--[[
Documentation is available in the Kotuku Wiki.
--]]

   import 'gui'
   include 'display', 'vector'

   namespace 'gui'

   mGfx <const> ?= mod.load('display')

DEFAULT_WIDTH  <const> = 600
DEFAULT_HEIGHT <const> = 400

lStyle = (function()
   if mSys.AnalysePath('style:window.tiri') is ERR_Okay then
      return loadFile('style:window.tiri')
   else
      return loadFile('styles:default/window.tiri')
   end
end)()

gui.window = function(Options:table)
   self = setmetatable({ -- Public variables
      events       = Options.events ?? { },
      aspectRatio  = Options.aspectRatio??,
      minimiseEnabled   = Options.minimise??,
      maximiseEnabled   = Options.maximise??,
      moveToBackEnabled = Options.moveToBack??,
      theme        = nil,
      focus        = Options.focus??,
      quit         = Options.quit is false ? nil :> true, -- Construction-only; defaults to true.
      title        = Options.title ?? 'Window',
      icon         = Options.icon ?? 'devices/monitor',
      restore      = nil, -- { x, y, width, height }
      orientation  = Options.orientation ?? 'landscape',
      client       = { }, -- Client margins
      menubar      = Options.menubar, -- Menubar configuration
      margins      = Options.margins,
      surface      = nil, -- Client access to the surface is permitted
      viewport     = nil -- The window's top-level viewport
   }, {
      __gc = function(Window)
         local surface = Window.surface
         Window.surface = nil
         surface?.free()
      end
   })

   -- Callbacks retain this record, not the public window table. Weak-value clearing may remove `window` before
   -- `__gc` runs, while the construction-time quit policy remains available to the surface free callback.

   lifecycle = setmetatable({ window=self, quit=self.quit }, { __mode='v' })

   self.clientViewport = function(self:table, Options:table)
      if self._clientViewport then return self._clientViewport end
      Options ?= { }

      Options.aspectRatio ?= 'XMin|YMin|Meet'

      Options.x = 0
      Options.y = 0
      Options.xOffset = 0
      Options.yOffset = 0

      self._clientViewport = self.viewport.new('VectorViewport', Options)

      return self._clientViewport
   end

   self.getSize = function(self:table)
      return {
         x      = self.surface.x - self.client.left,
         y      = self.surface.y - self.client.top,
         width  = self.surface.width + self.client.left + self.client.right,
         height =  self.surface.height + self.client.top + self.client.bottom
      }
   end

   self.getClientSize = function(self:table)
      return {
         x = self.surface.x, y = self.surface.y, width = self.surface.width, height = self.surface.height
      }
   end

   -- Resize the window via the client area

   self.resizeClientArea = function(self:table, ClientWidth:num, ClientHeight:num)
      ClientWidth ?= self.surface.width
      ClientHeight ?= self.surface.height
      self.surface.acResize(ClientWidth, ClientHeight, 0)
   end

   -- Changes the size of the position of the window in relation to its parent.  All dimensions refer to the
   -- border of the window.

   self.resize = function(self:table, X:num, Y:num, Width:num, Height:num)
      Width ?= self.surface.width
      Height ?= self.surface.height

      X ?= self.surface.x
      Y ?= self.surface.y
      self.surface.acRedimension(X + self.client.left, Y + self.client.top, 0,
         Width - self.client.left - self.client.right,
         Height - self.client.top - self.client.bottom, 0)
   end

   -- Define window sizing limits.

   self.sizeHints = function(self:table, MinWidth, MinHeight, MaxWidth, MaxHeight, EnforceAspect)
      if self.surface.display.mtSizeHints(MinWidth, MinHeight, MaxWidth, MaxHeight, EnforceAspect) != ERR_Okay then
         self.surface.maxWidth  = MaxWidth
         self.surface.minWidth  = MinWidth
         self.surface.maxHeight = MaxHeight
         self.surface.minHeight = MinHeight
      end
   end

   -- Smart limits are used to prevent the window from moving completely outside of the visible display area.

   self.applySmartLimits = function(self:table)
      self.smartLimitsEnabled = true
   end

   -- Run the minimise procedure for the window (environment dependent).

   self.minimise = function(self:table)
      if self.MinimiseEnabled then
         self?.events?.minimise(self)
      end
   end

   -- Run the maximise procedure for the window.  The process will take into account the hints provided by the margin
   -- settings of the parent surface (so if the margins are all set to 10, the window will be maximised to the size of
   -- the container minus 10 pixels from its edge).
   --
   -- If Toggle is true, the window is restored to its original position if the window is already maximised.

   self.maximise = function(self:table, Toggle)
      if not self.maximiseEnabled then
         msg('Maximisation for this window is turned off.')
         return
      end

      if self.events.maximise then
         self.events.maximise(self)
      end

      -- Send the maximisation request to the display
      display = obj.find(self.surface.display)
      display.flags = display.flags | SCR_MAXIMISE
   end

   self.moveToBack = function(self:table)
      self.surface.acMoveToBack()
   end

   self.moveToFront = function(self:table)
      self.surface.acMoveToFront()
   end

   self.parentSize = function(self:table)
      err, info = mGfx.getDisplayInfo(self.surface.display)
      return info.monitorWidth, info.monitorHeight
   end

   self.show = function(self:table, Centre:bool)
      if Centre then
         x, y = (function()
            if self.surface.popOver then
               err, x, y, powidth, poheight = [*__*]mGfx.GetSurfaceCoords(self.surface.popOver)
               if err is ERR_Okay then
                  x += ((powidth - self.surface.width) / 2)
                  y += ((poheight - self.surface.height) / 2)
                  err, px, py = [*__**__]mGfx.GetSurfaceCoords(self.surface.parent)
                  if err is ERR_Okay then
                     return x - px, y - py
                  end
               end
            elseif self.surface.parent then
               err, vx, vy, vwidth, vheight = [***__**]mGfx.GetVisibleArea(self.surface.parent)
               if err is ERR_Okay then
                  x = vx + ((vwidth - self.surface.width) / 2)
                  y = vy + ((vheight - self.surface.height) / 2)
                  --check_overlap(self, x, y, 0, 0)
                  return x, y
               end
            else
               err, info = mGfx.GetDisplayInfo(self.surface.display)
               if err is ERR_Okay then
                  return (info.monitorWidth - self.surface.width) / 2, (info.monitorHeight - self.surface.height) / 2
               end
            end
         end)()

         if x and y then
            err, info = mGfx.GetDisplayInfo(self.surface.display)
            if err is ERR_Okay then
               err, l_frame, t_frame, r_frame, b_frame = self.surface.display.mtGetFrame(0)

               if y - t_frame < info.virtualY then y = info.virtualY + t_frame end
               if x - l_frame < info.virtualX then x = info.virtualX + l_frame end
               if x + l_frame + r_frame + self.surface.width > info.virtualX + info.virtualWidth then x = info.virtualX + info.virtualWidth - self.surface.width - l_frame - r_frame end
               if y + t_frame + b_frame + self.surface.height > info.virtualY + info.virtualHeight then y = info.virtualY + info.virtualHeight - self.surface.height - t_frame - b_frame end
            end
            self.surface.acMoveToPoint(x, y, 0, MTF_X|MTF_Y)
         end
      end

      self.visible = true
      self.surface.acShow()
      if self.surface.flags has RNF_HAS_FOCUS then
         self.surface.acFocus()
      end

      self.events?.show(self)
   end

   self.hide = function(self:table)
      self.visible = false
      self.surface.acHide()
      self.events?.hide(self)
   end

   self.setTitle = function(self:table, Title:str)
      self.surface.display.title = Title
      self.title = Title
   end

   -- Main entry point --

   self._desktop = obj.find('desktop')

   surface_opts = {
      name      = 'winsurface',
      parent    = self._desktop,
      width     = Options.insideWidth ?? Options.width ?? DEFAULT_WIDTH,
      height    = Options.insideHeight ?? Options.height ?? DEFAULT_HEIGHT,
      type      = RT_ROOT,
      modal     = Options.modal ?? false,
      popOver   = Options.popOver,
      flags = (function()
         local flags = 0
         if Options.aspectRatio then
            flags = flags | RNF_ASPECT_RATIO
         end
         return flags
      end)()
   }

   surface_opts.minWidth  = Options.minWidth ?? 20
   surface_opts.minHeight = Options.minHeight ?? 10

   if Options.maxWidth  then surface_opts.maxWidth  = Options.maxWidth end
   if Options.maxHeight then surface_opts.maxHeight = Options.maxHeight end

   self.surface = obj.new('surface', surface_opts)

   if Options.enableControllers then
      self.surface.display.flags = self.surface.display.flags | SCR_GRAB_CONTROLLERS
   end

   parent_width, parent_height = self:parentSize()
   self.surface.x = Options.x ?? ((parent_width - self.surface.width) * 0.1)
   self.surface.y = Options.y ?? ((parent_height - self.surface.height) * 0.1)

   if (self.surface.minWidth is self.surface.maxWidth) and (self.surface.minHeight is self.surface.maxHeight) then
      self.maximiseEnabled = false
   end

   -- The margins are the recommended gap in addition to the client area.  The client
   -- area denotes the space afforded by the window frame.

   if Options.noMargins or Options.borderless then
      self.margins = { left = 0, top = 0, right = 0, bottom = 0 }
      self.client = { left = 0, top = 0, right = 0, bottom = 0 }
   else
      self.margins = { left = 6, top = 6, right = 6, bottom = 6 }

      -- Retrieve the available client area from the host
      local display = self.surface.display
      self.client = {
         left   = display.leftMargin,
         top    = display.topMargin,
         right  = display.rightMargin,
         bottom = display.bottomMargin
      }

      if Options.width and not Options.insideWidth then
         self.surface.width = Options.width - self.client.left - self.client.right
      end

      if Options.height and not Options.insideHeight then
         self.surface.height = Options.height - self.client.top - self.client.bottom
      end
   end

   self.scene = self.surface.new('VectorScene', { flags=VPF_RESIZE, surface=self.surface })

   self.theme = gui.setTheme(self.scene, Options.theme ?? gui.theme)

   gui.configureScene(self, self.scene) -- Support GUI customisation

   self.viewport = self.scene.new('VectorViewport', {
      x = 0, y = 0, width = '100%', height = '100%', aspectRatio = 'XMin|YMin|Meet'
   })

   self.bkgd = self.viewport.new('VectorRectangle', {
      fill = self.theme.window.bkgd, x = 0, y = 0, width = '100%', height = '100%'
   })

   self.surface.display.title = self.title

   if self.surface.popOver != 0 then
      -- If a pop-over surface is stick-to-front, we also need that status to avoid being behind it.

      info = struct.new('SurfaceInfo')
      if mGfx.GetSurfaceInfo(self.surface.popOver, info) is ERR_Okay then
         if info.flags has RNF_STICK_TO_FRONT then
            self.surface.flags = self.surface.flags | RNF_STICK_TO_FRONT
         end
      end
   end

   self.viewport.mtSubscribeFeedback(FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS, function(Viewport, Event)
      local window = lifecycle.window
      if not window then return ERR_Terminate end

      if Event is FM_LOST_FOCUS then
         window.events?.lostFocus(window)
      else
         if not window.disabled then
            window.events?.focus(window)
         end
      end

      Viewport.acDraw()
   end)

   mGfx.windowHook(self.surface.id, WH_CLOSE, function()
      local window = lifecycle.window
      if not window then return ERR_Terminate end

      result = window.events?.close(window)
      if result != nil then -- If client returns something, the window stays open
         msg('Client requested that the window stay open.')
         raise ERR_Cancelled
      end
      processing.collect('defer')
   end)

   self.surface.subscribe('focus', function(Surface, Args, Lifecycle)
      local window = Lifecycle.window
      if not window then return end

      Surface.acMoveToFront()
      if window.visible and not (Surface.flags has RNF_VISIBLE) then
         Surface.acShow()
      end

      window.events?.focus(window)
   end, lifecycle)

   self.surface.subscribe('lostfocus', function(Surface, Args, Lifecycle)
      local window = Lifecycle.window
      if not window then return end
      window.events?.lostFocus(window)
   end, lifecycle)

   self.surface.subscribe('free', function(Surface, Args, Lifecycle)
      if Lifecycle.quit then
         mSys.SendMessage(MSGID_QUIT)
      end

      local window = Lifecycle.window
      if window then table.clear(window) end
   end, lifecycle)

   return self
end
