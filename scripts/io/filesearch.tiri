--[[
The FileSearch interface simplifies the process of searching for files and folders within the file system.
Refer to the Tiri I/O Wiki page for documentation.
--]]

io.search = function(Path:any!, Options:table!)
   l_options       = Options
   l_stop          = false
   match_count      = 0
   is_regex_filter  = false
   is_exclude_regex = false
   has_min_date     = l_options.minDate != nil
   has_max_date     = l_options.maxDate != nil
   name_filter:any  = l_options.nameFilter
   exclude_filter:any = l_options.excludeFilter

   function normaliseFolderPath(Path:str!):str
      if Path.endsWith('/') or Path.endsWith('\\') or Path.endsWith(':') then return Path end
      return Path .. '/'
   end

   function reportError(Path:str!, Error:any)
      if l_options.errorFeedback then
         local result:any = l_options.errorFeedback(Path, Error)
         if result is ERR_Terminate then l_stop = true end
      end
   end

   function cancellationRequested():bool
      if l_stop then return true end

      if l_options.cancelToken and l_options.cancelToken.cancelled then
         l_stop = true
         return true
      end

      if l_options.cancelCheck then
         local result:any = l_options.cancelCheck(match_count)
         if (result is true) or (result is ERR_Terminate) then
            l_stop = true
            return true
         end
      end

      return false
   end

   function contentMatch(Path:str!):bool
      l_options.contentFilter ?! return true

      local filter_size = #l_options.contentFilter
      if filter_size is 0 then return true end

      local fl <close>:obj
      try
         fl = obj.new('file', { path=Path, flags=FL_READ } )
      except ex
         reportError(Path, ex)
         if l_options.strict then raise end
         return false
      end

      -- By default, symbolic links are not scanned for content unless the scanLinks option is set.

      if (fl.flags has FL_LINK) and (l_options.scanLinks != true) then return false end

      local buffer_size = 4096
      if filter_size > buffer_size then buffer_size = filter_size end

      local buffer = string.alloc(buffer_size)
      local overlap = ''

      while true do
         if cancellationRequested() then return false end

         local err, total_read = fl.acRead(buffer)
         if err != ERR_Okay then
            reportError(Path, err)
            if l_options.strict then raise err end
            return false
         end

         if total_read is 0 then return false end

         local content = overlap .. buffer.sub(0, total_read)
         if content.find(l_options.contentFilter) then return true end

         local overlap_size = filter_size - 1
         if overlap_size > #content then overlap_size = #content end
         overlap = content.sub(#content - overlap_size)
      end
   end

   function dateLessThan(A, B) -- struct DateTime
      if A.year < B.year then return true
      elseif A.year > B.year then return false end

      -- else years are equal, so test months
      if A.month < B.month then return true
      elseif A.month > B.month then return false end

      if A.day < B.day then return true
      elseif A.day > B.day then return false end

      if A.hour < B.hour then return true
      elseif A.hour > B.hour then return false end

      if A.minute < B.minute then return true
      elseif A.minute > B.minute then return false end

      if A.second < B.second then return true
      elseif A.second > B.second then return false end

      return false -- Dates are exactly equal
   end

   -- Filter can be a table or string
   function filterMatches(Filter:any!, RegexFilter:bool, FileName:str!):bool
      if RegexFilter then return Filter.test(FileName) end

      local cmp_name = FileName
      local cmp_filter:any = Filter
      if not l_options.caseSensitive then
         cmp_name = cmp_name.lower()
         cmp_filter = string.lower(cmp_filter)
      end

      return cmp_name is cmp_filter
   end

   function entryMatches(FileName:str!, File:obj, Depth:num):bool
      local match = true

      if l_options.minDepth and (Depth < l_options.minDepth) then match = false end
      if match and name_filter then match = filterMatches(name_filter, is_regex_filter, FileName) end
      if match and exclude_filter then
         match = not filterMatches(exclude_filter, is_exclude_regex, FileName)
      end

      if l_options.minSize?? and (l_options.minSize > 0) and (File.size < l_options.minSize) then match = false end
      if l_options.maxSize and (l_options.maxSize >= 0) and (File.size > l_options.maxSize) then match = false end
      if has_min_date and dateLessThan(File.date, l_options.minDate) then match = false end
      if has_max_date and dateLessThan(l_options.maxDate, File.date) then match = false end

      if match and (File.flags has FL_FILE) then match = contentMatch(File.path) end
      return match
   end

   function processEntry(Path:str!, FileName:str!, File:obj, Depth:num)
      local match = entryMatches(FileName, File, Depth)
      if cancellationRequested() then return end

      msg(f'Found: {File.path} Match: {match}')

      if match then
         match_count++
         if l_options.matchFeedback then
            local result:any = l_options.matchFeedback(Path, FileName, File)
            if result is ERR_Terminate then l_stop = true end
         end

         if l_options.maxResults and (match_count >= l_options.maxResults) then l_stop = true end
      elseif l_options.ignoreFeedback then
         local result:any = l_options.ignoreFeedback(Path, FileName, File)
         if result is ERR_Terminate then l_stop = true end
      end
   end

   function scanPath(Path:str, CurrentDepth:num):nil
      CurrentDepth ?= 0
      msg(f'scanPath() {Path ?? ':'} (depth: {CurrentDepth})')

      if cancellationRequested() then return end
      if l_options.maxDepth and (CurrentDepth > l_options.maxDepth) then return end

      local count = 0
      local flags = 0
      if not l_options.matchFolders then flags = flags | FL_EXCLUDE_FOLDERS end
      if l_options.ignoreFiles then flags = flags | FL_EXCLUDE_FILES end

      local folder
      try
         folder = obj.new('file', { src=Path, flags=flags })
      except ex
         reportError(Path, ex)
         if l_options.strict then raise end
         return
      end

      local err, fl = folder.mtNext()
      while (err is ERR_Okay) and (not l_stop) do
         count++
         processing.sleep(0)
         if cancellationRequested() then break end

         local _, file_name = io.splitPath(fl.path)
         processEntry(Path, file_name, fl, CurrentDepth)
         err, fl = folder.mtNext()
      end

      if (err != ERR_Okay) and (err != ERR_EndOfSequence) then
         reportError(Path, err)
         if l_options.strict then raise err end
      end

      if l_stop then return end

      -- Recursively scan directory content (if we haven't reached max depth)

      if not l_options.maxDepth or CurrentDepth < l_options.maxDepth then
         local can_recurse = true
         try
            folder = obj.new('file', { src=Path, flags=FL_EXCLUDE_FILES | FL_FOLDER } )
         except ex
            reportError(Path, ex)
            if l_options.strict then raise end
            can_recurse = false
         end

         if can_recurse then
            err, fl = folder.mtNext()
            while (err is ERR_Okay) and (not l_stop) do
               count++
               processing.sleep(0)
               if cancellationRequested() then break end

               if fl.flags has FL_LINK then
                  -- Do not scan symbolically linked directories (possible recursion)
               else
                  local descend = true
                  if l_options.shouldDescend then
                     local result:any = l_options.shouldDescend(Path, fl)
                     if result is ERR_Terminate then
                        l_stop = true
                        descend = false
                     else
                        descend = result is true
                     end
                  end

                  if descend then scanPath(normaliseFolderPath(fl.path), CurrentDepth + 1) end
               end
               err, fl = folder.mtNext()
            end

            if (err != ERR_Okay) and (err != ERR_EndOfSequence) then
               reportError(Path, err)
               if l_options.strict then raise err end
            end
         end
      end

      if count is 0 then processing.sleep(0) end -- Message check required if the directory was empty

      processing.collect()
   end

   function processPath(Path:str!)
      if cancellationRequested() then return end
      msg(f'Path: {Path}, Filter: {Options.nameFilter}, Regex: {is_regex_filter}, Content: {Options.contentFilter}')

      local err, location_type = mSys.AnalysePath(Path)
      if err != ERR_Okay then
         reportError(Path, err)
         if l_options.strict then raise err end
         return
      end

      if (location_type is LOC_FOLDER) or (location_type is LOC_VOLUME) then
         local folder_path = normaliseFolderPath(Path)
         scanPath(folder_path, 0)
      else
         if l_options.ignoreFiles then return end

         local path, file_name = io.splitPath(Path)
         path ?= ''

         local fl
         try
            fl = obj.new('file', { path=Path })
         except ex
            reportError(Path, ex)
            if l_options.strict then raise end
            return
         end

         processEntry(path, file_name, fl, 0)
      end
   end

   -- Entry point for the search

   if name_filter and name_filter != <str> then
      -- Check if it's a regex object by testing for regex methods
      if name_filter.test and name_filter.match then
         is_regex_filter = true
         if not l_options.caseSensitive then
            name_filter = regex.new(name_filter.pattern, name_filter.flags | regex.ICASE)
         end
      end
   end

   if exclude_filter and exclude_filter != <str> then
      if exclude_filter.test and exclude_filter.match then
         is_exclude_regex = true
         if not l_options.caseSensitive then
            exclude_filter = regex.new(exclude_filter.pattern, exclude_filter.flags | regex.ICASE)
         end
      end
   end

   if l_options.maxResults and (l_options.maxResults <= 0) then l_stop = true end

   if Path is <table> or Path is <array> then
      for value in values(Path) do
         processPath(value)
         if l_stop then break end
      end
   else
      processPath(Path)
   end
end
