   namespace gui

-- Converts percentage font sizes to points, scales all point sizes to the interface density and sets the default
-- style.  A point is always 1/72 inch, but VectorText converts points to pixels at a fixed 96 DPI.  Multiplying by
-- dpi/96 compensates, so that the rendered pixel size is pt * dpi / 72.  The stored sizes are therefore 96 DPI
-- equivalents and only match the true point size when the interface density is 96.

thunk scaledFonts(Fonts:table!):table
   rxFontSize <const> = r[[^(-?\d+)%$]]
   scale = gui.interface.dpi / 96
   for font in values(Fonts) do
      if font.size is <str> and rxFontSize.test(font.size) then
         pct = tonumber(rxFontSize.extract(font.size))
         font.size = gui.interface.fontSize * (pct / 100)
      end

      if font.size is <num> then font.size = math.round(font.size * scale) end

      font.style ?= 'medium'
   end
   return Fonts
end

gui.fonts = scaledFonts({
   -- Percentages are converted to numeric pt sizes, relative to gui.interface.fontSize
   -- Numeric sizes are points (1/72 in); scaled by dpi/96 to offset VectorText's fixed 96 DPI pt conversion
   -- All sizes are scaled to gui.interface.dpi on first access
   default  = { face='Noto Sans,Source Sans Pro', size='100%' },
   window   = { face='Noto Sans,Source Sans Pro', size='100%' }, -- For non-widget text
   button   = { face='Noto Sans,Source Sans Pro', size=11 }, -- Text inside buttons
   filesys  = { face='Inconsolata', size=12 }, -- Text for files, folders
   icon     = { face='Noto Sans,Source Sans Pro', size='100%' }, -- Labeling for icons
   menu     = { face='Noto Sans,Source Sans Pro', size=10 }, -- Menu & dropdown item text
   page     = { face='Noto Sans,Source Sans Pro', size=12 }, -- Multiple lines of text
   titlebar = { face='Noto Sans', size='100%' }, -- Window titlebar text
   small    = { face='Noto Sans,Source Sans Pro', size=9 }, -- Recommended text for small sizes
   xsmall   = { face='Micro', size=6 }, -- The smallest available, still legible size
   large    = { face='Noto Sans,Source Sans Pro', size='130%' }, -- Recommended text for headers
   input    = { face='Noto Sans,Source Sans Pro', size=12 }, -- Text inside input widgets (e.g. combobox)
   widget   = { face='Noto Sans,Source Sans Pro', size=12 }, -- Text inside non-input widgets (e.g. button)
   label    = { face='Noto Sans,Source Sans Pro', size='100%' } -- Text for labels and outside widgets
})
