-- VectorPath generators for widgets.  Each returns a table with the sequence string in its path field.

   include 'vector'

   module vector as mVec

   namespace gui

gui.paths ?= {}

local function cornerRadius(Size:num!):num
   return math.clamp(math.min(gui.maxCornerSize(), gui.sizing.widget.cornerSize * Size), 0, Size * 0.5)
end

gui.paths.ellipse = function(Viewport:obj!):table
   w = Viewport.width
   h = Viewport.height
   cx = w * .5
   cy = h * .5
   rx = w * .5
   ry = h * .5

   if rx <= 0 or ry <= 0 then return { path='' } end

   function arc(EX:num, EY:num):str
      return f'A{rx} {ry} 0 0 1 {EX} {EY} '
   end

   return {
      path = f'M{cx + rx} {cy} ' .. arc(cx, cy + ry) .. arc(cx - rx, cy) ..
         arc(cx, cy - ry) .. arc(cx + rx, cy) .. 'Z'
   }
end

gui.paths.rectangle = function(Viewport:obj!):table
   r = cornerRadius(math.min(Viewport.width, Viewport.height))

   if r is 0 then return { path='M 0 0 H ~0 V ~0 H 0 Z' } end

   return {
      path = f'M {r} 0 H ~{r} A {r} {r} 0 0 1 ~0 {r} V ~{r} A {r} {r} 0 0 1 ~{r} ~0 ' ..
         f'H {r} A {r} {r} 0 0 1 0 ~{r} V {r} A {r} {r} 0 0 1 {r} 0 Z'
   }
end

gui.paths.boombox = function(Viewport:obj!):table
   if Viewport.width <= 40 then
      return gui.paths.rectangle(Viewport)
   end
   k = Viewport.height / 180
   return {
      path = f"M ~{80*k} {20*k} h {-25*k} l {-10*k} {-10*k} H {115*k} l {-10*k} {10*k} H {80*k} " ..
         f"a {70*k} {70*k} 0 1 0 0 {140*k} h {25*k} l {10*k} {10*k} H ~{115*k} l {10*k} {-10*k} " ..
         f"h {25*k} a {70*k} {70*k} 0 1 0 0 {-140*k} Z"
   }
end

gui.paths.slant = function(Viewport:obj!):table
   w = Viewport.width
   h = Viewport.height
   if w <= 0 or h <= 0 then return { path='' } end

   slant = math.min(h * (90 / 140), w * 0.5)
   r = cornerRadius(math.min(w, h))
   if r is 0 then return { path=f'M 0 {h} L {slant} 0 H {w} L {w - slant} {h} Z' } end

   -- Trim both edges by the tangent distance for a circular arc at each rounded corner.
   side = math.sqrt(slant * slant + h * h)
   trim = r * (h / (side + slant))
   x = slant - trim * (slant / side)
   y = trim * (h / side)

   return {
      path = f'M 0 {h} L {x} {y} A {r} {r} 0 0 1 {slant + trim} 0 H {w} ' ..
         f'L {w - x} {h - y} A {r} {r} 0 0 1 {w - slant - trim} {h} Z'
   }
end

gui.paths.taper = function(Viewport:obj!):table
   w = Viewport.width
   h = Viewport.height
   if w <= 0 or h <= 0 then return { path='' } end

   mid_y = h * 0.5

   -- Without rounding, the end caps are 45 degree points.  They steepen when space is tight.
   if gui.sizing.widget.cornerSize <= 0 then
      point = math.min(mid_y, w * 0.5)
      return { path=f'M {point} 0 L 0 {mid_y} L {point} {h} H {w - point} L {w} {mid_y} L {w - point} 0 Z' }
   end

   -- The reference has 169 by 140 end caps. Compress them horizontally when space is tight.
   scale_y = h / 140
   inset = math.min(169 * scale_y, w * 0.5)
   rx = inset * (239 / 169)
   ry = 239 * scale_y
   arc = f'A {rx} {ry} 0 0 0'

   return {
      path = f'M {inset} 0 {arc} 0 {mid_y} {arc} {inset} {h} H {w - inset} ' ..
      f'{arc} {w} {mid_y} {arc} {w - inset} 0 Z'
   }
end

gui.paths.bevel = function(Viewport:obj!):table
   w = Viewport.width
   h = Viewport.height
   if w <= 0 or h <= 0 then return { path='' } end

   cut = cornerRadius(math.min(w, h))
   if cut is 0 then return { path=f'M 0 0 H {w} V {h} H 0 Z' } end

   return {
      path = f'M {cut} 0 L 0 {cut} V {h - cut} L {cut} {h} H {w - cut} ' ..
         f'L {w} {h - cut} V {cut} L {w - cut} 0 Z'
   }
end

gui.paths.softSlant = function(Viewport:obj!):table
   w = Viewport.width
   h = Viewport.height
   if w <= 0 or h <= 0 then return { path='' } end

   k = h / 100
   big_r = 140 * k
   fillet_r = 15.6 * k

   -- Horizontal distance between the nose arc and fillet centres, from internal tangency of the two circles.
   centre_gap = big_r - fillet_r
   drop = big_r - h + fillet_r
   dx = math.sqrt(centre_gap * centre_gap - drop * drop)
   nose = dx + fillet_r

   -- Compress the noses horizontally when the long edges would otherwise vanish.
   s = math.min(1, w / (nose + fillet_r))
   x0 = nose * s
   xf = fillet_r * s
   tx = (nose - dx * big_r / centre_gap) * s
   ty = big_r - drop * big_r / centre_gap
   nose_arc = f'A {big_r * s} {big_r} 0 0 0'
   fillet_arc = f'A {fillet_r * s} {fillet_r} 0 0 0'

   return {
      path = f'M {w - xf} 0 H {x0} {nose_arc} {tx} {ty} {fillet_arc} {xf} {h} H {w - x0} ' ..
         f'{nose_arc} {w - tx} {h - ty} {fillet_arc} {w - xf} 0 Z'
   }
end

gui.paths.butt = function(Viewport:obj!):table
   w = Viewport.width
   h = Viewport.height
   if w <= 0 or h <= 0 then return { path='' } end

   r = h / math.sqrt(2)
   bulge = r - h * 0.5

   -- Compress the end caps horizontally when they would otherwise overlap.
   s = math.min(1, w / (bulge * 2))
   inset = bulge * s
   cap = f'A {r * s} {r} 0 0 0'

   return { path=f'M {w - inset} 0 H {inset} {cap} {inset} {h} H {w - inset} {cap} {w - inset} 0 Z' }
end

gui.paths.divArrowhead = function(Viewport:obj!):table
   w = Viewport.width
   h = Viewport.height
   if w <= 0 or h <= 0 then return { path='' } end

   mid_y = h * 0.5
   head = h * 2
   if w < head * 2 then return { path=f'M 0 {mid_y} H {w}' } end

   -- Distances from the tip, scaled from the reference's 84 unit head length and 40 unit head height.
   flank_x = head * (31 / 84)
   c1_x    = head * (43 / 84)
   c2_x    = head * (55 / 84)
   back_x  = head * (67 / 84)
   flank_y = h * (12.5 / 40)
   c1_y    = h * (17.5 / 40)
   shaft_y = math.min(gui.sizing.widget.edgeWidth * 0.5, mid_y) -- Shaft thickness matches widget edges

   return {
      path = f'M {head} {mid_y - shaft_y} L {back_x} 0 ' ..
         f'C {c2_x} 0 {c1_x} {mid_y - c1_y} {flank_x} {mid_y - flank_y} L 0 {mid_y} L {flank_x} {mid_y + flank_y} ' ..
         f'C {c1_x} {mid_y + c1_y} {c2_x} {h} {back_x} {h} L {head} {mid_y + shaft_y} H {w - head} ' ..
         f'L {w - back_x} {h} C {w - c2_x} {h} {w - c1_x} {mid_y + c1_y} {w - flank_x} {mid_y + flank_y} ' ..
         f'L {w} {mid_y} L {w - flank_x} {mid_y - flank_y} ' ..
         f'C {w - c1_x} {mid_y - c1_y} {w - c2_x} 0 {w - back_x} 0 L {w - head} {mid_y - shaft_y} Z'
   }
end
