-- This is a library of VectorPath path generators for widgets.  It covers simple paths and a few fancy ones.

   include 'vector'

   module vector as mVec

   namespace gui

gui.paths ?= {}

gui.paths.ellipse = function(Viewport:obj!):str
   w = Viewport.width
   h = Viewport.height
   cx = w * .5
   cy = h * .5
   rx = w * .5
   ry = h * .5

   if rx <= 0 or ry <= 0 then return '' end

   function arc(EX:num, EY:num):str
      return f'A{rx} {ry} 0 0 1 {EX} {EY} '
   end

   return f'M{cx + rx} {cy} ' ..
      arc(cx, cy + ry) ..
      arc(cx - rx, cy) ..
      arc(cx, cy - ry) ..
      arc(cx + rx, cy) .. 'Z'
end

gui.paths.rectangle = function(Viewport:obj!):str
   vh = math.min(Viewport.width, Viewport.height)
   r = math.clamp(math.min(gui.maxCornerSize(), gui.sizing.widget.cornerSize * vh), 0, vh * 0.5)

   if r is 0 then return f'M 0 0 H ~0 V ~0 H 0 Z' end

   return f'M {r} 0 H ~{r} A {r} {r} 0 0 1 ~0 {r} V ~{r} A {r} {r} 0 0 1 ~{r} ~0 ' ..
      f'H {r} A {r} {r} 0 0 1 0 ~{r} V {r} A {r} {r} 0 0 1 {r} 0 Z'
end

gui.paths.boombox = function(Viewport:obj!):str
   if Viewport.width <= 40 then
      return gui.paths.rectangle(Viewport)
   end
   k = Viewport.height / 180
   return f"M ~{80*k} {20*k} h {-25*k} l {-10*k} {-10*k} H {115*k} l {-10*k} {10*k} H {80*k} " ..
      f"a {70*k} {70*k} 0 1 0 0 {140*k} h {25*k} l {10*k} {10*k} H ~{115*k} l {10*k} {-10*k} " ..
      f"h {25*k} a {70*k} {70*k} 0 1 0 0 {-140*k} Z"
end
