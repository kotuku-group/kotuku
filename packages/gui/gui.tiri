         focus = { stroke = Palette.contrast },
         text  = table.merge({ fill = Palette.text }, gui.fonts.input),
         disabled = { opacity = 0.5 }
      },
      menubar = {
         bkgd      = { fill = Palette.inverse, },
         text      = table.merge({ fill = Palette.altText }, gui.fonts.menu),
         highlight = { fill = Palette.contrast }
         focus     = { fill = Palette.contrast }
         -- 'menu' item reference is inserted post-construction
      },
      menu = {
         bkgd      = { fill = Palette.inverse },
         border    = { stroke  = Palette.neutral, opacity = 0.5 },
         highlight = { fill = Palette.contrast },
         text      = table.merge({ fill = Palette.altText }, gui.fonts.menu),
         icon      = Icon('fill(pearl)')
      },
      panel = {
         bkgd          = { fill = Palette.surround, stroke = Palette.edge, strokeWidth = Edge.width, cornerX = Edge.corner, cornerY = Edge.corner },
         header        = { fill = Palette.surround },
         title         = { fill = Palette.text, face = gui.fonts.small.face, size = gui.fonts.small.size, style = 'bold' },
         meta          = { fill = Palette.text, face = gui.fonts.small.face, size = gui.fonts.small.size, opacity = 0.9 },
         metaHighlight = { fill = Palette.contrast },
         divider       = { fill = Palette.edge },
         headerPad     = math.round(gui.fonts.small.size * 0.75), -- Three quarters of an em
         metaGap       = gui.sizing.widget.labelGap
      },
      slider = {
         bkgd          = { fill = Palette.mid, stroke = Palette.edge, cornerX = Edge.corner, cornerY = Edge.corner, strokeWidth = Edge.width, opacity = 1 },
         slideFill     = { fill = Palette.handle, stroke = 'none', cornerX = Edge.corner, cornerY = Edge.corner, strokeWidth = Edge.width },
         thumbFill     = { fill = Palette.handle, stroke = 'none', cornerX = Edge.corner, cornerY = Edge.corner, strokeWidth = Edge.width },
         foreHighlight = { fill = Palette.contrast, opacity = 1 },
         foreFocus     = { stroke = Palette.contrast, strokeWidth = Edge.width },
         tick          = { stroke = Palette.text, strokeWidth = gui.rpixel('1px'), opacity = 0.6 },
         text          = table.merge({ fill = Palette.text }, gui.fonts.widget),
         disabled      = { opacity = 0.5 }
      },
      scrollbar = {
         bkgd          = { fill = Palette.mid, stroke = 'none', strokeWidth = gui.rpixel('2px') },
         fore          = { fill = Palette.handle, stroke = 'none', opacity = 0.75, strokeWidth = gui.rpixel('2px') },
         foreHighlight = { fill = Palette.contrast, opacity = 1 },
         thickness     = gui.rpixel('18dp')
      },
      toolbar = {
         bkgd          = { fill = Palette.surround },
         groupBorder   = { stroke = Palette.inverse, strokeWidth = gui.rpixel('1.5pt') },
         highlight     = { fill = Palette.contrast },
         icon          = Icon('fill(carbon)'),
         iconHighlight = Icon('fill(pearl)')
      },
      tooltip = {
         bkgd = { fill = Palette.bkgd, cornerX = 4, cornerY = 4, strokeWidth = gui.rpixel('2px'), stroke = Palette.edge },
         text = { fill = Palette.text }
      },
      window = {
         bkgd   = { fill = Palette.neutral },
         text   = table.merge({ fill = Palette.text }, gui.fonts.window),
         stroke = { stroke = modifyAlpha(Palette.inverse, 0.5), strokeWidth = gui.rpixel('2px') },
         icon   = Icon('fill(carbon)'),
         tabPing  = { stroke = Palette.prime, strokeWidth = gui.rpixel('3dp') } -- Tab ping ring
      },
      desktop = {
         bkgd = 'rgb(160 160 160)'
      }
   }
end

@Doc(text=[[
-FUNCTION-
buildTheme: Builds a complete light or dark theme table from a palette, icon style and edge sizing.

Creates a new theme table for the `light` or `dark` ColourScheme.  The result has the same structure as the entries of
`gui.themes`, including the `scheme`, `palette` and `init` fields, and is suitable for `gui.window.setTheme()`.  Each
call creates new tables, so the result can be modified without affecting other themes.

Options that are not provided take the values that the gui library loaded from the user's style configuration:

* `palette`: A palette table from `gui.palettes`, holding `light` and `dark` variants.  The variant that matches
  ColourScheme is used.  Defaults to `gui.palette`.
* `fill`: An icon fill spec, such as `'fill(cmap:flare)'`, that replaces the theme's default icon fills.  Defaults to
  the configured fill.  Pass `false` to use the theme's own fills.
* `effects`: An effects spec, such as `'emboss()'`, that is appended to every icon fill.  Defaults to the configured
  effects.  Pass `false` for no effects.
* `edgeWidth`: The stroke width of widget edges, in pixels at 96 DPI.  It is scaled to the interface density.
  Defaults to `gui.sizing.widget.edgeWidth`.
* `cornerSize`: The corner radius of widget edges, as a fraction of the normalised diagonal of each edge's area (see
  `gui.cornerRadius()`).  The theme's `cornerX` and `cornerY` values are the equivalent percentage strings.  Defaults
  to `gui.sizing.widget.cornerSize`.

Fonts and all other sizing values come from the resolved `gui.fonts` and `gui.sizing` tables, because widget
layout depends on them.

-INPUT-
ColourScheme: The colour scheme to build, either `light` or `dark`.
Options: Optional table of overrides, as described above.

-RESULTS-
table: A new theme table.
]])
gui.buildTheme = function(ColourScheme:str!, Options:table):table
   if ColourScheme != 'light' and ColourScheme != 'dark' then
      raise ERR_Args, f'Unsupported colour scheme "{ColourScheme}".'
   end

   Options ?= { }
   palette = (Options.palette ?? gui.palette)[ColourScheme]
   if not (palette is <table>) then raise ERR_Args, f'The palette has no "{ColourScheme}" variant.' end

   fill, effects = gui.defaultFill, gui.defaultFX
   if Options.fill != nil then fill = Options.fill end
   if Options.effects != nil then effects = Options.effects end

   scale = gui.interface.dpi / 96
   edge = { width = gui.sizing.widget.edgeWidth, round = gui.sizing.widget.cornerSize }
   if Options.edgeWidth != nil then edge.width = Options.edgeWidth * scale end
   if Options.cornerSize != nil then edge.round = Options.cornerSize end

   function icon(Default:str!):str
      return iconTheme(Default, fill, effects)
   end

   theme = (ColourScheme is 'dark') ? darkTheme(palette, edge, icon) : lightTheme(palette, edge, icon)
   theme.menubar.menu = theme.menu -- Shared section
   return theme
end

-- The theme tables are deferred until first access because they read gui.fonts, which depends on the display density.

gui.themes = <table{ {
   dark  = gui.buildTheme('dark'),
   light = gui.buildTheme('light') }
}>
