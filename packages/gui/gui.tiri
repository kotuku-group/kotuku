@Doc(text=[[
Returns the name of the theme assigned to a given Viewport or vector Scene.

This is effectively the theme assigned to the display Window.  If a viewport is provided then the nearest parent scene
is queried.  Pop-up surfaces use this to adopt the theme of the window that opened them.  A scene without a theme
adopts the default theme.

-INPUT-
Object: A VectorViewport or VectorScene.  If nil, the default theme name is returned.

-RESULTS-
str: The theme name.
]])
gui.getThemeName = function(Object:obj):str
   Object ?! return gui.theme

   scene:obj
   if obj.class(Object).name is 'VectorViewport' then
      scene = Object.scene
   elseif obj.class(Object).name is 'VectorScene' then
      scene = Object
   else
      raise f'Provided object class {Object.class()} is unsupported.'
   end

   local state = scene.state()
   if not state.theme then -- Theme undefined, apply the default and its scene resources
      state.theme = gui.theme
      theme = gui.themes[state.theme]
      if theme then theme.init?(scene) end
   end

   return state.theme
end

----------------------------------------------------------------------------------------------------------------------

@Doc(text=[[
@desc Returns the localised theme table for a given Viewport or vector Scene.
@input A VectorViewport or VectorScene.  If nil, the default theme is returned.
@result The theme table.
]])
gui.getTheme = function(Object:obj):table
   return gui.themes[gui.getThemeName(Object)]
end

----------------------------------------------------------------------------------------------------------------------

@Doc(text=[[
Sets the theme for a given Viewport or Scene, or the default theme if no object is provided.

The base themes are 'light' and 'dark'.  Choosing an alternative theme will use one of the aforementioned as the
base and then override values with its own settings.  Themes work in conjunction with palettes, which allow the
user to direct the colours of the chosen theme.  Although the light and dark themes rely on palette colours
heavily, specialised themes may ignore them entirely.

A custom theme is loaded from 'config:themes/<Theme>.tiri'.  If it is unavailable, the 'light' theme is used.

-INPUT-
Object: A VectorViewport or VectorScene.  If nil, the default theme is changed.
Theme: Name of the theme.

-RESULTS-
table: The theme table.
]])
gui.setTheme = function(Object:obj, Theme:str!):table
   msg(f'gui.setTheme({Object}, {Theme})')

   if not gui.themes[Theme] then
      -- Request for a custom theme, load from storage
      if mSys.AnalysePath(f'config:themes/{Theme}.tiri') is ERR_Okay then
         -- Client must use light or dark as a base, then modify values
         loadFile(f'config:themes/{Theme}.tiri')
         assert(gui.themes[Theme], 'Theme configuration did not initialise correctly.')
      else
         msg(2, f'Requested theme "config:themes/{Theme}.tiri" unavailable.')
         Theme = 'light' -- Revert to a safe default
      end
   end

   local state
   if Object then
      scene:obj
      if obj.class(Object).name is 'VectorViewport' then
         scene = Object.scene
      elseif obj.class(Object).name is 'VectorScene' then
         scene = Object
      else
         raise f'Provided object class {Object.class()} is unsupported.'
      end

      state = scene.state()
      -- Some themes may add custom patterns & gradients to the scene
      gui.themes[Theme].init?(scene)
   end

   if state then
      state.theme = Theme
   else
      gui.theme = Theme
   end

   return gui.themes[Theme]
end

----------------------------------------------------------------------------------------------------------------------

@Doc(text=[[
@desc Copies each key-value of Set to Vector.  Internal function for widget libraries.
@input The vector, or table, that receives the style values.
@input Table of style values.  Nothing is applied if nil.
]])
gui.applyStyle = function(Vector:any!, Set:table)
   if not Set then return end

   for k, v in Set do
      Vector[k] = v
   end
end

-- Replace a rectangle's style, restoring fields omitted by the replacement to their native values.  Defaults is
-- private to the vector and must be supplied from the first style application.  Records retain nil values, and the
-- corner fields share storage, so all corners are saved and restored together.

gui.styleRectangle = function(Vector:obj!, Style:table, Defaults:table!)
   Defaults.corners ?= { value=Vector.corners }
   for key, saved in Defaults do Vector[key] = saved.value end

   if Style then
      for key in Style do
         if key != 'cornerX' and key != 'cornerY' and not (key in Defaults) then
            Defaults[key] = { value=Vector[key] }
         end
      end
      gui.applyStyle(Vector, Style)
   end
end

----------------------------------------------------------------------------------------------------------------------
-- Returns the theme widget registry of the outermost scene that hosts Object.

function widgetRegistry(Object:obj!):table
   local scene:obj
   if obj.class(Object).name is 'VectorScene' then
      scene = Object
   else
      scene = Object.scene
   end

   while scene.hostScene do scene = scene.hostScene end

   local state = scene.state()
   state.widgets ?= setmetatable({ }, { __mode='k' })
   return state.widgets
end

@Doc(text=[[
Registers a widget to receive theme updates from gui.broadcastTheme().  Internal function for widget libraries.

The registry belongs to the outermost scene that hosts Viewport.  Widgets are weakly referenced, so an entry lasts
until the first garbage collection after the widget is unreferenced.  A widget whose viewport is freed is skipped
until then.  Widgets are updated in no particular order.

The widget table must provide `viewport` and an `applyTheme(Theme)` function.  The function receives the complete
theme table and is expected to rebuild its own sub-theme from it, then update the presentation values that can change
in place.

-INPUT-
Viewport: The widget's viewport, or any vector in the scene that the widget belongs to.
Widget: The widget's interface table.
]])
gui.registerWidget = function(Viewport:obj!, Widget:table!)
   assert(Widget.viewport is <obj>, 'The widget must reference a viewport')
   assert(Widget.applyTheme is <func>, 'The widget must have an applyTheme() function')
   widgetRegistry(Viewport)[Widget] = true
end

@Doc(text=[[
Sends a theme to every widget that is registered with a scene.  Internal function for gui.window.setTheme().

Each widget's `applyTheme()` function is called with Theme.  Widgets whose viewport no longer exists are skipped.  An
error raised by a widget is logged and does not stop the broadcast.  Widgets that are registered during the broadcast
are not called.

-INPUT-
Scene: The window's VectorScene, or any vector within it.
Theme: The complete theme table.
]])
gui.broadcastTheme = function(Scene:obj!, Theme:table!)
   -- A widget can create other widgets while it applies the theme, e.g. a combobox rebuilds its drop-down list, so
   -- the registry is copied before the broadcast.  Widgets created during the broadcast already use the new theme.

   list = array<table>
   for widget in widgetRegistry(Scene) do list.push(widget) end

   for widget in values(list) do
      if not widget.viewport?.exists() then continue end

      try
         widget.applyTheme(Theme)
      except ex
         msg(f'Widget failed to apply theme: {ex.message}')
      end
   end
end

----------------------------------------------------------------------------------------------------------------------

function modifyAlpha(Colour:str!, Alpha:num!):str
   mVec.ReadPainter(nil, Colour, glPainter)
   nrgb = glPainter.colour
   rgb = gui.nrgb(nrgb.red, nrgb.green, nrgb.blue, nrgb.alpha)
   return tostring(rgb.withAlpha(Alpha))
end

----------------------------------------------------------------------------------------------------------------------
-- Unscaled style defaults.  The configuration file's interface and sizing sections override these, and
-- gui.styleDefaults() returns copies of them.  Sizing values are pixels at 96 DPI.

glStyleDefaults <const> = {
   interface = {
      fontSize  = 11,        -- Default font-size for everything (pt)
      iconTheme = 'Default', -- Named folder to load the icons from
      flashTime = 1.5,       -- Default duration of flashed messages, in seconds
      tabPing   = 0.3,       -- Seconds that the tab ping stays visible in a window; 0 disables it
      pingSize  = 30,
      tabPingDistance = 40 -- Tabs within this distance of the last ping don't ping (px at 96 DPI); 0 always pings
   },
   sizing = {
      window = {
         gap = 12         -- Margin to apply on all sides
      },
      widget = {
         gap       = 4,    -- Recommended gap between widgets (px at 96 DPI)
         margin    = 6,    -- Recommended internal margin for widgets (px at 96 DPI)
         labelGap  = 12,   -- Spacing between labels and the widget parts
         edgeWidth = 2,    -- Default stroke-width for widget edges (px at 96 DPI)
         cornerSize = 0.2, -- Corner radius as a fraction of the area's normalised diagonal (unitless)
         height    = 1.2   -- Box height, expressed in em scale
      }
   }
}

-- The value types accepted in each section of the style configuration.  'str' is a non-empty string, 'num' a number
-- of at least zero, 'size' a number greater than zero and 'fontSize' a size or a percentage string such as '120%'.
-- An 'object' is validated by its own reader.

SCHEMA_STYLE <const> = {
   theme = 'str', palette = 'str', paletteTheme = 'str', fill = 'str', effects = 'str', paletteColours = 'object'
}
SCHEMA_INTERFACE <const> = {
   fontSize = 'size', dpi = 'size', iconTheme = 'str', flashTime = 'num', tabPing = 'num', pingSize = 'size',
   tabPingDistance = 'num'
}
SCHEMA_WINDOW <const> = { gap = 'num' }
SCHEMA_WIDGET <const> = {
   width = 'size', gap = 'num', margin = 'num', labelGap = 'num', edgeWidth = 'num', cornerSize = 'num', height = 'num'
}
SCHEMA_FONT <const> = { face = 'str', size = 'fontSize', style = 'str' }

function validStyleValue(Kind:str!, Value:any):bool
   if Kind is 'str' then
      return Value is <str> and #Value > 0
   elseif Kind is 'num' then
      return Value is <num> and Value >= 0
   elseif Kind is 'size' then
      return Value is <num> and Value > 0
   elseif Kind is 'fontSize' then
      if Value is <str> then return r[[^\d+(?:\.\d+)?%$]].test(Value) end
      return Value is <num> and Value > 0
   end
   return false
end

-- Returns the valid entries of a configuration section.  Invalid values are reported and dropped, so that their
-- defaults apply.  Unknown keys are ignored silently, as they may belong to other tools.

function parseStyleTable(Section:any, Schema:table!, Path:str!):table
   result = { }
   if Section is nil then return result end

   if not (Section is <table>) then
      msg(2, f'Style configuration: "{Path}" is not an object and has been ignored.')
      return result
   end

   for key, value in Section do
      kind = Schema[key]
      if not kind then
         msg(f'Style configuration: ignoring unknown key "{Path}.{key}"')
      elseif kind is 'object' then
         continue
      elseif validStyleValue(kind, value) then
         result[key] = value
      else
         msg(2, f'Style configuration: invalid value for "{Path}.{key}" has been ignored.')
      end
   end

   return result
end

-- Reads a font role.  face, size and style select the font, and every other key is a font definition key such as
-- stroke or shadow:
--
--   widget = { face = 'Courier Prime', stroke = '#EC3013', strokeWidth = '0.05em' }
--
-- The definition keys are kept in the role alongside face, size and style, so that gui.fontStyle() passes them to the
-- text.  Keys that aren't valid definition keys are reported and dropped.

function fontRoleSection(Section:any, Path:str!):table
   result = { }
   if Section is nil then return result end

   if not (Section is <table>) then
      msg(2, f'Style configuration: "{Path}" is not an object and has been ignored.')
      return result
   end

   for key, value in Section do
      kind = SCHEMA_FONT[key]
      if kind then
         if validStyleValue(kind, value) then
            result[key] = value
         else
            msg(2, f'Style configuration: invalid value for "{Path}.{key}" has been ignored.')
         end
         continue
      end

      -- A ';' would add further keys to the definition, so a value holding one is rejected
      entry = f'{key}={value}'
      valid = (value is <num>) or ((value is <str>) and not (';' in value))
      if valid then
         err, normal = mVec.NormaliseTextStyle(entry)
         valid = (err is ERR_Okay) and normal??
      end

      if valid then
         result[key] = value
      else
         msg(2, f'Style configuration: invalid value for "{Path}.{key}" has been ignored.')
      end
   end

   return result
end

-- Reads style.paletteColours, the user's colour overrides for the gui palettes:
--
--   paletteColours = { ocean = { light = { prime = 'oklch(0.6 0.15 250)' }, dark = { ... } } }
--
-- Entries that aren't objects or non-empty strings are reported and dropped.  The colours themselves are checked when
-- they are applied to a palette (see withPaletteColours()).

function paletteColourSection(Section:any):table
   result = { }

   if Section is nil then return result end

   if not (Section is <table>) then
      msg(2, 'Style configuration: "style.paletteColours" is not an object and has been ignored.')
      return result
   end

   for name, schemes in Section do
      if not (schemes is <table>) then
         msg(2, f'Style configuration: "style.paletteColours.{name}" is not an object and has been ignored.')
         continue
      end

      palette = { }
      for scheme, colours in schemes do
         path = f'style.paletteColours.{name}.{scheme}'
         if not (colours is <table>) then
            msg(2, f'Style configuration: "{path}" is not an object and has been ignored.')
            continue
         end

         variant = { }
         for key, value in colours do
            if validStyleValue('str', value) then
               variant[key] = value
            else
               msg(2, f'Style configuration: invalid value for "{path}.{key}" has been ignored.')
            end
         end

         palette[scheme] = variant
      end

      result[name] = palette
   end

   return result
end

-- Reads and validates the style configuration.  This runs before any of the interface, sizing or font thunks can
-- resolve, because widget packages capture those values when they are imported.  A missing user file is created
-- with default content; a file named by the guiStyle script key is only ever read.

function loadStyle():table
   style = {
      style = { }, interface = { }, sizing = { window = { }, widget = { } }, fonts = { }, paletteColours = { }
   }

   if mSys.AnalysePath(glStyleConfig) != ERR_Okay then
      if glStyleOverride then
         msg(2, f'Style configuration {glStyleConfig} is unavailable; using defaults.')
      else
         fl <close> = obj.new('file', { path=glStyleConfig, flags=FL_WRITE|FL_NEW })
         fl.acWrite(json.encode({
               style = {
                  theme = 'light',
                  palette = 'ocean',
                  paletteTheme = 'light'
               },
               interface = { }, -- Don't override internal defaults
               sizing = { }
            })
         )
      end
      return style
   end

   local cfg:any
   try
      cfg = json.decode(io.readAll(glStyleConfig))
   except ex
      msg(2, f'Error in style configuration file {glStyleConfig}; delete to reset it')
      msg(2, f'  Detail: {ex.message}')
      return style
   end

   if not (cfg is <table>) then
      msg(2, f'Style configuration file {glStyleConfig} does not hold an object; delete to reset it')
      return style
   end

   style.style     = parseStyleTable(cfg.style, SCHEMA_STYLE, 'style')
   if cfg.style is <table> then style.paletteColours = paletteColourSection(cfg.style.paletteColours) end
   style.interface = parseStyleTable(cfg.interface, SCHEMA_INTERFACE, 'interface')

   if cfg.sizing is <table> then
      style.sizing.window = parseStyleTable(cfg.sizing.window, SCHEMA_WINDOW, 'sizing.window')
      style.sizing.widget = parseStyleTable(cfg.sizing.widget, SCHEMA_WIDGET, 'sizing.widget')
   elseif cfg.sizing != nil then
      msg(2, 'Style configuration: "sizing" is not an object and has been ignored.')
   end

   if cfg.fonts is <table> then
      for role, font in cfg.fonts do
         style.fonts[role] = fontRoleSection(font, f'fonts.{role}')
      end
   elseif cfg.fonts != nil then
      msg(2, 'Style configuration: "fonts" is not an object and has been ignored.')
   end

   return style
end

glStyle = loadStyle()

----------------------------------------------------------------------------------------------------------------------
-- Returns the average pixel density of the main display, or 96 if it is unavailable.

thunk displayDensity():num
   err, info = mGfx.GetDisplayInfo(0)
   if err != ERR_Okay then return 96 end
   dpi = ((info.hDensity + info.vDensity) * 0.5) ?? 96
   return dpi
end

-- Scales a table of pixel values from a 96 DPI baseline to the interface density.  Values are rounded to whole pixels
-- for layout, except for the keys in Exact, which are drawing values such as stroke widths and corner radii.  The keys
-- in Unscaled are not pixel values, e.g. multipliers of the font height, and are left as they are.

thunk scaledPixels(Values:table!, Exact:table, Unscaled:table):table
   scale = gui.interface.dpi / 96
   for k, v in Values do
      if Unscaled and Unscaled[k] then continue end
      Values[k] = (Exact and Exact[k]) ? v * scale : math.round(v * scale)
   end
   return Values
end

   -- The configured dpi replaces the detected display density, acting as a scale override for the interface.

   gui.interface = table.merge(glStyleDefaults.interface, glStyle.interface)

   if not glStyle.interface.dpi then
      gui.interface.dpi = displayDensity() -- Resolved on first read
   end

   gui.sizing = { } -- Universal sizing information, scaled to the interface density on first read

   gui.sizing.window = scaledPixels(table.merge(glStyleDefaults.sizing.window, glStyle.sizing.window))

   gui.sizing.widget = scaledPixels(table.merge(glStyleDefaults.sizing.widget, glStyle.sizing.widget),
      { edgeWidth = true },
      { height = true, cornerSize = true } -- Multipliers of the line spacing and of the area's diagonal
   )

   local glFontDefaults:table -- The unscaled font roles, assigned by fonts_data

   import './palettes_data'
   import './fills_data'
   import './fonts_data'
   import './effects'
   import './paths'

@Doc(text=[[
-FUNCTION-
styleDefaults: Returns the library's default style settings, before scaling and configuration.

Returns a fresh copy of the defaults for the `interface`, `sizing` and `fonts` sections of the style configuration.
Sizing values are pixels at 96 DPI and font sizes are points or percentages of `interface.fontSize`, as they are
written in the configuration file.  `interface.dpi` is absent because the display density is detected by default.

Use the result to reset settings, or to write only the values that differ from the defaults.  Changing the copy has
no effect on the library.

-RESULTS-
table: A table with `interface`, `sizing` (`window`, `widget`) and `fonts` sections.
]])
gui.styleDefaults = function():table
   return {
      interface = table.clone(glStyleDefaults.interface),
      sizing    = table.clone(glStyleDefaults.sizing),
      fonts     = table.clone(glFontDefaults)
   }
end

----------------------------------------------------------------------------------------------------------------------
-- Note: This function only needs to be called when shape calculations can't provide their own size limiter.

@Doc(text=[[
@desc Returns the maximum recommended corner size for widgets.
@result The maximum corner size is returned in pixel units.
]])
gui.maxCornerSize = function():num
   return gui.fonts.default.size * .4
end

----------------------------------------------------------------------------------------------------------------------
-- Returns Palette with the user's colour Overrides for it (see paletteColourSection()).  The result is a copy if
-- there are any overrides, so that gui.palettes is unchanged.  Overrides for schemes and keys that the palette lacks,
-- and colours that can't be read, are reported and ignored.

function withPaletteColours(Palette:table!, Overrides:table, Name:str!):table
   if not Overrides or table.empty(Overrides) then return Palette end

   result = { }
   for scheme, variant in Palette do
      result[scheme] = table.clone(variant)
   end

   for scheme, colours in Overrides do
      variant = result[scheme]
      for key, value in colours do
         path = f'style.paletteColours.{Name}.{scheme}.{key}'
         if not variant or (variant[key] is nil) then
            msg(2, f'Style configuration: "{path}" is not a colour of the palette and has been ignored.')
         elseif (value is 'none') or (mVec.ReadPainter(nil, value, glPainter) is ERR_Okay) then
            variant[key] = value
         else
            msg(2, f'Style configuration: invalid colour for "{path}" has been ignored.')
         end
      end
   end

   return result
end

----------------------------------------------------------------------------------------------------------------------
-- Returns Spec if it is a valid fill or effects specification, otherwise reports it and returns nil.

function validIconSpec(Spec:str, Path:str!):str
   if not Spec then return nil end

   try
      gui.parseFill(Spec)
      return Spec
   except ex
      msg(2, f'Style configuration: invalid spec for "{Path}" has been ignored: {ex.message}')
   end
   return nil
end

----------------------------------------------------------------------------------------------------------------------

   if not gui.theme then
      msg('No theme set, loading default from configuration file.')
      gui.theme        = glStyle.style.theme ?? 'light'
      gui.paletteTheme = 'light' -- 'light' or 'dark' only
      gui.palette      = gui.palettes.ocean
      gui.defaultFill  = validIconSpec(glStyle.style.fill, 'style.fill') -- User can override the theme's fill effect
      gui.defaultFX    = validIconSpec(glStyle.style.effects, 'style.effects') -- Post-effect

      palette_name = glStyle.style.palette ?? 'ocean'
      palette_theme = glStyle.style.paletteTheme

      if gui.palettes[palette_name] then
         gui.paletteTheme = gui.palettes[palette_name][palette_theme] ? palette_theme : 'light'
         gui.palette      = withPaletteColours(gui.palettes[palette_name], glStyle.paletteColours[palette_name], palette_name)
      elseif palette_name then
         msg(2, f'Style configuration: unknown palette "{palette_name}" has been ignored.')
      end
   end

----------------------------------------------------------------------------------------------------------------------
-- Returns the icon theme for a theme section: the configured fill, or the section's Default fill, followed by any
-- effects.

function iconTheme(Default:str!, Fill:any, Effects:any):str
   spec = Fill ?? Default
   if Effects?? then return f'{spec} {Effects}' end
   return spec
end

----------------------------------------------------------------------------------------------------------------------
-- Themes work by utilising table.merge() to combine presentation values like fill, stroke and strokeWidth
-- with vector object definitions.  The majority of the time, the target will be a VectorRectangle or VectorText
-- object.  Gradient and pattern fills are also permitted via the use of 'url()'.
--
-- Palette is the scheme's palette variant.  Edge holds the scaled edge width, the corner radius as a fraction of the
-- diagonal (round) and as a percentage string for VectorRectangle corners (corner).  Icon(Default) returns the icon
-- theme for a section.

function darkTheme(Palette:table!, Edge:table!, Icon:func!):table
   return {
      scheme  = 'dark', -- Colour scheme ('light' or 'dark') for code that adapts to the theme's brightness
      palette = Palette,
      init = function(Scene:obj!)
         if Scene.hostScene then return end

         try <trace>
            dot = gui.pixel('6dp')

            if Scene.mtFindDef('dark_vslider') != ERR_Okay then
               pattern = Scene.new('VectorPattern', {
                  name = 'vslider_pattern', width = dot, height = dot * 4,
                  spreadMethod = VSPREAD_PAD, units = VUNIT_USERSPACE
                  aspectRatio = ARF_MEET|ARF_X_MID|ARF_Y_MID, x='50%', y='50%',
                  transform = f'translate(-{dot/2},-{dot*4/2})'
               })

               pattern.viewport.new('VectorPolygon', {
                  strokeWidth = 4, stroke = 'rgb(0 0 0 / .5)', dashArray = array<double> { dot, dot },
                  x1 = '50%', x2 = '50%', y1 = 0, y2 = pattern.height
               })

               check Scene.mtAddDef('dark_vslider', pattern)
            end

            if Scene.mtFindDef('dark_hslider') != ERR_Okay then
               pattern = Scene.new('VectorPattern', {
                  name   = 'hslider_pattern',
                  width  = dot * 3,
                  height = dot,
                  x      = '50%',
                  y      = '50%',
                  spreadMethod = VSPREAD_PAD,
                  units        = VUNIT_USERSPACE
                  aspectRatio  = ARF_MEET|ARF_X_MID|ARF_Y_MID,
                  transform    = f'translate(-{dot*3/2},-{dot/2})'
               })

               pattern.viewport.new('VectorPolygon', {
                  strokeWidth = 4, stroke = 'rgb(0 0 0 / .5)', dashArray = array<double> { dot, dot },
                  y1 = '50%', y2 = '50%', x1 = 0, x2 = pattern.width
               })

               check Scene.mtAddDef('dark_hslider', pattern)
            end
         except ex
            msg(ex.stackTrace)
            raise ex
         end
      end,
      page = {
         bkgd = { -- Background for hosting text & paper-based layouts
            fill = Palette.bkgd
         },
         border = { -- Standard stroke for page borders
            stroke      = 'none', --Palette.edge,
            strokeWidth = 2
         }
         borderFocus = {  -- Stroke to use when 'bkgd' has the user's focus
            stroke      = Palette.contrast,
            strokeWidth = 2
         },
         text = table.merge({ fill = Palette.text }, gui.fonts.page), -- Default colour for text drawn over 'bkgd'
         -- The following are for text colour changes only; face is already defined by text {}
         textHighlight     = Palette.altText,  -- Colour for 'text' during user hover
         textHighlightBkgd = Palette.contrast, -- Background fill for 'text' during user hover
         textSelect        = Palette.altText,  -- Colour for 'text' when selected
         textSelectBkgd    = Palette.prime,    -- Background fill for 'text' when selected
         icon              = Icon('fill(pearl)'), -- Default icon theme for icons drawn over 'bkgd'
         iconHighlight     = Icon('fill(pearl)')  -- Recommended icon theme when highlighted or selected
      },
      statusbar = {
         fill = 'rgb(255 255 255 / .5)',
      },
      list = {
         text              = table.merge({ fill = Palette.text }, gui.fonts.list),
         textHighlight     = Palette.altText,  -- Colour for 'text' during user hover
         textHighlightBkgd = Palette.contrast, -- Background fill for 'text' during user hover
         textSelect        = Palette.altText,  -- Colour for 'text' when selected
         textSelectBkgd    = Palette.prime     -- Background fill for 'text' when selected
      },
      widget = { -- Non-input widgets only (exc. checkbox, combobox, etc.)
         text        = table.merge({ fill = Palette.text }, gui.fonts.widget), -- Widget labels
         bkgd        = { fill = Palette.prime, opacity = 1 },
         stroke      = { stroke = Palette.edge },
         strokeFocus = { stroke = Palette.contrast },
         disabled    = { opacity = 0.5 }
      },
      button = {
         path      = gui.paths.boombox,
         bkgd      = { fill = Palette.bkgd, stroke = Palette.edge, strokeWidth = Edge.width, opacity = 1 },
         highlight = { fill = Palette.contrast },
         focus     = { stroke = Palette.contrast, strokeWidth = Edge.width },
         text      = table.merge({ fill = Palette.text }, gui.fonts.widget),
         disabled  = { },
         primary   = { -- Overrides for buttons created with the primary option
            bkgd      = { fill = Palette.prime, stroke = Palette.prime },
            highlight = { fill = Palette.contrast, stroke = Palette.edge },
            text      = { fill = Palette.altText }
         }
      },
      dropdown = { -- Exclusive to combobox
         bkgd          = { fill = Palette.bkgd, stroke = Palette.edge, strokeWidth=Edge.width, cornerX = Edge.corner, cornerY = Edge.corner },
         highlight     = { fill = Palette.contrast },
         textHighlight = { fill = Palette.altText, fontStyle = gui.fonts.input.style },
         icon          = Icon('fill(pearl)'),
         iconHighlight = Icon('fill(pearl)')
      },
      icon = {
         text = table.merge({ fill = Palette.text }, gui.fonts.icon),
         effect = Icon('fill(pearl)')
      },
      input = { -- Used by checkbox, input, combobox
         bkgd  = { fill = Palette.bkgd, stroke = Palette.edge, strokeWidth = Edge.width, cornerX = Edge.corner, cornerY = Edge.corner, opacity = 1 },
         focus = { stroke = Palette.contrast },
         text  = table.merge({ fill = Palette.text }, gui.fonts.input),
         disabled = { opacity = 0.5 }
      },
      menubar = {
         bkgd      = { fill = Palette.shade },
         text      = table.merge({ fill = Palette.text }, gui.fonts.menu),
         highlight = { fill = Palette.contrast }
         focus     = { fill = Palette.contrast }
         -- 'menu' item reference is inserted post-construction
      },
      menu = {
         bkgd      = { fill = Palette.bkgd }, -- VectorRectangle
         border    = { stroke = Palette.inverse, opacity = 0.5 }, -- VectorRectangle
         highlight = { fill = Palette.contrast }, -- VectorRectangle
         text      = table.merge({ fill = Palette.text }, gui.fonts.menu), -- VectorText
         icon      = Icon('fill(pearl)')
      },
      panel = {
         bkgd          = { fill = Palette.surround, stroke = Palette.edge, strokeWidth = Edge.width, cornerX = Edge.corner, cornerY = Edge.corner },
         header        = { fill = Palette.surround },
         title         = { fill = Palette.text, face = gui.fonts.small.face, size = gui.fonts.small.size, style = 'semi bold' },
         meta          = { fill = Palette.text, face = gui.fonts.small.face, size = gui.fonts.small.size, opacity = 0.7 },
         metaHighlight = { fill = Palette.contrast }, -- Hover style of a clickable meta
         divider       = { fill = Palette.edge },
         headerPad     = gui.sizing.widget.margin * 2, -- Inset of the header content from the panel edges
         metaGap       = gui.sizing.widget.labelGap    -- Minimum space between the title and the meta
      },
      slider = {
         bkgd          = { fill = Palette.mid, stroke = Palette.edge, cornerX = Edge.corner, cornerY = Edge.corner, strokeWidth = Edge.width, opacity = 1 },
         slideFill     = { fill = Palette.handle, stroke = 'none', cornerX = Edge.corner, cornerY = Edge.corner, strokeWidth = Edge.width },
         thumbFill     = { fill = Palette.handle, stroke = 'none', cornerX = Edge.corner, cornerY = Edge.corner, strokeWidth = Edge.width },
         foreHighlight = { fill = Palette.contrast, opacity = 1 },
         foreFocus     = { stroke = Palette.contrast, strokeWidth = Edge.width },
         text          = table.merge({ fill = Palette.text }, gui.fonts.widget),
         tick          = { stroke = Palette.text, strokeWidth = gui.rpixel('1px'), opacity = 0.6 },
         disabled      = { opacity = 0.5 }
      },
      scrollbar_v = {
         bkgd          = { fill = Palette.mid, stroke = 'none', strokeWidth = gui.rpixel('2px') },
         fore          = { fill = f'{Palette.handle};url(#dark_vslider)', stroke = 'none', opacity = 0.75, strokeWidth = gui.rpixel('2px') },
         foreHighlight = { fill = f'{Palette.contrast};url(#dark_vslider)', opacity = 1 },
         thickness     = gui.rpixel('18dp')
      },
      scrollbar_h = {
         bkgd          = { fill = Palette.mid, stroke = 'none', strokeWidth = gui.rpixel('2px') },
         fore          = { fill = f'{Palette.handle};url(#dark_hslider)', stroke = 'none', opacity = 0.75, strokeWidth = gui.rpixel('2px') },
         foreHighlight = { fill = f'{Palette.contrast};url(#dark_hslider)', opacity = 1 },
         thickness     = gui.rpixel('18dp')
      },
      toolbar = {
         bkgd          = { fill = Palette.bkgd },
         groupBorder   = { stroke = Palette.edge, strokeWidth = gui.rpixel('1.5pt') },
         highlight     = { fill = Palette.contrast },
         icon          = Icon('fill(pearl)'),
         iconHighlight = Icon('fill(pearl)')
      },
      tooltip = {
         bkgd = { fill = Palette.bkgd, cornerX = gui.pixel('4pt'), cornerY = gui.rpixel('4pt'), strokeWidth = 2, stroke = Palette.edge },
         text = { fill = Palette.text }
      },
      window = {
         bkgd   = { fill = Palette.neutral },
         text   = table.merge({ fill = Palette.text }, gui.fonts.window),
         stroke = { stroke = modifyAlpha(Palette.text, 0.25), strokeWidth = 2 }, -- Stroking of direct lines/paths (not widget edges)
         icon   = Icon('fill(pearl)'),
         tabPing  = { stroke = 'rgb(220 30 30 / 0.85)', strokeWidth = gui.rpixel('2dp') } -- Tab ping ring
      },
      desktop = {
         bkgd = 'rgb(160 160 160)'
      }
   }
end

function lightTheme(Palette:table!, Edge:table!, Icon:func!):table
   return {
      scheme  = 'light',
      palette = Palette,
      page = {
         bkgd = {
            fill = Palette.bkgd
