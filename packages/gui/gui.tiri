            text      = { fill = Palette.altText }
         }
      },
      dropdown = {
         bkgd          = { fill = Palette.bkgd, stroke = Palette.edge, strokeWidth=Edge.width, cornerX = Edge.corner, cornerY = Edge.corner },
         border        = { stroke = Palette.inverse },
         highlight     = { fill = Palette.contrast },
