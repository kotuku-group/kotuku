@Package(name="gui/input", version="1.0")

--[[
Documentation is available in the Kotuku Wiki.
--]]

   import 'gui', 'gui/layout'

   namespace gui

function reportActivate(State:str!, Force:bool!)
   &events.activate ?! return
   text = &text.string
   hash = text ? string.hash(text) : 0
   if Force or hash != &hash then
      &hash = hash
      &events.activate({ text=text, state=State })
   end
end

-- Count UTF-8 characters rather than bytes.

function charLength(Text:str):num
   total = 0
   for i in {0 to #Text} do
      if (Text.byte(i) & 0xc0) != 0x80 then total++ end
   end
   return total
end

-- Test a string against the input mask.  Empty strings always pass so that the user can clear the box.

function maskAccepts(Text:str!):bool
   if &inputMask and (#Text > 0) then return &inputMask.test(Text) end
   return true
end

-- Commit-time validation, used on Enter and focus loss.  A failure reverts to the last string that passed.

function validateInput()
   if &inputMask then
      userInput = &text.string ?? ''
      if not maskAccepts(userInput) then
         &text.string = &_lastGoodInput
         &_currentText = &_lastGoodInput
         &events?.change({ text=&_lastGoodInput })
         &viewport.acDraw()
         return false
      end
      &_lastGoodInput = userInput
   end
   return true
end

gui.input = function(Options)
   local theme, input_theme

   self = entity { -- Public interface
      events         = Options.events ?? { },
      label          = Options.label,
      labelPos       = Options.labelPos ?? 'left',
      labelAlign     = Options.labelAlign ?? 'left',
      labelWidth     = Options.labelWidth, -- Slot breadth for side labels; defaults to the label's own breadth
      parentViewport = Options.target,
      inputMask      = Options.inputMask ?? regex.new(Options.inputMask) : nil,
      maskMode       = Options.maskMode ?? 'commit', -- 'commit' or 'keystroke'
      maxLength      = Options.maxLength, -- Maximum number of characters (not bytes)
      readOnly       = Options.readOnly ?? false,
      text           = nil, -- A VectorText that represents the string
      viewport       = nil, -- The input box's primary viewport
      _lastGoodInput = Options.text ?? '',
      _currentText   = Options.text ?? ''
   }

   assert(self.maskMode is 'commit' or self.maskMode is 'keystroke', 'maskMode must be "commit" or "keystroke".')

   -- Change the active state of the input box to disabled or enabled

   self.disable = function()
      &disabled = true
      &viewport.acDisable()
      gui.applyStyle(&bkgd, input_theme.disabled)
      &events?.disable()
      &viewport.acDraw()
   end

   self.enable = function()
      &disabled = false
      &viewport.acEnable()
      gui.applyStyle(&bkgd, input_theme.bkgd)
      &events?.enable()
      &viewport.acDraw()
   end

   function checkPlaceholder()
      if &placeholder then
         if &text.string?? then
            &placeholder.visibility = VIS_HIDDEN
         else
            &placeholder.visibility = VIS_VISIBLE
         end
      end
   end

   -- Programmatic changes bypass inputMask, maxLength and events.change.

   self.setText = function(Text:str!)
      &text?.string = Text
      &_currentText = Text
      &_lastGoodInput = Text
      checkPlaceholder()
      &viewport.acDraw()
   end

   self.getText = function():str
      return &text?.string ?? ''
   end

   self.setReadOnly = function(ReadOnly:bool!)
      &readOnly = ReadOnly
      if ReadOnly then
         &text.textFlags = &text.textFlags & ~VTXF_EDITABLE
      else
         &text.textFlags = &text.textFlags | VTXF_EDITABLE
      end
   end

   -- Called by VectorText after every user edit.  Rejected edits are reverted immediately, with the cursor returned
   -- to the edit position.

   function textChanged()
      new_text = &text.string ?? ''
      if new_text is &_currentText then return end

      accept = true
      if &readOnly then -- VectorText does not check VTXF_EDITABLE for deletion keys
         accept = false
      elseif &maxLength and (charLength(new_text) > &maxLength) then
         accept = false
      elseif (&maskMode is 'keystroke') and not maskAccepts(new_text) then
         accept = false
      elseif &events.change and (&events.change({ text=new_text }) is false) then
         accept = false
      end

      if accept then
         &_currentText = new_text
         if &maskMode is 'keystroke' then &_lastGoodInput = new_text end
      else
         column = &text.cursorColumn
         added = charLength(new_text) - charLength(&_currentText)
         &text.string = &_currentText
         if added > 0 then column -= added end
         &text.cursorColumn = math.max(0, column)
         &viewport.acDraw()
      end

      checkPlaceholder()
   end

   -- Main entry point --

   using self do
      assert(Options.target, 'A target viewport is required.')

      theme = gui.getTheme(Options.target)
      input_theme = table.merge(theme.input, Options.theme, true, true)
      gui.layout.checkLabel(&labelPos, &labelWidth, &labelAlign)

      font_max_height, font_height = gui.getFontHeight(gui.fonts.input)
      default_height = math.floor(font_max_height * 1.35) + 1

      vps = { -- Viewport settings
         name    = 'vp_input',
         x       = Options.x,
         y       = Options.y,
         width   = Options.width,
         height  = Options.height ?? default_height,
         xOffset = Options.xOffset,
         yOffset = Options.yOffset
      }

      if not vps.x and not vps.xOffset then vps.x = 0 end
      if not vps.y and not vps.yOffset then vps.y = 0 end
      if not vps.width and not vps.xOffset then vps.width = gui.sizing.widget.width end

      &viewport = &parentViewport.new('VectorViewport', vps)

      -- The box takes the space that remains after the label reservation.  Explicit dimensions include the label, and
      -- default dimensions grow to fit it.

      box = { name = 'vp_input_box', cursor = 'text', x = 0, y = 0, xOffset = 0, yOffset = 0 }

      if &label then
         &_label = gui.layout.label(&viewport, {
            string = &label, pos = &labelPos, align = &labelAlign, width = &labelWidth, style = theme.window.text
         })
         &labelText = &_label.text
         &_label.reserve(box)

         width, height = &_label.expand(&viewport.width, default_height)
         if not Options.width and not Options.xOffset then &viewport.width = width end
         if &_label.stacked and not Options.height then &viewport.height = height end
      end

      box_height = &viewport.height - box.y - box.yOffset

      &inputViewport = &viewport.new('VectorViewport', box)

      if &_label then
         &_label.place(&viewport.width, &viewport.height, box.y, box_height)
         &_label.slot.resizeEvent = function[<weak> self](Viewport, Vector, X, Y, Width, Height)
            &_label.place(Width, Height, box.y, box_height)
         end
      end

      &bkgd = &inputViewport.new('VectorRectangle', table.merge({
         x = 0, y = 0, width = '100%', height = '100%'
      }, input_theme.bkgd))

      &_textClip = &inputViewport.new('VectorViewport', {
         name = 'vp_input_clip',
         x = input_theme.bkgd.strokeWidth, y = input_theme.bkgd.strokeWidth,
         xOffset = input_theme.bkgd.strokeWidth, yOffset = input_theme.bkgd.strokeWidth,
         overflow = VOF_HIDDEN
      })

      if Options.placeholder then
         &placeholder = &_textClip.new('VectorText', table.merge({
            name      = 'vt_placeholder',
            x         = 4,
            y         = math.round(font_height + math.floor((box_height - font_height - (input_theme.bkgd.strokeWidth * 2)) * 0.5)),
            opacity   = 0.5,
            string    = Options.placeholder,
            lineLimit = 1
         }, input_theme.text))

         if Options.text?? then
            &placeholder.visibility = VIS_HIDDEN
         end
      end

      &text = &_textClip.new('VectorText', table.merge({
         name      = 'vt_input',
         x         = 4,
         y         = math.round(font_height + math.floor((box_height - font_height - (input_theme.bkgd.strokeWidth * 2)) * 0.5)),
         face      = gui.fonts.input.face, -- Fallbacks; theme.text normally defines the font
         fontSize  = string.format('%.2fpt', gui.fonts.input.size),
         fontStyle = gui.fonts.input.style,
         string    = Options.text,
         lineLimit = 1,
         textFlags = (function()
            flags = VTXF_EDITABLE -- Required at init for VectorText to support editing; readOnly is applied after
            if Options.secret then flags = flags | VTXF_SECRET end
            return flags
         end)(),
         onChange  = textChanged
      }, input_theme.text))

      if &readOnly then self.setReadOnly(true) end

      if Options.selectAll then &text.mtSelectArea(0, 0, -1, -1) end -- Select all of the text

      &viewport.mtSubscribeFeedback(FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS, function(Viewport:obj!, Event)
         if Event is FM_LOST_FOCUS then
            gui.applyStyle(&bkgd, input_theme.bkgd)
            &events?.lostFocus()
            if validateInput() then
               reportActivate('lost-focus', false)
            end
         else
            &_lastGoodInput = &text.string
            if &disabled then
               gui.applyStyle(&bkgd, input_theme.bkgd)
            else
               gui.applyStyle(&bkgd, input_theme.focus)
               &events?.focus()
            end
         end

         Viewport.acDraw()
      end)

      &_textClip.mtSubscribeKeyboard(function(Viewport:obj!, Qualifiers, Value, Unicode)
         if not (Qualifiers has KQ_PRESSED) then return end

         if (Value is KEY_ENTER) or (Value is KEY_NP_ENTER) then
            validateInput()
            reportActivate('activated', true)
         end

         &events?.keypress({ qualifiers=Qualifiers, value=Value, unicode=Unicode })

         checkPlaceholder()
      end)

      if &events.cursorEntry or &events.cursorExit then
         &inputViewport.mtSubscribeInput(JTYPE_CROSSING, function(Viewport:obj!, Msg)
            repeat
               choose Msg.type from
                  JET_CROSSED_IN -> &events?.cursorEntry()
                  JET_CROSSED_OUT -> &events?.cursorExit()
               end
               Msg = Msg.next
            until not Msg
         end)
      end

      if Options.disabled then &disable() end
      &events?.show()

      return &&
   end
end
