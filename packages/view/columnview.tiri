--[[
The ColumnView API is used to display data to the user in the form of tabulated items.

Documentation is available in the Kotuku Wiki.
--]]

@Package(name="gui/view", version="1.0")

   import 'gui', 'gui/libview'

   namespace gui

rx_datetime <const> = <{ regex.new([[^(\d{4}-\d{1,2}-\d{1,2})[\sT]?(.*)$]]) }>
rx_date <const> = <{ regex.new([[^(\d+)-(\d+)-(\d+)$]]) }>
rx_time <const> = <{ regex.new([[^(\d{2}):(\d{2}):?(\d{0,2})$]]) }>

----------------------------------------------------------------------------------------------------------------------
-- Row and font metrics are stored per view instance, so that views with different fonts do not affect each other.

function computeMetrics(View:table!)
   line_height, font_height, ascent = gui.getFontHeight(View.theme.list.text)
   row_height = math.round(line_height * 1.2)

   View._metrics = {
      lineHeight = row_height,                              -- Height of the banner and of each row
      fontHeight = font_height,
      iconSize   = font_height,
      margin     = math.round(line_height * 0.3),           -- Min space between graphics elements
      iconOffset = math.round((row_height - font_height) * 0.5),
      lineOffset = math.round((row_height + ascent) * 0.5), -- Baseline that centres capitals in the line
      edge       = math.round(row_height * .15)
   }
end

----------------------------------------------------------------------------------------------------------------------
-- Column widths are defined in units that scale with the list font.  Both conversions use the same factor, so that a
-- width reported to the client reproduces the same pixel width when passed back in a column definition.  Unit widths
-- are rounded to 2 decimal places to keep round trips stable.

function columnScale(View:table!):num
   return gui.pixel(tostring(View.theme.list.text.size), 96) -- A theme override can give the size in text form
end

function columnPixels(View:table!, Width:num!):num
   return math.round(Width * columnScale(View))
end

function columnUnits(View:table!, Pixels:num!):num
   return math.round((Pixels / columnScale(View)) * 100) / 100
end

----------------------------------------------------------------------------------------------------------------------

function columnText(Value:any, Type:str):any
   if Value is <table> then
      Value = Value.value
   end

   Value ?! return ''

   if Type is 'bytesize' then
      Value = tonumber(Value)
      Value ?! return ''
      if Value < 1024 then
         return string.format('%.0f', Value)
      elseif Value < 1024 * 1024 then
         return string.format('%.0f KB', Value / 1024)
      elseif Value < 1024 * 1024 * 1024 then
         Value /= (1024 * 1024)
         if Value >= 10 then
            return string.format('%.0f MB', Value)
         else
            return string.format('%.1f MB', Value)
         end
      elseif Value < 1024 * 1024 * 1024 * 1024 then
         return string.format('%.1f GB', Value / (1024 * 1024 * 1024))
      else
         return string.format('%.1f TB', Value / (1024 * 1024 * 1024 * 1024))
      end
   elseif Type is 'date' then
      -- The date type can be expressed as 'YYYY-MM-DD HH:NN', 'YYYY-MM-DD', 'YYYY-MM-DDTHH:NN'.

      local date = struct<DateTime>
      day, time = rx_datetime.extract(Value)
      local y, m, d = rx_date.extract(day)
      date.year, date.month, date.day = tonumber(y), tonumber(m), tonumber(d)

      local h, min, sec = rx_time.extract(time)
      if h then
         date.hour   = tonumber(h ?? '0')
         date.minute = tonumber(min ?? '0')
         date.second = tonumber(sec ?? '0')
      end

      return string.format('%4d-%02d-%02d %02d:%02d', date.year, date.month, date.day, date.hour, date.minute)
   elseif Type is 'numeric' then
      return string.format('%d', (tonumber(Value) ?? 0))
   elseif Type is 'seconds' then
      Value = (tonumber(Value) ?? 0)
      min = Value / 60
      sec = Value % 60
      return string.format('%d:%.2d', min, sec)
   elseif Type is 'float' then
      return string.format('%.3f', (tonumber(Value) ?? 0))
   end

   return Value
end

function raiseFailure(Exception)
   raise(Exception.code ?? ERR_Failed, Exception.message)
end

function setListTextFill(Item:table, Fill)
   if Item._vectors.text then
      Item._vectors.text.fill = Fill
   end
end

-- Cache complete checkbox artwork in scene definitions.  Cell rectangles only switch their fill.

function checkboxPatterns(View:table!, Size:num!):table
   style = View.theme.input.bkgd
   ink = View.theme.input.text.fill
   signature = f'{Size}|{style.fill}|{style.stroke}|{style.strokeWidth}|{style.cornerX}|{style.cornerY}' ..
      f'|{style.opacity}|{ink}'
   prefix = f'column_checkbox_{Size}_{signature.hash()}'
   fills = { }

   for state in {0 to 2} do
      name = f'{prefix}_{state}'
      if View.scene.mtFindDef(name) != ERR_Okay then
         pattern = View.scene.new('VectorPattern', {
            pageWidth = Size, pageHeight = Size, units = VUNIT_BOUNDING_BOX,
            width = '100%', height = '100%', spreadMethod = VSPREAD_PAD
         })
         pattern.viewport.viewWidth = Size
         pattern.viewport.viewHeight = Size
         inset = math.max(1, ((style.strokeWidth is nil ? 1 : style.strokeWidth)) * 0.5)
         pattern.viewport.new('VectorRectangle', {
            x = inset, y = inset, width = Size-inset*2, height = Size-inset*2,
            fill = style.fill, stroke = style.stroke, strokeWidth = (style.strokeWidth is nil ? 1 : style.strokeWidth),
            cornerX = (style.cornerX is nil ? Size*0.15 : style.cornerX),
            cornerY = (style.cornerY is nil ? Size*0.15 : style.cornerY),
            opacity = (style.opacity is nil ? 1 : style.opacity)
         })

         if state is 1 then
            pattern.viewport.new('VectorPath', {
               sequence=f'M{Size*0.25} {Size*0.5} L{Size*0.44} {Size*0.7} L{Size*0.76} {Size*0.3}',
               fill='none', stroke=ink, strokeWidth=math.max(1, Size*0.12)
            })
         end

         check View.scene.mtAddDef(name, pattern)
      end

      fills[state] = f'url(#{name})'
   end

   return fills
end

function checkboxValue(Item:table!, Column:table!):bool
   value:any = Item[Column.attrib]
   if value is <table> then value = value.value end
   return value is true
end

function checkboxX(Column:table!):num
   if Column.align is 'right' then return Column.px_width - Column._checkboxMargin - Column._checkboxSize end
   if Column.align is 'center' then return (Column.px_width - Column._checkboxSize) * 0.5 end
   return Column._checkboxMargin
end

function refreshCheckbox(View:table!, Item:table!, Column:table!)
   cell = Item._col?[Column.attrib]
   cell?.checkbox ?! return

   box = cell.checkbox
   box.x = math.round(checkboxX(Column))
   box.y = Item._y + Column._checkboxOffset
   box.visibility = Item.hidden ? VIS_HIDDEN : VIS_VISIBLE
   box.fill = Column._checkboxFills[checkboxValue(Item, Column) ? 1 : 0]

   disabled = View.disabled or Item.insensitive or Column.disabled
   box.opacity = disabled ? 0.5 : 1

   -- Focus follows the keyboard target, which pointer hover does not change.
   focused = not disabled and View.hasFocus and Item is View.kItem and View.checkboxColumn is Column.attrib

   box.stroke = focused ? (View.theme.input.focus.stroke ?? View.theme.list.textHighlightBkgd) : 'none'
   box.strokeWidth = focused ? 1 : 0
end

-- True if the cell of Attrib is open in the view's editor.  Its text is hidden for the duration of the edit.

function cellEdited(View:table!, Item:table!, Attrib:str!):bool
   local edit = View._edit
   return edit != nil and edit.item is Item and edit.attrib is Attrib
end

-- The x position of a cell's text within its column viewport.  Right-aligned text is anchored at its right edge.

function cellTextX(View:table!, Col:table!):num
   local m = View._metrics
   if Col.align is 'right' then return Col.px_width - m.margin end
   if Col.showIcons then return (m.margin * 2) + m.iconSize + (m.margin * 2) end
   return m.margin
end

-- Creates or updates the text vector of a cell from the item's value.

function updateCellText(View:table!, Item:table!, Col:table!)
   local attrib = Col.attrib
   local cell = Item._col[attrib]
   local vis = (Item.hidden or cellEdited(View, Item, attrib)) ? VIS_HIDDEN : VIS_VISIBLE
   local y = Item._y + View._metrics.lineOffset

   if not cell.text then
      cell.text = Col.vecViewport.new('VectorText', {
         name       = f'text_{attrib}',
         align      = Col.align ?? 'left',
         y          = y,
         fontStyle  = gui.fontStyle(View.theme.list.text),
         visibility = vis
      })
      Item._vectors['_a_' .. attrib] = cell.text -- Referenced for future termination
   else
      cell.text.y = y
      cell.text.visibility = vis
   end

   cell.text.x = cellTextX(View, Col)
   cell.text.string = columnText(Item[attrib], Col.type)
end

function highlightItem(View:table!, Item:table, Highlighted:bool)
   for col in values(View.columns) do
      if col.checkBoxes then refreshCheckbox(View, Item, col) end
   end

   if not Item._vectors.highlight and (Highlighted or Item._selected) then
      local radius = View._metrics.lineHeight * 0.2
      Item._vectors.highlight = Item._vectors.viewport.new('VectorRectangle', {
         name = 'item_highlight',
         cornerX = radius, cornerY = radius,
         x = 0, y = 0, width = '100%', height = '100%'
      })
      Item._vectors.highlight.acMoveToBack()
   end

   if Highlighted then
      if Item._selected then -- Both selected AND highlighted
         for k, col in pairs(Item._col) do
            col.text?.fill = View.namedCol[k].fillItemSelect
         end

         Item._vectors.highlight.{
            fill        = View.theme.list.textSelectBkgd,
            stroke      = View.theme.list.textHighlightBkgd,
            strokeWidth = 2
         }

         if Item._vectors.iconImage and Item._iconHighlight then
            Item._vectors.iconImage.fill = Item._iconHighlight
         end
      else -- Highlighted
         for k, col in pairs(Item._col) do
            col.text?.fill = View.namedCol[k].fillItemSelect
         end

         Item._vectors.highlight.{ fill = View.theme.list.textHighlightBkgd, strokeWidth = 0 }
         if Item._vectors.iconImage and Item._iconHighlight then
            Item._vectors.iconImage.fill = Item._iconHighlight
         end
      end
   elseif Item._selected then
      for k, col in pairs(Item._col) do
         col.text?.fill = View.namedCol[k].fillItemSelect
      end

      Item._vectors.highlight.{ fill = View.theme.list.textSelectBkgd, strokeWidth = 0 }
      if Item._vectors.iconImage and Item._iconHighlight then
         Item._vectors.iconImage.fill = Item._iconHighlight
      end
   else
      if Item.fill then
         for k, col in pairs(Item._col) do
            col.text?.fill = Item.fill
         end
      else
         for k, col in pairs(Item._col) do
            if col.text then
               if View.namedCol[k] then
                  col.text.fill = View.namedCol[k].fillItem
               else
                  msg('No fillItem defined for ' .. k .. ' in View.namedCol')
               end
            end
         end
      end

      Item._vectors.iconImage?.fill = Item._iconFill

      Item._vectors.highlight?.free()
      Item._vectors.highlight = nil
   end
end

-- Calls the constructCell() hook of every custom cell of an item that has been created, in column order.  Cells
-- that were never created, e.g. after a failed 'create', are skipped.  Every cell is attempted, and the first failure
-- is raised afterwards.

function dispatchCells(View:table!, Item:table!, Reason:str!)
   local failure:any = nil
   for col in values(View.columns) do
      if not col.constructCell then continue end
      local cell = Item._col?[col.attrib]
      if not cell?.created then continue end
      try
         View._dispatch(col.constructCell, Item, cell.cellViewport, Reason, col)
      except e
         failure ?= e
      end
   end

   if failure then raiseFailure(failure) end
end

-- Notifies custom cells whose size has changed since they were last notified with 'layout'.  The cell viewports are
-- already resized by the caller; this only informs the client.  Every cell is attempted, and the first failure is
-- raised afterwards.

function notifyCellGeometry(View:table!)
   local height = View._metrics.lineHeight
   local failure:any = nil
   for item in values(View.items) do
      for col in values(View.columns) do
         if not col.constructCell then continue end
         local cell = item._col?[col.attrib]
         if not cell?.created then continue end
         if (cell._cellWidth is col.px_width) and (cell._cellHeight is height) then continue end

         cell.{ _cellWidth = col.px_width, _cellHeight = height }

         try
            View._dispatch(col.constructCell, item, cell.cellViewport, 'layout', col)
         except e
            failure ?= e
         end
      end
   end
   if failure then raiseFailure(failure) end
end

-- Schedules notifyCellGeometry() for the next message cycle, so that a column drag sends one 'layout' per cell.

function scheduleCellGeometry(View:table!)
   if View._geometryPending then return end
   View._geometryPending = true
   processing.delayedCall(function()
      View._geometryPending = false
      if not View.viewport or not View.columns then return end
      notifyCellGeometry(View)
   end)
end

-- Brings Item.viewState up to date and notifies the item's custom cells of a change with 'state'.  The highlight and
-- checkboxes are redrawn if the state changed, or if Force is set.  Otherwise only the checkboxes are refreshed,
-- because their focus also depends on the active checkbox column, which is not part of viewState.

function syncState(View:table!, Item:table!, Force:bool)
   if Item.viewState is nil then return end -- The item has not been built yet

   local changed = View._updateViewState(Item)
   if changed then dispatchCells(View, Item, 'state') end

   if changed or Force then
      highlightItem(View, Item, Item is View.hItem)
   else
      for col in values(View.columns) do
         if col.checkBoxes then refreshCheckbox(View, Item, col) end
      end
   end
end

-- The sort icon sits at the opposite end of the banner to the column's title.

function positionSortIcon(View:table!)
   local m = View._metrics
   local col = View._sort.col
   View._sort.icon.x = (col.align is 'right' ? m.margin : col.px_width - m.margin - m.iconSize) - View._sort.margin
end

function arrangeColumns(View:table!)
   local m = View._metrics
   View.banner.lines.acClear()

   pc = struct<PathCommand>
   for col in values(View.columns) do
      col.vecTitle.x = col.align is 'right' ? col.px_width - m.margin : m.margin

      pc.{ type = PE_Move, x = col.x + col.px_width, y = 1 }
      View.banner.lines.mtAddCommand(pc)

      pc.{ type = PE_Line, x = col.x + col.px_width, y = m.lineHeight }
      View.banner.lines.mtAddCommand(pc)

      col.bannerVP.{ x = col.x, width = col.px_width }
      if col.checkBoxes then
         for item in values(View.items) do
            refreshCheckbox(View, item, col)
         end
      end

      col.{ fillItem = View.theme.list.text.fill, fillItemSelect = View.theme.list.textHighlight }
   end

   if View._sort?.icon then positionSortIcon(View) end

   if View.scrollbar then
      page_width = 0
      for col in values(View.columns) do
         page_width = col.x + col.px_width + m.edge
      end

      View.scrollbar.setDynamicPageSize(page_width, page_width, View.page.height)
   end
end

-- Apply the sort direction icon to the banner's sort indicator.  Pattern names are derived from the icon theme, so a
-- theme change creates new patterns.

function styleSortIcon(View:table!)
   local m = View._metrics
   path = View._sort.ascending ? 'layout/sort_alpha_asc' : 'layout/sort_alpha_desc'
   sort_icon = gui.createIcon(View.scene, path, m.iconSize, View.theme.window.icon)
   View._sort.margin = sort_icon.margin
   View._sort.icon.{
      fill   = sort_icon.fill,
      y      = math.round((m.lineHeight - m.iconSize) * 0.5) - sort_icon.margin,
      width  = m.iconSize + (sort_icon.margin * 2),
      height = m.iconSize + (sort_icon.margin * 2)
   }
end

-- Build the normal and highlight icon fills of an item for the current theme.

function itemIconStyle(View:table!, Item:table!)
   local theme = Item.iconTheme ?? View.theme.page.icon
   local size  = View._metrics.iconSize
   local uid   = f'{gui.parseFill(theme).key}+{Item.icon}'
   local info  = gui.createIcon(View.scene, Item.icon, size, theme, uid)
   Item.{ _iconFill = info.fill, _iconMargin = info.margin, _iconHighlight = nil }

   if View.theme.page.iconHighlight and View.theme.page.iconHighlight != theme then
      theme = View.theme.page.iconHighlight
      uid   = f'{gui.parseFill(theme).key}+{Item.icon}'
      Item._iconHighlight = gui.createIcon(View.scene, Item.icon, size, theme, uid).fill
   end
end

-- Applies the item's icon style to its icon image and positions the image in the item's row.

function placeItemIcon(View:table!, Item:table!)
   local m = View._metrics
   Item._vectors.iconImage.{
      fill   = Item._iconFill,
      x      = (m.margin * 2) - Item._iconMargin,
      y      = Item._y + m.iconOffset - Item._iconMargin,
      width  = m.iconSize + (Item._iconMargin * 2),
      height = m.iconSize + (Item._iconMargin * 2)
   }
end

-- Creates the viewport of a custom cell on first use and notifies the client with 'create', or with 'update' if the
-- cell exists.  The viewport is registered in Item._vectors so that Item._free() releases it.  The cell is marked as
-- created only once 'create' succeeds, so that a failed cell does not receive 'destroy'.

function updateCustomCell(View:table!, Item:table!, Col:table!)
   local cell = Item._col[Col.attrib]
   if cell.cellViewport then
      if cell.created then
         View._dispatch(Col.constructCell, Item, cell.cellViewport, 'update', Col)
      end
      return
   end

   cell.cellViewport = Col.vecViewport.new('VectorViewport', {
      name       = '_cell_' .. Col.attrib,
      x          = 0,
      y          = Item._y,
      width      = Col.px_width,
      height     = View._metrics.lineHeight,
      overflow   = VOF_HIDDEN,
      visibility = Item.hidden ? VIS_HIDDEN : VIS_VISIBLE
   })

   Item._vectors['_cell_' .. Col.attrib] = cell.cellViewport
   cell.{ _cellWidth = Col.px_width, _cellHeight = View._metrics.lineHeight }

   View._dispatch(Col.constructCell, Item, cell.cellViewport, 'create', Col)
   cell.created = true
end

-- Notifies every created custom cell of an item with 'destroy', in column order, while the cell viewports are still
-- valid.  Every cell is notified even if one fails; the first failure is returned.

function destroyCells(View:table!, Item:table!):any
   local failure:any = nil
   for col in values(View.columns ?? { }) do
      local cell = Item._col?[col.attrib]
      if not cell?.created then continue end
      cell.created = nil

      try
         View._dispatch(col.constructCell, Item, cell.cellViewport, 'destroy', col)
      except e
         failure ?= e
      end
   end
   return failure
end

-- Creates or updates the icon, checkboxes and text of every cell of an item.  Text is created for cells that have a
-- value; a cell that already has text keeps it when its value is removed.  Custom cells replace the icon and text.

function updateCells(View:table!, Item:table!)
   local vis = Item.hidden ? VIS_HIDDEN : VIS_VISIBLE

   for col in values(View.columns) do
      local attrib = col.attrib
      Item._col[attrib] ?= { }

      if col.constructCell then
         updateCustomCell(View, Item, col)
         continue
      end

      if not col.checkBoxes and col.showIcons then
         if Item.icon then
            try
               itemIconStyle(View, Item)
               if not Item._vectors.iconImage then
                  Item._vectors.iconImage = col.vecViewport.new('VectorRectangle', { name = 'item_icon' })
               end
               placeItemIcon(View, Item)
               Item._vectors.iconImage.visibility = vis
            end
         elseif Item._vectors.iconImage then
            Item._vectors.iconImage.free()
            Item._vectors.iconImage = nil
         end
      end

      if col.checkBoxes then
         local cell = Item._col[attrib]
         if not cell.checkbox then
            cell.checkbox = col.vecViewport.new('VectorRectangle', {
               name=f'checkbox_{attrib}', width=col._checkboxSize, height=col._checkboxSize
            })
            Item._vectors['_check_' .. attrib] = cell.checkbox
         end

         refreshCheckbox(View, Item, col)
      elseif Item[attrib]?? or Item._col[attrib].text then
         updateCellText(View, Item, col)
      end
   end
end

function bannerZoneClick(View, Col, X, Y, Value)
   if Value is 1 then return end

   -- The user's edit is committed before the sort, which may depend on its value.  The client's itemEdited() can
   -- change the view, so the column is checked again afterwards.

   if View._edit then
      View._commitEdit()
      if not View.viewport or (View.namedCol?[Col.attrib] != Col) then return end
   end

   if View._sort and View._sort.icon then
      View._sort?.icon?.free()
      View._sort.icon = nil
   end

   if View._sort and (View._sort.col is Col) and (View._sort.ascending is true) then
      View._sort = { col=Col, ascending=false }
      if not View.iconDescending then
         View._sort.icon = Col.bannerVP.new('VectorRectangle', { name = 'banner_sort' })
         styleSortIcon(View)
      end
   else
      View._sort = { col=Col, ascending=true }
      if not View.iconAscending then
         View._sort.icon = Col.bannerVP.new('VectorRectangle', { name = 'banner_sort' })
         styleSortIcon(View)
      end
   end

   if View._sort.icon then positionSortIcon(View) end

   View.sortColumn(View, Col, View._sort.ascending)
   View.viewport.acDraw()
end

-- Set correct item coordinates after a sort operation

function rearrangeItems(View)
   VSPACING <const> = gui.rpixel('2dp')
   local m = View._metrics
   View.zones = { }
   View._last_y = m.edge
   y = m.edge
   for item in values(View.items) do
      item._y = y
      if item._vectors.viewport then
         vis = item.hidden ? VIS_HIDDEN : VIS_VISIBLE

         item._vectors.viewport.visibility = vis
         item._vectors.iconImage?.visibility = vis

         for col in values(View.columns) do
            local cell = item._col?[col.attrib]
            if cell?.text then cell.text.visibility = cellEdited(View, item, col.attrib) ? VIS_HIDDEN : vis end
            if cell?.cellViewport then cell.cellViewport.{ y = y, visibility = vis } end
            if col.checkBoxes then refreshCheckbox(View, item, col) end
         end

         item._vectors.viewport.y = y
      end

      item._vectors.iconImage?.y = y + m.iconOffset - item._iconMargin

      for col in values(View.columns) do
         item._col?[col.attrib]?.text?.y = y + m.lineOffset
      end

      if not item.hidden then
         View.addZone(0, item._y, nil, m.lineHeight, item)
         y += m.lineHeight + VSPACING
      end
   end

   View._last_y = y
   View.page.height = y + m.edge
   if View._updateEdit then View._updateEdit() end -- The edited item may have moved
   View.scene.surface.mtScheduleRedraw()
end

----------------------------------------------------------------------------------------------------------------------

gui.columnView = function(Options):table
   lDestroyHook = Options.destroyItem
   assert(lDestroyHook is nil or lDestroyHook is <func>, 'destroyItem must be a function')
   assert(Options.columnResized is nil or Options.columnResized is <func>, 'columnResized must be a function')

   -- Custom cells are drawn by the client, and checkbox columns are toggled; neither can be edited in place.  The
   -- check is repeated by setColumns(), and must pass before the view is changed.

   function validateColumns(Columns:any, Editable:any)
      if not Columns then return end

      for col in values(Columns) do
         if col.constructCell != nil then
            assert(col.constructCell is <func>, f'constructCell of column "{col.attrib}" must be a function')
            assert(not col.checkBoxes, f'constructCell cannot be combined with checkBoxes in column "{col.attrib}"')
         end

         if (Editable is <array str>) and (Editable.indexOf(col.attrib) != nil) then
            if col.checkBoxes then raise f'editable attribute "{col.attrib}" names a checkbox column' end
            if col.constructCell then raise f'editable attribute "{col.attrib}" names a custom cell column' end
         end
      end
   end

   validateColumns(Options.columns, Options.editable)

   -- Records the width of a column that the user has resized, in definition units, and reports it to the client.
   -- The entry is keyed by attrib and survives setColumns(), rebuild() and clearView().

   function userResized(View:table!, Col:table!)
      local width = columnUnits(View, Col.px_width)
      View._userWidths[Col.attrib] = { width = width, base = Col.width }
      if Options.columnResized then View._dispatch(Options.columnResized, View, Col.attrib, width) end
   end

   -- Replaces the columns.  Custom cells receive 'destroy' while the old column viewports are valid.  The first
   -- cleanup failure is returned for the caller to raise once the new columns have been populated.

   function setColumns(View:table!, Columns):any
      validateColumns(Columns, View.editable)

      -- The column viewports host the editor, and are replaced below.

      View._cancelEdit?()

      local m = View._metrics
      sort = View._sort
      View._sort = nil
      c   = 0
      set = { }
      View.namedCol = { }
      for col in values(Columns) do
         assert(col['attrib'], 'No attrib defined for column ' .. c)

         new_col = { _index=c, width=8, title='Untitled' }
         for k, v in pairs(col) do new_col[k] = v end
         if new_col.checkBoxes then
            new_col.{
               _checkboxSize   = math.max(4, math.round(m.fontHeight)),
               _checkboxMargin = m.margin,
               _checkboxOffset = math.round((m.lineHeight - new_col._checkboxSize) * 0.5),
               _checkboxFills  = checkboxPatterns(View, new_col._checkboxSize)
            }
         end

         set.insert(new_col)
         View.namedCol[col['attrib']] = new_col
         c++
      end

      failure:any = nil
      if View.columns then -- Clear cell references before freeing their owning column viewports.
         for item in values(View.items) do
            local err = destroyCells(View, item)
            failure ?= err

            for col in values(View.columns) do
               item._col?[col.attrib] = nil
               item._vectors['_a_' .. col.attrib]     = nil
               item._vectors['_check_' .. col.attrib] = nil
               item._vectors['_cell_' .. col.attrib]  = nil
            end
            item._vectors.iconImage = nil
         end

         for col in values(View.columns) do
            col.vecViewport?.free()
            col.vecGradient?.free()
            col.vecGradientSelect?.free()
            col.vecTitle?.free()
         end
      end

      View.columns = set
      if not View.namedCol[View.checkboxColumn]?.checkBoxes then
         View.checkboxColumn = nil
         for col in values(set) do
            if col.checkBoxes then View.checkboxColumn = col.attrib; break end
         end
      end

      View.reserveTop('ViewUI', m.lineHeight)
      View.banner?.clip?.free()
      View.banner = { }

      -- Background graphics

      View.banner.clip = View.viewport.new('VectorViewport', {
         name = 'banner_clip',
         x = 0, y = View.frame.y - m.lineHeight, width = '100%', height = m.lineHeight, overflow = VOF_HIDDEN
      })

      View.banner.viewport = View.banner.clip.new('VectorViewport', {
         name = 'banner_vp', x = 0, y = 0, width = '100%', height = m.lineHeight, overflow = VOF_HIDDEN
      })

      View.banner.lines = View.banner.viewport.new('VectorPath', table.merge({
         name = 'banner_lines', strokeWidth = 1
      }, View.theme.window.stroke))

      View.banner.viewport.mtSubscribeInput(JTYPE_MOVEMENT|JTYPE_BUTTON, function(Viewport, Events)
         ev = Events
         while ev do
            if ev.type is JET_BUTTON_1 then
               if ev.flags has JTYPE_REPEATED then return end

               for col in values(View.columns) do
                  if (ev.x >= col.x+2) and (ev.x < col.x + col.px_width-2) then
                     bannerZoneClick(View, col, ev.x, ev.y, ev.value)
                     break
                  end
               end
            end
            ev = ev.next
         end
      end)

      -- Draw column text and separators

      x = 0
      prev = nil
      for col in values(View.columns) do
         if prev then
            prev.next = col
            col.prev = prev
         end

         col.x = x
         col.minWidth = x + m.margin

         -- A width set by the user is kept while the definition's width is unchanged.  A new width in the definition
         -- is a deliberate reset by the client, and replaces the user's width.

         local width = col.width
         local user = View._userWidths[col.attrib]
         if user then
            if user.base is col.width then width = user.width
            else View._userWidths[col.attrib] = nil end
         end

         col.px_width = columnPixels(View, width)

         if not col.bannerVP then
            -- Each banner viewport hosts the title and sorting icon
            col.bannerVP = View.banner.viewport.new('VectorViewport', {
               name = 'col_banner_vp',
               x = x, y = 0, width = col.px_width, height = '100%', overflow = VOF_HIDDEN
            })

            col.vecViewport = View.page.new('VectorViewport', {  -- The column VP hosts all page text for the column
               name = 'col_content',
               x = x, y = 0, width = col.px_width, height = '100%', overflow = VOF_HIDDEN
            })

            -- Column title

            col.vecTitle = col.bannerVP.new('VectorText', {
               name  = 'col_title',
               align = col.align ?? 'left',
               y     = m.lineOffset,
               fontStyle = gui.fontStyle(View.theme.list.text)
            })

            -- Support for resize management

            col.resizeVP = View.banner.viewport.new('VectorViewport', {
               name   = 'col_resize_zone',
               x      = x + col.px_width - (m.margin * 0.5),
               y      = 0,
               width  = m.margin,
               height = '100%',
               cursor = PTC_SPLIT_HORIZONTAL
            })

            col.resizeVP.dragCallback = function(SizeVP, X, Y)
               -- Rearrange layout
               local margin = View._metrics.margin
               delta_x = X - SizeVP.x
               col.px_width += delta_x
               if col.px_width < margin then col.px_width = margin end
               col.vecViewport.width = col.px_width

               -- Custom cells are resized now so that they clip correctly, but the client is told once per cycle.

               if col.constructCell then
                  for item in values(View.items) do
                     item._col?[col.attrib]?.cellViewport?.width = col.px_width
                  end
                  scheduleCellGeometry(View)
               end

               scan = col.next
               new_x = col.x + col.px_width
               while scan do
                  scan.x = new_x
                  scan.resizeVP.x = new_x + scan.px_width - (margin * 0.5)
                  scan.vecViewport.x = new_x
                  new_x += scan.px_width
                  scan = scan.next
               end

               arrangeColumns(View)

               if View.scrollbar then
                  page_width = new_x + (View._metrics.edge * 2)
                  View.scrollbar.setDynamicPageSize(page_width, page_width, View.page.height)
               end

               if col.align is 'right' then -- Realign all text in this column
                  align_x = col.px_width - margin
                  for item in values(View.items) do
                     item._col?[col.attrib]?.text?.x = align_x
                  end
               end

               if View._updateEdit then View._updateEdit() end

               SizeVP.x = col.x + col.px_width - (margin * 0.5)
               SizeVP.acDraw()
            end

            -- dragCallback reports movement only.  The zone also receives the button release that ends the drag, so
            -- the user's width is recorded once per completed resize.  This subscription follows the one installed
            -- by dragCallback, so the drag's final movement has been applied before the release is seen here.

            col.resizeVP.mtSubscribeInput(JTYPE_BUTTON, function(Viewport, Events)
               local ev:any = Events
               while ev do
                  if (ev.type is JET_LMB) and not (ev.flags has JTYPE_REPEATED) then
                     if ev.value > 0 then
                        col._dragStartWidth = col.px_width
                     elseif col._dragStartWidth != nil then
                        local start = col._dragStartWidth
                        col._dragStartWidth = nil
                        if col.px_width != start then userResized(View, col) end
                     end
                  end
                  ev = ev.next
               end
            end)
         else
            col.bannerVP.{ x = x, width = col.px_width }
            col.vecViewport.{ x = x, width = col.px_width }
         end

         col.vecTitle.string = col['title'] ?? 'Untitled'

         x += col.px_width
         prev = col
      end

      arrangeColumns(View)

      if not View.columnsInitialised then
         -- Ensure that the column banner is always aligned with the page.

         View.page.mtSubscribeFeedback(FM_PATH_CHANGED, function(Viewport, Event)
            if not View.banner?.viewport or not View.viewport then return end
            View.banner.viewport.x = View.page.x

            page_width = View.page.width
            frame_width = View.viewport.width
            View.banner.clip.width = page_width > frame_width ? page_width : frame_width
         end)

         View.frame.mtSubscribeFeedback(FM_PATH_CHANGED, function(Viewport, Event)
            if not View.banner?.clip then return end
            View.banner.clip.y = View.frame.y - View._metrics.lineHeight
         end)
      end

      View.columnsInitialised = true;
      if sort and View.namedCol[sort.col.attrib] then
         col = View.namedCol[sort.col.attrib]
         View._sort = { col=col, ascending=not sort.ascending }
         bannerZoneClick(View, col, 0, 0, 0)
      end

      return failure
   end

   -- Builds the row viewport, state and cells of an item at row position Y.

   function buildItem(View:table!, Item:table!, Y:num!, Width:num!)
      local m = View._metrics
      local vis = Item.hidden ? VIS_HIDDEN : VIS_VISIBLE

      Item._y = Y

      -- Each item gets a viewport within the page

      if not Item._vectors.viewport then
         Item._vectors.viewport = View.page.new('VectorViewport', {
            name = 'item_vp', x = m.edge, y = Y, xOffset = m.edge, height = m.lineHeight, visibility = vis
         })
      else
         Item._vectors.viewport.{ y = Y, width = Width, visibility = vis }
      end

      -- The state is current before any cell is built, so that custom cells can read it in 'create'.

      Item.viewState = { selected=false, highlighted=false, focused=false, disabled=false }
      View._updateViewState(Item)

      Item._highlightEvent = function(View, Item, Highlighted)
         syncState(View, Item, true)
      end

      Item._selectEvent = function(View, Item)
         syncState(View, Item, true)
      end

      updateCells(View, Item)
      highlightItem(View, Item, Item is View.hItem)
   end

   -- Process new items that have been added to the view.  An item whose cells cannot be built is removed from the
   -- view, which releases its created cells with 'destroy' and calls destroyItem().  The other items are built and laid
   -- out, then the first failure is raised.

   function newItems(View:table!, Items)
      View.columns ?! return
      Items ?! return

      VSPACING <const> = gui.rpixel('2dp')
      local m = View._metrics

      width = View.frame.width - (m.edge * 2)
      y = View._last_y

      local failure:any = nil
      local failed = array<table>

      for item in values(Items) do
         item._vectors ?= { }
         item._col ?= { }

         local built = true
         try
            buildItem(View, item, y, width)
         except e
            failure ?= e
            failed.push(item)
            built = false
         end

         if built and not item.hidden then
            View.addZone(0, item._y, nil, m.lineHeight, item)
            y += m.lineHeight + VSPACING
         end
      end

      View._last_y = y
      View.page.height = y + m.edge

      for col in values(View.columns) do
         col.vecViewport.acMoveToFront()
      end

      -- removeItem() keeps the selection, keyboard target and zones consistent, and lays out the remaining rows.  A
      -- cleanup failure for a failed item is reported, but the creation failure takes precedence.

      for item in values(failed) do
         try
            View.removeItem(item)
         except e
            msg(f'Cleanup of a column view item that failed to build has also failed: {e.message}')
         end
      end

      if failure then raiseFailure(failure) end
   end

   -- Callback function for constructing the view from scratch.  Can be called multiple times.  Custom cells receive
   -- 'destroy' and then 'create', because the column viewports are replaced.  A creation failure is raised in
   -- preference to a cleanup failure.

   function constructColumnView(View)
      computeMetrics(View)
      local failure:any = setColumns(View, Options.columns ?? { })
      View.zones = { }

      View._last_y = View._metrics.edge
      if #View.items > 0 then
         try
            newItems(View, View.items)
         except e
            failure = e
         end
      end

      processing.collect()

      if failure then
         View._afterLayout?() -- rebuild() does not complete the layout if this raises
         raiseFailure(failure)
      end
   end

   -- Lifecycle hooks are installed before any initial items are built.

   function prepareView(View:table!)
      View._userWidths = { } -- Column widths set by the user, keyed by attrib.  Never reset by a rebuild.

      -- Rows are laid out again in place after a structural change, e.g. removeItem(), so that the scroll position and
      -- an open edit are kept.

      View._relayout = function()
         if View.columns then rearrangeItems(View) end
      end

      -- Client cleanup: 'destroy' for each created custom cell, then destroyItem(), while the viewports are still
      -- valid.  Every hook is attempted, and the first failure is returned to the caller for reporting.

      View._releaseItem = function(Item:table!, Viewport:obj!):any
         local failure:any = destroyCells(View, Item)

         if lDestroyHook then
            try
               View._dispatch(lDestroyHook, Item, Viewport)
            except e
               failure ?= e
            end
         end

         return failure
      end
   end

   vw = gui.initView(Options, constructColumnView, newItems, prepareView)

   function resolveColumn(Column:any!):table
      if Column is <str> then return vw.namedCol[Column] end
      if Column is <num> then return vw.columns[Column] end
      for col in values(vw.columns) do
         if Column is col then return col end
      end
   end

   function setCheckbox(Item:table!, Column:table!, Checked:bool!, Reason:str!):bool
      if checkboxValue(Item, Column) is Checked then return false end
      if Item[Column.attrib] is <table> then Item[Column.attrib].value = Checked
      else Item[Column.attrib] = Checked end
      Item._col?[Column.attrib]?.checkbox?.fill = Column._checkboxFills[Checked ? 1 : 0]
      vw.scene.surface.mtScheduleRedraw()
      vw.events?.itemChecked(vw, Reason, Item, Column, Checked)
      return true
   end

   -- Change a checkbox programmatically.  Column accepts an attrib, zero-based index or column reference.
   vw.setChecked = function(Item:table!, Column:any!, Checked:bool!):bool
      assert(not vw._dispatching, 'Render callbacks must not modify the view structure; defer the change')
      col = resolveColumn(Column)
      assert(col?.checkBoxes, 'Column is not a checkbox column')
      assert(vw.lookup[Item._id] is Item, 'Item does not belong to this view')
      return setCheckbox(Item, col, Checked, 'manual')
   end

   -- Focus, enable and disable change the state of every item.

   vw._stateChanged = function()
      for item in values(vw.items) do syncState(vw, item) end
      vw.scene.surface.mtScheduleRedraw()
   end

   -- Recolours the banner, the column titles, the item text, highlights and checkboxes, and rebuilds the icons for the
   -- current theme.  Custom cells receive 'update' before the highlight is redrawn.  Fonts, the line height and the
   -- column widths are not changed.  Every item is restyled even if a custom cell fails; the first failure is raised
   -- afterwards.

   vw._restyle = function()
      vw.columns ?! return
      local failure:any = nil

      gui.applyStyle(vw.banner.lines, vw.theme.window.stroke)

      for col in values(vw.columns) do
         col.vecTitle.fill  = vw.theme.list.text.fill
         col.fillItem       = vw.theme.list.text.fill
         col.fillItemSelect = vw.theme.list.textHighlight
         if col.checkBoxes then col._checkboxFills = checkboxPatterns(vw, col._checkboxSize) end
      end

      if vw._sort?.icon then
         styleSortIcon(vw)
         positionSortIcon(vw)
      end

      for item in values(vw.items) do
         if item._vectors?.iconImage then
            try
               itemIconStyle(vw, item)
               placeItemIcon(vw, item)
            except e
               msg(f'Failed to restyle view icon "{item.icon}": {e.message}')
            end
         end

         if item.viewState != nil then
            try
               dispatchCells(vw, item, 'update')
            except e
               failure ?= e
            end
         end

         syncState(vw, item, true)
      end

      if failure then raiseFailure(failure) end
   end

   ----------------------------------------------------------------------------------------------------------------
   -- In-place editing hooks; the session is managed by libview.  The editor is a child of the column viewport, which
   -- clips it to the column and scrolls it with the page.  Its text starts where a left-aligned cell's text does; an
   -- editor always holds left-aligned text, including in right-aligned columns.

   vw._editGeometry = function(Item:table!, Attrib:str!):table
      local col = vw.namedCol?[Attrib]
      if not col or col.checkBoxes or not col.vecViewport or not Item._vectors?.viewport or (Item._y is nil) then
         return
      end
      local m = vw._metrics
      return {
         host     = col.vecViewport,
         textX    = col.showIcons ? (m.margin * 2) + m.iconSize + (m.margin * 2) : m.margin,
         baseline = Item._y + m.lineOffset,
         y        = Item._y,
         height   = m.lineHeight,
         span     = { x = col.x, width = col.px_width },
         theme    = { text = vw.theme.list.text }
      }
   end

   vw._editTextVector = function(Item:table!, Attrib:str!):obj
      return Item._col?[Attrib]?.text
   end

   vw._editCommitted = function(Item:table!, Attrib:str!)
      local col = vw.namedCol?[Attrib]
      if not col or not Item._col?[Attrib] then return end
      updateCellText(vw, Item, col) -- Also creates the text of a cell that had no value
      syncState(vw, Item, true)
      vw.scene.surface.mtScheduleRedraw()
   end

   -- Tab walks the editable columns in display order.

   vw._editOrder = function():array<any>
      local order = array<str>
      for col in values(vw.columns ?? { }) do
         if vw._editableSet[col.attrib] and not col.checkBoxes then order.push(col.attrib) end
      end
      return order
   end

   -- A double-click on the text of an editable cell starts an edit and is claimed, so that the item is not activated.
   -- Returns nil if the click is not on editable text.

   function editClick(Item:table!, Input:table!):bool
      for col in values(vw.columns) do
         if (Input.x < col.x) or (Input.x >= col.x + col.px_width) then continue end
         if col.checkBoxes or not vw._editableSet[col.attrib] then return end

         local text = Item._col?[col.attrib]?.text
         if not text or (text.visibility != VIS_VISIBLE) then return end

         local _, _, _, width = text.mtGetBoundary(0)
         local left = col.x + text.x - ((col.align is 'right') ? width : 0)
         if (Input.x < left) or (Input.x >= left + width) then return end
         if (Input.y < Item._y) or (Input.y >= Item._y + vw._metrics.lineHeight) then return end

         return vw._beginEdit(Item, col.attrib, 'user')
      end
   end

   -- Use row hit testing for all checkbox columns, without per-cell input subscriptions.

   vw._itemClick = function(Item:table, Input:table):bool
      if Input.value is 0 and vw._checkboxPressed then
         vw._checkboxPressed = nil
         return true
      end

      if not Item or Item.hidden then return false end

      for col in values(vw.columns) do
         if not col.checkBoxes then continue end
         box = Item._col?[col.attrib].checkbox
         box ?! continue
         x = col.x + box.x
         if Input.x >= math.max(col.x, x) and Input.x < math.min(col.x + col.px_width, x + box.width) and
            Input.y >= box.y and Input.y < box.y + box.height then
            if Input.value is 1 then
               vw._checkboxPressed = true
               previous = vw.namedCol[vw.checkboxColumn]
               vw.checkboxColumn = col.attrib
               vw.viewport.acFocus()

               if previous then refreshCheckbox(vw, Item, previous) end

               refreshCheckbox(vw, Item, col)
               vw.scene.surface.mtScheduleRedraw()

               if not vw.disabled and not Item.insensitive and not col.disabled then
                  setCheckbox(Item, col, not checkboxValue(Item, col), 'user')
               end
            end

            return true
         end
      end

      -- Sensitive views activate on the first click, so they are edited with F2 or editItem() only.

      if (Input.value is 0) and (Input.flags has JTYPE_DBL_CLICK) and vw.editable and not vw.sensitive then
         local result = editClick(Item, Input)
         if result != nil then return result end
      end

      return false
   end

   -- Space toggles the active checkbox column; Alt+Left/Right changes the column without moving the row.

   vw._keyEvent = function(Qualifiers:num!, Code:num!, Unicode:num):bool
      if not vw.namedCol[vw.checkboxColumn]?.checkBoxes then return false end

      if (Qualifiers has KQ_ALT) and (Code is KEY_LEFT or Code is KEY_RIGHT) then
         col = vw.namedCol[vw.checkboxColumn]
         step = Code is KEY_RIGHT ? 1 : -1
         index = col._index + step
         while index >= 0 and index < #vw.columns do
            if vw.columns[index].checkBoxes then vw.checkboxColumn = vw.columns[index].attrib; break end
            index += step
         end

         if vw.kItem then
            for column in values(vw.columns) do
               if column.checkBoxes then refreshCheckbox(vw, vw.kItem, column) end
            end
         end

         vw.scene.surface.mtScheduleRedraw()
         return true
      elseif Code is KEY_SPACE and not (Qualifiers has (KQ_CTRL | KQ_SHIFT | KQ_ALT)) then
         col = vw.namedCol[vw.checkboxColumn]
         item = vw.kItem

         if item and not item.hidden and not item.insensitive and not col.disabled then
            setCheckbox(item, col, not checkboxValue(item, col), 'user')
         end

         return true
      end

      return false
   end

   -- Lays out the existing rows again after the client has changed the hidden field of items directly, e.g. to filter
   -- a long list with one layout rather than one per item.  Cell content is not refreshed; see setItem().

   vw.relayout = function()
      assert(not vw._dispatching, 'Render callbacks must not modify the view structure; defer the change')
      vw._refreshLayout()
   end

   -- Updates the cells of an item in place.  The rows are laid out again only if the item was hidden or shown.

   vw.setItem = function(Item:table!, KV:table!)
      assert(not vw._dispatching, 'Render callbacks must not modify the view structure; defer the change')
      assert(vw.lookup[Item._id] is Item, 'Item does not belong to this view')
      for k in pairs(KV) do
         assert(not vw._isReservedField(k), f'Item field "{k}" is reserved by the view')
      end

      -- An external change to the edited value takes precedence over the user's edit.

      if (vw._edit?.item is Item) and (KV[vw._edit.attrib] != nil) then vw._cancelEdit() end

      local was_hidden = Item.hidden is true
      for k, v in pairs(KV) do
         Item[k] = v
      end
      vw._checkEdit()

      if not vw.columns or not Item._vectors?.viewport then return end -- The row has not been built yet

      updateCells(vw, Item)
      syncState(vw, Item, true)
      if (Item.hidden is true) != was_hidden then
         vw._refreshLayout()
         return -- Layout schedules the redraw; deselection callbacks may have freed the view.
      end
      vw.scene.surface.mtScheduleRedraw()
   end

   -- Refreshes the cells and highlight of an item in place, after the client has changed its fields directly.  The
   -- row, the selection, the keyboard target and the scroll position are preserved.  Rows are not laid out again; use
   -- relayout() after changing hidden.

   vw.refreshItem = function(Item:table!)
      assert(not vw._dispatching, 'Render callbacks must not modify the view structure; defer the change')
      assert(vw.lookup[Item._id] is Item, 'Item does not belong to this view')
      vw._checkEdit() -- The client may have made the edited item ineligible, e.g. insensitive
      if not vw.columns or not Item._vectors?.viewport then return end -- The row has not been built yet
      updateCells(vw, Item)
      syncState(vw, Item, true)
      vw.scene.surface.mtScheduleRedraw()
   end

   vw.setColumns = function(View:table!, Columns:any!)
      assert(not vw._dispatching, 'Render callbacks must not modify the view structure; defer the change')
      assert(View is vw, 'View does not match this columnview')
      validateColumns(Columns, View.editable)
      Options.columns = Columns
      local failure:any = setColumns(View, Columns)
      View.zones = { }
      View._last_y = View._metrics.edge

      try
         newItems(View, View.items)
      except e
         failure = e -- A creation failure takes precedence over a cleanup failure
      end

      View.scene.surface.mtScheduleRedraw()
      if failure then raiseFailure(failure) end
   end

   -- Forgets the width that the user set for a column, or for every column if Attrib is nil, and applies the widths
   -- in the column definitions again.  The columns are rebuilt as for setColumns(), only if a user width was removed.

   vw.resetColumnWidths = function(Attrib:str)
      assert(not vw._dispatching, 'Render callbacks must not modify the view structure; defer the change')
      if Attrib then
         if vw._userWidths[Attrib] is nil then return end
         vw._userWidths[Attrib] = nil
      else
         if table.empty(vw._userWidths) then return end
         vw._userWidths = { }
      end
      if vw.columns then vw.setColumns(vw, Options.columns ?? { }) end
   end

   -- Sorts the view by column (named or index).
   -- NB: Attrib values that evaluate to nil are not permitted/supported.

   vw.sortColumn = function(View:table!, Column:any!, Ascending:bool!)
      assert(not vw._dispatching, 'Render callbacks must not modify the view structure; defer the change')
      if Column is <str> then
         for col in values(View.columns) do
            if col['attrib'] is Column then
               Column = col
               break
            end
         end
      elseif Column is <num> then
         Column = View.columns[Column]
      end

      if Column is <table> then
         if #View.items > 0 then
            attrib = Column['attrib']
            numeric = (Column.type is 'bytesize') or (Column.type is 'numeric') or
               (Column.type is 'float') or (Column.type is 'seconds')
            -- Explicit text keys can encode grouping (e.g. folders before files), even in numeric columns.
            custom_text = false
            for item in values(View.items) do
               value = item[attrib]
               if value is <table> and value.sort is <str> then custom_text = true; break end
            end
            View.items.sort(function(A, B)
               local a:any = A[attrib]
               local b:any = B[attrib]
               if a is <table> then a = a.sort is nil ? a.value : a.sort end
               if b is <table> then b = b.sort is nil ? b.value : b.sort end
               if custom_text then
                  a = tostring(a is nil ? '' : a)
                  b = tostring(b is nil ? '' : b)
               elseif Column.checkBoxes then
                  a = a is true ? 1 : 0
                  b = b is true ? 1 : 0
               elseif numeric then
                  a = tonumber(a) ?? 0
                  b = tonumber(b) ?? 0
               else
                  a = tostring(a is nil ? '' : a).lower()
                  b = tostring(b is nil ? '' : b).lower()
               end
               return Ascending ? a < b : a > b
            end)
         end

         rearrangeItems(View)
      end
   end

   vw.sortView = function(Attrib, Ascending:bool)
      assert(not vw._dispatching, 'Render callbacks must not modify the view structure; defer the change')
      vw.sortItems(Attrib, Ascending)
      rearrangeItems(vw)
   end

   return vw
end
