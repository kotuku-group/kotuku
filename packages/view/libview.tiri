-- Internal support functions for listview, columnview etc

@Package(name="gui/view", version="1.0")

   import 'gui', 'gui/scrollbar'

   namespace gui

   module display as mGfx

   glItemCounter = 1
   glDragCounter = 1
   glDragSession = nil -- The active session started by any view in this script, for identifying internal drops

   DRAG_THRESHOLD <const> = 4 -- Pointer travel, in page units, before a press over an item becomes a drag

----------------------------------------------------------------------------------------------------------------------

function checkCursorImage(View:table)
   if View.pointerLocked and not View.activeZone then
      mGfx.RestoreCursor(PTC_DEFAULT, View.scene.surface)
      View.pointerLocked = nil
   end
end

-- Simplifies the process of highlighting an item.  Item can be nil for deselection.  The highlight reference is
-- committed before either item is notified so that handlers observe the final state.

function highlightItem(View:table!, Item:table)
   if Item is View.hItem then return end

   local previous = View.hItem
   View.hItem = Item
   previous?._highlightEvent(View, previous, false)
   Item?._highlightEvent(View, Item, true)
   View.viewport.acDraw()
end

-- The keyboard target (kItem) is the row that Enter, Space and keyboard navigation act upon.  It is set by keyboard
-- navigation and pointer presses, but never by pointer hover.

function setKeyboardTarget(View:table!, Item:table)
   local previous = View.kItem
   if previous is Item then return end
   View.kItem = Item
   previous?._highlightEvent(View, previous, previous is View.hItem)
   Item?._highlightEvent(View, Item, Item is View.hItem)
end

-- Rethrows an exception captured with try-except.

function rethrow(Exception)
   raise(Exception.code ?? ERR_Failed, Exception.message)
end

-- Release every item.  All items are freed even if a client cleanup callback fails; the first failure is returned
-- for the caller to report once the view is consistent.

function clearItems(View):any
   local failure:any = nil
   local items = View.items
   View.zones = { }
   View.hoveredItem = nil
   View.activeZone = nil
   View.hItem = nil
   View.kItem = nil
   View.items = { }
   View.lookup = { }
   View._contentsVersion = (View._contentsVersion ?? 0) + 1

   if items then
      for item in values(items) do
         local err = item?._free(item)
         failure ?= err
      end
   end
   return failure
end

----------------------------------------------------------------------------------------------------------------------
-- Membership remains in item flags.  Commit every delta before calling client code, and stop an
-- obsolete notification batch when a callback replaces contents or destroys the view.  Per-item versions suppress
-- superseded membership notifications while preserving pending notifications for unchanged items.

function selectionEligible(View:table!, Item:table):bool
   return Item != nil and not Item.hidden and View.lookup[Item._id] is Item
end

function selectionTransaction(View:table!, Wanted:table!, Lead:table, Anchor:table, Reason:str!,
   Active:table, BeforeNotify:func, Removed:table):bool
   selected   = array<table>
   deselected = array<table>
   snapshot   = array<table>
   first:table

   for item in values(View.items) do
      snapshot.push(item)
   end
   View._selectionVersion = (View._selectionVersion ?? 0) + 1
   version = View._selectionVersion
   old_active = View.activeItem

   for item in values(snapshot) do
      local wanted = selectionEligible(View, item) and Wanted[item._id] is true
      if wanted and not View.multiSelect and first then wanted = false end
      if wanted and not first then first = item end
      if wanted != (item._selected is true) then
         item._selected = wanted
         item._selectionVersion = version
         if wanted then selected.push(item) else deselected.push(item) end
      end
   end

   View.sItem = Lead?._selected and selectionEligible(View, Lead) ? Lead : first
   View.selectionAnchor = selectionEligible(View, Anchor) ? Anchor : nil
   View.activeItem = Active

   for item in values(deselected) do item?._selectEvent(View, item) end

   for item in values(selected) do item?._selectEvent(View, item) end

   if #selected > 0 or #deselected > 0 then View.scene.surface.mtScheduleRedraw() end

   if BeforeNotify then BeforeNotify() end

   local contents_version = View._contentsVersion
   for item in values(deselected) do
      if View._contentsVersion != contents_version or not View.viewport then return false end
      if item._selectionVersion is version and not item._selected
         and (Reason is 'clear' or item is Removed or View.lookup[item._id] is item) then
         View.events?.itemDeselected(View, Reason, item)
      end
   end

   for item in values(selected) do
      if View._contentsVersion != contents_version or not View.viewport then return false end
      if item._selectionVersion is version and item._selected and View.lookup[item._id] is item then
         View.events?.itemSelected(View, Reason, item)
      end
   end

   if View._selectionVersion != version or not View.viewport then return false end
   if old_active != Active then View.events?.activeChange(View, Reason, Active) end

   return View._selectionVersion is version and View.viewport != nil
end

function currentSelection(View:table!):table
   local wanted = {}
   for item in values(View.items) do
      if item._selected and not item.hidden then wanted[item._id] = true end
   end
   return wanted
end

----------------------------------------------------------------------------------------------------------------------
-- Reasons for a reported change:
--
--   clear:     All items in the view were removed.
--   inverted:  Item automatically deselected due to an invert operation.
--   moved:     The item has been deselected due to moving position.
--   user:      Selected by user interaction (click or keypress)
--   manual:    Item was manually selected (by the application, not the user).

function reportItemActivated(View:table!, Reason, Item)
   if Item.activity then Item.activity(Item) end
   View.events?.itemActivated(View, Reason, Item)
end

----------------------------------------------------------------------------------------------------------------------

function simpleSelect(View:table!, Item)
   if selectionTransaction(View, { [Item._id]=true }, Item, Item, 'user', View.activeItem) then
      reportItemActivated(View, 'user', Item)
   end
end

function selectNext(View:table, Filter):table
   if not View.sItem then
      for item in values(View.items) do
         if (not item.hidden) and Filter(item) then
            simpleSelect(View, item)
            return item
         end
      end
   else
      found = false
      for item in values(View.items) do
         if item is View.sItem then
            found = true
         elseif found and (not item.hidden) and Filter(item) then
            simpleSelect(View, item)
            return item
         end
      end
   end
end

function selectPrev(View:table, Filter):table
   if not View.sItem then
      for i in {1 into #View.items} do
         item = View.items[#View.items - i]
         if (not item.hidden) and Filter(item) then
            simpleSelect(View, item)
            return item
         end
      end
   else
      found = false
      for i in {1 into #View.items} do
         item = View.items[#View.items - i]
         if item is View.sItem then
            found = true
         elseif found and (not item.hidden) and Filter(item) then
            simpleSelect(View, item)
            return item
         end
      end
   end
end

----------------------------------------------------------------------------------------------------------------------
-- Drag and drop.  A session snapshots its payload when the drag starts, so that later changes to the view's contents,
-- selection or path cannot alter the data that a destination receives.

function fileReceipt(Session:table!, Item:num!):str
   local receipt = f'<receipt totalItems="{#Session.files}" id="{Item}">'
   for path in values(Session.files) do
      receipt ..= f'<file path="{path.escXML()}"/>'
   end
   return receipt .. '</receipt>'
end

-- Serves a destination's data request from the active session.  Requests for other sessions are refused.

function dragRequest(View:table!, Clipboard, Requester, Item:num, Datatypes):num
   local session = View._dragSession
   if not session or Item != session.id or not Requester then return ERR_NoSupport end

   local receipt:str
   local datatype = Datatypes[0]
   if datatype is DATA_FILE and session.files then
      receipt = fileReceipt(session, Item)
   elseif session._payload.receipt then
      receipt = session._payload.receipt(session, datatype, Requester)
   end

   receipt ?! return ERR_NoSupport
   session.requested = true
   return Requester.acDataFeed(Clipboard, DATA_RECEIPT, receipt)
end

-- Ends the active session exactly once.  Outcome is 'dropped' or 'cancelled'.

function finishDrag(View:table!, Outcome:str!)
   local session = View._dragSession
   session ?! return
   View._dragSession = nil
   if glDragSession is session then glDragSession = nil end
   session.preview?.free()
   session.preview = nil
   View.events?.dragEnd(View, session, Outcome)
end

function dragClipboard(View:table!):obj
   if not View._dragClipboard then
      View._dragClipboard = obj.new('clipboard', {
         flags = CPF_DRAG_DROP,
         requestHandler = function(Clipboard, Requester, Item, Datatypes)
            return dragRequest(View, Clipboard, Requester, Item, Datatypes)
         end,
         dragEndHandler = function(Clipboard, Item, Result)
            if View._dragSession?.id is Item then
               finishDrag(View, Result is ERR_Okay ? 'dropped' : 'cancelled')
            end
         end
      })
   end
   return View._dragClipboard
end

-- Called when the pointer has travelled far enough from a press.  The dragStart event returns the payload, or nil to
-- refuse the drag.  Only one attempt is made for each press.

function beginDrag(View:table!, Press:table!)
   View._dragPress = nil
   View._dragged   = true -- The release that ends this press must not select or activate, even if the drag is refused
   local handler = View.events?.dragStart
   handler ?! return
   if not selectionEligible(View, Press.item) or View._dragSession then return end

   local items = array<table> { }
   if Press.item._selected then
      for item in values(View.items) do
         if item._selected and not item.hidden then items.push(item) end
      end
   else
      items.push(Press.item)
   end

   local session = { id = glDragCounter, items = items, x = Press.x, y = Press.y, requested = false }
   glDragCounter++

   local payload = handler(View, session)
   payload ?! return
   if not View.viewport then
      payload.preview?.free()
      return
   end

   if payload.files then
      session.files = array<str> { }
      for path in values(payload.files) do session.files.push(path) end
   end

   local datatypes = payload.datatypes ?? (session.files ? string.char(DATA_FILE) : '')
   session._payload = payload
   session.preview  = payload.preview

   local clipboard = dragClipboard(View)
   session._sourceID = clipboard.id
   View._dragSession = session
   glDragSession = session

   local err = datatypes != '' ? mGfx.StartCursorDrag(clipboard.id, session.id, datatypes,
      session.preview?.id ?? 0) : ERR_NoData
   if err != ERR_Okay then
      msg(f'Failed to start drag: {mSys.GetErrorMsg(err)}')
      finishDrag(View, 'cancelled')
   end
end

-- Cancels an active session when the view is destroyed.  The source clipboard is freed with it.

function releaseDrag(View:table!)
   View._dragPress = nil
   finishDrag(View, 'cancelled')
   View._dragClipboard?.free()
   View._dragClipboard = nil
end

-- Returns the item at a position in page coordinates, or nil for empty space.

function itemAtPoint(View:table!, X:num!, Y:num!):table
   for zone in values(View.zones) do
      if Y >= zone.y and Y < zone.y + zone.height and
         (not zone.width or (X >= zone.x and X < zone.x + zone.width)) then
         if selectionEligible(View, zone.item) then return zone.item end
      end
   end
end

-- Feedback is independent of ordinary hover/capture.  No data is requested until the actual drop.  Destroying is set
-- when the view's viewport is being freed, which cannot be redrawn.

function clearDropFeedback(View:table!, Destroying:bool)
   if View._dropTimer then
      if not View._dropTick then mSys.UpdateTimer(View._dropTimer, 0) end
      View._dropTimer = nil
   end
   if not View._dropActive then return end
   View._dropActive = nil
   View._dropOutline?.visibility = VIS_HIDDEN
   highlightItem(View, nil)
   mGfx.RestoreCursor(PTC_DEFAULT, View.frame.id)
   View.events?.dragLeave(View, View._dropItem, View._dropInfo)
   View._dropItem = nil
   View._dropInfo = nil
   if not Destroying then View.viewport?.acDraw() end
end

function updateDropFeedback(View:table!)
   local pointer = obj.find('SystemPointer')
   if not View.viewport or not pointer?.dragSource or View.scene.dropTarget?.id != View.frame.id then
      clearDropFeedback(View)
      return
   end
   local x = View.scene.dropX
   local y = View.scene.dropY
   local item = itemAtPoint(View, x - View.page.x, y - View.page.y)
   local source = pointer.dragSource
   local drop = {
      source=source, item=pointer.dragItem, datatypes=pointer.dragDatatypes,
      x=x - View.page.x, y=y - View.page.y, qualifiers=View.qualifiers, operation='copy',
      session=(glDragSession and glDragSession._sourceID is source.id) ? glDragSession : nil
   }
   local accepted = not View.disabled and View.events?.dragDrop and
      not (View.qualifiers has (KQ_SHIFT | KQ_ALT))
   if accepted and View.events?.dragOver then accepted = View.events.dragOver(View, item, drop) is true end
   View.viewport ?! return
   pointer.dragFeedback = accepted ? 1 : 0
   View._dropActive = true
   View._dropItem = item
   View._dropInfo = drop
   View._dropOutline.visibility = accepted ? VIS_VISIBLE : VIS_HIDDEN
   highlightItem(View, accepted ? item : nil)
   mGfx.SetCursor(0, 0, accepted ? PTC_DEFAULT : PTC_STOP, '', View.frame.id)

   -- OLE invokes feedback inside its nested message loop; scroll there as well as from the regular timer.
   local now = mSys.PreciseTime()
   if accepted and now - (View._dropScrollTime ?? 0) >= 50000 then
      View._dropScrollTime = now
      local dx = x < 18 ? 12 : (x > View.frame.width - 18 ? -12 : 0)
      local dy = y < 18 ? 12 : (y > View.frame.height - 18 ? -12 : 0)
      if View.scrollDirection is 'vertical' then dx = 0 end
      if View.scrollDirection is 'horizontal' then dy = 0 end
      if dx != 0 or dy != 0 then View.scrollbar.scrollPage(dx, dy) end
   end
   if not View._dropTimer then
      local err
      err, View._dropTimer = mSys.SubscribeTimer(0.05, function()
         View._dropTick = true
         updateDropFeedback(View)
         View._dropTick = nil
         if not View._dropActive then return ERR_Terminate end
      end)
   end
   View.viewport.acDraw()
end


----------------------------------------------------------------------------------------------------------------------

gui.initView = function(Options:table!, BuildUI, NewItems, PrepareView:func)
   local scroll_direction = Options.scrollDirection ?? 'all'
   assert(scroll_direction is 'all' or scroll_direction is 'vertical' or scroll_direction is 'horizontal',
      'scrollDirection must be all, vertical or horizontal')

   vw = entity {
      lookup     = { }, -- Lookup items by ID
      activeZone = nil,
      zones      = { },
      items      = { },
      disabled   = false,
      sensitive  = Options.sensitive ?? false,
      multiSelect = Options.multiSelect is true,
      dragDrop   = Options.dragDrop is true,
      _selectionVersion = 0,
      _contentsVersion = 0,
      hItem      = nil, -- Highlighted item (pointer hover or keyboard navigation)
      kItem      = nil, -- Keyboard target; not affected by pointer hover
      sItem      = nil, -- Selected item
      selectionAnchor = nil,
      qualifiers = 0,
      activeItem = nil,
      scene      = nil,
      viewport   = nil,
      page       = nil,
      window     = nil, -- Host of the page
      -- Utilises the 'page' theme for inner view and 'widget' for titlebars etc
      theme      = nil,
      showIcons  = Options.showIcons != false,
      events          = Options.events ?? {},
      top             = { },
      totalTop        = 0,
      scrollDirection = scroll_direction,
      _built          = false
   }

   -- Render callbacks run with _dispatching set.  They may update their own vectors but must not change the structure
   -- of the view.

   function assertStructural()
      assert(not vw._dispatching, 'Render callbacks must not modify the view structure; defer the change')
   end

   -- Shift replaces the visible range; Ctrl+Shift adds it to the existing selection.
   function selectUserItem(Item:table!, Qualifiers:num!, Toggle:bool)
      if not selectionEligible(vw, Item) then return end

      wanted = {}
      anchor = Item
      if vw.multiSelect and (Qualifiers has KQ_SHIFT) then
         anchor = selectionEligible(vw, vw.selectionAnchor) ? vw.selectionAnchor :
            (selectionEligible(vw, vw.sItem) ? vw.sItem : Item)

         range_start:num, range_end:num
         for i in {0 to #vw.items} do
            if vw.items[i] is anchor then range_start = i end
            if vw.items[i] is Item then range_end = i end
         end

         if range_start > range_end then range_start, range_end = range_end, range_start end
         if Qualifiers has KQ_CTRL then wanted = currentSelection(vw) end

         for i in {range_start into range_end} do
            local item = vw.items[i]
            if not item.hidden then wanted[item._id] = true end
         end
      elseif (vw.multiSelect and (Qualifiers has KQ_CTRL)) or Toggle then
         if vw.multiSelect then wanted = currentSelection(vw) end
         wanted[Item._id] = not Item._selected
      else
         wanted[Item._id] = true
      end

      selectionTransaction(vw, wanted, Item, anchor, 'user', vw.activeItem)
   end

   function seekKeyboardItem(Start:num!, Step:num!):table
      index = Start
      while index >= 0 and index < #vw.items do
         item = vw.items[index]
         if not item.hidden then return item end
         index += Step
      end
   end

   -- Keyboard navigation moves both the highlight and the keyboard target.

   function navigateTo(Item:table!)
      highlightItem(vw, Item)
      setKeyboardTarget(vw, Item)
      vw.revealItem(Item)
   end

   -- Makes a visible item the keyboard target, as keyboard navigation does: it is highlighted and scrolled into view.

   vw.targetItem = function(Item:table!)
      if not selectionEligible(vw, Item) then return end
      navigateTo(Item)
   end

   function moveKeyboardHighlight(Step:num!)
      index = nil
      if vw.kItem then
         for i in {0 to #vw.items} do
            if vw.items[i] is vw.kItem then index = i; break end
         end
      end

      start = index is nil ? (Step > 0 ? 0 : #vw.items - 1) : math.clamp(index + Step, 0, #vw.items - 1)
      item = seekKeyboardItem(start, Step > 0 ? 1 : -1)
      if not item then item = seekKeyboardItem(start, Step > 0 ? -1 : 1) end
      if item then navigateTo(item) end
   end

   function selectHighlighted(Activate:bool!, Qualifiers:num!)
      item = vw.kItem
      if not selectionEligible(vw, item) then return end

      if Activate then
         if not item._selected then
            if not selectionTransaction(vw, { [item._id]=true }, item, item, 'user', vw.activeItem) then
               return
            end
         end

         if selectionEligible(vw, item) then
            reportItemActivated(vw, 'user', item)
         end
      else
         selectUserItem(item, Qualifiers, true)
      end
   end

   vw.addItem = function(Item)
      assert(Item, 'No Item provided')
      vw.addItems({ Item })
   end

   vw.addItems = function(Items)
      assert(Items, 'No Items provided')
      assertStructural()

      new_items = { }
      for item in values(Items) do
         new_item = table.merge({
            _id = glItemCounter,
            _vectors = { },
            -- Releases the item's graphics exactly once.  Client cleanup callbacks are invoked through
            -- View._releaseItem while the row viewport is still valid.  A cleanup failure does not prevent release;
            -- it is returned for the caller to report after cleanup is complete.
            _free = function(Item):any
               if Item._freed then return end
               Item._freed = true

               failure:any
               vp = Item._vectors.viewport
               if vp and vw._releaseItem and not Item._released then
                  Item._released = true
                  failure = vw._releaseItem(Item, vp)
               end

               Item._vectors.viewport = nil

               for v in values(Item._vectors) do
                  v.free()
               end

               vp?.free()

               Item._vectors = { }
               return failure
            end
         }, item)

         vw.items.insert(new_item)
         if NewItems then new_items.insert(new_item) end
         vw.lookup[glItemCounter] = new_item
         glItemCounter++
      end

      if vw._built and NewItems and (#new_items > 0) then
         NewItems(vw, new_items) -- Report new items to view manager
         if vw._relayout then vw._afterLayout() end
      end
   end

   -- Generic callback for the user hovering and interacting with listed items

   function itemHoverCallback(Zone, CursorX, CursorY)
      highlightItem(vw, Zone.item)

      vw.hoveredItem = {
         item = Zone.item,
         click = function(Input)
            if Input.value is 0 and not vw.disabled and not vw._modifiedClick then
               if vw.sensitive and (not Zone.item.insensitive) then
                  reportItemActivated(vw, 'user', Zone.item)
               elseif Input.flags has JTYPE_DBL_CLICK then
                  reportItemActivated(vw, 'user', Zone.item)
               end
            end
         end
      }
   end

   function cursorActivity()
      if not vw.activeZone and vw.cursorX then
         for zone in values(vw.zones) do
            if (vw.cursorY >= zone.y) and (vw.cursorY < zone.y + zone.height) then
               if ((not zone.width) or ((vw.cursorX >= zone.x) and (vw.cursorX < zone.x + zone.width))) then
                  cursor = zone.hoverCallback(zone, vw.cursorX, vw.cursorY)
                  if not cursor then checkCursorImage(vw) end
                  break
               end
            end
         end
      end
   end

   -- Reconcile selection, highlight and keyboard references with direct changes to item visibility.  Returns false
   -- if a selection callback replaced the contents or destroyed the view.

   vw._reconcile = function():bool
      if not selectionTransaction(vw, currentSelection(vw), vw.sItem, vw.selectionAnchor,
         'manual', vw.activeItem) then return false end
      if vw.hItem and not selectionEligible(vw, vw.hItem) then highlightItem(vw, nil) end
      if vw.kItem and not selectionEligible(vw, vw.kItem) then setKeyboardTarget(vw, nil) end
      return true
   end

   function afterLayout()
      cursorActivity() -- Reset the cursor
      vw.border?.acMoveToFront()
      vw.scene.surface.mtScheduleRedraw()
   end

   -- Reposition existing items after a structural change.  Views that implement _relayout() retain their rows and
   -- scroll position; other views are rebuilt.

   function refreshLayout()
      if not vw._relayout then
         vw.rebuild()
         return
      end

      if not vw._reconcile() then return end
      vw.zones = { }
      vw.hoveredItem = { }
      vw._relayout()
      afterLayout()
   end

   vw._refreshLayout = refreshLayout
   vw._afterLayout = afterLayout

   vw.disable = function()
      vw.disabled = true
      vw?._stateChanged()
   end

   vw.enable = function()
      vw.disabled = false
      vw?._stateChanged()
   end

   -- Add a monitored click zone.  Not for client use.
   -- If Width is nil then the click zone will span the entire width of the page and X is ignored.

   vw.addZone = function(X, Y, Width, Height, Item, HoverCallback):table
      HoverCallback ?= itemHoverCallback

      vw.zones.insert({
         x      = X,
         y      = Y,
         width  = Width,
         height = Height,
         item   = Item,
         hoverCallback = HoverCallback
      })

      return vw.zones[#vw.zones-1]
   end

   -- Clears a view of all internal content and updates the display.

   -- Returns false if a selection callback replaced the contents or destroyed the view, followed by the first
   -- cleanup failure, if any.

   function clearContents():<bool, any>
      if vw._clearing then return nil, nil end
      vw._clearing = true

      highlightItem(vw, nil)
      setKeyboardTarget(vw, nil)

      failure:any
      completed = selectionTransaction(vw, {}, nil, nil, 'clear', nil, function()
         failure = clearItems(vw)
         vw._clearing = false
      end)

      if completed then vw.rebuild(true) end
      return completed, failure
   end

   vw.clearView = function()
      assertStructural()
      completed, failure = clearContents()
      if failure then rethrow(failure) end
      return completed
   end

   -- Inverts visible membership in multiple mode, retaining the sensitive-view no-op.

   vw.invertSelection = function()
      if vw.sensitive or not vw.multiSelect then return end

      wanted = {}
      for item in values(vw.items) do
         if not item.hidden and not item._selected then
            wanted[item._id] = true
         end
      end

      highlightItem(vw, nil)
      selectionTransaction(vw, wanted, nil, vw.selectionAnchor, 'inverted', nil)
   end

   -- Returns the graphical dimensions of an item in the view.

   vw.itemDimensions = function(Item)
      assert(Item, 'No Item provided')
      vp = Item._vectors?.viewport
      if not vp then return { x=0, y=0, width=0, height=0 } end
      return { x=vp.x ?? 0, y=vp.y ?? 0, width=vp.width ?? 0, height=vp.height ?? 0 }
   end

   -- Moves an item towards the bottom of the view.

   vw.lowerItem = function(Item)
      assert(Item, 'No Item provided')
      assertStructural()
      for i in {0 to #vw.items - 1} do
         if vw.items[i] is Item then
            vw.items[i] = vw.items[i+1]
            vw.items[i+1] = Item
            refreshLayout()
            return
         end
      end
   end

   -- Moves an item towards the top of the view.

   vw.raiseItem = function(Item)
      assert(Item, 'No Item provided')
      assertStructural()

      for i in {1 to #vw.items} do
         if vw.items[i] is Item then
            vw.items[i] = vw.items[i-1]
            vw.items[i-1] = Item
            refreshLayout()
            return
         end
      end
   end

   -- Removes an item from the view.

   vw.removeItem = function(Item)
      assert(Item, 'No Item provided')
      assertStructural()

      if vw.lookup[Item._id] != Item then return end
      if Item is vw.hItem then highlightItem(vw, nil) end
      if Item is vw.kItem then setKeyboardTarget(vw, nil) end

      wanted = currentSelection(vw)
      wanted[Item._id] = nil
      active = vw.activeItem is Item ? nil : vw.activeItem

      failure:any
      completed = selectionTransaction(vw, wanted, vw.sItem,
         vw.selectionAnchor is Item ? nil : vw.selectionAnchor, 'manual', active, function()
            for i in {0 to #vw.items} do
               if vw.items[i] is Item then vw.items.remove(i); break end
            end

            vw.lookup[Item._id] = nil

            -- Drop input references to the item before its graphics are released
            local zones = { }
            for zone in values(vw.zones) do
               if zone.item != Item then zones.insert(zone) end
            end

            vw.zones = zones

            if vw.hoveredItem?.item is Item then vw.hoveredItem = nil end

            failure = Item._free(Item)
         end, Item)

      if completed then refreshLayout() end

      if failure then rethrow(failure) end
   end

   -- Returns the scroll delta needed to reveal the span [Start, Start+Size) within [Low, High).  A span larger than the
   -- visible area is left alone if any part of it is visible, otherwise the alternating edge corrections would cause
   -- the view to flip between its extremes.

   local function revealDelta(Start:num, Size:num, Low:num, High:num):num
      if Size > High - Low then
         if (Start < High) and (Start + Size > Low) then return 0 end
         return Low - Start
      elseif Start < Low then
         return Low - Start
      elseif Start + Size > High then
         return High - (Start + Size)
      end
      return 0
   end

   -- Checks the visibility of an item, scrolling it into view if it is partially or fully hidden.

   vw.revealItem = function(Item)
      assert(Item, 'No Item provided')
      vw.scrollbar ?! return

      dims = vw.itemDimensions(Item)
      if (dims.width <= 0) and (dims.height <= 0) then return end

      scroll_top  = -vw.page.y
      scroll_left = -vw.page.x
      delta_y = revealDelta(dims.y, dims.height, scroll_top, scroll_top + vw.frame.height)
      delta_x = revealDelta(dims.x, dims.width, scroll_left, scroll_left + vw.frame.width)

      if (delta_x != 0) or (delta_y != 0) then
         vw.scrollbar.scrollPage(delta_x, delta_y)
      end
   end

   -- Selects all items in the view for the user.

   function selectAllVisible(Reason:str!)
      wanted = currentSelection(vw)
      lead = selectionEligible(vw, vw.sItem) and vw.sItem._selected ? vw.sItem : nil
      for item in values(vw.items) do
         if not item.hidden and (vw.multiSelect or not lead) then
            wanted[item._id] = true
            lead ?= item
         end
      end

      selectionTransaction(vw, wanted, lead, vw.selectionAnchor, Reason, lead)
   end

   vw.selectAll = function()
      selectAllVisible('manual')
   end

   -- Add visible matches in multiple mode, or replace with the first match in single mode.

   vw.selectItems = function[](Conditional:func)
      wanted = vw.multiSelect ? currentSelection(vw) : {}
      lead:table

      for item in values(vw.items) do
         if not item.hidden and Conditional(item) is true then
            wanted[item._id] = true
            lead = item
            vw.multiSelect ?! break
         end
      end

      if lead then selectionTransaction(vw, wanted, lead, vw.selectionAnchor, 'manual', lead) end
   end

   -- Return a table of all selected items

   vw.selectedItems = function():array<table>
      list = array<table> { }
      for item in values(vw.items) do
         if item._selected then
            list.push(item)
         end
      end
      return list
   end

   vw.selectNext = function(Filter)
      Filter ?= function() return true end
      selectNext(vw, Filter)
   end

   vw.selectPrev = function(Filter)
      Filter ?= function() return true end
      selectPrev(vw, Filter)
   end

   -- Deselects all currently selected items.

   vw.deselectAll = function()
      selectionTransaction(vw, {}, nil, nil, 'manual', nil)
   end

   -- Cleanup failures are reported only after the view has been completely released.

   vw.free = function()
      if vw._freeing then return end
      assertStructural()
      vw._freeing = true

      failure:any
      try
         releaseDrag(vw)
      except e
         failure = e
      end

      try
         vw.clearView()
      except e
         failure ?= e
      end

      vw.viewport?.free()
      for k in keys(vw) do vw[k] = nil end
      processing.collect()
      if failure then rethrow(failure) end
   end

   -- Changes the underlying attributes of any item in the view by setting provided key-values.

   vw.setItem = function(Item:table!, KV:table!)
      assertStructural()
      for k, v in pairs(KV) do
         Item[k] = v
      end

      vw.rebuild()
   end

   -- Load a new set of items and display them for the user.  Any existing items will be cleared.

   vw.loadItems = function(Items)
      assertStructural()
      if not vw.clearView() or not vw.viewport then return end
      vw.addItems(Items)
      if not vw._relayout then vw.rebuild() end
   end

   -- Internal function for sorting items by any named attribute.  Clients must call sort() instead.

   vw.sortItems = function(Attrib, Ascending)
      Attrib ?= 'name'
      Ascending ?= true

      if #vw.items <= 1 then return end

      if vw.items[0][Attrib] is <table> then
         if vw.items[0][Attrib]['sort'] then
            vw.items.sort(function(a,b)
               return Ascending ? (a[Attrib].sort < b[Attrib].sort) : (a[Attrib].sort > b[Attrib].sort)
            end)
         else
            vw.items.sort(function(a,b)
               return Ascending ? (a[Attrib].value < b[Attrib].value) : (a[Attrib].value > b[Attrib].value)
            end)
         end
      elseif vw.items[1][Attrib] is <str> then
         vw.items.sort(function(a,b)
            return Ascending ? (string.lower(a[Attrib]) < string.lower(b[Attrib])) :
               (string.lower(a[Attrib]) > string.lower(b[Attrib]))
         end)
      else
         vw.items.sort(function(a,b)
            return Ascending ? a[Attrib] < b[Attrib] : a[Attrib] > b[Attrib]
         end)
      end

      vw.scene.surface.mtScheduleRedraw()
   end

   -- Sort items by any named attribute (Attrib must appear in all items)
   -- Functionality must be defined by the host.

   vw.sortView = function(Attrib, Ascending)
      msg('The view implementation must override the sort() method.')
   end

   -- Internal function for building the view's UI.  The page position is reset unless the view preserves its scroll
   -- position, in which case the implementation is expected to clamp it to the new extent.

   vw.rebuild = function(ResetScroll:bool)
      assertStructural()
      if not vw._reconcile() then return end
      vw.zones = { }
      vw.hoveredItem = { }

      if ResetScroll or not vw._preserveScroll then
         vw.page.x = 0 -- Reset the page position
         vw.page.y = 0
      end

      BuildUI(vw)
      vw._built = true
      afterLayout()
   end

   -- Internal function for offsetting the frame, e.g. to accommodate a toolbar.

   vw.reserveTop = function(ID, Height)
      if vw.top[ID] then return end
      vw.top[ID] = { y=vw.totalTop, height=Height }
      vw.totalTop = vw.totalTop + Height
      vw.frame?.y = vw.totalTop
      vw.scrollbar?.vbar?.viewport.y = vw.totalTop
   end

   -- Initialisation --

   vw.parentViewport = Options.target

   vw.scene    = vw.parentViewport.scene
   vw.viewport = vw.parentViewport.new('VectorViewport', { name='view_main', overflow='hidden' }) -- Main viewport for vector graphics.
   vw.frame    = vw.viewport.new('VectorViewport', { name='view_frame', x=0, xOffset=0, y=0, yOffset=0, overflow=VOF_HIDDEN })
   vw.theme    = gui.getTheme(vw.scene)
   if Options.theme then -- Accepts page and widget theme config
      vw.theme = table.merge(vw.theme, Options.theme, true, true)
   end

   vw.bkgd = vw.frame.new('VectorRectangle', table.merge({
      name = 'view_bkgd', width = '100%', height = '100%'
   }, vw.theme.page.bkgd))

   vw.page = vw.frame.new('VectorViewport', { name='view_page', width='100%', height='100%', buffered=true })

   if not Options.borderless then
      vw.border = vw.viewport.new('VectorRectangle', table.merge({
         name = 'view_border', x = 0.5, y = 0.5, xOffset = -0.5, yOffset = -0.5,
      }, vw.theme.page.border))
   end

   for v in values(array<str> { 'x', 'y', 'xOffset', 'yOffset', 'width', 'height'}) do
      if Options[v] then vw.viewport[v] = Options[v] end
   end

   vw.parentViewport.subscribe('free', function(Surface, Args)
      vw.parentViewport = nil
   end)
--[[
   vw.parentViewport.mtSubscribeFeedback((FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS), function(Viewport, Event)
      if (Event is FM_LOST_FOCUS) then

      else

      end
   end)
--]]

   vw.scrollbar = gui.scrollbar({
      target    = vw.viewport,
      view      = vw.frame,
      page      = vw.page,
      direction = scroll_direction
   })

   if not Options.borderless and vw.scrollbar then
      vw.scrollbar.hbar?.viewport.x = 1
      vw.scrollbar.vbar?.viewport.y = 1
   end

   vw.viewport.mtSubscribeFeedback((FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS), function(Viewport, Event)
      if Event is FM_LOST_FOCUS then
         vw.hasFocus = false
         vw.qualifiers = 0
         vw.events?.lostFocus(vw)
      else
         vw.hasFocus = true
         vw.events?.focus(vw)
      end
      vw?._stateChanged()
      vw.viewport.acDraw()
   end)

   -- Pointer input has no qualifiers.  Track them independently of vector focus so that Ctrl/Shift
   -- pressed in another widget still apply to the first click here.

   vw._modifierKeyboard = input.keyboard(nil, function(Handle, SurfaceID, Qualifiers, Code, Unicode)
      vw.qualifiers = Qualifiers & (KQ_SHIFT | KQ_CTRL | KQ_ALT)
      if Qualifiers has KQ_RELEASED then
         if Code is KEY_L_SHIFT then vw.qualifiers = vw.qualifiers & ~KQ_L_SHIFT end
         if Code is KEY_R_SHIFT then vw.qualifiers = vw.qualifiers & ~KQ_R_SHIFT end
         if Code is KEY_L_CONTROL then vw.qualifiers = vw.qualifiers & ~KQ_L_CONTROL end
         if Code is KEY_R_CONTROL then vw.qualifiers = vw.qualifiers & ~KQ_R_CONTROL end
         if Code is KEY_L_ALT then vw.qualifiers = vw.qualifiers & ~KQ_L_ALT end
         if Code is KEY_R_ALT then vw.qualifiers = vw.qualifiers & ~KQ_R_ALT end
      end
      if vw._dropActive then updateDropFeedback(vw) end
   end)

   -- If the view is destroyed by its parent rather than free(), client cleanup callbacks still run once for each row
   -- while the row viewports remain valid.  The graphics are released by the parent.

   vw.viewport.subscribe('free', function()
      clearDropFeedback(vw, true)
      vw._modifierKeyboard?.unsubscribe()
      vw._modifierKeyboard = nil
      if vw._dragSession or vw._dragClipboard then
         try
            releaseDrag(vw)
         except e
            msg(f'Drag cleanup failed during view destruction: {e.message}')
         end
      end
      if vw._releaseItem and vw.items then
         local failure:any = nil
         for item in values(vw.items) do
            local vp = item._vectors?.viewport
            if vp and not item._released then
               item._released = true
               local err = vw._releaseItem(item, vp)
               failure ?= err
            end
         end
         if failure then msg(f'Row cleanup failed during view destruction: {failure.message}') end
      end
   end)

   vw.viewport.mtSubscribeKeyboard(function(Viewport, Qualifiers, Code, Unicode)
      if (Qualifiers has KQ_PRESSED) and not vw.disabled then
         if vw._keyEvent and vw._keyEvent(Qualifiers, Code, Unicode) then return end

         if (Code is KEY_ENTER) or (Code is KEY_NP_ENTER) then
            selectHighlighted(true, Qualifiers)
         elseif Code is KEY_A and (Qualifiers has KQ_CTRL) then
            if vw.multiSelect then
               selectAllVisible('user')
            end
         elseif Code is KEY_SPACE then
            selectHighlighted(false, Qualifiers)
         elseif (Code is KEY_UP) or (Code is KEY_LEFT) then
            moveKeyboardHighlight(-1)
            if vw.kItem and (Qualifiers has KQ_SHIFT) then
               selectUserItem(vw.kItem, Qualifiers)
            end
         elseif (Code is KEY_DOWN) or (Code is KEY_RIGHT) then
            moveKeyboardHighlight(1)
            if vw.kItem and (Qualifiers has KQ_SHIFT) then
               selectUserItem(vw.kItem, Qualifiers)
            end
         elseif Code is KEY_HOME then
            item = seekKeyboardItem(0, 1)
            if item then
               navigateTo(item)
               if Qualifiers has KQ_SHIFT then
                  selectUserItem(item, Qualifiers)
               end
            end
         elseif Code is KEY_END then
            item = seekKeyboardItem(#vw.items - 1, -1)
            if item then
               navigateTo(item)
               if Qualifiers has KQ_SHIFT then
                  selectUserItem(item, Qualifiers)
               end
            end
         end
      end
   end)

   vw.page.mtSubscribeInput((JTYPE_MOVEMENT | JTYPE_BUTTON | JTYPE_CROSSING | JTYPE_EXT_MOVEMENT), function(Viewport, Events)
      ev = Events
      while ev do
         if ev.type is JET_CROSSED_IN then
            vw.cursorX = ev.x
            vw.cursorY = ev.y
            cursorActivity()
            checkCursorImage(vw)
         elseif ev.type is JET_CROSSED_OUT then
            vw.cursorX = nil
            vw.cursorY = nil
            checkCursorImage(vw)
            if vw.hItem then
               highlightItem(vw, nil)
            end
         elseif ev.type is JET_BUTTON_1 then
            if vw.disabled or (ev.flags has JTYPE_REPEATED) then return end
            if ev.value is 1 then vw._modifiedClick = vw.qualifiers has (KQ_SHIFT | KQ_CTRL) end

            if ev.value is 1 then
               vw.clickAbsX = ev.absX
               vw.clickAbsY = ev.absY
               vw.clickX = ev.x
               vw.clickY = ev.y
               vw._dragPress = nil
               vw._dragged = nil
               if vw.hItem and not vw.activeZone then
                  setKeyboardTarget(vw, vw.hItem)
               end
            elseif vw._dragged then -- Release of a press that passed the drag threshold
               vw._dragged = nil
               vw._dragPress = nil
               vw._modifiedClick = nil
               ev = ev.next
               continue
            elseif vw._dragPress then -- Release without a drag; apply the selection deferred by the press
               local press = vw._dragPress
               vw._dragPress = nil
               if (math.abs(ev.x - press.x) < DRAG_THRESHOLD) and (math.abs(ev.y - press.y) < DRAG_THRESHOLD) and
                  selectionEligible(vw, press.item) then
                  selectUserItem(press.item, press.qualifiers)
               end
            end

            if vw.activeZone then -- Custom zone for click activity
               vw.activeZone?.clickRelease(ev.x, ev.y, ev.absX, ev.absY)
               vw.activeZone = nil
               cursorActivity()
               return
            end

            if vw._itemClick and vw._itemClick(vw.hItem, ev) then
               ev = ev.next
               continue
            end

            if vw.hoveredItem and vw.hoveredItem.click then -- Feedback for all click types.  Refer to hoveredItem()
               if vw.hoveredItem.click(ev) then
                  return
               end
            end

            if (ev.value is 1) and vw.hItem and not vw.disabled then
               if vw.dragDrop and vw.events?.dragStart then
                  -- The press might start a drag, so selection waits for a release near the press.  Pressing an
                  -- item that is already part of a multiple selection keeps the group intact, so that the group
                  -- can be dragged.  An ordinary click collapses the selection on release instead.
                  local collapse = vw.multiSelect and vw.hItem._selected and not vw._modifiedClick
                  vw._dragPress = { item=vw.hItem, x=ev.x, y=ev.y, qualifiers=collapse ? 0 : vw.qualifiers }
               else
                  selectUserItem(vw.hItem, vw.qualifiers)
               end
            end
         elseif ev.type is JET_ABS_XY then
            vw?.activeZone?.clickMove(ev)
            vw.cursorX = ev.x
            vw.cursorY = ev.y
            vw.cursorAbsX = ev.absX
            vw.cursorAbsY = ev.absY
            local press = vw._dragPress
            if press and (math.abs(ev.x - press.x) >= DRAG_THRESHOLD or math.abs(ev.y - press.y) >= DRAG_THRESHOLD) then
               beginDrag(vw, press)
               vw.viewport ?! return
            end
            cursorActivity()
         end
         ev = ev.next
      end
   end)

   -- Drops are accepted over the frame, which covers the rows and the empty space around them.  Column banners,
   -- scrollbars and toolbars reserved with reserveTop() are outside the frame and are not drop targets.  Drops are
   -- only routed if the scene was created with VPF_DROP_TARGETS, e.g. by gui.window({ dragDrop=true }).

   if vw.dragDrop then
      vw.frame.dropTarget = 1
      vw._dropOutline = vw.frame.new('VectorRectangle', {
         x=1, y=1, xOffset=1, yOffset=1, fill='none', stroke='#4388dd', strokeWidth=2, visibility=VIS_HIDDEN
      })
      vw.frame.mtSubscribeInput(JTYPE_DRAG_ITEM, function(Frame, Events)
         if Events.type is JET_CROSSED_OUT then clearDropFeedback(vw) else updateDropFeedback(vw) end
      end)
      vw.frame.subscribe('DragDrop', function(Frame, Args)
         local handler = vw.events?.dragDrop
         if not handler or vw.disabled or vw.scene.dropTarget?.id != vw.frame.id then return end
         local pointer = obj.find('SystemPointer')
         if vw.qualifiers has (KQ_SHIFT | KQ_ALT) then
            pointer.dragFeedback = 0
            clearDropFeedback(vw)
            return
         end
         local x = vw.scene.dropX - vw.page.x
         local y = vw.scene.dropY - vw.page.y
         local source = Args.source
         local item = itemAtPoint(vw, x, y)
         local drop = {
            source=source, item=Args.item, datatypes=Args.datatype, x=x, y=y,
            qualifiers=vw.qualifiers, operation='copy',
            session=(glDragSession and source and glDragSession._sourceID is source.id) ? glDragSession : nil
         }
         if vw.events?.dragOver and not vw.events.dragOver(vw, item, drop) then
            pointer.dragFeedback = 0
            clearDropFeedback(vw)
            return
         end
         local accepted = handler(vw, item, drop)
         -- Existing handlers have no return value.  An explicit false reports refusal to the source/OLE.
         pointer.dragFeedback = accepted is false ? 0 : 1
         if vw.viewport then clearDropFeedback(vw) end
      end)
   end

   try
      -- Install implementation-specific lifecycle hooks before any initial rows are constructed.
      if PrepareView then PrepareView(vw) end
      if Options.items then vw.addItems(Options.items) end

      vw.rebuild()
      if Options.disabled then vw.disable() end
   except e
      -- No caller receives this view on failure.  Release its rows without selection notifications, preserving
      -- the construction error even if a client cleanup hook fails.
      clearItems(vw)
      vw.viewport?.free()
      raise
   end

   return vw
end
