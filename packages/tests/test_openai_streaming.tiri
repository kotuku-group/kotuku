include 'http'
import '../openai/sse'
import '../openai/stream'
import 'json'
import 'net/httpserver'
import 'ai/openai'
import '../oauth2/transport'

@Test function HTTPCallbackFieldsCanBeCleared()
   calls = 0
   http <close> = obj.new('http', { stateChanged=function(HTTP, State) calls++ end })
   http.currentState = HGS_READING_HEADER
   assert(calls is 1, 'The assigned callback must receive state changes')
   http.stateChanged = nil
   http.incoming = nil
   http.currentState = HGS_READING_CONTENT
   assert(calls is 1, 'Clearing a callback must prevent subsequent delivery')
   http.stateChanged = function(HTTP, State) calls++ end
   rejected = false
   try
      http.stateChanged = 17
   except e
      rejected = true
   end
   assert(rejected, 'Only functions and nil may be assigned to callback fields')
   http.currentState = HGS_COMPLETED
   assert(calls is 2, 'A rejected assignment must preserve the replacement callback')
end

function eventWire(Type:str, Extra:table):str
   value = { type=Type }
   for key, item in pairs(Extra or {}) do value[key] = item end
   return 'data: ' .. json.encode(value) .. '\n\n'
end

@Test; @Requires(network=true, ssl=true) function HTTPSRequestsStartWithTLS()
   first_bytes = array<int>
   seen = {}
   server <close> = obj.new('netserver', { address='127.0.0.1', port=0, flags=NSF_MULTI_CONNECT,
      incoming=function(Server, Client)
         buffer = array<byte, 4096>
         err, size = Client.acRead(buffer)
         if err is ERR_Disconnected then return end
         check err
         if size > 0 and not seen[Client.id] then
            seen[Client.id] = true
            first_bytes.push(buffer[0])
            check Client.acDeactivate()
         end
      end
   })
   client = openai.client({ credential=openai.apiKey('fixture'),
      baseURL='https://127.0.0.1:' .. server.port, timeout=1, retry={ maxAttempts=1 } })
   -- The fixture closes after the first record; no certificate or real credentials are needed.
   client.models.list()
   oauth_wire.request('GET', 'https://127.0.0.1:' .. server.port, nil, {
      timeout=1, elapsed=function() return mSys.PreciseTime() / 1000000 end
   })
   stream, err = client.responses.create({ model='fixture', input='test', stream=true })
   assert(stream and not err, 'The streaming HTTPS request must start')
   defer stream.close() end
   deadline = mSys.PreciseTime() + 3000000
   while #first_bytes < 3 and mSys.PreciseTime() < deadline do processing.sleep(0.01) end
   assert(#first_bytes is 3, 'OpenAI and sign-in HTTPS transports must connect to the fixture')
   for byte in values(first_bytes) do
      assert(byte is 0x16, 'HTTPS must send a TLS handshake, never a plaintext HTTP request')
   end
end

function fragmentEveryBoundary(Wire:str, Verify:func!)
   for split in {0 into #Wire} do
      stream = openai_stream.stream({ maxBytes=65536, maxEventBytes=8192, maxEvents=32, diagnosticBytes=128 })
      seen = array<table>
      stream.onEvent(function(Event) seen.push(Event) end)
      stream.feed(Wire.sub(0, split))
      stream.feed(Wire.sub(split))
      stream.finish('eof')
      Verify(stream, seen, split)
   end
end

@Test function SSEGrammarAndFragmentation()
   wire = ': comment\r\nid: sequence-7\r\nevent: response\r\ndata: {"type":"response.output_text.delta",\r\n' ..
      'data: "sequence_number":7,"delta":"ok"}\r\n\r\n' ..
      'data:{"type":"response.completed","response":{"id":"response-1"}}'
   fragmentEveryBoundary(wire, function(Stream, Seen, Split)
      response, err = Stream.result()
      assert(not err and response.id is 'response-1', f'Final unterminated event must complete at split {Split}')
      assert(#Seen is 2 and Seen[0].delta is 'ok' and Seen[0].sequenceNumber is 7,
         f'Repeated data fields and sequence numbers must survive fragmentation at split {Split}')
      assert(Seen[0].eventID is 'sequence-7' and Seen[0].eventName is 'response',
         f'SSE event and persistent ID fields must be preserved at split {Split}: ' ..
         f'{Seen[0].eventID}/{Seen[0].eventName}')
   end)
end

@Test function CRLineEndingsRemainIncremental()
   wire = eventWire('response.output_text.delta', { sequence_number=1, delta='CR' }).replace('\n', '\r') ..
      eventWire('response.completed', { response={ id='cr-only' } }).replace('\n', '\r')
   fragmentEveryBoundary(wire, function(Stream, Seen, Split)
      response, err = Stream.result()
      assert(not err and response.id is 'cr-only', f'CR-only framing must complete at split {Split}')
      assert(#Seen is 2 and Seen[0].delta is 'CR',
         f'CR-only framing must dispatch separate events at split {Split}')
   end)
end

@Test function InitialBOMIsIgnored()
   wire = '\xef\xbb\xbf' .. eventWire('response.completed', { response={ id='bom' } })
   fragmentEveryBoundary(wire, function(Stream, Seen, Split)
      response, err = Stream.result()
      assert(not err and response.id is 'bom' and #Seen is 1,
         f'An initial UTF-8 BOM must be ignored at split {Split}')
   end)
end

@Test function OneByteChunksRemainIncremental()
   wire = eventWire('response.output_text.delta', { sequence_number=1, delta='A' }) ..
      eventWire('response.completed', { response={ id='one-byte' } })
   stream = openai_stream.stream({})
   seen = 0
   stream.onEvent(function(Event) seen++ end)
   for index in {0 to #wire} do stream.feed(wire.sub(index, index + 1)) end
   response, err = stream.result()
   assert(not err and response.id is 'one-byte' and seen is 2,
      f'One-byte chunks must complete without buffering: {stream.state()}/{err?.code}/{response?.id}/{seen}')
end

@Test function ErrorTranslationPreservesFailuresWithoutAReplacementTable()
   for fixture in values(array<table> { {}, { value=false }, { value='invalid' }, { value=42 } }) do
      original:any = nil
      stream = openai_stream.stream({ errorTranslator=function(Error):any
         original = Error
         return fixture.value
      end })
      stream.feed(eventWire('response.failed', { response={ error={ code='provider_error', message='failed' } } }))
      response, err = stream.result()
      assert(stream.state() is 'failed' and response is nil and err and err is original and
         err.code is 'provider_error', 'A translator without a replacement table preserves the original failure')
   end

   original:any = nil
   stream = openai_stream.stream({ errorTranslator=function(Error)
      original = Error
      raise 'fixture translation failure'
   end })
   stream.feed(eventWire('response.failed', { response={ error={ code='provider_error', message='failed' } } }))
   _, err = stream.result()
   assert(err and err is original and err.code is 'provider_error',
      'A translator exception preserves the original stream failure')

   replacement = { kind='response', code='translated_error', message='translated' }
   translated = openai_stream.stream({ errorTranslator=function(Error) return replacement end })
   translated.feed(eventWire('response.failed', { response={ error={ code='provider_error', message='failed' } } }))
   _, translated_error = translated.result()
   assert(translated_error is replacement, 'A replacement error table is retained')
end

@Test function TerminalPathsRemainDistinct()
   fixtures = array<table> {
      { wire=eventWire('response.completed', { response={ id='ok' } }), state='completed', code=nil },
      { wire=eventWire('response.failed', { response={ error={ code='provider_error', message='failed' } } }),
         state='failed', code='provider_error' },
      { wire=eventWire('response.incomplete', { response={ incomplete_details={ reason='max_output_tokens' } } }),
         state='incomplete', code='max_output_tokens' },
      { wire='data: not-json\n\n', state='failed', code='malformed_event' },
      { wire=eventWire('response.output_text.delta', { delta='partial' }), state='interrupted',
         code='missing_terminal_event' }
   }
   for fixture in values(fixtures) do
      fragmentEveryBoundary(fixture.wire, function(Stream, Seen, Split)
         _, err = Stream.result()
         assert(Stream.state() is fixture.state,
            f'Terminal state must remain distinct at split {Split}: {Stream.state()} != {fixture.state}')
         assert((err and err.code or nil) is fixture.code, 'Terminal error code must remain distinct')
      end)
   end
   for reason, code in pairs({ timeout='timeout', connection_terminated='connection_terminated' }) do
      stream = openai_stream.stream({})
      stream.feed(eventWire('response.output_text.delta', { delta='partial' }))
      stream.finish(reason)
      _, err = stream.result()
      assert(stream.state() is 'interrupted' and err.code is code, 'Transport termination must be classified')
   end
end

@Test function CancellationAndSubscriptionLifetime()
   stream = openai_stream.stream({})
   calls = 0
   subscription = stream.onEvent(function(Event) calls++ end)
   stream.cancel()
   stream.cancel()
   stream.feed(eventWire('response.completed', {}))
   _, err = stream.result()
   assert(stream.state() is 'cancelled' and err.kind is 'cancelled' and calls is 0,
      'Cancellation must be idempotent and suppress later callbacks')
   subscription.close()
   subscription.close()
   stream.close()
   stream.close()
   assert(stream.state() is 'closed', 'Close must be idempotent')
end

@Test function ConfigurableLimitsAndBoundedDiagnostics()
   for fixture in values(array<table> {
      { options={ maxBytes=4 }, wire='12345', expected='byte_limit' },
      { options={ maxEventBytes=8 }, wire='data: 123456789\n\n', expected='event_byte_limit' },
      { options={ maxEvents=1 }, wire=eventWire('unknown.one', {}) .. eventWire('unknown.two', {}),
         expected='event_limit' }
   }) do
      stream = openai_stream.stream(fixture.options)
      stream.feed(fixture.wire)
      _, err = stream.result()
      assert(stream.state() is 'failed' and err.code is fixture.expected, 'Configured SSE limit must fail closed')
   end
   stream = openai_stream.stream({ diagnosticBytes=12 })
   stream.feed('data: this-is-not-json\n\n')
   _, err = stream.result()
   assert(#err.diagnostic <= 12 and err.diagnosticTruncated, 'Diagnostic capture must remain bounded')
   for malformed in values(array<str> {
      'data: {"type":"delta"} trailing\n\n',
      'data: {"type":"first","type":"second"}\n\n',
      'data: {"type":"delta","nested":[[[[0]]]]}\n\n'
   }) do
      stream = openai_stream.stream({ maxJSONDepth=2 })
      stream.feed(malformed)
      _, err = stream.result()
      assert(err.code is 'malformed_event', 'Strict bounded JSON must reject ambiguous or excessive input')
   end
end

@Test function EventOrderingAndCallbackCancellation()
   stream = openai_stream.stream({})
   order = array<int>
   stream.onEvent(function(Event)
      order.push(Event.sequenceNumber)
      if Event.sequenceNumber is 2 then stream.cancel() end
   end)
   stream.feed(eventWire('delta', { sequence_number=1 }) .. eventWire('delta', { sequence_number=2 }) ..
      eventWire('delta', { sequence_number=3 }))
   assert(#order is 2 and order[0] is 1 and order[1] is 2 and stream.state() is 'cancelled',
      'Events must remain ordered and cancellation from a callback must stop delivery')
end

@Test function CompletionDeliveryOrderingAndLateSubscriptions()
   stream = openai_stream.stream({})
   order = array<str>
   stream.onEvent(function(Event) order.push(Event.type) end)
   calls = 0
   subscription = stream.onComplete(function(Response, Error)
      calls++
      assert(Response.id is 'complete' and not Error, 'Completion supplies the successful response')
      order.push('complete')
      stream.close()
   end)
   stream.feed(eventWire('response.completed', { response={ id='complete' } }))
   assert(calls is 0 and #order is 1, 'Completion waits until terminal event callbacks have returned')
   processing.sleep(0)
   assert(calls is 1 and order[1] is 'complete' and subscription.closed and stream.state() is 'closed',
      'Completion runs once and may safely close the stream')
   late_calls = 0
   stream.onComplete(function(Response, Error)
      assert(Response.id is 'complete' and not Error, 'A late subscriber retains the result after stream closure')
      late_calls++
   end)
   assert(late_calls is 0, 'Late completion subscriptions also defer delivery')
   processing.sleep(0)
   assert(late_calls is 1 and calls is 1, 'Late delivery must not repeat an earlier callback')
end

@Test function CompletionReportsEveryTerminalFailure()
   for fixture in values(array<table> {
      { mode='connection_terminated', code='connection_terminated' },
      { mode='timeout', code='timeout' }, { mode='eof', code='missing_terminal_event' },
      { mode='cancel', code='cancelled' }, { mode='close', code='cancelled' },
      { mode='malformed', code='malformed_event' }, { mode='limit', code='byte_limit' },
      { mode='provider', code='provider_failure' }, { mode='incomplete', code='response_incomplete' }
   }) do
      stream = openai_stream.stream(fixture.mode is 'limit' ? { maxBytes=4 } : {})
      calls = 0
      stream.onComplete(function(Response, Error)
         assert(not Response and Error.code is fixture.code, 'Completion must include the terminal error')
         calls++
      end)
      if fixture.mode is 'cancel' then stream.cancel()
      elseif fixture.mode is 'close' then stream.close()
      elseif fixture.mode is 'malformed' then stream.feed('data: invalid\n\n')
      elseif fixture.mode is 'limit' then stream.feed('12345')
      elseif fixture.mode is 'provider' then
         stream.feed(eventWire('response.failed', { error={ code='provider_failure' } }))
      elseif fixture.mode is 'incomplete' then stream.feed(eventWire('response.incomplete', {}))
      else stream.finish(fixture.mode) end
      assert(calls is 0, 'Failure completion must defer delivery outside the transport callback')
      processing.sleep(0)
      assert(calls is 1, f'{fixture.mode} must notify completion even without a valid terminal SSE event')
      stream.close()
      processing.sleep(0)
      assert(calls is 1, 'Closing a failed stream must not deliver completion again')
   end
end

@Test function CompletionUnsubscriptionAndCallbackIsolation()
   stream = openai_stream.stream({})
   cancelled_calls = 0
   subscription = stream.onComplete(function(Response, Error) cancelled_calls++ end)
   stream.onComplete(function(Response, Error) raise 'Subscriber failure' end)
   delivered = 0
   stream.onComplete(function(Response, Error) delivered++ end)
   stream.cancel()
   subscription.close()
   processing.sleep(0)
   assert(cancelled_calls is 0 and delivered is 1,
      'Unsubscription suppresses queued delivery and subscriber exceptions do not block other completions')
   stream.close()
end

@Test; @Requires(network=true) function HTTPAdapterStreamsAndPreservesMetadata()
   server = hslib.start({ port=0, bind='127.0.0.1', folder='temp:', routes={
      { method='POST', pattern='/complete', handler=function(Req, Res)
         Res.header('Content-Type', 'text/event-stream').header('x-request-id', 'fixture-request').send(
            eventWire('response.completed', { response={ id='http-ok' } }))
      end },
      { method='POST', pattern='/error', handler=function(Req, Res)
         Res.status(429).header('x-request-id', 'fixture-error').send(
            '{"error":{"message":"Bearer should-not-escape"}}')
      end }
   } })
   defer server.stop() end
   for path in values(array<str> { 'complete', 'error' }) do
      stream, start_err = openai_stream.request({ url='http://127.0.0.1:' .. server.port .. '/' .. path,
         body='{}', timeout=2 })
      assert(stream and not start_err, 'HTTP stream must activate')
      signal <close> = obj.new('File', { flags='buffer' })
      proc = processing.new({ timeout=3, signals=array<obj> { signal } })
      response:table = nil
      err:table = nil
      calls = 0
      stream.onComplete(function(Response, Error)
         response = Response
         err = Error
         calls++
         check signal.acSignal()
      end)
      assert(proc.sleep() != ERR_Timeout and calls is 1, 'HTTP completion must wake the waiter without polling')
      if path is 'complete' then
         assert(response.id is 'http-ok' and not err, 'HTTP adapter must decode a completed SSE response')
      else
         assert(err.kind is 'http' and err.httpStatus is 429 and err.requestID is 'fixture-error' and
            not err.diagnostic.find('should-not-escape'), 'HTTP errors must preserve metadata and redact diagnostics')
      end
      stream.close()
   end
end

@Test function HTTPFailureBeforeResponseHeaders()
   for fixture in values(array<table> {
      { error=ERR_Disconnected, kind='transport', code='connection_terminated' },
      { error=ERR_TimeOut, kind='timeout', code='timeout' }
   }) do
      http <close> = obj.new('http', { error=fixture.error })
      stream = openai_stream.stream({})
      defer stream.close() end
      calls = 0
      stream.onComplete(function(Response, Error)
         assert(not Response and Error.kind is fixture.kind and Error.code is fixture.code and Error.retryable,
            'Failure before HTTP headers must retain its transport cause and allow retry')
         calls++
      end)
      stream._httpEnded(http, true)
      assert(stream.state() is 'interrupted', 'No HTTP response means an interrupted transport')
      processing.sleep(0)
      assert(calls is 1, 'The transport failure must notify completion exactly once')
   end
end

@Test; @Requires(network=true) function HTTPRequestPreservesBoardSeparators()
   prompt = 'Current board:\n1 | 2 | 3\n4 | X | 6\n7 | 8 | 9\nChoose a "corner" — O plays next.'
   received = array<str>
   server = hslib.start({ port=0, bind='127.0.0.1', folder='temp:', routes={
      { method='POST', pattern='/responses', handler=function(Req, Res)
         received.push(Req.body)
         request = json.decode(Req.body)
         response = { id='board-fixture', status='completed', output=array<table> }
         if request.stream then
            Res.header('Content-Type', 'text/event-stream').send(
               eventWire('response.completed', { response=response }))
         else Res.json(response) end
      end }
   } })
   defer server.stop() end
   client = openai.client({ credential=openai.apiKey('fixture-key'),
      baseURL='http://127.0.0.1:' .. server.port, testLoopback=true, timeout=1, retry={ maxAttempts=1 } })
   for streaming in values(array<any> { true, false }) do
      result, err = client.responses.create({ model='fixture', input=prompt, stream=streaming })
      assert(result and not err, 'The request must reach the server with its complete body')
      if streaming then
         stream = result
         defer stream.close() end
         done = false
         stream.onComplete(function(Response, Error) result = Response; err = Error; done = true end)
         deadline = mSys.PreciseTime() + 3000000
         while not done and mSys.PreciseTime() < deadline do processing.sleep(0.01) end
         assert(done, 'Streaming completion must arrive before the deadline')
      end
      assert(not err and result and result.id is 'board-fixture',
         'Both transports must send the full JSON body despite pipe characters')
   end
   assert(#received is 2, 'Both streaming and non-streaming requests must reach the route')
   for body in values(received) do
      assert(json.decode(body).input is prompt, 'Board separators, quotes and UTF-8 must survive transmission')
   end
end
