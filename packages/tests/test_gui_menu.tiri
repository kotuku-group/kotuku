@Test function DisabledRowDoesNotActivatePreviousRow()
   local surface <close>, target = newTarget()
   local hits = 0
   local menu = gui.menu({ target=surface, relative=target, x=0, y=0,
      config=array<table> {
         { id='enabled', item='Enabled', onActivate=function() hits++ end },
         { id='disabled', item='Disabled', disabled=true }
      } })
   defer menu.surface?.free() end
   surface.acShow()
   menu.show()
   menu.surface.acDraw()
   processing.sleep(0)
   feed(JET_ABS_XY, menu.surface.absX + 10, menu.surface.absY + menu.items[0].y + 5)
   assert(menu.hItem is menu.items[0], 'Enabled row not highlighted by pointer')
   feed(JET_ABS_XY, menu.surface.absX + 10, menu.surface.absY + menu.items[1].y + 5)
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(hits is 0, f'Clicking disabled row invoked enabled row {hits} times')
   feed(JET_ABS_XY, menu.surface.absX + 10, menu.surface.absY + menu.items[0].y + 5)
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(hits is 1 and not menu.visible, 'Clicking the enabled row must activate it exactly once')
end

@Test function MenubarRoutesKeysToOpenMenu()
   local surface <close>, target = newTarget()
   local hits = 0
   local bar = gui.menubar({
      target=target,
      createItems=function(Bar)
         Bar.addItem('file', 'File', nil, nil, array<table> {
            { item='Open' }, { item='Save', onActivate=function() hits++ end }
         })
         Bar.addItem('edit', 'Edit', nil, nil, array<table> { { item='Copy' } })
      end
   })
   surface.acShow()
   surface.acFocus()
   processing.sleep(0)
   sendKey(KEY_F10)
   sendKey(KEY_DOWN)
   local menu = bar._lookup.file.menu
   assert(menu?.visible and bar._currentItem is bar._lookup.file,
      'Down must open the selected menu without advancing to the next menubar item')
   sendKey(KEY_DOWN)
   sendKey(KEY_DOWN)
   assert(bar._currentItem is bar._lookup.file, 'Down must not switch top-level menus')
   assert(menu.hItem is menu.items[1], 'Down must advance through dropdown rows')
   sendKey(KEY_ENTER)
   assert(hits is 1 and not menu.visible, 'Enter must activate the selected row exactly once and close the menu')
   sendKey(KEY_ENTER)
   assert(menu.visible, 'Enter must reopen the menu after activation')
   sendKey(KEY_RIGHT)
   assert(bar._lookup.edit.menu?.visible and not menu.visible, 'Right must switch top-level leaf menus')
   sendKey(KEY_ESCAPE)
   assert(not bar._lookup.edit.menu.visible, 'Escape must dismiss the active dropdown')
end

@Test function SpaceDismissesAnUnselectedMenubarMenu()
   local surface <close>, target = newTarget()
   local hits = 0
   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('file', 'File', nil, nil, array<table> {
         { item='Open', onActivate=function() hits++ end }
      })
   end })
   surface.acShow()
   surface.acFocus()
   processing.sleep(0)
   sendKey(KEY_F10)
   sendKey(KEY_SPACE)
   local menu = bar._lookup.file.menu
   assert(menu?.visible and not menu.hItem, 'Space must open the menu without selecting a row')
   sendKey(KEY_SPACE)
   assert(not menu.visible and not (menu.surface.flags has RNF_VISIBLE) and hits is 0,
      'A second Space must dismiss the untouched menu without invoking an action')
   assert(not bar._lastMenu and bar._currentItem is bar._lookup.file,
      'Dismissal must preserve the menubar selection and clear the active menu')
   sendKey(KEY_SPACE)
   sendKey(KEY_DOWN)
   sendKey(KEY_SPACE)
   assert(hits is 1 and not menu.visible, 'Space must still activate a selected dropdown item')
end

@Test function MenuRoutesNestedKeysOnceAndSurvivesReopening()
   local surface <close>, target = newTarget()
   local hits = 0
   local menu = gui.menu({
      target=surface, relative=target, client=target,
      config=array<table> {
         { id='parent', item='Parent', items=array<table> {
            { item='First', onActivate=function() hits++ end }, { item='Second' }
         } }
      }
   })
   surface.acShow()
   menu.show()
   surface.acFocus()
   processing.sleep(0)
   sendKey(KEY_DOWN)
   local child = menu.currentMenu
   assert(child?.visible, 'Selecting a parent must open its submenu')
   sendKey(KEY_RIGHT)
   assert(child.hItem is child.items[0], 'Right must select the first submenu item')
   sendKey(KEY_DOWN)
   assert(child.hItem is child.items[1], 'Down must reach the submenu exactly once')
   sendKey(KEY_LEFT)
   assert(not child.visible and menu.visible, 'Left must close only the submenu')
   sendKey(KEY_RIGHT)
   assert(child.visible and child.hItem is child.items[0], 'Right must reopen and select the submenu')
   sendKey(KEY_ENTER)
   assert(hits is 1 and not menu.visible and not child.visible, 'Activation must close the entire menu chain')
   menu.show()
   sendKey(KEY_DOWN)
   sendKey(KEY_RIGHT)
   sendKey(KEY_ENTER)
   assert(hits is 2, 'Reopening must preserve keyboard input without duplicate subscriptions')
end

@Test function FocusLossWhileClickingSubmenuHidesWholeChain()
   local surface <close>, target = newTarget()
   local menu = gui.menu({
      target=surface, relative=target,
      config=array<table> {
         { item='Undo' },
         { id='clipboard', item='Clipboard', items=array<table> { { item='Copy' } } }
      }
   })
   target.mtSubscribeKeyboard(function() end)
   target.mtSubscribeFeedback(FM_LOST_FOCUS, function() menu.hide() end)
   surface.acShow()
   surface.acFocus()
   menu.show()
   menu.surface.acDraw()
   processing.sleep(0)

   local row = menu.items[1]
   feed(JET_ABS_XY, menu.surface.absX + 10, menu.surface.absY + row.y + 5)
   local child = menu.currentMenu
   assert(menu.visible and child?.visible, 'Hovering Clipboard must open its submenu')
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(not menu.visible, 'The focus-loss handler must dismiss the parent menu')
   assert(not child.visible and not (child.surface.flags has RNF_VISIBLE),
      'The pending click must not reopen a submenu after focus loss hides its parent')
end

@Test function FocusLossWhileClickingLeafStillActivatesItem()
   local surface <close>, target = newTarget()
   local hits = 0
   local menu = gui.menu({
      target=surface, relative=target,
      config=array<table> { { item='Copy', onActivate=function() hits++ end } }
   })
   target.mtSubscribeKeyboard(function() end)
   target.mtSubscribeFeedback(FM_LOST_FOCUS, function() menu.hide() end)
   surface.acShow()
   surface.acFocus()
   menu.show()
   menu.surface.acDraw()
   processing.sleep(0)

   feed(JET_ABS_XY, menu.surface.absX + 10, menu.surface.absY + menu.items[0].y + 5)
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(hits is 1 and not menu.visible, 'Focus loss must not swallow the pending leaf-item action')
end

@Test function SubmenuPreviewDoesNotCaptureKeyboardNavigation()
   local surface <close>, target = newTarget()
   local menu = gui.menu({
      target=surface, relative=target, client=target,
      config=array<table> {
         { item='New File' },
         { item='Open Recent', items=array<table> { { item='Project Notes' }, { item='Widget Ideas' } } },
         { item='Save' }
      }
   })
   surface.acShow()
   menu.show()
   surface.acFocus()
   processing.sleep(0)

   sendKey(KEY_DOWN)
   sendKey(KEY_DOWN)
   local child = menu.currentMenu
   assert(child?.visible, 'Open Recent must show a submenu preview')
   sendKey(KEY_DOWN)
   assert(menu.hItem is menu.items[2] and not child.visible,
      'Down must move past Open Recent to Save without entering the preview')
   sendKey(KEY_UP)
   assert(child.visible, 'Returning to Open Recent must restore its preview')
   sendKey(KEY_RIGHT)
   assert(child.hItem is child.items[0], 'Right must enter the submenu at its first item')
   sendKey(KEY_DOWN)
   assert(child.hItem is child.items[1] and menu.hItem is menu.items[1],
      'After Right, Down must navigate within the submenu')
   sendKey(KEY_LEFT)
   sendKey(KEY_DOWN)
   assert(menu.hItem is menu.items[2], 'Left must return keyboard navigation to the parent')
   sendKey(KEY_UP)
   sendKey(KEY_UP)
   assert(menu.hItem is menu.items[0] and not child.visible,
      'A cached submenu selection must not capture Up when its preview is reopened')
   sendKey(KEY_DOWN)
   sendKey(KEY_ENTER)
   assert(child.hItem is child.items[0], 'Enter must also explicitly enter a submenu')
   sendKey(KEY_DOWN)
   assert(child.hItem is child.items[1], 'Enter must transfer keyboard navigation to the submenu')
end

@Test function HidingMenusClearsSelectionThroughoutTheChain()
   local surface <close>, target = newTarget()
   local menu = gui.menu({
      target=surface, relative=target,
      config=array<table> {
         { item='New File' },
         { id='recent', item='Open Recent', items=array<table> { { item='First' }, { item='Second' } } }
      }
   })
   surface.acShow()
   menu.show()
   menu.selectItem('recent')
   local child = menu.currentMenu
   child.moveToEnd(true)
   assert(child.hItem is child.items[1], 'The submenu must have a selection before hiding')

   child.hide()
   assert(not child.hItem, 'Hiding a submenu must clear its selected item')
   menu.selectItem('recent')
   assert(child.visible and not child.hItem, 'A reopened preview must start without a selection')
   child.step(1)
   assert(child.hItem is child.items[0], 'Down in a reopened submenu must start at the first item')

   menu.surface.acHide()
   assert(not menu.hItem and not child.hItem, 'Hiding the root surface must clear every menu selection')
   menu.show()
   assert(not menu.hItem and not menu.currentMenu, 'The root menu must reopen without selection or an open child')
   menu.step(1)
   assert(menu.hItem is menu.items[0], 'Down in a reopened root menu must start at the first item')
end

@Test function F10FocusesMenubarFromAnotherWidget()
   local surface <close>, target = newTarget()
   local sibling = target.new('VectorViewport', { y=50, width=100, height=50, tabOrder=1 })
   local sibling_keys = 0
   sibling.mtSubscribeKeyboard(function() sibling_keys++ end)
   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('disabled', 'Disabled')
      Bar.addItem('file', 'File')
      Bar.addItem('edit', 'Edit')
   end })
   bar.disableItem('disabled')
   surface.acShow()
   surface.acFocus()
   processing.sleep(0)
   sendKey(KEY_A)
   assert(sibling_keys is 1 and not bar._hasFocus, 'The sibling must initially own keyboard focus')

   sendKey(KEY_F10)
   assert(bar._hasFocus and bar._currentItem is bar._lookup.file,
      'F10 must focus the menubar and select its first enabled item')
   local prior_keys = sibling_keys
   sendKey(KEY_RIGHT)
   assert(bar._currentItem is bar._lookup.edit and sibling_keys is prior_keys,
      'Subsequent navigation must reach the menubar rather than the previous widget')

   check sibling.acFocus()
   bar.disable()
   sendKey(KEY_F10)
   assert(not bar._hasFocus, 'A disabled menubar must not take focus on F10')
   bar.enable()
   bar.viewport.free()
   sendKey(KEY_F10)
   assert(not bar.viewport, 'Freeing a menubar must remove its F10 listener')
end

@Test function F10DoesNotFocusAnInactiveWindowMenubar()
   local surface <close>, target = newTarget()
   local bar = gui.menubar({ target=target, createItems=function(Bar) Bar.addItem('file', 'File') end })
   local other_surface <close>, other_target = newTarget()
   other_target.mtSubscribeKeyboard(function() end)
   surface.acShow()
   other_surface.acShow()
   other_surface.acFocus()
   surface.acLostFocus()
   processing.sleep(0)
   assert(not (surface.flags has RNF_HAS_FOCUS), 'The first window must be inactive before pressing F10')
   local focus_events = 0
   bar.viewport.mtSubscribeFeedback(FM_HAS_FOCUS, function() focus_events++ end)
   local prior_item = bar._currentItem
   sendKey(KEY_F10)
   assert(focus_events is 0 and bar._currentItem is prior_item and not (surface.flags has RNF_HAS_FOCUS),
      'F10 must not activate a menubar in an unfocused window')
end

@Test function UpAtFirstSelectableRowReturnsToMenubar()
   local surface <close>, target = newTarget()
   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('file', 'File', nil, nil, array<table> {
         { group='Files' },
         { item='Unavailable', disabled=true },
         { item='Open Recent', items=array<table> { { item='Project Notes' } } },
         { item='Save' }
      })
      Bar.addItem('edit', 'Edit', nil, nil, array<table> { { item='Copy' } })
   end })
   surface.acShow()
   surface.acFocus()
   processing.sleep(0)
   sendKey(KEY_F10)
   sendKey(KEY_DOWN)
   sendKey(KEY_DOWN)
   local menu = bar._lookup.file.menu
   local child = menu.currentMenu
   assert(menu.hItem is menu.items[2] and child?.visible,
      'Initial navigation must skip the heading and disabled row and show the submenu preview')
   sendKey(KEY_DOWN)
   sendKey(KEY_UP)
   assert(menu.visible and menu.hItem is menu.items[2], 'Up from a later row must keep the dropdown open')
   sendKey(KEY_UP)
   assert(not menu.visible and not child.visible and not bar._lastMenu,
      'Up at the first interactive row must close the dropdown and its preview')
   assert(bar._hasFocus and bar._currentItem is bar._lookup.file,
      'The same menubar item must remain active after returning from its dropdown')
   sendKey(KEY_DOWN)
   assert(menu.visible and not menu.hItem, 'Down must reopen the selected menu with a fresh selection')
   sendKey(KEY_DOWN)
   sendKey(KEY_UP)
   sendKey(KEY_RIGHT)
   assert(bar._currentItem is bar._lookup.edit and not bar._lastMenu,
      'Right must resume horizontal menubar navigation after the dropdown closes')
end

@Test function TabFocusHighlightsAnEnabledMenubarItem()
   local surface <close>, target = newTarget()
   local sibling = target.new('VectorViewport', { y=50, width=100, height=50, tabOrder=1 })
   sibling.mtSubscribeKeyboard(function() end)
   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('disabled', 'Disabled')
      Bar.addItem('file', 'File')
      Bar.addItem('edit', 'Edit')
   end })
   bar.disableItem('disabled')
   surface.acShow()
   surface.acFocus()
   surface.acDraw()
   processing.sleep(0)
   assert(not bar._hasFocus, 'The sibling must initially hold focus')
   sendKey(KEY_TAB, KQ_RELEASED)
   assert(bar._hasFocus and bar._currentItem is bar._lookup.file,
      'Tab must immediately highlight the first enabled item')
   assert(bar._highlight.visibility is VIS_VISIBLE, 'Keyboard focus must have a visible highlight')
   sendKey(KEY_RIGHT)
   sendKey(KEY_TAB, KQ_RELEASED)
   assert(not bar._hasFocus and bar._highlight.visibility is VIS_HIDDEN,
      'Tabbing away must hide the menubar highlight')
   sendKey(KEY_TAB, KQ_RELEASED)
   assert(bar._hasFocus and bar._currentItem is bar._lookup.edit and bar._highlight.visibility is VIS_VISIBLE,
      'Returning focus must restore the highlight on the existing enabled selection')
   feed(JET_ABS_XY, surface.absX + 10, surface.absY + 5)
   feed(JET_ABS_XY, surface.absX + 450, surface.absY + 5)
   assert(bar._currentItem is bar._lookup.edit and bar._highlight.visibility is VIS_VISIBLE,
      'Hovering a disabled item or empty space must preserve the keyboard focus indicator')
   feed(JET_ABS_XY, 1000, 1000)
   assert(not bar._currentItem and bar._highlight.visibility is VIS_HIDDEN,
      'Leaving the bar without an open menu must clear the selected item and its highlight')
end

@Test function ShortcutsActivateUnopenedNestedMenusWithoutTakingFocus()
   local surface <close>, target = newTarget()
   local sibling = target.new('VectorViewport', { y=50, width=100, height=50, tabOrder=1 })
   local typed = 0
   sibling.mtSubscribeKeyboard(function(Viewport, Qualifiers, Code) if Code is KEY_A then typed++ end end)
   local calls = 0
   local opens = 0
   local received_menu:table
   local config = { id='copy', item='Copy', qualifier='ctrl', key='c', onActivate=function(Menu, Item)
      calls++
      received_menu = Menu
      assert(Item.id is 'copy', 'The activation callback must receive the original shortcut item')
   end }
   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('edit', 'Edit', nil, function() opens++ end, array<table> {
         { menu={ text='Clipboard', items=array<table> { config } } }
      })
   end })
   surface.acShow()
   surface.acFocus()
   processing.sleep(0)
   assert(not bar._lookup.edit.menu, 'Shortcut dispatch must work before any menu is constructed')
   sendKey(KEY_C, KQ_PRESSED | KQ_R_CONTROL)
   assert(calls is 1 and opens is 0, 'The shortcut must invoke the leaf once without invoking the menu-open callback')
   assert(received_menu.parentMenu is bar._lookup.edit.menu and not received_menu.visible,
      'The callback must receive its owning submenu without showing it')
   assert(not bar._lookup.edit.menu.visible and not bar._lastMenu, 'Shortcut dispatch must not open any menu')
   sendKey(KEY_A)
   assert(typed is 1 and not bar._hasFocus, 'Shortcut activation must preserve the previous widget focus')
end

@Test function ShortcutsRequireExactModifiersAndRespectDynamicDisabledState()
   local surface <close>, target = newTarget()
   local saves = 0
   local save_as = 0
   local config = { item='Save As', qualifier='Ctrl + Shift', key='S', disabled=true,
      onActivate=function() save_as++ end }
   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('file', 'File', nil, nil, array<table> {
         { item='Save', qualifier='CONTROL', key='S', onActivate=function() saves++ end }, config,
         { item='Invalid', qualifier='TYPO', key='S', onActivate=function() raise 'Invalid modifier matched' end }
      })
   end })
   surface.acShow()
   surface.acFocus()
   processing.sleep(0)
   sendKey(KEY_S)
   sendKey(KEY_S, KQ_RELEASED | KQ_CTRL)
   sendKey(KEY_S, KQ_PRESSED | KQ_CTRL | KQ_SHIFT)
   sendKey(KEY_S, KQ_PRESSED | KQ_CTRL | KQ_ALT)
   assert(saves is 0 and save_as is 0, 'Missing, additional and released modifiers must not match')
   sendKey(KEY_S, KQ_PRESSED | KQ_L_CONTROL | KQ_CAPS_LOCK)
   assert(saves is 1, 'Caps Lock must not interfere with Ctrl+S')
   config.disabled = false
   sendKey(KEY_S, KQ_PRESSED | KQ_R_CONTROL | KQ_R_SHIFT)
   assert(save_as is 1 and saves is 1, 'Re-enabling an item must enable its exact Ctrl+Shift shortcut')
   bar.disableItem('file')
   sendKey(KEY_S, KQ_PRESSED | KQ_CTRL)
   bar.enableItem('file')
   bar.disable()
   sendKey(KEY_S, KQ_PRESSED | KQ_CTRL)
   bar.enable()
   bar.removeItem('file')
   sendKey(KEY_S, KQ_PRESSED | KQ_CTRL)
   assert(saves is 1, 'Disabled bars, disabled menus and removed menus must not dispatch shortcuts')
end

@Test function ShortcutsWorkForFunctionAndPunctuationKeys()
   local surface <close>, target = newTarget()
