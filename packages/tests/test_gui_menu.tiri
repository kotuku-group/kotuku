   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('view', 'View', nil, nil, array<table> {
         { item='Reload', key='F5', onActivate=function() hits.reload++ end },
         { item='Zoom In', key='+', qualifier='CTRL', onActivate=function() hits.plus++ end },
         { item='Zoom Out', key='-', qualifier='CTRL', onActivate=function() hits.minus++ end },
         { item='Reset', key='0', qualifier='CTRL', onActivate=function() hits.zero++ end }
      })
   end })
   surface.acShow()
   surface.acFocus()
   processing.sleep(0)
   sendKey(KEY_F5)
   sendKey(KEY_EQUALS, KQ_PRESSED | KQ_CTRL | KQ_SHIFT)
   sendKey(KEY_NP_PLUS, KQ_PRESSED | KQ_CTRL)
   sendKey(KEY_PLUS, KQ_PRESSED | KQ_CTRL)
   sendKey(KEY_R_SQUARE, KQ_PRESSED | KQ_CTRL, 43)
   sendKey(KEY_MINUS, KQ_PRESSED | KQ_CTRL)
   sendKey(KEY_ZERO, KQ_PRESSED | KQ_CTRL)
   assert(hits.reload is 1 and hits.plus is 4 and hits.minus is 1 and hits.zero is 1,
      'Function keys, shifted plus, keypad plus and digit shortcuts must resolve correctly')
end

@Test function ShortcutDispatchDoesNotAlsoActivateTheSelectedMenuRow()
   local surface <close>, target = newTarget()
   local hits = 0
   local wrong_hits = 0
   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('file', 'File', nil, nil, array<table> {
         { item='Selected', onActivate=function() wrong_hits++ end },
         { item='Shortcut', key='Space', qualifier='CTRL', onActivate=function() hits++ end }
      })
   end })
   surface.acShow()
   surface.acFocus()
   processing.sleep(0)
   sendKey(KEY_F10)
   sendKey(KEY_DOWN)
   sendKey(KEY_DOWN)
   sendKey(KEY_SPACE, KQ_PRESSED | KQ_CTRL)
   assert(hits is 1 and wrong_hits is 0, 'A shortcut must run once without activating the highlighted row')
   assert(not bar._lookup.file.menu.visible, 'A shortcut action must dismiss an open menu')
end

@Test function ShortcutsSkipDisabledAncestorsAndUseFirstEnabledMatch()
   local surface <close>, target = newTarget()
   local hits = 0
   local wrong_hits = 0
   local branch = { text='Clipboard', disabled=true, items=array<table> {
      { item='Copy', qualifier='CTRL', key='C', onActivate=function() hits++ end }
   } }
   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('edit', 'Edit', nil, nil, array<table> { { menu=branch } })
   end })
   surface.acShow()
   surface.acFocus()
   processing.sleep(0)
   sendKey(KEY_C, KQ_PRESSED | KQ_CTRL)
   assert(hits is 0 and not bar._lookup.edit.menu, 'Disabled ancestors must prevent shortcut dispatch')
   branch.disabled = false
   sendKey(KEY_C, KQ_PRESSED | KQ_CTRL)
   bar.addItem('duplicate', 'Duplicate', nil, nil, array<table> {
      { item='Other Copy', qualifier='CTRL', key='C', onActivate=function() wrong_hits++ end }
   })
   sendKey(KEY_C, KQ_PRESSED | KQ_CTRL)
   assert(hits is 2 and wrong_hits is 0, 'Duplicate shortcuts must dispatch only the first enabled match')
   branch.disabled = true
   sendKey(KEY_C, KQ_PRESSED | KQ_CTRL)
   assert(hits is 2 and wrong_hits is 1, 'Disabling an ancestor must make the next enabled match available')
   surface.acLostFocus()
   sendKey(KEY_C, KQ_PRESSED | KQ_CTRL)
   assert(wrong_hits is 1, 'Shortcuts must not fire in an inactive window')
end

@Test function ShortcutCallbacksCanRemoveTheirOwnMenu()
