@Test function PrepareRefreshesLayoutOnEachOpening()
   local surface <close>, target = newTarget()
   local calls = 0
   local config = array<table> { { id='save', item='Save', checkable=true } }
   local menu = gui.menu({ target=surface, relative=target, config=config,
      prepare=function(Menu, Config)
         assert(Menu.config is Config and Config is config, 'Prepare must receive the live configuration')
         assert(not Menu.visible, 'Prepare must run before the menu becomes visible')
         calls++
         Config[0].item = calls is 1 ? 'Save the current document' : 'Save'
         Config[0].checked = calls is 1
         Config[0].disabled = calls is 1
         if calls is 1 then Config.push({ id='new', item='New', key='N', qualifier='CTRL' })
         else Config.pop()
         end
         Menu.show()
      end
   })
   local viewport_id = menu.viewport.id
   local content_id = menu.content.id
   local initial_width = menu.surface.width
   assert(calls is 0, 'Construction must not call prepare')
   surface.acShow()
   menu.show()
   local expanded_height = menu.surface.height
   assert(calls is 1 and #menu.items is 2 and menu.surface.width > initial_width,
      'Prepare must rebuild the rows and resize before showing')
   assert(menu.items[0].text.string is config[0].item and menu.items[0].checkmark.visibility is VIS_VISIBLE,
      'Prepared labels and checked state must be rendered')
   assert(not menu.selectItem('save') and menu.selectItem('new'), 'Prepared disabled state must apply')
   assert(menu.viewport.id is viewport_id and not obj.find(content_id),
      'Relayout must preserve the input viewport and release old graphics')
   menu.show()
   assert(calls is 1, 'Showing an already visible menu must not prepare it again')
   menu.hide()
   menu.show()
   assert(calls is 2 and #menu.items is 1 and menu.surface.height < expanded_height,
      'Reopening must prepare again and remove stale rows')
   assert(menu.selectItem('save') and menu.items[0].checkmark.visibility is VIS_HIDDEN,
      'Reopening must apply updated enabled and checked state')
end

@Test function SubmenusPrepareWhenOpenedAndReleaseRebuiltChildren()
   local surface <close>, target = newTarget()
   local calls = 0
   local menu = gui.menu({ target=surface, relative=target, prepare=function() end,
      config=array<table> { { menu={ text='Recent', items=array<table>,
         prepare=function(Menu, Config)
            calls++
            Menu.config = array<table> { { id='recent', item=f'Recent document {calls}',
               key='R', qualifier='CTRL' } }
         end
      } } }
   })
   surface.acShow()
   menu.show()
   assert(calls is 0, 'Preparing the parent must not prepare unopened submenus')
   menu.selectItem(0)
   local child = menu.currentMenu
   local child_id = child.surface.id
   assert(calls is 1 and child.items[0].text.string is 'Recent document 1', 'Submenus must prepare before showing')
   child.hide()
   menu.selectItem(0)
   assert(calls is 2 and menu.currentMenu is child and child.items[0].text.string is 'Recent document 2',
      'Cached submenus must prepare again when reopened')
   local path = gui.findMenuShortcut(menu.config, KQ_PRESSED | KQ_CTRL, KEY_R)
   assert(path and menu.activateShortcut(path), 'Shortcuts must find replaced submenu configuration')
   menu.show()
   assert(not obj.find(child_id), 'Rebuilding the parent must dispose of its cached submenu')
   menu.selectItem(0)
   assert(calls is 3 and menu.currentMenu != child, 'Rebuilt parents must create and prepare fresh submenus')
end

@Test function MenubarPreparesInitiallyEmptyMenusAndUpdatesShortcuts()
   local surface <close>, target = newTarget()
