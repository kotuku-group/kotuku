@Test function PrepareFailureLeavesMenuHiddenAndAllowsRetry()
   local surface <close>, target = newTarget()
   local calls = 0
   local menu = gui.menu({ target=surface, relative=target, config=array<table> { { item='Open' } },
      prepare=function()
         calls++
         if calls is 1 then raise 'Expected prepare failure' end
      end
   })
   local failed = false
   try menu.show()
   except e
      failed = true
   end
   assert(failed and not menu.visible, 'Failed preparation must leave the menu hidden')
   surface.acShow()
   menu.show()
   assert(calls is 2 and menu.visible, 'A failed prepare must not prevent later opening')
end

@Test function FocusedMenubarRejectsClicksOutsideEnabledItems()
   local surface <close>, target = newTarget()
   local hits = 0
   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('file', 'File', nil, function() hits++ end,
         array<table> { { item='Open' } })
      Bar.addItem('disabled', 'Disabled')
   end })
   bar.disableItem('disabled')
   surface.acShow()
   surface.acFocus()
   surface.acDraw()
   processing.sleep(0)
   sendKey(KEY_F10)
   feed(JET_ABS_XY, surface.absX + 450, surface.absY + 5)
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(hits is 0 and not bar._lastMenu, 'Blank space must not activate the keyboard-selected item')
   feed(JET_ABS_XY, surface.absX + bar._lookup.disabled.x + 5, surface.absY + 5)
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(hits is 0 and not bar._lastMenu, 'Disabled rows must not activate the keyboard-selected item')
   assert(bar._currentItem is bar._lookup.file, 'Ignored clicks must preserve keyboard selection')
   sendKey(KEY_DOWN)
   assert(hits is 1 and bar._lastMenu.visible, 'Keyboard activation must still open the selected menu')
   feed(JET_ABS_XY, surface.absX + 450, surface.absY + 5)
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(hits is 1 and bar._lastMenu.visible, 'Blank clicks must not toggle an already open menu')
end

@Test function MenubarHoverSwitchesWithoutActivationCallbacks()
   local surface <close>, target = newTarget()
   local hits, prepares = 0, 0
   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('file', 'File', nil, nil, array<table> { { item='Open' } })
      Bar.addItem('edit', 'Edit', nil, function() hits++ end,
         array<table> { { item='Copy' } }, function() prepares++ end)
      Bar.addItem('help', 'Help', nil, function() hits++ end)
   end })
   surface.acShow()
   surface.acFocus()
   surface.acDraw()
   processing.sleep(0)
   sendKey(KEY_F10)
   sendKey(KEY_DOWN)
   local file_menu = bar._lastMenu
   feed(JET_ABS_XY, surface.absX + bar._lookup.edit.x + 5, surface.absY + 5)
   assert(not file_menu.visible and bar._lookup.edit.menu.visible,
      'Hovering another menu must switch the open dropdown')
   assert(hits is 0 and prepares is 1, 'Hover switching must prepare the menu without activating its callback')
   feed(JET_ABS_XY, surface.absX + bar._lookup.help.x + 5, surface.absY + 5)
   assert(hits is 0 and not bar._lastMenu, 'Hovering an action-only item must close the menu without activation')
   feed(JET_ABS_XY, surface.absX + bar._lookup.edit.x + 5, surface.absY + 5)
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(hits is 1 and prepares is 2 and bar._lastMenu.visible,
      'Explicit pointer activation must invoke the callback once and prepare the menu again')
   local selected = bar._currentItem
   feed(JET_ABS_XY, 1000, 1000)
   assert(bar._currentItem is selected and bar._lastMenu.visible and bar._highlight.visibility is VIS_VISIBLE,
      'Leaving the bar while a menu is open must preserve its selection and highlight')
end

@Test function WrappedSubmenusRespectLiveDisabledState()
   local surface <close>, target = newTarget()
   local wrapper = { disabled=true, menu={ id='wrapped', text='Wrapped', items=array<table> {
      { item='Child', key='G', qualifier='CTRL' }
   } } }
   local menu = gui.menu({ target=surface, relative=target, config=array<table> {
      wrapper, { item='Enabled' }
   } })
   assert(not menu.selectItem('wrapped') and not menu.activate('wrapped'),
      'Disabled wrappers must reject selection and activation')
   surface.acShow()
   menu.show()
   menu.surface.acDraw()
   processing.sleep(0)
   feed(JET_ABS_XY, menu.surface.absX + 10, menu.surface.absY + menu.items[0].y + 5)
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(not menu.currentMenu, 'Pointer input must not open a disabled wrapped submenu')
   menu.handleKey(KQ_PRESSED, KEY_DOWN)
   assert(menu.hItem is menu.items[1], 'Keyboard navigation must skip disabled wrappers')
   wrapper.disabled = false
   assert(menu.selectItem('wrapped') and menu.currentMenu.visible, 'Enabling the wrapper must allow opening')
   menu.currentMenu.hide()
   wrapper.menu.disabled = true
   assert(not menu.selectItem('wrapped') and not menu.activate('wrapped'),
      'The inner menu disabled state must also prevent opening')
   wrapper.menu.disabled = false
   wrapper.disabled = true
   assert(not menu.selectItem('wrapped') and not menu.activate('wrapped'),
      'Disabling the wrapper again must apply without rebuilding the menu')
end

@Test function MenubarMnemonicsReserveCapitalsBeforeResolvingConflicts()
   local surface <close>, target = newTarget()
   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('file', 'File')
      Bar.addItem('format', 'Format')
      Bar.addItem('open', 'Open')
      Bar.addItem('lower', 'tools')
      Bar.addItem('embedded', 'my Help')
      Bar.addItem('duplicate', 'FFF')
      Bar.addItem('empty', '')
      Bar.addItem('punctuation', '123!?')
   end })
   assert(bar._lookup.file.mnemonic is 'F' and bar._lookup.open.mnemonic is 'O',
      'The first pass must reserve first capitals for all items')
   assert(bar._lookup.format.mnemonic is 'R', 'Conflicts must skip letters reserved by later items')
   assert(bar._lookup.lower.mnemonic is 'T' and bar._lookup.embedded.mnemonic is 'H',
      'Lowercase labels need a fallback; embedded capitals take priority')
   assert(not bar._lookup.duplicate.mnemonic and not bar._lookup.empty.mnemonic and
      not bar._lookup.punctuation.mnemonic, 'Items without an available letter must remain unbound')
   bar.disableItem('file')
   assert(bar._lookup.file.mnemonic is 'F' and bar._lookup.format.mnemonic is 'R',
      'Disabling an item must not reassign mnemonics')
   bar.setItemText('open', 'View')
   assert(bar._lookup.open.mnemonic is 'V' and bar._lookup.format.mnemonic is 'O',
      'Renaming must recompute both mnemonic passes')
   bar.removeItem('file')
   assert(bar._lookup.format.mnemonic is 'F', 'Removing an item must release its letter')
   local item = bar.addItem('find', 'Find')
   assert(item.mnemonic is 'I', 'Items added later must receive an available letter')
end

@Test function AltMnemonicsFocusOpenAndSwitchMenus()
   local surface <close>, target = newTarget()
   local sibling = target.new('VectorViewport', { y=50, width=100, height=50, tabOrder=1 })
   sibling.mtSubscribeKeyboard(function() end)
   local calls, shortcut_hits, action_hits, unmatched_hits = 0, 0, 0, 0
   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('file', 'File', nil, nil, array<table> {
         { item='Other action', qualifier='ALT', key='F', onActivate=function() shortcut_hits++ end },
         { item='Unassigned letter', qualifier='ALT', key='Z', onActivate=function() unmatched_hits++ end }
      }, function() calls++ end)
      Bar.addItem('edit', 'Edit', nil, nil, array<table> { { item='Copy' } })
      Bar.addItem('help', 'Help', nil, function() action_hits++ end)
   end })
   surface.acShow()
   surface.acFocus()
   processing.sleep(0)
   check sibling.acFocus()
   sendKey(KEY_F, KQ_PRESSED | KQ_ALT | KQ_CTRL)
   sendKey(KEY_F, KQ_PRESSED | KQ_ALT | KQ_SHIFT)
   sendKey(KEY_F, KQ_ALT)
   assert(not bar._hasFocus and calls is 0, 'Only pressed Alt-letter without other modifiers may activate')
   sendKey(KEY_Z, KQ_PRESSED | KQ_ALT)
   assert(unmatched_hits is 1 and calls is 0 and not bar._hasFocus,
      'Unassigned Alt letters must still dispatch explicit shortcuts without taking focus')
   sendKey(KEY_F, KQ_PRESSED | KQ_ALT)
   assert(bar._hasFocus and bar._currentItem is bar._lookup.file and bar._lastMenu.visible and calls is 1,
      'Alt-letter must focus the bar and prepare and open its menu')
   assert(shortcut_hits is 0, 'Assigned mnemonics must take priority over matching menu shortcuts')
   sendKey(KEY_F, KQ_PRESSED | KQ_ALT)
   assert(bar._lastMenu.visible and calls is 1, 'Repeating a mnemonic must leave its menu open')
   local file_menu = bar._lastMenu
   sendKey(KEY_E, KQ_PRESSED | KQ_ALT)
   assert(not file_menu.visible and bar._lookup.edit.menu.visible and bar._currentItem is bar._lookup.edit,
      'Alt-letter must switch from an open menu to the matching menu')
   sendKey(KEY_DOWN)
   assert(bar._lastMenu.hItem, 'The opened menu must accept normal keyboard navigation')
   sendKey(KEY_H, KQ_PRESSED | KQ_ALT)
   assert(action_hits is 1 and not bar._lastMenu, 'Action-only items must activate exactly once')
   bar.disableItem('file')
   sendKey(KEY_F, KQ_PRESSED | KQ_ALT)
   assert(calls is 1 and shortcut_hits is 0, 'Disabled mnemonics must not activate or fall through to shortcuts')
   bar.disable()
   check sibling.acFocus()
   sendKey(KEY_E, KQ_PRESSED | KQ_ALT)
   assert(not bar._hasFocus, 'Disabled menubars must not take focus through mnemonics')
end

@Test function AltMnemonicsIgnoreInactiveWindowsAndReleaseBindingsOnFree()
   local surface <close>, target = newTarget()
   local hits = 0
   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('file', 'File', nil, function() hits++ end)
   end })
   local other_surface <close>, other_target = newTarget()
   other_target.mtSubscribeKeyboard(function() end)
   surface.acShow()
   other_surface.acShow()
   other_surface.acFocus()
   surface.acLostFocus()
   processing.sleep(0)
   sendKey(KEY_F, KQ_PRESSED | KQ_ALT)
   assert(hits is 0, 'Mnemonics must ignore inactive windows')
   surface.acFocus()
   processing.sleep(0)
   sendKey(KEY_F, KQ_PRESSED | KQ_ALT)
   assert(hits is 1, 'The active window must handle its mnemonic')
   bar.viewport.free()
   sendKey(KEY_F, KQ_PRESSED | KQ_ALT)
   assert(hits is 1, 'Freeing the menubar must release mnemonic handling')
end
