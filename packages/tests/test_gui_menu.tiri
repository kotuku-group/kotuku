   import 'gui', 'gui/menu', 'gui/menubar'
   include 'display', 'vector'

function sendKey(Code:num!, Qualifiers:num, Unicode:num)
   local ev = array<int, 6>
   ev[0] = ('keypress').hash()
   ev[1] = (EVG_IO << 24) | (('keyboard').hash() & 0xffffff)
   ev[2] = Qualifiers ?? KQ_PRESSED
   ev[3] = Code
   ev[4] = Unicode ?? 0
   check mSys.BroadcastEvent(ev, 24)
   processing.sleep(0)
end

function newTarget():<obj, obj>
   local surface = obj.new('Surface', { width=500, height=200 })
   local scene = surface.new('VectorScene', { surface=surface })
   local viewport = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   return surface, viewport
end

@Test function MenuRejectsDisabledItemsAndOpensSubmenus()
   local surface <close>, target = newTarget()
   local menu = gui.menu({
      target = surface,
      config = array<table> {
         { id='disabled', item='Disabled', disabled=true },
         { id='parent', item='Parent', items=array<table> { { id='child', item='Child' } } }
      }
   })

   assert(not menu.selectItem('disabled'), 'Disabled menu items must not be selectable')
   assert(menu.selectItem('parent'), 'Enabled menu items must be selectable')
   assert(menu.currentMenu?.visible, 'Selecting a submenu item must open its nested menu')

   menu.surface.free()
end

@Test function MenubarRelayoutsAndUpdatesItemsImmediately()
   local surface <close>, target = newTarget()
   local bar = gui.menubar({
      target = target,
      createItems = function(Bar)
         Bar.addItem('file', 'File', nil, nil, array<table> { { item='Open' } })
      end
   })

   local file = bar._lookup.file
   local original_width = file.width
   bar.addItem('edit', 'Edit', nil, nil, array<table> { { item='Copy' } })
   assert(bar._lookup.edit.vectorText, 'Items added after construction must render immediately')
   assert(bar._lookup.edit.x is original_width, 'A newly added item must be positioned after existing items')

   bar.disableItem('edit')
   assert(bar._lookup.edit.vectorText.opacity is 0.5, 'Disabling an item must update its presentation immediately')
   bar.enableItem('edit')
   assert(bar._lookup.edit.vectorText.opacity is 1, 'Enabling an item must restore its presentation immediately')

   assert(bar.setItemText('edit', 'Edit Menu'), 'setItemText() must report success for a known item')
   assert(bar._lookup.edit.name is 'Edit Menu' and bar._lookup.edit.width > original_width,
      'setItemText() must update the item and recompute its width')
   assert(bar.removeItem('file'), 'removeItem() must report success for a known item')
   assert(not bar._lookup.file and bar._first is bar._lookup.edit,
      'removeItem() must unlink the item and update lookup state')
end

@Test function MenubarUsesAltAndF10WithoutConsumingTab()
   local surface <close>, target = newTarget()
   local bar = gui.menubar({
      target = target,
      createItems = function(Bar)
         Bar.addItem('file', 'File', nil, nil, array<table> { { item='Open' } })
         Bar.addItem('edit', 'Edit', nil, nil, array<table> { { item='Copy' } })
      end
   })

   surface.acShow()
   surface.acFocus()
   processing.sleep(0)

   sendKey(KEY_F10)
   assert(bar._currentItem is bar._lookup.file, 'F10 must activate the first enabled menubar item')
   sendKey(KEY_RIGHT)
   assert(bar._currentItem is bar._lookup.edit, 'Right must advance menubar keyboard selection')
   sendKey(KEY_TAB)
   assert(bar._currentItem is bar._lookup.edit, 'The menubar must leave Tab available for normal focus traversal')

   bar._currentItem = nil
   sendKey(KEY_L_ALT)
   assert(bar._currentItem is bar._lookup.file, 'Alt must activate the first enabled menubar item')
end

function putDouble(Buffer:array<byte>!, Offset:num!, Value:num!)
   if Value is 0 then return end
   local mantissa, exponent = math.frexp(Value)
   local fraction = ((mantissa * 2) - 1) * 1048576 -- The top 20 bits of the mantissa occupy the high word
   local high = ((exponent + 1022) * 1048576) + math.floor(fraction)
   local low = (fraction - math.floor(fraction)) * 4294967296
   for i in {0 to 4} do
      Buffer[Offset + i] = math.floor(low / (256 ** i)) % 256
      Buffer[Offset + 4 + i] = math.floor(high / (256 ** i)) % 256
   end
end

-- Feed one dcDeviceInput record: { double Values[2]; int64 Timestamp; OBJECTID DeviceID; JTYPE Flags; JET Type }.

function feed(Type:num!, Value0:num!, Value1:num!)
   local input = array<byte, 40>
   putDouble(input, 0, Value0)
   putDouble(input, 8, Value1)
   input[32] = Type
   check obj.find('SystemPointer').acDataFeed(nil, DATA_DEVICE_INPUT, input)
   processing.sleep(0)
end

@BeforeEach
function resetPointer()
   -- Keep pointer position from an earlier test from selecting a newly created menu or suppressing a repeated move.
   if obj.find('SystemPointer') then feed(JET_ABS_XY, 1000, 1000) end
end

@Test function MenuReportsHighlightChanges()
   local surface <close>, target = newTarget()
   local events = array<table>
   local first = { id='first', item='First' }
   local second = { id='second', item='Second' }
   local child = { id='child', item='Child' }
   local parent = { id='parent', item='Parent', items=array<table> { child } }
   local menu = gui.menu({ target=surface, relative=target,
      config=array<table> { first, { group='Heading' }, { item='Disabled', disabled=true }, second, parent },
      onHighlight=function(Menu, Item)
         events.push({ menu=Menu, item=Item })
      end
   })
   defer menu.surface?.free() end

   assert(not menu.selectItem('Disabled'), 'Disabled rows must reject selection')
   assert(menu.selectItem('first') and events[0].menu is menu and events[0].item is first,
      'Programmatic highlighting must pass the owning menu and original item')
   menu.selectItem('first')
   assert(#events is 1, 'Selecting the same row twice must not repeat the callback')
   menu.step(1)
   assert(#events is 2 and events[1].item is second, 'Keyboard navigation must report the next selectable row')

   surface.acShow()
   menu.show()
   menu.surface.acDraw()
   processing.sleep(0)
   feed(JET_ABS_XY, menu.surface.absX + 10, menu.surface.absY + menu.items[0].y + 5)
   assert(#events is 3 and events[2].item is first, 'Pointer highlighting must report the new row')
   feed(JET_ABS_XY, menu.surface.absX + 11, menu.surface.absY + menu.items[0].y + 5)
   assert(#events is 3, 'Pointer movement within one row must not repeat the callback')

   menu.selectItem('parent')
   local submenu = menu.currentMenu
   submenu.selectItem('child')
   assert(#events is 5 and events[3].menu is menu and events[3].item is parent and
      events[4].menu is submenu and events[4].item is child,
      'Submenu highlighting must inherit the callback and report its own menu')

   menu.hide()
   menu.show()
   assert(#events is 5, 'Clearing a highlight while hiding must not invoke the callback')
   menu.selectItem('first')
   assert(#events is 6 and events[5].item is first, 'Reopening must allow the row to be reported again')
end

@Test function DisabledBarRejectsKeyboard()
   local surface <close>, target = newTarget()
   local hits = 0
   local bar = gui.menubar({ target=target, createItems=function(Bar)
      Bar.addItem('run', 'Run', nil, function() hits++ end)
   end })
   surface.acShow()
   surface.acFocus()
   processing.sleep(0)
   bar.disable()
   sendKey(KEY_F10)
   sendKey(KEY_ENTER)
   assert(hits is 0, f'Disabled bar invoked callback {hits} times')
   bar.enable()
   sendKey(KEY_F10)
   sendKey(KEY_ENTER)
   assert(hits is 1, 'Re-enabling the bar must restore keyboard activation')
end

@Test function ReopenSubmenuOnSameItem()
   local surface <close>, target = newTarget()
   local menu = gui.menu({ target=surface, config=array<table> {
      { id='parent', item='Parent', items=array<table> { { item='Child' } } }
   } })
   defer menu.surface?.free() end
   menu.selectItem('parent')
   menu.currentMenu.hide()
   menu.selectItem('parent')
   assert(menu.currentMenu?.visible, 'Reselecting parent did not reopen its submenu')
end

@Test function MenuUsesRelativeViewportOffset()
   local surface <close>, target = newTarget()
   target.x = 70
   target.y = 40
   local menu = gui.menu({ target=surface, relative=target, x=10, y=20,
      config=array<table> { { item='Open' } } })
   defer menu.surface?.free() end
   surface.acShow()
   surface.acDraw()
   processing.sleep(0)
   menu.show()
   assert(menu.surface.x is 80 and menu.surface.y is 60,
      f'Menu positioned at {menu.surface.x},{menu.surface.y} instead of 80,60')
