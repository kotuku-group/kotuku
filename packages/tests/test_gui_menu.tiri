   assert(hits is 1 and not bar._lookup.file, 'Shortcut cleanup must tolerate activation freeing its own menu')
end

@Test function ShortcutMatcherSupportsNamedKeysAndRejectsUnknownBindings()
   local config = array<table> {
      { item='Alt Home', qualifier='alt', key='Home' },
      { item='Command F20', qualifier='cmd', key='F20' },
      { item='Invalid', qualifier='Hyper', key='S' },
      { item='Invalid Key', key='UnknownKey' }
   }
   assert(gui.findMenuShortcut(config, KQ_PRESSED | KQ_R_ALT, KEY_HOME)[0] is config[0],
      'Named keys and right-hand Alt must match')
   assert(gui.findMenuShortcut(config, KQ_PRESSED | KQ_R_COMMAND, KEY_F20)[0] is config[1],
      'Command and F20 must match')
   assert(not gui.findMenuShortcut(config, KQ_PRESSED, KEY_S), 'Unknown modifiers must not become bare-key bindings')
   assert(not gui.findMenuShortcut(config, KQ_PRESSED, 0), 'Unknown names must not match a key')
end

@Test function StandalonePopupReceivesKeyboardWithoutAClient()
   local surface <close>, target = newTarget()
   target.mtSubscribeKeyboard(function() end)
   surface.acShow()
   surface.acFocus()
   local hits = 0
   local menu = gui.menu({ popup=true, config=array<table> {
      { group='Files' },
      { item='Disabled', disabled=true },
      { item='Open', onActivate=function() hits++ end },
      { item='Recent', items=array<table> {
         { item='First', onActivate=function() hits++ end }, { item='Second' }
      } }
   } })
   defer menu.surface?.free() end
   menu.show()
   processing.sleep(0)
   sendKey(KEY_DOWN)
   assert(menu.hItem is menu.items[2], 'A popup without a client must receive Down and skip non-interactive rows')
   sendKey(KEY_DOWN)
   local child = menu.currentMenu
   assert(child?.visible, 'Popup keyboard navigation must preview nested menus')
   sendKey(KEY_RIGHT)
   sendKey(KEY_DOWN)
   assert(child.hItem is child.items[1], 'The root popup must route keys into its submenu')
   sendKey(KEY_LEFT)
   assert(not child.visible and menu.visible, 'Left must return to the popup')
   sendKey(KEY_ESCAPE)
   assert(not menu.visible, 'Escape must dismiss a standalone popup')
   menu.show()
   processing.sleep(0)
   sendKey(KEY_DOWN)
   sendKey(KEY_ENTER)
   assert(hits is 1 and not menu.visible, 'A reopened popup must receive keys and activate an item once')
end

@Test function PopupUsesOwnKeyboardFocusEvenWithAClient()
   local surface <close>, target = newTarget()
   target.mtSubscribeKeyboard(function() end)
   local hits = 0
   local menu = gui.menu({ target=surface, popup=true, client=target, config=array<table> {
      { item='Save', key='S', qualifier='CTRL', onActivate=function() hits++ end }
   } })
   surface.acShow()
   surface.acFocus()
   menu.show()
   processing.sleep(0)
   sendKey(KEY_S, KQ_PRESSED | KQ_CTRL)
   assert(hits is 1 and not menu.visible, 'The focused popup must handle its shortcut without using the old client')
   surface.acFocus()
   processing.sleep(0)
   sendKey(KEY_S, KQ_PRESSED | KQ_CTRL)
   assert(hits is 1, 'A hidden popup must not retain an active shortcut listener on its client')
end

@Test function CheckableItemsToggleBeforePointerAndKeyboardActivation()
   local surface <close>, target = newTarget()
   local states = array<any>
   local menu_states = array<any>
   local config = { id='grid', item='Show Grid', checkable=true,
      onActivate=function(Menu, Item) states.push(Item.checked) end }
   local menu = gui.menu({ target=surface, relative=target, showIcons=false,
      onActivate=function(Menu, Item) menu_states.push(Item.checked) end,
      config=array<table> { config, { item='Disabled', checkable=true, checked=true, disabled=true } }
   })
   assert(menu.getChecked('grid') is false, 'Checkable items must default to unchecked')
   assert(menu.items[0].checkmark and menu.items[0].checkmark.visibility is VIS_HIDDEN,
      'Check indicators must exist even when icons are disabled')
   surface.acShow()
   menu.show()
   menu.surface.acDraw()
   processing.sleep(0)
   feed(JET_ABS_XY, menu.surface.absX + 10, menu.surface.absY + menu.items[0].y + 5)
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(config.checked and states[0] and menu_states[0], 'Pointer activation must toggle before both callbacks')
   menu.show()
   assert(menu.items[0].checkmark.visibility is VIS_VISIBLE, 'A checkmark must persist after reopening')
   menu.selectItem('grid')
   menu.handleKey(KQ_PRESSED, KEY_SPACE)
   assert(not config.checked and not states[1] and not menu_states[1], 'Keyboard activation must toggle off')
   assert(#states is 2 and #menu_states is 2 and not menu.visible, 'Each activation must notify once and dismiss')
   assert(not menu.activate(1) and menu.getChecked(1), 'Disabled checkable items must not toggle')
end

@Test function CheckedStateCanBeUpdatedWithoutActivation()
   local surface <close>, target = newTarget()
   local hits = 0
   local config = { id='checked', item='Checked', checkable=true, checked=true, icon='items/file_new',
      qualifier='CTRL', key='G',
      onActivate=function() hits++ end }
   local menu = gui.menu({ target=surface, relative=target, config=array<table> {
      config, { id='ordinary', item='A much longer ordinary menu item' }, { group='Heading' },
      { id='parent', item='Submenu', checkable=true, items=array<table> { { item='Child' } } },
      { id='second', item='Second', checkable=true }
   } })
   assert(menu.getChecked('checked') and menu.items[0].checkmark.visibility is VIS_VISIBLE,
      'Initially checked items must render a checkmark')
   assert(config.iconView and config.iconView.x is 6 and
      menu.items[0].text.x > config.iconView.x + config.iconView.width,
      'Icons must retain their original left-hand column')
   local _, text_x, _, text_width = menu.items[1].text.mtGetBoundary(0)
   local _, check_x, _, check_width = menu.items[0].checkmark.mtGetBoundary(0)
   local _, shortcut_x = menu.items[0].keyText.mtGetBoundary(0)
   local _, second_check_x = menu.items[4].checkmark.mtGetBoundary(0)
   assert(check_x > text_x + text_width and check_x + check_width < shortcut_x,
      'The check column must sit after the widest label and before the shortcut column')
   assert(second_check_x is check_x, 'Checked and unchecked items must share the same reserved column')
   assert(menu.setChecked(config, false) and not menu.getChecked('checked'),
      'setChecked must update the original config')
   assert(menu.items[0].checkmark.visibility is VIS_HIDDEN and hits is 0,
      'Programmatic changes must not invoke activation callbacks')
   assert(not menu.setChecked('ordinary', true) and menu.getChecked('ordinary') is nil,
      'Ordinary items must not be converted into checkable items')
   assert(not menu.setChecked('parent', true) and not menu.setChecked('missing', true),
      'Submenu parents and unknown items must reject checked-state updates')
   config.checked = true
   surface.acShow()
   menu.show()
   assert(menu.items[0].checkmark.visibility is VIS_VISIBLE,
      'Showing a menu must refresh externally changed checked state')
end

@Test function NestedCheckableShortcutsToggleExactlyOnce()
   local surface <close>, target = newTarget()
