@Test function FreeingPopupReleasesItsKeyboardScene()
   local surface <close>, target = newTarget()
   surface.acShow()
   local menu = gui.menu({ target=surface, popup=true, config=array<table> { { item='Open' } } })
   menu.show()
   local scene_id = menu.scene.id
   menu.surface.free()
   assert(not obj.find(scene_id), 'Freeing a popup must release its scene and keyboard subscriptions')
