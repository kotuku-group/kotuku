import 'ai/openai'
import '../openai/stream'
import 'json'

function fixtureClient(Transport:func, Extra:table):table
   options = { credential=openai.apiKey('fixture-key'), baseURL='http://127.0.0.1:12345/v1',
      testLoopback=true, retry={ maxAttempts=1 }, transport=Transport }
   for key, value in pairs(Extra or {}) do options[key] = value end
   return openai.Client(options)
end

@Test function CredentialsAndCapabilities()
   callbacks = 0
   credential = openai.refreshableBearer(function(Previous)
      callbacks++
      return { accessToken='rotating-' .. callbacks }
   end)
   authorizations = array<str>
   client = openai.Client({ credential=credential, baseURL='http://127.0.0.1:12345/v1', testLoopback=true,
      retry={ maxAttempts=1 }, transport=function(Request)
         authorizations.push(Request.headers.Authorization)
         return { status=200, body='{"object":"list","data":[]}' }
      end })
   client.models.list()
   client.models.list()
   assert(callbacks is 2 and authorizations[0] is 'Bearer rotating-1' and authorizations[1] is 'Bearer rotating-2',
      'Refreshable bearer callback supplies every request without exposing token fields')
   caps = client.capabilities()
   assert(caps.streaming and caps.nonStreaming and caps.credential.refreshable and not caps.background,
      'Capabilities describe transport, credentials and deferred features')
end

@Test function ModelListingPreservesProviderFields()
   client = fixtureClient(function(Request)
      assert(Request.method is 'GET' and Request.url.endsWith('/models'), 'Model listing uses the models endpoint')
      return { status=200, body=json.encode({ object='list', data=array<table> {
         { id='model-a', object='model', created=123, owned_by='owner', future_field={ enabled=true } },
         { id='hidden', object='model' }, { object='model' }
      } }) }
   end)
   models, err = client.models.list({ filter=function(Model) return Model.id != 'hidden' end })
   assert(not err and #models is 1 and models[0].id is 'model-a' and models[0].ownedBy is 'owner' and
      models[0].raw.future_field.enabled, 'Model normalisation remains useful without discarding unknown fields')
end

@Test function ResponsesValidationEncodingAndItems()
   captured:any = nil
   client = fixtureClient(function(Request)
      captured = json.decode(Request.body)
      return { status=200, headers={ ['x-request-id']='request-1' }, body=json.encode({ id='resp-1',
         object='response', status='completed', model='model-a', output=array<table> {
            { type='reasoning', id='reason-1', summary=array<table> },
            { type='message', role='assistant', content=array<table> {
               { type='output_text', text='Hello ' }, { type='future_content', value=9 },
               { type='output_text', text='world' } }, future_item=true },
            { type='future_item', payload={ retained=true } },
            { type='function_call', call_id='call-1', name='lookup', arguments='{"id":7}' }
         } }) }
   end)
   request = { model='model-a', input=array<table> { { role='user', content='Hi' } },
      metadata={ nullable=json.null },
      text={ format={ type='json_schema', name='answer', strict=true,
         schema={ type='object', properties={ answer={ type='string' } }, required=array<str> { 'answer' },
            additionalProperties=false } } },
      tools=array<table> { openai.functionTool('lookup', 'Lookup an item', { type='object',
         properties={ id={ type='integer' } }, required=array<str> { 'id' }, additionalProperties=false }) } }
   response, err = client.responses.create(request)
   request.model = 'mutated'
   assert(not err and response.outputText() is 'Hello world' and #response.functionCalls() is 1,
      'Response convenience accessors traverse typed Items')
   assert(response.output[2].kind is 'unknown' and response.output[2].raw.payload.retained and
      response.output[1].raw.future_item, 'Unknown Items and fields retain their complete payload')
   assert(captured.model is 'model-a' and captured.text.format.type is 'json_schema' and
      captured.tools[0].strict and captured.metadata.nullable is json.null,
      'Validated request preserves JSON null and structured output stays under text.format')
   assert(#response.inputItems() is 4, 'Every output Item remains available for caller-managed replay')

   _, invalid = client.responses.create({ model='', input='x' })
   assert(invalid.kind is 'invalid_request' and invalid.code is 'invalid_model',
      'Malformed requests fail before transport')
   _, invalid = client.responses.create({ model='model-a', input='x', tools=array<table> {
      { type='function', name='unsafe_schema', strict=true,
         parameters={ type='object', properties={ value={ type='string' } } } }
   } })
   assert(invalid.code is 'invalid_strict_schema', 'Invalid strict function schemas fail before transport')
end

@Test function ToolRegistryAllowListValidationAndApproval()
   approvals = 0
   invocations = 0
   registry = openai.ToolRegistry({ approve=function(Info)
      approvals++
      return Info.arguments.id is 7
   end })
   registry.register('lookup', { type='object', properties={ id={ type='integer' } },
      required=array<str> { 'id' }, additionalProperties=false }, function(Arguments)
         invocations++
         return { found=Arguments.id }
      end, { description='Lookup', consequential=true })
   assert(#registry.declarations() is 1 and registry.declarations()[0].strict,
      'Registry emits strict function declarations')
   output, err = registry.dispatch({ type='function_call', name='lookup', call_id='call-7', arguments='{"id":7}' })
   assert(not err and output.call_id is 'call-7' and json.decode(output.output).found is 7 and
      approvals is 1 and invocations is 1, 'Approved dispatch validates arguments and matches call_id')
   _, err = registry.dispatch({ type='function_call', name='lookup', call_id='call-extra',
      arguments='{"id":7,"extra":true}' })
   assert(err.code is 'argument_additional' and approvals is 1 and invocations is 1,
      'Invalid arguments are rejected before approval or invocation')
   _, err = registry.dispatch({ type='function_call', name='not_registered', call_id='call-x', arguments='{}' })
   assert(err.code is 'tool_not_allowed', 'Model-selected names are constrained by the allow-list')
   _, err = registry.dispatch({ type='function_call', name='lookup', call_id='call-malformed', arguments='{"id":' })
   assert(err.code is 'invalid_arguments' and approvals is 1 and invocations is 1,
      'Malformed arguments are rejected before approval or invocation')

   rejecting = openai.ToolRegistry({ approve=function(Info) return false end })
   rejecting.register('lookup', { type='object', properties={ id={ type='integer' } },
      required=array<str> { 'id' }, additionalProperties=false }, function(Arguments)
         raise 'Rejected tools must never run'
      end, { consequential=true })
   _, err = rejecting.dispatch({ type='function_call', name='lookup', call_id='call-rejected',
      arguments='{"id":7}' })
   assert(err.code is 'approval_required' and err.callID is 'call-rejected',
      'Consequential tools require explicit caller approval')
end

@Test function ToolRegistryEnforcesSchemaConstraintsBeforeCallbacks()
   approvals = 0
   invocations = 0
   registry = openai.ToolRegistry({ approve=function(Info) approvals++; return true end })
   properties = {
      n={ type='integer', minimum=1, maximum=5 },
      ratio={ type='number', exclusiveMinimum=0, exclusiveMaximum=1, multipleOf=0.25 },
      code={ type='string', minLength=2, maxLength=4, pattern='^[A-Z]+$' },
      tags={ type='array', items={ type='string' }, minItems=1, maxItems=2, uniqueItems=true },
      mode={ anyOf=array<table> { { const='fast' }, { const='safe' } } }
   }
   registry.register('constrained', { type='object', properties=properties,
      required=array<str> { 'n', 'ratio', 'code', 'tags', 'mode' }, additionalProperties=false },
      function(Arguments):any invocations++; return Arguments end, { consequential=true })
   valid = { n=2, ratio=0.5, code='OK', tags=array<str> { 'one' }, mode='safe' }
   output, err = registry.dispatch({ type='function_call', name='constrained', call_id='valid',
      arguments=json.encode(valid) })
   assert(not err and output.call_id is 'valid' and approvals is 1 and invocations is 1,
      'Arguments satisfying every constraint reach approval and the handler')
   fixtures = array<table> {
      { field='n', value=0, code='argument_minimum' },
      { field='n', value=6, code='argument_maximum' },
      { field='ratio', value=0, code='argument_exclusive_minimum' },
      { field='ratio', value=1, code='argument_exclusive_maximum' },
      { field='ratio', value=0.3, code='argument_multiple_of' },
      { field='code', value='A', code='argument_min_length' },
      { field='code', value='ABCDE', code='argument_max_length' },
      { field='code', value='no', code='argument_pattern' },
      { field='tags', value=array<str>, code='argument_min_items' },
      { field='tags', value=array<str> { 'one', 'two', 'three' }, code='argument_max_items' },
      { field='tags', value=array<str> { 'same', 'same' }, code='argument_unique_items' },
      { field='mode', value='unsafe', code='argument_any_of' }
   }
   for index, fixture in fixtures do
      arguments = {}
      for key, value in pairs(valid) do arguments[key] = value end
      arguments[fixture.field] = fixture.value
      _, err = registry.dispatch({ type='function_call', name='constrained', call_id='invalid-' .. index,
         arguments=json.encode(arguments) })
      assert(err and err.code is fixture.code and approvals is 1 and invocations is 1,
         f'{fixture.code} must reject arguments before approval or handler invocation at fixture {index}')
   end
end

@Test function HistoryRetainsReasoningAndCallPairs()
   history = openai.History(array<table> { { role='user', content='Question' } })
   raw = { id='resp', output=array<table> { { type='reasoning', id='r1' },
      { type='function_call', call_id='c1', name='lookup', arguments='{}' } } }
   history.appendResponse(openai.response(raw)).functionOutput('c1', { ok=true })
   items = history.items()
   items[0].content = 'changed'
   assert(history.count() is 4 and history.items()[0].content is 'Question' and
      history.items()[3].call_id is 'c1', 'History copies caller data and preserves reasoning/call/output Items')
end

@Test function ErrorsAreClassifiedRetriedAndRedacted()
   attempts = 0
   client = fixtureClient(function(Request)
      attempts++
      if attempts is 1 then return { status=500, body='temporary' } end
      return { status=429, headers={ ['x-request-id']='request-rate' },
         body='{"error":{"code":"rate_limit_exceeded","message":"Bearer secret-value","param":"model"}}' }
   end, { retry={ maxAttempts=2 } })
   _, err = client.responses.create({ model='model-a', input='Hello' })
   assert(attempts is 2 and err.kind is 'rate_limit' and err.code is 'rate_limit_exceeded' and
      err.requestID is 'request-rate' and err.param is 'model' and not err.message.find('secret-value') and
      not err.diagnostic.find('secret-value'), 'Errors retain diagnostics metadata while classifying and redacting')
end

@Test function ResponseLimitsAndMalformedPayloadsFailClosed()
   oversized = fixtureClient(function(Request)
      return { status=200, headers={ ['x-request-id']='request-large' }, body=string.rep('x', 33) }
   end, { maxResponseBytes=32 })
   _, err = oversized.responses.create({ model='model-a', input='Hello' })
   assert(err.code is 'response_limit' and err.kind is 'transport' and err.httpStatus is 200,
      'Oversized non-streaming payloads are rejected before decoding')

   malformed = fixtureClient(function(Request)
      return { status=200, headers={ ['x-request-id']='request-malformed' }, body='{"id":' }
   end)
   _, err = malformed.responses.create({ model='model-a', input='Hello' })
   assert(err.code is 'invalid_response' and err.requestID is 'request-malformed',
      'Malformed successful Responses payloads preserve request metadata')
end

@Test function StreamingUsesTypedResponseAndItemDecoders()
   stream = openai_stream.Stream({ responseDecoder=openai.response, itemDecoder=openai.item })
   seen:any = nil
   stream.onEvent(function(Event)
      seen = Event
      if Event.type is 'response.output_item.done' then Event.item.type = 'subscriber_mutation' end
   end)
   stream.feed('data: {"type":"response.output_item.added","item":{"type":"future_item","x":1}}\n\n')
   assert(seen.item.kind is 'unknown' and seen.item.raw.x is 1, 'Streaming events preserve unknown typed Items')
   stream.feed('data: {"type":"response.output_item.done","output_index":1,"item":{' ..
      '"type":"reasoning","id":"reason-1","status":"completed"}}\n\n')
   stream.feed('data: {"type":"response.output_item.done","output_index":0,"item":{' ..
      '"type":"message","role":"assistant","status":"completed","content":[' ..
      '{"type":"output_text","text":"assembled"}]}}\n\n')
   stream.feed('data: {"type":"response.completed","response":{"id":"done","output":[]}}\n\n')
   response, err = stream.result()
   assert(not err and response.id is 'done' and response.outputText() is 'assembled' and
      response.inputItems()[0].content[0].text is 'assembled' and response.output[1].type is 'reasoning',
      'Streaming completion restores isolated Items in output-index order when terminal output is empty')

   authoritative = openai_stream.Stream({ responseDecoder=openai.response, itemDecoder=openai.item })
   authoritative.feed('data: {"type":"response.output_item.done","output_index":0,"item":{' ..
      '"type":"message","content":[{"type":"output_text","text":"event"}]}}\n\n')
   authoritative.feed('data: {"type":"response.completed","response":{"id":"authoritative","output":[' ..
      '{"type":"message","content":[{"type":"output_text","text":"terminal"}]}]}}\n\n')
   authoritative_response, authoritative_err = authoritative.result()
   assert(not authoritative_err and authoritative_response.outputText() is 'terminal' and
      #authoritative_response.output is 1, 'Non-empty terminal output remains authoritative')
end

@Test function NamespacedToolsValidateDeclareAndDispatchByNamespace()
   schema = { type='object', properties={ id={ type='integer' } }, required=array<str> { 'id' },
      additionalProperties=false }
   calls = array<str>
   approvals = array<table>
   registry = openai.ToolRegistry({ approve=function(Info) approvals.push(Info); return true end })
   registry.register('lookup', schema, function(Arguments) calls.push('top'); return 'top' end)
   registry.register('lookup', schema, function(Arguments) calls.push('crm'); return 'crm' end,
      { namespace='crm', consequential=true })
   registry.describeNamespace('crm', 'Customer tools')

   declarations = registry.declarations()
   assert(#declarations is 2 and declarations[0].type is 'namespace' and declarations[0].name is 'crm' and
      declarations[0].description is 'Customer tools' and #declarations[0].tools is 1 and
      declarations[0].tools[0].name is 'lookup' and declarations[1].type is 'function',
      'Namespaced functions are grouped into a namespace declaration')

   captured:any = nil
   client = fixtureClient(function(Request)
      captured = json.decode(Request.body)
      return { status=200, body='{"id":"resp","output":[{"type":"function_call","namespace":"crm",' ..
         '"name":"lookup","call_id":"c1","arguments":"{\\"id\\":1}"}]}' }
   end)
   response, err = client.responses.create({ model='model-a', input=array<table> { { role='user', content='Hi' },
      { type='additional_tools', role='developer', tools=declarations } }, tools=declarations })
   assert(not err and captured.tools[0].tools[0].name is 'lookup' and captured.input[1].type is 'additional_tools',
      'Namespace tools and additional_tools Items pass validation unchanged')

   call = response.functionCalls()[0]
   assert(call.namespace is 'crm', 'Typed function_call Items expose their namespace')
   output, err = registry.dispatch(call)
   assert(not err and output.output is 'crm' and calls[0] is 'crm' and approvals[0].namespace is 'crm',
      'A namespaced call dispatches only to the matching namespaced function')
   output, err = registry.dispatch({ type='function_call', name='lookup', call_id='c2', arguments='{"id":1}' })
   assert(not err and output.output is 'top' and #approvals is 1, 'An un-namespaced call never matches a namespace')
   _, err = registry.dispatch({ type='function_call', namespace='other', name='lookup', call_id='c3',
      arguments='{"id":1}' })
   assert(err.code is 'tool_not_allowed' and err.namespace is 'other' and #calls is 2,
      'An unregistered namespace is outside the allow-list')
   _, err = registry.dispatch({ type='function_call', namespace='bad/name', name='lookup', call_id='c4',
      arguments='{"id":1}' })
   assert(err.code is 'invalid_call', 'Malformed namespace values are rejected')

   function rejected(Tools:array<table>, Code:str, Message:str)
      _, request_err = client.responses.create({ model='model-a', input='x', tools=Tools })
      assert(request_err and request_err.code is Code, Message)
   end
   function fn(Name:str):table return { type='function', name=Name, parameters=schema, strict=true } end
   rejected(array<table> { { type='namespace', name='outer', tools=array<table> {
      { type='namespace', name='inner', tools=array<table> { fn('a') } } } } }, 'invalid_tool',
      'Namespaces cannot be nested')
   rejected(array<table> { { type='namespace', name='mixed', tools=array<table> { { type='web_search' } } } },
      'invalid_tool', 'Namespaces only contain function and custom tools')
   rejected(array<table> { { type='namespace', name='empty', tools=array<table> } }, 'invalid_tool',
      'Namespaces require at least one tool')
   rejected(array<table> { fn('same'), fn('same') }, 'duplicate_tool', 'Function names are unique in a scope')
   rejected(array<table> { { type='namespace', name='strict', tools=array<table> { { type='function', name='loose',
      strict=true, parameters={ type='object', properties={ id={ type='integer' } } } } } } },
      'invalid_strict_schema', 'Strict schemas inside namespaces are validated')
   _, err = client.responses.create({ model='model-a', input=array<table> {
      { type='additional_tools', tools=array<table> { fn('dup'), fn('dup') } } } })
   assert(err and err.code is 'duplicate_tool', 'additional_tools Items are validated like top-level tools')
end
