@Package(name="gui/dialog", version="1.0")

--[[
Display a dialog message to the user.

Documentation is available in the Kotuku Wiki.
--]]

   import 'gui', 'gui/layout', 'gui/window', 'gui/button', 'gui/input', 'gui/toggle'

   include 'vector'

   module vector as mVec

   namespace gui

SCALE     <const> = gui.interface.dpi / 96 -- Sizes are in pixels at 96 DPI
MIN_WIDTH <const> = math.round(300 * SCALE)
MAX_WIDTH <const> = math.round(600 * SCALE)
ICON_SIZE <const> = math.round(72 * SCALE)
GAP       <const> = gui.sizing.widget.gap     -- Space between buttons
ICON_GAP  <const> = gui.sizing.widget.gap * 2 -- Horizontal space between the icon and the message column

-- Vertical spacing, in ems of the message font, so that it follows the size of the text.

TOP_SPACING     <const> = 1    -- Between the top margin and the icon and message
MESSAGE_SPACING <const> = 1    -- Between the message and the widgets beneath it
ROW_SPACING     <const> = 1    -- Between rows of widgets
BUTTON_SPACING  <const> = 1.25 -- Above the buttons

ICONS <const> = {
   error     = 'items/error',
   critical  = 'items/error',
   warning   = 'items/alert_circle',
   help      = 'items/question',
   question  = 'items/question',
   request   = 'items/request',
   info      = 'items/info'
}

   gui.dialog ?= { }

-- Return the length of the longest prefix of Word that fits Width pixels, cut at a UTF-8 character boundary.  At least
-- one character is always returned.

function fitLength(Font:any!, Word:str!, Width:num!):num
   cut = #Word
   while cut > 1 do
      cut -= 1
      while (cut > 1) and ((Word.byte(cut) & 0xc0) is 0x80) do cut -= 1 end -- Step back over continuation bytes
      if mVec.StringWidth(Font, Word.sub(0, cut), -1) <= Width then return cut end
   end

   cut = 1
   while (cut < #Word) and ((Word.byte(cut) & 0xc0) is 0x80) do cut++ end
   return cut
end

-- Word-wrap Text to fit Width pixels when drawn with Font.  Line breaks in Text are preserved.  A word that is too
-- wide for a line of its own, such as a long file path, is broken between characters.

function wrapText(Font:any!, Text:str!, Width:num!):array<str>
   lines = array<str>
   for para in values(Text.split('\n')) do
      line = ''
      for word in values(para.split(' ')) do
         if #word is 0 then continue end
         candidate = (#line > 0) ? f'{line} {word}' : word
         if mVec.StringWidth(Font, candidate, -1) <= Width then
            line = candidate
            continue
         end

         if #line > 0 then lines.push(line) end
         while mVec.StringWidth(Font, word, -1) > Width do
            cut = fitLength(Font, word, Width)
            lines.push(word.sub(0, cut))
            word = word.sub(cut)
         end
         line = word
      end
      lines.push(line)
   end
   return lines
end

-- The response options are accepted as a list table or an array.  Any other value results in a single Close option.

function readOptions(Options:any):array<table>
   list = array<table>
   if Options is <array> then
      for _, option in Options do list.push(option) end
   elseif Options is <table> then
      for _, option in ipairs(Options) do list.push(option) end
   end

   if #list is 0 then
      list.push({ id=1, label='Close Dialog', icon='items/cancel' })
   end
   return list
end

gui.dialog.message = function(Options:table!)
   if not (Options.message is <str>) then
      raise 'Dialog requires a message string.'
   end

   self = entity { -- Public interface
      options       = readOptions(Options.options),
      type          = Options.type,
      feedback      = Options.feedback,
      inputRequired = Options.inputRequired,
      message       = Options.message,
      scaleWindow   = Options.scale is false ? nil : true, -- Scale by default
      buttons       = array<table>, -- One button per option, in the same order
      input         = nil, -- The input box, if userInput is set
      checkbox      = nil, -- The toggle, if checkboxLabel is set
      messageText   = nil, -- The VectorText that displays the message
      viewport      = nil  -- The client viewport that contains the dialog content
   }

   local font, em, text_width, content_height, primary, buttons_width

   -- Wait for the user to respond to the dialog.

   self.wait = function()
      &waiting = true
      processing.sleep(-1)
      &waiting = nil
   end

   -- Release the dialog once the user has responded.  The window is closed when the dialog table is collected.

   function[self] finish()
      if &waiting then processing.signal() end
      &keyboard?.unsubscribe()
      &clear()
      processing.collect('defer')
   end

   -- Report the option at Index to the client.  Bound to the dialog, as button callbacks run in the button's context.

   function[self] respond(Index:num!)
      if not &window then return end -- The dialog has already responded

      response = &options[Index]
      state = { checkbox = (&checkbox?.value is true) }

      if &input then
         text = &input.getText()
         if #text > 0 then state.input = text end
      end

      if &inputRequired and not state.input then
         -- If input is mandatory, the response is cancelled when no input is given
         response = nil
      end

      &feedback?(&&, response, state)
      finish()
   end

   function[self] cancel()
      if not &window then return end
      &feedback?(&&, nil, nil)
      finish()
   end

   -- Wrap the message to the message column and position everything beneath it.  The window is resized to fit the
   -- content.  The message is aligned with the top of the icon.

   function arrange()
      lines = wrapText(font, &message, text_width)
      &messageText.string = lines.concat('\n')

      _, ascent = gui.layout.textMetrics(&messageText)
      top = &window.margins.top + (em * TOP_SPACING)
      &image?.y = 0
      &messageText.y = math.round(top + ascent)

      -- Each row is placed beneath the bottom of the content above it.

      bottom = top + (&messageText.lineSpacing * #lines)
      y = bottom + (em * MESSAGE_SPACING)

      if &input then
         &input.viewport.y = math.round(y)
         bottom = y + &input.viewport.height
         y = bottom + (em * ROW_SPACING)
      end

      if &checkbox then
         &checkbox.viewport.y = math.round(y)
         bottom = y + &checkbox.viewport.height
         y = bottom + (em * ROW_SPACING)
      end

      if &contentViewport then
         &contentViewport.y = math.round(y)
         bottom = y + content_height
      end

      -- The buttons are right-aligned.  A row of buttons that is wider than the message column widens the window.

      width = math.max(&window.margins.left + ICON_SIZE + ICON_GAP + text_width + &window.margins.right, buttons_width + (&window.margins.left + &window.margins.right))
      y = math.round(math.max(bottom, top + ICON_SIZE) + (em * BUTTON_SPACING))
      x = width - &window.margins.right - buttons_width
      for btn in values(&buttons) do
         btn.viewport.{ x = math.round(x), y = y }
         x += btn.viewport.width + GAP
      end

      height = y + &buttons[0].viewport.height + &window.margins.bottom

      if &scaleWindow then
         &viewport.{ viewWidth = width, viewHeight = height }
      end

      if (width != &layoutWidth) or (height != &layoutHeight) then
         &layoutWidth  = width
         &layoutHeight = height
         &window.surface.{ width = width, height = height }
         if &scaleWindow then
            &window.sizeHints(math.round(width * 0.5), math.round(height * 0.5), width * 3, height * 3, true)
         else
            &window.sizeHints(width, height, width, height, false)
         end
      end
   end

   -- Change the message in the dialog

   self.setMessage = function(Message:str!)
      if not &window then return end
      &message = Message
      arrange()
      &viewport.acDraw()
   end

   using self do
      &window = gui.window({
         insideWidth  = MIN_WIDTH,
         insideHeight = ICON_SIZE,
         quit         = Options.quit ?? false,
         popOver      = Options.popOver,
         aspectRatio  = &scaleWindow,
         icon         = Options.icon ?? 'items/question',
         title        = Options.title ?? 'Confirmation Required',
         modal        = Options.modal ?? false,
         events = {
            close = function()
               cancel()
            end
         }
      })

      &viewport = &window.clientViewport()
      theme = &window.theme

      -- The image beside the message.  An image that fails to load is logged and omitted.

      image = Options.image ?? ICONS[&type] ?? 'items/question'
      try
         icon = gui.createIcon(&viewport.scene, image, ICON_SIZE, theme.window.icon)
         &image = &viewport.new('VectorViewport', {
            x      = &window.margins.left - icon.margin,
            y      = 0, -- See arrange()
            width  = icon.size + (icon.margin * 2),
            height = icon.size + (icon.margin * 2),
            fill   = icon.fill
         })
         &imageMargin = icon.margin
      except ex
         msg(f'Failed to load dialog image "{image}": {ex.message}')
      end

      &messageText = &viewport.new('VectorText', table.merge({ x = &window.margins.left + ICON_SIZE + ICON_GAP, y = 0 }, theme.window.text))

      em = tonumber(&messageText.fontSize) -- The font size reads back in pixels
      _, font = check mVec.GetFontHandle(&messageText.face, &messageText.fontStyle, 0, em)

      -- The message column is as wide as the widest paragraph, within the dialog limits.

      widest = 0
      for para in values(&message.split('\n')) do
         if #para > 0 then widest = math.max(widest, mVec.StringWidth(font, para, -1)) end
      end

      text_width = math.clamp(math.ceil(widest), MIN_WIDTH - &window.margins.left - ICON_SIZE - ICON_GAP - &window.margins.right, MAX_WIDTH - &window.margins.left - ICON_SIZE - ICON_GAP - &window.margins.right)

      -- The last option is the default, unless the client marks another as primary.

      primary = #&options - 1
      for i, option in &options do
         if option.primary then primary = i end
      end

      -- Widgets are created in their visual order, which the scene follows for the tab order.

      if Options.userInput then
         &input = gui.input({
            target    = &viewport,
            x         = &window.margins.left + ICON_SIZE + ICON_GAP,
            width     = text_width,
            text      = (Options.userInput is <str>) ? Options.userInput : '',
            secret    = Options.secret,
            selectAll = true,
            events    = {
               activate = function(Event)
                  if Event.state is 'activated' then respond(primary) end
               end
            }
         })
      end

      if Options.checkboxLabel then
         &checkbox = gui.toggle({
            target = &viewport,
            x      = &window.margins.left + ICON_SIZE + ICON_GAP,
            label  = Options.checkboxLabel,
            value  = Options.checkboxState ? 1 : 0
         })
      end

      -- Client content is hosted in a viewport beneath the input box and checkbox, and returns the height that it uses.

      if Options.content then
         &contentViewport = &viewport.new('VectorViewport', {
            x = &window.margins.left + ICON_SIZE + ICON_GAP, y = 0, width = text_width, height = 1
         })
         content_height = Options.content(&&, &contentViewport, text_width) ?? 0
         &contentViewport.height = math.max(1, content_height)
      end

      buttons_width = 0
      for i, option in &options do
         btn = gui.button({
            target  = &viewport,
            label   = option.label,
            icon    = option.icon,
            primary = (i is primary),
            events  = {
               activate = function()
                  respond(i)
               end
            }
         })
         &buttons.push(btn)
         if i > 0 then buttons_width += GAP end
         buttons_width += btn.viewport.width
      end

      arrange()

      -- Escape cancels the dialog while its window has the focus.  The keys are monitored through the surface rather
      -- than a vector subscription, which would add the client viewport to the tab order.

      &keyboard = input.keyboard(&window.surface, function(Handle, SurfaceID:num, Qualifiers:num!, Code:num!, Unicode)
         if (Code is KEY_ESCAPE) and (Qualifiers has KQ_PRESSED) and not (Qualifiers has KQ_REPEAT) then
            cancel()
         end
      end)

      -- The input box receives the focus, with its text selected so that typing replaces it.  As the first widget, the
      -- scene gives it the focus when the window receives the focus.  Otherwise the default button takes the focus, so
      -- that Enter activates it.  A vector can't take the focus until the window has it, so this is deferred to the
      -- window's first focus if necessary.

      &window.moveToFront()
      &window.show(true)

      if not &input then
         default_button = &buttons[primary].viewport
         if default_button.acFocus() != ERR_Okay then
            pending = true
            &window.surface.subscribe('focus', function[self](Surface, Args)
               if pending and &window then
                  pending = false
                  default_button.acFocus()
               end
            end)
         end
      end

      return &&
   end
end

gui.dialog.error = function(Title:str!, Message:str!, Options:table):table
   Options ?= { }
   Options.{ type = 'error', title = Title, message = Message, scale = true }
   return gui.dialog.message(Options)
end

   -- This sub-routine is provided for languages other than Tiri to utilise the module.

@if(imported=false)
   dlg = gui.dialog.message({
      popOver    = arg('popOver'),
      modal      = arg('modal'),
      options    = arg('options'),
      message    = arg('message'),
      checkboxLabel = arg('checkboxLabel'),
      checkboxState = arg('checkboxState'),
      icon       = arg('icon'),
      image      = arg('image'),
      userInput  = arg('userInput', nil),
      secret     = arg('secret')
   })

   return dlg.window.surface.id, dlg.viewport.id
@end
