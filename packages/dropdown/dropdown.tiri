@Package(name="gui/dropdown", version="1.0")

--[[
Internal script for combobox drop-down menus.
--]]

   import 'gui'
   include 'display'

   namespace gui

   module display as mGfx

FONT_MAX_HEIGHT, FONT_HEIGHT = gui.getFontHeight(gui.fonts.menu)
ITEM_HEIGHT  <const> = math.floor(FONT_MAX_HEIGHT * 1.5)
VMARGIN      <const> = math.floor(ITEM_HEIGHT * 0.33)
HMARGIN      <const> = 6
ICON_SIZE    <const> = math.floor(ITEM_HEIGHT * 0.8)
ITEM_SPACING <const> = 1.2

gui.dropdown = function(Options)
   local theme = Options.theme ?? gui.getTheme()

   self = entity { -- Public variables
      surface  = nil,
      timeShow = 0,
      timeHide = 0,
      visible  = false,
      client   = Options.client,
      feedback = Options.feedback,
      x        = Options.x ?? 0,
      y        = Options.y ?? 0,
      relative = Options.relative,
      items    = { }
   }

   -- toggle() alternates the visible state of the menu.  A TimeLapse is supported so that rapid changes to
   -- menu visibility can be avoided.

   lastTime = 0
   self.toggle = function(TimeLapse:num)
      timelapse = TimeLapse and TimeLapse >= 0 ? TimeLapse * 1000 : 5000

      currentTime = mSys.PreciseTime()
      if &timeShow > &timeHide then -- Hide the menu
         if (currentTime - &timeShow >= timelapse) then &hide() end
         lastTime = currentTime
         return 0
      else
         if (currentTime - &timeHide >= timelapse) then &show() end
         lastTime = currentTime
         return 1
      end
   end

   self.selectItem = function()

   end

   self.getItem = function()

   end

   self.hide = function()
      &surface.acHide()
      &timeHide = mSys.PreciseTime()
   end

   self.show = function()
      surface = &surface
      if surface.flags has RNF_VISIBLE then return end

      if &relative then
         -- Correct the position of the menu according to the relative vector that it is offset from.

         err, relative_pos = mGfx.GetSurfaceInfo(&relative.scene.surface)
         if err is ERR_Okay then
            rel = { absX = relative_pos.absX, absY = relative_pos.absY }
            local target = { absX = 0, absY = 0, height = 4096 }

            if Options.target then
               local err, info = mGfx.GetSurfaceInfo(Options.target)
               if err is ERR_Okay then
                  target.absX   = info.absX
                  target.absY   = info.absY
                  target.height = info.height
               end
            else
               err, display = mGfx.GetDisplayInfo(0)
               if err is ERR_Okay then
                  target.height = display.height
               end
            end

            x = rel.absX + &x - target.absX
            y = rel.absY + &y - target.absY

            if &reverseY then
               y = rel.absY + (Options.y ?? 0) - target.absY - surface.height
            end

            if y + surface.height > target.height then
               y -= surface.height - (Options.y ?? 0)
            end

            surface.acMoveToPoint(x, y, 0, MTF_X|MTF_Y)
         end
      end

      &surface.acShow()
      &surface.acMoveToFront()
      &timeShow = mSys.PreciseTime()
   end

   function highlightItem(Item:table)
      if Item is &hItem then
         return
      elseif Item then
         if Item.lineBreak or Item.disabled then
            return
         end
      end

      if &hItem then -- Redraw the previously highlighted item
         &hItem.text.fill = theme.dropdown.text
         if &hItem.iconView then
            &hItem.iconView.fill = &hItem.iconFill
         end
         &surface.mtScheduleRedraw()
         &hItem = nil
      end

      &hItem = Item

      if Item then -- Draw the newly highlighted area
         Item.text.fill = theme.dropdown.textHighlight
         if Item.iconView then
            Item.iconView.fill = Item.iconHighlightFill
         end
         &highlight.y = Item.y
         &highlight.height = Item.height
         &highlight.visibility = 'visible'
         &surface.mtScheduleRedraw()
      else
         &highlight.visibility = 'hidden'
         &surface.mtScheduleRedraw()
      end
   end

   -- Main entry point --

   using self do
      assert(Options.config, 'A config value is required to define the Menu items')

      &surface = obj.new('surface')
      &surface.name     = 'menu'
      &surface.width    = Options.width ?? 400
      &surface.parent   = Options.target
      &surface.flags    = RNF_STICK_TO_FRONT|RNF_COMPOSITE
      &surface.x        = -10000
      &surface.y        = -10000
      &surface.presence = SPT_NONE
      &surface.height   = 400
      &surface.init()

      &scene = obj.new('VectorScene', { flags=VPF_RESIZE, surface=&surface })
      &viewport = &scene.new('VectorViewport', { })

      &surface.subscribe('free', function(Surface, Args)
         &surface = nil
      end)

      &surface.subscribe('hide', function(Surface, Args)
         &visible = false
         &timeHide = mSys.PreciseTime()
      end)

      &surface.subscribe('show', function(Surface, Args)
         &visible = true
         &timeShow = mSys.PreciseTime()

         -- Keyboard support requires a client reference to grab input from.

         if &client and (not &_subscribedKb) then
            if &client.mtSubscribeKeyboard(function(Viewport, Qualifiers, Value, Unicode)
               if not &visible then
                  &_subscribedKb = false
                  raise ERR_Terminate
               end

               if not (Qualifiers has KQ_PRESSED) then return end

               if Value is KEY_UP then

               elseif Value is KEY_DOWN then

               elseif Value is KEY_ENTER then

               end
            end) is ERR_Okay then
               &_subscribedKb = true
            end
         end
      end)

      &viewport.mtSubscribeInput(JTYPE_MOVEMENT | JTYPE_BUTTON | JTYPE_CROSSING, function(Viewport, Events)
         ev = Events
         while ev do
            if ev.type is JET_BUTTON_1 then
               if ev.value is 1 then
                  if &hItem then -- Menu item activated
                     &hItem.config?.feedback(self, &hItem.config)
                     self?.feedback(self, &hItem.config)
                     &surface.acHide()
                  end
               end
            elseif ev.type is JET_ABS_XY then
               highlightFound = false
               for item in values(&items) do
                  if not item.lineBreak then
                     if (ev.y >= item.y) and (ev.y < item.y + item.height) then
                        if &hItem != item then
                           highlightItem(item)
                        end
                        highlightFound = true
                        break
                     end
                  end
               end

               -- Remove existing menu highlighting if the cursor is no longer positioned over a highlight-able item.

               if not highlightFound and &hItem then
                  highlightItem(nil)
               end
            elseif ev.type is JET_CROSSED_OUT then
               if &hItem then highlightItem(nil) end
            end

            ev = ev.next
         end
      end)

      showIcons = Options.showIcons is false ? nil : true
      TEXT_X = HMARGIN

      if showIcons then
         iconsPresent = false
         for item in values(Options.config) do
            if item.icon then
               iconsPresent = true
               TEXT_X = HMARGIN + ICON_SIZE + HMARGIN + HMARGIN
            end
         end
      end

      &viewport.new('VectorRectangle', { -- Background
         fill = theme.dropdown.bkgd,
         x = 1.5, y = 1.5, roundX = 3, roundY = 3, width = 1, height = 1,
         resizeEvent = function(Viewport:obj!, Vector:obj!, X:num!, Y:num!, Width:num!, Height:num!)
            Vector.width  = Width - (Vector.x * 2)
            Vector.height = Height - (Vector.y * 2)
         end
      })

      &highlight = &viewport.new('VectorRectangle', {
         x = 2, y = 0, xOffset = 2, height = ITEM_HEIGHT, fill = theme.menu.highlight, visibility = 'hidden'
      })

      &viewport.new('VectorRectangle', { -- Menu border
         stroke = theme.dropdown.stroke,
         strokeWidth = 1.5, x = 1.5, y = 1.5, roundX = 3, roundY = 3, width = 1, height = 1,
         resizeEvent = function(Viewport, Vector, X, Y, Width, Height)
            Vector.width  = Width - (Vector.x * 2)
            Vector.height = Height - (Vector.y * 2)
         end
      })

      &items = { }
      widestItem = 0
      widestKey = 0
      y = VMARGIN
      for item in values(Options.config) do
         if item['item'] then
            mi = { y=y, config=item }
            vText = &viewport.new('VectorText', {
               x        = TEXT_X,
               face     = gui.fonts.menu.face,
               fontSize = string.format('%.2fpt', gui.fonts.menu.size),
               fontStyle = gui.fonts.menu.style,
               fill     = theme.page.text,
               align    = 'left',
               string   = item['item']
            })

            bw = [___*_]vText.mtGetBoundary(0)

            mi.text = vText
            mi.textY = math.floor(y + ((vText.lineSpacing + vText.displayHeight) * 0.5))

            if bw > widestItem then widestItem = bw end

            if showIcons and item.icon then
               try
                  info = gui.createIcon(&viewport.scene, item.icon, ICON_SIZE, theme.dropdown.icon)
                  mi.iconFill = info.fill

                  if theme.dropdown.iconHighlight and theme.dropdown.iconHighlight != theme.dropdown.icon then
                     local info = gui.createIcon(&viewport.scene, item.icon, ICON_SIZE, theme.dropdown.iconHighlight)
                     mi.iconHighlightFill = info.fill
                  else
                     mi.iconHighlightFill = mi.iconFill
                  end

                  mi.iconView = &viewport.new('VectorRectangle', {
                     x = HMARGIN, y = math.ceil(y + (ITEM_HEIGHT - ICON_SIZE) * 0.5), width = ICON_SIZE, height = ICON_SIZE, fill = info.fill
                  })
               end
            end

            vText.y = mi.textY
            mi.height = vText.lineSpacing * ITEM_SPACING
            y = math.floor(y + mi.height)

            &items.insert(mi)
         end
      end

      &surface.width  = TEXT_X + widestItem + (HMARGIN * 3) + widestKey + HMARGIN
      &surface.height = y + VMARGIN

      return &&
   end
end
