-- Protected persistence and opaque identifier helpers for ai/chatgpt.

   import 'json'

   namespace chatgpt_storage { }

function hexByte(Value:num):str
   digits <const> = '0123456789abcdef'
   return digits.sub((Value >> 4) & 15, ((Value >> 4) & 15) + 1) ..
      digits.sub(Value & 15, (Value & 15) + 1)
end

chatgpt_storage.hostID = function(RandomBytes:func!):str
   bytes = array<byte, 16>
   check RandomBytes(bytes)
   bytes[6] = (bytes[6] & 15) | 64
   bytes[8] = (bytes[8] & 63) | 128
   text = array<str>
   for index, value in bytes do
      if index is 4 or index is 6 or index is 8 or index is 10 then text.push('-') end
      text.push(hexByte(value))
   end
   return 'urn:uuid:' .. text.concat()
end

function validText(Value:any, Limit:num):bool
   return Value is <str> and Value != '' and #Value <= Limit and not r'[\x00-\x1f\x7f]'.test(Value)
end

function validNumber(Value:any):bool
   return Value is <num> and Value is Value and Value >= 0 and Value <= 9007199254740991
end

function validated(State:any):table
   if not (State is <table>) or State.schemaVersion != 1 or
      not validText(State.hostID, 128) or not State.hostID.startsWith('urn:uuid:') or
      not (State.accounts is <array>) or #State.accounts > 64 then
      raise 'Invalid ai/chatgpt credential store'
   end
   seen = {}
   for account_record in values(State.accounts) do
      if not (account_record is <table>) or not validText(account_record.id, 128) or seen[account_record.id] or
         not validText(account_record.clientID, 256) or account_record.clientID is 'dynamic_agent_client' or
         not validText(account_record.subject, 255) then
         raise 'Invalid ai/chatgpt account record'
      end
      seen[account_record.id] = true
      if account_record.email != nil and not validText(account_record.email, 1024) then
         raise 'Invalid ai/chatgpt account email'
      end
      if account_record.label != nil and not validText(account_record.label, 1024) then
         raise 'Invalid ai/chatgpt account label'
      end
      token = account_record.token
      if token != nil then
         identity = token.identity
         if not (token is <table>) or not validText(token.access_token, 65536) or
            token.token_type != 'Bearer' or not validText(token.scope, 4096) or
            token.clientID != account_record.clientID or token.validated_oidc != true or
            not (identity is <table>) or identity.issuer != 'https://auth.openai.com' or
            identity.subject != account_record.subject or identity.clientID != account_record.clientID or
            (token.refresh_token != nil and not validText(token.refresh_token, 65536)) or
            (token.id_token != nil and not validText(token.id_token, 65536)) or
            (token.expires_at != nil and not validNumber(token.expires_at)) or
            (token.refresh_at != nil and not validNumber(token.refresh_at)) or
            (token.earliest_refresh_at != nil and not validNumber(token.earliest_refresh_at)) then
            raise 'Invalid ai/chatgpt token record'
         end
      end
   end
   if State.activeID != nil and (not validText(State.activeID, 128) or not seen[State.activeID]) then
      raise 'Invalid ai/chatgpt active account'
   end
   return State
end

chatgpt_storage.newState = function(RandomBytes:func!):table
   return { schemaVersion=1, hostID=chatgpt_storage.hostID(RandomBytes), activeID=nil, accounts=array<table> }
end

chatgpt_storage.ProtectedStore = function(Path:str, WriteProtectedFile:func!):table
   path = Path or 'user:config/ai_chatgpt_credentials.json'
   if not validText(path, 4096) then raise 'Invalid ai/chatgpt credential path' end
   self = { path=path }

   self.loadState = function():table
      status = mSys.AnalysePath(path)
      if status is ERR_FileNotFound then return nil end
      if status != ERR_Okay then raise status, 'Unable to inspect ai/chatgpt credential storage' end
      file <close> = obj.new('file', { path=path })
      if file.size > 1048576 then raise 'ai/chatgpt credential store exceeds its size limit' end
      content = array<byte, file.size>
      check mSys.ReadFileToBuffer(path, content)
      raw = content.getString()
      decoded:any = nil
      try decoded = json.decode(raw) except e raise 'Unable to decode ai/chatgpt credential store' end
      return validated(decoded)
   end

   self.saveState = function(State:table):bool
      validated(State)
      encoded = json.encode(State)
      if #encoded > 1048576 then raise 'ai/chatgpt credential store exceeds its size limit' end
      err = WriteProtectedFile(path, encoded)
      if err != ERR_Okay then raise err, 'Unable to atomically save ai/chatgpt credentials' end
      return true
   end

   self['load'] = self.loadState
   self['save'] = self.saveState

   return self
end

chatgpt_storage.validate = validated
