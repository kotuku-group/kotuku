-- Responses value normalisation, request validation, history and custom tool dispatch.

   import 'json'
   import './bounded_json'

   namespace openai_responses { }

function copyValue(Value:any, Depth:num):any
   if Depth > 64 then raise 'OpenAI value nesting exceeds the supported limit' end
   if Value is json.null then return json.null end
   if Value is <array> then
      result = array<any>
      for item in values(Value) do result.push(copyValue(item, Depth + 1)) end
      return result
   end
   if Value is <table> then
      result = {}
      for key, item in pairs(Value) do
         if not (key is <str>) and not (key is <num>) then raise 'OpenAI object keys must be strings or numbers' end
         result[key] = copyValue(item, Depth + 1)
      end
      return result
   end
   if Value is <str> or Value is <num> or Value is <bool> or Value is <nil> then return Value end
   raise 'OpenAI values must be JSON-compatible'
end

openai_responses.copy = function(Value:any):any return copyValue(Value, 0) end

function encodeValue(Value:any, Depth:num):str
   if Depth > 64 then raise 'OpenAI value nesting exceeds the supported limit' end
   if Value is json.null then return 'null' end
   if Value is <array> then
      pieces = array<str> { '[' }
      for index, item in Value do
         if index > 0 then pieces.push(',') end
         pieces.push(encodeValue(item, Depth + 1))
      end
      pieces.push(']')
      return pieces.concat()
   end
   if Value is <table> then
      pieces = array<str> { '{' }
      first = true
      for key, item in pairs(Value) do
         if not (key is <str>) and not (key is <num>) then raise 'OpenAI object keys must be strings or numbers' end
         if not first then pieces.push(',') end
         first = false
         pieces.push(json.encode(key, nil, true), ':', encodeValue(item, Depth + 1))
      end
      pieces.push('}')
      return pieces.concat()
   end
   if Value is <num> and (Value != Value or Value is math.huge or Value is -math.huge) then
      raise 'OpenAI numbers must be finite'
   end
   if Value is <str> or Value is <num> or Value is <bool> or Value is <nil> then return json.encode(Value) end
   raise 'OpenAI values must be JSON-compatible'
end

openai_responses.encode = function(Value:any):str return encodeValue(Value, 0) end

function itemKind(Type:str):str
   known = { message='message', reasoning='reasoning', function_call='function_call',
      function_call_output='function_call_output', file_search_call='file_search_call',
      web_search_call='web_search_call', computer_call='computer_call', image_generation_call='image_generation_call',
      code_interpreter_call='code_interpreter_call', local_shell_call='local_shell_call' }
   return known[Type] or 'unknown'
end

@Doc(text=[[
Wraps a raw Responses Item in a typed table without discarding any provider data.

The `kind` field names the Item type when it is known to this package, or is `unknown` for future types.  Common
fields (`id`, `role`, `status`, `content`, `name`, `namespace`, `arguments`, `call_id` and `output`) are lifted for
convenience.  The complete Item, including unknown fields and content parts, is kept as a private copy in `raw`.

-INPUT-
Raw: A JSON-compatible Item table.

-RESULTS-
table: The typed Item, with `type`, `kind` and `raw` fields.
]])
openai_responses.item = function(Raw:table):table
   raw = openai_responses.copy(Raw)
   item = { type=raw.type is <str> and raw.type or 'unknown', raw=raw }
   item.kind = itemKind(item.type)
   for key in values(array<str> { 'id', 'role', 'status', 'content', 'name', 'namespace', 'arguments', 'call_id',
      'output' }) do
      item[key] = raw[key]
   end
   return item
end

@Doc(text=[[
Wraps a raw Responses object in the response table returned by non-streaming and streaming requests.

The response exposes `id`, `object`, `status`, `model`, `usage`, `error`, `incompleteDetails`, `output` (an array of
typed Items) and `raw` (a private copy of the complete payload).  Three helper methods are provided:

* `outputText()` concatenates the `output_text` parts of message Items and ignores every other Item type.
* `functionCalls()` returns the typed function_call Items.
* `inputItems()` returns copies of the raw output Items, ready for replay in a later request's input.

-INPUT-
Raw: A JSON-compatible Responses object.

-RESULTS-
table: The response wrapper.
]])
openai_responses.response = function(Raw:table):table
   raw = openai_responses.copy(Raw)
   response = { raw=raw, id=raw.id, object=raw.object, status=raw.status, model=raw.model,
      usage=raw.usage, error=raw.error, incompleteDetails=raw.incomplete_details, output=array<table> }
   if raw.output is <array> then
      for value in values(raw.output) do
         if value is <table> and value != json.null then response.output.push(openai_responses.item(value)) end
      end
   end
   response.outputText = function():str
      text = array<str>
      for item in values(response.output) do
         if item.type is 'message' and item.content is <array> then
            for part in values(item.content) do
               if part is <table> and part.type is 'output_text' and part.text is <str> then text.push(part.text) end
            end
         end
      end
      return text.concat()
   end
   response.functionCalls = function():array<table>
      calls = array<table>
      for item in values(response.output) do if item.type is 'function_call' then calls.push(item) end end
      return calls
   end
   response.inputItems = function():array<table>
      items = array<table>
      for item in values(response.output) do items.push(openai_responses.copy(item.raw)) end
      return items
   end
   return response
end

openai_responses.event = function(Event:table):table
   raw = Event.raw
   result = Event
   if raw?.item is <table> and raw.item != json.null then result.item = openai_responses.item(raw.item) end
   if raw?.response is <table> and raw.response != json.null then
      result.response = openai_responses.response(raw.response)
   end
   result.kind = result.type
   return result
end

function validName(Name:any):bool
   return Name is <str> and #Name > 0 and #Name <= 64 and r'^[A-Za-z0-9_\-]+$'.test(Name)
end

function validateFormat(Format:table):table
   if not (Format.type is <str>) or not (Format.type is 'text' or Format.type is 'json_object' or
      Format.type is 'json_schema') then
      return { code='invalid_text_format', message='Unsupported text.format type' }
   end
   if Format.type is 'json_schema' and (not validName(Format.name) or not (Format.schema is <table>)) then
      return { code='invalid_text_format', message='json_schema text.format requires a name and schema' }
   end
   return nil
end

function strictSchema(Schema:any, Path:str, Depth:num):table
   if not (Schema is <table>) or Schema is json.null or Depth > 32 then
      return { code='invalid_strict_schema', message='Strict JSON Schema is malformed', path=Path }
   end
   if Schema.type is 'object' then
      if not (Schema.properties is <table>) or Schema.additionalProperties != false or
         not (Schema.required is <array>) then
         return { code='invalid_strict_schema',
            message='Strict object schemas require properties, required and additionalProperties=false', path=Path }
      end
      for name, child in pairs(Schema.properties) do
         if not (name in Schema.required) then
            return { code='invalid_strict_schema', message='Every strict object property must be required',
               path=Path .. '.' .. name }
         end
         err = strictSchema(child, Path .. '.' .. name, Depth + 1)
         if err then return err end
      end
   elseif Schema.type is 'array' and Schema.items != nil then
      return strictSchema(Schema.items, Path .. '[]', Depth + 1)
   end
   if Schema.anyOf is <array> then
      for index, child in Schema.anyOf do
         err = strictSchema(child, Path .. '.anyOf[' .. index .. ']', Depth + 1)
         if err then return err end
      end
   end
   return nil
end

-- Validates a tools array.  Namespaces group function and custom tools and cannot be nested.  Function names must be
-- unique within each scope because a function_call Item is matched by its namespace and name.

function validateTools(Tools:any, Path:str, InNamespace:bool):table
   if not (Tools is <array>) then
      return { code='invalid_tools', message='Responses tools must be an array', path=Path }
   end
   names = {}
   for tool in values(Tools) do
      if not (tool is <table>) or not (tool.type is <str>) then
         return { code='invalid_tool', message='Every Responses tool requires a type', path=Path }
      end
      if tool.type is 'namespace' then
         if InNamespace then
            return { code='invalid_tool', message='Tool namespaces cannot be nested', path=Path }
         end
         if not validName(tool.name) or not (tool.tools is <array>) or #tool.tools is 0 then
            return { code='invalid_tool', message='Tool namespaces require a valid name and a tools array',
               path=Path }
         end
         for nested in values(tool.tools) do
            if not (nested is <table>) or (nested.type != 'function' and nested.type != 'custom') then
               return { code='invalid_tool', message='Tool namespaces may only contain function and custom tools',
                  path=Path .. '.' .. tool.name }
            end
         end
         err = validateTools(tool.tools, Path .. '.' .. tool.name, true)
         if err then return err end
      elseif tool.type is 'function' then
         if not validName(tool.name) or not (tool.parameters is <table>) then
            return { code='invalid_tool', message='Function tools require a valid name and parameters schema',
               path=Path }
         end
         if tool.strict is true then
            err = strictSchema(tool.parameters, Path .. '.' .. tool.name, 0)
            if err then return err end
         end
      end
      if (tool.type is 'function' or tool.type is 'custom' or tool.type is 'namespace') and tool.name is <str> then
         if names[tool.name] then
            return { code='duplicate_tool', message='Tool names must be unique within their scope',
               path=Path .. '.' .. tool.name }
         end
         names[tool.name] = true
      end
   end
   return nil
end

openai_responses.validate = function(Request:any):<table, table>
   if not (Request is <table>) then
      return nil, { code='invalid_request', message='Responses request must be a table' }
   end
   if not (Request.model is <str>) or Request.model is '' or #Request.model > 512 then
      return nil, { code='invalid_model', message='Responses request requires a model identifier' }
   end
   if Request.input is nil or not (Request.input is <str>) and not (Request.input is <array>) then
      return nil, { code='invalid_input', message='Responses input must be a string or Item array' }
   end
   if Request.stream != nil and not (Request.stream is <bool>) then
      return nil, { code='invalid_stream', message='Responses stream must be boolean' }
   end
   if Request.text != nil then
      if not (Request.text is <table>) then
         return nil, { code='invalid_text', message='Responses text must be a table' }
      end
      if Request.text.format != nil then
         if not (Request.text.format is <table>) then
            return nil, { code='invalid_text_format', message='Responses text.format must be a table' }
         end
         format_err = validateFormat(Request.text.format)
         if format_err then return nil, format_err end
      end
   end
   if Request.tools != nil then
      tools_err = validateTools(Request.tools, '$.tools', false)
      if tools_err then return nil, tools_err end
   end
   if Request.input is <array> then
      for index, item in Request.input do
         if item is <table> and item.type is 'additional_tools' then
            tools_err = validateTools(item.tools, f'$.input[{index}].tools', false)
            if tools_err then return nil, tools_err end
         end
      end
   end
   local copied:table
   try copied = openai_responses.copy(Request) except e
      return nil, { code='invalid_json_value', message='Responses request contains a non-JSON value' }
   end
   return copied
end

function typeMatches(Value:any, Expected:any):bool
   if Expected is <array> then
      for candidate in values(Expected) do if typeMatches(Value, candidate) then return true end end
      return false
   end
   if Expected is 'object' then return Value is <table> and Value != json.null end
   if Expected is 'array' then return Value is <array> end
   if Expected is 'string' then return Value is <str> end
   if Expected is 'number' then return Value is <num> end
   if Expected is 'integer' then return Value is <num> and Value is math.floor(Value) end
   if Expected is 'boolean' then return Value is <bool> end
   if Expected is 'null' then return Value is json.null end
   return false
end

function schemaError(Path:str):table
   return { code='argument_schema', message='Tool argument schema contains an invalid constraint', path=Path }
end

function jsonEqual(Left:any, Right:any, Depth:num):bool
   if Depth > 32 then return false end
   if Left is json.null or Right is json.null then return Left is Right end
   if Left is <array> or Right is <array> then
      if not (Left is <array>) or not (Right is <array>) or #Left != #Right then return false end
      for index, value in Left do
         if not jsonEqual(value, Right[index], Depth + 1) then return false end
      end
      return true
   end
   if Left is <table> or Right is <table> then
      if not (Left is <table>) or not (Right is <table>) or table.size(Left) != table.size(Right) then return false end
      for key, value in pairs(Left) do
         if not (key in Right) or not jsonEqual(value, Right[key], Depth + 1) then return false end
      end
      return true
   end
   return Left is Right
end

function schemaIntegerConstraint(Value:any):bool
   return Value is <num> and Value >= 0 and Value is math.floor(Value)
end

function schemaValue(Value:any, Schema:table, Path:str, Depth:num):table
   if Depth > 32 then return { code='argument_depth', message='Tool arguments exceed the nesting limit', path=Path } end
   if Schema.type != nil and not typeMatches(Value, Schema.type) then
      return { code='argument_type', message='Tool argument has the wrong type', path=Path }
   end
   if Schema.enum != nil then
      if not (Schema.enum is <array>) then return schemaError(Path) end
      enum_match = false
      for allowed in values(Schema.enum) do
         if jsonEqual(Value, allowed, 0) then enum_match = true; break end
      end
      if not enum_match then
         return { code='argument_enum', message='Tool argument is not an allowed value', path=Path }
      end
   end
   if Schema.const != nil and not jsonEqual(Value, Schema.const, 0) then
      return { code='argument_const', message='Tool argument does not match the required value', path=Path }
   end
   if Schema.anyOf != nil then
      if not (Schema.anyOf is <array>) or #Schema.anyOf is 0 then return schemaError(Path) end
      any_match = false
      for candidate in values(Schema.anyOf) do
         if not (candidate is <table>) then return schemaError(Path) end
         if not schemaValue(Value, candidate, Path, Depth + 1) then any_match = true; break end
      end
      if not any_match then
         return { code='argument_any_of', message='Tool argument does not match any allowed schema', path=Path }
      end
   end
   if Value is <num> then
      for constraint in values(array<array> {
         array<any> { 'minimum', 'argument_minimum', 'Tool argument is below the minimum' },
         array<any> { 'maximum', 'argument_maximum', 'Tool argument is above the maximum' },
         array<any> { 'exclusiveMinimum', 'argument_exclusive_minimum',
            'Tool argument is not above the exclusive minimum' },
         array<any> { 'exclusiveMaximum', 'argument_exclusive_maximum',
            'Tool argument is not below the exclusive maximum' }
      }) do
         keyword = constraint[0]
         code = constraint[1]
         message = constraint[2]
         limit = Schema[keyword]
         if limit != nil then
            if not (limit is <num>) then return schemaError(Path) end
            invalid = keyword is 'minimum' ? Value < limit : keyword is 'maximum' ? Value > limit :
               keyword is 'exclusiveMinimum' ? Value <= limit : Value >= limit
            if invalid then return { code=code, message=message, path=Path } end
         end
      end
      if Schema.multipleOf != nil then
         multiple = Schema.multipleOf
         if not (multiple is <num>) or multiple <= 0 then return schemaError(Path) end
         quotient = Value / multiple
         nearest = math.floor(quotient + 0.5)
         if math.abs(quotient - nearest) > 1e-12 then
            return { code='argument_multiple_of', message='Tool argument is not a permitted multiple', path=Path }
         end
      end
   elseif Value is <str> then
      string_length = #r'[\s\S]'.search(Value)
      if Schema.minLength != nil then
         if not schemaIntegerConstraint(Schema.minLength) then return schemaError(Path) end
         if string_length < Schema.minLength then
            return { code='argument_min_length', message='Tool argument is shorter than the minimum length', path=Path }
         end
      end
      if Schema.maxLength != nil then
         if not schemaIntegerConstraint(Schema.maxLength) then return schemaError(Path) end
         if string_length > Schema.maxLength then
            return { code='argument_max_length', message='Tool argument exceeds the maximum length', path=Path }
         end
      end
      if Schema.pattern != nil then
         if not (Schema.pattern is <str>) then return schemaError(Path) end
         local pattern:any
         try pattern = regex.new(Schema.pattern)
         except e return schemaError(Path) end
         if not pattern.test(Value) then
            return { code='argument_pattern', message='Tool argument does not match the required pattern', path=Path }
         end
      end
   end
   if Value is <table> and Value != json.null and Schema.properties is <table> then
      if Schema.minProperties != nil then
         if not schemaIntegerConstraint(Schema.minProperties) then return schemaError(Path) end
         if table.size(Value) < Schema.minProperties then
            return { code='argument_min_properties', message='Tool argument has too few properties', path=Path }
         end
      end
      if Schema.maxProperties != nil then
         if not schemaIntegerConstraint(Schema.maxProperties) then return schemaError(Path) end
         if table.size(Value) > Schema.maxProperties then
            return { code='argument_max_properties', message='Tool argument has too many properties', path=Path }
         end
      end
      for name in values(Schema.required or array<str>) do
         if not (name in Value) then return { code='argument_required', message='Required tool argument is missing',
            path=Path .. '.' .. name } end
      end
      for name, child in pairs(Value) do
         property = Schema.properties[name]
         if not property then
            if Schema.additionalProperties is false then return { code='argument_additional',
               message='Unexpected tool argument', path=Path .. '.' .. name } end
         elseif property is <table> then
            err = schemaValue(child, property, Path .. '.' .. name, Depth + 1)
            if err then return err end
         end
      end
   elseif Value is <array> then
      if Schema.minItems != nil then
         if not schemaIntegerConstraint(Schema.minItems) then return schemaError(Path) end
         if #Value < Schema.minItems then
            return { code='argument_min_items', message='Tool argument has too few items', path=Path }
         end
      end
      if Schema.maxItems != nil then
         if not schemaIntegerConstraint(Schema.maxItems) then return schemaError(Path) end
         if #Value > Schema.maxItems then
            return { code='argument_max_items', message='Tool argument has too many items', path=Path }
         end
      end
      if Schema.uniqueItems != nil then
         if not (Schema.uniqueItems is <bool>) then return schemaError(Path) end
         if Schema.uniqueItems then
            for left in {0 to #Value} do
               for right in {left + 1 to #Value} do
                  if jsonEqual(Value[left], Value[right], 0) then
                     return { code='argument_unique_items', message='Tool argument items must be unique', path=Path }
                  end
               end
            end
         end
      end
      if Schema.items != nil then
         if not (Schema.items is <table>) then return schemaError(Path) end
         for index, child in Value do
            err = schemaValue(child, Schema.items, Path .. '[' .. index .. ']', Depth + 1)
            if err then return err end
         end
      end
   end
   return nil
end

-- Registry keys combine the optional namespace and the function name.  Neither may contain '/'.

function toolKey(Namespace:str, Name:str):str
   return (Namespace or '') .. '/' .. Name
end

@Doc(text=[[
Creates an allow-list of Tiri functions that the model may request through function_call Items.

Only registered functions can be dispatched.  dispatch() validates the function name, optional namespace and JSON
arguments against the registered schema before any application callback runs.  Functions registered as consequential
also require the `approve` callback to return `true`.  The registry never dispatches a call automatically; the
application decides which function_call Items to pass to dispatch() and when.

Callbacks run synchronously on the calling thread.  The handler receives a private copy of the decoded arguments and
the raw function_call Item.  It may return a string, which is sent verbatim, or a JSON-compatible value, which is
encoded.

-INPUT-
Options: Optional table.  `approve(Info)` is called for consequential functions with `name`, `namespace`, `callID` and a
copy of `arguments`, and must return `true` to allow the call.  `maxArgumentBytes` (default 262144) and
`maxArgumentDepth` (default 32) limit the decoded arguments.

-RESULTS-
table: The registry, providing `register()`, `describeNamespace()`, `declarations()` and `dispatch()`.
]])
openai_responses.ToolRegistry = function(Options:table):table
   options = Options or {}
   entries = {}
   namespaces = {}
   self = {}

   @Doc(text=[[
Registers a function that the model is allowed to call.

The parameters schema is copied.  Functions are strict by default, so their schema must declare every property as
required and set `additionalProperties=false` on every object.  Registration raises an exception for an invalid name,
an invalid strict schema or a duplicate registration.

Set the `namespace` option to group the function in a Responses `namespace` tool.  A namespaced function is only
dispatched for a function_call Item whose `namespace` and `name` both match, and an un-namespaced function is never
matched by a namespaced call.  The ChatGPT-plan route expects function tools to be grouped in namespaces.

-INPUT-
Name: Function name of 1 to 64 letters, digits, underscores or hyphens.
Parameters: JSON Schema for the arguments object.
Handler: Function called as `Handler(Arguments, Call)` after validation and any required approval.
ToolOptions: Optional table with `description`, `strict` (default `true`), `consequential` (default `false`) and
`namespace`.

-RESULTS-
table: The registry, allowing calls to be chained.
]])
   self.register = function(Name:str!, Parameters:table!, Handler:func!, ToolOptions:table):table
      if not validName(Name) then raise 'Invalid OpenAI function name' end
      opts = ToolOptions or {}
      if opts.namespace != nil and not validName(opts.namespace) then raise 'Invalid OpenAI tool namespace' end
      key = toolKey(opts.namespace, Name)
      if entries[key] then raise 'OpenAI function is already registered' end
      entry = { name=Name, namespace=opts.namespace, parameters=openai_responses.copy(Parameters), handler=Handler,
         description=opts.description, strict=opts.strict is nil and true or opts.strict,
         consequential=opts.consequential or false }
      if entry.strict then
         schema_err = strictSchema(entry.parameters, '$.' .. Name, 0)
         if schema_err then raise schema_err.message .. ' at ' .. schema_err.path end
      end
      entries[key] = entry
      if entry.namespace then namespaces[entry.namespace] ?= { description=nil } end
      return self
   end

   @Doc(text=[[
Sets the description that declarations() gives to a namespace tool.

-INPUT-
Namespace: Namespace name, using the same rules as function names.
Description: Description of the group of functions, shown to the model.

-RESULTS-
table: The registry, allowing calls to be chained.
]])
   self.describeNamespace = function(Namespace:str!, Description:str):table
      if not validName(Namespace) then raise 'Invalid OpenAI tool namespace' end
      namespaces[Namespace] ?= {}
      namespaces[Namespace].description = Description
      return self
   end

   @Doc(text=[[
Returns the Responses tool declarations for every registered function.

Un-namespaced functions are returned as `function` tools.  Namespaced functions are grouped into one `namespace` tool
per namespace.  Declarations are sorted by name and are independent copies, so they can be placed in a request's
`tools` array or in an `additional_tools` input Item.

-RESULTS-
array: Tool declaration tables.
]])
   self.declarations = function():array<table>
      declarations = array<table>
      grouped = {}
      for _, entry in pairs(entries) do
         declaration = { type='function', name=entry.name, description=entry.description,
            parameters=openai_responses.copy(entry.parameters), strict=entry.strict }
         if entry.namespace then
            if not grouped[entry.namespace] then
               grouped[entry.namespace] = { type='namespace', name=entry.namespace,
                  description=namespaces[entry.namespace]?.description, tools=array<table> }
               declarations.push(grouped[entry.namespace])
            end
            grouped[entry.namespace].tools.push(declaration)
         else
            declarations.push(declaration)
         end
      end
      function byName(A:table, B:table):bool return A.name < B.name end
      for group in values(grouped) do group.tools.sort(byName) end
      declarations.sort(byName)
      return declarations
   end

   @Doc(text=[[
Validates and runs one function_call Item, returning its function_call_output Item.

Checks are applied in this order: the Item shape, the allow-list (namespace and name), strict JSON decoding of the
arguments, schema validation, and approval for consequential functions.  The handler only runs if every check
passes.  Handler exceptions are caught and reported without their message.

-INPUT-
Call: A function_call Item, either raw or as returned by `response.functionCalls()`.

-RESULTS-
table: A `function_call_output` Item with the original `call_id`, or `nil` on failure.
table: On failure, an error with `kind='tool'`, a `code` such as `tool_not_allowed`, `invalid_arguments`,
`argument_type` or `approval_required`, and the `name`, `namespace` and `callID` of the call.
]])
   self.dispatch = function(Call:table):<table, table>
      raw = Call.raw or Call
      call_namespace:any = raw.namespace
      if call_namespace is json.null then call_namespace = nil end
      if raw.type != 'function_call' or not validName(raw.name) or not (raw.call_id is <str>) or raw.call_id is '' or
         (call_namespace != nil and not validName(call_namespace)) then
         return nil, { kind='tool', code='invalid_call', message='Invalid function call Item' }
      end
      function failure(Code:str, Message:str):table
         return { kind='tool', code=Code, message=Message, name=raw.name, namespace=call_namespace,
            callID=raw.call_id }
      end
      entry = entries[toolKey(call_namespace, raw.name)]
      if not entry then return nil, failure('tool_not_allowed', 'Function is not registered') end
      if not (raw.arguments is <str>) then
         return nil, failure('invalid_arguments', 'Function arguments must be JSON text')
      end
      arguments:any = nil
      try arguments = openai_json.decode(raw.arguments, options.maxArgumentBytes or 262144,
         options.maxArgumentDepth or 32) end
      if not (arguments is <table>) or arguments is json.null then
         return nil, failure('invalid_arguments', 'Function arguments must decode to an object')
      end
      validation = schemaValue(arguments, entry.parameters, '$', 0)
      if validation then
         validation.kind = 'tool'; validation.name = raw.name; validation.namespace = call_namespace
         validation.callID = raw.call_id
         return nil, validation
      end
      if entry.consequential then
         approved = false
         if options.approve then
            try approved = options.approve({ name=raw.name, namespace=call_namespace, callID=raw.call_id,
               arguments=openai_responses.copy(arguments) }) is true end
         end
         if not approved then return nil, failure('approval_required', 'Function call was not approved') end
      end
      local output:any
      try output = entry.handler(openai_responses.copy(arguments), raw)
      except e
         return nil, failure('handler_failed', 'Function handler failed')
      end
      local encoded:str
      try encoded = output is <str> and output or openai_responses.encode(output)
      except e
         return nil, failure('invalid_output', 'Function handler returned a non-JSON value')
      end
      return { type='function_call_output', call_id=raw.call_id, output=encoded }
   end
   return self
end

@Doc(text=[[
Creates a caller-managed conversation history for replay in the `input` of later requests.

The history stores private copies of every Item it is given, including reasoning, function_call and
function_call_output Items, which some models require for the next turn.  It provides `append(Item)`,
`appendResponse(Response)`, `functionOutput(CallID, Output)`, `items()`, `reset()` and `count()`.  `items()` returns a
copy, so later changes by the caller do not alter the history.

Every replay sends the complete history again, so input token use, latency and cost grow with the length of the
conversation.  Trimming is the caller's decision.

-INPUT-
Initial: Optional array of Items or typed Items to start with.

-RESULTS-
table: The history object.
]])
openai_responses.History = function(Initial:array<any>):table
   state = array<table>
   for item in values(Initial or array<table>) do state.push(openai_responses.copy(item.raw or item)) end
   self = {}
   self.append = function(Item:table):table state.push(openai_responses.copy(Item.raw or Item)); return self end
   self.appendResponse = function(Response:table):table
      source = Response.raw and Response.raw.output or Response.output
      for item in values(source or array<table>) do state.push(openai_responses.copy(item.raw or item)) end
      return self
   end
   self.functionOutput = function(CallID:str!, Output:any):table
      if CallID is '' then raise 'Function output requires a call_id' end
      state.push({ type='function_call_output', call_id=CallID,
         output=Output is <str> and Output or openai_responses.encode(Output) })
      return self
   end
   self.items = function():array<any> return openai_responses.copy(state) end
   self.reset = function() state.clear(); return self end
   self.count = function():num return #state end
   return self
end
