@Package(name="gui/button", version="1.0")

--[[
Documentation is available in the Kotuku Wiki.
--]]

   import 'gui', 'gui/tooltip'

   namespace gui

LINE_SPACING, FONT_HEIGHT = gui.getFontHeight(gui.fonts.button)
DEFAULT_HEIGHT <const> = math.floor(LINE_SPACING * 1.75) + 1

gui.button = function(Options)
   self = entity { -- Public interface
      events         = Options.events ?? { },
      parentViewport = Options.target,
      pulse          = Options.pulse ?? false, -- If true, activate on press and repeatedly while the button is held
      tip            = Options.tip, -- Hover tip text; recommended for buttons that only show an icon
      viewport       = nil, -- The button's primary viewport
   }

   using self do
      base_theme = gui.getTheme(&parentViewport)
      theme = table.merge(base_theme.button, Options.theme, true, true)

      -- Icon size and label padding scale with the button height

      HEIGHT    <const> = Options.height ?? DEFAULT_HEIGHT
      ICON_SIZE <const> = HEIGHT * 0.56
      GAP       <const> = HEIGHT * 0.35

      calc_width = false -- True if the button width is computed from its content at initialisation
      icon_margin = 0 -- Padding around the icon's pattern tile, see gui.createIcon()

      -- Compose the background style from the current hover, focus and disabled states.  Hover and focus styling is
      -- suppressed while the button is disabled.

      function refreshStyle()
         style = table.clone(theme.bkgd)
         if &disabled then
            gui.applyStyle(style, theme.disabled)
         else
            if &_hover then gui.applyStyle(style, theme.highlight) end
            if &hasFocus then gui.applyStyle(style, theme.focus) end
         end
         gui.applyStyle(&bkgd, style)
      end

      -- Position the icon and text.  If Resize is true and the width was not fixed by the client, the width is computed
      -- from the content.  Resizing is limited to initialisation; later content changes are clipped to the existing size.

      function arrange(Resize:bool)
         label_offset = 0
         if &iconRender then
            &iconRender.x = GAP - icon_margin
            label_offset = (GAP * 0.5) + ICON_SIZE
         end

         if calc_width then
            if Resize then
               &viewport.width = &_label ? (GAP + label_offset + &_label.textWidth + GAP) : HEIGHT
            end

            if &iconRender and not &_label then -- Center icon, no text
               &iconRender.x = ((&viewport.width - ICON_SIZE) * 0.5) - icon_margin
            end
         end

         if &_label then
            if &iconRender then
               &_label.x = GAP + label_offset
               &_label.align = ALIGN_LEFT
            else -- No icon, centre text
               &_label.x = &viewport.width / 2
               &_label.align = ALIGN_HORIZONTAL
            end
         end
      end

      function createIcon(Path:str!):obj
         icon = gui.createIcon(&viewport.scene, Path, ICON_SIZE, gui.rgbToIconTheme(theme.text.fill))
         icon_margin = icon.margin
         return &viewport.new('VectorViewport', {
            x      = GAP - icon.margin,
            y      = ((HEIGHT - icon.size) * 0.5) - icon.margin,
            width  = icon.size + (icon.margin * 2),
            height = icon.size + (icon.margin * 2),
            fill   = icon.fill
         })
      end

      -- Change the active state of the button to disabled or enabled

      &disable = function()
         &disabled = true
         &clicked = false
         &_hoverTip.cancel()
         &viewport.acDisable()
         &viewport.opacity = 0.5
         refreshStyle()
         &events.disable?(&&)
         &viewport.acDraw()
      end

      &enable = function()
         &disabled = false
         &viewport.acEnable()
         &viewport.opacity = 1
         refreshStyle()
         &events.enable?(&&)
         &viewport.acDraw()
      end

      -- Change the button label.  A nil or empty string removes the label.

      &setLabel = function(Label:str)
         if Label?? then
            if &_label then
               &_label.string = Label
            else
               &_label = &_labelClip.new('VectorText', table.merge({
                  x         = 0,
                  y         = FONT_HEIGHT + math.floor((HEIGHT - FONT_HEIGHT - (theme.bkgd.strokeWidth * 2)) * 0.5),
                  string    = Label,
                  lineLimit = 1
               }, theme.text))
            end
         elseif &_label then
            &_label.free()
            &_label = nil
         end

         arrange()
         &viewport.acDraw()
      end

      -- Change the button icon.  A nil Path removes the icon.  If the icon cannot be loaded, an exception is raised and
      -- the current icon is retained.

      &setIcon = function(Path:str)
         replacement = Path ?? createIcon(Path) : nil
         &iconRender?.free()
         &iconRender = replacement
         &icon = Path?? ? Path : nil
         arrange()
         &viewport.acDraw()
      end

      -- Main entry point --

      assert(Options.target, 'A target viewport is required.')

      vps = { -- Viewport settings
         x       = Options.x,
         y       = Options.y,
         width   = Options.width,
         height  = HEIGHT,
         xOffset = Options.xOffset,
         yOffset = Options.yOffset
      }

      if not vps.x and not vps.xOffset then vps.x = 0 end
      if not vps.y and not vps.yOffset then vps.y = 0 end
      if not vps.width and not (vps.xOffset and vps.x) then
         vps.width = gui.sizing.widget.width
         calc_width = true
      end

      &viewport = &parentViewport.new('VectorViewport', vps)

      -- The tip is shown when the pointer rests on the button (see gui.hoverTip()).  It is read when the delay
      -- expires, so the tip field can be changed at any time.

      &_hoverTip = gui.hoverTip({ target = &viewport, text = function[&&]() return &tip end })

      &bkgd = &viewport.new('VectorRectangle', table.merge({
         x      = theme.bkgd.strokeWidth * 0.5,
         y      = theme.bkgd.strokeWidth * 0.5,
         width  = &viewport.width - theme.bkgd.strokeWidth,
         height = HEIGHT - theme.bkgd.strokeWidth,
         resizeEvent = function(Viewport, Vector, X, Y, Width, Height)
            if Vector.width != Width then
               Vector.width = Width - theme.bkgd.strokeWidth
            end

            if Vector.height != Height then
               Vector.height = Height - theme.bkgd.strokeWidth
            end

            arrange()
         end
      }, theme.bkgd))

      if Options.icon then -- A missing icon is reported but is not fatal to the button
         try
            &iconRender = createIcon(Options.icon)
            &icon = Options.icon
         except e
            msg(f'Failed to load button icon "{Options.icon}": {e.message}')
         end
      end

      &_labelClip = &viewport.new('VectorViewport', {
         x = theme.bkgd.strokeWidth, y = theme.bkgd.strokeWidth,
         xOffset = theme.bkgd.strokeWidth, yOffset = theme.bkgd.strokeWidth,
         overflow = VOF_HIDDEN
      })

      if Options.label then &setLabel(Options.label) end
      arrange(true)

      &viewport.mtSubscribeFeedback(FM_HAS_FOCUS|FM_CHILD_HAS_FOCUS|FM_LOST_FOCUS, function[&&](Viewport:obj!, Event)
         if Event is FM_LOST_FOCUS then
            &hasFocus = false
            &events.lostFocus?(&&)
         elseif not &disabled then
            &hasFocus = true
            &events.focus?(&&)
         end

         refreshStyle()

         Viewport.acDraw()
      end)

      &viewport.mtSubscribeKeyboard(function[&&](Viewport:obj!, Qualifiers:num!, Value:num!, Unicode)
         if &disabled or not (Qualifiers has KQ_PRESSED) then return end

         if (Value is KEY_ENTER) or (Value is KEY_SPACE) or (Value is KEY_NP_ENTER) then
            &events.activate?(&&)
         end
      end)

      &viewport.mtSubscribeInput(JTYPE_CROSSING|JTYPE_BUTTON|JTYPE_REPEATED, function[&&](Viewport:obj!, Msg)
         repeat
            if Msg.type is JET_CROSSED_IN then
               &_hover = true
               refreshStyle()
               &events.cursorEntry?(&&)
            elseif Msg.type is JET_CROSSED_OUT then
               &_hover = false
               refreshStyle()
               &events.cursorExit?(&&)
            elseif Msg.type is JET_LMB then
               if &disabled then
                  &clicked = false
               elseif Msg.value > 0 then
                  -- A click is triggered on release, unless the button pulses.  A pulsing button activates on the
                  -- initial press and on each repeat while the button is held.
                  if &pulse then
                     &clicked = false
                     &events.activate?(&&)
                  elseif not (Msg.flags has JTYPE_REPEATED) then
                     &&.{ clicked = true, clickX = Msg.x, clickY = Msg.y }
                  end
               elseif &clicked then
                  &clicked = false
                  if (math.abs(Msg.x - &clickX) < 4) and (math.abs(Msg.y - &clickY) < 4) then
                     &events.activate?(&&)
                  end
               end
            end
            Msg = Msg.next
         until not Msg

         Viewport.acDraw()
      end)

      if Options.disabled then &disable() end
      &events.show?(&&)

      return &&
   end
end
