@Package(name="gui/button", version="1.0")

--[[
Documentation is available in the Kotuku Wiki.
--]]

   import 'gui', 'gui/tooltip'

   namespace gui

LINE_SPACING, FONT_HEIGHT = gui.getFontHeight(gui.fonts.button)
DEFAULT_HEIGHT <const> = math.floor(LINE_SPACING * 1.75) + 1

gui.button = function(Options)
   self = entity { -- Public interface
      events         = Options.events ?? { },
      parentViewport = Options.target,
      pulse          = Options.pulse ?? false, -- If true, activate on press and repeatedly while the button is held
      tip            = Options.tip, -- Hover tip text; recommended for buttons that only show an icon
      viewport       = nil, -- The button's primary viewport
   }

   using self do
      -- The applied theme is layered as base.button <- base.button.primary (if primary) <- Options.theme <- the
      -- override from setTheme().  It is rebuilt whenever the base theme or the override changes.

      base_theme = gui.getTheme(&parentViewport)
      override = nil -- Per-instance override from setTheme()

      function buildTheme():table
         result = base_theme.button
         if Options.primary then -- Primary buttons mark the main action of a dialog or form
            result = table.merge(result, result.primary, true, true)
         end

         result = table.merge(result, Options.theme, true, true)
         if override then result = table.merge(result, override, true, true) end
         return result
      end

      theme = buildTheme()

      -- Icon size and label padding scale with the button height

      HEIGHT    <const> = Options.height ?? DEFAULT_HEIGHT
      ICON_SIZE <const> = HEIGHT * 0.56
      GAP       <const> = HEIGHT * 0.35

      calc_width = false -- True if the button width is computed from its content at initialisation
      icon_margin = 0 -- Padding around the icon's pattern tile, see gui.createIcon()
      inset = math.ceil(theme.bkgd.strokeWidth) -- Inset of the label area; whole pixels keep the label sharp
      label_size = 0 -- The label's font size in pixels before any scaling to fit the button

      function disabledOpacity():num
         return base_theme.scheme is 'light' ? 0.75 : 0.5
      end

      MIN_FONT_SIZE <const> = 6 -- Labels are not scaled below this pixel size, and may overflow the button if so

      -- The label baseline is centred within the stroke unless the theme gives a y position.  Both are relative to the
      -- label area, which is inset from the viewport by inset.

      function labelY():num
         return theme.text.y ?? (FONT_HEIGHT + math.floor((HEIGHT - FONT_HEIGHT - (theme.bkgd.strokeWidth * 2)) * 0.5))
      end

      -- Scale the label down in whole pixel font sizes until it fits within Available.  The label must be at its full
      -- size on entry.  The baseline is raised by half the reduction in font height so that the label stays centred.

      function fitLabel(Available:num!)
         size = label_size
         width = &_label.textWidth
         if (width > Available) and (width > 0) then
            size = math.max(MIN_FONT_SIZE, math.floor(label_size * Available / width))
            &_label.fontSize = size
            while (size > MIN_FONT_SIZE) and (&_label.textWidth > Available) do
               size -= 1
               &_label.fontSize = size
            end
         end

         shift = math.floor(FONT_HEIGHT * (1 - (size / label_size)) * 0.5)
         &_label.y = inset + labelY() - shift
      end

      -- Compose the background style from the current hover, focus and disabled states.  Hover and focus styling is
      -- suppressed while the button is disabled.

      function refreshStyle()
         style = table.clone(theme.bkgd)

         if &disabled then
            gui.applyStyle(style, theme.disabled)
         else
            if &_hover then gui.applyStyle(style, theme.highlight) end
            if &hasFocus then gui.applyStyle(style, theme.focus) end
         end

         gui.applyStyle(&bkgd, style)
      end

      -- Position the icon and text.  If Resize is true and the width was not fixed by the client, the width is computed
      -- from the content.  Resizing is limited to initialisation; later, a label that is too wide for the button is scaled
      -- down to fit within the border, less half the GAP on each side.

      function arrange(Resize:bool)
         label_offset = 0

         if &iconRender then
            &iconRender.x = GAP - icon_margin
            label_offset = (GAP) + ICON_SIZE
         end

         if &_label and (tonumber(&_label.fontSize) != label_size) then -- Restore the full size before measuring
            &_label.fontSize = label_size
         end

         if calc_width and Resize then
            &viewport.width = &_label ? (GAP + label_offset + &_label.textWidth + GAP) : HEIGHT
         end

         if &iconRender and not &_label then -- Center icon, no text
            &iconRender.x = ((&viewport.width - ICON_SIZE) * 0.5) - icon_margin
         end

         if &_label then
            margin = inset + (GAP * 0.5)
            if &iconRender then
               &_label.{ x = GAP + label_offset, align = ALIGN_LEFT }
               fitLabel(&viewport.width - margin - (GAP + label_offset))
            else -- No icon, centre text
               &_label.{ x = &viewport.width * 0.5, align = ALIGN_HORIZONTAL }
               fitLabel(&viewport.width - (margin * 2))
            end
         end
      end

      -- Returns the icon pattern for Path in the current text colour, and the placement of the viewport that paints it.

      function iconPattern(Path:str!):<table, table>
         icon = gui.createIcon(&viewport.scene, Path, ICON_SIZE, gui.rgbToIconTheme(theme.text.fill))
         icon_margin = icon.margin
         return icon, {
            x      = GAP - icon.margin,
            y      = ((HEIGHT - icon.size) * 0.5) - icon.margin,
            width  = icon.size + (icon.margin * 2),
            height = icon.size + (icon.margin * 2),
            fill   = icon.fill
         }
      end

      function createIcon(Path:str!):obj
         _, settings = iconPattern(Path)
         return &viewport.new('VectorViewport', settings)
      end

      -- Apply the current theme to the existing vectors.

      function restyle()
         sw = theme.bkgd.strokeWidth
         &bkgd.{ x = sw * 0.5, y = sw * 0.5, width = &viewport.width - sw, height = &viewport.height - sw }
         refreshStyle()

         inset = math.ceil(sw)

         if &_label then
            if theme.text.fill then &_label.fill = theme.text.fill end
            if theme.text.fontSize then
               &_label.fontSize = theme.text.fontSize
               label_size = tonumber(&_label.fontSize)
            end
         end

         if &iconRender then
            try
               _, settings = iconPattern(&icon)
               gui.applyStyle(&iconRender, settings)
            except e
               msg(f'Failed to restyle button icon "{&icon}": {e.message}')
            end
         end

         if &disabled then &viewport.opacity = disabledOpacity() end
         &viewport.acDraw()
      end

      -- Change the active state of the button to disabled or enabled

      &disable = function()
         &disabled = true
         &clicked = false
         &_hoverTip.cancel()
         &viewport.acDisable()
         &viewport.opacity = disabledOpacity()
         refreshStyle()
         &events.disable?(&&)
         &viewport.acDraw()
      end

      &enable = function()
         &disabled = false
         &viewport.acEnable()
         &viewport.opacity = 1
         refreshStyle()
         &events.enable?(&&)
         &viewport.acDraw()
      end

      -- Change the button label.  A nil or empty string removes the label.

      &setLabel = function(Label:str)
         if Label?? then
            if &_label then
               &_label.string = Label
            else
               &_label = &viewport.new('VectorText', table.merge({
                  x         = 0,
                  y         = inset + labelY(),
                  string    = Label,
                  lineLimit = 1
               }, theme.text))
               label_size = tonumber(&_label.fontSize)
            end
         elseif &_label then
            &_label.free()
            &_label = nil
         end

         arrange()
         &viewport.acDraw()
      end

      -- Style this button instance.  Override is merged over the button's theme and is kept when the window theme
      -- changes.  Each call replaces the previous override; nil removes it.

      &setTheme = function(Override:table)
         override = Override
         theme = buildTheme()
         restyle()
      end

      -- Called by gui.broadcastTheme() with the window's new theme.

      &applyTheme = function(Theme:table!)
         base_theme = Theme
         theme = buildTheme()
         restyle()
      end

      -- Change the button icon.  A nil Path removes the icon.  If the icon cannot be loaded, an exception is raised and
      -- the current icon is retained.

      &setIcon = function(Path:str)
         replacement = Path ?? createIcon(Path) : nil
         &iconRender?.free()
         &iconRender = replacement
         &icon = Path?? ? Path : nil
         arrange()
         &viewport.acDraw()
      end

      -- Main entry point --

      assert(Options.target, 'A target viewport is required.')

      vps = { -- Viewport settings
         x       = Options.x,
         y       = Options.y,
         width   = Options.width,
         height  = HEIGHT,
         xOffset = Options.xOffset,
         yOffset = Options.yOffset
      }

      if not vps.x and not vps.xOffset then vps.x = 0 end
      if not vps.y and not vps.yOffset then vps.y = 0 end
      if not vps.width and not (vps.xOffset and vps.x) then
         vps.width = gui.sizing.widget.width
         calc_width = true
      end

      &viewport = &parentViewport.new('VectorViewport', vps)

      -- The tip is shown when the pointer rests on the button (see gui.hoverTip()).  It is read when the delay
      -- expires, so the tip field can be changed at any time.

      &_hoverTip = gui.hoverTip({ target = &viewport, text = function[&&]() return &tip end })

      &bkgd = &viewport.new('VectorRectangle', table.merge({
         x      = theme.bkgd.strokeWidth * 0.5,
         y      = theme.bkgd.strokeWidth * 0.5,
         width  = &viewport.width - theme.bkgd.strokeWidth,
         height = HEIGHT - theme.bkgd.strokeWidth,
         resizeEvent = function(Viewport, Vector, X, Y, Width, Height)
            if Vector.width != Width then
               Vector.width = Width - theme.bkgd.strokeWidth
            end

            if Vector.height != Height then
               Vector.height = Height - theme.bkgd.strokeWidth
            end

            arrange()
         end
      }, theme.bkgd))

      if Options.icon then -- A missing icon is reported but is not fatal to the button
         try
            &iconRender = createIcon(Options.icon)
            &icon = Options.icon
         except e
            msg(f'Failed to load button icon "{Options.icon}": {e.message}')
         end
      end

      if Options.label then &setLabel(Options.label) end
      arrange(true)

      gui.registerWidget(&viewport, &&)

      &viewport.mtSubscribeFeedback(FM_HAS_FOCUS|FM_CHILD_HAS_FOCUS|FM_LOST_FOCUS, function[&&](Viewport:obj!, Event)
         if Event is FM_LOST_FOCUS then
            &hasFocus = false
            &events.lostFocus?(&&)
         elseif not &disabled then
            &hasFocus = true
            &events.focus?(&&)
         end

         refreshStyle()

         Viewport.acDraw()
      end)

      &viewport.mtSubscribeKeyboard(function[&&](Viewport:obj!, Qualifiers:num!, Value:num!, Unicode)
         if &disabled or not (Qualifiers has KQ_PRESSED) then return end

         if (Value is KEY_ENTER) or (Value is KEY_SPACE) or (Value is KEY_NP_ENTER) then
            &events.activate?(&&)
         end
      end)

      &viewport.mtSubscribeInput(JTYPE_CROSSING|JTYPE_BUTTON|JTYPE_REPEATED, function[&&](Viewport:obj!, Msg)
         repeat
            if Msg.type is JET_CROSSED_IN then
               &_hover = true
               refreshStyle()
               &events.cursorEntry?(&&)
            elseif Msg.type is JET_CROSSED_OUT then
               &_hover = false
               refreshStyle()
               &events.cursorExit?(&&)
            elseif Msg.type is JET_LMB then
               if &disabled then
                  &clicked = false
               elseif Msg.value > 0 then
                  -- A click is triggered on release, unless the button pulses.  A pulsing button activates on the
                  -- initial press and on each repeat while the button is held.
                  if &pulse then
                     &clicked = false
                     &events.activate?(&&)
                  elseif not (Msg.flags has JTYPE_REPEATED) then
                     &&.{ clicked = true, clickX = Msg.x, clickY = Msg.y }
                  end
               elseif &clicked then
                  &clicked = false
                  if (math.abs(Msg.x - &clickX) < 4) and (math.abs(Msg.y - &clickY) < 4) then
                     &events.activate?(&&)
                  end
               end
            end
            Msg = Msg.next
         until not Msg

         Viewport.acDraw()
      end)

      if Options.disabled then &disable() end
      &events.show?(&&)

      return &&
   end
end
