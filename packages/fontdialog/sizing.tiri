-- Sizing panel: font size in points, line height, tracking, word spacing and kerning.  Tracking and word spacing are
-- disabled for bitmap families, which are drawn a line at a time.

   import 'gui', 'gui/panel', './theme', './parts', './controls', './style'

   namespace fontdialog_sizing { }

PAD   <const> = fontdialog_controls.PAD
ROW_H <const> = fontdialog_controls.ROW_H

MIN_SIZE <const> = 6
MAX_SIZE <const> = 144
PT_PER_PX <const> = 0.75
PT_STEP   <const> = 0.5 -- Size increment, in points

fontdialog_sizing.HEIGHT = fontdialog_theme.PANEL_HEADER_H + 8 + (ROW_H * 5) + 8

KERNING_ITEMS <const> = array<table> {
   { id = 'metrics', label = 'Metrics', tip = 'Kerning from the font\'s kern table' },
   { id = 'none',    label = 'Off' }
}

----------------------------------------------------------------------------------------------------------------------

function trimZero(Text:str!):str
   if Text.endsWith('.0') then return Text.sub(0, -2) end
   return Text
end

@Doc(text=[[
@desc Format a pixel size as a number of points, e.g. `12` for 16 pixels.
]])
fontdialog_sizing.formatValue = function(Pixels:num!):str
   return trimZero(string.format('%.1f', Pixels * PT_PER_PX))
end

@Doc(text=[[
@desc Format a pixel size in points, e.g. `12 pt`.
]])
fontdialog_sizing.formatSize = function(Pixels:num!):str
   return f'{fontdialog_sizing.formatValue(Pixels)} pt'
end

@Doc(text=[[
@desc Convert a size option to pixels at the 96 DPI baseline used by the font database.  Numbers are pixels, and strings
accept the units of `gui.pixel()`, e.g. `'16'`, `'16px'`, `'8pt'` or `'8 pt'`.  An invalid unit raises an error.
@result The size in pixels, or nil if the value is empty or not positive.
]])
fontdialog_sizing.parse = function(Value:any):num
   if Value is nil then return nil end
   pixels = (Value is <num>) ? Value : gui.pixel(tostring(Value).replace(' ', ''), 96)
   if pixels <= 0 then return nil end
   return pixels
end

@Doc(text=[[
@desc Convert a pixel size to points at the 96 DPI baseline used by the font database.
]])
fontdialog_sizing.points = function(Pixels:num!):num
   return Pixels * PT_PER_PX
end

-- True if the family is restricted to a fixed list of sizes.  Bitmap families list their strikes, and scalable
-- families can be restricted with a Points key in fonts:options.cfg.

fontdialog_sizing.fixed = function(Font:table!):bool
   return (Font.sizes != nil) and (#Font.sizes > 0)
end

-- The pixel sizes of a family's fixed sizes, which are listed in points in the font database.  The sizes are not
-- rounded to whole pixels, so that they read back as the exact point sizes that were listed.

fontdialog_sizing.strikes = function(Font:table!):array<double>
   strikes = array<double>
   for points in values(Font.sizes ?? array<int>) do strikes.push(points / PT_PER_PX) end
   strikes.sort()
   return strikes
end

-- Snap a pixel size to the nearest fixed size of a family.  Families without fixed sizes accept any size.

fontdialog_sizing.snap = function(Font:table!, Pixels:num!):num
   if not fontdialog_sizing.fixed(Font) then return Pixels end
   strikes = fontdialog_sizing.strikes(Font)
   best = strikes[0]
   for size in values(strikes) do
      if math.abs(size - Pixels) < math.abs(best - Pixels) then best = size end
   end
   return best
end

-- Quantise a pixel size to a selectable point size.  Families with fixed sizes snap to them; otherwise sizes are
-- rounded to the nearest half point.

fontdialog_sizing.quantise = function(Font:table!, Pixels:num!):num
   if fontdialog_sizing.fixed(Font) then return fontdialog_sizing.snap(Font, Pixels) end
   points = math.round(Pixels * PT_PER_PX / PT_STEP) * PT_STEP
   return math.clamp(points, MIN_SIZE * PT_PER_PX, MAX_SIZE * PT_PER_PX) / PT_PER_PX
end

----------------------------------------------------------------------------------------------------------------------

@Doc(text=[[
@desc Create the Sizing panel.
@input Picker table
@input Target viewport
@input Options: x, y, width
@result Table with `panel` and `update(Source)`
]])
fontdialog_sizing.new = function(Picker:table!, Target:obj!, Options:table!):table
   state = Picker.state
   inner = Options.width - (PAD * 2)

   self = { outlined = true, sizeLocked = false }

   self.panel = gui.panel({
      target = Target, x = Options.x, y = Options.y, width = Options.width, height = fontdialog_sizing.HEIGHT,
      title = 'Sizing', padding = fontdialog_parts.PANEL_PADDING
   })

   body = self.panel.body
   y = 8

   function row(Options:table!):table
      result = fontdialog_controls.sliderRow(Picker, body, table.merge({ x = PAD, y = y, width = inner }, Options))
      y += ROW_H
      return result
   end

   self.size = row({
      label = 'Size', min = MIN_SIZE, max = MAX_SIZE, step = PT_STEP / PT_PER_PX, value = state.size,
      format = function(V):str return fontdialog_sizing.formatSize(self.strikes ? self.strikes[V] : V) end,
      onChange = function(V)
         if self.strikes then
            Picker.update({ size = self.strikes[V] }, 'size')
            return
         end
         snapped = fontdialog_sizing.quantise(Picker.state.font, V)
         if snapped != V then self.size.set(snapped) end
         Picker.update({ size = snapped }, 'size')
      end
   })

   self.lineHeight = row({
      label = 'Line height', min = 0.8, max = 2.5, step = 0.05, value = state.lineHeight,
      format = function(V):str return string.format('%.2f', V) end,
      onChange = function(V) Picker.update({ lineHeight = V }, 'sizing') end
   })

   self.tracking = row({
      label = 'Tracking', min = -100, max = 200, step = 5, value = state.tracking,
      format = function(V):str return (V > 0) ? f'+{V}' : tostring(V) end,
      onChange = function(V) Picker.update({ tracking = V }, 'sizing') end
   })

   self.wordSpace = row({
      label = 'Word space', min = -0.2, max = 1, step = 0.05, value = state.wordSpace,
      format = function(V):str return string.format('%.2f', V) end,
      onChange = function(V) Picker.update({ wordSpace = V }, 'sizing') end
   })

   self.kerning = fontdialog_controls.segmentedRow(Picker, body, {
      x = PAD, y = y, label = 'Kerning', items = KERNING_ITEMS, selected = state.kerning,
      onChange = function(ID) Picker.update({ kerning = ID }, 'sizing') end
   })

   -- The slider's value for a pixel size: a position in the list of strikes if there is one, otherwise the size.

   function sliderValue(Pixels:num!):num
      if not self.strikes then return Pixels end
      best = 0
      for i, size in self.strikes do
         if math.abs(size - Pixels) < math.abs(self.strikes[best] - Pixels) then best = i end
      end
      return best
   end

   -- A change of family resets the size range.  Several fixed sizes are selected by their position in the list of
   -- strikes, so the thumb can only rest on a size that exists.  Scalable families step by half points; the step
   -- counts from MIN_SIZE, which is a whole number of half points.  A family with a single fixed size has nothing to
   -- choose from, so the slider is disabled.

   self.update = function(Source:str)
      s = Picker.state

      outlined = fontdialog_style.hasOutlines(s.font)
      if outlined != self.outlined then
         self.outlined = outlined
         fontdialog_controls.setEnabled(array<table> { self.tracking, self.wordSpace }, outlined)
      end

      if (Source is 'font') or (Source is 'init') or (Source is 'reset') or (Source is 'preset') then
         locked = false
         self.strikes = nil
         if fontdialog_sizing.fixed(s.font) then
            strikes = fontdialog_sizing.strikes(s.font)
            locked = #strikes is 1
            if locked then
               self.size.slider.step = 0
               self.size.setRange(math.max(1, strikes.first() - 1), strikes.first() + 1)
            else
               self.strikes = strikes
               self.size.slider.step = 1
               self.size.setRange(0, #strikes - 1)
            end
            self.panel.setMeta((s.font.tech is 'bitmap') ? 'bitmap strikes' : 'fixed sizes')
         else
            self.size.slider.step = PT_STEP / PT_PER_PX
            self.size.setRange(MIN_SIZE, MAX_SIZE)
            self.panel.setMeta('')
         end

         if locked != self.sizeLocked then
            self.sizeLocked = locked
            fontdialog_controls.setEnabled(array<table> { self.size }, not locked)
         end
      end

      if Source != 'size' then self.size.set(sliderValue(s.size)) end
      if Source != 'sizing' then
         self.lineHeight.set(s.lineHeight)
         self.tracking.set(s.tracking)
         self.wordSpace.set(s.wordSpace)
         self.kerning.select(s.kerning)
      end
   end

   return self
end
