@Package(name="gui/fontdialog", version="1.0")

--[[
Documentation is available in the Kotuku Wiki.
--]]

   import 'gui', 'gui/listview', 'gui/window', 'gui/button', 'gui/slider', 'gui/checkbox', 'config'
   include 'display', 'font'

   namespace gui
   module font as mFont

   gui.dialog ?= { }

MIN_SIZE <const> = 4
MAX_SIZE <const> = 200
SIZE_TICKS <const> = array<double> { 4, 12, 24, 48, 72, 100, 150, 200 }
WIDTH_TICKS <const> = array<double> { 50, 62.5, 75, 87.5, 100, 112.5, 125, 150, 200 }

-- Style keywords, in the normalised form used by the font engine (lower case, no spaces, hyphens or underscores).

WEIGHT_KEYWORDS <const> = {
   thin=100, hairline=100, extralight=200, ultralight=200, light=300, regular=400, normal=400, book=400, medium=500,
   semibold=600, demibold=600, bold=700, extrabold=800, ultrabold=800, black=900, heavy=900, extrablack=950,
   ultrablack=950
}

WIDTH_KEYWORDS <const> = {
   ultracondensed=50, extracondensed=62.5, condensed=75, semicondensed=87.5, semiexpanded=112.5, expanded=125,
   extraexpanded=150, ultraexpanded=200
}

-- Conventional names for the weights that have one, used to keep simple selections as plain style names.

WEIGHT_NAMES <const> = {
   [100]='Thin', [200]='Extra Light', [300]='Light', [400]='Regular', [500]='Medium', [600]='Semi Bold', [700]='Bold',
   [800]='Extra Bold', [900]='Black'
}

NORMALISE <const> = r'[\s_\-]+'

function normalise(Value:str!):str
   return NORMALISE.replace(Value, '').lower()
end

-- Reduce a style name such as 'Semi Condensed Bold Italic' to its weight, width and italic traits.

function nameTraits(Name:str!):<num, num, bool>
   name = normalise(Name)
   italic = false
   for word in values(array<str> { 'italic', 'oblique' }) do
      pos = name.find(word)
      if pos then
         name = name.sub(0, pos) .. name.sub(pos + #word)
         italic = true
      end
   end

   width = 100
   match = ''
   for keyword, value in WIDTH_KEYWORDS do
      if (#keyword > #match) and name.find(keyword) then
         match = keyword
         width = value
      end
   end

   if #match > 0 then
      pos = name.find(match)
      name = name.sub(0, pos) .. name.sub(pos + #match)
   end

   return WEIGHT_KEYWORDS[name] ?? 400, width, italic
end

-- Read the weight, width and italic traits of a style name or style descriptor string, e.g.
-- 'weight=Medium;width=Condensed;italic=yes'.

function styleTraits(Style:str!):<num, num, bool>
   weight, width, italic = 400, 100, false
   named = false
   for segment in values(Style.split(';')) do
      segment = segment.trim()
      if #segment is 0 then continue end
      eq = segment.find('=')
      if not eq then
         if not named then
            named = true
            weight, width, italic = nameTraits(segment)
         end
         continue
      end

      key   = normalise(segment.sub(0, eq))
      value = segment.sub(eq + 1).trim()
      if key is 'weight' then
         weight = tonumber(value) ?? WEIGHT_KEYWORDS[normalise(value)] ?? weight
      elseif key is 'width' then
         if value.endsWith('%') then value = value.sub(0, -1) end
         width = tonumber(value) ?? WIDTH_KEYWORDS[normalise(value)] ?? ((normalise(value) is 'normal') ? 100 : width)
      elseif key is 'italic' then
         italic = normalise(value) in array<str> { 'yes', 'true', 'on', '1' }
      end
   end
   return weight, width, italic
end

-- Build a style string from traits.  Selections that have a conventional name, e.g. 'Semi Bold Italic', are returned
-- as that name so that they remain compatible with clients that only understand style names.

function composeStyle(Weight:num!, Width:num!, Italic:bool):str
   name = WEIGHT_NAMES[Weight]
   if name and (Width is 100) then
      if not Italic then return name end
      return (name is 'Regular') ? 'Italic' : name .. ' Italic'
   end

   parts = array<str>
   if Weight != 400 then parts.push(f'weight={Weight}') end
   if Width != 100 then parts.push(f'width={Width}%') end
   if Italic then parts.push('italic=yes') end
   return (#parts > 0) ? parts.concat(';') : 'Regular'
end

gui.dialog.font = function(Options)
   self = entity { -- Public interface
      face      = 'Noto Sans',
      pointSize = 12,
      style     = 'Regular',
      feedback  = Options.feedback,
      colour    = gui.srgb(0, 0, 0)
   }

   lLongText = [[
Lorem ipsum dolor sit amet, consectetur adipiscing elit. Maecenas varius dignissim sapien eu pellentesque. Ètiam libero velit, vehicula nec ante non, sodales ultricies metus. Phasellus commodo dolor turpis. Âliquam sed pellentesque magna, non luctus sapien. Ètiam molestie dui nibh, nec finibus velit molestie non. Ut feugiat maximus elit nec mattis. Suspendisse porta vestibulum faucibus. Sed iaculis placerat justo id lobortis. Interdum et malesuada fames ac ante ipsum primis in faucibus.

Morbi tincidunt varius ante sit amet pulvinar. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos. Nulla ante orci, faucibus non odio viverra, tempus rutrum ex. Mauris sit amet hendrerit quam. Vestibulum tincidunt magna suscipit ultrices congue. Aliquam et blandit tellus, ut porta libero. Cum sociis natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus. Cras vulputate congue eros sed placerat. Nunc eleifend nec felis sit amet fermentum. Cras suscipit ullamcorper eros, id consectetur quam blandit ac.

Suspendisse sed diam ut sem euismod accumsan commodo vehicula sapien. Nullam nisl augue, suscipit vitae posuere sit amet, porttitor et ex. Duis at elit pellentesque, placerat risus in, placerat mauris. Nam in metus sed dui iaculis aliquam sed ut sem. In varius euismod quam, sed lobortis sem. Aliquam nec dui magna. Suspendisse lobortis enim vitae vestibulum accumsan. Pellentesque ac tincidunt est. Ut porta, arcu eu ornare placerat, urna urna venenatis est, at imperdiet lectus justo vel neque. Sed congue dolor eget erat dignissim sollicitudin. Aliquam mollis massa in est gravida faucibus.

Fusce auctor metus egestas commodo laoreet. Morbi sed venenatis augue. Maecenas non nisi vehicula, aliquam turpis in, mattis lectus. Dõnec magna metus, tempor fringilla metus ac, ultricies efficitur ante. Quisque at semper elit. Ut in purus in est venenatis interdum. Curabitur a dui mauris. Suspendisse potenti. Suspendisse tempus dictum ipsum, id condimentum nulla fermentum sed. Etiam mattis ligula lacus, a tempor felis sodales fermentum. Donec in risus vulputate, tempor neque vel, volutpat mauris. Integer placerat a nunc a aliquet. Phasellus quis porta leo. Etiam et arcu ex. Nunc dictum at ipsum eu dapibus.

Ĉras metus mi, ultricies nec blandit condimentum, congue dapibus libero. Nulla eget ornare ante, ac efficitur turpis. Proin venenatis eget sapien vitae volutpat. In interdum id ante in aliquet. Quisque convallis lacus in gravida fringilla. Nam porta pellentesque turpis, ut efficitur neque suscipit vel. Morbi vitae consequat nisl. Donec turpis lorem, dapibus eget scelerisque quis, porttitor bibendum leo.
]]

   local vwFace
   local syncing = false -- True while sliders are updated by the dialog rather than the user
   local completing = false
   local closed = false
   local ready = false

   function[self] closeDialog()
      if closed then return end
      closed = true
      completing = true
      defer
         gui.dialog.active[&&] = nil
         &clear()
         processing.collect('defer')
      end
      &window?.surface?.free()
   end

   defer if not ready then closeDialog() end end

   function[self] respond(Accepted:bool!)
      if completing then return end
      completing = true
      defer closeDialog() end
      &feedback?(Accepted)
   end

   self.close = function[self]() respond(false) end

   function exampleMargin()
      return math.round(&examplePage.width * 0.05)
   end

   self.refreshGuidelines = function()
      if &exampleText then
         seq       = ''
         gap       = exampleMargin()
         spacing   = &exampleText.lineSpacing
         pageWidth = &examplePage.width
         baseline  = &exampleText.y

         x1 = gap
         x2 = pageWidth - gap
         for y in {baseline into &examplePage.height by spacing} do
            seq ..= string.format('M%f,%f L%f,%f ', x1, y, x2, y)
         end
         &guidelines.sequence = seq

         &exampleText.{ inlineSize = x2 - x1, x = gap }
      else
         &guidelines.sequence = 'M-1,-1 Z'
      end
   end

   function refreshExample()
      if not &guidelines then
         local page_colour = gui.strToRGB(&window.theme.page.bkgd.fill)
         line_col = (page_colour.luminance(page_colour) > 0.5) ? 'rgb(0 0 0 / .25)' :
            'rgb(255 255 255 / .15)'
         &guidelines = &examplePage.new('VectorPath', { strokeWidth = 0.5, stroke = line_col })
      end

      pageWidth = &examplePage.width
      gap = exampleMargin()

      &exampleText?.free()
      &exampleText = nil

      try
         &exampleText = &examplePage.new('VectorText', {
            x          = gap,
            fill       = Options.colour ? tostring(&colour) : &window.theme.page.text.fill,
            inlineSize = pageWidth - (gap * 2),
            face       = &face,
            fontSize   = &pointSize .. 'pt',
            fontStyle  = &style,
            string     = Options.example ?? lLongText,
            textFlags  = VTXF_RASTER
         })
      except ex
         msg(f'Failed to create example text for {&face} {&style}')
      end

      &exampleText?.y = math.floor(gap + &exampleText.displaySize)

      &refreshGuidelines()

      processing.collect()
      &viewport.acDraw()
   end

   -- Load the system font catalogue and convert its Config strings to values used by the dialog.

   function getFonts()
      &prvFonts = resolve(gui.fontList)
   end

   -- Resolve the face of a font list entry, following aliases.

   function fontEntry(Face:str!):table
      font = &prvFonts[Face]
      if font?.alias then font = &prvFonts[font.alias] end
      return font
   end

   function updateStyle()
      &style = composeStyle(&weight, &width, &italic)
      refreshExample()
   end

   -- Bitmap fonts must use an available size, preferring the largest not above the request.

   function nearestFixedSize(Sizes:array<double>, Size:num):num
      selected = Sizes[0]
      for size in values(Sizes) do
         if size <= Size and (selected > Size or size > selected) then
            selected = size
         elseif selected > Size and size < selected then
            selected = size
         end
      end
      return selected
   end

   -- Configure the sliders and italic option for the selected face.

   function configureControls()
      font = fontEntry(&face)
      syncing = true
      defer syncing = false end

      if font?.sizes and (not font.scalable) and (#font.sizes > 0) then
         sizes = array<double>
         for size in values(font.sizes) do sizes.push(size) end
         sizes.sort()
         &pointSize = nearestFixedSize(sizes, &pointSize)
         if sizes.first() < sizes.last() then
            &sizeSlider.setRange(sizes.first(), sizes.last())
            &sizeSlider.enable()
         else
            &sizeSlider.disable()
         end
         &sizeSlider.step = 1
         &sizeSlider.setTicks(sizes)
         &prvFixedSizes = sizes
      else
         &sizeSlider.setRange(MIN_SIZE, MAX_SIZE)
         &sizeSlider.step = 0.5
         &sizeSlider.setTicks(SIZE_TICKS)
         &sizeSlider.enable()
         &prvFixedSizes = nil
      end
      &sizeSlider.setValue(&pointSize, true)

      -- Width is only variable if the face has a wdth axis or the family has width styles.

      has_width = font?.axes and ('wdth' in font.axes)
      has_italic = false
      for style in values(font?.styles ?? array<str>) do
         lower = style.lower()
         if lower.find('condensed') or lower.find('expanded') then has_width = true end
         if lower.find('italic') or lower.find('oblique') then has_italic = true end
      end

      if has_width then &widthSlider.enable() else &widthSlider.disable() end
      if has_italic then &italicBox.enable() else &italicBox.disable() end
   end

   using self do
      getFonts()

      -- Disassemble any compact font face definition.  Trailing and empty parts are optional, e.g. 'Noto Sans' or
      -- 'Noto Sans::Bold'.

      if Options.face then
         s = string.split(Options.face, ':') -- FaceName, Size, Style, Colour
         s.resize(4) -- Missing parts are padded with nil
         if s[0]?? then Options.face      = s[0] end
         if s[1]?? then Options.pointSize = tonumber(s[1]) ?? Options.pointSize end
         if s[2]?? then Options.style     = s[2] end
         if s[3]?? then Options.colour    = s[3] end
      end

      if Options.pointSize then
         &pointSize = math.clamp(tonumber(Options.pointSize) ?? &pointSize, 4, 400)
      end

      &style = Options.style ?? &style
      local weight, width, italic = styleTraits(&style)
      self.{ weight = weight, width = width, italic = italic }
      if Options.colour is <str> then
         &colour = gui.strToRGB(Options.colour)
      elseif Options.colour is <table> then
         &colour = gui.nrgb(Options.colour.r, Options.colour.g, Options.colour.b, Options.colour.a)
      end

      &window = gui.window({
         insideWidth  = gui.rpixel('1000dp'),
         insideHeight = gui.rpixel('900dp'),
         minWidth     = gui.rpixel('700dp'),
         minHeight    = gui.rpixel('600dp'),
         maxWidth     = gui.rpixel('1500dp'),
         maxHeight    = gui.rpixel('1200dp'),
         quit         = false,
         popOver      = Options.popOver,
         icon         = 'items/font',
         title        = Options.title ?? 'Select a font',
         modal        = Options.modal ?? false,
         events = {
            close = function()
               respond(false)
            end
         }
      })

      &window.surface.subscribe('free', function[<weak> &&]()
         if not completing then closeDialog() end
      end)

      &viewport = &window.clientViewport({
         resizeEvent = function()
            self.refreshGuidelines()
         end
      })

      -- Okay and cancel buttons

      footer = &window.margins.bottom

      okay = gui.button({
         target  = &viewport,
         label   = 'OK',
         xOffset = gui.sizing.widget.gap,
         yOffset = footer,
         icon    = 'items/checkmark',
         primary = true,
         events  = {
            activate = function()
               respond(true)
            end
         }
      })

      cancel = gui.button({
         target  = &viewport,
         label   = 'Cancel',
         xOffset = okay.viewport.width + (gui.sizing.widget.gap * 2),
         yOffset = footer,
         icon    = 'items/cancel',
         events  = {
            activate = function()
               respond(false)
            end
         }
      })

      footer += okay.viewport.height + gui.sizing.widget.gap

      -- Font example area

      &exampleVP = &viewport.new('VectorViewport', {
         x       = gui.rpixel('310dp'),
         y       = &window.margins.top,
         xOffset = &window.margins.right,
         yOffset = footer
      })

      &exampleBkgd = &exampleVP.new('VectorRectangle', table.merge({
         x = 0, y = 0, width = '100%', height = '100%'
      }, table.merge(&window.theme.page.bkgd, &window.theme.page.border)))

      &exampleView = &exampleVP.new('VectorViewport', {
         x = gui.sizing.widget.gap, y = gui.sizing.widget.gap, xOffset = gui.sizing.widget.gap, yOffset = gui.sizing.widget.gap, overflow = VOF_HIDDEN
      })

      &examplePage = &exampleView.new('VectorViewport', {
         name='view_page', width='100%', height='100%'
      })

      refreshExample()

      -- Font size, weight, width and italic controls, stacked above the footer

      control_width = &exampleVP.x - gui.sizing.widget.gap - &window.margins.left
      label_width = gui.rpixel('90dp')

      &italicBox = gui.checkbox({
         target  = &viewport,
         x       = &window.margins.left,
         yOffset = footer,
         label   = 'Italic',
         value   = &italic,
         events  = {
            activate = function()
               using self do
                  &italic = &italicBox.value
                  updateStyle()
               end
            end
         }
      })

      footer += &italicBox.viewport.height + gui.sizing.widget.gap

      function newSlider(Label:str!, Min:num!, Max:num!, Step:num!, Ticks:array<double>, Value:num!,
         Activate:func!):table
         local slider = gui.slider({
            target     = &viewport,
            label      = Label,
            labelWidth = label_width,
            valuePos   = 'in-centre',
            min        = Min,
            max        = Max,
            step       = Step,
            ticks      = Ticks,
            value      = math.clamp(Value, Min, Max),
            x          = &window.margins.left,
            yOffset    = footer,
            width      = control_width,
            events     = {
               activate = function(NewValue)
                  if syncing then return end
                  using self do Activate(NewValue) end
               end
            }
         })
         footer += slider.viewport.height + gui.sizing.widget.gap
         return slider
      end

      &widthSlider = newSlider('Width:', 50, 200, 0.5, WIDTH_TICKS, &width, function(Value)
         &width = Value
         updateStyle()
      end)

      &weightSlider = newSlider('Weight:', 100, 900, 10, array<double> { 100, 400, 700, 900 }, &weight,
         function(Value)
            &weight = Value
            updateStyle()
         end)

      &sizeSlider = newSlider('Size:', MIN_SIZE, MAX_SIZE, 0.5, SIZE_TICKS, &pointSize, function(Value)
         if &prvFixedSizes then
            -- Snap to the nearest size that the bitmap font provides.
            nearest = &prvFixedSizes[0]
            for size in values(&prvFixedSizes) do
               if math.abs(size - Value) < math.abs(nearest - Value) then nearest = size end
            end
            Value = nearest
            if &sizeSlider.value != nearest then
               syncing = true
               &sizeSlider.setValue(nearest, true)
               syncing = false
            end
         end
         if &pointSize != Value then
            &pointSize = Value
            refreshExample()
         end
      end)

      -- Available font faces

      vwFace = gui.listView({
         x          = &window.margins.left,
         y          = &window.margins.top,
         width      = &exampleVP.x - gui.sizing.widget.gap - &window.margins.left,
         yOffset    = footer,
         target     = &viewport,
         sensitive  = true,
         textAttrib = 'name',
         events = {
            itemSelected = function(View, Reason, Item)
               using self do
                  assert(&prvFonts[Item.name], f'Font "{Item.name}" not recognised.')

                  &face = Item.name
                  configureControls()
                  refreshExample()
               end
            end
         }
      })

      faces = { }
      for _, font in &prvFonts.sortByKeys() do
         if font.hidden?? then continue end

         new_font = { id=font.name, name=font.name }
         if font.alias then font = &prvFonts[font.alias] end
         new_font.icon = font.scalable ? 'items/font' : 'layout/text_sans'
         faces.insert(new_font)
      end
      vwFace.loadItems(faces)

      -- Preselect list items based on the preferences supplied by the client.

      vwFace.selectItems(function(Item)
         if Item.id is (Options.face ?? 'Noto Sans') then return true end
      end)

      &window.moveToFront()
      &window.show(true)
      --vwFace.acFocus()

      gui.dialog.active[&&] = true
      ready = true
      return &&
   end
end

   -- This sub-routine is provided for languages other than Tiri to utilise the module.

@if(imported=false)
   dlg = gui.dialog.font({
      popOver    = arg('popOver'),
      target     = arg('target'),
      modal      = arg('modal'),
      icon       = arg('icon')
   })

   return dlg.window.surface.id
@end
