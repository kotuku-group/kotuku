@Package(name="gui/fontdialog", version="1.0")

--[[
   import 'gui/fontdialog'

   gui.dialog.font({
      face      = 'Noto Sans, Arial',     -- family list
      size      = '12pt',                 -- initial size: pixels (number) or e.g. '16px', '12pt'
      style     = 'Bold Italic',          -- style name, or descriptors such as 'weight=550;italic=yes'
      fill      = '#203040',            -- text colour
      example   = 'Sample text',          -- preview text
      bkgd      = '#203040',            -- fill for the preview's background
      fontDef   = 'face=Noto Sans; ...',  -- font definition; its keys override the options above
      resultFilter = { 'face', 'size' },  -- table or array of the key names to include in the Result
      features  = { 'list', 'preview' },  -- table or array of the panels to show; all of them if omitted.  The names
                                          -- are list, preview, sizing, style, glyphs, fill, stroke, effects, alignment
      feedback  = function(Result) ... end -- Result table, or nil on cancel
   })

   Result holds face, style, size (px), pointSize, fill, fontFeatures, fontDef and settings, or only the keys named by
   resultFilter.  fontFeatures is the value of the definition's features key, e.g. 'kern 1, liga 0, smcp 1'.
--]]

   import 'gui', 'gui/window', 'gui/button', 'gui/scrollbar'

   import './theme', './parts', './catalogue', './controls', './fontlist', './preview', './sizing', './style'
   import './glyphs', './fill', './stroke', './effects', './alignment'
   import 'gui/fontdialog/storage'

   include 'display'

   namespace gui

   gui.dialog ?= { }

COLUMN_WIDTHS <const> = array<int> { 312, 584, 284 }
BODY_HEIGHT   <const> = 700
FOOTER_HEIGHT <const> = 42
CLIENT_HEIGHT <const> = BODY_HEIGHT + FOOTER_HEIGHT
FOOTER_PAD    <const> = 12
FOOTER_GAP    <const> = 8
BUTTON_HEIGHT <const> = 26
SCREEN_FILL   <const> = 0.9 -- Maximum share of the monitor that the window may occupy when it opens or zooms
ZOOM_STEP     <const> = 1.25
MIN_SCALE     <const> = 0.5
MAX_SCALE     <const> = 4
MIN_PREVIEW   <const> = 220 -- Least height of the Preview panel, including its header and footer

-- The columns abut.  Panels in adjacent columns are 12 px apart, matching the vertical gap between panels: each column
-- leaves 6 px beside its neighbour and 14 px at the window edges, as in the colour picker.

EDGE_PAD <const> = 14
SIDE_PAD <const> = 6
GAP      <const> = 12

LEFT_INNER   <const> = COLUMN_WIDTHS[0] - EDGE_PAD - SIDE_PAD
CENTRE_INNER <const> = COLUMN_WIDTHS[1] - (SIDE_PAD * 2)
RIGHT_INNER  <const> = COLUMN_WIDTHS[2] - SIDE_PAD - EDGE_PAD
SCROLL_THICKNESS <const> = 10 -- The right column's scrollbar, which sits in its edge padding

-- Layouts without the preview.  Up to SLIM_PANELS small panels form a single column in a slim dialog, and any more are
-- arranged in two columns.  SLIM_INNER gives a lone column the room that the footer's three buttons need.

SLIM_PANELS    <const> = 3
SLIM_INNER     <const> = 312
DOUBLE_INNER   <const> = 280 -- Width of each panel when the small panels form two columns
MIN_LIST_BODY  <const> = 360 -- Least body height that leaves the font list usable
MIN_STACK_BODY <const> = 200 -- Least body height of a layout that only has the scrolling stack

ALL_FEATURES <const> = array<str> {
   'list', 'preview', 'sizing', 'style', 'glyphs', 'fill', 'stroke', 'effects', 'alignment'
}

-- The small panels in stacking order.  Sizing and Style are only part of the stack when there is no preview.

STACK_ORDER <const> = array<str> { 'sizing', 'style', 'glyphs', 'fill', 'stroke', 'effects', 'alignment' }

DEFAULT_FACE <const> = 'Noto Sans'

-- The keys returned in the result when the client does not specify a resultFilter.

glDefaultFilter <const> = array<str> {
   'face', 'style', 'size', 'pointSize', 'fill', 'fontFeatures', 'fontDef'
   -- Not included: settings
}

-- Presets.  The first available face of each is used.  A preset's `def` is a font definition.  Presets saved by the
-- user follow these, and are kept in fontdialog_storage.FILE along with the user's pins.

PRESETS <const> = array<table> {
   { name = 'Body copy',    faces = array<str> { 'Noto Serif', 'PT Serif', 'Crimson Pro' },
      def = 'size=19px; Regular' },
   { name = 'Headline',     faces = array<str> { 'Noto Sans', 'Inconsolata' }, def = 'size=56px; Extra Bold' },
   { name = 'Poster',       faces = array<str> { 'Libre Baskerville', 'Noto Serif' }, def = 'size=64px; Bold' },
   { name = 'Code listing', faces = array<str> { 'Source Code Pro', 'Inconsolata', 'Courier Prime' },
      def = 'size=15px; Regular' }
}

----------------------------------------------------------------------------------------------------------------------
-- Convert the features option to a set of names.  Every feature is enabled if the option is omitted.

function readFeatures(Features:any):table
   enabled = { }
   if Features is nil then Features = ALL_FEATURES end
   for name in values(Features) do
      assert(name in ALL_FEATURES, f'Unknown font dialog feature \'{name}\'')
      enabled[name] = true
   end
   assert(not table.empty(enabled), 'The features option must name at least one feature')
   return enabled
end

----------------------------------------------------------------------------------------------------------------------
-- Calculate the column layout for a set of features.  The columns abut and those that are present are positioned from
-- the left: the font list, the preview with the Sizing and Style panels below it, then the scrolling stack of small
-- panels.  Each column has `x`, `width`, `left` (the inset of its content) and `inner` (the width of its content).

function planLayout(Has:table!):table
   stack = array<str>
   for name in values(STACK_ORDER) do
      if (name is 'stroke') and Has.fill then continue end
      if Has[name] and not (Has.preview and ((name is 'sizing') or (name is 'style'))) then stack.push(name) end
   end

   plan = { enabled = Has, stackNames = stack, stackColumns = 1, stackInner = COLUMN_WIDTHS[2] - SIDE_PAD - EDGE_PAD }
   plan.slim = (not Has.preview) and (#stack <= SLIM_PANELS)

   if not Has.preview then
      if not plan.slim then
         plan.stackColumns = 2
         plan.stackInner = DOUBLE_INNER
      elseif not Has.list then
         plan.stackInner = SLIM_INNER
      end
   end

   spans = array<table>
   if Has.list then
      plan.list = { inner = (#stack is 0 and not Has.preview) ? SLIM_INNER : LEFT_INNER }
      spans.push(plan.list)
   end
   if Has.preview then
      plan.centre = { inner = CENTRE_INNER }
      spans.push(plan.centre)
   end
   if #stack > 0 then
      plan.stack = { inner = (plan.stackInner * plan.stackColumns) + (GAP * (plan.stackColumns - 1)) }
      spans.push(plan.stack)
   end

   x = 0
   for i, span in spans do
      span.x = x
      span.left = (i is 0) ? EDGE_PAD : SIDE_PAD
      span.width = span.left + span.inner + ((i is #spans - 1) ? EDGE_PAD : SIDE_PAD)
      x += span.width
   end

   plan.spans = spans
   plan.width = x

   -- The least body height at which the layout fits.  A shorter window scales the layout down to this height.

   plan.lowerHeight = (Has.preview and (Has.sizing or Has.style)) ? fontdialog_sizing.HEIGHT : 0

   if Has.preview then
      plan.minBody = (EDGE_PAD * 2) + MIN_PREVIEW + ((plan.lowerHeight > 0) ? plan.lowerHeight + GAP : 0)
   else
      plan.minBody = Has.list ? MIN_LIST_BODY : MIN_STACK_BODY
   end

   plan.minClient = plan.minBody + FOOTER_HEIGHT
   return plan
end

----------------------------------------------------------------------------------------------------------------------
-- The settings for a family with everything else at its default.  Fill is the page text colour of the window theme.

function freshState(Font:table!, Size:num, Fill:str):table
   return {
      font         = Font,
      size         = fontdialog_sizing.snap(Font, Size ?? 20),
      unit         = 'px',
      lineHeight   = 1.45,
      tracking     = 0,
      wordSpace    = 0,
      kerning      = 'metrics',
      axes         = fontdialog_style.defaultAxes(Font),
      italic       = false,
      style        = fontdialog_style.defaultStyle(Font),
      features     = fontdialog_style.defaultFeatures(),
      fill         = Fill,
      opacity      = 100, -- Alpha of the fill
      strokeOn     = false,
      strokeColour = '#EC3013',
      strokeWidth  = 1,
      strokeOpacity = 100,
      strokeJoin   = 'miter',
      shadowOn     = false,
      shadowX      = 3,
      shadowY      = 4,
      shadowBlur   = 0,
      glowOn       = false,
      glowRadius   = 10,
      blend        = 'Normal',
      align        = 'left',
      letterCase   = 'none',
      paraSpace    = 0.8,
      view         = 'para',
      text         = fontdialog_preview.TEXT
   }
end

----------------------------------------------------------------------------------------------------------------------

gui.dialog.font = function(Options:table)
   Options ??= { }

   plan = planLayout(readFeatures(Options.features))
   client_width = plan.width

   self = entity {
      feedback  = Options.feedback,
      resultFilter = Options.resultFilter, -- Names of the keys to return in the result; nil uses glDefaultFilter
      previewBkgd = Options.bkgd, -- Overrides the fill of the preview's background
      finished  = false,
      isTyping  = false,
      presets   = PRESETS.clone(),
      pins      = { },
      database  = fontdialog_storage.load(),
      fonts     = nil,
      state     = nil,
      panels    = array<table>, -- Every panel module, in update order
      rightPanels = array<table>, -- The right column's panels, in stacking order
      bodyHeight  = BODY_HEIGHT, -- Height of the layout above the footer, in layout units
      zoomHeight  = nil -- Layout height to keep while a zoom resizes the window
   }

   for name in values(self.database.pins) do self.pins[name] = true end

   local ready = false
   defer if not ready then self.finish?(nil) end end

   using self do
      &fonts = fontdialog_catalogue.load()
      assert(#&fonts > 0, 'No fonts are installed.')

      function findFont(Name:str):table
         for font in values(&fonts) do
            if font.name is Name then return font end
         end
         return nil
      end

      -- The first installed family of a comma-separated list, following aliases.  Returns nil if there is none.

      function findFace(List:str):table
         List ?! return nil
         for entry in values(List.split(',')) do
            local name = entry.trim()
            local info = gui.fontList[name]
            local target = info?.alias ?? name
            local font = findFont(target)
            if font then return font end
         end
         return nil
      end

      -- State changes.  Panels call update() with the settings they change and a Source that names the change, so
      -- that a panel can skip refreshing the control that made it.

      &refresh = function(Source:str)
         if &finished then return end
         for panel in values(&panels) do panel.update(Source) end
         &viewport.acDraw()
      end

      &update = function(Patch:table!, Source:str)
         if &finished then return end
         for k, v in Patch do &state[k] = v end
         &refresh(Source)
      end

      -- Replace every setting, e.g. when swapping the compare panes.

      &restore = function(Settings:table!)
         &state = table.clone(Settings)
         &refresh('reset')
      end

      -- Select a family.  The size is kept (snapped to the family's fixed sizes) and the style settings return to
      -- the family's defaults; fill, stroke, effects and layout settings are kept.

      &selectFont = function(Font:table!)
         if Font is &state.font then return end
         &update({
            font     = Font,
            size     = fontdialog_sizing.snap(Font, &state.size),
            axes     = fontdialog_style.defaultAxes(Font),
            italic   = false,
            style    = fontdialog_style.defaultStyle(Font),
            features = fontdialog_style.defaultFeatures(),
            text     = fontdialog_preview.textFor(Font, &state.text)
         }, 'font')
      end

      &presetState = function(Name:str!):table
         preset = &presets.find(P => P.name is Name)
         preset ?! return nil
         font = nil
         for face in values(preset.faces) do
            font = findFont(face)
            if font then break end
         end
         font ?! return nil

         state = freshState(font, nil, &defaultFill)
         fontdialog_style.applyDef(state, preset.def)
         state.size = fontdialog_sizing.snap(font, state.size)
         return state
      end

      -- Write the user's pins and presets.  A failure is reported in the font list, and the change lasts for the life
      -- of the dialog.

      &persist = function()
         pins = array<str>
         for name in &pins do pins.push(name) end
         pins.sort()

         presets = array<table>
         for preset in values(&presets) do
            if preset.user then presets.push({ name = preset.name, def = preset.def }) end
         end

         ok, message = fontdialog_storage.save(&database, pins, presets)
         if not ok then &fontList.panel.flash(message) end
      end

      &addSavedPreset = function(Name:str!, Def:str!, Face:str!)
         &presets.push({ name = Name, faces = array<str> { Face }, def = Def, user = true })
      end

      &savePreset = function():str
         local name:str
         local number = 1
         repeat
            name = f'Saved {number}'
            number++
         until not &presets.find(P => P.name is name)
         &addSavedPreset(name, fontdialog_style.fontDef(&state), &state.font.name)
         &persist()
         return name
      end

      -- Returns true if the named preset was a saved preset and has been deleted.

      &deletePreset = function(Name:str!):bool
         index = &presets.findIndex(P => (P.name is Name) and P.user)
         index ?= -1
         if index < 0 then return false end
         &presets.remove(index)
         &persist()
         return true
      end

      -- Saved presets with a duplicate name or an invalid definition are skipped.

      for saved in values(&database.presets) do
         try
            face = fontdialog_style.readDef(saved.def).face
            if face and not &presets.find(P => P.name is saved.name) then &addSavedPreset(saved.name, saved.def, face) end
         except e
            print(f'Font dialog: ignoring saved preset {saved.name}: {e.message}')
         end
      end

      &applyPreset = function(Name:str!)
         state = &presetState(Name)
         if not state then
            &fontList.panel.flash('preset font missing')
            return
         end
         state.text = fontdialog_preview.textFor(state.font, &state.text)
         &state = state
         &refresh('preset')
      end

      &typing = function(Typing:bool)
         &isTyping = Typing
      end

      -- Sizing.  The layout is client_width units wide and is scaled to the width of the window.  The window's height
      -- is not scaled: the layout reflows to fill it, with the font list, the Preview panel and the right column's
      -- scrolling stack taking up the difference.  A window too short for plan.minClient scales the layout down
      -- to fit instead.

      &layout = function(BodyHeight:num!)
         if BodyHeight is &bodyHeight then return end
         &bodyHeight = BodyHeight

         for col in values(&columns) do col.height = BodyHeight end
         if &fontList then &fontList.panel.viewport.height = BodyHeight - (EDGE_PAD * 2) end

         if &preview then
            lower_y = BodyHeight - EDGE_PAD - plan.lowerHeight
            &preview.setHeight(lower_y - ((plan.lowerHeight > 0) ? GAP : 0) - EDGE_PAD)
            if &sizing then &sizing.panel.viewport.y = lower_y end
            if &style then &style.panel.viewport.y = lower_y end
         end

         &footer.y = BodyHeight
         &viewport.acDraw()
      end

      &fit = function()
         if &finished then return end
         surface = &window.surface
         if (surface.width <= 0) or (surface.height <= 0) then return end
         height = math.max(plan.minClient, math.round(surface.height * client_width / surface.width))

         -- After a zoom, the layout keeps its height unless the window was resized by more than rounding allows.

         if &zoomHeight and (math.abs(height - &zoomHeight) <= 1) then height = &zoomHeight end
         &zoomHeight = nil

         &viewport.viewHeight = height
         &layout(height - FOOTER_HEIGHT)
      end

      -- Zooming resizes the window to the new scale, so that the layout keeps its height.  The window is kept within
      -- the monitor.

      function setScale(Scale:num!)
         surface = &window.surface
         current = surface.width / client_width
         monitor_width, monitor_height = &window.parentSize()
         upper = MAX_SCALE
         if (monitor_width ?? 0) > 0 then upper = math.min(upper, monitor_width * SCREEN_FILL / client_width) end
         scale = math.clamp(Scale, MIN_SCALE, math.max(MIN_SCALE, upper))
         if math.abs(scale - current) < 0.001 then return end

         &zoomHeight = &bodyHeight + FOOTER_HEIGHT
         height = &zoomHeight * scale
         if (monitor_height ?? 0) > 0 then height = math.min(height, monitor_height * SCREEN_FILL) end
         &window.resizeClientArea(math.round(client_width * scale), math.round(height))
      end

      -- Stack the right column's panels and size the scrolled page to fit them.  A panel's stackColumn is only set
      -- when the small panels form two columns.

      &layoutRight = function()
         if #&rightPanels is 0 then return end
         next_y = array<double> { EDGE_PAD, EDGE_PAD }
         for p in values(&rightPanels) do
            column = p.stackColumn ?? 0
            p.panel.viewport.{ x = plan.stack.left + (column * (plan.stackInner + GAP)), y = next_y[column] }
            next_y[column] += p.height + GAP
         end
         &rightPage.height = math.max(next_y[0], next_y[1]) - GAP + EDGE_PAD
      end

      -- Assign the panels to the shorter of the two columns.  This is done once so that a panel doesn't change columns
      -- when its height changes.

      function assignStackColumns()
         if plan.stackColumns < 2 then return end
         heights = array<double> { 0, 0 }
         for p in values(&rightPanels) do
            column = (heights[1] < heights[0]) ? 1 : 0
            p.stackColumn = column
            heights[column] += p.height + GAP
         end
      end

      -- Close the window and notify the client once.  Result is nil for a cancellation.

      &finish = function(Result:table)
         if &finished then return end
         &finished = true
         defer
            gui.dialog.active[&&] = nil
            processing.collect('defer')
         end
         local surface = &window?.surface
         defer surface?.free() end

         feedback = &feedback
         &feedback = nil
         &panels = array<table>
         &rightPanels = array<table>
         for field in values(array<str> {
            'fontList', 'preview', 'sizing', 'style', 'glyphs', 'fill', 'stroke', 'effects', 'alignment',
            'rightBar', 'rightPage', 'rightView', 'columns', 'footer', 'btnSelect', 'btnCancel', 'btnReset',
            'viewport', 'window'
         }) do self[field] = nil end

         if feedback then feedback(Result) end
      end

      &apply = function()
         if &finished then return end
         s = &state
         result = {
            face      = s.font.name,
            style     = fontdialog_style.fontStyle(s),
            size     = s.size,
            pointSize = fontdialog_sizing.points(s.size),
            fill      = s.fill,
            fontFeatures = fontdialog_style.featureList(s),
            fontDef   = fontdialog_style.fontDef(s),
            settings  = fontdialog_style.resultSettings(s)
         }

         -- Not '??', which would replace an empty filter with the default.

         key_filter = &resultFilter
         key_filter ?= glDefaultFilter

         filtered = { }
         for key in values(key_filter) do filtered[key] = result[key] end
         &finish(filtered)
      end

      &cancel = function() &finish(nil) end

      &reset = function()
         &restore(&initialState)
      end

      &window = gui.window({
         insideWidth  = client_width,
         insideHeight = CLIENT_HEIGHT,
         quit         = false,
         minWidth     = math.round(client_width * MIN_SCALE),
         minHeight    = math.round(plan.minClient * MIN_SCALE),
         popOver      = Options.popOver,
         icon         = Options.icon ?? 'items/font',
         title        = Options.title ?? 'Select Font',
         modal        = Options.modal ?? false,
         themeName    = Options.theme,
         events = {
            close = function[<weak> &&](Window)
               &finish(nil)
            end
         }
      })

      &theme = &window.theme

      &window.surface.subscribe('free', function[<weak> &&]()
         &finish(nil)
         if &themeName then gui.themes[&themeName] = nil end -- The derived theme is specific to this window
      end)

      &themeName = fontdialog_theme.apply(&window.scene, 'fontdialog')
      &tokens = fontdialog_theme.tokens(&themeName)
      &defaultFill = fontdialog_controls.toHex(&theme.page.text.fill ?? '#000000')

      -- Initial settings: the requested family, or the first preset.  A requested size overrides the preset's, and
      -- is shown in points if it is a whole number of points once snapped to the family's fixed sizes.  The other options are then applied, and fontDef last so that its keys take precedence.

      size = fontdialog_sizing.parse(Options.size)

      local definition:table
      if Options.fontDef?? then definition = fontdialog_style.readDef(Options.fontDef) end

      font = findFace(definition?.face) ?? findFace(Options.face)
      if font then
         &state = freshState(font, size, &defaultFill)
      else
         &state = &presetState(PRESETS[0].name) ?? freshState(findFont(DEFAULT_FACE) ?? &fonts[0], size,
            &defaultFill)
      end

      if size then
         &state.size = fontdialog_sizing.snap(&state.font, size)
         &state.unit = fontdialog_sizing.preferredUnit(&state.size)
      end

      if Options.style?? then fontdialog_style.applyDef(&state, Options.style) end
      if Options.fill?? then &state.fill = fontdialog_controls.toHex(Options.fill) end
      if Options.example?? then
         &state.text = Options.example
      else
         &state.text = fontdialog_preview.sampleFor(&state.font)
      end

      if definition then
         fontdialog_style.applyDef(&state, Options.fontDef)
         &state.size = fontdialog_sizing.snap(&state.font, &state.size)
      end

      &initialState = table.clone(&state)

      &viewport = &window.clientViewport({
         viewX = 0, viewY = 0, viewWidth = client_width, viewHeight = CLIENT_HEIGHT
      })

      &columns = array<obj>
      for span in values(plan.spans) do
         span.viewport = &viewport.new('VectorViewport', {
            x = span.x, y = 0, width = span.width, height = BODY_HEIGHT
         })
         &columns.push(span.viewport)
      end

      enabled = plan.enabled

      -- Left column

      if enabled.list then
         &fontList = fontdialog_list.new(&&, plan.list.viewport, {
            x = plan.list.left, y = EDGE_PAD, width = plan.list.inner, height = BODY_HEIGHT - (EDGE_PAD * 2)
         })
      end

      -- Right column: a scrolling stack of panels.  The scrollbar sits in the column's edge padding.

      stack_options = nil
      if plan.stack then
         col = plan.stack.viewport
         &rightView = col.new('VectorViewport', { x = 0, y = 0, xOffset = 0, yOffset = 0, overflow = VOF_HIDDEN })
         &rightPage = &rightView.new('VectorViewport', {
            x = 0, y = 0, width = plan.stack.width - SCROLL_THICKNESS, height = BODY_HEIGHT
         })
         &rightBar = gui.scrollbar({
            target = col, view = &rightView, page = &rightPage, direction = 'vertical',
            theme = { scrollbar = { thickness = SCROLL_THICKNESS } }
         })

         stack_options = { x = plan.stack.left, y = 0, width = plan.stackInner }
      end

      -- Centre column: the preview above the Sizing and Style panels, which join the stack if there is no preview.

      sizing_target, sizing_options, style_target, style_options = nil, nil, nil, nil

      if enabled.preview then
         centre = plan.centre
         lower_y = BODY_HEIGHT - EDGE_PAD - plan.lowerHeight

         &preview = fontdialog_preview.new(&&, centre.viewport, {
            x = centre.left, y = EDGE_PAD, width = centre.inner,
            height = lower_y - ((plan.lowerHeight > 0) ? GAP : 0) - EDGE_PAD
         })

         -- Sizing and Style share the width of the column, unless only one of them is present.

         half = (enabled.sizing and enabled.style) ? math.floor((centre.inner - GAP) * 0.5) : centre.inner
         sizing_target = centre.viewport
         style_target  = centre.viewport
         sizing_options = { x = centre.left, y = lower_y, width = half }
         style_options  = {
            x = centre.left + (enabled.sizing ? half + GAP : 0), y = lower_y,
            width = enabled.sizing ? centre.inner - half - GAP : centre.inner
         }
      elseif plan.stack then
         sizing_target = &rightPage
         style_target  = &rightPage
         sizing_options = table.clone(stack_options)
         style_options  = table.clone(stack_options)
      end

      if enabled.sizing then
         &sizing = fontdialog_sizing.new(&&, sizing_target, sizing_options)
         &sizing.height = fontdialog_sizing.HEIGHT
      end

      if enabled.style then
         style_options.height = fontdialog_sizing.HEIGHT
         &style = fontdialog_style.new(&&, style_target, style_options)
         &style.height = fontdialog_sizing.HEIGHT
      end

      function restack(Options:table!):table
         return table.merge(Options, { onResize = function[<weak> &&]() &layoutRight() end })
      end

      if enabled.glyphs then &glyphs = fontdialog_glyphs.new(&&, &rightPage, restack(stack_options)) end

      if enabled.fill then &fill = fontdialog_fill.new(&&, &rightPage, stack_options) end

      if enabled.stroke then
         stroke_options = table.clone(stack_options)
         if enabled.fill then
            stroke_options.panel = &fill.panel
            stroke_options.contentY = &fill.height - fontdialog_theme.PANEL_HEADER_H + 4
            &fill.height += fontdialog_stroke.HEIGHT - fontdialog_theme.PANEL_HEADER_H
            &fill.panel.setTitle('Paint')
            &fill.panel.viewport.height = &fill.height
         end
         &stroke = fontdialog_stroke.new(&&, &rightPage, stroke_options)
      end

      if enabled.effects then &effects = fontdialog_effects.new(&&, &rightPage, restack(stack_options)) end

      if enabled.alignment then &alignment = fontdialog_alignment.new(&&, &rightPage, stack_options) end

      for name in values(plan.stackNames) do &rightPanels.push(self[name]) end

      for name in values(array<str> {
         'fontList', 'sizing', 'style', 'glyphs', 'fill', 'stroke', 'effects', 'alignment', 'preview'
      }) do
         if self[name] then &panels.push(self[name]) end
      end

      &layoutRight()

      -- Footer: key hints and the dialog buttons

      t = &tokens
      &footer = &viewport.new('VectorViewport', {
         x = 0, y = BODY_HEIGHT, width = client_width, height = FOOTER_HEIGHT
      })

      &footer.new('VectorRectangle', { x = 0, y = 0, width = '100%', height = 1, fill = t.border })

      -- Hints are limited to the keys that have an effect.  A slim dialog needs its width for the buttons, and in other
      -- layouts the hints that don't fit beside the buttons are dropped.

      hints = array<table>
      if not plan.slim then
         hints.push({ key = 'Tab', text = 'next control' })
         if enabled.list then
            hints.push({ key = 'Ctrl+F', text = 'search' })
            hints.push({ key = 'S', text = 'pin' })
         end
         if enabled.preview then hints.push({ key = 'C', text = 'compare' }) end
      end

      hint_room = client_width - (FOOTER_PAD * 2) - FOOTER_GAP - (3 * (100 + FOOTER_GAP))
      while #hints > 0 do
         hint_group = &footer.new('VectorViewport', { x = 0, y = 0, width = hint_room, height = FOOTER_HEIGHT })
         width = fontdialog_parts.hints(hint_group, {
            x = FOOTER_PAD, y = 0, height = FOOTER_HEIGHT, tokens = t.onWindow, items = hints
         })
         if width <= hint_room then break end
         hint_group.free()
         hints.pop()
      end

      function footerButton(Text:str, Primary:bool, Activate:func):table
         return gui.button({
            target = &footer, y = (FOOTER_HEIGHT - BUTTON_HEIGHT) * 0.5, width = 100, height = BUTTON_HEIGHT,
            label = Text, primary = Primary, events = { activate = Activate }
         })
      end

      &btnSelect = footerButton(Options.okLabel ?? 'Select', true, function[&&]() &apply() end)
      &btnCancel = footerButton(Options.cancelLabel ?? 'Cancel', false, function[&&]() &cancel() end)
      &btnReset  = footerButton('Reset', false, function[&&]() &reset() end)

      x = client_width - FOOTER_PAD
      for btn in values(array<table> { &btnSelect, &btnCancel, &btnReset }) do
         x -= btn.viewport.width
         btn.viewport.x = x
         x -= FOOTER_GAP
      end

      -- Dialog keys.  The handler receives every key while the focus is anywhere in the client area:
      --
      --   Enter    Selects the font, unless a text box has the focus.  A focused button, toggle or combobox consumes
      --            the key, so it does not reach this handler.
      --   Escape   Cancels, unless a combobox menu is open; the combobox closes its menu instead.
      --   Ctrl+F   Moves the focus to the search box.
      --   S        Pins or unpins the current family, unless a text box has the focus.
      --   C        Toggles Compare, unless a text box has the focus.
      --
      -- Actions are deferred so that the window isn't freed during the scene's key dispatch.

      &viewport.tabOrder = 1
      &viewport.mtSubscribeKeyboard(function(Viewport:obj!, Qualifiers:num!, Value:num!, Unicode)
         if &finished or not (Qualifiers has KQ_PRESSED) or (Qualifiers has KQ_REPEAT) then return end

         plain = not (Qualifiers has (KQ_CTRL | KQ_ALT | KQ_COMMAND))

         if (Value is KEY_F) and (Qualifiers has KQ_CTRL) then
            processing.delayedCall(function() &fontList?.focusSearch() end)
         elseif Value is KEY_ESCAPE then
            if &fontList and &fontList.presets.menu?.visible then return end
            if &effects and &effects.blend.menu?.visible then return end
            processing.delayedCall(function() &cancel() end)
         elseif &isTyping then
            return
         elseif (Value is KEY_ENTER) or (Value is KEY_NP_ENTER) then
            processing.delayedCall(function() &apply() end)
         elseif (Value is KEY_S) and plain then
            font = &state.font
            processing.delayedCall(function() &fontList?.togglePin(font) end)
         elseif (Value is KEY_C) and plain then
            processing.delayedCall(function() &preview?.toggleCompare() end)
         end
      end)

      &refresh('init')
      assignStackColumns()
      &layoutRight()

      -- The window's zoom keys change the scale (see setScale()) rather than the window's view box.

      &window.zoomIn    = function[<weak> &&]() setScale(&window.surface.width * ZOOM_STEP / client_width) end
      &window.zoomOut   = function[<weak> &&]() setScale(&window.surface.width / ZOOM_STEP / client_width) end
      &window.resetZoom = function[<weak> &&]() setScale(1) end

      &window.surface.subscribe('redimension', function[<weak> &&]() &fit() end)

      -- Fit the window to the monitor: the width by scaling the layout down, and the height by reflowing it.  A dialog
      -- that only has small panels opens at the height of its content.

      preferred = CLIENT_HEIGHT
      if plan.stack and not (enabled.list or enabled.preview) then
         preferred = math.clamp(&rightPage.height, plan.minBody, BODY_HEIGHT) + FOOTER_HEIGHT
      end

      monitor_width, monitor_height = &window.parentSize()
      scale = 1
      height = preferred
      if (monitor_width ?? 0) > 0 then scale = math.min(1, monitor_width * SCREEN_FILL / client_width) end
      height *= scale
      if (monitor_height ?? 0) > 0 then height = math.min(height, monitor_height * SCREEN_FILL) end
      if (scale < 1) or (height != CLIENT_HEIGHT) then
         &window.resizeClientArea(math.floor(client_width * scale), math.floor(height))
      end
      &fit()

      &window.moveToFront()
      &window.show(true)
      &viewport.acFocus() -- A no-op if the window hasn't gained the focus yet: tabOrder then selects the viewport

      gui.dialog.active[&&] = true
      ready = true
      return &&
   end
end

----------------------------------------------------------------------------------------------------------------------
-- This sub-routine is provided for languages other than Tiri to use the interface.  Options are passed as script keys
-- and the window ID is returned.  The outcome is written back to the script's keys before the window closes:
-- 'response' is 'select' or 'cancel', and on Select 'face', 'style', 'size' (px), 'pointSize', 'fill', 'fontFeatures'
-- and 'fontDef' describe the font.  'fontDef' is the string equivalent of the Tiri result's settings table.

@if(imported=false)
   script = obj.find('self')
   modal = arg('modal')
   features = arg('features')

   dlg = gui.dialog.font({
      face      = arg('face'),
      size      = arg('size'),
      style     = arg('style'),
      fill      = arg('fill'),
      example   = arg('example'),
      bkgd      = arg('bkgd'),
      fontDef   = arg('fontDef'),
      title     = arg('title'),
      icon      = arg('icon'),
      theme     = arg('theme'),
      modal     = (modal is '1') or (modal is 'true'),
      features  = (features??) ? features.split(',').map(N => N.trim()) : nil,
      popOver   = tonumber(arg('popOver')),
      feedback  = function(Result:table)
         if Result then
            script.setKey('face', Result.face)
            script.setKey('style', Result.style)
            script.setKey('size', tostring(Result.size))
            script.setKey('pointSize', tostring(Result.pointSize))
            script.setKey('fill', Result.fill)
            script.setKey('fontFeatures', Result.fontFeatures)
            script.setKey('fontDef', Result.fontDef)
         end
         script.setKey('response', Result ? 'select' : 'cancel')
      end
   })

   return dlg.window.surface.id
@end
