@Package(name="gui/toggle", version="1.0")

--[[
The gui.toggle API creates and manages toggles in the user interface.

Documentation is available in the Kotuku Wiki.
--]]

   import 'gui', 'gui/layout'

   namespace gui

FONT_MAX_HEIGHT = gui.getFontHeight(gui.fonts.widget)
DEFAULT_HEIGHT <const> = math.floor(FONT_MAX_HEIGHT * 1.35) + 1 -- Matches the combobox and input

function toggleState()
   if &disabled then return end
   &setState(not &value)
   &events.activate?()
end

gui.toggle = function(Options:table!):table
   assert(Options.value is nil or Options.value is <bool> or Options.value is 0 or Options.value is 1,
      'Toggle value must be a boolean or 0/1.')

   self = entity { -- Public interface
      disabled       = false,
      events         = Options.events ?? { },
      label          = Options.label,
      labelPos       = Options.labelPos ?? 'right',
      labelAlign     = Options.labelAlign ?? 'left',
      labelWidth     = Options.labelWidth, -- Slot breadth for side labels; defaults to the label's own breadth
      parentViewport = Options.target,
      labelText      = nil, -- A VectorText that represents the label
      value          = Options.value is true or Options.value is 1,
      viewport       = nil, -- The toggle's primary viewport
   }

   -- Update the displayed state without reporting a user activation.  Disabled toggles can still be updated.

   self.setState = function(State:bool!)
      &value = State
      &iconRender.opacity = State ? 1.0 : 0.25
      &viewport.acDraw()
   end

   -- Change the active state of the toggle to disabled or enabled

   -- The applied theme is layered as base <- Options.theme <- the override from setTheme().  It is rebuilt whenever
   -- the base theme or the override changes.

   base_theme = gui.getTheme(Options.target)
   override = nil -- Per-instance override from setTheme()

   function buildTheme():table
      result = base_theme
      if Options.theme then result = table.merge(result, Options.theme, true, true) end
      if override then result = table.merge(result, override, true, true) end
      return result
   end

   -- Compose the box style from the current focus and disabled states.  Focus styling is suppressed while the toggle
   -- is disabled.

   function refreshStyle()
      gui.applyStyle(&bkgd, &theme.input.bkgd)
      if &disabled then
         gui.applyStyle(&bkgd, &theme.input.disabled)
      elseif &_focus then
         gui.applyStyle(&bkgd, &theme.input.focus)
      end
   end

   self.disable = function()
      &disabled = true
      &viewport.acDisable()
      refreshStyle()
      &events.disable?()
      &viewport.acDraw()
   end

   self.enable = function()
      &disabled = false
      &viewport.acEnable()
      refreshStyle()
      &events.enable?()
      &viewport.acDraw()
   end

   -- Main entry point --

   using self do
      assert(Options.target, 'A target viewport is required.')
      gui.layout.checkLabel(&labelPos, &labelWidth, &labelAlign)
      &theme = buildTheme()

      vps = { -- Viewport settings
         x        = Options.x,
         y        = Options.y,
         width    = Options.width,
         height   = Options.height ?? DEFAULT_HEIGHT,
         xOffset  = Options.xOffset,
         yOffset  = Options.yOffset
      }

      calc_width = false
      if not vps.x and not vps.xOffset then vps.x = 0 end
      if not vps.y and not vps.yOffset then vps.y = 0 end
      if not vps.width and not (vps.xOffset and vps.x) then
         vps.width = vps.height
         calc_width = true
      end

      &viewport = &parentViewport.new('VectorViewport', vps)

      -- The box and label are packed together from the start of the widget, so any further width is clickable space
      -- that does not move them.  The box is a square of the height that remains after a stacked label, and the
      -- icon scales with it.

      box = { x = 0, y = 0, xOffset = 0, yOffset = 0 }

      if &label then
         &_label = gui.layout.label(&viewport, {
            string = &label, pos = &labelPos, align = &labelAlign, width = &labelWidth, style = &theme.window.text
         })
         &labelText = &_label.text
         &_label.reserve(box)

         if &_label.stacked and not Options.height then &viewport.height += &_label.size end
      end

      HEIGHT    <const> = &viewport.height - box.y - box.yOffset
      ICON_SIZE <const> = math.round(HEIGHT * 0.56)

      if &_label then
         packed_width, _ = &_label.expand(HEIGHT, HEIGHT)
         if calc_width then &viewport.width = packed_width end
         &_label.place(packed_width, &viewport.height, box.y, HEIGHT)
      end

      &bkgd = &viewport.new('VectorRectangle', table.merge({
         x = box.x, y = box.y, width = HEIGHT, height = HEIGHT
      }, &theme.input.bkgd))

      -- Returns the placement of the checkmark viewport, with the pattern in the current text colour.  The fill is
      -- painted with padding around the icon's pattern tile, see gui.createIcon().

      function checkmark():table
         icon_theme = gui.rgbToIconTheme(&theme.input.text.fill)
         icon = gui.createIcon(&viewport.scene, 'items/checkmark', ICON_SIZE, icon_theme)
         return {
            x      = box.x + math.floor((HEIGHT - ICON_SIZE) * 0.5) - icon.margin,
            y      = box.y + math.floor((HEIGHT - ICON_SIZE) * 0.5) - icon.margin,
            width  = ICON_SIZE + (icon.margin * 2),
            height = ICON_SIZE + (icon.margin * 2),
            fill   = icon.fill
         }
      end

      &iconRender = &viewport.new('VectorViewport', table.merge({ opacity = &value ? 1.0 : 0.25 }, checkmark()))

      -- Apply the current theme to the existing vectors.

      function restyle()
         refreshStyle()
         if &labelText and &theme.window.text.fill then &labelText.fill = &theme.window.text.fill end

         try
            gui.applyStyle(&iconRender, checkmark())
         except e
            msg(f'Failed to restyle toggle icon: {e.message}')
         end

         &viewport.acDraw()
      end

      -- Style this toggle instance.  Override is merged over the complete theme, as for Options.theme, and is kept
      -- when the window theme changes.  Each call replaces the previous override; nil removes it.

      &setTheme = function(Override:table)
         override = Override
         &theme = buildTheme()
         restyle()
      end

      -- Called by gui.broadcastTheme() with the window's new theme.

      &applyTheme = function(Theme:table!)
         base_theme = Theme
         &theme = buildTheme()
         restyle()
      end

      &viewport.mtSubscribeFeedback(FM_HAS_FOCUS|FM_CHILD_HAS_FOCUS|FM_LOST_FOCUS, function(Viewport, Event)
         if Event is FM_LOST_FOCUS then
            &_focus = false
            refreshStyle()
            &events.lostFocus?()
         else
            &_focus = true
            refreshStyle()
            if not &disabled then &events.focus?() end
         end

         Viewport.acDraw()
      end)

      &viewport.mtSubscribeKeyboard(function(Viewport, Qualifiers, Value, Unicode)
         if not (Qualifiers has KQ_PRESSED) then return end

         if (Value is KEY_ENTER) or (Value is KEY_SPACE) or (Value is KEY_NP_ENTER) then
            toggleState()
         end
      end)

      &viewport.mtSubscribeInput(JTYPE_BUTTON, function(Viewport, Msg)
         repeat
            if Msg.type is JET_LMB and Msg.value > 0 then
               toggleState()
            end
            Msg = Msg.next
         until not Msg
      end)

      gui.registerWidget(&viewport, &&)

      if Options.disabled then &disable() end
      &events.show?()

      return &&
   end
end
