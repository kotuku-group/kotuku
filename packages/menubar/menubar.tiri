@Package(name="gui/menubar", version="1.0")

--[[
Documentation is available in the Kotuku Wiki.
--]]

   import 'gui', 'gui/menu'

   include 'vector'

   namespace gui

VMARGIN   = gui.sizing.widget.margin
GAP       <const> = 26
ICON_SIZE <const> = 12

function selectable(Item:table):bool
   return Item and not Item.disabled
end

function hasMenu(Item:table):bool
   return Item and ((Item.prepare != nil) or (Item.menuItems and (#Item.menuItems > 0)))
end

function itemMenu(Item:table!):table
   menu = Item.menu
   if not menu then
      menu = gui.menu({
         hostScene = &viewport.scene,
         relative  = &viewport,
         x         = Item.x,
         y         = &viewport.height - 2,
         items     = Item.menuItems,
         prepare   = Item.prepare,
         theme     = &theme.menu
      })
      Item.menu = menu
   end

   return menu
end

function findShortcut(Qualifiers:num!, Code:num!, Unicode:num):<table, array<table>>
   if &_disabled then return nil end
   item = &_first
   while item do
      if selectable(item) and hasMenu(item) then
         path = gui.findMenuShortcut(item.menu ? item.menu.items : item.menuItems, Qualifiers, Code, Unicode)
         if path then return item, path end
      end
      item = item.next
   end
end

function showItemMenu(Item:table!, Hover:bool) -- Open an item's menu, switching away from any previously open menu.
   if not selectable(Item) or not hasMenu(Item) then return false end
   if not Hover then Item?.callback(Item.id, Item.name) end

   menu = itemMenu(Item)
   menu.x = Item.x

   if &_lastMenu and &_lastMenu != menu then
      &_lastMenu.hide()
   end

   menu.show()
   &_lastMenu = menu
   return true
end

function activateItem() -- Activate the current menu item.
   item = &_currentItem
   if &_disabled or not selectable(item) then return false end

   if hasMenu(item) then
      if item.menu?.visible then
         item.menu.hide()
         &_lastMenu = nil
      else
         showItemMenu(item)
      end
   else
      item?.callback(item.id, item.name)
      &_lastMenu?.hide()
      &_lastMenu = nil
   end
   return true
end

function firstItem():table -- Return the first item
   item = &_first
   while item and not selectable(item) do item = item.next end
   return item
end

function lastItem():table -- Return the last item
   item = &_last
   while item and not selectable(item) do item = item.prev end
   return item
end

function adjacentItem(Item:table, Direction:num!):table
   scan = Direction < 0 ? Item?.prev : Item?.next
   while scan and not selectable(scan) do scan = Direction < 0 ? scan.prev : scan.next end
   return scan ?? (Direction < 0 ? lastItem() : firstItem())
end

function newItem(Name, ID) -- Append an item to the menu bar
   if ID and &_lookup[ID] then raise f'An item with identifier {ID} already exists.' end

   item = { id=ID, name=Name }
   if Name?? then
      item.displayName = Name
   end

   if &_last then &_last.next = item end
   item.prev = &_last
   item.next = nil
   &_last = item
   if not &_first then &_first = item end

   if ID then &_lookup[ID] = item end
   return item
end

function getCursorItem(X, Y):table
   item = &_first
   while item do
      if (X >= item.x) and (X <  item.x + item.width) and (Y >= item.y) and (Y <  item.y + item.height) then
         return item
      end
      item = item.next
   end
end

-- While the menubar has the focus, its bottom edge is highlighted

function updateFocusEdge()
   if not &_focusEdge then return end
   show = &_hasFocus and (not &_disabled)
   &_focusEdge.visibility = show ? 'visible' : 'hidden'
end

function hideHighlight()
   &_highlight.visibility = 'hidden'
   updateFocusEdge()
end

-- Highlight selected item (for keyboard item selection)

function highlightItem(Item)
   if not selectable(Item) then return end

   &_currentItem = Item

   &_highlight.{
      x          = Item.x,
      y          = 0,
      width      = Item.width,
      height     = &viewport.height,
      visibility = 'visible'
   }

   updateFocusEdge()
   &viewport.acDraw()
end

-- Reserve first capitals before assigning fallback letters, so conflicts cannot steal another item's first choice.
function assignMnemonics()
   &_mnemonics = { }
   item = &_first
   while item do
      item.mnemonic = nil
      item._mnemonicStart = 0
      name = item.displayName ?? ''
      for i in {0 to #name} do
         byte = name.byte(i)
         if byte >= 65 and byte <= 90 then
            letter = name.sub(i, i + 1)
            item._mnemonicStart = i + 1
            if not &_mnemonics[letter] then
               item.mnemonic = letter
               &_mnemonics[letter] = item
            end
            break
         end
      end
      item = item.next
   end

   item = &_first
   while item do
      name = item.displayName ?? ''
      if not item.mnemonic then
         for offset in {0 to #name} do
            index = (item._mnemonicStart + offset) % #name
            letter = name.sub(index, index + 1).upper()
            byte = letter.byte()
            if byte >= 65 and byte <= 90 and not &_mnemonics[letter] then
               item.mnemonic = letter
               &_mnemonics[letter] = item
               break
            end
         end
      end
      item = item.next
   end
end

function arrangeItems()
   assignMnemonics()
   &_vg?.free()

   &_vg = &viewport.new('VectorGroup', { name='ItemGroup' })

   item = &_first
   x = 0
   y = 0
   while item do
      item.x        = x
      item.y        = y
      item.width    = ICON_SIZE + (VMARGIN * 2)
      item.height   = ICON_SIZE + (VMARGIN * 2)
      item.gfxWidth = item.width

      iconWidth = 0
      if item.icon then
         iconWidth = ICON_SIZE + VMARGIN
         item.icon.x = x + VMARGIN - item.iconMargin
         item.icon.y = y + VMARGIN - item.iconMargin
         item.icon.opacity = (&_disabled or item.disabled) ? 0.5 : 1
      end

      if item.displayName?? then
         item.vectorText = &_vg.new('VectorText', table.merge({
            x        = x + iconWidth + VMARGIN,
            face     = gui.fonts.menu.face,
            fontSize = string.format('%.2fpt', gui.fonts.menu.size),
            string   = item.displayName
         }, &theme.text))

         err, bx, by, bw, bh = item.vectorText.mtGetBoundary(0)
         item.gfxWidth = iconWidth + bw + (VMARGIN * 2)
         item.width = item.gfxWidth + GAP
         item.vectorText.y = math.floor((&viewport.height + item.vectorText.displaySize) * 0.5)

         item.vectorText.opacity = (&_disabled or item.disabled) ? 0.5 : 1
      else
         item.vectorText = nil
      end

      x += item.width

      item = item.next
   end

   &_arranged = true
   &viewport.acDraw()
end

gui.menubar = function(Options:table)
   self = entity { -- Public interface
      host      = nil,
      viewport  = nil,
      _lookup   = { },
      _disabled = false,
      _arranged = false
   }

   -- Add a clickable item to the menubar.  The Name acts as the item text that is displayed in the menubar if no
   -- icon can be displayed.  The icon string must be in the standard format of 'category/icon'.

   self.addItem = function(ID, Name, Icon, Function, Menu, Prepare:func)
      item = newItem(Name, ID)
      item.callback = Function
      if Prepare and Menu is nil then Menu = array<table> end
      item.menuItems = Menu
      item.prepare = Prepare

      if Icon then
         icon = gui.createIcon(&viewport.scene, Icon, ICON_SIZE, gui.rgbToIconTheme(&theme.text.fill))

         item.iconMargin = icon.margin
         item.icon = &viewport.new('VectorRectangle', {
            x=0, y=0, width=ICON_SIZE + (icon.margin * 2), height=ICON_SIZE + (icon.margin * 2), fill = icon.fill
         })
      end

      &_arranged = false
      if &_ready then arrangeItems() end
      return item
   end

   self.removeItem = function(ID):bool
      item = &_lookup[ID]
      if not item then return false end

      if item.prev then item.prev.next = item.next else &_first = item.next end
      if item.next then item.next.prev = item.prev else &_last = item.prev end
      &_lookup[ID] = nil

      item.menu?.surface?.free()
      item.icon?.free()
      if &_currentItem is item then
         &_currentItem = nil
         hideHighlight()
      end

      if &_lastMenu and &_lastMenu is item.menu then
         &_lastMenu = nil
      end

      arrangeItems()
      return true
   end

   self.setItemLabel = function(ID, Label:str):bool
      item = &_lookup[ID]
      if not item then return false end
      item.name = Label
      item.displayName = Label
      arrangeItems()
      return true
   end

   self.arrange = function()
      arrangeItems()
   end

   -- Individual menubar items can be disabled with this method.  Reverse this action with enableItem().

   self.disableItem = function(ID)
      item = &_lookup[ID]
      if item and (not item.disabled) then
         item.disabled = true
         if &_currentItem is item then
            &_currentItem = nil
            hideHighlight()
         end

         if &_lastMenu and &_lastMenu is item.menu then
            &_lastMenu.hide()
            &_lastMenu = nil
         end

         arrangeItems()
      end
   end

   -- Items that have been disabled can be re-enabled by calling this method.

   self.enableItem = function(ID)
      item = &_lookup[ID]
      if item and item.disabled then
         item.disabled = false
         arrangeItems()
      end
   end

   function hoverUpdate(Item, StateChanged) -- Highlight items that the user hovers over.
      -- While focused, an existing selection survives hovering over empty space.  Without one, the focus edge is shown.

      if &_hasFocus and not &_disabled and not selectable(Item) then
         Item = selectable(&_currentItem) ? &_currentItem : nil
      end

      if (&_currentItem is Item) and (StateChanged != true) then return end

      open_menu = &_lastMenu?.visible
      hideHighlight()
      &_currentItem = Item

      if &_currentItem and (not &_currentItem.disabled) and (not &_disabled) then
         highlightItem(&_currentItem)
         &_prevItem = &_currentItem
         if open_menu and &_currentItem.menu != &_lastMenu then
            if hasMenu(&_currentItem) then
               showItemMenu(&_currentItem, true)
            else
               &_lastMenu.hide()
               &_lastMenu = nil
            end
         end
      end

      &viewport.acDraw()
   end

   -- Main entry point

   using self do
      try
         assert(Options.target, 'A target viewport is required.')

         &theme = gui.getTheme(Options.target).menubar
         &viewport = Options.target.new('vectorviewport')
         &viewport.x      = Options.x ?? 0
         &viewport.y      = Options.y ?? 0
         &viewport.height = 1
         &viewport.xOffset = Options.xOffset ?? 0

         &viewport.init()

         &viewport.subscribe('free', function(Viewport, Args)
            &_shortcutKeyboard?.unsubscribe()
            &_shortcutKeyboard = nil
            &_mnemonics = nil

            item = &_first
            while item do
               next_item = item.next
               item.menu?.surface?.free()
               item.prev = nil
               item.next = nil
               item = next_item
            end

            &_first = nil
            &_last = nil
            &_currentItem = nil
            &_lastMenu = nil
            &viewport = nil
         end)

         &viewport.mtSubscribeFeedback(FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS, function(Viewport, Event)
            if Event is FM_LOST_FOCUS then
               &_hasFocus = false
               hideHighlight()
               &_lastMenu?.hide()
            else
               &_hasFocus = true
               if &_ready and not &_disabled and selectable(&_currentItem) then
                  highlightItem(&_currentItem) -- Restore the existing selection
               else
                  updateFocusEdge()
               end
            end

            &viewport.acDraw()
         end)

         &enable = function()
            &_disabled = false
            updateFocusEdge()
            arrangeItems()
         end

         &disable = function()
            &_disabled = true
            &_lastMenu?.hide()
            &_lastMenu = nil
            hideHighlight()
            arrangeItems()
         end

         &viewport.mtSubscribeInput(JTYPE_BUTTON | JTYPE_MOVEMENT | JTYPE_CROSSING, function(Viewport, Events)
            ev = Events
            while ev do
               if ev.type is JET_CROSSED_IN then

               elseif ev.type is JET_CROSSED_OUT then
                  if &_currentItem and not &_lastMenu?.visible then
                     &_currentItem = nil
                     hideHighlight()
                     &viewport.acDraw()
                  end
               elseif ev.flags has JTYPE_MOVEMENT then
                  if &_clicked then return end

                  item = getCursorItem(ev.x, ev.y)

                  hoverUpdate(item)
               elseif ev.flags has JTYPE_BUTTON then
                  if ev.type != JET_BUTTON_1 then return end

                  if ev.value != 0 then
                     item = getCursorItem(ev.x, ev.y)
                     if selectable(item) and not &_disabled then
                        &_clicked = item
                        highlightItem(item)
                        activateItem()
                     end
                  elseif &_clicked then
                     &_clicked = nil

                     hoverUpdate(&_currentItem, true)
                  end
               end

               ev = ev.next
            end
         end)

         function keyboardInput(Qualifiers, Code, Unicode)
            if &_disabled then return end

            if Qualifiers has KQ_PRESSED then
               if (Code is KEY_SPACE) and &_lastMenu?.visible and not &_lastMenu.hItem then
                  &_lastMenu.hide()
                  &_lastMenu = nil
                  return
               end

               if &_lastMenu?.visible then
                  if &_lastMenu.handleKey(Qualifiers, Code) then return end
                  if Code is KEY_UP then
                     &_lastMenu.hide()
                     &_lastMenu = nil
                     &viewport.acFocus()
                     highlightItem(&_currentItem)
                     return
                  end
               end

               if (Code is KEY_L_ALT) or (Code is KEY_R_ALT) then
                  item = firstItem()
                  if item then highlightItem(item) end
               elseif (Code is KEY_ENTER) or (Code is KEY_NP_ENTER) or (Code is KEY_SPACE) or (Code is KEY_DOWN) then
                  activateItem()
               elseif (Code is KEY_UP) or (Code is KEY_LEFT) then
                  if &_currentItem then
                     scan = adjacentItem(&_currentItem, -1)
                     highlightItem(scan)
                     if &_lastMenu?.visible then
                        showItemMenu(scan)
                     end
                  else
                     highlightItem(firstItem())
                  end
               elseif Code is KEY_RIGHT then
                  if &_currentItem then
                     scan = adjacentItem(&_currentItem, 1)
                     highlightItem(scan)
                     if &_lastMenu?.visible then
                        showItemMenu(scan)
                     end
                  else
                     highlightItem(firstItem())
                  end
               end
            end
         end

         -- Keep the viewport in vector focus traversal; the window listener handles each key exactly once.
         &viewport.mtSubscribeKeyboard(function() end)

         &_bkgd = &viewport.new('VectorGroup', { name='ItemBackground' })

         Options.createItems(&&)

         &viewport.height = ICON_SIZE + (VMARGIN * 2)

         &_bkgd.new('VectorRectangle', table.merge({ -- Main background
            fill = 'none', x = 0, y = 0, width  = '100%', height = &viewport.height
         }, &theme.bkgd))

         &_highlight = &_bkgd.new('VectorRectangle', table.merge({ -- Highlight for items
            fill = 'none', x = 0, y = 0, width = 1, height = &viewport.height - 1,
            visibility = 'hidden'
         }, &theme.highlight))

         &_focusEdge = &_bkgd.new('VectorRectangle', table.merge({ -- Focus indicator
            fill = 'none', x = 0, y = &viewport.height - 2, width = '100%', height = 2,
            visibility = 'hidden'
         }, &theme.focus ? &theme.focus : &theme.highlight))

         arrangeItems()
         &_ready = true
         updateFocusEdge()

         &_shortcutKeyboard = input.keyboard(&viewport.scene.surface,
            function(Handle, SurfaceID, Qualifiers, Code, Unicode)
               if &_disabled or not (Qualifiers has KQ_PRESSED) then return end

               if not (&viewport.scene.surface.flags has RNF_HAS_FOCUS) then return end

               if (Qualifiers has KQ_L_ALT) and not (Qualifiers has (KQ_CTRL | KQ_SHIFT | KQ_COMMAND)) and
                  Code >= KEY_A and Code <= KEY_Z then
                  letter = string.char(65 + Code - KEY_A)
                  item = &_mnemonics[letter]
                  if item then
                     -- Reserve assigned mnemonics even while disabled, keeping other bindings predictable.
                     if not selectable(item) then return end
                     if &viewport.acFocus() != ERR_Okay then return end
                     highlightItem(item)

                     if hasMenu(item) then
                        showItemMenu(item)
                     else
                        activateItem()
                     end

                     return
                  end
               end

               if (Code != KEY_F10) or (Qualifiers has (KQ_CTRL | KQ_SHIFT | KQ_ALT | KQ_COMMAND)) then
                  item, path = findShortcut(Qualifiers, Code, Unicode)
                  if item and itemMenu(item).activateShortcut(path) then
                     &_lastMenu?.hide()
                     &_lastMenu = nil
                  elseif not item and &_hasFocus then
                     keyboardInput(Qualifiers, Code, Unicode)
                  end
                  return
               end

               item = firstItem()
               item ?! return

               if &viewport.acFocus() != ERR_Okay then return end

               &_lastMenu?.hide()
               &_lastMenu = nil
               highlightItem(item)
            end)
      except ex
         print(ex.message)
      end

      return &&
   end
end
