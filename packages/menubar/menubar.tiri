@Package(name="gui/menubar", version="1.0")

--[[
Documentation is available in the Kotuku Wiki.
--]]

   import 'gui', 'gui/menu'

   include 'vector'

   namespace gui

VMARGIN   = gui.sizing.widget.margin
GAP       <const> = 26
ICON_SIZE <const> = 12

function selectable(Item:table):bool
   return Item and not Item.disabled
end

function hasMenu(Item:table):bool
   return Item and ((Item.prepare != nil) or (Item.menuConfig and (#Item.menuConfig > 0)))
end

function itemMenu(self, Item:table!):table
   menu = Item.menu
   if not menu then
      menu = gui.menu({
         hostScene = self.viewport.scene,
         relative  = self.viewport,
         x         = Item.x,
         y         = self.viewport.height - 2,
         config    = Item.menuConfig,
         prepare   = Item.prepare,
         theme     = self.theme.menu
      })
      Item.menu = menu
   end

   return menu
end

function findShortcut(self, Qualifiers:num!, Code:num!, Unicode:num):<table, array<table>>
   if self._disabled then return nil end
   item = self._first
   while item do
      if selectable(item) and hasMenu(item) then
         path = gui.findMenuShortcut(item.menu ? item.menu.config : item.menuConfig, Qualifiers, Code, Unicode)
         if path then return item, path end
      end
      item = item.next
   end
end

function showItemMenu(self, Item:table!, Hover:bool) -- Open an item's menu, switching away from any previously open menu.
   if not selectable(Item) or not hasMenu(Item) then return false end
   if not Hover then Item?.callback(Item.id, Item.name) end

   menu = itemMenu(self, Item)
   menu.x = Item.x

   if self._lastMenu and self._lastMenu != menu then
      self._lastMenu.hide()
   end

   menu.show()
   self._lastMenu = menu
   return true
end

function activateItem(self) -- Activate the current menu item.
   item = self._currentItem
   if self._disabled or not selectable(item) then return false end

   if hasMenu(item) then
      if item.menu?.visible then
         item.menu.hide()
         self._lastMenu = nil
      else
         showItemMenu(self, item)
      end
   else
      item?.callback(item.id, item.name)
      self._lastMenu?.hide()
      self._lastMenu = nil
   end
   return true
end

function firstItem(self):table -- Return the first item
   item = self._first
   while item and not selectable(item) do item = item.next end
   return item
end

function lastItem(self):table -- Return the last item
   item = self._last
   while item and not selectable(item) do item = item.prev end
   return item
end

function adjacentItem(self, Item:table, Direction:num!):table
   scan = Direction < 0 ? Item?.prev : Item?.next
   while scan and not selectable(scan) do scan = Direction < 0 ? scan.prev : scan.next end
   return scan ?? (Direction < 0 ? lastItem(self) : firstItem(self))
end

function newItem(self, Name, ID) -- Append an item to the menu bar
   if ID and self._lookup[ID] then raise f'An item with identifier {ID} already exists.' end

   item = { id=ID, name=Name }
   if Name?? then
      item.displayName = Name
   end

   if self._last then self._last.next = item end
   item.prev = self._last
   item.next = nil
   self._last = item
   if not self._first then self._first = item end

   if ID then self._lookup[ID] = item end
   return item
end

function getCursorItem(self, X, Y):table
   item = self._first
   while item do
      if (X >= item.x) and (X <  item.x + item.width) and (Y >= item.y) and (Y <  item.y + item.height) then
         return item
      end
      item = item.next
   end
end

-- Highlight selected item (for keyboard item selection)

function highlightItem(self, Item)
   if not selectable(Item) then return end
   self._currentItem = Item

   self._highlight.x          = Item.x
   self._highlight.y          = 0
   self._highlight.width      = Item.width
   self._highlight.height     = self.viewport.height
   self._highlight.visibility = 'visible'

   self.viewport.acDraw()
end

-- Reserve first capitals before assigning fallback letters, so conflicts cannot steal another item's first choice.
function assignMnemonics(self)
   self._mnemonics = { }
   item = self._first
   while item do
      item.mnemonic = nil
      item._mnemonicStart = 0
      name = item.displayName ?? ''
      for i in {0 to #name} do
         byte = name.byte(i)
         if byte >= 65 and byte <= 90 then
            letter = name.sub(i, i + 1)
            item._mnemonicStart = i + 1
            if not self._mnemonics[letter] then
               item.mnemonic = letter
               self._mnemonics[letter] = item
            end
            break
         end
      end
      item = item.next
   end

   item = self._first
   while item do
      name = item.displayName ?? ''
      if not item.mnemonic then
         for offset in {0 to #name} do
            index = (item._mnemonicStart + offset) % #name
            letter = name.sub(index, index + 1).upper()
            byte = letter.byte()
            if byte >= 65 and byte <= 90 and not self._mnemonics[letter] then
               item.mnemonic = letter
               self._mnemonics[letter] = item
               break
            end
         end
      end
      item = item.next
   end
end

function arrangeItems(self)
   assignMnemonics(self)
   self._vg?.free()

   self._vg = self.viewport.new('VectorGroup', { name='ItemGroup' })

   item = self._first
   x = 0
   y = 0
   while item do
      item.x        = x
      item.y        = y
      item.width    = ICON_SIZE + (VMARGIN * 2)
      item.height   = ICON_SIZE + (VMARGIN * 2)
      item.gfxWidth = item.width

      iconWidth = 0
      if item.icon then
         iconWidth = ICON_SIZE + VMARGIN
         item.icon.x = x + VMARGIN
         item.icon.y = y + VMARGIN
         item.icon.opacity = (self._disabled or item.disabled) ? 0.5 : 1
      end

      if item.displayName?? then
         item.vectorText = self._vg.new('VectorText', table.merge({
            x        = x + iconWidth + VMARGIN,
            face     = gui.fonts.menu.face,
            fontSize = string.format('%.2fpt', gui.fonts.menu.size),
            string   = item.displayName
         }, self.theme.text))

         err, bx, by, bw, bh = item.vectorText.mtGetBoundary(0)
         item.gfxWidth = iconWidth + bw + (VMARGIN * 2)
         item.width = item.gfxWidth + GAP
         item.vectorText.y = math.floor((self.viewport.height + item.vectorText.displaySize) * 0.5)

         item.vectorText.opacity = (self._disabled or item.disabled) ? 0.5 : 1
      else
         item.vectorText = nil
      end

      x += item.width

      item = item.next
   end

   self._arranged = true
   self.viewport.acDraw()
end

gui.menubar = function(Options:table)
   self = entity { -- Public interface
      host      = nil,
      viewport  = nil,
      _lookup   = { },
      _disabled = false,
      _arranged = false
   }

   -- Add a clickable item to the menubar.  The Name acts as the item text that is displayed in the menubar if no
   -- icon can be displayed.  The icon string must be in the standard format of 'category/icon'.

   self.addItem = function(ID, Name, Icon, Function, Menu, Prepare:func)
      item = newItem(self, Name, ID)
      item.callback = Function
      if Prepare and Menu is nil then Menu = array<table> end
      item.menuConfig = Menu
      item.prepare = Prepare

      if Icon then
         icon = gui.createIcon(self.viewport.scene, Icon, ICON_SIZE, gui.rgbToIconTheme(self.theme.text.fill))

         item.icon = self.viewport.new('VectorRectangle', {
            x=0, y=0, width=ICON_SIZE, height=ICON_SIZE, fill = icon.fill
         })
      end

      self._arranged = false
      if self._ready then arrangeItems(self) end
      return item
   end

   self.removeItem = function(ID):bool
      item = self._lookup[ID]
      if not item then return false end

      if item.prev then item.prev.next = item.next else self._first = item.next end
      if item.next then item.next.prev = item.prev else self._last = item.prev end
      self._lookup[ID] = nil

      item.menu?.surface?.free()
      item.icon?.free()
      if self._currentItem is item then
         self._currentItem = nil
         self._highlight.visibility = 'hidden'
      end

      if self._lastMenu and self._lastMenu is item.menu then
         self._lastMenu = nil
      end

      arrangeItems(self)
      return true
   end

   self.setItemText = function(ID, Text:str):bool
      item = self._lookup[ID]
      if not item then return false end
      item.name = Text
      item.displayName = Text
      arrangeItems(self)
      return true
   end

   self.arrange = function()
      arrangeItems(self)
   end

   -- Individual menubar items can be disabled with this method.  Reverse this action with enableItem().

   self.disableItem = function(ID)
      item = self._lookup[ID]
      if item and (not item.disabled) then
         item.disabled = true
         if self._currentItem is item then
            self._currentItem = nil
            self._highlight.visibility = 'hidden'
         end

         if self._lastMenu and self._lastMenu is item.menu then
            self._lastMenu.hide()
            self._lastMenu = nil
         end

         arrangeItems(self)
      end
   end

   -- Items that have been disabled can be re-enabled by calling this method.

   self.enableItem = function(ID)
      item = self._lookup[ID]
      if item and item.disabled then
         item.disabled = false
         arrangeItems(self)
      end
   end

   function hoverUpdate(Item, StateChanged) -- Highlight items that the user hovers over.
      if self._hasFocus and not self._disabled and not selectable(Item) then
         Item = selectable(self._currentItem) ? self._currentItem : firstItem(self)
      end

      if (self._currentItem is Item) and (StateChanged != true) then return end

      open_menu = self._lastMenu?.visible
      self._highlight.visibility = 'hidden'
      self._currentItem = Item

      if self._currentItem and (not self._currentItem.disabled) and (not self._disabled) then
         highlightItem(self, self._currentItem)
         self._prevItem = self._currentItem
         if open_menu and self._currentItem.menu != self._lastMenu then
            if hasMenu(self._currentItem) then
               showItemMenu(self, self._currentItem, true)
            else
               self._lastMenu.hide()
               self._lastMenu = nil
            end
         end
      end

      self.viewport.acDraw()
   end

   -- Main entry point

   try
      assert(Options.target, 'A target viewport is required.')

      self.theme = gui.getTheme(Options.target).menubar
      self.viewport = Options.target.new('vectorviewport')
      self.viewport.x      = Options.x ?? 0
      self.viewport.y      = Options.y ?? 0
      self.viewport.height = 1
      self.viewport.xOffset = Options.xOffset ?? 0

      self.viewport.init()

      self.viewport.subscribe('free', function(Viewport, Args)
         self._shortcutKeyboard?.unsubscribe()
         self._shortcutKeyboard = nil
         self._mnemonics = nil

         item = self._first
         while item do
            next_item = item.next
            item.menu?.surface?.free()
            item.prev = nil
            item.next = nil
            item = next_item
         end

         self._first = nil
         self._last = nil
         self._currentItem = nil
         self._lastMenu = nil
         self.viewport = nil
      end)

      self.viewport.mtSubscribeFeedback(FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS, function(Viewport, Event)
         if Event is FM_LOST_FOCUS then
            self._hasFocus = false
            if self._currentItem then
               self._highlight.visibility = 'hidden' -- Turn off highlighting
            end

            self._lastMenu?.hide()
         else
            self._hasFocus = true
            if self._ready and not self._disabled then
               item = selectable(self._currentItem) ? self._currentItem : firstItem(self)
               highlightItem(self, item)
            end
         end

         self.viewport.acDraw()
      end)

      self.enable = function()
         self._disabled = false
         arrangeItems(self)
      end

      self.disable = function()
         self._disabled = true
         self._lastMenu?.hide()
         self._lastMenu = nil
         self._highlight.visibility = 'hidden'
         arrangeItems(self)
      end

      self.viewport.mtSubscribeInput(JTYPE_BUTTON | JTYPE_MOVEMENT | JTYPE_CROSSING, function(Viewport, Events)
         ev = Events
         while ev do
            if ev.type is JET_CROSSED_IN then

            elseif ev.type is JET_CROSSED_OUT then
               if self._currentItem and not self._lastMenu?.visible then
                  self._currentItem = nil
                  self._highlight.visibility = 'hidden'
                  self.viewport.acDraw()
               end
            elseif ev.flags has JTYPE_MOVEMENT then
               if self._clicked then return end

               item = getCursorItem(self, ev.x, ev.y)

               hoverUpdate(item)
            elseif ev.flags has JTYPE_BUTTON then
               if ev.type != JET_BUTTON_1 then return end

               if ev.value != 0 then
                  item = getCursorItem(self, ev.x, ev.y)
                  if selectable(item) and not self._disabled then
                     self._clicked = item
                     highlightItem(self, item)
                     activateItem(self)
                  end
               elseif self._clicked then
                  self._clicked = nil

                  hoverUpdate(self._currentItem, true)
               end
            end

            ev = ev.next
         end
      end)

      function keyboardInput(Qualifiers, Code, Unicode)
         if self._disabled then return end

         if Qualifiers has KQ_PRESSED then
            if (Code is KEY_SPACE) and self._lastMenu?.visible and not self._lastMenu.hItem then
               self._lastMenu.hide()
               self._lastMenu = nil
               return
            end

            if self._lastMenu?.visible then
               if self._lastMenu.handleKey(Qualifiers, Code) then return end
               if Code is KEY_UP then
                  self._lastMenu.hide()
                  self._lastMenu = nil
                  self.viewport.acFocus()
                  highlightItem(self, self._currentItem)
                  return
               end
            end

            if (Code is KEY_L_ALT) or (Code is KEY_R_ALT) then
               item = firstItem(self)
               if item then highlightItem(self, item) end
            elseif (Code is KEY_ENTER) or (Code is KEY_NP_ENTER) or (Code is KEY_SPACE) or (Code is KEY_DOWN) then
               activateItem(self)
            elseif (Code is KEY_UP) or (Code is KEY_LEFT) then
               if self._currentItem then
                  scan = adjacentItem(self, self._currentItem, -1)
                  highlightItem(self, scan)
                  if self._lastMenu?.visible then
                     showItemMenu(self, scan)
                  end
               else
                  highlightItem(self, firstItem(self))
               end
            elseif Code is KEY_RIGHT then
               if self._currentItem then
                  scan = adjacentItem(self, self._currentItem, 1)
                  highlightItem(self, scan)
                  if self._lastMenu?.visible then
                     showItemMenu(self, scan)
                  end
               else
                  highlightItem(self, firstItem(self))
               end
            end
         end
      end

      -- Keep the viewport in vector focus traversal; the window listener handles each key exactly once.
      self.viewport.mtSubscribeKeyboard(function() end)

      self._bkgd = self.viewport.new('VectorGroup', { name='ItemBackground' })

      Options.createItems(self)

      self.viewport.height = ICON_SIZE + (VMARGIN * 2)

      self._bkgd.new('VectorRectangle', table.merge({ -- Main background
         fill = 'none',
         x = 0, y = 0, width  = '100%', height = self.viewport.height
      }, self.theme.bkgd))

      self._highlight = self._bkgd.new('VectorRectangle', table.merge({ -- Highlight for items
         fill = 'none',
         x = 0, y = 0, width = 1, height = self.viewport.height - 1,
         visibility = 'hidden'
      }, self.theme.highlight))

      arrangeItems(self)
      self._ready = true
      if self._hasFocus and not self._disabled then
         highlightItem(self, firstItem(self))
      end

      self._shortcutKeyboard = input.keyboard(self.viewport.scene.surface,
         function(Handle, SurfaceID, Qualifiers, Code, Unicode)
            if self._disabled or not (Qualifiers has KQ_PRESSED) then return end

            if not (self.viewport.scene.surface.flags has RNF_HAS_FOCUS) then return end

            if (Qualifiers has KQ_L_ALT) and not (Qualifiers has (KQ_CTRL | KQ_SHIFT | KQ_COMMAND)) and
               Code >= KEY_A and Code <= KEY_Z then
               letter = string.char(65 + Code - KEY_A)
               item = self._mnemonics[letter]
               if item then
                  -- Reserve assigned mnemonics even while disabled, keeping other bindings predictable.
                  if not selectable(item) then return end
                  if self.viewport.acFocus() != ERR_Okay then return end
                  highlightItem(self, item)

                  if hasMenu(item) then
                     showItemMenu(self, item)
                  else
                     activateItem(self)
                  end

                  return
               end
            end

            if (Code != KEY_F10) or (Qualifiers has (KQ_CTRL | KQ_SHIFT | KQ_ALT | KQ_COMMAND)) then
               item, path = findShortcut(self, Qualifiers, Code, Unicode)
               if item and itemMenu(self, item).activateShortcut(path) then
                  self._lastMenu?.hide()
                  self._lastMenu = nil
               elseif not item and self._hasFocus then
                  keyboardInput(Qualifiers, Code, Unicode)
               end
               return
            end

            item = firstItem(self)
            if not item then return end
            if self.viewport.acFocus() != ERR_Okay then return end

            self._lastMenu?.hide()
            self._lastMenu = nil
            highlightItem(self, item)
         end)
   except ex
      print(ex.message)
   end

   return self
end
