@Package(name='gui/combobox', version='1.0')

--[[
The gui.combobox API creates and manages combobox boxes in the user interface.

Documentation is available in the Kotuku Wiki.
--]]

   import 'gui', 'gui/dropdown'

   namespace gui

FONT_MAX_HEIGHT, FONT_HEIGHT = gui.getFontHeight(gui.fonts.widget)
BOX_HEIGHT <const> = math.floor(FONT_MAX_HEIGHT * 1.35) + 1
MARGIN     <const> = math.floor(FONT_HEIGHT * 0.5) + 1

function iconTheme(Widget:table!):str
   colour = gui.strToRGB(Widget.theme.page.text)
   return colour.brightness() > 0.5 ? 'pearl' : 'default'
end

function reportFeedback()
   &events.activate ?! return
   text = &text.string
   hash = text ? string.hash(text) : 0
   if hash != &hash then
      &hash = hash
      &events.activate(&&, text)
   end
end

function toggleMenu()
   -- The boundary is in display coordinates and includes any scaling applied by parent viewports, so the menu is
   -- scaled to match the input box.

   err, bx, by, bw, bh = &inputViewport.mtGetBoundary(0)
   if err is ERR_Okay then
      &menu.x = bx
      &menu.y = by + bh
      if &inputViewport.width > 0 then &menu.scale = bw / &inputViewport.width end
   end

   if not &unlockMenuWidth then
      &menu.width = &inputViewport.width
   end

   if not &menu.visible then
      &_menuNavigated = false
      current = &text.string -- Read before the call, as arguments are evaluated in the menu's context
      &menu.highlightText(current)
   end

   &menu.toggle()
end

gui.combobox = function(Options)
   self = entity { -- Public interface
      events         = Options.events ?? { },
      label          = Options.label,
      parentViewport = Options.target,
      allowCustom    = Options.allowCustom,
      _menuNavigated = false,
      text           = nil, -- A VectorText that represents the string
      viewport       = nil  -- The primary viewport
   }

   -- Change the active state of the combobox box to disabled or enabled

   self.disable = function()
      &disabled = true
      &viewport.acDisable()
      &text.opacity = 0.5
      &bkgd.fill = &theme.page.bkgd
      &events?.disable(&&)
      &viewport.acDraw()
   end

   self.enable = function()
      &disabled = false
      &viewport.acEnable()
      &text.opacity = 1.0
      &bkgd.fill = &theme.page.bkgd
      &events?.enable(&&)
      &viewport.acDraw()
   end

   -- Main entry point --

   using self do
      assert(Options.target, 'A target viewport is required.')
      assert(Options.items and #Options.items > 0, 'A list of items is required.')

      &theme = gui.getTheme(&parentViewport)

      vps = { -- Viewport settings
         x       = Options.x,
         y       = Options.y,
         width   = Options.width,
         height  = BOX_HEIGHT,
         xOffset = Options.xOffset,
         yOffset = Options.yOffset
      }

      if not vps.x and not vps.xOffset then vps.x = 0 end
      if not vps.y and not vps.yOffset then vps.y = 0 end
      if not vps.width and not vps.xOffset then
         vps.width = gui.sizing.widget.width
         &unlockMenuWidth = true
      end

      &viewport = &parentViewport.new('VectorViewport', vps)

      &inputViewport = &viewport.new('VectorViewport', {
         x = 0,
         y = 0,
         width = &viewport.width,
         yOffset = 0,
         resizeEvent = function(Viewport:obj, Vector:obj, X:num, Y:num, Width:num, Height:num)
            new_width = Width - &labelSize
            if Vector.width != new_width then
               Vector.width = new_width
            end

            if Vector.height != Height then
               Vector.height = Height
            end
         end
      })

      if &label then
         &labelText = &viewport.new('VectorText', {
            name      = 'Label',
            x         = 0,
            y         = FONT_HEIGHT + math.floor((BOX_HEIGHT - FONT_HEIGHT) * 0.5),
            face      = gui.fonts.label.face,
            fontSize  = string.format('%.2fpt', gui.fonts.label.size),
            fontStyle = gui.fonts.label.style,
            fill      = &theme.window.text,
            string    = &label,
            lineLimit = 1
         })

         &labelSize = &labelText.textWidth + MARGIN
         &inputViewport.x = &labelText.x + &labelSize
         &inputViewport.width = &viewport.width - &labelSize
      else
         &labelSize = 0
      end

      &bkgd = &inputViewport.new('VectorRectangle', {
         fill = &theme.page.bkgd, x = 0, y = 0, width = '100%', height = '100%'
      })

      ICON_SIZE = FONT_HEIGHT
      down_icon = gui.createIcon(&viewport.scene, 'arrows/down', ICON_SIZE, iconTheme(self))

      &iconRender = &viewport.new('VectorViewport', {
         xOffset = MARGIN,
         y       = (&viewport.height - ICON_SIZE) * 0.5,
         width   = ICON_SIZE,
         height  = ICON_SIZE,
         fill    = down_icon.fill
      })

      if not Options.flushEdges then
         &bkgd.stroke      = &theme.input.stroke
         &bkgd.strokeWidth = gui.sizing.page.strokeWidth
         &bkgd.roundX      = gui.sizing.page.strokeWidth * 2
         &bkgd.roundY      = gui.sizing.page.strokeWidth * 2
      end

      &_textClip = &inputViewport.new('VectorViewport', {
         cursor = (function()
            if &allowCustom then return 'text' end
         end)(),
         x = gui.sizing.widget.strokeWidth, y = gui.sizing.widget.strokeWidth,
         xOffset = &iconRender.width + MARGIN + MARGIN, yOffset = gui.sizing.widget.strokeWidth,
         overflow = VOF_HIDDEN
      })

      defaultText = Options.text
      if not Options.allowCustom and not defaultText then
         defaultText = Options.items[0].item
      end

      &text = &_textClip.new('VectorText', {
         x         = 4,
         y         = FONT_HEIGHT + math.floor((BOX_HEIGHT - FONT_HEIGHT - (gui.sizing.widget.strokeWidth * 2)) * 0.5),
         face      = gui.fonts.input.face,
         fontSize  = string.format('%.2fpt', gui.fonts.input.size),
         fontStyle = gui.fonts.input.style,
         fill      = &theme.page.text,
         string    = defaultText,
         lineLimit = 1,
         textFlags = (function()
            flags = 0
            if &allowCustom then
               flags = flags | VTXF_EDITABLE
            end
            return flags
         end)()
      })

      if Options.selected then &text.mtSelectArea(0, 20000) end

      &viewport.mtSubscribeFeedback(FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS, function(Viewport, Event)
         if Event is FM_LOST_FOCUS then
            &bkgd.stroke = &theme.input.stroke
            &events?.lostFocus(&&)
            if &allowCustom then
               reportFeedback()
            end

            &menu.hide()
         else
            &_lastGoodInput = &text.string
            if &disabled then
               &bkgd.stroke = &theme.input.stroke
            else
               &bkgd.stroke = &theme.input.strokeFocus
               &events?.focus(&&)
            end
         end

         Viewport.acDraw()
      end)

      &_textClip.mtSubscribeKeyboard(function(Viewport, Qualifiers, Value, Unicode)
         if not (Qualifiers has KQ_PRESSED) then return end

         -- The menu cannot take the focus, so navigation keys are forwarded to it while it is open.  Home and End
         -- are left to the caret if the text is editable.

         if &menu.visible then
            if Value is KEY_UP then
               &_menuNavigated = true
               &menu.step(-1)
               return
            elseif Value is KEY_DOWN then
               &_menuNavigated = true
               &menu.step(1)
               return
            elseif (Value is KEY_PAGE_UP) or (Value is KEY_PAGE_DOWN) then
               page = &menu.lineLimit ?? 8 -- Read before the call, as arguments are evaluated in the menu's context
               &_menuNavigated = true
               &menu.step(Value is KEY_PAGE_UP ? -page : page)
               return
            elseif (Value is KEY_HOME) and (not &allowCustom) then
               &_menuNavigated = true
               &menu.moveToEnd(false)
               return
            elseif (Value is KEY_END) and (not &allowCustom) then
               &_menuNavigated = true
               &menu.moveToEnd(true)
               return
            elseif Value is KEY_ESCAPE then &menu.hide() return
            elseif (Value is KEY_ENTER) or (Value is KEY_NP_ENTER) or ((not &allowCustom) and (Value is KEY_SPACE)) then
               if (not &allowCustom) or &_menuNavigated then
                  if &menu.activate() then return end
               end
            end

            -- Any other key resumes text editing, so an earlier menu highlight must not replace the edited value.

            if &allowCustom then &_menuNavigated = false end
         elseif (Value is KEY_UP) or (Value is KEY_DOWN) then
            toggleMenu()
            return
         end

         if (Value is KEY_ENTER) or (Value is KEY_NP_ENTER) or ((not &allowCustom) and (Value is KEY_SPACE)) then
            toggleMenu()
            if &allowCustom then
               reportFeedback()
            end
         end
      end)

      &inputViewport.mtSubscribeInput(JTYPE_BUTTON, function(Viewport:obj!, Msg:any!)
         repeat
            if (Msg.type is JET_LMB) and (Msg.value > 0) then
               toggleMenu()
            end
            Msg = Msg.next
         until Msg is nil
      end)

      &menu = gui.dropdown({
         relative  = &viewport,
         config    = Options.items,
         lineLimit = 8,
         feedback = function(Menu:table!, Item:table!)
            using self do
               &text.string = Item.item
               reportFeedback()
               &viewport.acDraw()
            end
         end
      })

      if &unlockMenuWidth then -- Set combobox size to the width of the menu
         &viewport.width = &menu.width + &labelSize
      end

      &events?.show(&&)

      return &&
   end
end
