-- Code panel for the colour picker's Export panel: a rounded panel with a row of tabs above syntax-coloured
-- monospaced lines.  Lines that are too long for the panel are wrapped, preferably at a space, and lines that don't
-- fit vertically are scrolled with a gui.scrollbar.  The text vectors are pooled, so replacing the lines doesn't
-- create new vectors unless the line count grows.

   import 'gui/scrollbar', './parts'
   include 'display'

   namespace colourpicker_code { }

PAD_X       <const> = 12
PAD_Y       <const> = 10
FONT_SIZE   <const> = 10.5
LINE_HEIGHT <const> = 16   -- 1.55 em, as in the design
TAB_HEIGHT  <const> = 18
TAB_SIZE    <const> = 10
TAB_PAD_X   <const> = 7
TAB_GAP     <const> = 2
TABS_BELOW  <const> = 6    -- Gap between the tabs and the first line
WRAP_INDENT <const> = 4    -- Extra indent of a wrapped continuation, in characters
BAR_INSET   <const> = 4    -- Gap between the scrollbar and the panel border
BAR_GAP     <const> = 4    -- Minimum gap between wrapped text and the scrollbar

-- Byte offset of each UTF-8 character, followed by the end of the string for half-open slices.

function characterOffsets(Text:str):array<int>
   offsets = array<int>
   for i in {0 to #Text} do
      if (Text.byte(i) & 0xc0) != 0x80 then offsets.push(i) end
   end
   offsets.push(#Text)
   return offsets
end

-- Wrap one line of segments at Columns characters.  Returns an array of display lines, each { indent, segs }, where
-- indent is in characters and segs is an array<table> of { role, text }.

function wrapLine(Segs:array<table>, Columns:num):array<table>
   parts = array<str>
   for s in values(Segs) do parts.push(s.text) end
   text = parts.concat('')
   offsets = characterOffsets(text)
   length = #offsets - 1

   if length <= Columns then
      return array<table> { { indent = 0, segs = Segs } }
   end

   lead = 0
   while (lead < length) and (text.byte(offsets[lead]) is 32) do lead++ end
   cont = math.min(lead + WRAP_INDENT, math.floor(Columns * 0.5))

   -- Find the byte ranges of the display lines

   ranges = array<table>
   pos = 0
   limit = Columns
   while (length - pos) > limit do
      cut = pos + limit
      brk = cut
      while (brk > pos) and (text.byte(offsets[brk - 1]) != 32) do brk -= 1 end
      if brk <= pos + ((pos is 0) ? lead : 0) then -- No space to break at, so break inside a word
         brk = cut
      end
      ranges.push({ first = offsets[pos], stop = offsets[brk] })
      pos = brk
      while (pos < length) and (text.byte(offsets[pos]) is 32) do pos++ end
      limit = Columns - cont
   end
   if pos < length then ranges.push({ first = offsets[pos], stop = #text }) end

   -- Cut the segments to each range

   result = array<table>
   for i, range in ranges do
      segs = array<table>
      offset = 0
      for s in values(Segs) do
         s_end = offset + #s.text
         lo = math.max(range.first, offset)
         hi = math.min(range.stop, s_end)
         if hi > lo then segs.push({ role = s.role, text = s.text.sub(lo - offset, hi - offset) }) end
         offset = s_end
      end
      result.push({ indent = (i is 0) ? 0 : cont, segs = segs })
   end
   return result
end

----------------------------------------------------------------------------------------------------------------------

@Doc(text=[[
@desc Create a code panel.
@input Target viewport
@input Options: x, y, width, height, tokens, tabs (array<str> of tab labels), onTab(Index) and onClick()
@result Table with `viewport`, `setTab(Index)`, `setLines(Lines, Text)`, `scrollTo(Line)` and `setHeight(Height)`.
Lines are as returned by colourexport.generate(), and Text is their joined form, which lets an unchanged update be
skipped.
]])
colourpicker_code.new = function(Target:obj!, Options:table!):table
   t = Options.tokens
   code = t.code
   width = Options.width
   height = Options.height
   text = colourpicker_parts.text
   mono = colourpicker_parts.FACE_MONO

   role_fill = { c = code.comment, p = code.punct, k = code.key, v = code.value, t = code.text }

   self = {
      viewport = Target.new('VectorViewport', { x = Options.x, y = Options.y, width = width, height = height }),
      tab      = 0,
      display  = array<table>, -- Wrapped lines
      pool     = array<obj>
   }

   self.bkgd = self.viewport.new('VectorRectangle', {
      x = 0.5, y = 0.5, width = width - 1, height = height - 1, roundX = 5, roundY = 5,
      fill = code.bkgd, stroke = code.stroke, strokeWidth = 1
   })

   -- Tabs

   self.tabs = array<table>
   x = PAD_X
   for i, label in Options.tabs do
      vp = self.viewport.new('VectorViewport', { x = x, y = PAD_Y, width = 1, height = TAB_HEIGHT, cursor = 'hand' })
      bkgd = vp.new('VectorRectangle', { x = 0, y = 0, width = 1, height = TAB_HEIGHT, roundX = 3, roundY = 3 })
      label_vt = text(vp, {
         x = TAB_PAD_X, y = colourpicker_parts.baseline(0, TAB_HEIGHT, TAB_SIZE), size = TAB_SIZE, face = mono,
         string = label
      })
      tab_w = math.ceil(label_vt.textWidth) + (TAB_PAD_X * 2)
      vp.width = tab_w
      bkgd.width = tab_w

      vp.mtSubscribeInput(JTYPE_BUTTON, function(Viewport:obj!, Msg:any!)
         repeat
            if (Msg.type is JET_LMB) and (Msg.value > 0) and (self.tab != i) then
               self.setTab(i)
               if Options.onTab then Options.onTab(i) end
            end
            Msg = Msg.next
         until not Msg
      end)

      self.tabs.push({ viewport = vp, bkgd = bkgd, label = label_vt })
      x += tab_w + TAB_GAP
   end

   -- Lines are drawn on a page that is moved within a clipping frame.  The scrollbar is placed at the right of the
   -- scroll area and narrows the frame while it is shown.  Lines are wrapped to the narrowed width, so showing or
   -- hiding the bar never changes the wrapping.

   frame_y = PAD_Y + TAB_HEIGHT + TABS_BELOW
   frame_h = height - frame_y - PAD_Y
   area_w = width - PAD_X - BAR_INSET
   self.area = self.viewport.new('VectorViewport', { x = PAD_X, y = frame_y, width = area_w, height = frame_h })
   self.frame = self.area.new('VectorViewport', {
      x = 0, y = 0, xOffset = 0, yOffset = 0, overflow = VOF_HIDDEN, cursor = 'hand'
   })
   self.page = self.frame.new('VectorViewport', { x = 0, y = 0, width = '100%', height = frame_h, cursor = 'hand' })
   self.scrollbar = gui.scrollbar({ target = self.area, view = self.frame, page = self.page, direction = 'vertical' })

   probe = text(self.page, { y = -100, size = FONT_SIZE, face = mono, string = '0000000000' })
   self.charWidth = probe.textWidth / 10
   probe.free()
   text_w = area_w - self.scrollbar.v_thickness - BAR_GAP
   self.columns = math.max(8, math.floor(text_w / self.charWidth))

   self.setTab = function(Index:num!)
      self.tab = Index
      for i, tab in self.tabs do
         active = (i is Index)
         tab.bkgd.fill = active ? code.tabActive : code.tab
         tab.label.fill = active ? code.tabActiveText : code.tabText
      end
   end

   -- Scroll so that Line is at the top of the frame, as far as the page allows.  The scrollbar follows the page.

   self.scrollTo = function(Line:num!)
      max_y = math.max(0, self.page.height - frame_h)
      y = -math.clamp(math.floor(Line) * LINE_HEIGHT, 0, max_y)
      if self.page.y != y then self.page.y = y end
   end

   self.setLines = function(Lines:array<any>!, Text:str)
      if Text and (Text is self.text) then return end
      self.text = Text

      display = array<table>
      for line in values(Lines) do
         for wrapped in values(wrapLine(line, self.columns)) do display.push(wrapped) end
      end
      self.display = display

      n = 0
      for i, line in display do
         baseline = colourpicker_parts.baseline(i * LINE_HEIGHT, LINE_HEIGHT, FONT_SIZE)
         x = line.indent * self.charWidth
         for s in values(line.segs) do
            local vt:obj
            if n < #self.pool then
               vt = self.pool[n]
            else
               vt = text(self.page, { size = FONT_SIZE, face = mono })
               self.pool.push(vt)
            end
            vt.string = s.text
            vt.x = x
            vt.y = baseline
            vt.fill = role_fill[s.role] ?? code.text
            vt.visibility = VIS_VISIBLE
            x += (#characterOffsets(s.text) - 1) * self.charWidth
            n++
         end
      end

      for i in {n to #self.pool} do self.pool[i].visibility = VIS_HIDDEN end

      -- Keep the scroll position unless the page has become too short for it.

      self.page.height = math.max(frame_h, #display * LINE_HEIGHT)
      min_y = math.min(0, frame_h - self.page.height)
      if self.page.y < min_y then self.page.y = min_y end
   end

   -- Resize the panel.  The scroll area follows, and the scroll position is kept unless the page has become too short
   -- for it.

   self.setHeight = function(Height:num!)
      if Height is self.viewport.height then return end
      self.viewport.height = Height
      self.bkgd.height = Height - 1
      frame_h = Height - frame_y - PAD_Y
      self.area.height = frame_h
      self.page.height = math.max(frame_h, #self.display * LINE_HEIGHT)
      min_y = math.min(0, frame_h - self.page.height)
      if self.page.y < min_y then self.page.y = min_y end
   end

   -- The scrollbar handles wheel input on the page.  Clicks are taken from the page too: the scrollbar subscribes the
   -- page to input, so the frame behind it no longer receives the buttons.  The page always covers the frame.

   self.page.mtSubscribeInput(JTYPE_BUTTON, function(Viewport:obj!, Msg:any!)
      repeat
         if (Msg.type is JET_LMB) and (Msg.value is 0) then
            if Options.onClick then Options.onClick() end
         end
         Msg = Msg.next
      until not Msg
   end)

   self.setTab(0)
   return self
end
