-- Shared number formatting for the display-independent colour, palette and export helpers.

   namespace colourpicker_format { }

colourpicker_format.number = function(Value:num!, Places:num!):str
   s = string.format(f'%.{Places}f', Value)
   if s.find('.', 0, true) then
      while s.endsWith('0') do s = s.sub(0, -1) end
      if s.endsWith('.') then s = s.sub(0, -1) end
   end
   if s is '-0' then s = '0' end
   return s
end
