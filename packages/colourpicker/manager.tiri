-- Palette manager: the Palette tab of the colour picker.  The left panel lists the palettes of the palette database
-- under a search filter, with the New, Import and Export buttons.  The centre panel shows the swatches of the selected
-- palette as cards, and the right panel shows the details of the palette and of the selected swatch, with editable
-- descriptions.  Double-clicking a palette or a swatch card opens it in the Picker tab.
--
-- The picker owns the database (picker.db) and supplies the callbacks in Options; see colourpicker_manager.build().

   import 'gui', 'gui/button', 'gui/input', 'gui/listview', 'gui/scrollbar', 'gui/filedialog'
   import 'gui/colourpicker/colour', 'gui/colourpicker/palette'
   import './parts'

   namespace colourpicker_manager { }

PAD          <const> = 14 -- Around the panels
GAP          <const> = 12 -- Between panels
LEFT_W       <const> = 268
RIGHT_W      <const> = 260
INSET        <const> = 10 -- Padding inside a panel body
SEARCH_H     <const> = 26
BUTTON_H     <const> = 26
LIST_ROW_H   <const> = 40
LIST_EDGE    <const> = 4  -- Inset of the rows within a listview
STRIP_X      <const> = 8
STRIP_W      <const> = 56
STRIP_H      <const> = 16
CARD_COLS    <const> = 3
CARD_GAP     <const> = 10
CARD_SWATCH  <const> = 64 -- Height of a card's colour block
CARD_H       <const> = CARD_SWATCH + 56
AREA_H       <const> = 84 -- Description areas
AREA_PAD     <const> = 7
AREA_FONT    <const> = 12
NAME_LIMIT   <const> = 60
TEXT_LIMIT   <const> = 2000
FLASH_TIME   <const> = 1.6
LABEL_FONT   <const> = 10.5
PROP_ROW     <const> = 34
EXPORT_NAME  <const> = 'palettes.json'
FILE_FILTER  <const> = { { name = 'Palette Databases', ext = '.json' }, { name = 'All Files', ext = '' } }

----------------------------------------------------------------------------------------------------------------------
-- The sRGB hex value of a swatch, gamut-mapped for display.

function swatchHex(S:table):str
   l, c, h = colourmath.gamutMap(S.l, S.c, S.h, 'srgb')
   r, g, b = colourmath.oklchToSrgb(l, c, h)
   return colourmath.toHex(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
end

function plural(Count:num, Noun:str):str
   return f'{Count} {Noun}{(Count is 1) ? "" : "s"}'
end

function paletteSummary(Palette:table):str
   return f'{plural(#Palette.swatches, "colour")}  ·  {colourpalette.mode(Palette).label}'
end

-- An uppercase section label in the mono face.

-- Widget theme override for 12 px UI text in an input box of the given height.

function inputText(Height:num):table
   return { text = { fontSize = '12px', x = 6, y = colourpicker_parts.baseline(0, Height - 2, 12) } }
end

function label(Target:obj, X:num, Y:num, Text:str, Tokens:table):obj
   return colourpicker_parts.text(Target, {
      x = X, y = Y, size = LABEL_FONT, face = colourpicker_parts.FACE_MONO, fill = Tokens.fg3, string = Text.upper()
   })
end

----------------------------------------------------------------------------------------------------------------------
-- A palette row in the list: a strip of the palette's colours, its name and a summary.  The palette that the picker
-- is editing is tagged.

function paletteRow(Viewport:obj!, Tokens:table!):table
   t = Tokens
   self = { viewport = Viewport, cells = array<obj> }

   self.highlight = Viewport.new('VectorRectangle', {
      x = 0.5, y = 0.5, xOffset = 0.5, yOffset = 0.5, roundX = 4, roundY = 4, fill = t.accentSoft, stroke = t.accent,
      strokeWidth = 1, visibility = VIS_HIDDEN
   })

   strip_y = math.floor((LIST_ROW_H - STRIP_H) * 0.5)
   self.strip = Viewport.new('VectorViewport', {
      x = STRIP_X, y = strip_y, width = STRIP_W, height = STRIP_H, overflow = VOF_HIDDEN
   })
   Viewport.new('VectorRectangle', {
      x = STRIP_X + 0.5, y = strip_y + 0.5, width = STRIP_W - 1, height = STRIP_H - 1, roundX = 2, roundY = 2,
      fill = 'none', stroke = t.swatchBorder, strokeWidth = 1
   })

   text_x = STRIP_X + STRIP_W + 10
   self.name = colourpicker_parts.text(Viewport, { x = text_x, y = 17, size = 12, fill = t.fg0 })
   self.sub = colourpicker_parts.text(Viewport, {
      x = text_x, y = 32, size = LABEL_FONT, face = colourpicker_parts.FACE_MONO, fill = t.fg3
   })
   self.tag = colourpicker_parts.text(Viewport, {
      y = 17, size = 9.5, face = colourpicker_parts.FACE_MONO, fill = t.accent, align = 'right', string = 'IN PICKER',
      style = 'Bold'
   })

   function fit()
      right = Viewport.width - 8
      self.tag.x = right
      space = right - self.name.x - ((self.tag.visibility is VIS_VISIBLE) ? (self.tag.textWidth + 8) : 0)
      colourpicker_parts.fitText(self.name, '', self.palette?.name ?? '', space)
      if self.palette then
         colourpicker_parts.fitText(self.sub, '', paletteSummary(self.palette), right - self.sub.x)
      end
   end

   self.set = function(Item:table!)
      palette = Item.palette
      self.palette = palette
      for cell in values(self.cells) do cell.free() end
      self.cells.clear()
      n = math.max(1, #palette.swatches)
      w = STRIP_W / n
      for i, s in palette.swatches do
         self.cells.push(self.strip.new('VectorRectangle', {
            x = i * w, y = 0, width = w + 0.5, height = STRIP_H, fill = swatchHex(s)
         }))
      end
      self.tag.visibility = Item.current ? VIS_VISIBLE : VIS_HIDDEN
      fit()
   end

   self.layout = function() fit() end

   self.setHighlight = function(State:str)
      if State is 'active' then
         self.highlight.{ visibility = VIS_VISIBLE, fill = t.accentSoft, stroke = t.accent }
      elseif State is 'focus' then
         self.highlight.{ visibility = VIS_VISIBLE, fill = 'none', stroke = t.accent }
      else
         self.highlight.visibility = VIS_HIDDEN
      end
   end

   return self
end

----------------------------------------------------------------------------------------------------------------------
-- A multi-line text area.  Clicking gives it the focus, which makes the text editable.  A focus loss commits the
-- text through commit(Text).  The placeholder is shown while the area is empty and unfocused.

function textArea(Target:obj!, Options:table!):table
   t = Options.tokens
   self = { focused = false }

   vp = Target.new('VectorViewport', {
      x = Options.x, y = Options.y, width = Options.width, height = Options.height, overflow = VOF_HIDDEN,
      cursor = 'text'
   })
   self.viewport = vp

   self.bkgd = vp.new('VectorRectangle', {
      x = 0.5, y = 0.5, xOffset = 0.5, yOffset = 0.5, roundX = 4, roundY = 4, fill = t.sunk, stroke = t.border,
      strokeWidth = 1
   })

   baseline = AREA_PAD + math.round(AREA_FONT * 0.9)
   self.placeholder = colourpicker_parts.text(vp, {
      x = AREA_PAD, y = baseline, size = AREA_FONT, fill = t.fg3, string = Options.placeholder ?? '',
      style = 'Regular'
   })

   self.text = vp.new('VectorText', {
      x = AREA_PAD, y = baseline, face = colourpicker_parts.FACE_UI, fontSize = f'{AREA_FONT}px',
      fontStyle = 'Regular', fill = t.fg0, inlineSize = Options.width - (AREA_PAD * 2), lineLimit = 0,
      textFlags = VTXF_EDITABLE
   })

   function showPlaceholder()
      empty = not ((self.text.string ?? '')??)
      self.placeholder.visibility = (empty and not self.focused) ? VIS_VISIBLE : VIS_HIDDEN
   end

   self.set = function(Text:str)
      if self.focused then return end
      self.text.string = Text ?? ''
      showPlaceholder()
   end

   self.get = function():str
      return (self.text.string ?? '').trim()
   end

   self.enable = function() vp.acEnable() end
   self.disable = function() vp.acDisable() end

   vp.mtSubscribeInput(JTYPE_BUTTON, function(Input:obj!, Msg:any!)
      repeat
         if (Msg.type is JET_LMB) and (Msg.value is 1) and not self.focused then vp.acFocus() end
         Msg = Msg.next
      until not Msg
   end)

   -- Escape leaves the area.  Enter starts a new line, which the VectorText handles.

   vp.mtSubscribeKeyboard(function(Input:obj!, Qualifiers:num!, Value:num!, Unicode)
      if (Qualifiers has KQ_PRESSED) and (Value is KEY_ESCAPE) and Options.blur then Options.blur() end
   end)

   vp.mtSubscribeFeedback(FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS, function(Input:obj!, Event:num!)
      gained = Event != FM_LOST_FOCUS
      if gained is self.focused then return end
      self.focused = gained
      self.bkgd.stroke = gained ? t.accent : t.border
      showPlaceholder()
      if not gained then
         text = self.get()
         if #text > TEXT_LIMIT then text = text.sub(0, TEXT_LIMIT) end
         Options.commit(text)
      end
      if Options.focus then Options.focus(gained, self) end
      vp.acDraw()
   end)

   showPlaceholder()
   return self
end

----------------------------------------------------------------------------------------------------------------------
-- A swatch card in the centre panel: the colour, the swatch name, its hex value and its OKLCH channels.

function swatchCard(Target:obj!, X:num!, Y:num!, Width:num!, Swatch:table!, Tokens:table!):table
   t = Tokens
   self = { }

   vp = Target.new('VectorViewport', { x = X, y = Y, width = Width, height = CARD_H, cursor = 'hand' })
   self.viewport = vp

   vp.new('VectorRectangle', {
      x = 0.5, y = 0.5, width = Width - 1, height = CARD_H - 1, roundX = 5, roundY = 5, fill = t.panel,
      stroke = t.border, strokeWidth = 1
   })

   -- The colour block has rounded top corners only, as a path.

   w, r = Width - 1, 5
   vp.new('VectorPath', {
      sequence = f'M0.5 {CARD_SWATCH + 0.5} V{r + 0.5} A{r} {r} 0 0 1 {r + 0.5} 0.5 H{w - r} ' ..
         f'A{r} {r} 0 0 1 {w} {r + 0.5} V{CARD_SWATCH + 0.5} Z',
      fill = swatchHex(Swatch)
   })

   if Swatch.alpha < 1 then
      colourpicker_parts.text(vp, {
         x = Width - 8, y = 16, size = 10, face = colourpicker_parts.FACE_MONO, fill = t.fg0, align = 'right',
         string = f'α {math.round(Swatch.alpha * 100)}%'
      })
   end

   name = colourpicker_parts.text(vp, { x = 9, y = CARD_SWATCH + 18, size = 12, fill = t.fg0 })
   colourpicker_parts.fitText(name, '', Swatch.name, Width - 18)

   colourpicker_parts.text(vp, {
      x = 9, y = CARD_SWATCH + 33, size = 11, face = colourpicker_parts.FACE_MONO, fill = t.fg2,
      string = swatchHex(Swatch)
   })

   colourpicker_parts.text(vp, {
      x = 9, y = CARD_SWATCH + 47, size = 10, face = colourpicker_parts.FACE_MONO, fill = t.fg3,
      string = f'L {math.round(Swatch.l * 100)} · C {string.format("%.2f", Swatch.c)} · H {math.round(Swatch.h)}'
   })

   self.ring = vp.new('VectorRectangle', {
      x = 1, y = 1, width = Width - 2, height = CARD_H - 2, roundX = 5, roundY = 5, fill = 'none',
      stroke = t.accent, strokeWidth = 2, visibility = VIS_HIDDEN
   })

   self.setSelected = function(Selected:bool)
      self.ring.visibility = Selected ? VIS_VISIBLE : VIS_HIDDEN
   end

   return self
end

----------------------------------------------------------------------------------------------------------------------

@Doc(text=[[
@desc Build the palette manager in a hidden viewport that covers the dialog body.
@input Picker: the picker entity, which supplies `tokens`, `db` (the palette database) and `dbIndex` (the palette that
the picker edits)
@input Target viewport
@input Options: x, y, width, height, and the callbacks open(Index, Swatch), save(), sync() (stores the picker's palette
in the database), focus(Has, Field) and blur()
@result Table with `viewport`, `show()`, `hide()`, `refresh()`, `widgets()` and `destroy()`
]])
colourpicker_manager.build = function(Picker:table!, Target:obj!, Options:table!):table
   t = Picker.tokens
   width, height = Options.width, Options.height
   panel_h = height - (PAD * 2)
   centre_w = width - (PAD * 2) - (GAP * 2) - LEFT_W - RIGHT_W

   self = {
      selected = Picker.dbIndex, -- Index of the palette shown in the centre and right panels
      swatch   = nil,            -- Index of the selected swatch in that palette
      filter   = '',
      cards    = array<table>
   }

   self.viewport = Target.new('VectorViewport', {
      x = Options.x, y = Options.y, width = width, height = height, visibility = VIS_HIDDEN
   })

   function db():table
      return Picker.db
   end

   function selectedPalette():table
      return (self.selected != nil) ? db().palettes[self.selected] : nil
   end

   ---------------------------------------------------------------------------------------------------------------
   -- Left: the search box, the palette list and the database buttons

   left = colourpicker_parts.panel(self.viewport, {
      x = PAD, y = PAD, width = LEFT_W, height = panel_h, title = 'My Palettes', tokens = t
   })
   self.leftPanel = left
   body_h = panel_h - 32
   inner_w = LEFT_W - (INSET * 2)

   self.search = gui.input({
      target = left.body, x = INSET, y = INSET, width = inner_w, height = SEARCH_H, placeholder = 'Search palettes…',
      theme = inputText(SEARCH_H),
      events = {
         change = function(Event)
            self.filter = (Event.text ?? '').trim().lower()
            processing.delayedCall(function()
               if self.list then self.updateList() end
            end)
         end
      }
   })

   self.search.viewport.mtSubscribeFeedback(FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS,
      function(Input:obj!, Event:num!)
         Options.focus(Event != FM_LOST_FOCUS, self.search)
      end)

   list_y = INSET + SEARCH_H + 8
   buttons_y = body_h - INSET - BUTTON_H
   list_h = buttons_y - 8 - list_y

   self.list = gui.listView({
      target     = left.body,
      x          = INSET - LIST_EDGE,
      y          = list_y - LIST_EDGE,
      width      = inner_w + (LIST_EDGE * 2),
      height     = list_h + (LIST_EDGE * 2),
      borderless = true,
      showIcons  = false,
      rowHeight  = LIST_ROW_H,
      rowSpacing = 2,
      scrollDirection = 'vertical',
      theme      = { page = { bkgd = { fill = t.panel } } },

      constructItem = function(Item:table, Viewport:obj, Reason:str)
         if Reason is 'create' then
            Item.content = paletteRow(Viewport, t)
            Item.content.set(Item)
         elseif Reason is 'update' then
            Item.content.set(Item)
         elseif Reason is 'layout' then
            Item.content.layout()
         elseif Reason is 'destroy' then
            Item.content = nil
         end
      end,

      constructHighlight = function(Item:table, Viewport:obj, Reason:str)
         if Reason is 'selected' then
            Item.content.setHighlight('active')
         else
            Item.content.setHighlight(Item.viewState.focused ? 'focus' : nil)
         end
      end,

      events = {
         itemSelected = function(View:table, Reason:str, Item:table)
            if Reason is 'user' then self.selectPalette(Item.index) end
         end,

         -- Double-clicking a row, or Enter on it, opens the palette in the picker

         itemActivated = function(View:table, Reason:str, Item:table)
            if Reason is 'user' then
               index = Item.index
               processing.delayedCall(function() Options.open(index, nil) end)
            end
         end
      }
   })

   self.list.page.new('VectorRectangle', {
      width = '100%', height = '100%', fill = t.panel, cursor = 'hand'
   }).acMoveToBack()

   self.empty = colourpicker_parts.text(left.body, {
      x = LEFT_W * 0.5, y = list_y + 28, size = 12, fill = t.fg3, align = 'center', string = 'No matching palettes',
      style = 'Regular'
   })

   function button(X:num, W:num, Label:str, Activate:func):table
      return gui.button({
         target = left.body, x = X, y = buttons_y, width = W, height = BUTTON_H, label = Label,
         theme = { text = { fontSize = '11.5px', y = colourpicker_parts.baseline(0, BUTTON_H - 2, 11.5) } },
         events = { activate = Activate }
      })
   end

   btn_w = math.floor((inner_w - 12) / 3)
   self.btnNew = button(INSET, btn_w, '+ New', function() self.newPalette() end)
   self.btnImport = button(INSET + btn_w + 6, btn_w, 'Import…', function() self.importDatabase() end)
   self.btnExport = button(INSET + ((btn_w + 6) * 2), btn_w, 'Export…', function() self.exportDatabase() end)

   ---------------------------------------------------------------------------------------------------------------
   -- Centre: the swatches of the selected palette

   centre = colourpicker_parts.panel(self.viewport, {
      x = PAD + LEFT_W + GAP, y = PAD, width = centre_w, height = panel_h, title = '', tokens = t
   })
   self.centrePanel = centre

   -- The cards are drawn on a page that is scrolled within a clipping frame

   area_w = centre_w - INSET - 4
   area_h = body_h - (INSET * 2)
   self.area = centre.body.new('VectorViewport', { x = INSET, y = INSET, width = area_w, height = area_h })
   self.frame = self.area.new('VectorViewport', { x = 0, y = 0, xOffset = 0, yOffset = 0, overflow = VOF_HIDDEN })
   self.page = self.frame.new('VectorViewport', { x = 0, y = 0, width = '100%', height = area_h })
   self.page.new('VectorRectangle', { width = '100%', height = '100%', fill = t.panel })
   self.scrollbar = gui.scrollbar({ target = self.area, view = self.frame, page = self.page, direction = 'vertical' })
   card_w = math.floor((area_w - self.scrollbar.v_thickness - 4 - (CARD_GAP * (CARD_COLS - 1))) / CARD_COLS)

   self.noPalette = colourpicker_parts.text(centre.body, {
      x = centre_w * 0.5, y = 60, size = 12, fill = t.fg3, align = 'center', string = 'Select a palette',
      style = 'Regular', visibility = VIS_HIDDEN
   })

   ---------------------------------------------------------------------------------------------------------------
   -- Right: palette and swatch details

   right_x = PAD + LEFT_W + GAP + centre_w + GAP
   right_inner = RIGHT_W - (INSET * 2)
   pal_h = 32 + INSET + 14 + 6 + SEARCH_H + 14 + 14 + 6 + AREA_H + INSET

   info = colourpicker_parts.panel(self.viewport, {
      x = right_x, y = PAD, width = RIGHT_W, height = pal_h, title = 'Palette', tokens = t
   })
   self.infoPanel = info

   y = INSET + 10
   label(info.body, INSET, y, 'Name', t)
   y += 6
   self.nameInput = gui.input({
      target = info.body, x = INSET, y = y, width = right_inner, height = SEARCH_H, maxLength = NAME_LIMIT,
      theme = inputText(SEARCH_H),
      events = {
         activate = function(Event)
            palette = selectedPalette()
            if not palette or self.refreshing then return end
            if colourpalette.renamePalette(palette, Event.text ?? '') then
               Options.save()
               self.refresh()
            else
               self.nameInput.setText(palette.name)
            end
         end
      }
   })
   self.nameInput.viewport.mtSubscribeFeedback(FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS,
      function(Input:obj!, Event:num!)
         Options.focus(Event != FM_LOST_FOCUS, self.nameInput)
      end)

   y += SEARCH_H + 14 + 10
   label(info.body, INSET, y, 'Description', t)
   y += 6
   self.paletteNotes = textArea(info.body, {
      x = INSET, y = y, width = right_inner, height = AREA_H, tokens = t, placeholder = 'Notes about this palette…',
      commit = function(Text:str)
         palette = selectedPalette()
         if not palette or ((palette.description ?? '') is Text) then return end
         palette.description = (#Text > 0) ? Text : nil
         Options.save()
      end,
      focus = Options.focus, blur = Options.blur
   })

   sw_y = PAD + pal_h + GAP
   swatch = colourpicker_parts.panel(self.viewport, {
      x = right_x, y = sw_y, width = RIGHT_W, height = height - PAD - sw_y, title = 'Swatch', tokens = t
   })
   self.swatchPanel = swatch
   sw_body_h = height - PAD - sw_y - 32

   self.swatchGroup = swatch.body.new('VectorViewport', { x = 0, y = 0, width = RIGHT_W, height = sw_body_h })
   g = self.swatchGroup

   self.swatchBlock = g.new('VectorRectangle', {
      x = INSET + 0.5, y = INSET + 0.5, width = 47, height = 47, roundX = 6, roundY = 6, stroke = t.swatchBorder,
      strokeWidth = 1, fill = 'white'
   })
   self.swatchName = colourpicker_parts.text(g, { x = INSET + 60, y = INSET + 20, size = 13, fill = t.fg0 })
   self.swatchCss = colourpicker_parts.text(g, {
      x = INSET + 60, y = INSET + 38, size = 11, face = colourpicker_parts.FACE_MONO, fill = t.fg2
   })

   y = INSET + 48 + 22
   label(g, INSET, y, 'Description', t)
   y += 6
   self.swatchNotes = textArea(g, {
      x = INSET, y = y, width = right_inner, height = AREA_H, tokens = t, placeholder = 'Notes about this colour…',
      commit = function(Text:str)
         palette = selectedPalette()
         s = (palette and (self.swatch != nil)) ? palette.swatches[self.swatch] : nil
         if not s or ((s.description ?? '') is Text) then return end
         s.description = (#Text > 0) ? Text : nil
         Options.save()
      end,
      focus = Options.focus, blur = Options.blur
   })

   -- Properties: two columns of label and value

   y += AREA_H + 22
   label(g, INSET, y, 'Properties', t)
   y += 8
   self.props = { }
   col_w = right_inner * 0.5
   props = array<table> {
      { id = 'l', label = 'Lightness' }, { id = 'c', label = 'Chroma' }, { id = 'h', label = 'Hue' },
      { id = 'alpha', label = 'Alpha' }, { id = 'srgb', label = 'sRGB' }, { id = 'gamut', label = 'In gamut' }
   }
   for i, p in props do
      px = INSET + ((i % 2) * col_w)
      py = y + (math.floor(i / 2) * PROP_ROW)
      label(g, px, py + 12, p.label, t)
      self.props[p.id] = colourpicker_parts.text(g, {
         x = px, y = py + 28, size = 12, face = colourpicker_parts.FACE_MONO, fill = t.fg0
      })
   end

   self.btnEdit = gui.button({
      target = g, x = INSET, y = sw_body_h - INSET - BUTTON_H, width = right_inner, height = BUTTON_H,
      label = 'Edit in Picker', primary = true,
      theme = { text = { fontSize = '11.5px', y = colourpicker_parts.baseline(0, BUTTON_H - 2, 11.5) } },
      events = {
         activate = function()
            if self.selected != nil then Options.open(self.selected, self.swatch) end
         end
      }
   })

   self.noSwatch = colourpicker_parts.text(swatch.body, {
      x = RIGHT_W * 0.5, y = 40, size = 12, fill = t.fg3, align = 'center', string = 'No swatch selected',
      style = 'Regular', visibility = VIS_HIDDEN
   })

   ---------------------------------------------------------------------------------------------------------------
   -- Updates

   function flash(Text:str)
      colourpicker_parts.cancelTimer(self.flashTimer)
      left.setMeta(Text)
      self.flashTimer = colourpicker_parts.after(FLASH_TIME, function()
         self.flashTimer = nil
         if not self.list then return end
         left.setMeta(tostring(#db().palettes))
         self.viewport.acDraw()
      end)
      self.viewport.acDraw()
   end
   self.flash = flash

   function matches(Palette:table):bool
      if not self.filter?? then return true end
      if Palette.name.lower().find(self.filter, 0, true) then return true end
      return (Palette.description ?? '').lower().find(self.filter, 0, true) != nil
   end

   self.updateList = function()
      items = array<table>
      for i, p in db().palettes do
         if matches(p) then
            items.push({ index = i, name = p.name, palette = p, current = (i is Picker.dbIndex) })
         end
      end
      self.list.loadItems(items)
      self.empty.visibility = (#items is 0) ? VIS_VISIBLE : VIS_HIDDEN
      if not self.flashTimer then left.setMeta(tostring(#db().palettes)) end

      for item in values(self.list.items) do
         if item.index is self.selected then
            self.list.selectItems(Item => Item is item)
            self.list.revealItem(item)
            break
         end
      end
      self.viewport.acDraw()
   end

   function updateCards()
      for card in values(self.cards) do card.viewport.free() end
      self.cards.clear()

      palette = selectedPalette()
      self.noPalette.visibility = palette ? VIS_HIDDEN : VIS_VISIBLE
      self.area.visibility = palette ? VIS_VISIBLE : VIS_HIDDEN
      centre.title.string = palette ? palette.name : ''
      centre.setMeta(palette ? paletteSummary(palette) : '')
      if centre.title.textWidth > centre_w - 24 - centre.meta.textWidth - 16 then
         colourpicker_parts.fitText(centre.title, '', palette.name, centre_w - 24 - centre.meta.textWidth - 16)
      end
      if not palette then return end

      for i, s in palette.swatches do
         x = (i % CARD_COLS) * (card_w + CARD_GAP)
         y = math.floor(i / CARD_COLS) * (CARD_H + CARD_GAP)
         card = swatchCard(self.page, x, y, card_w, s, t)
         card.setSelected(i is self.swatch)
         index = i
         card.viewport.mtSubscribeInput(JTYPE_BUTTON, function(Input:obj!, Msg:any!)
            repeat
               if (Msg.type is JET_LMB) and (Msg.value is 0) then
                  if Msg.flags has JTYPE_DBL_CLICK then
                     sel = self.selected
                     processing.delayedCall(function() Options.open(sel, index) end)
                  else
                     self.selectSwatch(index)
                  end
               end
               Msg = Msg.next
            until not Msg
         end)
         self.cards.push(card)
      end

      rows = math.ceil(#palette.swatches / CARD_COLS)
      self.page.height = math.max(area_h, (rows * (CARD_H + CARD_GAP)) - CARD_GAP)
      min_y = math.min(0, area_h - self.page.height)
      if self.page.y < min_y then self.page.y = min_y end
   end

   function updateInfo()
      self.refreshing = true
      defer
         self.refreshing = false
      end

      palette = selectedPalette()
      if palette then
         self.nameInput.setText(palette.name)
         self.nameInput.enable()
         self.paletteNotes.set(palette.description ?? '')
         self.paletteNotes.enable()
      else
         self.nameInput.setText('')
         self.nameInput.disable()
         self.paletteNotes.set('')
         self.paletteNotes.disable()
      end

      s = (palette and (self.swatch != nil)) ? palette.swatches[self.swatch] : nil
      self.swatchGroup.visibility = s ? VIS_VISIBLE : VIS_HIDDEN
      self.noSwatch.visibility = s ? VIS_HIDDEN : VIS_VISIBLE
      if not s then return end

      hex = swatchHex(s)
      self.swatchBlock.fill = hex
      colourpicker_parts.fitText(self.swatchName, '', s.name, RIGHT_W - INSET - 60 - INSET)
      self.swatchCss.string = colourmath.toOklchString(s.l, s.c, s.h, s.alpha)
      self.swatchNotes.set(s.description ?? '')

      _, _, _, in_srgb = colourmath.oklchToSrgb(s.l, s.c, s.h)
      gr, gg, gb = colourmath.oklchToSrgb(colourmath.gamutMap(s.l, s.c, s.h, 'srgb'))
      self.props.l.string = string.format('%.3f', s.l)
      self.props.c.string = string.format('%.3f', s.c)
      self.props.h.string = f'{math.round(s.h)}°'
      self.props.alpha.string = f'{math.round(s.alpha * 100)}%'
      self.props.srgb.string = f'{math.round(math.clamp(gr, 0, 1) * 255)} · {math.round(math.clamp(gg, 0, 1) * 255)} · ' ..
         f'{math.round(math.clamp(gb, 0, 1) * 255)}'
      self.props.gamut.string = in_srgb ? '✓ sRGB' : '✗ sRGB'
      self.props.gamut.fill = in_srgb ? t.ok : t.warn
   end

   self.refresh = function()
      if (self.selected != nil) and (self.selected >= #db().palettes) then self.selected = nil end
      palette = selectedPalette()
      if palette and (self.swatch != nil) and (self.swatch >= #palette.swatches) then self.swatch = nil end
      self.updateList()
      updateCards()
      updateInfo()
      self.viewport.acDraw()
   end

   self.selectPalette = function(Index:num)
      if Index is self.selected then return end
      self.selected = Index
      palette = selectedPalette()
      self.swatch = (palette and (#palette.swatches > 0)) ? 0 : nil
      updateCards()
      updateInfo()
      self.viewport.acDraw()
   end

   self.selectSwatch = function(Index:num)
      self.swatch = Index
      for i, card in self.cards do card.setSelected(i is Index) end
      updateInfo()
      self.viewport.acDraw()
   end

   ---------------------------------------------------------------------------------------------------------------
   -- Database actions

   self.newPalette = function()
      palettes = db().palettes
      if #palettes >= colourpalette.MAX_PALETTES then
         flash('database full')
         return
      end
      palettes.push(colourpalette.newPalette(colourpalette.uniquePaletteName(palettes, 'New Palette')))
      Options.save()
      self.filter = ''
      self.search.setText('')
      self.selected = nil
      self.selectPalette(#palettes - 1)
      self.updateList()
      flash('created')
   end

   function fileDialog(Title:str, OkLabel:str, Save:bool, Done:func)
      if self.dialog then return end
      self.dialog = gui.dialog.file({
         title       = Title,
         okLabel     = OkLabel,
         path        = Save ? f'user:{EXPORT_NAME}' : 'user:',
         filterList  = FILE_FILTER,
         allowNew    = Save,
         warnExists  = Save,
         modal       = true,
         popOver     = Picker.window.surface,
         feedback    = function(Dialog, Path, Files)
            self.dialog = nil
            if not self.list or not Files or (#Files is 0) then return end
            Done((Path ?? '') .. Files[0].filename)
         end
      })
   end

   self.importDatabase = function()
      fileDialog('Import Palettes', 'Import', false, function(Path:str)
         local text:str
         try
            text = io.readAll(Path)
         except e
            msg(f'Palette import failed: {e.message}')
            flash('import failed')
            return
         end
         imported, err = colourpalette.databaseFromJSON(text)
         if not imported then
            msg(f'Palette import from {Path} failed: {err}')
            flash('not a palette database')
            return
         end
         added = colourpalette.mergeDatabase(db(), imported)
         Options.save()
         self.refresh()
         flash(f'{added} imported')
      end)
   end

   self.exportDatabase = function()
      fileDialog('Export Palettes', 'Export', true, function(Path:str)
         Options.sync()
         if colourpalette.saveDatabase(Path, db()) then
            flash('exported')
         else
            flash('export failed')
         end
      end)
   end

   ---------------------------------------------------------------------------------------------------------------

   self.show = function()
      Options.sync()
      if (self.selected is nil) or (self.selected is Picker.dbIndex) then
         self.selected = Picker.dbIndex
         active = Picker.state.active
         self.swatch = (active != nil) ? active : ((#selectedPalette().swatches > 0) ? 0 : nil)
      end
      self.viewport.visibility = VIS_VISIBLE
      self.refresh()
   end

   self.hide = function()
      self.viewport.visibility = VIS_HIDDEN
   end

   self.visible = function():bool
      return self.viewport.visibility is VIS_VISIBLE
   end

   -- The widgets that handle Enter themselves

   self.widgets = function():array<table>
      return array<table> { self.list, self.btnNew, self.btnImport, self.btnExport, self.btnEdit }
   end

   self.destroy = function()
      colourpicker_parts.cancelTimer(self.flashTimer)
      self.flashTimer = nil
      self.dialog?.window?.surface?.free()
      self.dialog = nil
      self.list = nil
      self.cards = nil
   end

   return self
end
