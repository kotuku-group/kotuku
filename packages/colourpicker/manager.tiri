-- Palette manager: the Palette tab of the colour picker.  The left panel lists the palettes of the palette database
-- under a search filter, with icon buttons for New, Duplicate, Delete, Import and Export.  The centre panel shows the
-- swatches of the selected palette as cards, and the right panel shows the details of the palette and of the selected
-- swatch, with editable descriptions.  Double-clicking a palette or a swatch card opens it in the Picker tab.
--
-- The read-only starter palettes bundled with the package (colourpalette.loadStarters()) are listed in a second panel
-- under the palette list.  A starter palette can be viewed but not edited or opened: Duplicate, or dragging it to the
-- palette list, adds an editable copy to the database.
--
-- The picker owns the database (picker.db) and supplies the callbacks in Options; see colourpicker_manager.build().

   import 'gui', 'gui/button', 'gui/input', 'gui/listview', 'gui/scrollbar', 'gui/filedialog', 'gui/dialog'
   import 'gui/panel', 'gui/colourpicker/colour', 'gui/colourpicker/palette'
   import './parts', './theme'

   namespace colourpicker_manager { }

PAD          <const> = 14 -- Around the panels
GAP          <const> = 12 -- Between panels
LEFT_W       <const> = 268
RIGHT_W      <const> = 260
INSET        <const> = 10 -- Padding inside a panel body
SEARCH_H     <const> = 26
CLEAR_W      <const> = 22 -- The search box's clear button
BUTTON_H     <const> = 26
ICON_BUTTON  <const> = 22 -- The palette list's icon buttons, as the picker's palette buttons
ICON_GAP     <const> = 6
LIST_ROW_H   <const> = 40
LIST_EDGE    <const> = 4  -- Inset of the rows within a listview
LIST_GAP     <const> = 2  -- Between list rows
STARTER_ROWS <const> = 5  -- The starter list's most visible rows; it scrolls beyond them
STRIP_X      <const> = 8
STRIP_W      <const> = 56
STRIP_H      <const> = 16
CARD_COLS    <const> = 3
CARD_GAP     <const> = 10
CARD_SWATCH  <const> = 64 -- Height of a card's colour block
CARD_H       <const> = CARD_SWATCH + 56
AREA_H       <const> = 84 -- Description areas
AREA_PAD     <const> = 7
AREA_FONT    <const> = 12
AREA_INSET   <const> = 1  -- The border of a description area
AREA_BAR     <const> = 8  -- Thickness of a description area's scrollbar
NAME_LIMIT   <const> = 60
TEXT_LIMIT   <const> = colourpalette.DESCRIPTION_LIMIT
FLASH_TIME   <const> = 1.6
LABEL_FONT   <const> = 10.5
PROP_ROW     <const> = 34
MARKER       <const> = 10 -- The box of a swatch card's state markers
MARKER_GAP   <const> = 4
EXPORT_NAME  <const> = 'palettes.json'
FILE_FILTER  <const> = { { name = 'Palette Databases', ext = '.json' }, { name = 'All Files', ext = '' } }

----------------------------------------------------------------------------------------------------------------------
-- The sRGB hex value of a swatch, gamut-mapped for display.

function swatchHex(S:table):str
   l, c, h = colourmath.gamutMap(S.l, S.c, S.h, 'srgb')
   r, g, b = colourmath.oklchToSrgb(l, c, h)
   return colourmath.toHex(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
end

-- The fill that shows a swatch: its sRGB colour, over the picker's checkerboard (cpChecker) if it is translucent.

function swatchFill(S:table):str
   if S.alpha >= 1 then return swatchHex(S) end
   l, c, h = colourmath.gamutMap(S.l, S.c, S.h, 'srgb')
   r, g, b = colourmath.oklchToSrgb(l, c, h)
   return 'url(#cpChecker);' .. colourmath.toHex(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1),
      S.alpha)
end

-- Swatch state markers in a 10 px box, with the shapes of the picker's palette rows and gamut notice.

function lockGlyph(Target:obj!, X:num!, Y:num!, Fill:str!):obj
   vp = Target.new('VectorViewport', { x = X, y = Y, width = MARKER, height = MARKER })
   vp.new('VectorPath', {
      sequence = 'M3 4.5 V3.25 A2 2 0 0 1 7 3.25 V4.5', stroke = Fill, strokeWidth = 1, lineCap = 'round'
   })
   vp.new('VectorRectangle', { x = 1.5, y = 4.5, width = 7, height = 5, roundX = 1, roundY = 1, fill = Fill })
   return vp
end

function linkGlyph(Target:obj!, X:num!, Y:num!, Stroke:str!):obj
   vp = Target.new('VectorViewport', { x = X, y = Y, width = MARKER, height = MARKER })
   vp.new('VectorPath', {
      sequence = 'M 6 7 V 2 H 0 M 2 4 L 0 2 L 2 0', stroke = Stroke, strokeWidth = 1,
      lineCap = 'round', lineJoin = 'round'
   })
   return vp
end

function warnGlyph(Target:obj!, X:num!, Y:num!, Stroke:str!):obj
   vp = Target.new('VectorViewport', {
      x = X, y = Y, width = MARKER, height = MARKER, viewX = 0, viewY = 0, viewWidth = 12, viewHeight = 12
   })
   vp.new('VectorPath', { sequence = 'M6 1.5 L11 10.5 L1 10.5 Z', stroke = Stroke, strokeWidth = 1.4,
      lineJoin = 'round' })
   vp.new('VectorPath', { sequence = 'M6 5 V7.2 M6 8.3 V8.5', stroke = Stroke, strokeWidth = 1.4, lineCap = 'round' })
   return vp
end

function plural(Count:num, Noun:str):str
   return f'{Count} {Noun}{(Count is 1) ? "" : "s"}'
end

function paletteSummary(Palette:table):str
   return f'{plural(#Palette.swatches, "colour")}  ·  {colourpalette.mode(Palette).label}'
end

-- An uppercase section label in the mono face.

-- Widget theme override for 12 px UI text in an input box of the given height.

function inputText(Height:num):table
   return { text = { fontSize = '12px', x = 6, y = colourpicker_parts.baseline(0, Height - 2, 12) } }
end

function label(Target:obj, X:num, Y:num, Text:str, Tokens:table):obj
   return colourpicker_parts.text(Target, {
      x = X, y = Y, size = LABEL_FONT, face = colourpicker_parts.FACE_MONO, fill = Tokens.fg3, string = Text.upper()
   })
end

----------------------------------------------------------------------------------------------------------------------
-- A palette row in the list: a strip of the palette's colours, its name and a summary.  The palette that the picker
-- is editing is tagged.  The selected palette stays listed while the search hides it; it is dimmed, and its summary
-- says that it is filtered out.  The whole row shows the hand cursor.

function paletteRow(Viewport:obj!, Tokens:table!):table
   theme = gui.getTheme(Viewport)

   t = Tokens
   self = { viewport = Viewport, cells = array<obj>, colours = array<str> }

   -- The cursor is set on a shape rather than the row viewport: a viewport with a cursor takes the input from the
   -- list, but a shape without input subscriptions passes it through.

   Viewport.new('VectorRectangle', { width = '100%', height = '100%', fill = 'rgba(0,0,0,0)', cursor = 'hand' })

   self.highlight = Viewport.new('VectorRectangle', {
      x = 0.5, y = 0.5, xOffset = 0.5, yOffset = 0.5, roundX = 4, roundY = 4, fill = t.accentSoft, stroke = t.accent,
      strokeWidth = 1, visibility = VIS_HIDDEN
   })

   strip_y = math.floor((LIST_ROW_H - STRIP_H) * 0.5)
   self.strip = Viewport.new('VectorViewport', {
      x = STRIP_X, y = strip_y, width = STRIP_W, height = STRIP_H, overflow = VOF_HIDDEN
   })
   Viewport.new('VectorRectangle', {
      x = STRIP_X + 0.5, y = strip_y + 0.5, width = STRIP_W - 1, height = STRIP_H - 1, roundX = 2, roundY = 2,
      fill = 'none', stroke = t.swatchBorder, strokeWidth = 1
   })

   text_x = STRIP_X + STRIP_W + 10
   self.name = colourpicker_parts.text(Viewport, { x = text_x, y = 17, size = 12, fill = t.fg0 })
   self.sub = colourpicker_parts.text(Viewport, {
      x = text_x, y = 32, size = LABEL_FONT, face = colourpicker_parts.FACE_MONO, fill = t.fg3
   })
   self.tag = colourpicker_parts.text(Viewport, {
      y = 17, size = 9.5, face = colourpicker_parts.FACE_MONO, fill = t.accent, align = 'right', string = 'IN PICKER',
      style = 'Bold'
   })

   self.tagWidth = self.tag.textWidth

   -- Fitting a text that has to be shortened is slow, and the rows of a large database are fitted again when the
   -- list's scrollbar appears or disappears.  A row keeps the fitted string for each width of its text, until the
   -- text changes.

   function fitRowText(Vector:obj!, Fit:table!, Text:str!, Width:num!)
      if Fit.text != Text then Fit.{ text = Text, widths = { } } end
      fitted = Fit.widths[Width]
      if fitted then
         if Vector.string != fitted then Vector.string = fitted end
         return
      end
      colourpicker_parts.fitText(Vector, '', Text, Width)
      Fit.widths[Width] = Vector.string
   end

   name_fit, sub_fit = { }, { }

   function fit()
      right = Viewport.width - 8
      if self.tag.x != right then self.tag.x = right end
      tag_w = self.current ? (self.tagWidth + 8) : 0
      fitRowText(self.name, name_fit, self.palette.name, right - text_x - tag_w)
      summary = self.filtered ? f'filtered out  ·  {plural(#self.palette.swatches, "colour")}' :
         paletteSummary(self.palette)
      fitRowText(self.sub, sub_fit, summary, right - text_x)
   end

   -- The list refreshes every shown row when the palettes may have changed (see updateList()), so a row changes only
   -- what differs from its last update: the strip is rebuilt if the number of swatches changes, a cell's fill is set
   -- if its colour changes, and the text is fitted again if the name, the summary or the tag changes.  A hidden row
   -- is brought up to date when it is shown.

   self.set = function(Item:table!)
      palette = Item.palette
      self.palette = palette
      if Item.hidden then
         self.stale = true
         return
      end

      swatches = palette.swatches
      if #swatches != #self.cells then
         for cell in values(self.cells) do cell.free() end
         self.cells.clear()
         self.colours.clear()
         w = STRIP_W / math.max(1, #swatches)
         for i in {0 to #swatches} do
            self.cells.push(self.strip.new('VectorRectangle', { x = i * w, y = 0, width = w + 0.5, height = STRIP_H }))
            self.colours.push('')
         end
      end
      for i, s in swatches do
         colour = f'{s.l} {s.c} {s.h} {s.alpha}'
         if colour != self.colours[i] then
            self.colours[i] = colour
            self.cells[i].fill = swatchFill(s)
         end
      end

      filtered = Item.filtered is true
      state = f'{palette.name}|{#swatches}|{palette.mode}|{Item.current is true}|{filtered}'
      if (state is self.state) and not self.stale then return end
      self.state = state
      self.stale = false
      self.current = Item.current is true
      self.tag.visibility = self.current ? VIS_VISIBLE : VIS_HIDDEN
      self.filtered = filtered
      self.name.fill = filtered ? t.fg3 : t.fg0
      self.strip.opacity = filtered ? 0.45 : 1
      fit()
   end

   self.layout = function(Item:table!)
      if Item.hidden then self.stale = true else fit() end
   end

   -- State is 'active' for the selected palette, 'hover' for the row under the pointer, or nil.  Focused outlines the
   -- list's keyboard target.

   self.setHighlight = function(State:str, Focused:bool)
      if State is 'active' then
         self.highlight.{ visibility = VIS_VISIBLE, fill = t.accentSoft, stroke = theme.palette.prime }
      elseif (State is 'hover') or Focused then
         self.highlight.{
            visibility = VIS_VISIBLE,
            fill = (State is 'hover') ? t.sunk : 'none',
            stroke = Focused ? theme.palette.contrast : t.border
         }
      else
         self.highlight.visibility = VIS_HIDDEN
      end
   end

   return self
end

----------------------------------------------------------------------------------------------------------------------
-- A multi-line text area.  Clicking gives it the focus, which makes the text editable.  A focus loss commits the
-- text through commit(Text).  The placeholder is shown while the area is empty and unfocused.  Text that is taller
-- than the area scrolls: a narrow scrollbar appears, the mouse wheel scrolls, and the caret is kept in view while
-- editing.
--
-- The text is drawn on a page that is moved within a clipping frame inside the border.  The page is the editing
-- viewport (`viewport`): the VectorText edits while its nearest viewport has the focus.  `box` is the bordered area.

function textArea(Target:obj!, Options:table!):table
   t = Options.tokens
   self = { focused = false }
   theme = gui.getTheme(Target)

   box = Target.new('VectorViewport', {
      x = Options.x, y = Options.y, width = Options.width, height = Options.height, overflow = VOF_HIDDEN,
      cursor = 'text'
   })
   self.box = box

   self.bkgd = box.new('VectorRectangle', {
      x = 0.5, y = 0.5, xOffset = 0.5, yOffset = 0.5, roundX = 4, roundY = 4, fill = t.sunk, stroke = t.border,
      strokeWidth = 1
   })

   baseline = AREA_PAD + math.round(AREA_FONT * 0.9)
   self.placeholder = colourpicker_parts.text(box, {
      x = AREA_PAD, y = baseline, size = AREA_FONT, fill = t.fg3, string = Options.placeholder ?? '',
      style = 'Regular'
   })

   -- The scroll area is inset by the border, so that the scrollbar doesn't cover it.

   frame_h = Options.height - (AREA_INSET * 2)
   area = box.new('VectorViewport', { x = AREA_INSET, y = AREA_INSET, xOffset = AREA_INSET, yOffset = AREA_INSET })
   frame = area.new('VectorViewport', { x = 0, y = 0, xOffset = 0, yOffset = 0, overflow = VOF_HIDDEN })
   page = frame.new('VectorViewport', { x = 0, y = 0, width = '100%', height = frame_h, cursor = 'text' })
   self.viewport = page
   self.frame = frame

   -- The scrollbar uses the theme's vertical style if it has one, narrowed for the small area.

   bar_style = gui.getTheme(area).scrollbar_v ? 'scrollbar_v' : 'scrollbar'
   self.scrollbar = gui.scrollbar({
      target = area, view = frame, page = page, direction = 'vertical',
      theme = { [bar_style] = { thickness = AREA_BAR } }
   })

   local fitPage, reveal

   text_style = {
      x = AREA_PAD - AREA_INSET, y = baseline - AREA_INSET, face = colourpicker_parts.FACE_UI,
      fontSize = f'{AREA_FONT}px', fontStyle = 'Regular', lineLimit = 0,
      inlineSize = Options.width - (AREA_PAD * 2) - AREA_BAR
   }

   self.text = page.new('VectorText', table.merge({
      fill = t.fg0, textFlags = VTXF_EDITABLE, charLimit = TEXT_LIMIT,
      onChange = function()
         fitPage()
         reveal()
      end
   }, text_style))

   -- A hidden copy measures the full text extent and the caret's wrapped line without the editor's scroll offset.

   probe = page.new('VectorText', table.merge({ visibility = VIS_HIDDEN }, text_style))

   -- The bottom of a text vector's last line (its baseline), from the top of the page.  Boundaries are in scene
   -- coordinates, which the page's own boundary converts.

   function textBottom(Vector:obj!):num
      err, _, ty, _, th = Vector.mtGetBoundary(0)
      if err != ERR_Okay then return Vector.y end
      _, _, py = page.mtGetBoundary(0)
      return ty + th - py
   end

   -- The page covers the frame and is as tall as the text.  The scroll position is kept unless the page has become
   -- too short for it.

   fitPage = function()
      vt = self.text
      text = vt.string ?? ''

      -- A final glyph preserves an empty last line in the non-editable probe.

      if (#text is 0) or text.endsWith('\n') then text ..= '|' end
      probe.string = text
      height = math.max(frame_h, math.ceil(textBottom(probe) + vt.descent + AREA_PAD))

      if height != page.height then
         page.height = height
         -- The VectorText offsets itself to keep the caret inside its viewport; a move to the same position
         -- recomputes that offset for the new height.
         if self.focused then vt.cursorRow = vt.cursorRow end
      end

      min_y = math.min(0, frame_h - height)
      if page.y < min_y then page.y = min_y end
   end

   -- The text up to the caret (its row and its column in characters), followed by the rest of the caret's word, so
   -- that the probe wraps the caret's line as the text does.  A caret at the start of a line is given a character
   -- to measure, as a trailing empty line has no extent.

   function caretText():str
      text = self.text.string ?? ''
      n = #text
      i = 0
      for {0 to self.text.cursorRow} do
         nl = text.find('\n', i)
         if nl is nil then break end
         i = nl + 1
      end

      column = self.text.cursorColumn
      while (column > 0) and (i < n) do
         i++
         while (i < n) and ((text.byte(i) & 0xc0) is 0x80) do i++ end
         column -= 1
      end

      while (i < n) and (text.byte(i) > 0x20) do i++ end
      prefix = text.sub(0, i)
      if (#prefix is 0) or prefix.endsWith('\n') then prefix ..= '|' end
      return prefix
   end

   -- Scroll the caret's line into view, with the area's padding around it.  The padding matches the page's, so the
   -- first and last lines scroll to the ends of the page.

   reveal = function()
      vt = self.text
      probe.string = caretText()
      line = textBottom(probe)
      top = line - AREA_FONT - AREA_PAD
      bottom = line + vt.descent + AREA_PAD
      view_top = -page.y
      if top < view_top then
         page.y = -math.max(0, top)
      elseif bottom > view_top + frame_h then
         page.y = -math.min(page.height - frame_h, bottom - frame_h)
      end
   end

   function showPlaceholder()
      empty = not ((self.text.string ?? '')??)
      self.placeholder.visibility = (empty and not self.focused) ? VIS_VISIBLE : VIS_HIDDEN
   end

   -- Setting the text scrolls back to the top.

   self.set = function(Text:str)
      if self.focused then return end
      self.text.string = Text ?? ''
      page.y = 0
      fitPage()
      showPlaceholder()
   end

   self.get = function():str
      return (self.text.string ?? '').trim()
   end

   -- True if the text is taller than the area, so that it can be scrolled.

   self.scrolls = function():bool
      return page.height > frame_h
   end

   self.enable = function() box.acEnable() end
   self.disable = function() box.acDisable() end

   -- Clicks are taken from the page: the scrollbar subscribes it to input for the wheel, and it covers the frame.

   page.mtSubscribeInput(JTYPE_BUTTON, function(Input:obj!, Msg:any!)
      repeat
         if (Msg.type is JET_LMB) and (Msg.value is 1) and not self.focused then page.acFocus() end
         Msg = Msg.next
      until not Msg
   end)

   -- Escape leaves the area.  Enter starts a new line, which the VectorText handles.  Other keys can move the caret,
   -- which is revealed once the VectorText has handled the key.

   page.mtSubscribeKeyboard(function(Input:obj!, Qualifiers:num!, Value:num!, Unicode)
      if not (Qualifiers has KQ_PRESSED) then return end
      if Value is KEY_ESCAPE then
         if Options.blur then Options.blur() end
      else
         processing.delayedCall(function()
            if self.focused then reveal() end
         end)
      end
   end)

   page.mtSubscribeFeedback(FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS, function(Input:obj!, Event:num!)
      gained = Event != FM_LOST_FOCUS
      if gained is self.focused then return end
      self.focused = gained
      self.bkgd.stroke = gained ? theme.input.focus.stroke : theme.input.bkgd.stroke
      showPlaceholder()

      if not gained then
         text = self.get()
         text = colourpalette.limitDescription(text)
         self.text.string = text
         fitPage()
         Options.commit(text)
      end

      if Options.focus then Options.focus(gained, self) end
      box.acDraw()
   end)

   showPlaceholder()
   return self
end

----------------------------------------------------------------------------------------------------------------------
-- A swatch card in the centre panel: the colour, the swatch name, its hex value and its OKLCH channels.  A translucent
-- colour is drawn over the checkerboard.  Markers after the name show a swatch reserved for a role of the palette
-- mode (padlock) and a linked swatch (hooked arrow), and a warning after the hex value shows a colour outside sRGB,
-- whose hex value is gamut-mapped.  The pointer outlines the card.  The card grid takes the keyboard focus as a
-- whole (see colourpicker_manager.build()).

function swatchCard(Target:obj!, X:num!, Y:num!, Width:num!, Swatch:table!, State:table!, Tokens:table!):table
   t = Tokens
   card = { locked = State.locked is true, linked = State.linked is true, hovered = false, selected = false }

   theme = gui.getTheme(Target)

   vp = Target.new('VectorViewport', { x = X, y = Y, width = Width, height = CARD_H, cursor = 'hand' })
   card.viewport = vp

   card.bkgd = vp.new('VectorRectangle', {
      x = 1, y = 1, width = Width - 2, height = CARD_H - 2, roundX = 5, roundY = 5, fill = theme.palette.bkgd, stroke = 'none'
   })

   -- The colour block has rounded top corners only, as a path.

   w, r = Width - 1, 5
   card.block = vp.new('VectorPath', {
      sequence = f'M0.5 {CARD_SWATCH + 0.5} V{r + 0.5} A{r} {r} 0 0 1 {r + 0.5} 0.5 H{w - r} ' ..
         f'A{r} {r} 0 0 1 {w} {r + 0.5} V{CARD_SWATCH + 0.5} Z',
      fill = swatchFill(Swatch)
   })

   -- The alpha label's α is drawn, as the mono face lacks the glyph.

   if Swatch.alpha < 1 then
      alpha = colourpicker_parts.text(vp, {
         x = Width - 8, y = 16, size = 10, face = colourpicker_parts.FACE_MONO, style = 'bold', fill = t.fg0, align = 'right',
         string = f'{math.round(Swatch.alpha * 100)}%'
      })
      colourpicker_parts.alphaGlyph(vp, { x = Width - 8 - alpha.textWidth - 10, y = 16, size = 10, fill = t.fg0 })
   end

   -- The markers are right-aligned on the name line, and the name is fitted to the space before them.

   name_y = CARD_SWATCH + 18
   marker_x = Width - 9
   marker_y = name_y - MARKER + 1
   if card.linked then
      marker_x -= MARKER
      card.linkMarker = linkGlyph(vp, marker_x, marker_y, t.fg3)
      marker_x -= MARKER_GAP
   end

   if card.locked then
      marker_x -= MARKER
      card.lockMarker = lockGlyph(vp, marker_x, marker_y, t.fg3)
      marker_x -= MARKER_GAP
   end

   name = colourpicker_parts.text(vp, { x = 9, y = name_y, size = 12, fill = t.fg0 })
   colourpicker_parts.fitText(name, '', Swatch.name, marker_x - 9 - 2)

   hex = colourpicker_parts.text(vp, {
      x = 9, y = CARD_SWATCH + 33, size = 11, face = colourpicker_parts.FACE_MONO, fill = t.fg2,
      string = swatchHex(Swatch)
   })

   _, _, _, in_srgb = colourmath.oklchToSrgb(Swatch.l, Swatch.c, Swatch.h)
   card.inGamut = in_srgb
   if not in_srgb then
      card.gamutMarker = warnGlyph(vp, 9 + math.ceil(hex.textWidth) + 6, CARD_SWATCH + 24, t.warn)
   end

   colourpicker_parts.text(vp, {
      x = 9, y = CARD_SWATCH + 47, size = 10, face = colourpicker_parts.FACE_MONO, fill = t.fg3,
      string = f'L {math.round(Swatch.l * 100)} · C {string.format("%.2f", Swatch.c)} · H {math.round(Swatch.h)}'
   })

   card.ring = vp.new('VectorRectangle', {
      x = 0.5, y = 1, width = Width - 2, height = CARD_H - 2, roundX = 5, roundY = 5, fill = 'none',
      stroke = t.border, strokeWidth = 2
   })

   -- TODO: Panels should be highlighted in their titlebar when they have the focus.

   card.setSelected = function(Selected:bool, PanelHasFocus:bool)
      if Selected then
         card.ring.stroke = theme.palette.contrast
      elseif card.hovered then
         card.ring.stroke = theme.palette.prime
      else
         card.ring.stroke = t.border
      end
      card.selected = Selected
   end

   vp.mtSubscribeInput(JTYPE_CROSSING, function(Input:obj!, Msg:any!)
      repeat
         if Msg.type is JET_CROSSED_IN then
            card.hovered = true
         elseif Msg.type is JET_CROSSED_OUT then
            card.hovered = false
         end
         Msg = Msg.next
      until not Msg

      if card.hovered then
         card.ring.stroke = theme.palette.contrast
      elseif card.selected then
         card.ring.stroke = theme.palette.prime
      else
         card.ring.stroke = t.border
      end

      vp.acDraw()
   end)

   return card
end

----------------------------------------------------------------------------------------------------------------------

@Doc(text=[[
@desc Build the palette manager in a hidden viewport that covers the dialog body.  The manager edits the picker's
database in place and calls `save()` after each change.  Call `show()` to display it, and `destroy()` before the
picker is freed.
@input Picker: the picker entity.  The manager reads `tokens`, `db` (the palette database), `dbID` and `dbIndex`
(the ID and index of the palette that the picker edits), `state.active` (the edited swatch) and `window` (the parent
of its dialogs).  It reads `paletteFolder` and sets it to the folder last used by Import or Export.
@input Target viewport
@input Options: x, y, width and height of the viewport, and the callbacks: `open(Index, Swatch)` edits database palette
Index in the picker, with swatch Swatch if given; `save()` saves the database and returns false if it couldn't;
`sync()` stores the picker's palette in the database; `removePalette(Index)` removes a database palette, switching
the picker to another if it edits that palette, and returns false if it was refused; `focus(Has, Field)` reports
that a text field gained or lost the focus; and `blur()` asks the picker to take the focus from a text field.
@result Table with `viewport`, `show()`, `hide()`, `visible()`, `refresh()` (redraws after the database changes),
`widgets()` (the widgets that handle Enter themselves), `keyPress(Qualifiers, Value)` (returns true if it used a
manager shortcut) and `destroy()`
]])
colourpicker_manager.build = function(Picker:table!, Target:obj!, Options:table!):table
   t = Picker.tokens
   width, height = Options.width, Options.height
   panel_h = height - (PAD * 2)
   centre_w = width - (PAD * 2) - (GAP * 2) - LEFT_W - RIGHT_W

   self = {
      selected = Picker.dbIndex, -- Index of the palette shown in the centre and right panels
      starter  = false,          -- True if selected is an index of the starter palettes, not of the database
      swatch   = nil,            -- Index of the selected swatch in that palette
      filter   = '',
      matches  = 0,              -- The number of palettes that match the filter
      pinned   = nil,            -- Index of the selected palette if it is listed although the filter hides it
      cards    = array<table>,
      cardsFocused = false,      -- True while the card grid has the keyboard focus
      starters = colourpalette.loadStarters() -- Read-only; never part of the database
   }

   self.viewport = Target.new('VectorViewport', {
      x = Options.x, y = Options.y, width = width, height = height, visibility = VIS_HIDDEN
   })

   function db():table
      return Picker.db
   end

   function selectedPalette():table
      if self.selected is nil then return nil end
      return self.starter ? self.starters[self.selected] : db().palettes[self.selected]
   end

   -- True if the database palette at Index is selected

   function isSelected(Index:num):bool
      return (not self.starter) and (Index is self.selected)
   end

   ---------------------------------------------------------------------------------------------------------------
   -- Left: the search box, the palette list and the database buttons, and the starter palettes below them.  The
   -- starter panel fits its rows, up to STARTER_ROWS; it is omitted if there are no starter palettes.

   starter_count = math.min(#self.starters, STARTER_ROWS)
   starter_list_h = (starter_count * (LIST_ROW_H + LIST_GAP)) - LIST_GAP
   starter_h = (starter_count > 0) ? (colourpicker_theme.PANEL_HEADER_H + (INSET * 2) + starter_list_h) : 0
   left_h = panel_h - ((starter_h > 0) ? (starter_h + GAP) : 0)

   left = gui.panel({
      target = self.viewport, x = PAD, y = PAD, width = LEFT_W, height = left_h, title = 'My Palettes',
      padding = colourpicker_parts.PANEL_PADDING
   })
   self.leftPanel = left
   _, left_body_h = left.bodySize()
   inner_w = LEFT_W - (INSET * 2)

   -- The palette and starter lists draw their rows with paletteRow()

   function constructRow(Item:table, Viewport:obj, Reason:str)
      if Reason is 'create' then
         Item.content = paletteRow(Viewport, t)
         Item.content.set(Item)
      elseif Reason is 'update' then
         Item.content.set(Item)
      elseif Reason is 'layout' then
         Item.content.layout(Item)
      elseif Reason is 'destroy' then
         Item.content = nil
      end
   end

   function highlightRow(Item:table, Viewport:obj, Reason:str)
      if Reason is 'selected' then
         Item.content.setHighlight('active')
      else
         Item.content.setHighlight((Reason is 'highlighted') ? 'hover' : nil, Item.viewState.focused)
      end
   end

   self.search = gui.input({
      target = left.body, x = INSET, y = INSET, width = inner_w, height = SEARCH_H, placeholder = 'Search palettes…',
      theme = inputText(SEARCH_H),
      events = {
         -- Keystrokes that arrive in the same message cycle update the list once.

         change = function(Event)
            self.filter = (Event.text ?? '').trim().lower()
            if self.searchPending then return end
            self.searchPending = true
            processing.delayedCall(function()
               self.searchPending = false
               if self.list then self.updateList() end
            end)
         end,

         -- Escape clears the search, then leaves the box, so that a further Escape cancels the dialog.

         keypress = function(Event)
            if Event.value != KEY_ESCAPE then return end
            if self.search.getText()?? then
               self.clearSearch()
            else
               Options.blur()
            end
         end
      }
   })

   self.search.viewport.mtSubscribeFeedback(FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS,
      function(Input:obj!, Event:num!)
         Options.focus(Event != FM_LOST_FOCUS, self.search)
      end)

   -- The clear button is at the right of the search box while it has text.  The text is clipped before the button.

   self.search._textClip.xOffset += CLEAR_W
   self.clearButton = self.search.inputViewport.new('VectorViewport', {
      xOffset = 0, y = 0, width = CLEAR_W, height = '100%', cursor = 'hand', visibility = VIS_HIDDEN
   })
   self.clearButton.new('VectorRectangle', { width = '100%', height = '100%', fill = 'rgba(0,0,0,0)' })
   clear_glyph = self.clearButton.new('VectorViewport', {
      x = math.floor((CLEAR_W - 12) * 0.5), y = math.floor((SEARCH_H - 12) * 0.5), width = 12, height = 12
   })
   clear_glyph.new('VectorEllipse', { cx = 6, cy = 6, radius = 6, fill = t.fg3 })
   clear_glyph.new('VectorPath', {
      sequence = 'M4 4 L8 8 M8 4 L4 8', stroke = t.sunk, strokeWidth = 1.4, lineCap = 'round'
   })
   self.clearButton.mtSubscribeInput(JTYPE_BUTTON, function(Input:obj!, Msg:any!)
      repeat
         if (Msg.type is JET_LMB) and (Msg.value is 0) then
            processing.delayedCall(function()
               if not self.list then return end
               self.clearSearch()
               self.search._textClip.acFocus()
            end)
         end
         Msg = Msg.next
      until not Msg
   end)

   list_y = INSET + SEARCH_H + 8
   buttons_y = left_body_h - INSET - ICON_BUTTON
   list_h = buttons_y - 8 - list_y

   self.list = gui.listView({
      target     = left.body,
      x          = INSET - LIST_EDGE,
      y          = list_y - LIST_EDGE,
      width      = inner_w + (LIST_EDGE * 2),
      height     = list_h + (LIST_EDGE * 2),
      borderless = true,
      showIcons  = false,
      dragDrop   = true,
      rowHeight  = LIST_ROW_H,
      rowSpacing = LIST_GAP,
      scrollDirection = 'vertical',
      theme      = { page = { bkgd = { fill = t.panel } } },
      constructItem = constructRow,
      constructHighlight = highlightRow,

      events = {
         itemSelected = function(View:table, Reason:str, Item:table)
            if Reason is 'user' then self.selectPalette(Item.index, false) end
         end,

         -- Only starter palettes can be dropped on the list.  The copy is inserted after the row under the pointer,
         -- or at the end of the list.

         dragOver = function(View:table, Item:table, Drop:table):bool
            return Drop.session?.starter != nil
         end,

         dragDrop = function(View:table, Item:table, Drop:table)
            starter = Drop.session?.starter
            if not starter then return false end
            index = Item ? (Item.index + 1) : nil
            processing.delayedCall(function()
               if self.list then self.copyStarter(starter, index) end
            end)
         end,

         -- Gaining the focus from the keyboard leaves the list without a keyboard target, so the selected palette's
         -- row becomes the target.  A press on a row sets the target in the same message cycle, so the check is
         -- deferred.

         focus = function(View:table)
            processing.delayedCall(function()
               if self.list and View.hasFocus and not View.kItem and View.sItem then
                  View.targetItem(View.sItem)
               end
            end)
         end,

         -- Double-clicking a row, or Enter on it, opens the palette in the picker

         itemActivated = function(View:table, Reason:str, Item:table)
            if Reason is 'user' then
               index = Item.index
               processing.delayedCall(function() Options.open(index, nil) end)
            end
         end
      }
   })

   self.list.page.new('VectorRectangle', {
      width = '100%', height = '100%', fill = t.panel, cursor = 'hand'
   }).acMoveToBack()

   empty_y = list_y + 28
   self.empty = colourpicker_parts.text(left.body, {
      x = LEFT_W * 0.5, y = empty_y, size = 12, fill = t.fg3, align = 'center', string = 'No matching palettes',
      style = 'Regular'
   })

   -- The icon buttons: the palette actions on the left, and the database's Import and Export on the right.

   function button(X:num, Icon:str, Tip:str, Activate:func):table
      return gui.button({
         target = left.body, x = X, y = buttons_y, height = ICON_BUTTON, icon = Icon, tip = Tip,
         events = { activate = Activate }
      })
   end

   step = ICON_BUTTON + ICON_GAP
   right_btn = INSET + inner_w - ICON_BUTTON
   self.btnNew = button(INSET, 'items/add', 'New palette', function() self.newPalette() end)
   self.btnDuplicate = button(INSET + step, 'page/duplicate', 'Duplicate palette', function()
      self.duplicatePalette()
   end)
   self.btnDelete = button(INSET + (step * 2), 'items/trash', 'Delete palette', function() self.deletePalette() end)
   self.btnImport = button(right_btn - step, 'items/download', 'Import palettes…', function()
      self.importDatabase()
   end)
   self.btnExport = button(right_btn, 'items/upload', 'Export palettes…', function() self.exportDatabase() end)

   -- The starter palettes.  Activating one (double-click or Enter) explains how to edit it; dragging one to the
   -- palette list adds a copy.  The drag carries no data that other applications can use.

   if starter_h > 0 then
      starter_panel = gui.panel({
         target = self.viewport, x = PAD, y = PAD + left_h + GAP, width = LEFT_W, height = starter_h,
         title = 'Starter Palettes', meta = tostring(#self.starters), padding = colourpicker_parts.PANEL_PADDING
      })
      self.starterPanel = starter_panel

      starter_items = array<table>
      for i, p in self.starters do
         starter_items.push({ index = i, name = p.name, palette = p, current = false, filtered = false })
      end

      self.starterList = gui.listView({
         target     = starter_panel.body,
         x          = INSET - LIST_EDGE,
         y          = INSET - LIST_EDGE,
         width      = inner_w + (LIST_EDGE * 2),
         height     = starter_list_h + (LIST_EDGE * 2),
         borderless = true,
         showIcons  = false,
         dragDrop   = true,
         rowHeight  = LIST_ROW_H,
         rowSpacing = LIST_GAP,
         scrollDirection = 'vertical',
         theme      = { page = { bkgd = { fill = t.panel } } },
         items      = starter_items,
         constructItem = constructRow,
         constructHighlight = highlightRow,

         events = {
            itemSelected = function(View:table, Reason:str, Item:table)
               if Reason is 'user' then self.selectPalette(Item.index, true) end
            end,

            focus = function(View:table)
               processing.delayedCall(function()
                  if self.list and View.hasFocus and not View.kItem and View.sItem then
                     View.targetItem(View.sItem)
                  end
               end)
            end,

            itemActivated = function(View:table, Reason:str, Item:table)
               if Reason is 'user' then self.flash('read-only', true) end
            end,

            dragStart = function(View:table, Session:table):table
               palette = self.starters[Session.items[0].index]
               palette ?! return nil
               Session.starter = palette
               fills = array<str>
               for s in values(palette.swatches) do
                  if s.base is nil then fills.push(swatchHex(s)) end
               end
               return {
                  datatypes = string.char(DATA_XML),
                  receipt   = function() return nil end,
                  preview   = colourpicker_parts.paletteDragPreview(Picker.window.surface, fills)
               }
            end
         }
      })

      self.starterList.page.new('VectorRectangle', {
         width = '100%', height = '100%', fill = t.panel, cursor = 'hand'
      }).acMoveToBack()
   end

   ---------------------------------------------------------------------------------------------------------------
   -- Centre: the swatches of the selected palette

   -- The cards are drawn on the panel's scrolled page.  The panel's title is the palette name, which is shortened
   -- before the summary in the meta.  The body is the card grid's tab stop, and is hidden when there is no palette.

   centre = gui.panel({
      target = self.viewport, x = PAD + LEFT_W + GAP, y = PAD, width = centre_w, height = panel_h,
      truncate = 'title', scroll = 'vertical', padding = { left = INSET, right = 4, top = INSET, bottom = INSET }
   })
   self.centrePanel = centre

   area_w, area_h = centre.bodySize()
   self.area = centre.body
   self.page = centre.page
   self.page.height = area_h
   self.page.new('VectorRectangle', { width = '100%', height = '100%', fill = t.panel })
   self.scrollbar = centre.scrollbar
   card_w = math.floor((area_w - self.scrollbar.v_thickness - 4 - (CARD_GAP * (CARD_COLS - 1))) / CARD_COLS)

   -- Edit the swatch at Index of the selected palette in the picker.  Starter palettes can't be edited.

   function openSwatch(Index:num)
      if self.selected is nil then return end
      if self.starter then
         self.flash('read-only', true)
         return
      end
      sel = self.selected
      processing.delayedCall(function() Options.open(sel, Index) end)
   end

   -- Scroll the card at Index into view

   function revealCard(Index:num!)
      top = math.floor(Index / CARD_COLS) * (CARD_H + CARD_GAP)
      view_top = -self.page.y
      if top < view_top then
         self.scrollbar.scrollPage(0, view_top - top)
      elseif top + CARD_H > view_top + area_h then
         self.scrollbar.scrollPage(0, (view_top + area_h) - (top + CARD_H))
      end
   end

   -- The card grid is a single stop in the tab order.  The arrow keys, Home and End select a card, and Enter edits
   -- the selected swatch in the picker.

   self.area.mtSubscribeKeyboard(function(Viewport:obj!, Qualifiers:num!, Value:num!, Unicode)
      if not (Qualifiers has KQ_PRESSED) or (Qualifiers has (KQ_CTRL | KQ_ALT | KQ_COMMAND)) then return end
      palette = selectedPalette()
      palette ?! return
      count = #palette.swatches
      if count is 0 then return end

      i = self.cards.findIndex(Card => Card.index is self.swatch)
      if (Value is KEY_ENTER) or (Value is KEY_NP_ENTER) then
         if i != nil then openSwatch(self.cards[i].index) end
         return
      elseif i is nil then
         if (Value is KEY_LEFT) or (Value is KEY_RIGHT) or (Value is KEY_UP) or (Value is KEY_DOWN) or
            (Value is KEY_HOME) or (Value is KEY_END) then
            i = 0
         else
            return
         end
      elseif Value is KEY_LEFT then
         i = math.max(0, i - 1)
      elseif Value is KEY_RIGHT then
         i = math.min(count - 1, i + 1)
      elseif Value is KEY_UP then
         if i >= CARD_COLS then i -= CARD_COLS end
      elseif Value is KEY_DOWN then
         -- From the row above a shorter last row, Down moves to the last card.
         if math.floor(i / CARD_COLS) < math.floor((count - 1) / CARD_COLS) then
            i = math.min(count - 1, i + CARD_COLS)
         end
      elseif Value is KEY_HOME then
         i = 0
      elseif Value is KEY_END then
         i = count - 1
      else
         return
      end

      index = self.cards[i].index
      if index != self.swatch then self.selectSwatch(index) end
      revealCard(i)
   end)

   self.area.mtSubscribeFeedback(FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS, function(Input:obj!, Event:num!)
      focused = Event != FM_LOST_FOCUS
      if focused is self.cardsFocused then return end
      self.cardsFocused = focused

      if focused and (self.swatch is nil) and (#self.cards > 0) then
         self.selectSwatch(self.cards[0].index)
      else
         for card in values(self.cards) do
            card.setSelected(card.index is self.swatch, focused)
         end
         self.viewport.acDraw()
      end
   end)

   self.noPalette = colourpicker_parts.text(centre.viewport, {
      x = centre_w * 0.5, y = colourpicker_theme.PANEL_HEADER_H + 60, size = 12, fill = t.fg3, align = 'center',
      string = 'Select a palette',
      style = 'Regular', visibility = VIS_HIDDEN
   })

   ---------------------------------------------------------------------------------------------------------------
   -- Right: palette and swatch details

   right_x = PAD + LEFT_W + GAP + centre_w + GAP
   right_inner = RIGHT_W - (INSET * 2)
   pal_h = colourpicker_theme.PANEL_HEADER_H + INSET + 14 + 6 + SEARCH_H + 14 + 14 + 6 + AREA_H + INSET

   info = gui.panel({
      target = self.viewport, x = right_x, y = PAD, width = RIGHT_W, height = pal_h, title = 'Palette',
      padding = colourpicker_parts.PANEL_PADDING
   })
   self.infoPanel = info

   y = INSET + 10
   label(info.body, INSET, y, 'Name', t)
   y += 6
   self.nameInput = gui.input({
      target = info.body, x = INSET, y = y, width = right_inner, height = SEARCH_H, maxLength = NAME_LIMIT,
      theme = inputText(SEARCH_H),
      events = {
         activate = function(Event)
            palette = selectedPalette()
            if not palette or palette.starter or self.refreshing then return end
            renamed, reason = colourpalette.renamePalette(palette, Event.text ?? '', db().palettes)
            if renamed then
               Options.save()
               self.refresh()
            else
               msg(reason)
               self.nameInput.setText(palette.name)
               if (Event.text ?? '').trim()?? then self.flash('name in use') end
            end
         end
      }
   })
   self.nameInput.viewport.mtSubscribeFeedback(FM_HAS_FOCUS | FM_CHILD_HAS_FOCUS | FM_LOST_FOCUS,
      function(Input:obj!, Event:num!)
         Options.focus(Event != FM_LOST_FOCUS, self.nameInput)
      end)

   y += SEARCH_H + 14 + 10
   label(info.body, INSET, y, 'Description', t)
   y += 6
   self.paletteNotes = textArea(info.body, {
      x = INSET, y = y, width = right_inner, height = AREA_H, tokens = t, placeholder = 'Notes about this palette…',
      commit = function(Text:str)
         palette = selectedPalette()
         if not palette or palette.starter or ((palette.description ?? '') is Text) then return end
         palette.description = (#Text > 0) ? Text : nil
         Options.save()
      end,
      focus = Options.focus, blur = Options.blur
   })

   sw_y = PAD + pal_h + GAP
   swatch = gui.panel({
      target = self.viewport, x = right_x, y = sw_y, width = RIGHT_W, height = height - PAD - sw_y,
      title = 'Swatch', padding = colourpicker_parts.PANEL_PADDING
   })
   self.swatchPanel = swatch
   _, sw_body_h = swatch.bodySize()

   self.swatchGroup = swatch.body.new('VectorViewport', { x = 0, y = 0, width = RIGHT_W, height = sw_body_h })
   g = self.swatchGroup

   self.swatchBlock = g.new('VectorRectangle', {
      x = INSET + 0.5, y = INSET + 0.5, width = 47, height = 47, roundX = 6, roundY = 6, stroke = t.swatchBorder,
      strokeWidth = 1, fill = 'white'
   })
   self.swatchName = colourpicker_parts.text(g, { x = INSET + 60, y = INSET + 20, size = 13, fill = t.fg0 })
   self.swatchCss = colourpicker_parts.text(g, {
      x = INSET + 60, y = INSET + 38, size = 11, face = colourpicker_parts.FACE_MONO, fill = t.fg2
   })

   y = INSET + 48 + 22
   label(g, INSET, y, 'Description', t)
   y += 6
   self.swatchNotes = textArea(g, {
      x = INSET, y = y, width = right_inner, height = AREA_H, tokens = t, placeholder = 'Notes about this colour…',
      commit = function(Text:str)
         palette = selectedPalette()
         s = (palette and not palette.starter and (self.swatch != nil)) ? palette.swatches[self.swatch] : nil
         if not s or ((s.description ?? '') is Text) then return end
         s.description = (#Text > 0) ? Text : nil
         Options.save()
      end,
      focus = Options.focus, blur = Options.blur
   })

   -- Properties: two columns of label and value

   y += AREA_H + 22
   label(g, INSET, y, 'Properties', t)
   y += 8
   self.props = { }
   col_w = right_inner * 0.5
   props = array<table> {
      { id = 'l', label = 'Lightness' }, { id = 'c', label = 'Chroma' }, { id = 'h', label = 'Hue' },
      { id = 'alpha', label = 'Alpha' }, { id = 'srgb', label = 'sRGB' }, { id = 'gamut', label = 'In gamut' }
   }
   for i, p in props do
      px = INSET + ((i % 2) * col_w)
      py = y + (math.floor(i / 2) * PROP_ROW)
      label(g, px, py + 12, p.label, t)
      self.props[p.id] = colourpicker_parts.text(g, {
         x = px, y = py + 28, size = 12, face = colourpicker_parts.FACE_MONO, fill = t.fg0
      })
   end

   self.btnEdit = gui.button({
      target = g, x = INSET, y = sw_body_h - INSET - BUTTON_H, width = right_inner, height = BUTTON_H,
      label = 'Edit in Picker', primary = true,
      theme = { text = { fontSize = '11.5px', y = colourpicker_parts.baseline(0, BUTTON_H - 2, 11.5) } },
      events = {
         activate = function()
            if (self.selected != nil) and not self.starter then Options.open(self.selected, self.swatch) end
         end
      }
   })

   self.noSwatch = colourpicker_parts.text(swatch.body, {
      x = RIGHT_W * 0.5, y = 40, size = 12, fill = t.fg3, align = 'center', string = 'No swatch selected',
      style = 'Regular', visibility = VIS_HIDDEN
   })

   ---------------------------------------------------------------------------------------------------------------
   -- Updates

   -- The list's meta is the number of palettes, or the number that match the search and the total.

   function listMeta():str
      total = #db().palettes
      return (self.filter??) ? f'{self.matches} of {total}' : tostring(total)
   end

   -- Show Text in place of the meta of the palette list, or of the starter list if Starter is true, for a moment.

   function flash(Text:str, Starter:bool)
      panel = ((Starter is true) and self.starterPanel) ? self.starterPanel : left
      panel.flash(Text, FLASH_TIME)
   end
   self.flash = flash

   -- Duplicate and Delete act on the selected palette.  The last palette and starter palettes can not be deleted.

   function updateButtons()
      if self.selected != nil then self.btnDuplicate.enable() else self.btnDuplicate.disable() end
      if (self.selected != nil) and not self.starter and (#db().palettes > 1) then
         self.btnDelete.enable()
      else
         self.btnDelete.disable()
      end
   end

   function matches(Palette:table):bool
      if not self.filter?? then return true end
      if Palette.name.lower().find(self.filter, 0, true) then return true end
      return (Palette.description ?? '').lower().find(self.filter, 0, true) != nil
   end

   -- True if the list has an item for each database palette, in order.

   function listedInOrder():bool
      items = self.list.items
      palettes = db().palettes
      if #items != #palettes then return false end
      for i in {0 to #items} do
         if not rawequal(items[i].palette, palettes[i]) then return false end
      end
      return true
   end

   -- The list has a row for every palette, and the search hides the rows that don't match.  The selected palette is
   -- listed even if the search hides it, so that the selection is kept.  Its row is marked as filtered out, and is
   -- hidden when another palette is selected.
   --
   -- Creating the rows of a large database is slow, so the list is rebuilt only if the palettes have been added,
   -- removed or reordered.  Otherwise the items are updated in place and the list is laid out again.  A row is
   -- refreshed if it is shown and its item has changed, or if Refresh is true (the palettes may have been edited),
   -- and it redraws only what has changed (see paletteRow()).

   self.updateList = function(Refresh:bool)
      self.matches = 0
      self.pinned = nil
      shown = 0
      palettes = db().palettes
      in_place = listedInOrder()
      items = in_place ? self.list.items : array<table>
      changed = array<table>
      for i, p in palettes do
         match = matches(p)
         if match then self.matches++ end
         listed = match or isSelected(i)
         if listed then shown++ end
         if (not match) and listed then self.pinned = i end
         current = p.id is Picker.dbID
         if in_place then
            item = items[i]
            if listed and (Refresh or item.hidden or (item.filtered != not match) or (item.current != current) or
               (item.name != p.name)) then
               changed.push(item)
            end
            item.{ name = p.name, current = current, filtered = not match, hidden = not listed }
         else
            items.push({ index = i, palette = p, name = p.name, current = current, filtered = not match,
               hidden = not listed })
         end
      end
      if in_place then
         self.list.relayout()
         for item in values(changed) do self.list.refreshItem(item) end
      else
         self.list.loadItems(items)
      end
      self.empty.visibility = (self.matches is 0) ? VIS_VISIBLE : VIS_HIDDEN
      self.empty.y = empty_y + ((shown > 0) ? (LIST_ROW_H + 2) : 0)
      self.clearButton.visibility = (self.search.getText()??) ? VIS_VISIBLE : VIS_HIDDEN
      updateButtons()
      left.setMeta(listMeta())

      for item in values(self.list.items) do
         if isSelected(item.index) then
            self.list.selectItems(Item => Item is item)
            self.list.revealItem(item)
            if self.list.hasFocus then self.list.targetItem(item) end
            break
         end
      end
      self.viewport.acDraw()
   end

   function updateCards()
      for card in values(self.cards) do card.viewport.free() end
      self.cards.clear()

      palette = selectedPalette()
      self.noPalette.visibility = palette ? VIS_HIDDEN : VIS_VISIBLE
      self.area.visibility = palette ? VIS_VISIBLE : VIS_HIDDEN
      centre.setTitle(palette ? palette.name : '')
      centre.setMeta(palette ? paletteSummary(palette) : '')
      if not palette then return end

      for position, entry in colourpicker_parts.paletteOrder(palette) do
         i = entry.index
         s = palette.swatches[i]
         x = (position % CARD_COLS) * (card_w + CARD_GAP)
         y = math.floor(position / CARD_COLS) * (CARD_H + CARD_GAP)
         card = swatchCard(self.page, x, y, card_w, s, {
            locked = colourpalette.isReserved(palette, i), linked = s.base != nil
         }, t)
         card.index = i
         card.setSelected(i is self.swatch, self.cardsFocused)
         index = i
         card.viewport.mtSubscribeInput(JTYPE_BUTTON, function(Input:obj!, Msg:any!)
            repeat
               if (Msg.type is JET_LMB) and (Msg.value is 1) then
                  if not self.cardsFocused then self.area.acFocus() end
               elseif (Msg.type is JET_LMB) and (Msg.value is 0) then
                  if Msg.flags has JTYPE_DBL_CLICK then
                     openSwatch(index)
                  else
                     self.selectSwatch(index)
                  end
               end
               Msg = Msg.next
            until not Msg
         end)
         self.cards.push(card)
      end

      rows = math.ceil(#palette.swatches / CARD_COLS)
      self.page.height = math.max(area_h, (rows * (CARD_H + CARD_GAP)) - CARD_GAP)
      min_y = math.min(0, area_h - self.page.height)
      if self.page.y < min_y then self.page.y = min_y end
   end

   function updateInfo()
      self.refreshing = true
      defer
         self.refreshing = false
      end

      -- A starter palette is shown, but its name and descriptions can't be edited.

      palette = selectedPalette()
      editable = palette and not palette.starter
      self.nameInput.setText(palette?.name ?? '')
      self.paletteNotes.set(palette?.description ?? '')
      if editable then
         self.nameInput.enable()
         self.paletteNotes.enable()
         self.swatchNotes.enable()
         self.btnEdit.enable()
      else
         self.nameInput.disable()
         self.paletteNotes.disable()
         self.swatchNotes.disable()
         self.btnEdit.disable()
      end
      info.setMeta(palette?.starter ? 'read-only' : '')

      s = (palette and (self.swatch != nil)) ? palette.swatches[self.swatch] : nil
      self.swatchGroup.visibility = s ? VIS_VISIBLE : VIS_HIDDEN
      self.noSwatch.visibility = s ? VIS_HIDDEN : VIS_VISIBLE
      if not s then return end

      self.swatchBlock.fill = swatchFill(s)
      colourpicker_parts.fitText(self.swatchName, '', s.name, RIGHT_W - INSET - 60 - INSET)
      self.swatchCss.string = colourmath.toOklchString(s.l, s.c, s.h, s.alpha)
      self.swatchNotes.set(s.description ?? '')

      _, _, _, in_srgb = colourmath.oklchToSrgb(s.l, s.c, s.h)
      gr, gg, gb = colourmath.oklchToSrgb(colourmath.gamutMap(s.l, s.c, s.h, 'srgb'))
      self.props.l.string = string.format('%.3f', s.l)
      self.props.c.string = string.format('%.3f', s.c)
      self.props.h.string = f'{math.round(s.h)}°'
      self.props.alpha.string = f'{math.round(s.alpha * 100)}%'
      self.props.srgb.string = f'{math.round(math.clamp(gr, 0, 1) * 255)} · {math.round(math.clamp(gg, 0, 1) * 255)} · ' ..
         f'{math.round(math.clamp(gb, 0, 1) * 255)}'
      self.props.gamut.string = in_srgb ? '✓ sRGB' : '✗ sRGB'
      self.props.gamut.fill = in_srgb ? t.ok : t.warn
   end

   self.refresh = function()
      count = self.starter ? #self.starters : #db().palettes
      if (self.selected != nil) and (self.selected >= count) then self.selected = nil end
      palette = selectedPalette()
      if palette and (self.swatch != nil) and (self.swatch >= #palette.swatches) then self.swatch = nil end
      self.updateList(true)
      updateCards()
      updateInfo()
      self.viewport.acDraw()
   end

   -- Select the palette at Index of the database, or of the starter palettes if Starter is true.  Only one of the
   -- lists has a selected row.

   self.selectPalette = function(Index:num, Starter:bool)
      Starter = Starter is true
      if (Index is self.selected) and (Starter is self.starter) then return end
      if (self.pinned != nil) and (Starter or (self.pinned != Index)) then
         self.pinned = nil
         processing.delayedCall(function() if self.list then self.updateList() end end)
      end
      self.selected = Index
      self.starter = Starter
      if Starter then self.list.deselectAll() else self.starterList?.deselectAll() end
      palette = selectedPalette()
      self.swatch = (palette and (#palette.swatches > 0)) ? 0 : nil
      updateCards()
      updateInfo()
      updateButtons()
      self.viewport.acDraw()
   end

   self.selectSwatch = function(Index:num)
      self.swatch = Index
      for card in values(self.cards) do
         card.setSelected(card.index is Index, self.cardsFocused)
      end
      updateInfo()
      self.viewport.acDraw()
   end

   self.clearSearch = function()
      self.search.setText('')
      self.filter = ''
      self.updateList()
   end

   -- Give an input box the focus, with its text selected so that typing replaces it.

   function focusInput(Input:table!)
      Input._textClip.acFocus()
      Input.text.mtSelectArea(0, 0, -1, -1)
      self.viewport.acDraw()
   end

   -- Keys that the dialog passes on while the manager is shown and no text field has the focus.  Returns true if the
   -- key was used.
   --   Ctrl+F, Ctrl+K  Focus the search box.
   --   Delete          Deletes the selected palette while the palette list has the focus (after confirmation).
   --   F2              Renames the selected palette while the palette list has the focus: the name field takes
   --                   the focus, with its text selected.

   self.keyPress = function(Qualifiers:num!, Value:num!):bool
      ctrl = Qualifiers has KQ_CTRL
      if ctrl and ((Value is KEY_F) or (Value is KEY_K)) then
         focusInput(self.search)
         return true
      end

      if ctrl or not self.list.hasFocus then return false end

      if Value is KEY_DELETE then
         processing.delayedCall(function() if self.list then self.deletePalette() end end)
         return true
      elseif Value is KEY_F2 then
         if (self.selected is nil) or self.starter then return false end
         processing.delayedCall(function() if self.list then focusInput(self.nameInput) end end)
         return true
      end

      return false
   end

   ---------------------------------------------------------------------------------------------------------------
   -- Database actions

   self.newPalette = function()
      palettes = db().palettes
      if #palettes >= colourpalette.MAX_PALETTES then
         flash('database full')
         return
      end
      palettes.push(colourpalette.newPalette(colourpalette.uniquePaletteName(palettes, 'New Palette')))
      saved = Options.save()
      self.filter = ''
      self.search.setText('')
      self.selected = nil
      self.selectPalette(#palettes - 1)
      self.updateList()
      if saved then flash('created') end
   end

   -- The copy is inserted after the selected palette and selected.  It has the same name, numbered if that is in use.
   -- A copy of a starter palette is added to the end of the palette list.

   self.duplicatePalette = function()
      if self.selected is nil then return end
      if self.starter then
         self.copyStarter(selectedPalette(), nil)
         return
      end
      Options.sync()
      index = colourpalette.copyPalette(db(), self.selected)
      if index is nil then
         flash('database full')
         return
      end
      saved = Options.save()
      self.selected = nil
      self.selectPalette(index)
      self.updateList()
      if saved then flash('duplicated') end
   end

   -- Add an editable copy of a starter palette to the database at Index (the end if nil), and select it.

   self.copyStarter = function(Starter:table!, Index:num)
      index = colourpalette.insertCopy(db(), Starter, Index)
      if index is nil then
         flash('database full')
         return
      end
      saved = Options.save()
      self.selected = nil
      self.selectPalette(index, false)
      self.updateList()
      if saved then flash('added') end
   end

   -- A modal message over the picker.  Done(Response) is called unless the manager has been destroyed.

   function message(Spec:table!, Done:func)
      if self.messageDialog then return end
      Spec.{ modal = true, popOver = Picker.window.surface }
      Spec.feedback = function(Dialog, Response, State)
         self.messageDialog = nil
         if self.list and Done then Done(Response) end
      end
      self.messageDialog = gui.dialog.message(Spec)
   end

   -- Ask before Action() replaces or removes something.  Label names the action on the confirming button.

   function confirm(Title:str, Text:str, Image:str, Label:str, Action:func)
      message({
         title = Title, message = Text, type = 'question', image = Image,
         options = {
            { id = 0, label = 'Cancel', icon = 'items/cancel' },
            { id = 1, label = Label, icon = 'items/checkmark' }
         }
      }, function(Response)
         if Response?.id is 1 then Action() end
      end)
   end

   function report(Title:str, Text:str, Type:str)
      message({ title = Title, message = Text, type = Type, options = { { id = 0, label = 'OK' } } })
   end

   -- Deleting the palette that the picker edits switches the picker to the palette that takes its place.  The
   -- selection moves to that palette as well.

   self.deletePalette = function()
      palette = selectedPalette()
      if not palette or (#db().palettes <= 1) then return end
      text = f'Are you sure?  The palette "{palette.name}" and its {plural(#palette.swatches, "colour")} will be ' ..
         'deleted.  This can not be undone.'
      if palette.id is Picker.dbID then
         text ..= '  The picker will edit the next palette in the list.'
      end
      confirm('Delete Palette', text, 'items/trash', 'Delete', function()
         index = colourpalette.paletteIndex(db(), palette.id)
         if index is nil then return end
         saved = Options.removePalette(index)
         if colourpalette.paletteIndex(db(), palette.id) != nil then return end -- Refused
         self.selected = nil
         self.selectPalette(math.min(index, #db().palettes - 1))
         self.updateList()
         if saved then flash('deleted') end
      end)
   end

   -- The file dialog opens in the folder last used for Import or Export.  That folder is saved with the picker's
   -- preferences.

   function fileDialog(Title:str, OkLabel:str, Save:bool, Done:func)
      if self.dialog then return end
      folder = Picker.paletteFolder ?? 'user:'
      self.dialog = gui.dialog.file({
         title       = Title,
         okLabel     = OkLabel,
         path        = Save ? (folder .. EXPORT_NAME) : folder,
         filterList  = FILE_FILTER,
         allowNew    = Save,
         warnExists  = Save,
         modal       = true,
         popOver     = Picker.window.surface,
         feedback    = function(Dialog, Path, Files)
            self.dialog = nil
            if not self.list or not Files or (#Files is 0) then return end
            if Path?? then Picker.paletteFolder = Path end
            Done((Path ?? '') .. Files[0].filename)
         end
      })
   end

   -- Import merges the file's palettes into the database.  The result, or the reason that the file was refused, is
   -- reported in a dialog.

   self.importDatabase = function()
      fileDialog('Import Palettes', 'Import', false, function(Path:str)
         _, file = io.splitPath(Path)
         local text:str
         try
            text = io.readAll(Path)
         except e
            print(f'Colour picker: palette import failed: {e.message}')
            report('Import Failed', f'"{file}" could not be read.  {e.message}', 'error')
            return
         end
         imported, err = colourpalette.databaseFromJSON(text)
         if not imported then
            print(f'Colour picker: palette import from {Path} failed: {err}')
            report('Import Failed', f'"{file}" could not be imported.  {err}.', 'error')
            return
         end
         Options.sync()
         added, renamed, full = colourpalette.mergeDatabase(db(), imported)
         saved = Options.save()
         self.refresh()
         if not saved then return end -- The picker reports the failure

         lines = array<str> { f'{plural(added, "palette")} imported from "{file}".' }
         if renamed > 0 then
            lines.push(f'{plural(renamed, "palette")} renamed because the name was already in use.')
         end
         if imported.skipped > 0 then
            lines.push(f'{plural(imported.skipped, "palette")} skipped because the data was not valid.')
         end
         if full > 0 then
            lines.push(f'{plural(full, "palette")} not imported because the database is full ' ..
               f'({colourpalette.MAX_PALETTES} palettes).')
         end
         report('Import Palettes', lines.concat('\n'), (added > 0) ? 'info' : 'warning')
      end)
   end

   -- Export writes a copy of the whole database.  A name without an extension is given .json; as the file dialog
   -- checked the name without it, replacing an existing file is confirmed here.

   function writeExport(Path:str, File:str)
      Options.sync()
      saved, reason = colourpalette.saveDatabase(Path, db(), true)
      if saved then
         flash('exported')
      else
         print(f'Colour picker: palette export failed: {reason}')
         report('Export Failed', f'The palettes could not be exported to "{File}".  {reason}', 'error')
      end
   end

   self.exportDatabase = function()
      fileDialog('Export Palettes', 'Export', true, function(Path:str)
         folder, file = io.splitPath(Path)
         if not file.find('.') then
            file ..= '.json'
            Path = (folder ?? '') .. file
            _, location = mSys.AnalysePath(Path)
            if location is LOC_FILE then
               confirm('Export Palettes', f'"{file}" already exists.  Do you want to replace it?', 'items/upload',
                  'Replace', function() writeExport(Path, file) end)
               return
            end
         end
         writeExport(Path, file)
      end)
   end

   ---------------------------------------------------------------------------------------------------------------

   self.show = function()
      Options.sync()
      if (self.selected is nil) or isSelected(Picker.dbIndex) then
         self.selected = Picker.dbIndex
         self.starter = false
         active = Picker.state.active
         self.swatch = (active != nil) ? active : ((#selectedPalette().swatches > 0) ? 0 : nil)
      end
      self.viewport.visibility = VIS_VISIBLE
      self.refresh()
   end

   self.hide = function()
      self.viewport.visibility = VIS_HIDDEN
   end

   self.visible = function():bool
      return self.viewport.visibility is VIS_VISIBLE
   end

   -- The widgets that handle Enter themselves

   self.widgets = function():array<table>
      widgets = array<table> {
         self.list, self.btnNew, self.btnDuplicate, self.btnDelete, self.btnImport, self.btnExport, self.btnEdit,
         { viewport = self.area }
      }
      if self.starterList then widgets.push(self.starterList) end
      return widgets
   end

   -- The callbacks of the manager's dialogs do nothing once the list is cleared.  Close the file dialog through its
   -- cancellation handler to release its subscriptions and any overwrite confirmation before dropping the reference.

   self.destroy = function()
      self.list = nil
      self.dialog?.window?.events?.close()
      self.dialog = nil
      self.messageDialog?.window?.surface?.free()
      self.messageDialog = nil
      self.starterList = nil
      self.cards = nil
   end

   return self
end
