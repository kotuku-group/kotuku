@Package(name="gui/filedialog", version="1.0")

--[[
Documentation is available in the Kotuku Wiki.
--]]

   import 'gui', 'gui/fileview', 'gui/columnview', 'gui/button', 'gui/combobox', 'gui/input', 'gui/window'

   namespace gui

   gui.dialog ?= { }

GAP <const> = 8

gui.dialog.file = function(Options)
   local target_path, target_file
   if Options.path then target_path, target_file = io.splitPath(Options.path) end

   accepting = false
   closed = false
   local confirm:table -- An open overwrite confirmation

   self = setmetatable(entity { -- Public variables
      windowID    = nil,
      currentPath = target_path,
      multiSelect = Options.multiSelect ?? false,
      warnExists  = Options.warnExists ?? false,
      feedback    = Options.feedback,
      target      = Options.target,
      allowNew    = Options.allowNew
   }, {
      -- Freeing the surface frees the file view's vectors and releases its file system subscriptions.  The window
      -- may have been collected first, in which case its surface has already been freed.

      __gc = function()
         if closed then return end
         closed = true
         local message = confirm
         confirm = nil
         message?.window?.surface?.free()
         &window?.surface?.free()
      end
   })

   function[<weak> self] closeDialog()
      if closed then return end
      closed = true
      accepting = false
      local message = confirm
      confirm = nil
      message?.window?.surface?.free()
      &fileview?.free()
      local window = &window
      &window = nil
      window?.surface?.free()
      local dialog = &&
      dialog.clear()
   end

   -- Report a cancellation, then close the dialog.

   function[<weak> self] cancelDialog()
      if closed then return end
      accepting = true
      &feedback?(&&, nil)
      closeDialog()
      processing.collect('defer')
   end

   function[<weak> self] processFeedback()
      if accepting or closed then return true end
      list = &fileview.view.selectedItems()

      if (#list <= 1) and &filebox then
         -- The filebox has priority over single list selections
         local file = &filebox.getText()
         if file?? then
            list = array<table> { { filename = file } }
         end
      end

      if (&warnExists is true) and (#list > 0) then
         exists = false
         accepted_path = &fileview.path
         for item in values(list) do
            local _, location = mSys.AnalysePath((accepted_path ?? '') .. item.filename)
            if location is LOC_FILE then exists = true end
         end

         if exists then
            accepting = true
            local msg

            if #list is 1 then
               msg = f"You are about to overwrite the file '{list[0].filename}'.  Do you want to continue?"
            else
               msg = f'You are about to overwrite {#list} files.  Do you want to continue?'
            end

            confirm = gui.dialog.message({
               target  = &target,
               modal   = true,
               options = { { id=-1, label='No', icon='items/cancel' },
                           { id=1, label='Yes', icon='items/checkmark' } },
               title   = 'Confirmation Required',
               type    = 'warning',
               message = msg,
               popOver = &windowID,
               feedback = function[<weak> &&](Dialog, Response, State)
                  confirm = nil
                  if closed then return end
                  if Response?.id is 1 and accepting then
                     &feedback?(&&, accepted_path, list)
                     closeDialog()
                  else
                     accepting = false
                  end
               end
            })

            processing.collect('defer')
            return true
         end
      end

      accepting = true
      &feedback?(&&, &fileview.path, #list > 0 ? list : nil)

      closeDialog()
      processing.collect('defer')
      return true
   end

   using self do
      &window = gui.window({
         insideWidth  = gui.rpixel('750dp'),
         insideHeight = gui.rpixel('825dp'),
         minWidth     = gui.rpixel('375dp'),
         minHeight    = gui.rpixel('225dp'),
         quit         = false,
         popOver      = Options.popOver,
         icon         = Options.icon ?? 'icons:folders/folder',
         title        = Options.title ?? 'Select a file',
         modal        = Options.modal ?? false,
         events = {
            close = cancelDialog
         }
      })

      &windowID = &window.surface.id

      theme = &window.theme

      &scene = &window.scene

      &viewport = &window.clientViewport({ })

      &pathbox = gui.input({
         target     = &viewport,
         x          = 0,
         y          = 0,
         xOffset    = 0,
         text       = &currentPath,
         theme      = {
            bkgd = { fill = 'none', stroke = 'none', roundX = 0, roundY = 0 },
            text = { face = gui.fonts.filesys.face }
         },
         events = {
            activate = function[<weak> &&](Event)
               &fileview.browse(Event.text)
            end
         }
      })

      y = &pathbox.viewport.y + &pathbox.viewport.height
      y += gui.separator(&window.viewport, 'H', y)

      -- Okay and cancel buttons

      footer = &window.margins.bottom

      lOkayButton = gui.button({
         target  = &viewport,
         label   = Options.okLabel ?? 'Okay',
         xOffset = GAP,
         yOffset = footer,
         icon    = 'items/checkmark',
         primary = true,
         events  = {
            activate = processFeedback
         }
      })

      lCancelButton = gui.button({
         target  = &viewport,
         label   = Options.cancelLabel ?? 'Cancel',
         xOffset = lOkayButton.viewport.width + (GAP * 2),
         yOffset = footer,
         icon    = 'items/cancel',
         events = {
            activate = cancelDialog
         }
      })

      footer += lOkayButton.viewport.height + GAP

      if Options.allowNew then
         &filebox = gui.input({
            target      = &viewport,
            x           = 0,
            yOffset     = footer,
            xOffset     = 0,
            placeholder = 'Enter file name',
            theme       = {
               bkgd = { fill = 'none', stroke = 'none', roundX = 0, roundY = 0 },
               text = { face = gui.fonts.filesys.face }
            },
            text = target_file,
            events = {
               activate = function(Event:table!)
                  if Event.state is 'activated' then
                     processFeedback()
                  end
               end
            }
         })

         advance = gui.separator(&filebox.viewport, 'H', '100%', nil, nil)

         footer += &filebox.viewport.height + advance
      end

      -- Populate filter selection

      fv_filters = array<table>
      if Options.filterList and (#Options.filterList > 0) then
         if Options.strictFilter then
            -- Pick the first item as being selected if none other is chosen.

            selection = false
            for item in values(Options.filterList) do
               if item.selected then
                  selection = true
                  break
               end
            end

            if not selection then Options.filterList[0].selected = true end
         end

         for filter in values(Options.filterList) do
            fv_filters.push(filter)
         end
      end

      -- File view area

      viewRegion = &viewport.new('VectorViewport', {
         x        = 0,
         y        = y,
         width    = '100%',
         yOffset  = footer,
         overflow = VOF_HIDDEN
      })

      &fileview = gui.fileview({
         target        = viewRegion,
         path          = &currentPath,
         filterList    = fv_filters,
         strictFilter  = Options.strictFilter,
         sysKeys       = true,
         fileSelected  = processFeedback,
         multiSelect   = &multiSelect,
         style         = 'column', -- column, list, tree
         toolbar       = { clipboard=true, settings=true },
         viewOptions   = { },
         events = {
            pathChanged = function[<weak> &&](FileView:table!, Path:str)
               if Path then
                  &currentPath = Path
                  &pathbox.setText(Path)
               end
            end
         }
      })

      &currentPath = &fileview.path -- Ensure consistency

      gui.separator(&window.viewport, 'H', -footer)

      &window.moveToFront()
      &window.show(true)

      return &&
   end
end

-- This sub-routine is provided for languages other than Tiri to utilise the module.

@if(imported=false)
   -- The dialog is retained by a global until the script is freed, as it is closed when it is collected.

   global glDialog = gui.dialog.file({
      popOver      = arg('popOver'),
      target       = arg('target'),
      modal        = arg('modal'),
      okLabel      = arg('okLabel'),
      cancelLabel  = arg('cancelLabel'),
      filterList   = arg('filterList'),
      icon         = arg('icon'),
      path         = arg('path'),
      selectFolder = arg('selectFolder'),
      multiSelect  = arg('multiSelect'),
      userInput    = arg('userInput'),
      allowNew     = arg('allowNew'),
      strictFilter = arg('strictFilter')
   })

   return glDialog.windowID
@end
