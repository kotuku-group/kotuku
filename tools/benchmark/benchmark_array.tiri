-- Goal: Get the first and last elements of an array

@Test function ArrayFirstLastByMethod()
   local checksum = 0
   for i in {0 to 10000} do
      local first_int = glIntArray:first()
      local first_str = glStrArray:first()
      local last_int = glIntArray:last()
      local last_str = glStrArray:last()
      checksum += first_int + last_int + #first_str + #last_str
   end
   return checksum
end

-- Compare with direct indexing

@Test function ArrayFirstLastByIndex()
   local checksum = 0
   for i in {0 to 1000000} do
      local first_int = glIntArray[0]
      local first_str = glStrArray[0]
      local last_int = glIntArray[#glIntArray - 1]
      local last_str = glStrArray[#glStrArray - 1]
      checksum += first_int + last_int + #first_str + #last_str
   end
   return checksum
end

