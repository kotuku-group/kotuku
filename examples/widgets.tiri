      }
   })

   fontButton = gui.button({
      target = viewport,
      label  = 'Select Font',
      x      = colourButton.viewport.x + colourButton.viewport.width + gui.sizing.widget.gap,
      y      = y,
      icon   = 'items/font',
      events = {
         activate = function()
            gui.dialog.font({
               modal    = true,
               popOver  = win.surface,
               feedback = function(Accepted)
