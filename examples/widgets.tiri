#!/usr/bin/env origo
--[[
A demonstration of standard widgets
--]]

   import 'gui', 'gui/toolbar', 'gui/menubar', 'gui/colourdialog', 'gui/fontdialog'
   import 'gui/dialog', 'gui/filedialog', 'gui/icon', 'gui/input', 'gui/button'
   import 'gui/checkbox', 'gui/combobox', 'gui/slider', 'gui/window', 'vfx'

   glSelf = <obj{ obj.find('self') }>
   glPath = <str{ glSelf.workingPath }>

   win = gui.window({ title='Widget Examples', insideWidth=600, insideHeight=400 })
   viewport = win.clientViewport({ aspectRatio = ARF_MEET })

function itemCallback(Bar, Item)
   print(f'Callback: {Item.id}, {Item.name}')
end

-- This callback is activated whenever a menu is activated by the user.

function menuCallback(ID, Name)
   print(f'Callback: {ID}, {Name}')
end

-- This is a universal callback for any menu item that is activated by the user.

function itemClicked(Menu, Item)
   print(f'Selected menu item "{Item.item}" (id: {Item.id ?? "none"})')
end

local menubar:table
local dynamic_item_added = false
local dynamic_name_long = false

function dynamicMenuCallback(ID, Name)
   print(f'Dynamic menubar item selected: {ID}, {Name}')
end

function addDynamicMenuItem(Menu, Item)
   if dynamic_item_added then
      print('The dynamic menubar item already exists.')
      return
   end

   menubar.addItem('dynamic', 'Dynamic', 'items/star', dynamicMenuCallback, array<table>)
   dynamic_item_added = true
   dynamic_name_long = false
   print('Added a callback-only menubar item after initial layout.')
end

function renameDynamicMenuItem(Menu, Item)
   if not dynamic_item_added then
      print('Add the dynamic menubar item before renaming it.')
      return
   end

   dynamic_name_long = not dynamic_name_long
   name = dynamic_name_long ? 'Dynamic Example' : 'Dynamic'
   menubar.setItemText('dynamic', name)
   print(f'Renamed the dynamic menubar item to "{name}".')
end

function removeDynamicMenuItem(Menu, Item)
   if menubar.removeItem('dynamic') then
      dynamic_item_added = false
      dynamic_name_long = false
      print('Removed the dynamic menubar item.')
   else
      print('There is no dynamic menubar item to remove.')
   end
end

function disableViewMenu(Menu, Item)
   menubar.disableItem('view')
   print('Disabled the View menubar item.')
end

function enableViewMenu(Menu, Item)
   menubar.enableItem('view')
   print('Enabled the View menubar item.')
end

function widgetFocus(Widget)
   --if Widget.effect then return end
   --Widget.effect = vfx.shake((Widget.inputViewport ? Widget.viewport), {
   --   seconds = 0.2,
   --   intensity = 0.2,
   --   callback = function(Effect)
   --      Widget.effect = nil
   --   end
   --})
end

   menubar = gui.menubar({
      target = viewport,
      createItems = function(Bar)
         Bar.addItem('file', 'File', 'devices/harddisk', menuCallback, array<table> {
            { group='Documents' },
            {
               id='new', item='New File', icon='items/file_new', qualifier='CTRL', key='N',
               onActivate=itemClicked
            },
            {
               menu={
                  id='open_recent', text='Open Recent', icon='office/documents', items=array<table> {
                     { id='recent_one', item='Project Notes.tiri', onActivate=itemClicked },
                     { id='recent_two', item='Widget Ideas.txt', onActivate=itemClicked },
                     { id='recent_missing', item='Missing Document', disabled=true, onActivate=itemClicked }
                  }
               }
            },
            { id='reload', item='Reload Document', icon='items/reload', key='F5', onActivate=itemClicked },
            { group='Save' },
            {
               id='save', item='Save File', icon='items/file_save', qualifier='CTRL', key='S',
               onActivate=itemClicked
            },
            {
               id='save_as', item='Save As...', icon='items/file_saveas', qualifier='CTRL+SHIFT', key='S',
               disabled=true, onActivate=itemClicked
            }
         })
         Bar.addItem('edit', 'Edit', 'tools/edit', menuCallback, array<table> {
            { id='undo', item='Undo', icon='items/undo', qualifier='CTRL', key='Z', onActivate=itemClicked },
            { id='redo', item='Redo', icon='items/redo', qualifier='CTRL', key='Y', disabled=true,
              onActivate=itemClicked },
            {
               menu={
                  id='clipboard', text='Clipboard', icon='items/clipboard', items=array<table> {
                     { id='cut', item='Cut', icon='tools/cut', qualifier='CTRL', key='X', onActivate=itemClicked },
                     { id='copy', item='Copy', icon='tools/copy', qualifier='CTRL', key='C', onActivate=itemClicked },
                     { id='paste', item='Paste', icon='tools/paste', qualifier='CTRL', key='V', onActivate=itemClicked }
                  }
               }
            }
         })
         Bar.addItem('view', 'View', 'page/page', menuCallback, array<table> {
            { group='Layout' },
            { id='show_grid', item='Show Grid', checkable=true, checked=false, qualifier='CTRL', key='G',
              onActivate=function(Menu, Item) print(f'Grid display enabled: {Item.checked}') end },
            { id='columns', item='Column View', icon='layout/column_three', onActivate=itemClicked },
            { id='list', item='List View', icon='layout/list', onActivate=itemClicked },
            {
               menu={
                  id='zoom', text='Zoom', icon='tools/magnifier', items=array<table> {
                     { id='zoom_in', item='Zoom In', qualifier='CTRL', key='+', onActivate=itemClicked },
                     { id='zoom_out', item='Zoom Out', qualifier='CTRL', key='-', onActivate=itemClicked },
                     { id='zoom_reset', item='Actual Size', qualifier='CTRL', key='0', onActivate=itemClicked }
                  }
               }
            }
         })
         Bar.addItem('tools', 'Tools', 'tools/wizard', menuCallback, array<table> {
            { group='Menubar API' },
            { id='add_dynamic', item='Add Dynamic Item', onActivate=addDynamicMenuItem },
            { id='rename_dynamic', item='Rename Dynamic Item', onActivate=renameDynamicMenuItem },
            { id='remove_dynamic', item='Remove Dynamic Item', onActivate=removeDynamicMenuItem },
            { group='Item State' },
            { id='disable_view', item='Disable View Menu', onActivate=disableViewMenu },
            { id='enable_view', item='Enable View Menu', onActivate=enableViewMenu }
         })
         Bar.addItem('help', 'Help', 'items/help', menuCallback, array<table> {
            { group='Keyboard' },
            { item='Alt or F10 activates the menubar', disabled=true },
            { item='Arrow keys move between menus', disabled=true },
            { item='Tab continues normal focus traversal', disabled=true },
            { group='About' },
            { id='about', item='About Widget Examples', icon='items/info', onActivate=itemClicked }
         })
      end
   })

   y = menubar.viewport.height

   lToolbar = gui.toolbar({
      target      = viewport,
      xOffset     = 0,
      y           = y,
      iconSize    = 22,
      createItems = function(Bar)
         Bar.addGroup(1, 'Navigation', 2)
         Bar.addItem(2, 'Root', 'Root Directory', 'devices/harddisk', itemCallback)
         Bar.addItem(3, 'Parent', 'Parent Folder', 'arrows/arrow_nw', itemCallback)
         Bar.addGroup(4, 'Clipboard', 3)
         Bar.addItem(5, 'Cut', 'Cut', 'tools/not_an_icon', itemCallback)
         Bar.addItem(6, 'Copy', 'Copy', 'tools/copy', itemCallback)
         Bar.addItem(7, 'Paste', 'Paste', 'tools/paste', itemCallback)
         Bar.addGroup(8, 'Actions', 3)
         Bar.addItem(9, 'Create Dir', 'Create Directory', 'folders/folder_new', itemCallback)
         Bar.addBreak()
         Bar.addItem(10, 'Rename', 'Rename', 'layout/interface_textbox', itemCallback)
         Bar.addItem(11, 'Delete', 'Delete', 'tools/eraser', itemCallback)
         Bar.addGroup(12, 'View', 2)
         Bar.addItem(13, 'Column View', 'Column View', 'layout/column_three', itemCallback)
         Bar.addItem(14, 'List View', 'List View', 'layout/list', itemCallback)
      end
   })

   y += lToolbar.viewport.height + 10

   popupMenu = gui.menu({
      --target = win.surface,
      theme  = win.theme.menu,
      x      = 30,
      y      = 50,
      popup  = true,
      onActivate = itemClicked,
      onHighlight = function(Menu, Item)
         print(f'Highlighted menu item: {Item.item}')
      end,
      config = array<table> {
         { group='Files' },
         {
            id='new', item='New File', icon='items/file_new', qualifier='CTRL', key='N'
         },
         {
            menu={
               id='open_recent', text='Open Recent', icon='office/documents', items=array<table> {
                  { id='recent_one', item='Project Notes.tiri' },
                  { id='recent_two', item='Widget Ideas.txt' }
               }
            }
         },
         { id='reload', item='Reload Document', icon='items/reload', key='F5' },
         { id='save', item='Save File', icon='items/file_save', qualifier='CTRL', key='S' },
         { id='save_as', item='Save As...', icon='items/file_saveas', disabled=true },
         { group='Print' },
         { id='print', item='Print', icon='devices/printer', qualifier='CTRL', key='P' },
         { group='Quit' },
         { id='quit', item='Quit', icon='items/quit', qualifier='CTRL', key='Q' }
      }
   })

   input.subscribe(JTYPE_BUTTON, win.surface, 0, function(Surface, Events)
      if Events.type is JET_BUTTON_2 then
         if Events.value is 0 then
            popupMenu.show()
         end
      end
   end)

   text = viewport.new('vectortext', {
      x=win.margins.left, y=y, string='Kōtuku interfaces are drawn using real-time vector graphics',
      face='Noto Sans', fontSize=20, fill=win.theme.window.text, textFlags='!editable'
   })
   font_size = tonumber(text.fontSize)
   text.y += font_size
   y += font_size + 14

   msgButton = gui.button({
      target = viewport,
      text   = 'Message Box',
      x      = win.margins.left,
      y      = y,
      icon   = 'items/question',
      events = {
         activate = function(Widget)
            gui.dialog.message({
               modal         = true,
               image         = 'items/warning',
               title         = 'Hamlet has a question',
               message       = 'To be or not to be?',
               userInput     = 'That is the question',
               checkboxLabel = '\'Tis nobler to suffer',
               options = array<table> {
                  { id=1, text='To be', icon='items/checkmark' },
                  { id=2, text='Not to be', icon='items/cancel' }
               },
               feedback = function(Dialog, Response, State)
                  if Response then
                     print('User selected option ' .. Response.id)
                  end
                  if State then
                     print('User entered string: ' .. (State.input ?? 'NIL'))
                     if State.checkbox then
                        print('The user selected the checkbox.')
                     else
                        print('The checkbox is unselected.')
                     end
                  end
               end
            })
         end,
         focus = widgetFocus
      }
   })

   colourButton = gui.button({
      target = viewport,
      text   = 'Select Colour',
      x      = msgButton.viewport.x + msgButton.viewport.width + 4,
      y      = y,
      icon   = 'tools/palette',
      events = {
         activate = function(Widget)
            gui.dialog.colour({
               modal   = true,
               popOver = win.surface,
               colour  = 'rgb(255,0,0)',
               feedback = function(Colour:table)
                  if not Colour then
                     print('Dialog was cancelled.')
                     return
                  end

                  print(f'The user selected colour is {Colour}')
               end
            })
         end,
         focus = widgetFocus
      }
   })

   fontButton = gui.button({
      target = viewport,
      text   = 'Select Font',
      x      = colourButton.viewport.x + colourButton.viewport.width + 4,
      y      = y,
      icon   = 'items/font',
      events = {
         activate = function(Widget)
            gui.dialog.font({
               okText     = 'Select Font',
               cancelText = 'Exit',
               modal      = true,
               popOver    = win.surface,
               feedback = function(Dialog, Accepted)
                  if not Accepted then
                     print('Dialog was cancelled.')
                  else
                     print("The user selected '" .. Dialog.face .. "', size " .. Dialog.pointSize .. ", style '" .. Dialog.style .. "'")
                     print("This can be compacted to '" .. Dialog.compactFace .. "'")
                  end
               end
            })
         end,
         focus = widgetFocus
      }
   })

   fileButton = gui.button({
      target = viewport,
      text   = 'Select File',
      x      = fontButton.viewport.x + fontButton.viewport.width + 4,
      y      = y,
      icon   = 'folders/folder',
      events = {
         activate = function(Widget)
            gui.dialog.file({
               filterList  = array<table> { { name='MP3 Audio Files', ext='mp3' }, { name='Text Files', ext='txt' } },
               okText      = 'Select File',
               cancelText  = 'Exit',
               modal       = true,
               popOver     = win.surface,
               warnExists  = false,
               multiSelect = true,
               feedback = function(Dialog, Path, Files)
                  if not Files then
                     print('Dialog was cancelled or no files selected.')
                     return
                  end

                  for k, v in ipairs(Files) do
                      print(k, f'{Path} = {v.filename}')
                  end
               end
            })
         end,
         focus = widgetFocus
      }
   })

   y += msgButton.viewport.height + 12

   checkbox = gui.checkbox({
      target = viewport,
      label  = 'Checkbox',
      align  = 'left',
      x      = win.margins.left,
      y      = y,
      events = {
         activate = function(Widget)
         end,
         focus = widgetFocus
      }
   })

   slider = gui.slider({
      target = viewport,
      label  = 'Slider:',
      orientation = 'vertical',
      value  = 1,
      min    = 0.5,
      max    = 1,
      x      = win.viewport.width / 2,
      y      = y,
      events = {
         activate = function(Widget, Value)
         end
      }
   })

   y += checkbox.viewport.height + 12

   combobox = gui.combobox({
      target = viewport,
      label  = 'Combobox:',
      string = 'Your text here',
      x      = win.margins.left, y = y,
      allowCustom = true,
      items = {
         { group='Office' },
         { item='Address Book', icon='office/addressbook' },
         { item='Inbox', icon='office/cabinet_in' },
         { item='Tasks', icon='office/tasks' },
         { item='Finances', icon='office/money' },
         { group='Weather' },
         { item='Snow', icon='weather/snow' },
         { item='Thunder', icon='weather/thunder' }
      },
      events = {
         activate = function(Widget)
         end,
         focus = widgetFocus
      }
   })

   y += combobox.viewport.height + 12

   local input = gui.input({
      target = viewport,
      x      = win.margins.left,
      y      = y,
      width  = 260,
      label  = 'Inputbox: ',
      text   = 'Your text here',
      events = {
         activate = function(Widget, Event)
            print('Input state set to "' .. (Event.state ?? 'NIL') .. '", text "' .. (Event.text ?? 'NIL') .. '"')
         end,
         focus = widgetFocus
      }
   })
   y += input.viewport.height + 16

   try
      global sndAlarm = obj.new('sound', { path=glPath .. 'data/alarm.mp3', volume=0.2 })
   end

   gui.icon({
      target = viewport,
      x      = 20,
      y      = y,
      image  = 'time/alarm',
      text   = 'Alarm',
      size   = 80,
      events = {
         show = function(Icon)
            vfx.fadeIn(Icon.viewport, { seconds=1.0, delay=0.1 })
         end,
         activate = function(Icon)
            if Icon.effect then return end
            Icon.effect = vfx.shake(Icon.viewport, {
               seconds = 1.0,
               intensity = 1.0,
               callback = function(Effect)
                  Icon.effect = nil
               end
            })

            sndAlarm?.acActivate()
         end
      }
   })

   try
      global sndWilhelm = obj.new('sound', { path=glPath .. 'data/wilhelm.mp3', volume=0.2 })
   end

   gui.icon({
      target = viewport,
      x      = 120,
      y      = y,
      image  = 'programs/filemanager',
      text   = 'Wilhelm\'s House',
      events = {
         show = function(Icon)
            vfx.rotate(Icon.viewport, { seconds=0.8 })
            vfx.zoomIn(Icon.viewport, { seconds=0.4, delay=0.3 })
         end,
         activate = function(Icon)
            if Icon.effect then return end

            Icon.effect = vfx.chain({
               vfx.rotate(Icon.viewport, { seconds=0.8 }),
               vfx.zoomOut(Icon.viewport, { seconds=0.8 })
            }, function()
               Icon.viewport.free()
               Icon.viewport = nil
            end)

            sndWilhelm?.acActivate()
         end
      }
   })

   win.show()
   processing.sleep() -- Will sleep until the window sends MSGID_QUIT
