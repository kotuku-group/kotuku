                  id='open_recent', label='Open Recent', icon='office/documents', items=array<table> {
                     { id='recent_one', label='Project Notes.tiri', onActivate=itemClicked },
                     { id='recent_two', label='Widget Ideas.txt', onActivate=itemClicked },
                     { id='recent_missing', label='Missing Document', disabled=true, onActivate=itemClicked }
                  }
               }
            },
            { id='reload', label='Reload Document', icon='items/reload', key='F5', onActivate=itemClicked },
            { group='Save' },
            {
               id='save', label='Save File', icon='items/file_save', qualifier='CTRL', key='S',
               onActivate=itemClicked
            },
            {
               id='save_as', label='Save As...', icon='items/file_saveas', qualifier='CTRL+SHIFT', key='S',
               disabled=true, onActivate=itemClicked
            }
         })
         Bar.addItem('edit', 'Edit', 'tools/edit', menuCallback, array<table> {
            { id='undo', label='Undo', icon='items/undo', qualifier='CTRL', key='Z', onActivate=itemClicked },
            { id='redo', label='Redo', icon='items/redo', qualifier='CTRL', key='Y', disabled=true,
              onActivate=itemClicked },
            {
               menu={
                  id='clipboard', label='Clipboard', icon='items/clipboard', items=array<table> {
