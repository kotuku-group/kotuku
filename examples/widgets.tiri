      }
   })

   y += input.viewport.height + gui.sizing.widget.gap

   hslider = gui.slider({
      target      = viewport,
      label       = 'Slider:',
      labelPos    = 'left',
      labelWidth  = gui.rpixel('150dp'),
      orientation = 'horizontal',
      valuePos    = 'in-centre',
      value       = 1,
      min         = 0.5,
      max         = 1,
      x           = win.margins.left,
      y           = y,
      width       = input.viewport.width,
      events      = {
         activate = function(Value)
         end
      }
   })

   y += hslider.viewport.height + gui.sizing.widget.gap

   -- A multi-line input.  Enter adds a line and Ctrl+Enter activates the input.

   memo = gui.input({
      target     = viewport,
      x          = win.margins.left,
      y          = y,
      width      = input.viewport.width,
      labelWidth = gui.rpixel('150dp'),
      label      = 'Multi-line:',
      multiline  = true,
      text       = 'Enter adds a new line.\nCtrl+Enter activates the input.',
      events     = {
         activate = function(Event)
            print('Multi-line input state set to "' .. (Event.state ?? 'NIL') .. '", text "' ..
               (Event.text ?? 'NIL') .. '"')
         end,
         focus = function()
            widgetFocus(&&)
         end
      }
   })

   y += memo.viewport.height + gui.sizing.widget.gap

   -- A panel in the space between the widget column and the vertical slider, with a scrolling body of wrapped text.
   -- The text is wrapped to the page, less the scrollbar, and the page is sized to fit it when the body is resized.

   local notes_text:obj
   local notes_width, notes_height = 0, 0

   function fitNotes(Panel:table!)
      if not notes_text or (notes_width <= 0) then return end
      notes_text.inlineSize = math.max(1, notes_width - (gui.sizing.widget.gap + gui.sizing.widget.gap) - Panel.scrollbar.v_thickness)
      _, _, ty, _, th = notes_text.mtGetBoundary(0)
      _, _, py = Panel.page.mtGetBoundary(0)
      Panel.page.height = math.max(notes_height, math.ceil(ty + th - py + gui.sizing.widget.gap))
   end

   notes = gui.panel({
      target  = viewport,
      x       = combobox.viewport.x + combobox.viewport.width + (gui.sizing.widget.gap * 2),
      xOffset = vslider.viewport.xOffset + vslider.viewport.width + (gui.sizing.widget.gap * 2),
      y       = toggle.viewport.y,
      height  = gui.rpixel('260dp'),
      title   = 'Panel',
      meta    = 'Scrolling text',
      scroll  = 'vertical',
      events  = {
         resize = function(Width, Height)
            notes_width, notes_height = Width, Height
            fitNotes(&&)
         end
      }
   })

   notes_text = notes.page.new('VectorText', table.merge({
      x = gui.sizing.widget.gap,
      y = gui.getFontHeight({ face='Inconsolata', fontSize='12pt'}),
      lineLimit = 0,
      face = 'Inconsolata',
      fontSize = '12pt',
      textFlags = VTXF_SELECTABLE,
      string = 'A panel is a card with a header row and a body for its content.  The header shows a title on ' ..
         'the left and meta text on the right, and either can be replaced by a widget.\n\n' ..
         'This panel was created with the scroll option, so its body holds a page that is moved by the ' ..
         'scrollbar.  The text is wrapped to the width of the page, and the page is sized to fit the text.\n\n' ..
         'Use the mouse wheel or drag the scrollbar to read the rest of this text.'
   }, win.theme.window.text, false, true))

   fitNotes(notes)

   y = math.max(y, notes.viewport.y + notes.viewport.height) + gui.rpixel('20dp')

   try
      global sndAlarm = obj.new('sound', { path=glPath .. 'data/alarm.mp3', volume=0.2 })
   end

   glAlarmIcon = gui.icon({
      target = viewport,
      x      = gui.rpixel('30dp'),
      y      = y,
      image  = 'time/alarm',
      label  = 'Alarm',
      size   = gui.rpixel('120dp'),
      draggable = true,
      theme = { effect = 'fill(cmap:flare) sheen() emboss() glow(black)' },
      events = {
         show = function()
            vfx.fadeIn(&viewport, { seconds=1.0, delay=0.1 })
         end,
         activate = function()
            if &effect then return end
            &effect = vfx.shake(&viewport, {
               seconds = 1.0,
               intensity = 1.0,
               callback = function(Effect)
                  &effect = nil
               end
            })

            sndAlarm?.acActivate()
         end
      }
   })

   try
      global sndWilhelm = obj.new('sound', { path=glPath .. 'data/wilhelm.mp3', volume=0.2 })
   end

   glHouseIcon = gui.icon({
      target = viewport,
      x      = gui.rpixel('180dp'),
      y      = y,
      image  = 'programs/filemanager',
      label  = 'Wilhelm\'s House',
      draggable = true,
      theme = { effect = 'fill(pearl) glow(colour=#000000)' },
      events = {
         show = function()
            vfx.rotate(&viewport, { seconds=0.8 })
            vfx.zoomIn(&viewport, { seconds=0.4, delay=0.3 })
         end,
         activate = function()
            if &effect then return end

            &effect = vfx.chain({
               vfx.rotate(&viewport, { seconds=0.8 }),
               vfx.zoomOut(&viewport, { seconds=0.8 })
            }, function()
               &viewport.free()
               &viewport = nil
            end)

            sndWilhelm?.acActivate()
         end
      }
   })

   -- Zoom controls are kept in their own viewport above the client viewport so that they are unaffected by the zoom.
   -- Zooming sets the client viewport's view box to a fraction of the window size, so content anchored to the right or
   -- bottom edges is laid out again within the zoomed area.

   zoom = 1.0
   ZOOM_STEP <const> = 1.25

   function applyZoom()
      viewport.{ viewX = 0, viewY = 0, viewWidth = win.surface.width / zoom, viewHeight = win.surface.height / zoom }
      win.surface.mtScheduleRedraw()
   end

   function setZoom(Value:num)
      zoom = math.min(4, math.max(0.25, Value))
      applyZoom()
   end

   win.bkgd.resizeEvent = function(Viewport, Vector, X, Y, Width, Height)
      if zoom != 1 then applyZoom() end
   end

   zoomViewport = win.viewport.new('VectorViewport', {
      xOffset = gui.sizing.widget.gap, y = gui.sizing.widget.gap, width = 1, height = 1
   })

   zoomOutButton = gui.button({
      target = zoomViewport,
      label  = '-',
      tip    = 'Zoom Out',
      x = 0, y = 0, width = 24, height = 24,
      events = { activate = function() setZoom(zoom / ZOOM_STEP) end }
   })

   zoomInButton = gui.button({
      target = zoomViewport,
      label  = '+',
      tip    = 'Zoom In',
      x = zoomOutButton.viewport.width + gui.sizing.widget.gap, y = 0, width = 24, height = 24,
      events = { activate = function() setZoom(zoom * ZOOM_STEP) end }
   })

   zoomViewport.{
      width  = zoomInButton.viewport.x + zoomInButton.viewport.width,
      height = math.max(zoomOutButton.viewport.height, zoomInButton.viewport.height)
   }

   win.show()
   processing.sleep() -- Will sleep until the window sends MSGID_QUIT
