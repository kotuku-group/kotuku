            { group='Menubar API' },
            { id='add_dynamic', label='Add Dynamic Item', onActivate=addDynamicMenuItem },
            { id='rename_dynamic', label='Rename Dynamic Item', onActivate=renameDynamicMenuItem },
            { id='remove_dynamic', label='Remove Dynamic Item', onActivate=removeDynamicMenuItem },
            { group='Item State' },
            { id='disable_view', label='Disable View Menu', onActivate=disableViewMenu },
            { id='enable_view', label='Enable View Menu', onActivate=enableViewMenu }
         })
         Bar.addItem('help', 'Help', 'items/help', menuCallback, array<table> {
            { group='Keyboard' },
            { label='Alt or F10 activates the menubar', disabled=true },
            { label='Arrow keys move between menus', disabled=true },
            { label='Tab continues normal focus traversal', disabled=true },
            { group='About' },
            { id='about', label='About Widget Examples', icon='items/info', onActivate=itemClicked }
