#!/usr/bin/env origo
--[[
A demonstration of standard widgets
--]]

   import 'gui', 'gui/toolbar', 'gui/menubar', 'gui/colourdialog', 'gui/fontdialog'
   import 'gui/dialog', 'gui/filedialog', 'gui/icon', 'gui/input', 'gui/button'
   import 'gui/toggle', 'gui/combobox', 'gui/slider', 'gui/window', 'vfx'

   glSelf = <obj{ obj.find('self') }>
   glPath = <str{ glSelf.workingPath }>

   win = gui.window({ title='Widget Examples', insideWidth=600, insideHeight=500 })
   viewport = win.clientViewport({ aspectRatio = ARF_MEET })

function itemCallback(Bar, Item)
   print(f'Callback: {Item.id}, {Item.name}')
end

-- This callback is activated whenever a menu is activated by the user.

function menuCallback(ID, Name)
   print(f'Callback: {ID}, {Name}')
end

-- This is a universal callback for any menu item that is activated by the user.

function itemClicked(Item)
   print(f'Selected menu item "{Item.label}" (id: {Item.id ?? "none"})')
end

   menubar:table
   dynamic_item_added = false
   dynamic_name_long = false

function dynamicMenuCallback(ID, Name)
   print(f'Dynamic menubar item selected: {ID}, {Name}')
end

function addDynamicMenuItem(Item)
   if dynamic_item_added then
      print('The dynamic menubar item already exists.')
      return
   end

   menubar.addItem('dynamic', 'Dynamic', 'items/star', dynamicMenuCallback, array<table>)
   dynamic_item_added = true
   dynamic_name_long = false
   print('Added a callback-only menubar item after initial layout.')
end

function renameDynamicMenuItem(Menu, Item)
   if not dynamic_item_added then
      print('Add the dynamic menubar item before renaming it.')
      return
   end

   dynamic_name_long = not dynamic_name_long
   name = dynamic_name_long ? 'Dynamic Example' : 'Dynamic'
   menubar.setItemLabel('dynamic', name)
   print(f'Renamed the dynamic menubar item to "{name}".')
end

function removeDynamicMenuItem(Menu, Item)
   if menubar.removeItem('dynamic') then
      dynamic_item_added = false
      dynamic_name_long = false
      print('Removed the dynamic menubar item.')
   else
      print('There is no dynamic menubar item to remove.')
   end
end

function disableViewMenu(Menu, Item)
   menubar.disableItem('view')
   print('Disabled the View menubar item.')
end

function enableViewMenu(Menu, Item)
   menubar.enableItem('view')
   print('Enabled the View menubar item.')
end

function widgetFocus(Widget)
   --if Widget.effect then return end
   --Widget.effect = vfx.shake((Widget.inputViewport ? Widget.viewport), {
   --   seconds = 0.2,
   --   intensity = 0.2,
   --   callback = function(Effect)
   --      Widget.effect = nil
   --   end
   --})
end

   menubar = gui.menubar({
      target = viewport,
      createItems = function(Bar)
         Bar.addItem('file', 'File', 'devices/harddisk', menuCallback, array<table> {
            { group='Documents' },
            {
               id='new', label='New File', icon='items/file_new', qualifier='CTRL', key='N',
               onActivate=itemClicked
            },
            {
               menu={
                  id='open_recent', label='Open Recent', icon='office/documents', items=array<table> {
                     { id='recent_one', label='Project Notes.tiri', onActivate=itemClicked },
                     { id='recent_two', label='Widget Ideas.txt', onActivate=itemClicked },
                     { id='recent_missing', label='Missing Document', disabled=true, onActivate=itemClicked }
                  }
               }
            },
            { id='reload', label='Reload Document', icon='items/reload', key='F5', onActivate=itemClicked },
            { group='Save' },
            {
               id='save', label='Save File', icon='items/file_save', qualifier='CTRL', key='S',
               onActivate=itemClicked
            },
            {
               id='save_as', label='Save As...', icon='items/file_saveas', qualifier='CTRL+SHIFT', key='S',
               disabled=true, onActivate=itemClicked
            }
         })
         Bar.addItem('edit', 'Edit', 'tools/edit', menuCallback, array<table> {
            { id='undo', label='Undo', icon='items/undo', qualifier='CTRL', key='Z', onActivate=itemClicked },
            { id='redo', label='Redo', icon='items/redo', qualifier='CTRL', key='Y', disabled=true,
              onActivate=itemClicked },
            {
               menu={
                  id='clipboard', label='Clipboard', icon='items/clipboard', items=array<table> {
                     { id='cut', label='Cut', icon='tools/cut', qualifier='CTRL', key='X', onActivate=itemClicked },
                     { id='copy', label='Copy', icon='tools/copy', qualifier='CTRL', key='C', onActivate=itemClicked },
                     { id='paste', label='Paste', icon='tools/paste', qualifier='CTRL', key='V', onActivate=itemClicked }
                  }
               }
            }
         })
         Bar.addItem('view', 'View', 'page/page', menuCallback, array<table> {
            { group='Layout' },
            { id='show_grid', label='Show Grid', checkable=true, checked=false, qualifier='CTRL', key='G',
              onActivate=function(Item) print(f'Grid display enabled: {Item.checked}') end },
            { id='columns', label='Column View', icon='layout/column_three', onActivate=itemClicked },
            { id='list', label='List View', icon='layout/list', onActivate=itemClicked },
            {
               menu={
                  id='zoom', label='Zoom', icon='tools/magnifier', items=array<table> {
                     { id='zoom_in', label='Zoom In', qualifier='CTRL', key='+', onActivate=itemClicked },
                     { id='zoom_out', label='Zoom Out', qualifier='CTRL', key='-', onActivate=itemClicked },
                     { id='zoom_reset', label='Actual Size', qualifier='CTRL', key='0', onActivate=itemClicked }
                  }
               }
            }
         })
         Bar.addItem('tools', 'Tools', 'tools/wizard', menuCallback, array<table> {
            { group='Menubar API' },
            { id='add_dynamic', label='Add Dynamic Item', onActivate=addDynamicMenuItem },
            { id='rename_dynamic', label='Rename Dynamic Item', onActivate=renameDynamicMenuItem },
            { id='remove_dynamic', label='Remove Dynamic Item', onActivate=removeDynamicMenuItem },
            { group='Item State' },
            { id='disable_view', label='Disable View Menu', onActivate=disableViewMenu },
            { id='enable_view', label='Enable View Menu', onActivate=enableViewMenu }
         })
         Bar.addItem('help', 'Help', 'items/help', menuCallback, array<table> {
            { group='Keyboard' },
            { label='Alt or F10 activates the menubar', disabled=true },
            { label='Arrow keys move between menus', disabled=true },
            { label='Tab continues normal focus traversal', disabled=true },
            { group='About' },
            { id='about', label='About Widget Examples', icon='items/info', onActivate=itemClicked }
         })
      end
   })

   y = menubar.viewport.height

   lToolbar = gui.toolbar({
      target      = viewport,
      xOffset     = 0,
      y           = y,
      createItems = function(Bar)
         Bar.addGroup(1, 'Navigation', 2)
         Bar.addItem(2, 'Root', 'Root Directory', 'devices/harddisk', itemCallback)
         Bar.addItem(3, 'Parent', 'Parent Folder', 'arrows/arrow_nw', itemCallback)
         Bar.addGroup(4, 'Clipboard', 3)
         Bar.addItem(5, 'Cut', 'Cut', 'tools/not_an_icon', itemCallback)
         Bar.addItem(6, 'Copy', 'Copy', 'tools/copy', itemCallback)
         Bar.addItem(7, 'Paste', 'Paste', 'tools/paste', itemCallback)
         Bar.addGroup(8, 'Actions', 3)
         Bar.addItem(9, 'Create Dir', 'Create Directory', 'folders/folder_new', itemCallback)
         Bar.addBreak()
         Bar.addItem(10, 'Rename', 'Rename', 'layout/interface_textbox', itemCallback)
         Bar.addItem(11, 'Delete', 'Delete', 'tools/eraser', itemCallback)
         Bar.addGroup(12, 'View', 2)
         Bar.addItem(13, 'Column View', 'Column View', 'layout/column_three', itemCallback)
         Bar.addItem(14, 'List View', 'List View', 'layout/list', itemCallback)
      end
   })

   y += lToolbar.viewport.height + 10

   popupMenu = gui.menu({
      --target = win.surface,
      theme  = win.theme.menu,
      x      = 30,
      y      = 50,
      popup  = true,
      onActivate = itemClicked,
      onHighlight = function(Item)
         print(f'Highlighted menu item: {Item.label}')
      end,
      config = array<table> {
         { group='Files' },
         {
            id='new', label='New File', icon='items/file_new', qualifier='CTRL', key='N'
         },
         {
            menu={
               id='open_recent', label='Open Recent', icon='office/documents', items=array<table> {
                  { id='recent_one', label='Project Notes.tiri' },
                  { id='recent_two', label='Widget Ideas.txt' }
               }
            }
         },
         { id='reload', label='Reload Document', icon='items/reload', key='F5' },
         { id='save', label='Save File', icon='items/file_save', qualifier='CTRL', key='S' },
         { id='save_as', label='Save As...', icon='items/file_saveas', disabled=true },
         { group='Print' },
         { id='print', label='Print', icon='devices/printer', qualifier='CTRL', key='P' },
         { group='Quit' },
         { id='quit', label='Quit', icon='items/quit', qualifier='CTRL', key='Q' }
      }
   })

   input.subscribe(JTYPE_BUTTON, win.surface, 0, function(Surface, Events)
      if Events.type is JET_BUTTON_2 then
         if Events.value is 0 then
            popupMenu.show()
         end
      end
   end)

   text = viewport.new('vectortext', table.merge({
      x=win.margins.left, y=y, string='Kōtuku interfaces are drawn using real-time vector graphics',
      face='Noto Sans', fontSize=20, textFlags='!editable'
   }, win.theme.window.text))
   font_size = tonumber(text.fontSize)
   text.y += font_size
   y += font_size + 14

   msgButton = gui.button({
      target = viewport,
      label  = 'Message Box',
      x      = win.margins.left,
      y      = y,
      icon   = 'items/question',
      events = {
         activate = function()
            gui.dialog.message({
               modal         = true,
               image         = 'items/warning',
               title         = 'Hamlet has a question',
               message       = 'To be or not to be?',
               userInput     = 'That is the question',
               checkboxLabel = '\'Tis nobler to suffer',
               options = array<table> {
                  { id=1, label='To be', icon='items/checkmark' },
                  { id=2, label='Not to be', icon='items/cancel' }
               },
               feedback = function(Dialog, Response, State)
                  if Response then
                     print('User selected option ' .. Response.id)
                  end
                  if State then
                     print('User entered string: ' .. (State.input ?? 'NIL'))
                     if State.checkbox then
                        print('The user selected the checkbox.')
                     else
                        print('The checkbox is unselected.')
                     end
                  end
               end
            })
         end,
         focus = widgetFocus
      }
   })

   colourButton = gui.button({
      target = viewport,
      label  = 'Select Colour',
      x      = msgButton.viewport.x + msgButton.viewport.width + 4,
      y      = y,
      icon   = 'tools/palette',
      events = {
         activate = function()
            gui.dialog.colour({
               modal   = true,
               popOver = win.surface,
               colour  = 'rgb(255,0,0)',
               feedback = function(Colour:table)
                  if not Colour then
                     print('Dialog was cancelled.')
                     return
                  end

                  print(f'The user selected colour is {Colour}')
               end
            })
         end,
         focus = widgetFocus
      }
   })

   fontButton = gui.button({
      target = viewport,
      label  = 'Select Font',
      x      = colourButton.viewport.x + colourButton.viewport.width + 4,
      y      = y,
      icon   = 'items/font',
      events = {
         activate = function()
            gui.dialog.font({
               modal      = true,
               popOver    = win.surface,
               feedback = function(Accepted)
                  if not Accepted then
                     print('Dialog was cancelled.')
                  else
                     print("The user selected '" .. &face .. "', size " .. &pointSize .. ", style '" .. &style .. "'")
                  end
               end
            })
         end,
         focus = widgetFocus
      }
   })

   fileButton = gui.button({
      target = viewport,
      label  = 'Select File',
      x      = fontButton.viewport.x + fontButton.viewport.width + 4,
      y      = y,
      icon   = 'folders/folder',
      events = {
         activate = function()
            gui.dialog.file({
               filterList  = array<table> { { name='MP3 Audio Files', ext='mp3' }, { name='Text Files', ext='txt' } },
               okLabel     = 'Select File',
               cancelLabel = 'Exit',
               modal       = true,
               popOver     = win.surface,
               warnExists  = false,
               multiSelect = true,
               feedback = function(Dialog, Path, Files)
                  if not Files then
                     print('Dialog was cancelled or no files selected.')
                     return
                  end

                  for k, v in ipairs(Files) do
                      print(k, f' {Path} = {v.filename}')
                  end
               end
            })
         end,
         focus = widgetFocus
      }
   })

   y += msgButton.viewport.height + gui.sizing.widget.gap

   toggle = gui.toggle({
      target = viewport,
      label  = 'Toggle:',
      labelWidth = 90,
      labelPos = 'left',
      x      = win.margins.left,
      y      = y,
      events = {
         activate = function()
         end,
         focus = widgetFocus
      }
   })

   vslider = gui.slider({
      target = viewport,
      label  = 'Slider:',
      labelPos = 'bottom',
      orientation = 'vertical',
      value  = 1,
      valuePos = 'in-centre',
      min    = 0.5,
      max    = 1,
      x      = win.viewport.width / 2,
      y      = y,
      events = {
         activate = function(Value)
         end
      }
   })

   y += toggle.viewport.height + gui.sizing.widget.gap

   combobox = gui.combobox({
      target = viewport,
      label  = 'Combobox:',
      labelWidth = 90,
      text   = 'Your text here',
      x      = win.margins.left, y = y,
      allowCustom = true,
      items = {
         { group='Office' },
         { label='Address Book', icon='office/addressbook' },
         { label='Inbox', icon='office/cabinet_in' },
         { label='Tasks', icon='office/tasks' },
         { label='Finances', icon='office/money' },
         { group='Weather' },
         { label='Snow', icon='weather/snow' },
         { label='Thunder', icon='weather/thunder' }
      },
      events = {
         activate = function()
         end,
         focus = widgetFocus
      }
   })

   y += combobox.viewport.height + gui.sizing.widget.gap

   local input = gui.input({
      target = viewport,
      x      = win.margins.left,
      y      = y,
      width  = 260,
      labelWidth = 90,
      label  = 'Inputbox:',
      text   = 'Your text here',
      events = {
         activate = function(Event)
            print('Input state set to "' .. (Event.state ?? 'NIL') .. '", text "' .. (Event.text ?? 'NIL') .. '"')
         end,
         focus = function()
            widgetFocus(&&)
         end
      }
   })

   y += input.viewport.height + gui.sizing.widget.gap

   hslider = gui.slider({
      target = viewport,
      label  = 'Slider:',
      labelPos = 'left',
      labelWidth = 90,
      orientation = 'horizontal',
      valuePos = 'in-centre',
      value  = 1,
      min    = 0.5,
      max    = 1,
      x      = win.margins.left,
      y      = y,
      events = {
         activate = function(Value)
         end
      }
   })

   y += input.viewport.height + 80

   try
      global sndAlarm = obj.new('sound', { path=glPath .. 'data/alarm.mp3', volume=0.2 })
   end

   glAlarmIcon = gui.icon({
      target = viewport,
      x      = 20,
      y      = y,
      image  = 'time/alarm',
      label  = 'Alarm',
      size   = 80,
      draggable = true,
      theme = { effect = 'fill(cmap:flare) sheen() emboss() glow(black)' },
      events = {
         show = function()
            vfx.fadeIn(&viewport, { seconds=1.0, delay=0.1 })
         end,
         activate = function()
            if &effect then return end
            &effect = vfx.shake(&viewport, {
               seconds = 1.0,
               intensity = 1.0,
               callback = function(Effect)
                  &effect = nil
               end
            })

            sndAlarm?.acActivate()
         end
      }
   })

   try
      global sndWilhelm = obj.new('sound', { path=glPath .. 'data/wilhelm.mp3', volume=0.2 })
   end

   glHouseIcon = gui.icon({
      target = viewport,
      x      = 120,
      y      = y,
      image  = 'programs/filemanager',
      label  = 'Wilhelm\'s House',
      draggable = true,
      theme = { effect = 'fill(pearl) glow(colour=#000000)' },
      events = {
         show = function()
            vfx.rotate(&viewport, { seconds=0.8 })
            vfx.zoomIn(&viewport, { seconds=0.4, delay=0.3 })
         end,
         activate = function()
            if &effect then return end

            &effect = vfx.chain({
               vfx.rotate(&viewport, { seconds=0.8 }),
               vfx.zoomOut(&viewport, { seconds=0.8 })
            }, function()
               &viewport.free()
               &viewport = nil
            end)

            sndWilhelm?.acActivate()
         end
      }
   })

   win.show()
   processing.sleep() -- Will sleep until the window sends MSGID_QUIT
