#!/usr/bin/env origo
--[[
Supershape Demonstration
--]]

   import 'gui', 'gui/window', 'gui/combobox', 'gui/slider', 'gui/panel', 'gui/button', 'gui/listview', 'json'

local glWindow, glViewport, glShapeView, glShape, glSavedPanel, glSavedList, glModeCombo, glModCombo, glRemoveButton
local glClipboard

glSliders    = { } -- Slider widgets, keyed by label
glSliderList = array<str> -- Slider labels in creation order, so that restoration applies them in a fixed order
glSaveCount  = 0

widgets = array<table>
glY     = 0
glMode  = 'Shape'
glCount = 5

PANEL_WIDTH = gui.rpixel('400dp')
FILL_COLOUR <const> = '#65b5df'
ROW_HEIGHT <const> = 56
SAVE_PATH <const> = 'user:config/supershapes.json'

-- Shape fields copied into a saved row.  Order matters: setting vertices clears tolerance, so tolerance comes after.

SHAPE_FIELDS <const> = array<str> { 'm', 'n1', 'n2', 'n3', 'a', 'b', 'phi', 'radius', 'vertices', 'tolerance', 'mod' }

MODS <const> = array<str> {
   'None', 'exp(r)', 'log(r)', 'atan(r)', 'exp(1/r)', '1+cos(r)^2', 'sin(r)^2', '1+sin(r)^2', 'cos(r)^2'
}

----------------------------------------------------------------------------------------------------------------------

function redraw()
   glShapeView.scene.surface.mtScheduleRedraw()
end

----------------------------------------------------------------------------------------------------------------------
-- Repeat and Spiral are mutually exclusive, so only the field for the active mode receives the count.  Spirals are
-- drawn as open strokes because closing them would draw a line back to the centre.

function applyModeTo(Shape:obj!, Mode:str!, Count:num!)
   Shape.repeat = (Mode is 'Repeat') ? Count : 0
   Shape.spiral = (Mode is 'Spiral') ? Count : 0
   Shape.close  = (Mode is 'Spiral') ? 0 : 1
   Shape.fill   = (Mode is 'Spiral') ? 'none' : FILL_COLOUR
   Shape.stroke = (Mode is 'Spiral') ? FILL_COLOUR : 'none'
end

function applyMode()
   applyModeTo(glShape, glMode, glCount)
end

----------------------------------------------------------------------------------------------------------------------
-- Keep the widget range above zero: the slider's default-value handling treats zero as an unset value.

function addSlider(Label:str, Value:num, Min:num, Max:num, Step:num, Apply:func)
   caption_format = (Step and Step % 1 is 0) ? '%s' : '%s: %.2f'

   slider = gui.slider({
      target = glViewport, x = glWindow.margins.left, y = glY, width = PANEL_WIDTH - (glWindow.margins.left * 2),
      step = Step, valuePos='in-max',
      min = Min, max = Max, value = Value, labelPos = 'in-min', label = Label,
      events = {
         activate = function(Position:num)
            value = Position
            Apply(value)
            redraw()
         end
      }
   })

   glSliders[Label] = slider
   glSliderList.push(Label)
   glY += slider.viewport.height + gui.sizing.widget.gap
end

----------------------------------------------------------------------------------------------------------------------
-- Saved shapes.  An entry records the shape fields for drawing its thumbnail, and the widget values for restoring
-- the main view.

function saveShape()
   glSaveCount++

   fields = { }
   for field in values(SHAPE_FIELDS) do fields[field] = glShape[field] end

   slider_values = { }
   for label, slider in pairs(glSliders) do slider_values[label] = slider.value end

   glSavedList.addItem({
      name    = f'Shape {glSaveCount}',
      fields  = fields,
      sliders = slider_values,
      mode    = glMode,
      count   = glCount,
      modName = glModCombo.text.string
   })
end

----------------------------------------------------------------------------------------------------------------------

function updateRemoveButton()
   if not glRemoveButton then return end
   if #glSavedList.selectedItems() > 0 then glRemoveButton.enable() else glRemoveButton.disable() end
end

function removeSelectedShapes()
   for item in values(glSavedList.selectedItems()) do glSavedList.removeItem(item) end
   updateRemoveButton()
end

----------------------------------------------------------------------------------------------------------------------
-- Express the active shape as an SVG element.  The attributes mirror those written by the SVG exporter, and the
-- element declares the Kotuku namespace itself so that it can be pasted into any SVG document.

function shapeSVG():str
   spiral = (glMode is 'Spiral')
   attribs = array<str> {
      'xmlns:kotuku="http://www.kotuku.dev/xmlns/svg"',
      string.format('cx="%g" cy="%g" r="%g"', glShape.cx, glShape.cy, glShape.radius),
      string.format('m="%g" n1="%g" n2="%g" n3="%g"', glShape.m, glShape.n1, glShape.n2, glShape.n3),
      string.format('a="%g" b="%g" phi="%g"', glShape.a, glShape.b, glShape.phi)
   }

   tolerance = glShape.tolerance
   if tolerance != 0 then
      if tolerance != 0.25 then attribs.push(string.format('tolerance="%g"', tolerance)) end
   else
      attribs.push(f'vertices="{glShape.vertices}"')
   end

   if glShape.mod != 0 then attribs.push(f'mod="{glShape.mod}"') end
   if glMode is 'Repeat' then attribs.push(f'repeat="{glCount}"') end

   if spiral then
      attribs.push(f'spiral="{glCount}" close="false" fill="none" stroke="{FILL_COLOUR}" stroke-width="1.5"')
      attribs.push('stroke-linejoin="round" stroke-linecap="round"')
   else
      attribs.push(f'fill="{FILL_COLOUR}" fill-rule="evenodd"')
   end

   return '<kotuku:shape ' .. attribs.concat(' ') .. '/>'
end

----------------------------------------------------------------------------------------------------------------------

function copyShapeToClipboard()
   glClipboard ?= obj.new('clipboard')
   if glClipboard.mtAddText(shapeSVG()) != ERR_Okay then
      print('The shape could not be copied to the clipboard.')
   end
end

----------------------------------------------------------------------------------------------------------------------
-- Restoration goes through the widgets, so that their activate events update the shape and the controls agree with
-- it.  The mode is applied last because the Repeat / Spirals slider applies the mode that is current at the time.

function restoreShape(Item:table!)
   for label in values(glSliderList) do
      if Item.sliders[label] != nil then glSliders[label].setValue(Item.sliders[label]) end
   end

   -- The saved sampling is reapplied directly.  The Vertices slider always applies a fixed count, which clears
   -- adaptive sampling, and it applies nothing when its value is unchanged.
   if (Item.fields.tolerance ?? 0) > 0 then
      glShape.tolerance = Item.fields.tolerance
   elseif Item.fields.vertices then
      glShape.vertices = Item.fields.vertices
   end

   glMode  = Item.mode
   glCount = Item.count
   glModeCombo.setText(Item.mode)
   glModCombo.setText(Item.modName)
   glShape.mod = Item.fields.mod
   applyMode()
   redraw()
end

----------------------------------------------------------------------------------------------------------------------

function summary(Item:table!):str
   f = Item.fields
   text = string.format('m %g  n %.3g, %.3g, %.3g', f.m, f.n1, f.n2, f.n3)
   if Item.mode != 'Shape' then text ..= f'  {Item.mode} {Item.count}' end
   return text
end

----------------------------------------------------------------------------------------------------------------------
-- Each row is a custom viewport: a thumbnail viewport that redraws the stored supershape at a reduced scale, and the
-- name and parameters of the entry.  The built-in highlight does not recolour client content, so the text follows
-- the selection itself.

function constructSavedRow(Item:table, Viewport:obj, Reason:str)
   theme = gui.getTheme(glViewport)

   if Reason is 'create' then
      _, _, ascent = gui.getFontHeight(theme.list.text)
      size = ROW_HEIGHT - 8

      thumb = Viewport.new('VectorViewport', {
         x = 4, y = 4, width = size, height = size, viewWidth = 640, viewHeight = 640,
         aspectRatio = ARF_X_MID|ARF_Y_MID|ARF_MEET, overflow = 'hidden'
      })
      thumb.new('VectorRectangle', { width = '100%', height = '100%', cornerX = 64, cornerY = 64, fill = '#f5f7fa' })

      shape = thumb.new('VectorShape', {
         cx = 320, cy = 320, fillRule = 'evenodd', strokeWidth = 12, lineJoin = 'round', lineCap = 'round'
      })
      for field in values(SHAPE_FIELDS) do
         if Item.fields[field] != nil then shape[field] = Item.fields[field] end
      end
      applyModeTo(shape, Item.mode, Item.count)

      font = gui.fontStyle(theme.list.text)
      Item.content = {
         name   = Viewport.new('VectorText', { x = size + 14, y = math.round(ROW_HEIGHT * 0.5) - 2,
            string = Item.name, fontStyle = font }),
         detail = Viewport.new('VectorText', { x = size + 14, y = math.round(ROW_HEIGHT * 0.5) + ascent + 2,
            string = summary(Item), fontStyle = font, opacity = 0.7 })
      }
   end

   if Item.content and ((Reason is 'create') or (Reason is 'state') or (Reason is 'update')) then
      fill = Item.viewState.selected ? theme.list.textSelect : theme.list.text.fill
      Item.content.name.fill = fill
      Item.content.detail.fill = fill
   end
end

----------------------------------------------------------------------------------------------------------------------
-- Persistence.  Only the entry data is written; the list adds its own private fields to items, so they are not
-- encoded directly.  A missing file is normal on first run, and a damaged file is reported and ignored rather than
-- stopping the demo.

function storeShapes()
   entries = array<table>
   for item in values(glSavedList.items) do
      entries.push({
         name = item.name, fields = item.fields, sliders = item.sliders, mode = item.mode, count = item.count,
         modName = item.modName
      })
   end

   try
      io.writeAll(SAVE_PATH, json.encode({ version = 1, shapes = entries }))
   except e
      print(f'Failed to save {SAVE_PATH}: {e.message}')
   end
end

function loadShapes()
   err, location = mSys.AnalysePath(SAVE_PATH)
   if (err != ERR_Okay) or (location != LOC_FILE) then return end

   try
      data = json.decode(io.readAll(SAVE_PATH))
      if (data is <table>) and (data.shapes is <array>) then
         entries = array<table>
         for entry in values(data.shapes) do
            if (entry is <table>) and (entry.fields is <table>) and (entry.sliders is <table>) then
               entries.push({
                  name    = tostring(entry.name ?? f'Shape {#entries + 1}'),
                  fields  = entry.fields,
                  sliders = entry.sliders,
                  mode    = (entry.mode is <str>) ? entry.mode : 'Shape',
                  count   = (entry.count is <num>) ? entry.count : 5,
                  modName = (entry.modName is <str>) ? entry.modName : MODS[0]
               })
            end
         end

         if #entries > 0 then glSavedList.addItems(entries) end
      end
   except e
      print(f'Failed to load {SAVE_PATH}: {e.message}')
   end

   glSaveCount = #glSavedList.items
end

----------------------------------------------------------------------------------------------------------------------

function buildSavedPanel()
   BUTTON_SPACE <const> = gui.rpixel('38dp')
   BUTTON_HEIGHT <const> = gui.rpixel('28dp')

   glSavedPanel = gui.panel({
      target  = glViewport,
      x       = glWindow.margins.left,
      y       = glY,
      width   = PANEL_WIDTH - (glWindow.margins.left * 2),
      yOffset = glWindow.margins.bottom,
      title   = 'Saved Shapes',
      flush   = true,
      padding = { bottom = BUTTON_SPACE }
   })

   glSavedList = gui.listView({
      target          = glSavedPanel.body,
      borderless      = true,
      scrollDirection = 'vertical',
      sensitive       = true,
      rowHeight       = ROW_HEIGHT,
      constructItem   = constructSavedRow,
      events = {
         itemActivated = function(View, Reason, Item)
            restoreShape(Item)
         end,
         itemSelected = function()
            updateRemoveButton()
         end,
         itemDeselected = function()
            updateRemoveButton()
         end
      }
   })

   gui.button({
      target = glSavedPanel.viewport,
      icon   = 'items/add',
      tip    = 'Save the current shape',
      xOffset = (BUTTON_SPACE - BUTTON_HEIGHT) * .5,
      yOffset = (BUTTON_SPACE - BUTTON_HEIGHT) * .5,
      height  = BUTTON_HEIGHT,
      events = {
         activate = function()
            saveShape()
         end
      }
   })

   glRemoveButton = gui.button({
      target   = glSavedPanel.viewport,
      icon     = 'items/trash',
      tip      = 'Remove the selected shape',
      disabled = true,
      xOffset  = (BUTTON_SPACE - BUTTON_HEIGHT) * .5 + BUTTON_SPACE,
      yOffset  = (BUTTON_SPACE - BUTTON_HEIGHT) * .5,
      height   = BUTTON_HEIGHT,
      events = {
         activate = function()
            removeSelectedShapes()
         end
      }
   })

   gui.button({
      target  = glSavedPanel.viewport,
      icon    = 'items/clipboard',
      tip     = 'Copy the current shape to the clipboard as SVG',
      x       = (BUTTON_SPACE - BUTTON_HEIGHT) * .5,
      yOffset = (BUTTON_SPACE - BUTTON_HEIGHT) * .5,
      height  = BUTTON_HEIGHT,
      events = {
         activate = function()
            copyShapeToClipboard()
         end
      }
   })
end

----------------------------------------------------------------------------------------------------------------------

function buildScene()
   glY = glWindow.margins.top

   glShapeView = glViewport.new('VectorViewport', {
      x = PANEL_WIDTH, y = 0, xOffset = 0, yOffset = 0,
      viewWidth = 640, viewHeight = 640, aspectRatio = ARF_X_MID|ARF_Y_MID|ARF_SLICE,
      overflow = 'hidden'
   })

   glShapeView.new('VectorRectangle', { width = '100%', height = '100%', fill = '#f5f7fa' })

   glShape = glShapeView.new('VectorShape', {
      name = 'supershape', cx = 320, cy = 320, radius = 260,
      m = 6, n1 = 1, n2 = 7, n3 = 8, a = 1, b = 1, phi = 2, close = false,
      fill = FILL_COLOUR, fillRule = 'evenodd', stroke = 'none', strokeWidth = 1.5,
      lineJoin = 'round', lineCap = 'round'
   })

   addSlider('Symmetry', glShape.m, 0, 20, 1, function(Value:num) glShape.m = Value end)

   addSlider('N1', glShape.n1, 0.1, 20, nil, function(Value:num) glShape.n1 = Value end)

   addSlider('N2', glShape.n2, 0, 20, nil, function(Value:num) glShape.n2 = Value end)

   addSlider('N3', glShape.n3, 0, 20, nil, function(Value:num) glShape.n3 = Value end)

   addSlider('A', glShape.a, 0.1, 3, nil, function(Value:num) glShape.a = Value end)

   addSlider('B', glShape.b, 0.1, 3, nil, function(Value:num) glShape.b = Value end)

   addSlider('Sweep', glShape.phi, 2, 100, 1, function(Value:num) glShape.phi = math.floor(Value) end)

   addSlider('Radius', glShape.radius, 10, 440, 1, function(Value:num) glShape.radius = Value end)

   addSlider('Vertices', glShape.vertices, 3, 1440, 1, function(Value:num)
      if Value > 3 then
         glShape.vertices = math.floor(Value)
      else
         glShape.tolerance = 0.25
      end
   end)

   addSlider('Repeat / Spirals', glCount, 1, 20, 1, function(Value:num)
      glCount = math.floor(Value)
      applyMode()
   end)

   glModeCombo = gui.combobox({
      target = glViewport,
      label  = 'Mode:',
      labelWidth = gui.rpixel('70dp'),
      text   = glMode,
      x      = glWindow.margins.left,
      y      = glY,
      items  = array<table> { { label = 'Shape' }, { label = 'Repeat' }, { label = 'Spiral' } },
      events = {
         activate = function(Item:table!)
            glMode = Item.label
            applyMode()
            redraw()
         end
      }
   })
   glY += glModeCombo.viewport.height + gui.sizing.widget.gap

   mod_items = array<table>
   for i in {0 to #MODS} do mod_items.push({ label = MODS[i] }) end

   glModCombo = gui.combobox({
      target = glViewport,
      label  = 'Mod:',
      labelWidth = gui.rpixel('70dp'),
      text   = MODS[0],
      x      = glWindow.margins.left,
      y      = glY,
      items  = mod_items,
      events = {
         activate = function(Item:table!)
            for i in {0 to #MODS} do
               if MODS[i] is Item.label then glShape.mod = i end
            end
            redraw()
         end
      }
   })
   glY += glModCombo.viewport.height + gui.sizing.widget.gap

   buildSavedPanel()
end

----------------------------------------------------------------------------------------------------------------------

   glWindow = gui.window({
      title = 'Supershape Demo', insideWidth = 1024, insideHeight = 800, minWidth = 800, minHeight = 600,
      events = { close = function() storeShapes() end }
   })

   glViewport = glWindow.clientViewport({ aspectRatio = ARF_MEET })

   buildScene()
   loadShapes()
   glWindow.show()
   processing.sleep()
