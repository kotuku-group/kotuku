#!/usr/bin/env origo

   import 'gui/filedialog'

   -- The dialog is closed if it is collected, so it is retained while the script waits for the response.

   dialog = gui.dialog.file({
      filterList  = { { name='All Files', ext='' }, { name='MP3 Audio Files', ext='.mp3' }, { name='Text Files', ext='.txt' } },
      okLabel     = 'Select File',
      cancelLabel = 'Exit',
      warnExists  = true,
      multiSelect = true,
      allowNew    = arg('save'),
      path        = arg('path'),
      feedback = function(Dialog, Path, Files)
         mSys.SendMessage(MSGID_QUIT)

         if not Files then
            print('Dialog was cancelled.')
            return
         end

         for k, v in ipairs(Files) do
             print(f'{k} = {Path}{v.filename}')
         end
      end
   })

   processing.sleep()
