#!/usr/bin/env origo
-- Colour Picker test

   import 'gui'
   import 'gui/colourpicker'

   proc = processing.new()

   gui.dialog.colour({
      colour  = 'rgb(255,0,0)',
      theme   = arg('theme'),
      feedback = function(Colour, Status)
         if Status is 'active' then
            print(f'Active colour: {Colour.css}')
            return
         end
         if not Colour then
            print('Dialog was cancelled.')
         else
            print(f'The user selected colour is {Colour} (sRGB), {Colour.css} in the {Colour.gamut} target')
         end
         proc.signal()
      end
   })

   proc.sleep(nil, true)
