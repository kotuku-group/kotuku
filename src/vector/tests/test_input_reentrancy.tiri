-- Nested input dispatch must complete crossing notifications and preserve cursor choices across wheel input.

   include 'display', 'vector'

-- The unit-test hook dispatches straight into the scene, as native input paths can do, so the first group of
-- callbacks below exercises nested scene_input_events() calls in isolation.  The second group feeds the system
-- pointer and blocks in processing.sleep(), which re-enters input_event_loop() through the FD dispatcher.

function feed(Scene:obj!, Type:num!, Value0:num!, Value1:num!)
   local passed, total = mod.test('vector', f'input:{Scene.id}:{Type}:{Value0}:{Value1}')
   assert(total is 1 and passed is total, 'The direct scene input dispatch failed')
end

function newScene():<obj, obj, obj, obj, obj>
   local surface = obj.new('Surface', { width=100, height=100 })
   local scene = surface.new('VectorScene', { surface=surface })
   local root = scene.new('VectorViewport', { x=0, y=0, width=100, height=100, cursor='default' })
   root.new('VectorRectangle', { x=0, y=0, width=100, height=100, fill='#808080' })
   local a = root.new('VectorViewport', { x=0, y=0, width=30, height=30, cursor='default' })
   local b = root.new('VectorViewport', { x=30, y=0, width=30, height=30, cursor='hand' })
   local c = root.new('VectorViewport', { x=60, y=0, width=30, height=30, cursor='crosshair' })
   for vector in values(array<obj> { a, b, c }) do
      vector.new('VectorRectangle', { x=0, y=0, width=30, height=30, fill='#ff0000' })
      check vector.mtSubscribeInput(JTYPE_MOVEMENT, function(Vector, Msg) end)
   end
   check root.mtSubscribeInput(JTYPE_MOVEMENT, function(Vector, Msg) end)
   return surface, a, b, c, scene
end

function drawScene(Surface:obj!, Scene:obj!)
   check Surface.acShow()
   check Surface.acDraw()
   processing.sleep(0)
   feed(Scene, JET_ABS_XY, 95, 95)
   feed(Scene, JET_ABS_XY, 15, 15)
end

@Test function LeavePreviousVectorDuringNestedMovement()
   local surface <close>, a, b, c, scene = newScene()
   local left_a = 0
   local left_b = 0
   local nested = false
   check a.mtSubscribeInput(JTYPE_CROSSING, function(Vector, Msg)
      if Msg.type is JET_CROSSED_OUT then left_a++ end
   end)
   check b.mtSubscribeInput(JTYPE_CROSSING, function(Vector, Msg)
      if Msg.type is JET_CROSSED_OUT then left_b++ end
   end)
   check b.mtSubscribeInput(JTYPE_MOVEMENT, function(Vector, Msg)
      if nested then return end
      nested = true
      feed(scene, JET_ABS_XY, 75, 15)
   end)
   drawScene(surface, scene)
   left_a = 0
   left_b = 0

   feed(scene, JET_ABS_XY, 45, 15)
   assert(nested, 'The movement callback did not dispatch nested input')
   assert(left_a is 1, f'The previous vector received {left_a} leave events instead of 1')
   assert(left_b is 1, f'The intermediate vector received {left_b} leave events instead of 1')
   assert(surface.cursor is c.cursor, 'Nested movement must retain the newest cursor')
end

@Test function WheelDuringMovementPreservesCursor()
   local surface <close>, a, b, c, scene = newScene()
   local wheels = 0
   check b.mtSubscribeInput(JTYPE_EXT_MOVEMENT, function(Vector, Msg)
      if Msg.type is JET_WHEEL then wheels++ end
   end)
   check b.mtSubscribeInput(JTYPE_MOVEMENT, function(Vector, Msg)
      feed(scene, JET_WHEEL, 1, 0)
   end)
   drawScene(surface, scene)

   feed(scene, JET_ABS_XY, 45, 15)
   assert(wheels is 1, 'The movement callback did not dispatch the nested wheel event')
   assert(surface.cursor is b.cursor, 'Nested wheel input must preserve the pending movement cursor')
end

@Test function WheelDuringEnterPreservesMovement()
   local surface <close>, a, b, c, scene = newScene()
   local moves = 0
   local wheels = 0
   check a.mtSubscribeInput(JTYPE_EXT_MOVEMENT, function(Vector, Msg)
      if Msg.type is JET_WHEEL then wheels++ end
   end)
   check b.mtSubscribeInput(JTYPE_CROSSING, function(Vector, Msg)
      if Msg.type is JET_CROSSED_IN then feed(scene, JET_WHEEL, 1, 0) end
   end)
   check b.mtSubscribeInput(JTYPE_MOVEMENT, function(Vector, Msg) moves++ end)
   drawScene(surface, scene)

   feed(scene, JET_ABS_XY, 45, 15)
   assert(wheels is 1, 'The enter callback did not dispatch the nested wheel event')
   assert(moves is 1, 'Nested wheel input must not discard the pending movement event')
   assert(surface.cursor is b.cursor, 'Nested wheel input during entry must preserve the selected cursor')
end

----------------------------------------------------------------------------------------------------------------------
-- Pointer input through the FD dispatcher.  A callback that blocks in processing.sleep(), as one waiting on a dialog
-- does, must not stop input from reaching the scene.

-- Write the little-endian IEEE-754 encoding of a non-negative double into Buffer at Offset.

function putDouble(Buffer:array<byte>!, Offset:num!, Value:num!)
   if Value is 0 then return end
   local mantissa, exponent = math.frexp(Value)
   local fraction = ((mantissa * 2) - 1) * 1048576 -- The top 20 bits of the mantissa occupy the high word
   local high = ((exponent + 1022) * 1048576) + math.floor(fraction)
   local low = (fraction - math.floor(fraction)) * 4294967296
   for i in {0 to 4} do
      Buffer[Offset + i] = math.floor(low / (256 ** i)) % 256
      Buffer[Offset + 4 + i] = math.floor(high / (256 ** i)) % 256
   end
end

-- Queue one dcDeviceInput record on the system pointer without dispatching it.

function queuePointer(Type:num!, Value0:num!, Value1:num!)
   local input = array<byte, 40>
   putDouble(input, 0, Value0)
   putDouble(input, 8, Value1)
   input[32] = Type
   check obj.find('SystemPointer').acDataFeed(nil, DATA_DEVICE_INPUT, input)
end

function feedPointer(Type:num!, Value0:num!, Value1:num!)
   queuePointer(Type, Value0, Value1)
   processing.sleep(0)
end

-- Tests share one system pointer, and the scenes all open at the same position.  Park the pointer in a corner that
-- no test vector covers, so that a later test's scene does not receive input from where an earlier test left it.

@AfterEach function parkPointer()
   feedPointer(JET_ABS_XY, 99, 99)
end

-- A scene with a root viewport that logs its movement and right button events, and a child at (10, 10, 20, 20).

function newPointerScene():<obj, obj, obj, array<str>>
   local surface = obj.new('Surface', { x=0, y=0, width=100, height=100 })
   local scene = surface.new('VectorScene', { surface=surface })
   local root = scene.new('VectorViewport', { x=0, y=0, width=100, height=100 })
   root.new('VectorRectangle', { x=0, y=0, width=100, height=100, fill='#808080' })
   local child = root.new('VectorViewport', { x=10, y=10, width=20, height=20 })
   child.new('VectorRectangle', { x=0, y=0, width=20, height=20, fill='#ff0000' })
   local log = array<str>
   check root.mtSubscribeInput(JTYPE_MOVEMENT|JTYPE_BUTTON, function(Vector, Msg)
      if Msg.type is JET_ABS_XY then log.push(f'M{Msg.absX}')
      elseif Msg.type is JET_RMB then log.push(f'R{Msg.value}') end
   end)
   return surface, root, child, log
end

function showScene(Surface:obj!)
   check Surface.acShow()
   check Surface.acDraw()
   processing.sleep(0)
end

-- The button lock is released before a release callback runs, so input reaches the rest of the scene while the
-- callback blocks.

@Test function BlockedReleaseCallbackReleasesLock()
   local surface <close>, root, child, log = newPointerScene()
   local nested:any
   check child.mtSubscribeInput(JTYPE_BUTTON, function(Vector, Msg)
      if (Msg.type is JET_LMB) and (Msg.value is 0) and (nested is nil) then
         local before = #log
         feedPointer(JET_ABS_XY, 60, 60)
         feedPointer(JET_ABS_XY, 70, 70)
         processing.sleep(0.05)
         nested = #log - before
      end
   end)
   showScene(surface)

   feedPointer(JET_ABS_XY, 20, 20)
   feedPointer(JET_LMB, 1, 0)
   feedPointer(JET_LMB, 0, 0)
   assert(nested is 2, f'The root received {nested} of 2 movement events while the release callback blocked')
end

-- A press callback that blocks while the button is released must not leave the button lock in place.

@Test function BlockedPressCallbackHonoursNestedRelease()
   local surface <close>, root, child, log = newPointerScene()
   local nested:any
   check child.mtSubscribeInput(JTYPE_BUTTON, function(Vector, Msg)
      if (Msg.type is JET_LMB) and (Msg.value > 0) and (nested is nil) then
         local before = #log
         feedPointer(JET_LMB, 0, 0)
         feedPointer(JET_ABS_XY, 60, 60)
         feedPointer(JET_ABS_XY, 70, 70)
         processing.sleep(0.05)
         nested = #log - before
      end
   end)
   showScene(surface)

   feedPointer(JET_ABS_XY, 20, 20)
   feedPointer(JET_LMB, 1, 0)
   assert(nested is 2, f'The root received {nested} of 2 movement events after the nested release')

   local before = #log
   feedPointer(JET_ABS_XY, 80, 80)
   feedPointer(JET_ABS_XY, 90, 90)
   assert(#log - before is 2, f'The root received {#log - before} of 2 movement events after the press callback ' ..
      'returned; the button lock was left in place')
end

-- A movement callback blocks part-way through a batch while newer input arrives.  The scene and a second,
-- display-level subscriber must each receive the remaining older events before the newer ones.  M20 is coalesced
-- into the nested M40 because consecutive movement events are consolidated.

@Test function BlockedCallbackPreservesEventOrder()
   local surface <close>, root, child, log = newPointerScene()
   local global_log = array<str>
   local global_sub = input.subscribe(JTYPE_MOVEMENT|JTYPE_BUTTON, nil, 0, function(Input, Event)
      if Event.type is JET_ABS_XY then global_log.push(f'M{Event.absX}')
      elseif Event.type is JET_RMB then global_log.push(f'R{Event.value}') end
   end)
   defer global_sub.unsubscribe() end

   local blocked = false
   check root.mtSubscribeInput(JTYPE_MOVEMENT, function(Vector, Msg)
      if (Msg.type is JET_ABS_XY) and (Msg.absX is 10) and (not blocked) then
         blocked = true
         feedPointer(JET_ABS_XY, 40, 10)
         feedPointer(JET_ABS_XY, 50, 10)
         processing.sleep(0.05)
      end
   end)
   showScene(surface)
   log.clear()

   queuePointer(JET_ABS_XY, 10, 10)
   queuePointer(JET_RMB, 1, 0)
   queuePointer(JET_RMB, 0, 0)
   queuePointer(JET_ABS_XY, 20, 10)
   processing.sleep(0.1)

   local scene_order = log.concat(',')
   local global_order = global_log.concat(',')
   assert(scene_order is 'M10,R1,R0,M40,M50', f'Scene received {scene_order}')
   assert(global_order is 'M10,R1,R0,M20,M40,M50', f'Second subscriber received {global_order}')
end
