   include 'display', 'vector'
   module display as mGfx

function readPixel(Bitmap, X, Y)
   return struct.toTable(mGfx.ReadRGBPixel(Bitmap, X, Y))
end

-- These tests exercise the Gradient.Matrices field, which holds gradientTransform values in contiguous
-- kt::vector<VectorMatrix> storage.  The transform is consumed by the renderer via apply_transforms(), so a
-- transformed gradient must produce a measurably different result to an untransformed one.

function newBitmap(Width, Height)
   bmp = obj.new('bitmap', { width=Width, height=Height, bitsPerPixel=32, bkgd='0,0,0,255' })
   bmp.acClear()
   return bmp
end

function stop(Offset, R, G, B)
   s = struct<GradientStop>
   s.offset    = Offset
   s.rgb.red   = R
   s.rgb.green = G
   s.rgb.blue  = B
   s.rgb.alpha = 1.0
   return s
end

function rampStops()
   return array<struct<GradientStop>> { stop(0.0, 1.0, 0.0, 0.0), stop(1.0, 0.0, 0.0, 1.0) }
end

-- A horizontal user-space linear gradient running red (left) to blue (right) across a 100x100 area.

function newLinearScene(Transform)
   scene = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   viewport = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })

   fields = { units=VUNIT_USERSPACE, x1=0, y1=50, x2=100, y2=50, stops=rampStops() }
   if Transform then fields.transform = Transform end

   gradient = scene.new('GradientLinear', fields)
   check scene.mtAddDef('grad', gradient)

   viewport.new('VectorRectangle', { x=0, y=0, width='100%', height='100%', fill='url(#grad)' })
   return scene, gradient
end

function drawScene(Scene, Bitmap)
   Bitmap.acClear()
   Scene.bitmap = Bitmap
   check Scene.acDraw()
end

function drawHash(Scene, Bitmap)
   drawScene(Scene, Bitmap)
   return mSys.GenCRC32(0, Bitmap.data, Bitmap.size)
end

@Test function PlainGradientRunsLeftToRight()
   scene = newLinearScene(nil)
   bmp = newBitmap(100, 100)
   drawScene(scene, bmp)

   left  = readPixel(bmp, 10, 50)
   right = readPixel(bmp, 90, 50)

   assert((left.red > left.blue) and (left.red > 180),
      'The untransformed gradient should be red-dominant on the left (got ' ..
      left.red .. ',' .. left.green .. ',' .. left.blue .. ')')
   assert((right.blue > right.red) and (right.blue > 180),
      'The untransformed gradient should be blue-dominant on the right (got ' ..
      right.red .. ',' .. right.green .. ',' .. right.blue .. ')')
end

@Test function TransformAltersRendering()
   -- A transformed gradient must hash differently to an untransformed one, proving the Matrices field is
   -- consumed by the renderer.

   plain_scene = newLinearScene(nil)
   rot_scene   = newLinearScene('rotate(90 50 50)')
   plain_bmp = newBitmap(100, 100)
   rot_bmp   = newBitmap(100, 100)

   assert(drawHash(plain_scene, plain_bmp) != drawHash(rot_scene, rot_bmp),
      'A gradientTransform must change the rendered output')
end

@Test function RotateReorientsAxis()
   -- rotate(90) about the centre turns the horizontal ramp into a vertical one: red at the top, blue at the bottom.

   scene = newLinearScene('rotate(90 50 50)')
   bmp = newBitmap(100, 100)
   drawScene(scene, bmp)

   top    = readPixel(bmp, 50, 10)
   bottom = readPixel(bmp, 50, 90)

   assert((top.red > top.blue) and (top.red > 180),
      'A 90-degree rotation should place the start colour (red) at the top (got ' ..
      top.red .. ',' .. top.green .. ',' .. top.blue .. ')')
   assert((bottom.blue > bottom.red) and (bottom.blue > 180),
      'A 90-degree rotation should place the end colour (blue) at the bottom (got ' ..
      bottom.red .. ',' .. bottom.green .. ',' .. bottom.blue .. ')')
end

@Test function TransformReassignmentResetsMatrix()
   -- Re-assigning the transform on an already-transformed gradient must reset the existing matrix in-place
   -- (the ResetMatrix branch) rather than accumulate.  Rotating by 90 then back to 0 must restore the
   -- original left-to-right rendering.

   plain_scene = newLinearScene(nil)
   reset_scene, gradient = newLinearScene('rotate(90 50 50)')
   gradient.transform = 'rotate(0 50 50)'

   plain_bmp = newBitmap(100, 100)
   reset_bmp = newBitmap(100, 100)

   assert(drawHash(plain_scene, plain_bmp) is drawHash(reset_scene, reset_bmp),
      'Re-assigning a zero rotation should restore the untransformed rendering')
end

----------------------------------------------------------------------------------------------------------------------
-- Under BOUNDING_BOX units the transform is applied in the normalised (0..1) space of the target's bounding box, as for
-- SVG's gradientTransform, so translate(0.25 0) moves the gradient by a quarter of the box width and rotate(180 0.5 0.5)
-- turns it about the centre of the box.  The target is a 60x40 rectangle at (20,10), so that a transform applied in
-- user space, or with the box offset and scale in the wrong order, lands somewhere measurably different.

BOX <const> = { x = 20, y = 10, width = 60, height = 40 }

-- Red before the half-way point of the gradient, blue after it

function hardStops()
   return array<struct<GradientStop>> { stop(0.5, 1.0, 0.0, 0.0), stop(0.5, 0.0, 0.0, 1.0) }
end

function newBoxScene(Class, Fields)
   scene = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   viewport = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   gradient = scene.new(Class, table.merge({ units=VUNIT_BOUNDING_BOX }, Fields))
   check scene.mtAddDef('grad', gradient)
   viewport.new('VectorRectangle', {
      x=BOX.x, y=BOX.y, width=BOX.width, height=BOX.height, fill='url(#grad)'
   })
   return scene
end

-- Returns 'red' or 'blue' for the dominant colour of a pixel in the box, which has no other colours

function colourAt(Scene, X, Y)
   bmp = newBitmap(100, 100)
   drawScene(Scene, bmp)
   pixel = readPixel(bmp, X, Y)
   assert(math.max(pixel.red, pixel.blue) > 180, f'Pixel {X},{Y} is not inside the gradient ' ..
      f'({pixel.red},{pixel.green},{pixel.blue})')
   return (pixel.red > pixel.blue) ? 'red' : 'blue'
end

function assertColours(Scene, Expected, Label)
   for _, check_point in Expected do
      got = colourAt(Scene, check_point.x, check_point.y)
      assert(got is check_point.colour, f'{Label}: pixel {check_point.x},{check_point.y} is {got}, ' ..
         f'expected {check_point.colour}')
   end
end

@Test function BoundingBoxLinearTranslate()
   -- The red/blue edge is at 50% of the box (x=50), and a translation of 0.25 moves it to 75% (x=65)

   linear = { x1=0, y1=0, x2='100%', y2=0, stops=hardStops() }
   assertColours(newBoxScene('GradientLinear', linear), array<table> {
      { x = 45, y = 30, colour = 'red' }, { x = 55, y = 30, colour = 'blue' }
   }, 'Untransformed')

   linear.transform = 'translate(0.25 0)'
   assertColours(newBoxScene('GradientLinear', linear), array<table> {
      { x = 60, y = 30, colour = 'red' }, { x = 70, y = 30, colour = 'blue' }
   }, 'translate(0.25 0)')
end

@Test function BoundingBoxLinearRotateAboutCentre()
   -- A half turn about the centre of the box reverses the gradient within the box

   assertColours(newBoxScene('GradientLinear', {
      x1=0, y1=0, x2='100%', y2=0, stops=hardStops(), transform='rotate(180 0.5 0.5)'
   }), array<table> {
      { x = 25, y = 30, colour = 'blue' }, { x = 75, y = 30, colour = 'red' }
   }, 'rotate(180 0.5 0.5)')
end

@Test function BoundingBoxRadialTranslate()
   -- The circle has a radius of 25% of the box, so it spans x=35..65 untransformed and x=50..80 after translate(0.25 0)

   radial = { cx='50%', cy='50%', radius='25%' }
   radial.stops = array<struct<GradientStop>> { stop(1.0, 1.0, 0.0, 0.0), stop(1.0, 0.0, 0.0, 1.0) }
   assertColours(newBoxScene('GradientRadial', radial), array<table> {
      { x = 50, y = 30, colour = 'red' }, { x = 75, y = 30, colour = 'blue' }
   }, 'Untransformed')

   radial.transform = 'translate(0.25 0)'
   assertColours(newBoxScene('GradientRadial', radial), array<table> {
      { x = 40, y = 30, colour = 'blue' }, { x = 65, y = 30, colour = 'red' }
   }, 'translate(0.25 0)')
end

@Test function BoundingBoxDiamondTranslate()
   -- Kotuku's own gradient types follow the same rule as the SVG ones

   diamond = { cx='50%', cy='50%', radius='25%', transform='translate(0.25 0)' }
   diamond.stops = array<struct<GradientStop>> { stop(1.0, 1.0, 0.0, 0.0), stop(1.0, 0.0, 0.0, 1.0) }
   assertColours(newBoxScene('GradientDiamond', diamond), array<table> {
      { x = 40, y = 30, colour = 'blue' }, { x = 65, y = 30, colour = 'red' }
   }, 'Diamond translate(0.25 0)')
end

@Test function UserSpaceTransformUnchanged()
   -- A user space transform is in the target's coordinate system, so translate(15 0) moves the edge by 15 pixels

   assertColours(newBoxScene('GradientLinear', {
      units=VUNIT_USERSPACE, x1=20, y1=0, x2=80, y2=0, stops=hardStops(), transform='translate(15 0)'
   }), array<table> {
      { x = 60, y = 30, colour = 'red' }, { x = 70, y = 30, colour = 'blue' }
   }, 'User space translate(15 0)')
end
