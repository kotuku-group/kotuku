-- LightingFX kernel units (UnitX/UnitY, equivalent to SVG kernelUnitLength) and light colour assignment

   include 'display', 'vector'
   module display as mGfx
   module vector as mVec

----------------------------------------------------------------------------------------------------------------------
-- Renders a lit circle to a 72x72 bitmap.  The circle is drawn in a viewport of Size units, which is magnified by
-- Scale so that it always covers the same pixels.  The bump map is blurred and lit in bounding box units, and Unit
-- defines the kernel unit if it is not nil.  Options can override unitY, rotation, elevation and lighting type.

function renderLit(Size:num!, Scale:num!, Unit:num, Options:table):obj
   local page = 72
   local scene <close> = obj.new('VectorScene', { pageWidth=page, pageHeight=page })
   local root = scene.new('VectorViewport', {
      width=page, height=page, viewX=0, viewY=0, viewWidth=page / Scale, viewHeight=page / Scale
   })

   local filter = scene.new('VectorFilter', { primitiveUnits=VUNIT_BOUNDING_BOX })
   filter.new('BlurFX', { sx=0.03, sy=0.03, sourceType='Alpha' })
   local light = filter.new('LightingFX', { type=Options?.type ?? LT_SPECULAR, constant=1, scale=2, exponent=4 })
   if Unit then light.{ unitX = Unit, unitY = Options?.unitY ?? Unit } end
   check light.mtSetDistantLight(225, Options?.elevation ?? 30)
   check scene.mtAddDef('lit', filter)

   local vp = root.new('VectorViewport', {
      width=Size, height=Size, viewX=0, viewY=0, viewWidth=24, viewHeight=24, filter='url(#lit)'
   })
   if Options?.rotation then
      local _, matrix = check vp.mtNewMatrix(0)
      check mVec.ParseTransform(matrix, f'translate({Size/2},{Size/2}) rotate({Options.rotation}) ' ..
         f'translate({-Size/2},{-Size/2})')
   end
   vp.new('VectorEllipse', { cx=12, cy=12, radius=8, fill='white' })

   local bmp = obj.new('bitmap', { width=page, height=page, bitsPerPixel=32, bkgd='0,0,0,255' })
   bmp.acClear()
   scene.bitmap = bmp
   check scene.acDraw()
   return bmp
end

-- Returns the largest difference between the colour channels of two bitmaps of equal size.  Channels are copied
-- before the next read because ReadRGBPixel() reuses its result.

function maxDifference(A:obj!, B:obj!):num
   local result = 0
   for y in {0 to A.height} do
      for x in {0 to A.width} do
         local p = mGfx.ReadRGBPixel(A, x, y)
         local r, g, b = p.red, p.green, p.blue
         local q = mGfx.ReadRGBPixel(B, x, y)
         result = math.max(result, math.abs(r - q.red), math.abs(g - q.green), math.abs(b - q.blue))
      end
   end
   return result
end

----------------------------------------------------------------------------------------------------------------------

@Test function UnitsMustBePositive()
   local filter <close> = obj.new('VectorFilter')
   local fx = filter.new('LightingFX')

   for value in values(array<double> { 0, -0.5 }) do
      try
         fx.unitX = value
      success
         assert(false, f'UnitX must reject {value}')
      end

      try
         fx.unitY = value
      success
         assert(false, f'UnitY must reject {value}')
      end
   end

   fx.{ unitX = 0.25, unitY = 2 }
   assert(fx.unitX is 0.25 and fx.unitY is 2, 'Positive kernel units must be retained')
end

-- With bounding box units, the blur and the kernel scale together, so a magnified graphic matches a graphic that is
-- drawn at the same pixel size in its own coordinate system.

@Test function BoundingBoxUnitsAreIndependentOfScale()
   local magnified <close> = renderLit(24, 3, 1/24)
   local native <close> = renderLit(72, 1, 1/24)
   local diff = maxDifference(magnified, native)
   assert(diff <= 2, f'Kernel units in bounding box space must not depend on scale (max difference {diff})')
end

-- Without a kernel unit, the unit is one client unit.  A graphic that is larger in its own coordinate system is lit
-- more gently than an equivalent that is magnified by its parent.  This also confirms that the test above is able to
-- detect a difference.

@Test function DefaultUnitIsTheClientUnit()
   local magnified <close> = renderLit(24, 3, nil)
   local native <close> = renderLit(72, 1, nil)
   local diff = maxDifference(magnified, native)
   assert(diff > 40, f'The default kernel unit must follow the client coordinate system (max difference {diff})')

   -- The bounding box is the circle, which is 48 client units wide at a Size of 72, so a kernel unit of 1/48 of the
   -- box is equivalent to the default.

   local explicit <close> = renderLit(72, 1, 1/48)
   diff = maxDifference(native, explicit)
   assert(diff <= 2, f'A kernel unit of one client unit must match the default (max difference {diff})')
end

-- A quarter turn swaps the screen directions of unequal kernel units.  A light directly above the circle isolates
-- the kernel orientation from the light direction, and the circular bump map covers the same pixels after rotation.

@Test function UnequalUnitsFollowQuarterTurns()
   for light_type in values(array<int> { LT_DIFFUSE, LT_SPECULAR }) do
      local original <close> = renderLit(72, 1, 0.02, { unitY=0.12, elevation=90, type=light_type })
      local swapped <close> = renderLit(72, 1, 0.12, { unitY=0.02, elevation=90, type=light_type })
      assert(maxDifference(original, swapped) > 40, 'Unequal units must produce visibly different lighting')

      for angle in values(array<int> { 90, 270 }) do
         local rotated <close> = renderLit(72, 1, 0.02, {
            unitY=0.12, rotation=angle, elevation=90, type=light_type
         })
         local diff = maxDifference(rotated, swapped)
         assert(diff <= 2, f'A {angle} degree rotation must swap the kernel axes (max difference {diff})')
      end
   end
end

-- Opposite diagonal orientations need cross-axis gradient terms.  Swapping the units and adding a quarter turn
-- describes the same kernel, while keeping the units produces a different diagonal orientation.

@Test function UnequalUnitsFollowDiagonalRotations()
   local clockwise <close> = renderLit(72, 1, 0.02, { unitY=0.12, rotation=45, elevation=90 })
   local anticlockwise <close> = renderLit(72, 1, 0.02, { unitY=0.12, rotation=-45, elevation=90 })
   local swapped <close> = renderLit(72, 1, 0.12, { unitY=0.02, rotation=-45, elevation=90 })
   assert(maxDifference(clockwise, anticlockwise) > 40, 'Opposite diagonal kernel orientations must differ')
   local diff = maxDifference(clockwise, swapped)
   assert(diff <= 2, f'Swapping the diagonal kernel axes must preserve the lighting (max difference {diff})')
end

----------------------------------------------------------------------------------------------------------------------
-- Colour struct fields accept colour strings from Tiri as well as numeric CSV values.  Each component must match
-- Expected within a small tolerance.

function assertColour(Colour:struct, Expected:array<double>, Label:str)
   local actual = array<double> { Colour.red, Colour.green, Colour.blue, Colour.alpha }
   for i, value in Expected do
      assert(math.abs(actual[i] - value) < 0.002,
         f'{Label}: expected {Expected.join(",")}, got {actual.join(",")}')
   end
end

@Test function LightColourAcceptsColourStrings()
   local scene <close> = obj.new('VectorScene', { pageWidth=10, pageHeight=10 })
   local filter = scene.new('VectorFilter', { })
   local light = filter.new('LightingFX', { colour='#ff0000' })
   assertColour(light.colour, array<double> { 1, 0, 0, 1 }, 'Hex initialiser')

   light.colour = '#00ff0080'
   assertColour(light.colour, array<double> { 0, 1, 0, 128/255 }, 'Hex with alpha')

   light.colour = 'rgb(0,0,255)'
   assertColour(light.colour, array<double> { 0, 0, 1, 1 }, 'rgb() function')

   light.colour = 'hsl(60,100%,50%)'
   assertColour(light.colour, array<double> { 1, 1, 0, 1 }, 'hsl() function')

   light.colour = 'white'
   assertColour(light.colour, array<double> { 1, 1, 1, 1 }, 'Named colour')
end

@Test function LightColourKeepsNumericValues()
   local scene <close> = obj.new('VectorScene', { pageWidth=10, pageHeight=10 })
   local filter = scene.new('VectorFilter', { })
   local light = filter.new('LightingFX', { colour='0.25,0.5,0.75,1' })
   assertColour(light.colour, array<double> { 0.25, 0.5, 0.75, 1 }, 'CSV initialiser')

   local other = filter.new('LightingFX', { colour='#ff0000' })
   other.colour = light.colour
   assertColour(other.colour, array<double> { 0.25, 0.5, 0.75, 1 }, 'Struct assignment')
end

@Test function InvalidLightColourIsRejected()
   local scene <close> = obj.new('VectorScene', { pageWidth=10, pageHeight=10 })
   local filter = scene.new('VectorFilter', { })
   local light = filter.new('LightingFX', { colour='#0000ff' })
   local raised = false
   try
      light.colour = 'notacolour'
   except e
      raised = true
   end
   assert(raised, 'An unrecognised colour string must raise an exception')
   assertColour(light.colour, array<double> { 0, 0, 1, 1 }, 'Unchanged after a failed assignment')
end

@Test function FloodColourAcceptsColourStrings()
   local scene <close> = obj.new('VectorScene', { pageWidth=10, pageHeight=10 })
   local filter = scene.new('VectorFilter', { })
   local flood = filter.new('FloodFX', { colour='#00ff00' })
   assertColour(flood.colour, array<double> { 0, 1, 0, 1 }, 'FloodFX hex initialiser')
end
