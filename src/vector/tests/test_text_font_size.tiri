   include 'vector'

-- VectorText resolves FontSize to a whole number of pixels.  Physical units convert at the fixed 96 DPI reference
-- and are rounded to the nearest pixel rather than truncated.

function resolvedSize(Value:str!):num
   local text <close> = obj.new('VectorText')
   text.fontSize = Value
   return tonumber(text.fontSize)
end

@Test function PointSizesRoundToNearestPixel()
   assert(resolvedSize('11pt') is 15, '11pt (14.67px) must round to 15px')
   assert(resolvedSize('10pt') is 13, '10pt (13.33px) must round to 13px')
   assert(resolvedSize('12pt') is 16, '12pt must resolve to exactly 16px')
end

@Test function FractionalPixelSizesRound()
   assert(resolvedSize('14.4') is 14, '14.4px must round down')
   assert(resolvedSize('14.6px') is 15, '14.6px must round up')
   assert(resolvedSize('0.6') is 1, 'Sizes that round to one pixel are accepted')
end

@Test function SubPixelSizesAreRejected()
   local scene <close> = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   text = scene.new('VectorViewport').new('VectorText', { fontSize=20 })
   try
      text.fontSize = '0.4'
   except e when ERR_OutOfRange
   success
      raise 'A size that rounds to zero pixels must be rejected'
   end
   assert(tonumber(text.fontSize) is 20, 'A rejected size must not change the existing size')
end

-- Tiny's 5pt and 6pt strikes have identical Height metrics, so the em size must come from the strike's point size.

function tinyText(Parent:obj!, Size:str!, Style:str):obj
   return Parent.new('VectorText', { face='Tiny', fontSize=Size, string='Hgx', textFlags=VTXF_RASTER, textStyle=Style })
end

@Test function BitmapStrikesCanBeSwitchedInBothDirections()
   local scene <close> = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   text = tinyText(scene.new('VectorViewport'), '8px')
   assert(text.displayHeight is 10, f'6pt strike expected, got height {text.displayHeight}')
   text.fontSize = '5pt'
   assert(text.displayHeight is 8, f'5pt strike expected, got height {text.displayHeight}')
   text.fontSize = '6pt'
   assert(text.displayHeight is 10, f'Returning to the 6pt strike failed, got height {text.displayHeight}')
end

@Test function BitmapFontSizeReflectsTheStrike()
   local scene <close> = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   viewport = scene.new('VectorViewport')
   assert(tonumber(tinyText(viewport, '5pt').fontSize) is 7, '5pt must resolve to 7px')
   assert(tonumber(tinyText(viewport, '6pt').fontSize) is 8, '6pt must resolve to 8px')
   assert(tonumber(tinyText(viewport, '40px').fontSize) is 8, 'An unavailable size must report the selected strike')
end

@Test function BitmapLineHeightScalesWithTheStrike()
   local scene <close> = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   viewport = scene.new('VectorViewport')
   small = tinyText(viewport, '5pt', 'lineHeight=1.45').lineSpacing
   large = tinyText(viewport, '6pt', 'lineHeight=1.45').lineSpacing
   assert(small is 10, f'1.45 x 7px must give a pitch of 10, got {small}')
   assert(large is 12, f'1.45 x 8px must give a pitch of 12, got {large}')
end
