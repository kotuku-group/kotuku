@Test function ReadHueUnitCase()
   painter = struct.new('VectorPainter')
   for _, angle in { '120DEG', '133.33333333333333GrAd', '2.0943951023931953rAd', '0.3333333333333333TuRn' } do
      for _, model in { 'hsl', 'hsv' } do
         third = model is 'hsl' ? 50 : 100
         err, result = mVec.ReadPainter(nil, f'{model}({angle} 100% {third}% / 25%);blue', painter)
         check err
         assert(checkRGB(painter, 0, 1, 0, 0.25), f'Failed mixed-case hue unit {model}({angle})')
         assert(result is ';blue', f'Mixed-case hue unit lost the next painter: {result}')
      end
   end
end

@Test function ReadLargeHue()
   painter = struct.new('VectorPainter')
   for _, angle in { '1e308turn', '-1e308turn' } do
      for _, model in { 'hsl', 'hsv' } do
         third = model is 'hsl' ? 50 : 100
         err, result = mVec.ReadPainter(nil, f'{model}({angle} 100% {third}%);blue', painter)
         check err
         assert(checkRGB(painter, 1, 0, 0, 1), f'Large integral turn must wrap to red: {model}({angle})')
         assert(result is ';blue', f'Large hue lost the next painter: {result}')
      end
   end
end

@Test function RejectOutOfRangeHue()
   painter = struct.new('VectorPainter')
   for _, angle in { '1e309', '-1e309', '+1e309turn', ' 1e309turn', '-1e309deg', '1e-400turn' } do
      for _, model in { 'hsl', 'hsla', 'hsv' } do
         for _, components in { ',100%,50%,0.5', ' 100% 50% / 0.5' } do
            local err, result = mVec.ReadPainter(nil, f'{model}({angle}{components});blue', painter)
            assert(err is ERR_Syntax, f'Out-of-range hue must return ERR_Syntax: {model}({angle}{components})')
            assert(not result or result is '', 'Failed hue parsing must clear the next painter')
         end
      end
   end
end

@Test function RejectNonFiniteHue()
   painter = struct.new('VectorPainter')
   for _, angle in { 'inf', '-inf', 'nan' } do
      for _, model in { 'hsl', 'hsv' } do
         err, result = mVec.ReadPainter(nil, f'{model}({angle},100%,50%);blue', painter)
         assert(err is ERR_Syntax, f'Non-finite hue must return ERR_Syntax: {model}({angle})')
         assert(not result or result is '', 'Failed hue parsing must clear the next painter')
      end
   end
end

