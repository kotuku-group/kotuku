-- hsl() and hsla()
-----------------------------------------------------------------------------------------------------------------------

@Test function ReadHSLRed()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "hsl(0,100,50)", painter)
   assert(checkRGB(painter, 1.0, 0, 0, 1.0), 'Failed hsl() red')
end

@Test function ReadHSLGreen()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "hsl(120,100,50)", painter)
   assert(checkRGB(painter, 0, 1.0, 0, 1.0), 'Failed hsl() green')
end

@Test function ReadHSLBlue()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "hsl(240,100,50)", painter)
   assert(checkRGB(painter, 0, 0, 1.0, 1.0), 'Failed hsl() blue')
end

@Test function ReadHSLGrey()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "hsl(0,0,50)", painter)
   assert(checkRGB(painter, 0.5, 0.5, 0.5, 1.0), 'Failed hsl() grey (zero saturation)')
end

@Test function ReadHSLA()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "hsla(0,100,50,0.5)", painter)
   assert(checkRGB(painter, 1.0, 0, 0, 0.5), 'Failed hsla() red with alpha')
end

@Test function ReadHSLPercentageResult()
   painter = struct.new('VectorPainter')
   local err, result = mVec.ReadPainter(nil, "hsl(0,100%,50%);blue", painter)
   check err
   assert(checkRGB(painter, 1.0, 0, 0, 1.0), 'Failed hsl() red with percentage suffixes')
   assert(result is ";blue", f'hsl() result should point at next painter, got {result}')
end

@Test function ReadHSLAlphaPercentage()
   painter = struct.new('VectorPainter')
   local err, result = mVec.ReadPainter(nil, "hsla(0,100%,50%,50%);blue", painter)
   check err
   assert(checkRGB(painter, 1.0, 0, 0, 0.5), 'Failed hsla() percentage alpha')
   assert(result is ";blue", f'hsla() result should point at next painter, got {result}')
end

@Test function ReadHSLSpaceSeparated()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "hsl(120 100% 50%)", painter)
   assert(checkRGB(painter, 0, 1.0, 0, 1.0), 'Failed space-separated hsl() green')
end

@Test function ReadHSLSpaceSeparatedAlpha()
   painter = struct.new('VectorPainter')
   local err, result = mVec.ReadPainter(nil, "hsl(240 100% 50% / 25%);blue", painter)
   check err
   assert(checkRGB(painter, 0, 0, 1.0, 0.25), 'Failed space-separated hsl() with percentage alpha')
   assert(result is ";blue", f'Space-separated hsl() result should point at next painter, got {result}')

   check mVec.ReadPainter(nil, "hsl(0 100% 50% / 0.5)", painter)
   assert(checkRGB(painter, 1.0, 0, 0, 0.5), 'Failed space-separated hsl() with numeric alpha')
end

@Test function ReadHSLHueUnitsAndWrapping()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "hsl(120deg, 100%, 50%)", painter)
   assert(checkRGB(painter, 0, 1.0, 0, 1.0), 'Failed hsl() with deg unit')

   check mVec.ReadPainter(nil, "hsl(0.5turn 100% 50%)", painter)
   assert(checkRGB(painter, 0, 1.0, 1.0, 1.0), 'Failed hsl() with turn unit')

   check mVec.ReadPainter(nil, "hsl(480 100% 50%)", painter)
   assert(checkRGB(painter, 0, 1.0, 0, 1.0), 'A hue of 480 must wrap to 120')

   check mVec.ReadPainter(nil, "hsl(-120 100% 50%)", painter)
   assert(checkRGB(painter, 0, 0, 1.0, 1.0), 'A hue of -120 must wrap to 240')
end

