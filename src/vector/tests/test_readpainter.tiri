@Test function ReadLabPercentage()
   -- lab(100% 0% 0%) should produce white
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "lab(100% 0% 0%)", painter)
   assert(checkRGB(painter, 1.0, 1.0, 1.0, 1.0), 'Failed lab() with percentages')
