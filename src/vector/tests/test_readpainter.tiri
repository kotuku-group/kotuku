@Test function ReadOKLabWhite()
   -- oklab(1 0 0) should produce white
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "oklab(1 0 0)", painter)
   assert(checkRGB(painter, 1.0, 1.0, 1.0, 1.0), 'Failed oklab() white')
end

@Test function ReadOKLabBlack()
   -- oklab(0 0 0) should produce black
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "oklab(0 0 0)", painter)
   assert(checkRGB(painter, 0, 0, 0, 1.0), 'Failed oklab() black')
end

@Test function ReadOKLabWithAlpha()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "oklab(1 0 0 / 0.5)", painter)
   assert(checkRGB(painter, 1.0, 1.0, 1.0, 0.5), 'Failed oklab() with alpha')
end

@Test function ReadOKLabPercentage()
   -- oklab(100% 0% 0%) should produce white
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "oklab(100% 0% 0%)", painter)
   assert(checkRGB(painter, 1.0, 1.0, 1.0, 1.0), 'Failed oklab() with percentages')
end

@Test function ReadOKLabRed()
   -- oklab(0.6279 0.2249 0.1264) is approximately sRGB red
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "oklab(0.6279 0.2249 0.1264)", painter)
   assert(near(painter.colour.red, 1.0), f'oklab() red: expected ~1.0, got {painter.colour.red}')
   assert(near(painter.colour.green, 0.0), f'oklab() green: expected ~0.0, got {painter.colour.green}')
   assert(near(painter.colour.blue, 0.0), f'oklab() blue: expected ~0.0, got {painter.colour.blue}')
end

