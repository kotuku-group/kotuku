
module vector as mVec

TOLERANCE <const> = 0.0099

function near(A, B)
   return math.abs(A - B) < TOLERANCE
end

function checkRGB(Painter, Red, Green, Blue, Alpha)
   local rgb = Painter.colour
   if not (Red ≈ rgb.red) then print(f'Red mismatch: expected {Red}, got {rgb.red}') return false end
   if not (Green ≈ rgb.green) then print(f'Green mismatch: expected {Green}, got {rgb.green}') return false end
   if not (Blue ≈ rgb.blue) then print(f'Blue mismatch: expected {Blue}, got {rgb.blue}') return false end
   if not (Alpha ≈ rgb.alpha) then print(f'Alpha mismatch: expected {Alpha}, got {rgb.alpha}') return false end
   return true
end

-----------------------------------------------------------------------------------------------------------------------
-- rgb() and rgba()
-----------------------------------------------------------------------------------------------------------------------

@Test function ReadRGB()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "rgb(255,128,0)", painter)
   assert(checkRGB(painter, 1.0, 128/255, 0, 1.0), 'Failed rgb(255,128,0)')
end

@Test function ReadRGBWithAlpha()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "rgb(255,255,255,0.5)", painter)
   assert(checkRGB(painter, 1.0, 1.0, 1.0, 0.5), 'Failed rgb() with alpha')
end

@Test function ReadRGBA()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "rgba(0,0,0,0.75)", painter)
   assert(checkRGB(painter, 0, 0, 0, 0.75), 'Failed rgba()')
end

@Test function ReadRGBPercentage()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "rgb(100%,50%,0%)", painter)
   assert(checkRGB(painter, 1.0, 0.5, 0, 1.0), 'Failed rgb() with percentages')
end

@Test function ReadRGBBlack()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "rgb(0,0,0)", painter)
   assert(checkRGB(painter, 0, 0, 0, 1.0), 'Failed rgb() black')
end

-----------------------------------------------------------------------------------------------------------------------
-- rgb() space-separated (modern CSS)
-----------------------------------------------------------------------------------------------------------------------

@Test function ReadRGBSpace()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "rgb(255 128 0)", painter)
   assert(checkRGB(painter, 1.0, 128/255, 0, 1.0), 'Failed rgb() space-separated')
end

@Test function ReadRGBSpaceAlpha()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "rgb(255 255 255 / 0.5)", painter)
   assert(checkRGB(painter, 1.0, 1.0, 1.0, 0.5), 'Failed rgb() space-separated with alpha')
end

@Test function ReadRGBSpaceAlphaPercent()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "rgb(0 0 255 / 75%)", painter)
   assert(checkRGB(painter, 0, 0, 1.0, 0.75), 'Failed rgb() space-separated with percentage alpha')
end

@Test function ReadRGBSpacePercentage()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "rgb(100% 50% 0%)", painter)
   assert(checkRGB(painter, 1.0, 0.5, 0, 1.0), 'Failed rgb() space-separated with percentages')
end

@Test function ReadRGBSpacePercentageAlpha()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "rgb(100% 0% 0% / 0.3)", painter)
   assert(checkRGB(painter, 1.0, 0, 0, 0.3), 'Failed rgb() space-separated percentages with alpha')
end

@Test function ReadRGBSpaceBlack()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "rgb(0 0 0)", painter)
   assert(checkRGB(painter, 0, 0, 0, 1.0), 'Failed rgb() space-separated black')
end

@Test function ReadRGBSpaceNoAlpha()
   -- Verify alpha defaults to 1.0 when no slash is present
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "rgb(128 64 32)", painter)
   assert(checkRGB(painter, 128/255, 64/255, 32/255, 1.0), 'Failed rgb() space-separated default alpha')
end

@Test function ReadRGBASpace()
   -- rgba() prefix should also work with the space-separated format
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "rgba(0 255 0 / 0.8)", painter)
   assert(checkRGB(painter, 0, 1.0, 0, 0.8), 'Failed rgba() space-separated')
end

