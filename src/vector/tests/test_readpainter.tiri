@Test function ReadNamedCssColour4()
   -- Names added in CSS Color Level 4
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "rebeccapurple", painter)
   assert(checkRGB(painter, 102/255, 51/255, 153/255, 1.0), 'Failed named colour "rebeccapurple"')

   check mVec.ReadPainter(nil, "Transparent", painter)
   assert(checkRGB(painter, 0, 0, 0, 0), 'Failed named colour "transparent"')
