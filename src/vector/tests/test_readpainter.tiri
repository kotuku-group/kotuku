-----------------------------------------------------------------------------------------------------------------------
-- Input formatting edge cases
-----------------------------------------------------------------------------------------------------------------------

@Test function LeadingSemicolon()
   -- ReadPainter() should skip a leading semicolon
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, ";rgb(255,0,0)", painter)
   assert(checkRGB(painter, 1.0, 0, 0, 1.0), 'Failed to skip leading semicolon')
end

@Test function LeadingWhitespace()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "  rgb(0,255,0)", painter)
   assert(checkRGB(painter, 0, 1.0, 0, 1.0), 'Failed to skip leading whitespace')
end

@Test function InvalidColourName()
   painter = struct.new('VectorPainter')
   local err = mVec.ReadPainter(nil, "notacolour", painter)
   assert(err != ERR_Okay, 'Invalid colour name should return an error')
end

@Test function InvalidHexLength()
   painter = struct.new('VectorPainter')
   local err = mVec.ReadPainter(nil, "#ab", painter)
   assert(err != ERR_Okay, 'Hex with 2 nibbles should return an error')
end

-----------------------------------------------------------------------------------------------------------------------
-- Result: the content following a painter, used for painter lists and SVG fallback colours
-----------------------------------------------------------------------------------------------------------------------

function readResult(IRI:str!):<num, str>
   local painter = struct.new('VectorPainter')
   local err, result = mVec.ReadPainter(nil, IRI, painter)
   check err
   return painter.colour.red, result ?? ''
end

@Test function ResultExposesCommaSeparator()
   local red, result = readResult('red, blue')
   assert(red is 1, 'The first painter of a comma-separated list should be parsed')
   assert(result is ', blue', f'Result should start at the comma separator, got [{result}]')

   red, result = readResult('#ff0000 , blue')
   assert(result is ', blue', f'Whitespace before a hex separator should be skipped, got [{result}]')

   red, result = readResult('rgb(255 0 0) ,blue')
   assert(result is ',blue', f'Whitespace before a function separator should be skipped, got [{result}]')
end

@Test function ResultExposesSemicolonSeparator()
   local red, result = readResult('red;blue')
   assert(result is ';blue', f'Named colour result should point at the next painter, got [{result}]')

   red, result = readResult('#f00 ;blue')
   assert(result is ';blue', f'Hex result should point at the next painter, got [{result}]')
end

@Test function ResultExposesFallbackColour()
   -- Content that does not start with a separator must be returned intact so that it can be read as a fallback.

   local red, result = readResult('rgb(255,0,0) blue')
   assert(red is 1, 'The colour preceding a fallback should be parsed')
   assert(result is 'blue', f'Function colours must not discard trailing content, got [{result}]')

   red, result = readResult('red blue')
   assert(red is 1, 'Named colours should terminate at whitespace')
   assert(result is 'blue', f'Named colour result should expose the trailing token, got [{result}]')

   red, result = readResult('#ff0000 junk;blue')
   assert(result is 'junk;blue', f'Hex colours must not skip ahead to the next separator, got [{result}]')
end

@Test function ResultEmptyAtEnd()
   local red, result = readResult('rgb(255 0 0)  ')
   assert(result is '', f'Trailing whitespace should produce an empty result, got [{result}]')

   red, result = readResult('red')
   assert(result is '', f'A lone painter should produce an empty result, got [{result}]')
end

@Test function LeadingSeparatorSkipped()
   -- The result of a previous call can be passed back to ReadPainter() as-is.

   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, ', blue', painter)
   assert(checkRGB(painter, 0, 0, 1.0, 1.0), 'A leading comma should be skipped')
   check mVec.ReadPainter(nil, ';blue', painter)
   assert(checkRGB(painter, 0, 0, 1.0, 1.0), 'A leading semi-colon should be skipped')
end

-----------------------------------------------------------------------------------------------------------------------
-- Cross-verification: equivalent colours in different formats produce the same result
-----------------------------------------------------------------------------------------------------------------------

@Test function CrossVerifyRedFormats()
   -- Pure red expressed in multiple formats should produce near-identical RGB values
   local formats = {
      "rgb(255,0,0)",
      "rgb(255 0 0)",
      "#ff0000",
      "red",
      "hsl(0,100,50)"
   }

   local results = {}
   for i, fmt in ipairs(formats) do
      local p = struct.new('VectorPainter')
      check mVec.ReadPainter(nil, fmt, p)
      results[i] = p
   end

   for i in {0 to #results - 1} do
      local a = results[i].colour
      local b = results[i + 1].colour
      assert((a.red ≈ b.red) and (a.green ≈ b.green) and (a.blue ≈ b.blue),
         f'Red cross-check failed between format {i} and {i+1}')
   end
end

-----------------------------------------------------------------------------------------------------------------------
-- color()
-----------------------------------------------------------------------------------------------------------------------

@Test function ReadColorSrgb()
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "color(srgb 1 0.5 0)", painter)
   assert(checkRGB(painter, 1.0, 0.5, 0, 1.0), 'Failed color(srgb)')

   check mVec.ReadPainter(nil, "color(srgb 100% 50% 0% / 25%)", painter)
   assert(checkRGB(painter, 1.0, 0.5, 0, 0.25), 'Failed color(srgb) with percentages and alpha')

   check mVec.ReadPainter(nil, "color( SRGB none 1 none / 0.5 )", painter)
   assert(checkRGB(painter, 0, 1.0, 0, 0.5), 'Failed color(srgb) with none, space case and whitespace')
end

@Test function ReadColorSrgbLinear()
   -- Linear 0.2158605 is sRGB 128/255
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "color(srgb-linear 0.21586050011 1 0)", painter)
   assert(checkRGB(painter, 128/255, 1.0, 0, 1.0), 'Failed color(srgb-linear)')
end

@Test function ReadColorDisplayP3()
   -- sRGB red is color(display-p3 0.9175 0.2003 0.1386) in CSS Color 4
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "color(display-p3 0.9175 0.2003 0.1386)", painter)
   rgb = painter.colour
   assert(math.abs(rgb.red - 1) < 0.001 and math.abs(rgb.green) < 0.001 and math.abs(rgb.blue) < 0.001,
      f'P3 sRGB red: got {rgb.red} {rgb.green} {rgb.blue}')

   check mVec.ReadPainter(nil, "color(display-p3 1 1 1 / 0.5)", painter)
   assert(checkRGB(painter, 1.0, 1.0, 1.0, 0.5), 'P3 white must be sRGB white')

   -- P3 green is outside sRGB; negative channels use the mirrored sRGB transfer function.
   check mVec.ReadPainter(nil, "color(display-p3 0 1 0)", painter)
   rgb = painter.colour
   assert(math.abs(rgb.red + 0.511605) < 0.001 and math.abs(rgb.green - 1.018266) < 0.001 and
      math.abs(rgb.blue + 0.310675) < 0.001,
      f'P3 green conversion: got {rgb.red} {rgb.green} {rgb.blue}')
end

@Test function ReadColorRec2020()
   -- sRGB red encoded with the CSS Color 4 BT.1886 transfer function
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "color(rec2020 0.82346410 0.32842945 0.18033933)", painter)
   rgb = painter.colour
   assert(math.abs(rgb.red - 1) < 0.001 and math.abs(rgb.green) < 0.001 and math.abs(rgb.blue) < 0.001,
      f'Rec. 2020 sRGB red: got {rgb.red} {rgb.green} {rgb.blue}')

   check mVec.ReadPainter(nil, "color(rec2020 100% 100% 100% / 0.5)", painter)
   assert(checkRGB(painter, 1.0, 1.0, 1.0, 0.5), 'Rec. 2020 white must be sRGB white')

   -- Rec. 2020 green is far outside sRGB
   check mVec.ReadPainter(nil, "color(rec2020 0 1 0)", painter)
   rgb = painter.colour
   assert(math.abs(rgb.red + 0.790375) < 0.001 and math.abs(rgb.green - 1.056302) < 0.001 and
      math.abs(rgb.blue + 0.350164) < 0.001,
      f'Rec. 2020 green conversion: got {rgb.red} {rgb.green} {rgb.blue}')

   -- BT.1886 remains a power function near black: 0.045 is linear 0.000585747
   check mVec.ReadPainter(nil, "color(rec2020 0.045 0.045 0.045)", painter)
   rgb = painter.colour
   assert(math.abs(rgb.red - 0.00756785) < 0.00001 and math.abs(rgb.green - rgb.red) < 0.00001 and
      math.abs(rgb.blue - rgb.red) < 0.00001,
      f'Rec. 2020 dark grey: got {rgb.red} {rgb.green} {rgb.blue}')

   -- Neutral midtones distinguish BT.1886 from the inverse camera encoding curve.
   for value in values(array<double> { 0.5, -0.5 }) do
      check mVec.ReadPainter(nil, f"color(rec2020 {value} {value} {value})", painter)
      rgb = painter.colour
      expected = value < 0 ? -0.4725 : 0.4725
      assert(math.abs(rgb.red - expected) < 0.00001 and math.abs(rgb.green - expected) < 0.00001 and
         math.abs(rgb.blue - expected) < 0.00001,
         f'Rec. 2020 grey {value}: got {rgb.red} {rgb.green} {rgb.blue}')
   end
end

@Test function ReadColorA98Rgb()
   -- sRGB red is color(a98-rgb 0.8586 0 0) in CSS Color 4
   painter = struct.new('VectorPainter')
   check mVec.ReadPainter(nil, "color(a98-rgb 0.85859 0 0)", painter)
   rgb = painter.colour
   assert(math.abs(rgb.red - 1) < 0.001 and math.abs(rgb.green) < 0.001 and math.abs(rgb.blue) < 0.001,
      f'A98 sRGB red: got {rgb.red} {rgb.green} {rgb.blue}')

   check mVec.ReadPainter(nil, "color(A98-RGB 1 1 1 / 25%)", painter)
   assert(checkRGB(painter, 1.0, 1.0, 1.0, 0.25), 'A98 white must be sRGB white')

   check mVec.ReadPainter(nil, "color(a98-rgb 0 1 0)", painter)
   rgb = painter.colour
   assert(math.abs(rgb.red + 0.66395) < 0.001 and math.abs(rgb.green - 1) < 0.001 and
      math.abs(rgb.blue + 0.229161) < 0.001,
      f'A98 green conversion: got {rgb.red} {rgb.green} {rgb.blue}')
end

@Test function ReadColorFollowedByFallback()
   painter = struct.new('VectorPainter')
   err, result = mVec.ReadPainter(nil, "color(display-p3 1 1 1), red", painter)
   assert(err is ERR_Okay and result is ', red', f'The content after color() must be returned, got "{result}"')
end

@Test function RejectInvalidColor()
   painter = struct.new('VectorPainter')
   for iri in values(array<str> {
      'color(prophoto-rgb 1 0 0)', 'color(a98 1 0 0)', 'color(1 0 0)', 'color(display-p3 1 0)', 'color(display-p3 1 x 0)', 'color()'
   }) do
      err = mVec.ReadPainter(nil, iri, painter)
      assert(err is ERR_Syntax, f'{iri} must return ERR_Syntax, got {err}')
   end
end
