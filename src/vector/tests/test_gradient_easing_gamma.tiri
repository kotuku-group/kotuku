   include 'display', 'vector'

module display as mGfx

function newBitmap(Width, Height)
   local bmp = obj.new('bitmap', { width=Width, height=Height, bitsPerPixel=32, bkgd='0,0,0,255' })
   bmp.acClear()
   return bmp
end

function stop(Offset, R, G, B, Alpha)
   local s = struct.new('GradientStop')
   s.offset    = Offset
   s.rgb.red   = R
   s.rgb.green = G
   s.rgb.blue  = B
   s.rgb.alpha = Alpha is nil ? 1.0 : Alpha
   return s
end

function blackWhiteStops()
   local stops = { }
   stops.insert(stop(0.0, 0.0, 0.0, 0.0))
   stops.insert(stop(1.0, 1.0, 1.0, 1.0))
   return stops
end

function newLinearScene(Options, RectOptions)
   local scene = obj.new('VectorScene', { pageWidth=100, pageHeight=20 })
   local viewport = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })

   local gradient_options = {
      units=VUNIT_USERSPACE,
      x1=0,
      y1=0,
      x2=100,
      y2=0
   }

   for key, value in pairs(Options) do
      if key != 'stops' then gradient_options[key] = value end
   end

   local gradient = scene.new('GradientLinear', gradient_options)
   gradient.stops = Options.stops ?? blackWhiteStops()
   check scene.mtAddDef('linear', gradient)

   local rect_options = { x=0, y=0, width='100%', height='100%', fill='url(#linear)' }
   if RectOptions != nil then
      for key, value in pairs(RectOptions) do
         rect_options[key] = value
      end
   end

   viewport.new('VectorRectangle', rect_options)
   return scene, gradient
end

function newColourMapScene(Easing)
   local scene = obj.new('VectorScene', { pageWidth=100, pageHeight=20 })
   local viewport = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })

   local gradient = scene.new('GradientLinear', {
      units=VUNIT_USERSPACE,
      x1=0,
      y1=0,
      x2=100,
      y2=0,
      colourMap='cmap:viridis',
      easing=Easing
   })
   check scene.mtAddDef('colourmap', gradient)

   viewport.new('VectorRectangle', { x=0, y=0, width='100%', height='100%', fill='url(#colourmap)' })
   return scene, gradient
end

function drawScene(Scene, Bitmap)
   Bitmap.acClear()
   Scene.bitmap = Bitmap
   check Scene.acDraw()
end

function drawHash(Scene, Bitmap)
   drawScene(Scene, Bitmap)
   return mSys.GenCRC32(0, Bitmap.data, Bitmap.size)
end

function sampleMiddleRed(Scene):num
   local bmp = newBitmap(100, 20)
   drawScene(Scene, bmp)
   return mGfx.ReadRGBPixel(bmp, 50, 10).red
end

@Test function DarkLinearRGBRampUsesEveryGreyLevel()
   local scene = newLinearScene({
      colourSpace=VCS_LINEAR_RGB,
      stops={ stop(0, 0, 0, 0), stop(1, 20 / 255, 20 / 255, 20 / 255) }
   })
   local bmp = newBitmap(100, 20)
   drawScene(scene, bmp)

   local levels = { }
   for x in {0 into 99} do
      local p = mGfx.ReadRGBPixel(bmp, x, 10)
      assert(p.red is p.green and p.red is p.blue, f'Expected neutral grey at x={x}')
      assert(p.red <= 20, f'The dark ramp exceeded sRGB level 20 at x={x}, got {p.red}')
      levels[p.red] = true
   end

   assert(mGfx.ReadRGBPixel(bmp, 99, 10).red is 20, 'The dark ramp must end at sRGB level 20')
   for level in {0 into 20} do
      assert(levels[level], f'The linearRGB ramp skipped sRGB level {level}')
   end
end

@Test function SRGBRoundsAfterInterpolatingFractionalStops()
   local scene = newLinearScene({
      colourSpace=VCS_SRGB,
      stops={ stop(0, 10.6 / 255, 0, 0), stop(1, 11.6 / 255, 0, 0) }
   })
   local bmp = newBitmap(100, 20)
   drawScene(scene, bmp)

   local p = mGfx.ReadRGBPixel(bmp, 60, 10)
   assert(p.red is 11, f'Expected red level 11 at 60%, got {p.red}')
end

@Test function TransparentStopRetainsItsColourDuringInterpolation()
   for colour_space in values({ VCS_SRGB, VCS_LINEAR_RGB }) do
      local scene = newLinearScene({
         colourSpace=colour_space,
         stops={ stop(0, 1, 0, 0), stop(1, 0, 0, 1, 0) }
      })
      local bmp = obj.new('bitmap', {
         width=100, height=20, bitsPerPixel=32, bkgd='255,255,255,255', blendMode=BLM_SRGB
      })
      drawScene(scene, bmp)

      local p = mGfx.ReadRGBPixel(bmp, 50, 10)
      local expected = colour_space is VCS_SRGB ? 191 : 221
      assert(math.abs(p.red - expected) <= 3 and math.abs(p.blue - expected) <= 3 and
         math.abs(p.green - 128) <= 3,
         f'Expected straight-alpha midpoint in colour space {colour_space}, got {p.red},{p.green},{p.blue}')
   end
end

@Test function PerceptualMidpointsMatchCSSGamutMapping()
   -- Color.js 0.7.1, toGamut({ space: "srgb", method: "css" }) at table entry 128 of 255.
   local cases = {
      { mode=GCI_OKLAB, first=stop(0, 0, 0, 1), last=stop(1, 1, 1, 0), r=108, g=172, b=199 },
      { mode=GCI_OKLAB, first=stop(0, 1, 0, 0), last=stop(1, 0, 1, 1), r=210, g=169, b=148 },
      { mode=GCI_OKLCH, first=stop(0, 0, 0, 1), last=stop(1, 1, 1, 0), r=0, g=190, b=176 },
      { mode=GCI_OKLCH, first=stop(0, 0, 128 / 255, 0), last=stop(1, 1, 0, 1), r=207, g=95, b=0 }
   }
   local bmp = newBitmap(100, 20)
   for sample in values(cases) do
      local scene = newLinearScene({
         x2=101, colourSpace=VCS_LINEAR_RGB, interpolation=sample.mode, stops={ sample.first, sample.last }
      })
      drawScene(scene, bmp)
      local p = mGfx.ReadRGBPixel(bmp, 50, 10)
      assert(math.abs(p.red - sample.r) <= 1 and math.abs(p.green - sample.g) <= 1 and
         math.abs(p.blue - sample.b) <= 1,
         f'Expected {sample.r},{sample.g},{sample.b}, got {p.red},{p.green},{p.blue}')
   end
end

@Test function PerceptualRampsPremultiplyAlphaAndBorrowHue()
   local bmp = obj.new('bitmap', {
      width=100, height=20, bitsPerPixel=32, bkgd='255,255,255,255', blendMode=BLM_SRGB
   })
   for mode in values({ GCI_OKLAB, GCI_OKLCH }) do
      local scene = newLinearScene({
         interpolation=mode, hueMethod=GHM_LONGER, stops={ stop(0, 1, 0, 0), stop(1, 0, 0, 1, 0) }
      })
      drawScene(scene, bmp)
      local p = mGfx.ReadRGBPixel(bmp, 50, 10)
      assert(p.red is 255 and math.abs(p.green - 128) <= 3 and p.green is p.blue,
         f'Expected a red midpoint at half opacity, got {p.red},{p.green},{p.blue}')
   end

   local scene, gradient = newLinearScene({
      interpolation=GCI_OKLCH, stops={ stop(0, 0, 0, 1), stop(1, 1, 1, 1) }
   })
   local shorter = drawHash(scene, bmp)
   gradient.hueMethod = GHM_LONGER
   assert(drawHash(scene, bmp) is shorter, 'White should borrow blue’s hue without a hue sweep')
end

@Test function PerceptualFieldsRebuildOpacityAdjustedTables()
   local scene, gradient = newLinearScene({
      stops={ stop(0, 1, 0, 0), stop(1, 0, 0, 1) }
   }, { fillOpacity=0.5 })
   local bmp = newBitmap(100, 20)
   local default_hash = drawHash(scene, bmp)

   gradient.interpolation = GCI_OKLCH
   local shorter = drawHash(scene, bmp)
   assert(shorter != default_hash, 'Changing interpolation should replace the cached fill ramp')
   gradient.hueMethod = GHM_LONGER
   local longer = drawHash(scene, bmp)
   assert(longer != shorter, 'Changing the hue arc should replace the cached fill ramp')
   gradient.hueMethod = GHM_INCREASING
   assert(drawHash(scene, bmp) is longer, 'Increasing hue should match the longer arc from red to blue')
   gradient.hueMethod = GHM_DECREASING
   assert(drawHash(scene, bmp) is shorter, 'Decreasing hue should match the shorter arc from red to blue')

   gradient.interpolation = GCI_DEFAULT
   assert(drawHash(scene, bmp) is default_hash, 'Restoring default interpolation should restore the original ramp')
end

@Test function LinearEasingMatchesDefault()
   local default_scene = newLinearScene({ })
   local linear_scene = newLinearScene({ easing=GEZ_LINEAR })

   assert(sampleMiddleRed(default_scene) is sampleMiddleRed(linear_scene),
      'GEZ_LINEAR should match the default gradient ramp')
end

@Test function CubicInEasingDarkensMidpoint()
   local linear_scene = newLinearScene({ easing=GEZ_LINEAR })
   local eased_scene = newLinearScene({ easing=GEZ_CUBIC_IN })

   local linear_mid = sampleMiddleRed(linear_scene)
   local eased_mid = sampleMiddleRed(eased_scene)

   assert(eased_mid < linear_mid - 40,
      'CUBIC_IN easing should move the midpoint toward the first stop (linear ' ..
      linear_mid .. ', eased ' .. eased_mid .. ')')
end

@Test function PostInitEasingChangeRebuildsTable()
   local scene, gradient = newLinearScene({ easing=GEZ_LINEAR })

   local linear_mid = sampleMiddleRed(scene)
   gradient.easing = GEZ_CUBIC_IN
   local eased_mid = sampleMiddleRed(scene)

   assert(eased_mid < linear_mid - 40,
      'Changing Easing after initialisation should rebuild the colour table (linear ' ..
      linear_mid .. ', eased ' .. eased_mid .. ')')
end

@Test function PostInitEasingChangeRefreshesOpacityTable()
   local scene, gradient = newLinearScene({ easing=GEZ_LINEAR }, { opacity=0.5 })

   local linear_mid = sampleMiddleRed(scene)
   gradient.easing = GEZ_CUBIC_IN
   local eased_mid = sampleMiddleRed(scene)

   assert(eased_mid < linear_mid - 20,
      'Changing Easing should refresh cached opacity-adjusted gradient tables (linear ' ..
      linear_mid .. ', eased ' .. eased_mid .. ')')
end

@Test function GammaOneMatchesDefault()
   local default_scene = newLinearScene({ })
   local gamma_scene = newLinearScene({ gamma=1.0 })

   assert(sampleMiddleRed(default_scene) is sampleMiddleRed(gamma_scene),
      'Gamma 1.0 should match the default gradient ramp')
end

@Test function GammaTwoDarkensMidpoint()
   local default_scene = newLinearScene({ })
   local gamma_scene = newLinearScene({ gamma=2.0 })

   local normal_mid = sampleMiddleRed(default_scene)
   local gamma_mid = sampleMiddleRed(gamma_scene)

   assert(gamma_mid < normal_mid - 40,
      'Gamma 2.0 should move the midpoint toward the first stop (normal ' ..
      normal_mid .. ', gamma ' .. gamma_mid .. ')')
end

@Test function ColourMapEasingChangesRamp()
   local linear_scene = newColourMapScene(GEZ_LINEAR)
   local eased_scene = newColourMapScene(GEZ_CUBIC_IN)
   local linear_bmp = newBitmap(100, 20)
   local eased_bmp = newBitmap(100, 20)

   assert(drawHash(linear_scene, linear_bmp) != drawHash(eased_scene, eased_bmp),
      'Easing should alter ColourMap-backed gradients')
end

@Test function PostInitColourMapEasingChangeRebuildsTable()
   local scene, gradient = newColourMapScene(GEZ_LINEAR)
   local bmp = newBitmap(100, 20)
   local linear_hash = drawHash(scene, bmp)

   gradient.easing = GEZ_CUBIC_IN
   local eased_hash = drawHash(scene, bmp)

   assert(eased_hash != linear_hash,
      'Changing Easing after initialisation should rebuild ColourMap-backed gradients')
end

@Test function ResolutionChangesRebuildFromOriginalStops()
   local scene, gradient = newLinearScene({ }, { opacity=0.5 })
   local fresh = newLinearScene({ resolution=0.75 }, { opacity=0.5 })
   local bmp = newBitmap(100, 20)
   local full_hash = drawHash(scene, bmp)

   gradient.resolution = 0.25
   local coarse_hash = drawHash(scene, bmp)
   assert(coarse_hash != full_hash, 'Reducing Resolution should change the ramp')

   gradient.resolution = 0.75
   local updated_hash = drawHash(scene, bmp)
   assert(updated_hash != coarse_hash, 'Changing Resolution from 0.25 to 0.75 should regenerate the ramp')
   assert(updated_hash is drawHash(fresh, bmp), 'The rebuilt ramp should match a fresh gradient at the same Resolution')

   gradient.resolution = 1.0
   assert(drawHash(scene, bmp) is full_hash, 'Restoring full Resolution should recover the original ramp')
end

@Test function ImplicitColourMapRendersAndRetainsPalette()
   local scene = obj.new('VectorScene', { pageWidth=100, pageHeight=20 })
   local viewport = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   viewport.new('VectorRectangle', { x=0, y=0, width='100%', height='100%', fill='url(#cmap:viridis)' })
   local bmp = newBitmap(100, 20)
   local default_hash = drawHash(scene, bmp)
   local left_red = mGfx.ReadRGBPixel(bmp, 5, 10).red
   local right_red = mGfx.ReadRGBPixel(bmp, 95, 10).red
   assert(left_red < 100 and right_red > 200, f'Viridis should render a ramp, got red {left_red} and {right_red}')

   local _, gradient = check scene.mtFindDef('cmap:viridis')
   assert(gradient.colourMap is 'cmap:viridis', 'The implicit gradient should retain its palette name')
   gradient.easing = GEZ_CUBIC_IN
   assert(drawHash(scene, bmp) != default_hash, 'Changing Easing should rebuild the implicit colourmap')
end

@Test function GammaKeepsCoincidentStopsSharp()
   local scene = newLinearScene({
      gamma=2.0,
      colourSpace=VCS_LINEAR_RGB,
      stops={ stop(0, 0, 0, 0), stop(0.25, 0, 0, 0), stop(0.25, 1, 1, 1), stop(1, 1, 1, 1) }
   })
   local bmp = newBitmap(100, 20)
   drawScene(scene, bmp)

   for x in {0 to 100} do
      local expected = x < 50 ? 0 : 255
      local p = mGfx.ReadRGBPixel(bmp, x, 10)
      assert(p.red is expected, f'Expected a sharp step at x=50, got red {p.red} at x={x}')
   end
end

@Test function ColourMapEasingResamplesUnroundedColours()
   local scene = newColourMapScene(GEZ_CUBIC_IN)
   local bmp = newBitmap(100, 20)
   drawScene(scene, bmp)

   -- Cubic easing at this lookup position samples between Viridis entries 1 and 2.
   local sample = mGfx.ReadRGBPixel(bmp, 16, 10).red
   assert(sample is 69, f'Expected red 69 from the original Viridis samples, got {sample}')
end

@Test function ReducedResolutionRoundsAfterAveraging()
   local t = 128 / 255
   local scene = newLinearScene({
      resolution=0,
      stops={ stop(0, 10 / 255, 0, 0), stop(t, 10 / 255, 0, 0), stop(t, 11 / 255, 0, 0),
         stop(1, 11 / 255, 0, 0) }
   })

   local sample = sampleMiddleRed(scene)
   assert(sample is 11, f'Expected the RMS of red 10 and 11 to round to 11, got {sample}')
end
