-- Verifies pin-based lazy callback invalidation (zombie object pinning).  Feedback subscriptions made by a script
-- must be discarded silently after that script is freed - without crashing on the zombie context and without
-- disturbing other live subscribers.

   include 'vector'

module vector as mVec

function newRectScene(RectName)
   scene = obj.new('VectorScene')
   viewport = scene.new('VectorViewport')
   rect = viewport.new('VectorRectangle', { name=RectName, x=10, y=10, width=100, height=80 })
   scene.init()
   viewport.init()
   rect.init()
   return scene, viewport, rect
end

-- Dirty the rectangle's path and force regeneration, which emits FM_PATH_CHANGED to feedback subscribers.

function firePathChanged(Rect)
   Rect.width = Rect.width + 10
   err = Rect.mtGetBoundary(VBF_NO_TRANSFORM)
   check err
end

function drawResizeScene(Scene, Bitmap)
   Bitmap.acClear()
   Scene.bitmap = Bitmap
   check Scene.acDraw()
end

@Test function UnsubscribeFeedbackByFunction()
   local scene <close>, viewport, rect = newRectScene('callback_identity_rect')
   local calls = 0
   local callback = function() calls++ end

   check rect.mtSubscribeFeedback(FM_PATH_CHANGED, callback)
   firePathChanged(rect)
   assert(calls > 0, 'The original feedback subscription should receive events')

   check rect.mtSubscribeFeedback(0, callback)
   local before = calls
   firePathChanged(rect)
   assert(calls is before, 'Passing the same function should remove its feedback subscription immediately')

   check rect.mtSubscribeFeedback(FM_PATH_CHANGED, callback)
   firePathChanged(rect)
   assert(calls > before, 'A function should be usable again after its last subscription is removed')
   check rect.mtSubscribeFeedback(0, callback)
end

@Test function SharedFeedbackFunctionRetainsOtherSubscriptions()
   local scene <close>, viewport, rect = newRectScene('callback_identity_shared')
   local other = viewport.new('VectorRectangle', { width=20, height=20 })
   local calls = 0
   local unrelated_calls = 0
   local callback = function() calls++ end
   local unrelated = function() unrelated_calls++ end

   check rect.mtSubscribeFeedback(FM_PATH_CHANGED, callback)
   check rect.mtSubscribeFeedback(FM_PATH_CHANGED, callback)
   check other.mtSubscribeFeedback(FM_PATH_CHANGED, callback)
   check rect.mtSubscribeFeedback(FM_PATH_CHANGED, unrelated)
   firePathChanged(rect)
   firePathChanged(other)
   assert(calls > 0 and unrelated_calls > 0, 'Both callback functions should initially receive events')

   check rect.mtSubscribeFeedback(0, callback)
   local before = calls
   local unrelated_before = unrelated_calls
   firePathChanged(rect)
   assert(calls is before, 'Unsubscribing should remove every matching registration on this vector')
   assert(unrelated_calls > unrelated_before, 'Unsubscribing should preserve other callback functions')
   firePathChanged(other)
   assert(calls > before, 'Removing one vector subscription must preserve the function used by another vector')
   check other.mtSubscribeFeedback(0, callback)
   check rect.mtSubscribeFeedback(0, unrelated)
end

@Test function UnsubscribeFeedbackPreservesOtherContexts()
   local scene <close>, viewport, rect = newRectScene('callback_identity_context')
   local first = entity { calls=0 }
   local second = entity { calls=0 }
   local callback = function() &calls++ end

   using first do
      check rect.mtSubscribeFeedback(FM_PATH_CHANGED, callback)
   end
   using second do
      check rect.mtSubscribeFeedback(FM_PATH_CHANGED, callback)
   end
   firePathChanged(rect)
   assert(first.calls > 0 and second.calls > 0, 'Each registration should retain its own context')

   using first do
      check rect.mtSubscribeFeedback(0, callback)
   end
   local first_before = first.calls
   local second_before = second.calls
   firePathChanged(rect)
   assert(first.calls is first_before, 'The same function and entity should match the original registration')
   assert(second.calls > second_before, 'Unsubscribing one context must preserve the other context')
   using second do
      check rect.mtSubscribeFeedback(0, callback)
   end
end

@Test function UnsubscribeFeedbackReleasesFunctionAndContext()
   local scene <close>, viewport, rect = newRectScene('callback_identity_release')
   local weak = setmetatable({}, { __mode='v' })

   function register()
      local owner = entity { calls=0 }
      local callback = function() &calls++ end
      weak.owner = owner
      weak.callback = callback
      using owner do
         check rect.mtSubscribeFeedback(FM_PATH_CHANGED, callback)
      end
   end

   function unregister()
      using weak.owner do
         check rect.mtSubscribeFeedback(0, weak.callback)
      end
   end

   register()
   processing.collect()
   assert(weak.owner != nil and weak.callback != nil, 'A live subscription should retain its callback and context')
   unregister()
   processing.collect()
   processing.collect()
   assert(weak.owner is nil and weak.callback is nil, 'The last unsubscribe should release the function and context')
end

-- A script subscribes to vector feedback and is then freed.  Regenerating the path must not crash on the stale
-- context; the first event pass removes the record lazily and the second confirms stability.

@Test function StaleScriptSubscriberIsDiscarded()
   scene, viewport, rect = newRectScene('callback_lifetime_rect')

   sub_script = obj.new('tiri', { statement=[[
      include 'vector'
      local rect = obj.find('callback_lifetime_rect')
      assert(rect != nil, 'Sub-script could not find the target rectangle')
      check rect.mtSubscribeFeedback(FM_PATH_CHANGED, function(Vector, EventFlag, EventObject)
         raise('A feedback callback fired for a freed script context')
      end)
   ]] })

   check sub_script.acActivate()
   sub_script.free()
   sub_script = nil

   firePathChanged(rect)
   firePathChanged(rect)
end

-- With a freed subscriber ahead of a live one in the subscription list, the stale record's lazy removal must not
-- disturb delivery to the live subscriber.

@Test function LiveSubscriberSurvivesStaleRemoval()
   scene, viewport, rect = newRectScene('callback_lifetime_rect_live')

   sub_script = obj.new('tiri', { statement=[[
      include 'vector'
      local rect = obj.find('callback_lifetime_rect_live')
      assert(rect != nil, 'Sub-script could not find the target rectangle')
      check rect.mtSubscribeFeedback(FM_PATH_CHANGED, function(Vector, EventFlag, EventObject)
         raise('A feedback callback fired for a freed script context')
      end)
   ]] })

   check sub_script.acActivate()

   glFeedbackCount = 0
   check rect.mtSubscribeFeedback(FM_PATH_CHANGED, function(Vector, EventFlag, EventObject)
      glFeedbackCount++
      return ERR_Okay
   end)

   sub_script.free()
   sub_script = nil

   firePathChanged(rect)
   assert(glFeedbackCount >= 1, 'Live subscriber did not receive feedback after stale record removal')

   local count_after_first = glFeedbackCount
   firePathChanged(rect)
   assert(glFeedbackCount > count_after_first, 'Live subscriber stopped receiving feedback on subsequent events')
end

-- Object dependency links (Mask, GuidePath) are weak-pinned rather than eagerly watched via AC_Free.  Freeing the
-- target must not crash subsequent draws or path generation, and the links must read as nil afterwards.

@Test function StaleDependencyLinksAreDropped()
   scene, viewport, rect = newRectScene('callback_lifetime_dep_rect')
   bitmap = obj.new('bitmap', { width=180, height=140, bitsPerPixel=32 })

   clip = scene.new('VectorClip')
   clip.init()
   rect.mask = clip

   guide = viewport.new('VectorPath', { sequence='M 0 0 L 100 100' })
   guide.init()
   rect.guidePath = guide

   drawResizeScene(scene, bitmap)

   clip.free()
   clip = nil
   guide.free()
   guide = nil

   drawResizeScene(scene, bitmap) -- Sweeps the stale mask link during the draw pass
   firePathChanged(rect)          -- Sweeps the stale guide link during path generation

   assert(rect.mask is nil, 'The mask link should be dropped after the clip is freed')
   assert(rect.guidePath is nil, 'The guide path link should be dropped after the guide is freed')
end

-- Freeing a scene that still carries a live resize subscription must release the pinned callback context in the
-- scene's destructor (child vectors skip that cleanup during a cascade free) without invoking the callback.

@Test function SceneFreeReleasesLiveResizeSubscription()
   scene, viewport, rect = newRectScene('callback_lifetime_scene_free')

   rect.resizeEvent = function(Viewport, Vector, X, Y, Width, Height)
      raise 'A resize callback fired during scene destruction'
   end

   scene.free()
   scene = nil
   viewport = nil
   rect = nil
end

-- ResizeEvent stores callbacks in a scene-level dispatch table rather than directly on the vector.  A stale script
-- context in that table must be removed lazily before dispatching the callback.

@Test function StaleResizeSubscriberIsDiscarded()
   scene, viewport, rect = newRectScene('callback_lifetime_resize_rect')
   bitmap = obj.new('bitmap', { width=180, height=140, bitsPerPixel=32, bkgd='0,0,0,255' })

   sub_script = obj.new('tiri', { statement=[[
      include 'vector'
      local rect = obj.find('callback_lifetime_resize_rect')
      assert(rect != nil, 'Sub-script could not find the target rectangle')
      rect.resizeEvent = function(Viewport, Vector, X, Y, Width, Height)
         raise('A resize callback fired for a freed script context')
      end
   ]] })

   check sub_script.acActivate()
   sub_script.free()
   sub_script = nil

   drawResizeScene(scene, bitmap)
   drawResizeScene(scene, bitmap)

   viewport.width = 120
   drawResizeScene(scene, bitmap)
   drawResizeScene(scene, bitmap)
end
