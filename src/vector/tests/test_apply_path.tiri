   include 'vector'

module display as mGfx
module vector as mVec

function assertNear(Actual, Expected, Message)
   assert(Actual ≈ Expected, f'{Message}: expected {Expected}, got {Actual}')
end

function newTargetPath()
   scene = obj.new('VectorScene')
   viewport = scene.new('VectorViewport')
   path = viewport.new('VectorPath')
   scene.init()
   viewport.init()
   path.init()
   return scene, viewport, path
end

function assertCommand(Path, Index, Type, X, Y, Message)
   err, command = Path.mtGetCommand(Index)
   assert(err is ERR_Okay, f'{Message}: GetCommand({Index}) failed with {mSys.GetErrorMsg(err)}')
   assert(command.type is Type, f'{Message}: command type mismatch')
   assertNear(command.x, X, f'{Message}: X')
   assertNear(command.y, Y, f'{Message}: Y')
end

function assertCurveCommand(Path, Index, Type, X, Y, X2, Y2, X3, Y3, Message)
   err, command = Path.mtGetCommand(Index)
   assert(err is ERR_Okay, f'{Message}: GetCommand({Index}) failed with {mSys.GetErrorMsg(err)}')
   assert(command.type is Type, f'{Message}: command type mismatch')
   assertNear(command.x, X, f'{Message}: X')
   assertNear(command.y, Y, f'{Message}: Y')
   assertNear(command.x2, X2, f'{Message}: X2')
   assertNear(command.y2, Y2, f'{Message}: Y2')
   assertNear(command.x3, X3, f'{Message}: X3')
   assertNear(command.y3, Y3, f'{Message}: Y3')
end

@Test function RectangleAppliesAsEditableCommands()
   err, source = mVec.GenerateRectangle(10, 20, 30, 40)
   check err

   scene, viewport, path = newTargetPath()
   check mVec.ApplyPath(source, path)

   assert(path.totalCommands is 5, f'Rectangle should apply as five commands, got {path.totalCommands}')
   assertCommand(path, 0, PE_Move, 10, 20, 'rectangle move')
   assertCommand(path, 1, PE_Line, 40, 20, 'rectangle top edge')
   assertCommand(path, 2, PE_Line, 40, 60, 'rectangle right edge')
   assertCommand(path, 3, PE_Line, 10, 60, 'rectangle bottom edge')

   local command
   err, command = path.mtGetCommand(4)
   assert(err is ERR_Okay, f'rectangle close: GetCommand failed with {mSys.GetErrorMsg(err)}')
   assert(command.type is PE_ClosePath, 'Rectangle should end with a close-path command')
end

@Test function ApplyPathReplacesExistingCommands()
   err, source = mVec.GenerateRectangle(1, 2, 3, 4)
   check err

   scene, viewport, path = newTargetPath()
   path.sequence = 'M 100 100 L 200 200'
   assert(path.totalCommands is 2, 'Precondition failed: path sequence should create two commands')

   check mVec.ApplyPath(source, path)

   assert(path.totalCommands is 5, f'Applied path should replace existing commands, got {path.totalCommands}')
   assertCommand(path, 0, PE_Move, 1, 2, 'replacement move')
end

@Test function PathXYMovesComputedBoundary()
   scene, viewport, path = newTargetPath()
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'

   err, x, y, width, height = path.mtGetBoundary(VBF_NO_TRANSFORM)
   check err
   assertNear(x, 10, 'default path boundary X')
   assertNear(y, 20, 'default path boundary Y')
   assertNear(width, 30, 'default path boundary width')
   assertNear(height, 30, 'default path boundary height')

   path.x = 100
   path.y = 200

   err, x, y, width, height = path.mtGetBoundary(VBF_NO_TRANSFORM)
   check err
   assertNear(x, 100, 'moved path boundary X')
   assertNear(y, 200, 'moved path boundary Y')
   assertNear(width, 30, 'moved path boundary width')
   assertNear(height, 30, 'moved path boundary height')

   assertNear(path.x, 100, 'reported path X')
   assertNear(path.y, 200, 'reported path Y')
   assertCommand(path, 0, PE_Move, 10, 20, 'path commands remain unchanged after X/Y placement')

   check path.acMoveToPoint(25, 35, 0, MTF_X | MTF_Y)

   err, x, y, width, height = path.mtGetBoundary(VBF_NO_TRANSFORM)
   check err
   assertNear(x, 25, 'MoveToPoint path boundary X')
   assertNear(y, 35, 'MoveToPoint path boundary Y')
   assertNear(width, 30, 'MoveToPoint path boundary width')
   assertNear(height, 30, 'MoveToPoint path boundary height')
end

@Test function PathXYReadFreshWithoutBoundary()
   -- X/Y getters must compute the path bounds on demand; reading them without a prior draw or
   -- GetBoundary() call previously returned stale or uninitialised bounds.
   scene, viewport, path = newTargetPath()
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'

   assertNear(path.x, 10, 'path X read directly after setting the sequence')
   assertNear(path.y, 20, 'path Y read directly after setting the sequence')

   path.sequence = 'M 50 60 L 70 60 L 70 80 Z'

   assertNear(path.x, 50, 'path X read after replacing the sequence')
   assertNear(path.y, 60, 'path Y read after replacing the sequence')
end

-- Scene helpers for the Width/Height tests.  The page and viewport are sized so that scaled units resolve to known
-- values.

function newSizedPath(Size:num!):<obj, obj, obj>
   local scene = obj.new('VectorScene', { pageWidth=Size, pageHeight=Size })
   local viewport = scene.new('VectorViewport', { x=0, y=0, width=Size, height=Size })
   local path = viewport.new('VectorPath')
   path.init()
   return scene, viewport, path
end

function assertBoundary(Path:obj!, X:num, Y:num, Width:num, Height:num, Message:str)
   local err, bx, by, bw, bh = Path.mtGetBoundary(VBF_NO_TRANSFORM)
   assert(err is ERR_Okay, f'{Message}: GetBoundary failed with {mSys.GetErrorMsg(err)}')
   if X != nil then assertNear(bx, X, f'{Message}: boundary X') end
   if Y != nil then assertNear(by, Y, f'{Message}: boundary Y') end
   if Width != nil then assertNear(bw, Width, f'{Message}: boundary width') end
   if Height != nil then assertNear(bh, Height, f'{Message}: boundary height') end
end

-- Draws the scene to a black bitmap and returns it.  Read channels with pixelLevel() because ReadRGBPixel() results
-- share a buffer.

function drawScene(Scene:obj!, Size:num!):obj
   local bitmap = obj.new('bitmap', { width=Size, height=Size, bitsPerPixel=32, bkgd='0,0,0,255' })
   bitmap.acClear()
   Scene.bitmap = bitmap
   check Scene.acDraw()
   return bitmap
end

function pixelLevel(Bitmap:obj!, X:num!, Y:num!):num
   local rgb = mGfx.ReadRGBPixel(Bitmap, X, Y)
   return rgb.red
end

@Test function PathWidthHeightFixed()
   scene, viewport, path = newTargetPath()
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.width = 60
   path.height = 90

   assertBoundary(path, 10, 20, 60, 90, 'fixed Width/Height')
   assertCommand(path, 0, PE_Move, 10, 20, 'move command unchanged by Width/Height')
   assertCommand(path, 2, PE_Line, 40, 50, 'line command unchanged by Width/Height')
end

@Test function PathWidthHeightWithXY()
   scene, viewport, path = newTargetPath()
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.width = 60
   path.height = 90
   path.x = 100
   path.y = 200
   assertBoundary(path, 100, 200, 60, 90, 'Width/Height set before X/Y')

   scene, viewport, path = newTargetPath()
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.x = 100
   path.y = 200
   path.width = 60
   path.height = 90
   assertBoundary(path, 100, 200, 60, 90, 'X/Y set before Width/Height')

   assertNear(path.x, 100, 'X reads back unchanged by sizing')
   assertNear(path.y, 200, 'Y reads back unchanged by sizing')
end

@Test function PathWidthOnly()
   scene, viewport, path = newTargetPath()
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.width = 120

   assertBoundary(path, 10, 20, 120, 30, 'Width without Height')
   assertNear(path.height, 30, 'Height reads the natural extent when only Width is set')
end

@Test function PathWidthHeightScaled()
   scene, viewport, path = newSizedPath(400)
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.width = '50%'
   path.height = '25%'

   assertBoundary(path, 10, 20, 200, 100, 'scaled Width/Height in a 400 px viewport')

   viewport.width = 200
   viewport.height = 200
   assertBoundary(path, 10, 20, 100, 50, 'scaled Width/Height after resizing the viewport')
end

@Test function PathWidthHeightReadback()
   scene, viewport, path = newTargetPath()
   path.sequence = 'M 10 20 L 40 20 L 40 70 L 10 70 Z'

   assertNear(path.width, 30, 'undefined Width reads the natural width without a draw')
   assertNear(path.height, 50, 'undefined Height reads the natural height without a draw')

   path.width = 80
   assertNear(path.width, 80, 'fixed Width reads back the stored value')

   path.width = '25%'
   assertNear(path.width, 0.25, 'scaled Width reads back as a scaled value')

   path.width = 0/0
   assertNear(path.width, 30, 'clearing Width restores the natural width')
   assertBoundary(path, 10, 20, 30, 50, 'cleared Width')

   path.sequence = 'M 0 0 L 5 0 L 5 5 Z'
   assertNear(path.width, 5, 'natural width follows a replaced sequence')
end

@Test function PathDegenerateAxis()
   scene, viewport, path = newTargetPath()
   path.sequence = 'M 0 0 V 100'
   path.width = 50
   path.height = 40

   local err, bx, by, bw, bh = path.mtGetBoundary(VBF_NO_TRANSFORM)
   assert(err is ERR_Okay, f'GetBoundary failed with {mSys.GetErrorMsg(err)}')
   assert((bw is bw) and (bh is bh), 'A vertical line must not produce NaN bounds')
   assert(bw < 1.0e-6, f'A vertical line cannot be scaled horizontally, width is {bw}')
   assertNear(bh, 40, 'Height still applies to a vertical line')

   -- A zero-length segment with a round cap is nudged by 1.0e-10 so that it is stroked as a dot.

   scene, viewport, path = newTargetPath()
   path.lineCap = VLC_ROUND
   path.sequence = 'M 10 10 L 10 10'
   path.width = 50

   local err, bx, by, bw, bh = path.mtGetBoundary(VBF_NO_TRANSFORM)
   assert(err is ERR_Okay, f'GetBoundary failed with {mSys.GetErrorMsg(err)}')
   assert(bw < 1.0e-6, f'A round-cap dot must not be scaled, width is {bw}')
   assertNear(bx, 10, 'round-cap dot X')
end

@Test function PathWidthZero()
   scene, viewport, path = newTargetPath()
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.width = 0

   assertBoundary(path, 10, 20, 0, 30, 'zero Width collapses to a vertical line')
end

@Test function PathNegativeWidth()
   local SIZE <const> = 100

   -- The right angle of the triangle starts at the top-left and moves to the top-right when flipped.

   local scene:obj, viewport:obj, path:obj = newSizedPath(SIZE)
   path.sequence = 'M 0 0 L 40 0 L 0 40 Z'
   path.fill = 'rgb(255,255,255)'
   path.x = 80
   path.width = -40

   assertBoundary(path, 40, 0, 40, 40, 'negative Width spans from X + Width to X')
   assertNear(path.width, -40, 'negative Width reads back unchanged')

   local bitmap = drawScene(scene, SIZE)
   assert(pixelLevel(bitmap, 75, 30) > 200, 'Flipped triangle should cover the right side of its box')
   assert(pixelLevel(bitmap, 45, 30) < 50, 'Flipped triangle should leave the left side of its box empty')

   path.width = 40
   path.x = 40
   bitmap = drawScene(scene, SIZE)
   assert(pixelLevel(bitmap, 45, 30) > 200, 'Unflipped triangle should cover the left side of its box')
   assert(pixelLevel(bitmap, 75, 30) < 50, 'Unflipped triangle should leave the right side of its box empty')

   path.width = 40
   path.height = -40
   path.y = 80
   assertBoundary(path, 40, 40, 40, 40, 'negative Height spans from Y + Height to Y')
end

-- XOffset and YOffset follow the VectorRectangle conventions.  The test path is a 30x30 square at (10,20) in a
-- 200 px viewport.

@Test function PathOffsetAnchorsFarEdge()
   local scene:obj, viewport:obj, path:obj = newSizedPath(200)
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.xOffset = 20
   path.yOffset = 10

   assertBoundary(path, 150, 160, 30, 30, 'XOffset/YOffset alone keep the natural size')
   assertNear(path.x, 150, 'X reads the resolved left edge')
   assertNear(path.y, 160, 'Y reads the resolved top edge')
   assertNear(path.width, 30, 'Width reads the natural width')
   assertNear(path.xOffset, 20, 'XOffset reads back the stored value')
   assertNear(path.yOffset, 10, 'YOffset reads back the stored value')
   assertCommand(path, 0, PE_Move, 10, 20, 'move command unchanged by offsets')

   path.xOffset = 0/0
   path.yOffset = 0/0
   assertBoundary(path, 10, 20, 30, 30, 'clearing the offsets restores the natural placement')
end

@Test function PathOffsetWithSize()
   local scene:obj, viewport:obj, path:obj = newSizedPath(200)
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.width = 60
   path.height = 40
   path.xOffset = 20
   path.yOffset = 10

   assertBoundary(path, 120, 150, 60, 40, 'Width/Height with offsets anchor the sized path')
end

@Test function PathOffsetWithFlippedSize()
   local scene:obj, viewport:obj, path:obj = newSizedPath(200)
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.{ width=-60, height=-40, xOffset=20, yOffset=10 }
   assertBoundary(path, 120, 150, 60, 40, 'Offsets anchor the geometric far edge of a flipped path')

   path.{ x=180, y=190, xOffset=0/0, yOffset=0/0 }
   assertNear(path.xOffset, 20, 'Derived XOffset is measured to the geometric right edge')
   assertNear(path.yOffset, 10, 'Derived YOffset is measured to the geometric bottom edge')
end

@Test function PathOffsetStretchesFromXY()
   local scene:obj, viewport:obj, path:obj = newSizedPath(200)
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.x = 10
   path.xOffset = 40
   path.y = 20
   path.yOffset = 30

   assertBoundary(path, 10, 20, 150, 150, 'X/Y with offsets stretch the path')
   assertNear(path.width, 150, 'Width reads the stretched width')
   assertNear(path.height, 150, 'Height reads the stretched height')

   path.width = 50
   assertBoundary(path, 10, nil, 50, nil, 'XOffset is ignored when X and Width are defined')
end

@Test function PathOffsetScaled()
   local scene:obj, viewport:obj, path:obj = newSizedPath(200)
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.xOffset = '10%'

   assertBoundary(path, 150, nil, 30, nil, 'scaled XOffset in a 200 px viewport')
   assertNear(path.xOffset, 0.1, 'scaled XOffset reads back as a scaled value')

   viewport.width = 400
   assertBoundary(path, 330, nil, 30, nil, 'scaled XOffset after resizing the viewport')
end

@Test function PathOffsetDerivedReadback()
   local scene:obj, viewport:obj, path:obj = newSizedPath(200)
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   assertNear(path.xOffset, 160, 'undefined XOffset reads the natural right-side gap')
   assertNear(path.yOffset, 150, 'undefined YOffset reads the natural bottom gap')

   path.x = 100
   path.width = 60
   assertNear(path.xOffset, 40, 'undefined XOffset follows X and Width')
end

@Test function PathOffsetMove()
   local scene:obj, viewport:obj, path:obj = newSizedPath(200)
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.xOffset = 20
   check path.acMove(-10, 5, 0)

   assertBoundary(path, 140, 25, 30, 30, 'Move shifts an offset-anchored path without resizing it')
   assertNear(path.xOffset, 30, 'Move adjusts XOffset')

   path.x = 10
   path.xOffset = 40
   check path.acMove(5, 0, 0)
   assertBoundary(path, 15, nil, 150, nil, 'Move keeps the width of a stretched path')
end

@Test function PathScaledOffsetMoveAfterViewportResize()
   local scene:obj, viewport:obj, path:obj = newSizedPath(200)
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.{ xOffset='10%', yOffset='20%' }
   assertBoundary(path, 150, 130, 30, 30, 'Initial scaled offsets')

   viewport.{ width=400, height=300 }
   check path.acMove(5, 10, 0)
   assertBoundary(path, 335, 220, 30, 30, 'Move resolves scaled offsets against the resized viewport')
end

@Test function PathWidthCurveFit()
   scene, viewport, path = newTargetPath()
   path.sequence = 'M 0 0 C 0 -100 100 -100 100 0'
   path.height = 100
   path.y = 0

   local err, bx, by, bw, bh = path.mtGetBoundary(VBF_NO_TRANSFORM)
   assert(err is ERR_Okay, f'GetBoundary failed with {mSys.GetErrorMsg(err)}')
   assert(math.abs(bh - 100) < 0.1, f'Curve should fit Height within 0.1, got {bh}')
   assert(math.abs(by) < 0.1, f'Curve should be placed at Y within 0.1, got {by}')

   -- Tracing the scaled path must stay inside the fitted box.

   local min_y, max_y = 1000, -1000
   function trace(Vector, Index, Command, X, Y)
      if Y < min_y then min_y = Y end
      if Y > max_y then max_y = Y end
      return ERR_Okay
   end
   check path.mtTrace(trace, 1.0, false)
   assert(min_y > -0.5 and max_y < 100.5, f'Traced curve should stay within the fitted box, got {min_y} to {max_y}')
   assert(max_y - min_y > 99, f'Traced curve should span the fitted height, got {max_y - min_y}')
end

@Test function PathEnlargedCurvesFit()
   local scene:obj, viewport:obj, path:obj = newSizedPath(400)

   for _, size in ipairs({0.01, 0.1, 1, 10, 100}) do
      for _, kind in ipairs({'cubic', 'quadratic'}) do
         if kind is 'cubic' then
            path.sequence = f'M 0 0 C 0 {-size} {size} {-size} {size} 0'
         else
            path.sequence = f'M 0 0 Q {size/2} {-size} {size} 0'
         end
         path.width = 100
         path.height = 100
         path.x = 20
         path.y = 30
         assertBoundary(path, 20, 30, 100, 100, f'{kind} fit from size {size}')

         local min_x, min_y, max_x, max_y = math.huge, math.huge, -math.huge, -math.huge
         function trace(Vector, Index, Command, X, Y)
            min_x = math.min(min_x, X)
            min_y = math.min(min_y, Y)
            max_x = math.max(max_x, X)
            max_y = math.max(max_y, Y)
            return ERR_Okay
         end
         check path.mtTrace(trace, 10, false)
         assert(math.abs(min_x - 20) < 0.1 and math.abs(max_x - 120) < 0.1,
            f'{kind} size {size}: traced X bounds {min_x}..{max_x} should fit 20..120')
         assert(math.abs(min_y - 30) < 0.1 and math.abs(max_y - 130) < 0.1,
            f'{kind} size {size}: traced Y bounds {min_y}..{max_y} should fit 30..130')
      end
   end
end

@Test function PathCurveNaturalExtrema()
   local scene:obj, viewport:obj, path:obj = newTargetPath()
   path.sequence = 'M 0 0 C 0 1 1 -1 1 0'
   local extent = math.sqrt(3) / 6
   assertNear(path.width, 1, 'cubic natural width')
   assertNear(path.height, 2 * extent, 'cubic height includes both interior extrema')
   assertBoundary(path, 0, -extent, 1, 2 * extent, 'cubic natural bounds')

   path.sequence = 'M 0 0 Q 0.5 -1 1 0'
   assertNear(path.height, 0.5, 'quadratic natural height')
   assertBoundary(path, 0, -0.5, 1, 0.5, 'quadratic natural bounds')
end

@Test function PathWidthKeepsStroke()
   local SIZE <const> = 100

   -- A 4 px stroke on the left edge at X=10 covers 8 to 12, whether or not the path is scaled.

   local scene:obj, viewport:obj, path:obj = newSizedPath(SIZE)
   path.sequence = 'M 10 10 L 30 10 L 30 30 L 10 30 Z'
   path.stroke = 'rgb(255,255,255)'
   path.strokeWidth = 4
   path.width = 80
   path.height = 80

   assertBoundary(path, 10, 10, 80, 80, 'stroked path geometry')

   local bitmap = drawScene(scene, SIZE)
   assert(pixelLevel(bitmap, 9, 50) > 200, 'Stroke should cover the inside of its 4 px width')
   assert(pixelLevel(bitmap, 11, 50) > 200, 'Stroke should cover the inside of its 4 px width')
   assert(pixelLevel(bitmap, 6, 50) < 50, 'Stroke should not extend outside its 4 px width')
   assert(pixelLevel(bitmap, 14, 50) < 50, 'Stroke should not be scaled with the path')
   assert(pixelLevel(bitmap, 50, 50) < 50, 'An unfilled path should leave its interior empty')
end

@Test function PathResize()
   scene, viewport, path = newTargetPath()
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.width = '50%'

   check path.acResize(60, 90, 0)

   assertBoundary(path, 10, 20, 60, 90, 'Resize sets fixed dimensions')
   assertNear(path.width, 60, 'Resize replaces a scaled Width with a fixed value')
   assertNear(path.height, 90, 'Resize sets Height')
   assertCommand(path, 0, PE_Move, 10, 20, 'Resize leaves the path commands unchanged')
end

@Test function PathMoveWithWidth()
   scene, viewport, path = newTargetPath()
   path.sequence = 'M 10 20 L 40 20 L 40 50 L 10 50 Z'
   path.width = 60
   path.height = 90

   check path.acMove(5, 7, 0)

   assertBoundary(path, 15, 27, 60, 90, 'Move shifts the sized path without changing its size')
end

@Test function GeneratedCurvesApplyAndTrace()
   err, source = mVec.GeneratePath('M 0 0 C 10 0 20 20 30 30 Q 40 40 50 50')
   check err

   scene, viewport, path = newTargetPath()
   check mVec.ApplyPath(source, path)

   assert(path.totalCommands is 3, f'Curve path should apply as three commands, got {path.totalCommands}')

   local command:struct<PathCommand>
   err, command = path.mtGetCommand(1)
   assert(err is ERR_Okay, f'curve command: GetCommand failed with {mSys.GetErrorMsg(err)}')
   assert(command.type is PE_Curve, 'Cubic curve should remain editable as a cubic command')

   err, command = path.mtGetCommand(2)
   assert(err is ERR_Okay, f'quadratic command: GetCommand failed with {mSys.GetErrorMsg(err)}')
   assert(command.type is PE_QuadCurve, 'Quadratic curve should remain editable as a quadratic command')

   traced = 0
   function trace(Vector, Index, Command, X, Y)
      traced++
      return ERR_Okay
   end

   err = path.mtTrace(trace, 1.0, false)
   assert(err is ERR_Okay, f'Applied curve path should trace successfully, got {mSys.GetErrorMsg(err)}')
   assert(traced > 0, 'Applied curve path should produce traced coordinates')
end

@Test function ViewportTraceAppliesTransformsOnce()
   local scene = obj.new('VectorScene', { pageWidth=400, pageHeight=400 })
   local root = scene.new('VectorViewport', { x=0, y=0, width=400, height=400 })
   local host = root.new('VectorViewport', { x=10, y=20, width=100, height=50 })
   local _, matrix = check host.mtNewMatrix()
   check mVec.ParseTransform(matrix, 'scale(2) rotate(90)')
   local view = host.new('VectorViewport', { x=5, y=6, width=30, height=40 })

   local xs, ys
   function trace(Vector, Index, Command, X, Y)
      xs.push(X)
      ys.push(Y)
      return ERR_Okay
   end

   xs, ys = array<double>, array<double>
   check view.mtTrace(trace, 1.0, false)
   assert(#xs >= 4, f'Untransformed viewport trace should produce four corners, got {#xs}')
   assertNear(xs[0], 5, 'untransformed top-left X')
   assertNear(ys[0], 6, 'untransformed top-left Y')
   assertNear(xs[2], 35, 'untransformed bottom-right X')
   assertNear(ys[2], 46, 'untransformed bottom-right Y')

   -- In scene coordinates (5,6) maps to (10 - 2*6, 20 + 2*5), and the width extends along +Y.

   xs, ys = array<double>, array<double>
   check view.mtTrace(trace, 1.0, true)
   assert(#xs >= 4, f'Transformed viewport trace should produce four corners, got {#xs}')
   assertNear(xs[0], -2, 'transformed top-left X')
   assertNear(ys[0], 30, 'transformed top-left Y')
   assertNear(xs[1], -2, 'transformed top-right X')
   assertNear(ys[1], 90, 'transformed top-right Y')
   assertNear(xs[3], -82, 'transformed bottom-left X')
   assertNear(ys[3], 30, 'transformed bottom-left Y')
end

@Test function GeneratedSmoothQuadraticApplies()
   err, source = mVec.GeneratePath('M 0 0 Q 10 0 20 20 T 30 20')
   check err

   scene, viewport, path = newTargetPath()
   check mVec.ApplyPath(source, path)

   assert(path.totalCommands is 3, f'Smooth quadratic path should apply as three commands, got {path.totalCommands}')
   assertCurveCommand(path, 1, PE_QuadCurve, 20, 20, 10, 0, 0, 0, 'initial quadratic curve')
   assertCurveCommand(path, 2, PE_QuadCurve, 30, 20, 30, 40, 0, 0, 'smooth quadratic curve')
end

@Test function GeneratedSmoothCubicApplies()
   err, source = mVec.GeneratePath('M 0 0 C 10 0 20 10 30 20 S 50 40 60 20')
   check err

   scene, viewport, path = newTargetPath()
   check mVec.ApplyPath(source, path)

   assert(path.totalCommands is 3, f'Smooth cubic path should apply as three commands, got {path.totalCommands}')
   assertCurveCommand(path, 1, PE_Curve, 30, 20, 10, 0, 20, 10, 'initial cubic curve')
   assertCurveCommand(path, 2, PE_Curve, 60, 20, 40, 30, 50, 40, 'smooth cubic curve')
end

@Test function SmoothQuadraticFunctionApplies()
   err, source = mVec.GeneratePath(nil)
   check err

   mVec.MoveTo(source, 0, 0)
   mVec.Curve3(source, 10, 0, 20, 20)
   mVec.Smooth3(source, 30, 20)

   scene, viewport, path = newTargetPath()
   check mVec.ApplyPath(source, path)

   assert(path.totalCommands is 3, f'Smooth3 path should apply as three commands, got {path.totalCommands}')
   assertCurveCommand(path, 2, PE_QuadCurve, 30, 20, 30, 40, 0, 0, 'Smooth3 curve')
end

@Test function SmoothCubicFunctionApplies()
   err, source = mVec.GeneratePath(nil)
   check err

   mVec.MoveTo(source, 0, 0)
   mVec.Curve4(source, 10, 0, 20, 10, 30, 20)
   mVec.Smooth4(source, 50, 40, 60, 20)

   scene, viewport, path = newTargetPath()
   check mVec.ApplyPath(source, path)

   assert(path.totalCommands is 3, f'Smooth4 path should apply as three commands, got {path.totalCommands}')
   assertCurveCommand(path, 2, PE_Curve, 60, 20, 40, 30, 50, 40, 'Smooth4 curve')
end

@Test function EmptyGeneratedPathClearsExistingCommands()
   err, source = mVec.GeneratePath(nil)
   check err

   scene, viewport, path = newTargetPath()
   path.sequence = 'M 0 0 L 1 1'
   assert(path.totalCommands is 2, 'Precondition failed: path sequence should create two commands')

   check mVec.ApplyPath(source, path)

   assert(path.totalCommands is 0, f'Empty generated path should clear existing commands, got {path.totalCommands}')
end

@Test function NullArgumentsAreRejected()
   scene, viewport, path = newTargetPath()
   err = mVec.ApplyPath(nil, path)
   assert(err is ERR_NullArgs, f'Null path should return NullArgs, got {mSys.GetErrorMsg(err)}')

   err, source = mVec.GenerateRectangle(0, 0, 1, 1)
   check err

   err = mVec.ApplyPath(source, nil)
   assert(err is ERR_NullArgs, f'Null VectorPath should return NullArgs, got {mSys.GetErrorMsg(err)}')
end

@Test function NonVectorPathTargetIsRejected()
   err, source = mVec.GenerateRectangle(0, 0, 1, 1)
   check err

   scene = obj.new('VectorScene')
   viewport = scene.new('VectorViewport')
   rectangle = viewport.new('VectorRectangle', { width=10, height=10 })

   err = mVec.ApplyPath(source, rectangle)
   assert(err != ERR_Okay, 'Non-VectorPath target should return failure')
end
