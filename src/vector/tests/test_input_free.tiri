-- Verifies that VectorScene input processing remains intact when vectors that are referenced by the scene's input
-- state are freed between draws.  Pointer input is injected through the SystemPointer as dcDeviceInput records.

   include 'display', 'vector'

-- Write the little-endian IEEE-754 encoding of a non-negative double into Buffer at Offset.

function putDouble(Buffer:array<byte>!, Offset:num!, Value:num!)
   if Value is 0 then return end
   local mantissa, exponent = math.frexp(Value)
   local fraction = ((mantissa * 2) - 1) * 1048576 -- The top 20 bits of the mantissa occupy the high word
   local high = ((exponent + 1022) * 1048576) + math.floor(fraction)
   local low = (fraction - math.floor(fraction)) * 4294967296
   for i in {0 to 4} do
      Buffer[Offset + i] = math.floor(low / (256 ** i)) % 256
      Buffer[Offset + 4 + i] = math.floor(high / (256 ** i)) % 256
   end
end

-- Feed one dcDeviceInput record: { double Values[2]; int64 Timestamp; OBJECTID DeviceID; JTYPE Flags; JET Type }.

function feed(Type:num!, Value0:num!, Value1:num!)
   local input = array<byte, 40>
   putDouble(input, 0, Value0)
   putDouble(input, 8, Value1)
   input[32] = Type
   check obj.find('SystemPointer').acDataFeed(nil, DATA_DEVICE_INPUT, input)
   processing.sleep(0)
end

-- Create a drawn scene with a buffered root viewport that counts movement events and a child viewport at
-- (10, 10, 20, 20).  A group separates the child from the viewport so cache cleanup has to follow ParentView rather
-- than the direct parent chain.  Input boundaries are recorded when the scene is drawn, so the child's input
-- subscription is made by Subscribe beforehand.

function newScene(Subscribe:func!):<obj, obj, obj, table>
   local surface = obj.new('Surface', { width=100, height=100 })
   local scene = surface.new('VectorScene', { surface=surface })
   local root = scene.new('VectorViewport', { x=0, y=0, width=100, height=100, buffered=true })
   root.new('VectorRectangle', { x=0, y=0, width=100, height=100, fill='#808080' })
   local group = root.new('VectorGroup')
   local child = group.new('VectorViewport', { x=10, y=10, width=20, height=20 })
   child.new('VectorRectangle', { x=0, y=0, width=20, height=20, fill='#ff0000' })

   local counts = { root=0 }
   root.mtSubscribeInput(JTYPE_MOVEMENT, function(Vector, Msg) counts.root++ end)
   Subscribe(child)

   surface.acShow()
   surface.acDraw()
   processing.sleep(0)
   return surface, root, child, counts
end

-- A vector that is freed while it holds the button lock must not leave the lock in place, otherwise the scene stops
-- delivering pointer input to every other vector.

@Test function FreeButtonLockHolder()
   local pressed = false
   local surface <close>, root, child, counts = newScene(function(Child)
      Child.mtSubscribeInput(JTYPE_BUTTON, function(Vector, Msg)
         if (Msg.type is JET_LMB) and (Msg.value > 0) then pressed = true end
      end)
   end)

   feed(JET_ABS_XY, 20, 20)
   feed(JET_LMB, 1, 0)
   assert(pressed, 'The child did not receive the button press')
   child.free()
   feed(JET_LMB, 0, 0)

   local before = counts.root
   feed(JET_ABS_XY, 60, 60)
   feed(JET_ABS_XY, 70, 70)
   assert(counts.root - before is 2, f'The root received {counts.root - before} of 2 movement events after the ' ..
      'button lock holder was freed')
end

-- Freeing the vector under the pointer without redrawing must pass subsequent movement to the vector beneath it.

@Test function FreeActiveVectorBeforeRedraw()
   local child_moves = 0
   local surface <close>, root, child, counts = newScene(function(Child)
      Child.mtSubscribeInput(JTYPE_MOVEMENT, function(Vector, Msg) child_moves++ end)
   end)

   feed(JET_ABS_XY, 20, 20)
   assert(child_moves is 1, 'The child did not receive the initial movement event')
   child.free()
   surface.acDraw() -- A clean buffered viewport replays its cached input boundaries.

   local before = counts.root
   feed(JET_ABS_XY, 22, 22)
   feed(JET_ABS_XY, 24, 24)
   assert(counts.root - before is 2, f'The root received {counts.root - before} of 2 movement events over the ' ..
      'area of the freed child')
end

-- A callback that subscribes more callbacks to its own vector reallocates the subscription list mid-dispatch.  The
-- remaining subscriptions must each receive the event once, and the new ones must remain subscribed.

@Test function SubscribeDuringDispatch()
   local calls = { first=0, second=0, added=0 }
   local subscribed = false
   local surface <close>, root, child, counts = newScene(function(Child)
      Child.mtSubscribeInput(JTYPE_BUTTON, function(Vector, Msg)
         if (Msg.type != JET_LMB) or (Msg.value is 0) then return end
         calls.first++
         if subscribed then return end
         subscribed = true
         for i in {0 to 16} do
            Vector.mtSubscribeInput(JTYPE_BUTTON, function(Vector, Msg)
               if (Msg.type is JET_LMB) and (Msg.value > 0) then calls.added++ end
            end)
         end
      end)
      Child.mtSubscribeInput(JTYPE_BUTTON, function(Vector, Msg)
         if (Msg.type is JET_LMB) and (Msg.value > 0) then calls.second++ end
      end)
   end)

   feed(JET_ABS_XY, 20, 20)
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(calls.first is 1, f'The first callback was called {calls.first} times for one press')
   assert(calls.second is 1, f'The second callback was called {calls.second} times for one press')

   local added = calls.added
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(calls.second is 2, f'The second callback was called {calls.second} times for two presses')
   assert(calls.added - added is 16, f'{calls.added - added} of 16 added callbacks received the second press')
end

-- A callback that unsubscribes a later callback mid-dispatch must stop it from receiving the event, and the
-- subscription that follows it must still be called.

@Test function UnsubscribeDuringDispatch()
   local calls = { first=0, second=0, third=0 }
   local second = function(Vector, Msg)
      if (Msg.type is JET_LMB) and (Msg.value > 0) then calls.second++ end
   end
   local surface <close>, root, child, counts = newScene(function(Child)
      Child.mtSubscribeInput(JTYPE_BUTTON, function(Vector, Msg)
         if (Msg.type is JET_LMB) and (Msg.value > 0) then
            calls.first++
            Vector.mtSubscribeInput(0, second)
         end
      end)
      Child.mtSubscribeInput(JTYPE_BUTTON, second)
      Child.mtSubscribeInput(JTYPE_BUTTON, function(Vector, Msg)
         if (Msg.type is JET_LMB) and (Msg.value > 0) then calls.third++ end
      end)
   end)

   feed(JET_ABS_XY, 20, 20)
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(calls.first is 1, f'The first callback was called {calls.first} times for one press')
   assert(calls.second is 0, f'The unsubscribed callback was called {calls.second} times')
   assert(calls.third is 1, f'The third callback was called {calls.third} times for one press')
end

-- Removing both the current callback and an earlier one must not skip the remaining subscription.

@Test function RemoveEarlierAndSelfDuringDispatch()
   local calls = { first=0, second=0, third=0 }
   local first = function(Vector, Msg)
      if (Msg.type is JET_LMB) and (Msg.value > 0) then calls.first++ end
   end
   local second:func
   second = function(Vector, Msg)
      if (Msg.type is JET_LMB) and (Msg.value > 0) then
         calls.second++
         Vector.mtSubscribeInput(0, first)
         Vector.mtSubscribeInput(0, second)
      end
   end
   local surface <close>, root, child, counts = newScene(function(Child)
      Child.mtSubscribeInput(JTYPE_BUTTON, first)
      Child.mtSubscribeInput(JTYPE_BUTTON, second)
      Child.mtSubscribeInput(JTYPE_BUTTON, function(Vector, Msg)
         if (Msg.type is JET_LMB) and (Msg.value > 0) then calls.third++ end
      end)
   end)
   feed(JET_ABS_XY, 20, 20)
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(calls.first is 1, 'The first callback did not receive the press')
   assert(calls.second is 1, 'The second callback did not receive the press')
   assert(calls.third is 1, f'Remaining callback received {calls.third} presses instead of 1')
end

-- Callbacks removed mid-dispatch leave cleared entries that are compacted when the dispatch finishes.  The removed
-- callbacks must then be able to subscribe again, and each must receive the next event exactly once.

@Test function ResubscribeAfterDispatchRemoval()
   local calls = { a=0, b=0, c=0 }
   local a = function(Vector, Msg)
      if (Msg.type is JET_LMB) and (Msg.value > 0) then calls.a++ end
   end
   local b:func
   b = function(Vector, Msg)
      if (Msg.type is JET_LMB) and (Msg.value > 0) then
         calls.b++
         Vector.mtSubscribeInput(0, a)
         Vector.mtSubscribeInput(0, b)
      end
   end
   local c = function(Vector, Msg)
      if (Msg.type is JET_LMB) and (Msg.value > 0) then calls.c++ end
   end
   local surface <close>, root, child, counts = newScene(function(Child)
      Child.mtSubscribeInput(JTYPE_BUTTON, a)
      Child.mtSubscribeInput(JTYPE_BUTTON, b)
      Child.mtSubscribeInput(JTYPE_BUTTON, c)
   end)

   feed(JET_ABS_XY, 20, 20)
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)

   check child.mtSubscribeInput(JTYPE_BUTTON, a)
   check child.mtSubscribeInput(JTYPE_BUTTON, b)
   feed(JET_LMB, 1, 0)
   feed(JET_LMB, 0, 0)
   assert(calls.a is 2, f'A was called {calls.a - 1} times after subscribing again')
   assert(calls.b is 2, f'B was called {calls.b - 1} times after subscribing again')
   assert(calls.c is 2, f'C was called {calls.c} times for two presses')
end
