
  enums("VFA", { type="int", comment="Define the aspect ratio for VectorFilter unit scaling." },
     "MEET: Scale X/Y values independently and in relation to the width/height of the bounding box.",
     "NONE: Scale X/Y values on a `1:1` basis, in relation to the normalised diagonal of the bounding box.")

  enums("VSF", { type="int", start=0, comment="Filter source types." },
    "IGNORE|NONE: The filter does not require an input source.",
    "GRAPHIC: Represents the graphics elements that were the original input into the filter element.",
    "ALPHA: As for `GRAPHIC` except that only the alpha channel is used.",
    "BKGD: An image snapshot of the SVG document under the filter region at the time that the filter element was invoked.",
    "BKGD_ALPHA: As for `BKGD` but only the alpha channel is used.",
    "FILL: The value of the fill property on the target element for the filter effect.",
    "STROKE: The value of the stroke property on the target element for the filter effect.",
    "REFERENCE: This value is an assigned name for the filter primitive in the form of a custom-ident. If supplied, then graphics that result from processing this filter primitive can be referenced by an in attribute on a subsequent filter primitive within the same filter element. If no value is provided, the output will only be available for re-use as the implicit input into the next filter primitive if that filter primitive provides no value for its in attribute.",
    "PREVIOUS: Use the previous effect as input, or source graphic if no previous effect.")

  enums('MOP', { type='int', start=0, comment='MorphologyFX options.' },
    'ERODE: Erode (thin) the input source.',
    'DILATE: Dilate (fatten) the input source.')

  enums('MKS', { type='int', start=0, comment='MorphologyFX kernel shapes.' },
    'RECTANGLE: Use the entire rectangular neighbourhood.',
    'ELLIPSE: Use the samples within the ellipse defined by the two radii.',
    'CROSS: Use only the centre row and centre column.')

  enums('MCM', { type='int', start=0, comment='MorphologyFX channel modes for bitmap input.' },
    'COMPONENTS: Apply the operator to each component independently.',
    'ALPHA: Apply the operator to alpha and retain straight RGB from the centre sample.')

  enums('FEM', { type='int', start=0, comment='Filter input edge addressing modes.' },
    'TRANSPARENT: Sample transparent black outside the input.',
    'CLAMP: Extend the nearest edge sample.',
    'REPEAT: Wrap samples to the opposite edge.',
    'MIRROR: Reflect alternating copies of the input, repeating the edge sample at each join.')

   enums('OP', { type='int', start=0, comment='Operators for CompositionFX.' },
    "OVER: The Porter-Duff 'over' operator, this is the default operation for standard alpha blending.",
    "IN: The Porter-Duff 'in' operator; the input alpha channel has priority and the mix channel is secondary.",
    "OUT: The Porter-Duff 'out' operator; the mix alpha channel is inversed with the input channel.",
    "ATOP: The Porter-Duff 'atop' operator; the mix alpha channel has priority and the input channel does not occlude.",
    "XOR: The Porter-Duff 'xor' operator; blend as normal but occlusion occurs when input and mix alpha channels interact.",
    "ARITHMETIC: The SVG 'arithmetic' blending algorithm.",
    "SCREEN: Produces a result brighter than the input.",
    "MULTIPLY: Multiplies the input and mix colour components, producing a darker result unless one source is white.",
    "LIGHTEN: Use the lighter colour components of the mix and input values.",
    "DARKEN: Use the darker colour components of the mix and input values.",
    "INVERT_RGB: Invert the mix colour components using the input colour channels as the per-channel strength.",
    "INVERT: Invert the mix colour components using the input alpha channel as the strength.",
    "CONTRAST: Adjust the mix contrast using the input colour values as the contrast strength.",
    "DODGE: Gives a brighter result than `SCREEN` by decreasing the contrast between the input and mix colours.",
    "BURN: Gives a darker result than `MULTIPLY` by increasing the contrast between the input and mix colours.",
    "HARD_LIGHT: Apply `MULTIPLY` or `SCREEN` according to the input colour, producing a high-contrast result.",
    "SOFT_LIGHT: Apply a softer variant of `HARD_LIGHT`, subtly darkening or lightening the mix from the input colour.",
    "DIFFERENCE: Output the difference between the input and mix colours.",
    "EXCLUSION: Produce the difference between the mix and input values around a reference point of mid-grey.",
    "PLUS: Add the input and mix colour values together.",
    "MINUS|SUBTRACT: The input colour value is subtracted from the mix.",
    "OVERLAY: Combines the multiply and screen blend modes, with the mix determining tonal strength.")

  klass('FilterEffect', { src='filters/filter_effect.cpp', output='filters/filter_effect_def.c', references={ 'VSF', 'VCS' }, extended=true }, [[
    obj(FilterEffect) Next  # Next filter in the chain.
    obj(FilterEffect) Prev  # Previous filter in the chain.
    obj(Bitmap) Target      # Target bitmap for rendering the effect.
    obj(FilterEffect) Input # The effect uses another effect as an input.
    obj(FilterEffect) Mix   # Reference to an additional effect for mixing, e.g. compositing
    unit X                  # Primitive x coordinate.
    unit Y                  # Primitive y coordinate.
    unit Width              # Primitive width.
    unit Height             # Primitive height.
    int(VSF) SourceType     # Desired source input.
    int(VSF) MixType        # Optional input for mixing.
    ~int(VCS) ColourSpace
  ]])

  structdef('MergeSource', { comment='Input source declaration for MergeFX' }, [[
   int(VSF) SourceType        # The type of the required source.
   obj(FilterEffect) Effect   # Effect pointer if the `SourceType` is `REFERENCE`.
  ]],
  [[
  MergeSource(VSF pType, objFilterEffect *pEffect = nullptr) : SourceType(pType), Effect(pEffect) { };
  ]])

  structdef('MergeLayer', { comment='Weighted input source for MergeFX.' }, [[
    int(VSF) SourceType  # Input source type.
    int      EffectID    # Object ID of the producer for REFERENCE.
    double   Opacity     # Normalised layer opacity.
    int      Enabled     # Set to TRUE to render the layer.
  ]])

  enums('RFT', { type='int', start=0, comment='Remap transfer function.' },
    'IDENTITY', 'DISCRETE', 'LINEAR', 'GAMMA', 'TABLE', 'INVERT', 'MASK')

  structdef('RemapTransfer', { comment='Mathematical configuration of a RemapFX channel.' }, [[
    array(double,1024) Values # Samples for TABLE and DISCRETE.
    int      Count            # Number of active samples.
    int(RFT) Type             # Transfer function.
    double   Slope            # LINEAR coefficient.
    double   Intercept        # LINEAR offset.
    double   Amplitude        # GAMMA amplitude.
    double   Exponent         # GAMMA exponent.
    double   Offset           # GAMMA offset.
    int      Mask             # MASK bit mask in [0, 255].
  ]])

