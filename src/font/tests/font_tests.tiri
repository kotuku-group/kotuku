-- $TIRI
-- Flute tests for Font functionality

   import 'config'

   module font as mFont
   module vector as mVec

@Test function NumericTraitsAreMatchedWithoutRounding()
   local err, bold = check mFont.SelectFont('Courier Prime', 'Bold')
   local _, selected = check mFont.SelectFont('Courier Prime', 'weight=501')
   assert(selected is bold, 'A weight above 500 must prefer Bold over Regular')

   local _, expected = check mVec.GetFontHandle('Courier Prime', 'Bold', 0, 24)
   local _, described = check mVec.GetFontHandle('Courier Prime', 'weight=501', 0, 24)
   local _, weighted = check mVec.GetFontHandle('Courier Prime', 'Regular', 501, 24)
   assert(rawequal(described, expected), 'A numeric descriptor must select the Bold file without rounding')
   assert(rawequal(weighted, expected), 'The Weight argument must select the Bold file without rounding')
end

@Test function SelectFont()
   err, path, meta = mFont.SelectFont("Noto Sans", "Regular")
   assert(err is ERR_Okay, "SelectFont() returned error " .. mSys.GetErrorMsg(err))

   err, path, meta = mFont.SelectFont("Does Not Exist,*", "Regular")
   assert(err != ERR_Okay, "SelectFont() returned error " .. mSys.GetErrorMsg(err))

   err, path, meta = mFont.SelectFont("Does Not Exist", "Regular")
   assert(err != ERR_Okay, "SelectFont() returned error " .. mSys.GetErrorMsg(err))
end

@Test function RefreshFontsDescribesFamilies()
   path = 'temp:font_test_refresh.cfg'
   defer mSys.DeleteFile(path) end
   check mFont.RefreshFonts(path)
   db = config.decode(io.readAll(path))

   -- Classification from OS/2 data, from bitmap headers, and by measuring serifs where the font declares none.
   -- Micro gives only its I serifs, so it must not be classed as a serif face.

   expected = {
      ['Noto Sans'] = 'Sans', ['Noto Serif'] = 'Serif', ['Inconsolata'] = 'Mono', ['Courier Prime'] = 'Mono',
      ['Crimson Pro'] = 'Serif', ['Spectral'] = 'Serif', ['Micro'] = 'Sans', ['Speedy'] = 'Mono',
      ['Veranda'] = 'Sans', ['Noto Emoji'] = 'Symbol'
   }
   for family, cls in expected do
      assert(db[family], f'{family} is missing from the font database')
      assert(db[family].Class is cls, f'{family} should be classed {cls}, got {db[family].Class}')
   end

   sans = db['Noto Sans']
   assert(sans.Axes is 'wght,wdth', 'Axes must list the axis tags in font order')
   assert(sans.AxisRanges is 'wght:100:400:900,wdth:62.5:100:100', f'Unexpected axis ranges {sans.AxisRanges}')

   features = sans.Features.split(',')
   for tag in values(array<str> { 'kern', 'liga', 'smcp', 'tnum' }) do
      assert(tag in features, f'Noto Sans should list the {tag} feature')
   end

   coverage = { }
   for entry in values(sans.Coverage.split(',')) do
      parts = entry.split(':')
      coverage[parts[0]] = tonumber(parts[1])
   end
   for _, id in array<str> { 'basic-latin', 'latin-1', 'pasifika', 'vietnamese', 'cyrillic' } do
      assert(coverage[id] is 100, f'Noto Sans should fully cover {id}, got {coverage[id]}')
   end
   assert(not ('cjk' in coverage), 'Sets without coverage must be omitted')
   assert(tonumber(sans.Characters) > 1000, 'Characters must count the mapped characters')

   assert(db['Speedy'].Coverage is 'basic-latin:100,latin-1:100', 'Bitmap coverage must follow the Latin-1 range')
   assert(not db['Speedy'].Features, 'Bitmap fonts have no layout features')
end

@Test function ResolveFamily()
   err, name = mFont.ResolveFamilyName("Does Not Exist,*")
   assert(err is ERR_Okay, "ResolveFamilyName() returned error " .. mSys.GetErrorMsg(err))
   assert(name is "Noto Sans", "Expected ResolveFamilyName() to return 'Noto Sans' as the default font")
end

@Test function FontFieldSetters()
   font <close> = obj.new('font')

   font.face = 'Noto Sans'
   assert(font.face is 'Noto Sans', 'Face parsing did not isolate the family name')

   font.italic = true
   font.bold = false
   assert(font.style is 'Italic', 'Clearing Bold should preserve Italic')

   font.italic = false
   assert(font.style is 'Regular', 'Clearing Italic should restore Regular')

   font.string = 'abc'
   assert(font.string is 'abc', 'String field did not store the assigned value')

   font.string = nil
   assert(font.string is nil, 'Clearing String should remove the previous value')
end

@Test(hotpath=true) function StructFieldLiveView()
   font <close> = obj.new('font')

   colour = font.colour
   assert(type(colour) is 'struct', 'Font.colour should be exposed as a native struct')

   colour.red = 17
   colour.green = 29
   assert(font.colour.red is 17, 'Writing through the struct view should update the object field')
   assert(font.colour.green is 29, 'Repeated object field reads should observe live struct changes')

   replacement = struct.new('RGB8', { red=41, green=53, blue=67, alpha=79 })
   font.colour = replacement
   assert(colour.red is 41, 'Whole-struct assignment should update an existing live view')
   assert(font.colour.alpha is 79, 'Whole-struct assignment should copy every field')
end

@Test function StructFieldStaleView()
   font = obj.new('font')

   colour = font.colour
   assert(type(colour) is 'struct', 'Font.colour should be exposed as a native struct')

   font.free()

   read_caught = false
   try
      -- NB: '_ = colour.red' would elide the read entirely; a real local is required to trigger the access.
      local red = colour.red
      read_caught = red < 0 -- Unreachable; keeps the read live
   except e
      read_caught = true
   end
   assert(read_caught, 'Reading a struct view after object destruction should raise an exception')

   write_caught = false
   try
      colour.green = 1
   except e
      write_caught = true
   end
   assert(write_caught, 'Writing a struct view after object destruction should raise an exception')
end
