--[[
A simple test program for confirming that our fonts and reported metrics values are in-line with what we would expect.
--]]

   import 'gui/window'
   import 'gui/combobox'
   import 'gui/listview'
   import 'gui/toggle'

   module font as mFont
   module vector as mVec

glFontSize = 30
local glViewport, glWindow, glTextY
local glFace, glStyle
local glFontList:table

-- Returns the style to use for Face.  'Regular' is preferred, and is always used for aliases so that the alias's own
-- Style is applied.  Families without a Regular style use the first style in their list.

local function faceStyle(Face:str):str
   local rec = glFontList[Face]
   if (not rec) or rec.alias or ('Regular' in rec.styles) then return 'Regular' end
   return rec.styles[0] ?? 'Regular'
end

-- Hinting overrides applied through SetFontHinting().  The override persists for the process, so the chosen mode is
-- remembered per family and reselected in the list when the family is chosen again.

local HINT_MODES = { Default=0, Normal=HINT_NORMAL, Light=HINT_LIGHT, Internal=HINT_INTERNAL }
local glHints = { }

local glKerning = true -- Cleared by the kerning toggle, which sets VTXF_NO_KERNING on the sample text

function setFont(Face, Size)
   if glText then glText.free() end
   if glSmallText then glSmallText.free() end
   if glKernText then glKernText.free() end

   glFace  = Face
   glStyle = faceStyle(Face)
   local _, fh = mVec.GetFontHandle(Face, glStyle, 0, Size)
   metrics = struct.new('FontMetrics')
   check mVec.GetFontMetrics(fh, metrics)

   print(f'Font: {Face}; Style: {glStyle}; Size: {Size}/{(Size * 72/96)}; Height: {metrics.height}; Ascent: {metrics.ascent}; Descent: {metrics.descent}; LineSpacing: {metrics.lineSpacing}')

   if not glInitialised then
      -- CAP-HEIGHT: YELLOW
      -- The fontSize * 0.75 should meet the cap height (A-Z).  This works for maybe 2/3rds of
      -- our fonts.  Non-conforming fonts are notable for including the accents.
      -- For the most part this proves that fontSize should not be used in metrics calculations.
      global glSize = glViewport.new('vectorrectangle', { x = 0, width='50%', y=0, height=1, fill='rgb(255,255,0,128)' })

      -- METRICS LINE SPACING: BLUE
      global glNextLine = glViewport.new('vectorrectangle', { x = 0, width='100%', y=0, height=1, fill='rgb(0,0,255,128)' })
      global glNextHeight = glViewport.new('vectorrectangle', { x = 0, width='100%', y=0, height=1, fill='rgb(0,0,255,128)' })

      -- METRICS DESCENT: GREEN
      global glDescent = glViewport.new('vectorrectangle', { x = 0, width='100%', y=0, height=1, fill='rgb(0,255,0,64)' })

      -- METRICS HEIGHT: RED
      -- The metrics height is equivalent to Ascent + Descent.  Accents are ignored.  Generally very reliable, only
      -- a few fonts show a slight margin of error - Courier Prime probably being the worst because its descent is off.
      -- It's vital to remember that the height is taken from the bottom of the gutter, not the basline.
      global glHeight = glViewport.new('vectorrectangle', { x = '50%', width='100%', y=0, height=1, fill='rgb(255,0,0,64)' })

      -- METRICS ASCENT: BLUE DOTTED
      -- The ascent is the distance from the baseline to the top of the font, NOT including accents.  Generally very
      -- reliable, the margin of error is reasonably tight for our fonts.
      global glAscent = glViewport.new('vectorpolygon', { x1 = 0, y1 = 0, x2 = '100%', y2 = 0, stroke='rgb(0,0,255,128)', dashArray=array<double> { 4,4 } })
   end

   baseline = glTextY + Size

   global glText = glViewport.new('vectortext', {
      x         = glWindow.margins.left,
      y         = baseline,
      face      = Face,
      fontStyle = glStyle,
      fontSize  = Size,
      fill      = 'rgb(0,0,0)',
      string    = f'{Face}; ÄĆÃÊgy; Size: {Size}/{(Size * 72/96)}; Height: {metrics.height}; ' ..
         f'Ascent: {metrics.ascent}; Descent: {metrics.descent}; LineSpacing: {metrics.lineSpacing};\n' ..
         'ÄĆÃÊ The quick brown Fox jumped Over the lazy Dog'
   })

   glHeight.y = baseline + metrics.descent - metrics.height
   glHeight.height = metrics.height

   -- FONTSIZE MATCHES THE CAP HEIGHT WHEN * 0.75
   glSize.y = glText.y
   glSize.height = -tonumber(glText.fontSize) * 0.75

   glNextLine.y = glText.y + metrics.lineSpacing
   glNextHeight.y = glText.y + metrics.lineSpacing - metrics.ascent

   glDescent.y = glText.y
   glDescent.height = metrics.descent

   glAscent.y1 = glText.y - metrics.ascent
   glAscent.y2 = glText.y - metrics.ascent

   global glSmallText = glViewport.new('vectortext', {
      x         = glWindow.margins.left,
      y         = glText.y + metrics.lineSpacing * 2,
      face      = Face,
      fontStyle = glStyle,
      fontSize  = '8pt',
      fill      = 'rgb(0,0,0)',
      string    = 'ÄĆÃÊ The quick brown Fox jumped Over the lazy Dog'
   })

   -- Pairs that are kerned by most fonts.  Compare against the toggle to see the effect of the font's kerning.

   global glKernText = glViewport.new('vectortext', {
      x         = glWindow.margins.left,
      y         = glText.y + metrics.lineSpacing * 3,
      face      = Face,
      fontStyle = glStyle,
      fontSize  = Size,
      fill      = 'rgb(0,0,0)',
      textFlags = glKerning ? 0 : VTXF_NO_KERNING,
      string    = 'AV To Ty WA LT Yo P. F, "A" 11'
   })

   global glInitialised = true
   processing.collect()
end

   mFont.RefreshFonts()

   glWindow = gui.window({ title='Widget Examples', insideWidth=600, insideHeight=400 })
   glViewport = glWindow.clientViewport({ aspectRatio = ARF_MEET })

   y = 6
   items = array<table> { }
   glFontList = resolve(gui.fontList)

   for _, rec in glFontList.sortByKeys() do
      if not rec.hidden then
         items.push({ label=rec.name })
      end
   end

   local hintList:table -- Declared ahead of the font combobox, which updates it

   -- Reselects the hinting mode recorded for Face.  The 'manual' selection reason is ignored by itemSelected.

   function showHinting(Face:str)
      mode = glHints[Face] ?? 'Default'
      hintList.selectItems(Item => Item.name is mode)
   end

   combobox = gui.combobox({
      target = glViewport,
      label  = 'Font:',
      x      = glWindow.margins.left, y = y,
      items  = items,
      events = {
         activate = function(Item:table!)
            showHinting(Item.label)
            setFont(Item.label, glFontSize)
         end
      }
   })

   hintList = gui.listView({
      target    = glViewport,
      x         = combobox.viewport.x + combobox.viewport.width + 16, y = y,
      width     = 120,
      height    = 96,
      showIcons = false,
      scrollDirection = 'vertical',
      items     = array<table> { { name='Default' }, { name='Normal' }, { name='Light' }, { name='Internal' } },
      events    = {
         itemSelected = function(View:table, Reason:str, Item:table)
            if Reason != 'user' then return end
            check mVec.SetFontHinting(glFace, HINT_MODES[Item.name])
            glHints[glFace] = (Item.name != 'Default') ? Item.name : nil
            setFont(glFace, glFontSize)
         end
      }
   })
   local kernToggle:table -- Declared before its initialiser, which reads it in the activate event
   kernToggle = gui.toggle({
      target = glViewport,
      label  = 'Kerning',
      x      = hintList.viewport.x + hintList.viewport.width + 16, y = y,
      value  = glKerning,
      events = {
         activate = function()
            glKerning = kernToggle.value
            setFont(glFace, glFontSize)
         end
      }
   })
   y += math.max(combobox.viewport.height, hintList.viewport.height) + 12

   glTextY = y

   showHinting(items[0].label)
   setFont(items[0].label, glFontSize)

   glWindow.show()
   processing.sleep() -- Will sleep until the window sends MSGID_QUIT
