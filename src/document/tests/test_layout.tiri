-- $TIRI
-- Flute tests for the Document class.
--
-- This technique uses pre-computed checksums from the Document's bitmap output, captured from a 'good' state.  If a
-- checksum doesn't match, the test will fail and the resulting image will be saved to "temp:doc_test_results/".
-- You can view the saved image files to confirm the accuracy of the results.  If the test has passed then update the
-- old checksum with the new one provided in this program's output.

   include 'image'

@BeforeAll function init(State)
   global glDocFolder = State.folder
end

function saveBitmap(Bitmap, Name)
   filename = Name .. '.png'

   pic = obj.new('image', { width = Bitmap.width, height = Bitmap.height, bitsPerPixel = Bitmap.bitsPerPixel, flags=PCF_NEW })
   Bitmap.acCopyData(pic.bitmap)
   fl = obj.new('file', { flags=FL_NEW|FL_WRITE, path=f'temp:doc_test_results/{filename}' })
   pic.acSaveImage(fl)
end

-----------------------------------------------------------------------------------------------------------------------

function renderDocToBitmap(Path:str, Width:num)
   scene = obj.new('VectorScene', { pageWidth=Width ?? 1024, pageHeight=768 })
   vp = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   vp.new('VectorRectangle', { x=0, y=0, width='100%', height='100%', fill='rgb(255 255 255)' })

   doc = vp.new('document', { viewport=vp, path=Path })
   scene.pageHeight = doc.pageHeight

   bmp = obj.new('bitmap', { width=scene.pageWidth, height=doc.pageHeight, bitsPerPixel=32 })
   bmp.acClear()

   scene.bitmap = bmp
   scene.acDraw()
   return bmp
end

function crcTest(Name:str, Path:str, ExpectedCRC:any, TimeLimit:num)
   if type(ExpectedCRC) is 'table' then
      for res, crc in pairs(ExpectedCRC) do
         print(f'Testing at {res}px width')
         startTime = mSys.PreciseTime()
         bmp = renderDocToBitmap(glDocFolder .. Path, res)
         timeTaken = (mSys.PreciseTime() - startTime) / 1000000

         bmpdata = bmp.data
         bmp_crc = mSys.GenCRC32(0, bmpdata, #bmpdata)
         if crc is 0 then
            saveBitmap(bmp, f'{Name}_{res}')
            raise f'File "{Path}" @ page width {res} is yet to be assigned a checksum, current CRC is ' ..
               string.format("0x%.8x", bmp_crc)
         elseif crc != bmp_crc then
            saveBitmap(bmp, f'{Name}_{res}')
            raise f'The CRC for "{Path}" @ page width {res} is {string.format("0x%.8x", bmp_crc)}, ' ..
               f'expected {string.format("0x%.8x", crc)}'
         end

         if TimeLimit and (timeTaken > TimeLimit) and (mSys.GetSystemState().releaseBuild is 1) then
            raise f'File "{Path}" @ page width {res} took {timeTaken}s to render, expected {TimeLimit}s'
         end
      end
      return
   end

   startTime = mSys.PreciseTime()
   bmp = renderDocToBitmap(glDocFolder .. Path, 1024)
   timeTaken = (mSys.PreciseTime() - startTime) / 1000000

   bmpdata = bmp.data
   crc = mSys.GenCRC32(0, bmpdata, #bmpdata)
   if ExpectedCRC is 0 then
      saveBitmap(bmp, Name)
      raise f'The {Name} test is yet to be assigned a checksum, current CRC is {string.format("0x%.8x", crc)}'
   elseif ExpectedCRC != crc then
      saveBitmap(bmp, Name)
      raise f'The CRC for {Name} is {string.format("0x%.8x", crc)}, expected {string.format("0x%.8x", ExpectedCRC)}'
   else
      --saveBitmap(bmp, Name)
   end

   if TimeLimit and (timeTaken > TimeLimit) and (mSys.GetSystemState().releaseBuild is 1) then
      raise f'File "{Path}" took {timeTaken}s to render, expected {TimeLimit}s'
   end
end

-----------------------------------------------------------------------------------------------------------------------

@Test(priority=1) function Alignment()   crcTest('Alignment', 'alignment.rpl', { [1024] = 0x6bb3aa2c, [600] = 0x7318285f, [400] = 0xb4ba945f }, 0.1) end
@Test(priority=4) function Dialog()      crcTest('Dialog', 'dialog.rpl', 0xd1b391cf, 0.01) end
@Test(priority=4) function Fonts()       crcTest('Fonts', 'fonts.rpl', 0x8bf9495f, 0.02) end
@Test(priority=4) function Images()      crcTest('Images', 'images.rpl', 0x37f310d4, 0.02) end
@Test(priority=4) function Layout()      crcTest('Layout', 'layout.rpl', 0xef85c830, 0.03) end
@Test(priority=4) function Links1()      crcTest('Links1', 'links.rpl', 0xf40e5d14, 0.02) end
@Test(priority=4) function Links2()      crcTest('Links2', 'links.rpl?font=Noto Sans&font-size=16', 0x19e9d71a, 0.03) end
@Test(priority=4) function Lists()       crcTest('Lists', 'lists.rpl', 0xa63db457, 0.05) end
@Test(priority=4) function Logic()       crcTest('Logic', 'logic.rpl', 0x19dcf266, 0.03) end
@Test(priority=4) function Paragraphs()  crcTest('Paragraphs', 'paragraphs.rpl', 0x401fa40e, 0.05) end
@Test(priority=2) function Tables()      crcTest('Tables', 'tables.rpl', 0xa9fb6c41, 0.1) end
--@Test(priority=3) function Widgets()     crcTest('Widgets', 'widgets.rpl', 0xbf1021d5, 0.01) end
