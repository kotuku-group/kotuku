include 'crypto'
module crypto as mCrypto
import './oauth2_local' as oauth2

rxVerifier <const> = <{ regex.new([[^[A-Za-z0-9_\-]{128}$]]) }>
rxChallenge <const> = <{ regex.new([[^[A-Za-z0-9_\-]{43}$]]) }>

@Test function NativePkceGeneration()
   client = oauth2.Client({
      client_id = 'offline-test-client',
      scope = 'openid',
      custom_endpoints = {
         name = 'Offline fixture',
         auth_endpoint = 'https://issuer.invalid/authorize',
         token_endpoint = 'https://issuer.invalid/token',
         supports_pkce = true,
         supports_device_flow = false,
      },
   })

   first_url = client.buildAuthUrl()
   first_verifier = client.pkce.code_verifier
   first_challenge = client.pkce.code_challenge
   first_state = client.state

   assert(first_url.find('code_challenge_method=S256'), 'Authorization URL should request PKCE S256')
   assert(rxVerifier.test(first_verifier), 'PKCE verifier must be 128 unpadded base64url characters')
   assert(rxChallenge.test(first_challenge), 'PKCE challenge must be 43 unpadded base64url characters')
   assert(#first_state is 32, 'OAuth state must have the requested length')

   digest = array<byte, 32>
   assert(mCrypto.SHA256(first_verifier, digest) is ERR_Okay, 'Native SHA-256 should hash the verifier')
   expected = array<byte, 43>
   err, written = mCrypto.Base64Encode(digest, CC_URL, expected)
   assert(err is ERR_Okay and written is 43, 'Native base64url should encode the PKCE digest')
   assert(first_challenge is expected.getString(0, written), 'PKCE challenge must be BASE64URL(SHA256(verifier))')

   client.buildAuthUrl()
   assert(client.state != first_state, 'Each authorization attempt must use fresh state')
   assert(client.pkce.code_verifier != first_verifier, 'Each authorization attempt must use a fresh verifier')
end
