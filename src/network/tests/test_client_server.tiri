--[[
Client-Server Network Communications test.  Creates a NetServer and then starts NetSocket clients to connect to it.
--]]

   include 'network'
module network as mNet

glTestSteps     = 0
glExpectedSteps = 6
glServerData    = nil
glClientData    = nil
glPort          = 8206
glTestCompleted = false
rxMessage <const> = regex.new('\\w+:(.+)')

function logOutputableState(State)
   return choose State from
      NTC_CONNECTED -> 'CONNECTED'
      NTC_CONNECTING -> 'CONNECTING'
      NTC_DISCONNECTED -> 'DISCONNECTED'
      NTC_HANDSHAKING -> 'HANDSHAKING'
      NTC_RESOLVING -> 'RESOLVING'
      else -> tostring(State)
   end
end

------------------------------------------------------------------------------------------------------------------------
-- Test address validation and error handling

@Test function StrToAddress()
   invalidAddresses = array<str> {
      'gggg::1',           -- Invalid hex digits
      '1::2::3',           -- Double double-colon
      '1:2:3:4:5:6:7:8:9', -- Too many groups
      'not.an.ipv6.address' -- Not an IP address at all
   }

   for addr in values(invalidAddresses) do
      dest = struct.new('IPAddress')
      assert(mNet.StrToAddress(addr, dest) != ERR_Okay, 'StrToAddress should fail for invalid IPv6 address: ' .. addr)
   end

   validAddresses = array<str> {
      '::1',                   -- Loopback
      '::',                    -- Any address
      '2001:db8::1',           -- Documentation prefix
      'fe80::1',               -- Link-local
      '::ffff:127.0.0.1',      -- IPv4-mapped IPv6
   }

   for addr in values(validAddresses) do
      dest = struct.new('IPAddress')
      check mNet.StrToAddress(addr, dest)
   end
end

-----------------------------------------------------------------------------------------------------------------------

@Test function ClientServer()
   glPort++
   server_buffer = string.alloc(1024)

   sockServer = obj.new('netserver', {
      name    = 'Server',
      address = '127.0.0.1',
      feedback = function(Socket:obj, Client:obj, State)
         assert(Socket and Client, '[Server] Socket or Client parameter not defined.')

         if State is NTC_CONNECTED then
            logOutput('[Server] Connection established to new client.')
            err, len = Client.acWrite('Hello from the server')
            assert(err is ERR_Okay, '[Server] Failed to send message to the client: ' .. mSys.GetErrorMsg(err))
         else
            logOutput('[Server] Ignoring state ' .. logOutputableState(State))
         end
      end,
      incoming = function(Socket:obj, Client:obj)
         assert(Socket and Client, '[Server] Socket or Client parameter not defined.')

         err, read_len = Client.acRead(server_buffer)
         assert(err is ERR_Okay, 'Failed to read data from client, error: ' .. mSys.GetErrorMsg(err))

         local msg = server_buffer.sub(0, read_len)
         logOutput(f'[Server] Received "{msg}"')
         if (msg.find('Reply')) then
            glTestCompleted = true
            Socket.acSignal()
         end
      end,
      port  = glPort,
   } )

   clientSocket = obj.new('netsocket', {
      name = 'Client',
      feedback = function(Socket, State)
         assert(Socket, 'Socket parameter not defined.')
         if (State is NTC_CONNECTED) then
            logOutput('[Client] Writing hello message to the server...')
            err, len = Socket.acWrite('Hello from the client.')
            assert(err is ERR_Okay, '[Client] Failed to write chars, error: ' .. mSys.GetErrorMsg(err))
         end
      end,
      incoming = function(Socket, Script)
         buffer = string.alloc(1024)
         err, read_len = Socket.acRead(buffer)
         assert(err is ERR_Okay, '[Client] Failed to read data from the socket.')
         logOutput('[Client] Received: ' .. buffer.sub(0,read_len))
         logOutput('[Client] Sending reply to server...')
         err, len = Socket.acWrite('Reply from the client.')
         assert(err is ERR_Okay, '[Client] Failed to send reply, error: ' .. mSys.GetErrorMsg(err))
      end
   } )

   proc = processing.new({ timeout = 5.0, signals = array<obj> { sockServer } })

   check clientSocket.mtConnect('127.0.0.1', glPort)
   check proc.sleep()
   assert(glTestCompleted, 'The test did not complete the steps as expected.')
end

-----------------------------------------------------------------------------------------------------------------------

@Test function DataFeedWritesToSocket()
   glPort++

   expected_msg = 'DATAFEED:Buffer write path'
   received_msg = nil

   server = obj.new('netserver', {
      name    = 'DataFeedServer',
      address = '127.0.0.1',
      incoming = function(Socket:obj, Client:obj)
         buffer = string.alloc(1024)
         err, read_len = Client.acRead(buffer)
         assert(err is ERR_Okay, '[Server] Failed to read data-feed content: ' .. mSys.GetErrorMsg(err))

         received_msg = buffer.sub(0, read_len)
         Socket.acSignal()
      end,
      port = glPort,
   } )

   client = obj.new('netsocket', {
      name = 'DataFeedClient',
      feedback = function(Socket:obj, State:num)
         if State is NTC_CONNECTED then
            err = Socket.acDataFeed(nil, DATA_TEXT, expected_msg)
            assert(err is ERR_Okay, '[Client] Failed to feed socket data: ' .. mSys.GetErrorMsg(err))
         end
      end,
   } )

   proc = processing.new({ timeout = 5.0, signals = array<obj> { server } })
   check client.mtConnect('127.0.0.1', glPort)
   check proc.sleep()

   assert(received_msg is expected_msg,
      'DataFeed payload mismatch. Expected: ' .. expected_msg .. ', Received: ' .. tostring(received_msg))
end

-----------------------------------------------------------------------------------------------------------------------
-- One-on-one basic communication test between client and server.

@Test function BasicCommunication()
   local read_msg_sent
   glPort++

   -- Create NetServer with comprehensive message handling
   sockServer = obj.new('netserver', {
      name = 'BasicTestServer',
      feedback = function(Socket, Client, State)
         logOutput('[Server] Client state change: ' .. logOutputableState(State))
         if State is NTC_CONNECTED then
            logOutput('[Server] Client connected, sending welcome message...')
            err, len = Client.acWrite('WELCOME:Server ready for communication')
            assert(err is ERR_Okay, '[Server] Failed to send welcome message: ' .. mSys.GetErrorMsg(err))
            glTestSteps++
         elseif State is NTC_DISCONNECTED then
            glTestSteps++
            logOutput('[Server] Client disconnected.  Step ' .. glTestSteps .. ' of ' .. glExpectedSteps)
            if glTestSteps >= glExpectedSteps then
               Socket.acSignal()
            end
         end
      end,
      incoming = function(Socket, Client)
         buffer = string.alloc(2048)
         err, read_len = Client.acRead(buffer)
         if (err != ERR_Okay) then
            if (err is ERR_Disconnected) then
               if not read_msg_sent then logOutput('[Server] Client disconnected on Read()') end
               read_msg_sent = true
               return
            end
            Socket.acSignal()
            raise '[Server] Failed to read data from client: ' .. mSys.GetErrorMsg(err)
         end

         local msg = buffer.sub(0, read_len)
         logOutput('[Server] Received: ' .. msg)

         if (msg.startsWith('ACK:WELCOME')) then
            logOutput('[Server] Client acknowledged welcome, requesting data...')
            err, len = Client.acWrite('REQUEST:Send your test data')
            assert(err is ERR_Okay, '[Server] Failed to send data request: ' .. mSys.GetErrorMsg(err))
            glTestSteps++
         elseif (msg.startsWith('DATA:')) then
            data = rxMessage.extract(msg)
            glServerData = data
            logOutput('[Server] Received data: ' .. data)
            err, len = Client.acWrite('CONFIRM:Data received successfully')
            assert(err is ERR_Okay, '[Server] Failed to send confirmation: ' .. mSys.GetErrorMsg(err))
            glTestSteps++
         elseif (msg.startsWith('COMPLETE:')) then
            logOutput('[Server] Client signalled completion')
            glTestSteps++
            check Client.acDeactivate()
         end
      end,
      port = glPort,
      flags = 'MULTI_CONNECT'
   })

   -- Create client socket with state-aware message handling
   clientSocket = obj.new('netsocket', {
      name = 'BasicTestClient',
      feedback = function(Socket:obj, State:num)
         logOutput('[Client] Connection state: ' .. logOutputableState(State))
         if State is NTC_CONNECTED then
            logOutput('[Client] Connected to server, waiting for welcome...')
         elseif State is NTC_DISCONNECTED then
            logOutput('[Client] Disconnected from server')
         end
      end,
      incoming = function(Socket)
         buffer = string.alloc(2048)
         err, read_len = Socket.acRead(buffer)
         if err is ERR_Disconnected then return end
         assert(err is ERR_Okay, '[Client] Failed to read data from server: ' .. mSys.GetErrorMsg(err))

         local msg = buffer.sub(0, read_len)
         logOutput('[Client] Received: ' .. msg)

         if msg.startsWith('WELCOME:') then
            logOutput('[Client] Received welcome, sending acknowledgment...')
            err, len = Socket.acWrite('ACK:WELCOME received, client ready')
            assert(err is ERR_Okay, '[Client] Failed to send acknowledgment: ' .. mSys.GetErrorMsg(err))
            glTestSteps++
         elseif msg.startsWith('REQUEST:') then
            logOutput('[Client] Received data request, sending test data...')
            glClientData = 'TestPayload123'
            err, len = Socket.acWrite('DATA:' .. glClientData)
            assert(err is ERR_Okay, '[Client] Failed to send data: ' .. mSys.GetErrorMsg(err))
         elseif msg.startsWith('CONFIRM:') then
            logOutput('[Client] Server confirmed data receipt, completing test...')
            err, len = Socket.acWrite('COMPLETE:Test finished')
            assert(err is ERR_Okay, '[Client] Failed to send completion: ' .. mSys.GetErrorMsg(err))
         end
      end
   })

   proc = processing.new({ timeout = 10.0, signals = array<obj> { sockServer } })
   check clientSocket.mtConnect('127.0.0.1', glPort)
   check proc.sleep()

   assert(glTestSteps >= glExpectedSteps,
      'Test did not complete all steps. Expected: ' .. glExpectedSteps .. ', Actual: ' .. glTestSteps)

   assert(glServerData is glClientData and glServerData != nil,
      'Data integrity check failed. Expected: ' .. tostring(glClientData) .. ', Received: ' .. tostring(glServerData))
end

-----------------------------------------------------------------------------------------------------------------------

@Test function ConnectionStates()
   stateChanges = array<str> {}

   glPort++

   server = obj.new('netserver', {
      name = 'StateTestServer',
      feedback = function(Socket, Client, State)
         logOutput('Server received state change.')
         stateChanges.push('SERVER_CLIENT_' .. logOutputableState(State))
      end,
      port = glPort,
   })

   client = obj.new('netsocket', {
      name = 'StateTestClient',
      feedback = function(Socket, State)
         logOutput('Client received state change.')
         stateChanges.push('CLIENT_' .. logOutputableState(State))
         if State is NTC_CONNECTED then
            server.acSignal()
         end
      end
   })

   proc = processing.new({ timeout = 5.0, signals = array<obj> { server } })
   client.mtConnect('127.0.0.1', glPort)
   check proc.sleep()

   assert(#stateChanges >= 2, 'Expected at least 2 state changes, got: ' .. #stateChanges)

   foundClientConnected = false
   foundServerConnected = false
   for state in values(stateChanges) do
      if (state is 'CLIENT_CONNECTED') then foundClientConnected = true end
      if (state is 'SERVER_CLIENT_CONNECTED') then foundServerConnected = true end
   end

   assert(foundClientConnected, 'Client connection state change not detected')
   assert(foundServerConnected, 'Server client connection state change not detected')
end

-----------------------------------------------------------------------------------------------------------------------

@Test function ConnectionTimeout()
   timeoutDuration = 0.5
   startTime = mSys.PreciseTime()
   connectionTimedOut = false

   -- Try connecting to an IP address that should not respond (RFC 5737 test address)
   -- 192.0.2.1 is reserved for documentation and should not be routable
   testAddress = '192.0.2.1'
   testPort = 12345

   clientSocket = obj.new('netsocket', {
      name = 'TimeoutTestClient',
      feedback = function(Socket, State)
         currentTime = mSys.PreciseTime()
         elapsed = (currentTime - startTime) / 1000000.0  -- Convert to seconds
         logOutput(string.format('[Client] State: %s after %.2fs', logOutputableState(State), elapsed))

         if State is NTC_DISCONNECTED then
            if Socket.error is ERR_TimeOut then
               connectionTimedOut = true
               Socket.acSignal()
            end
         end
      end
   })

   logOutput(string.format('[Client] Attempting connection to %s:%d with %.1fs timeout...', testAddress, testPort, timeoutDuration))

   proc = processing.new({ timeout = timeoutDuration + 2.0, signals = array<obj> { clientSocket } })
   check clientSocket.mtConnect(testAddress, testPort, timeoutDuration)
   check proc.sleep()

   endTime = mSys.PreciseTime()
   totalElapsed = (endTime - startTime) / 1000000.0

   -- Verify the timeout occurred within expected time bounds
   assert(connectionTimedOut, 'Connection timeout did not occur')
   assert(clientSocket.error is ERR_TimeOut, 'Socket error should be ERR_TimeOut, got: ' .. mSys.GetErrorMsg(clientSocket.error))
   assert(totalElapsed >= timeoutDuration, string.format('Timeout occurred too early: %.2fs < %.2fs', totalElapsed, timeoutDuration))
   assert(totalElapsed <= (timeoutDuration + 1.0), string.format('Timeout occurred too late: %.2fs > %.2fs', totalElapsed, timeoutDuration + 1.0))
end

------------------------------------------------------------------------------------------------------------------------
-- A ClientSocket reports unsent bytes through OutQueueSize, and Deactivate() disconnects only after its queue has been
-- written.  The client runs on this thread, so nothing is read until the test sleeps; a write larger than the kernel
-- buffers is therefore partly queued by Network.

@Test function ClientSocketQueueAndDeactivate()
   local TOTAL <const> = 8 * 1024 * 1024
   local state = { received=0, disconnected=false, accepted=nil }

   local server <close> = obj.new('netserver', {
      address='127.0.0.1', port=0, flags=NSF_MULTI_CONNECT,
      feedback = function(Server, Client, State)
         if State is NTC_CONNECTED then state.accepted = Client end
      end,
      incoming = function(Server, Client)
         local buffer = string.alloc(1024)
         Client.acRead(buffer)
      end
   })

   local client <close> = obj.new('netsocket', {
      feedback = function(Socket, State)
         if State is NTC_DISCONNECTED then state.disconnected = true end
      end,
      incoming = function(Socket)
         local buffer = array<byte, 65536>
         local err, size = Socket.acRead(buffer)
         if err != ERR_Okay then
            state.disconnected = true
            return
         end
         state.received += size
      end
   })
   check client.mtConnect('127.0.0.1', server.port)

   for i in {0 to 300} do
      if state.accepted then break end
      processing.sleep(0.01)
   end
   local socket = state.accepted
   assert(socket, 'The connection was not accepted')
   assert(socket.outQueueSize is 0, 'A new ClientSocket reported queued bytes')

   -- MsgLimit (about 1 MiB) caps what Network queues from one write, so several writes are needed.

   local chunk = string.rep('q', 512 * 1024)
   local written = 0
   while written < TOTAL do
      local err, size = socket.acWrite(chunk)
      assert(err is ERR_Okay or err is ERR_BufferOverflow, f'Write failed with {err}')
      written += size
      if size < #chunk then break end
   end

   local queued = socket.outQueueSize
   assert(queued > 0, 'Nothing was queued even though the peer was not reading')
   assert(queued <= written, f'OutQueueSize {queued} exceeds the {written} bytes written')

   check socket.acDeactivate()
   assert(not state.disconnected, 'Deactivate disconnected before the queue was written')

   for i in {0 to 1000} do
      if state.disconnected then break end
      processing.sleep(0.01)
   end

   assert(state.disconnected, 'The connection was not closed after the queue drained')
   assert(state.received is written, f'Wrote {written} bytes but the client received {state.received}')
end

-----------------------------------------------------------------------------------------------------------------------
-- Bytes queued under backpressure must arrive in the order written.  On Windows, sends are posted to IOCP from both
-- the owning thread and the completion threads, which could reorder blocks if a send was dequeued and posted
-- separately.

@Test function QueuedWritesKeepOrder()
   local BLOCK <const> = 16384
   local COUNT <const> = 512
   local state = { chunks={}, received=0, connected=false }

   local server <close> = obj.new('netserver', {
      address='127.0.0.1', port=0, flags=NSF_MULTI_CONNECT,
      incoming = function(Server, Client)
         local buffer = array<byte, 65536>
         local err, size = Client.acRead(buffer)
         if err is ERR_Okay and size > 0 then
            state.chunks[#state.chunks] = buffer.getString(0, size)
            state.received += size
         end
      end
   })

   local client <close> = obj.new('netsocket', {
      feedback = function(Socket, State)
         if State is NTC_CONNECTED then state.connected = true end
      end
   })
   check client.mtConnect('127.0.0.1', server.port)

   for i in {0 to 300} do
      if state.connected then break end
      processing.sleep(0.01)
   end
   assert(state.connected, 'The client did not connect')

   -- The peer cannot read while this loop runs, so the operating system's buffers fill and Network queues the rest.

   local filler = string.rep('z', BLOCK - 8)
   local index = 0
   local remainder = nil
   local function pump()
      while index < COUNT do
         local block = remainder ?? (string.format('%08d', index) .. filler)
         local err, size = client.acWrite(block)
         assert(err is ERR_Okay or err is ERR_BufferOverflow, f'Write failed with {err}')
         if size < #block then
            remainder = block.sub(size)
            return false
         end
         remainder = nil
         index++
      end
      return true
   end

   client.outgoing = function(Socket)
      if pump() then Socket.outgoing = nil end
   end
   pump()

   for i in {0 to 3000} do
      if state.received >= BLOCK * COUNT then break end
      processing.sleep(0.01)
   end
   assert(state.received is BLOCK * COUNT, f'Received {state.received} of {BLOCK * COUNT} bytes')

   local data = table.concat(state.chunks)
   for i in {0 to COUNT} do
      local tag = data.sub(i * BLOCK, i * BLOCK + 8)
      assert(tag is string.format('%08d', i), f'Block {i} arrived out of order (found tag {tag})')
   end
end

-----------------------------------------------------------------------------------------------------------------------
-- A script can remove its Outgoing callback by assigning nil.  Outgoing is write-only, so the test checks that the
-- assignment succeeds (it previously dereferenced a null value).

@Test function ClearOutgoingCallback()
   local socket <close> = obj.new('netsocket', { })
   socket.outgoing = function(Socket) end
   socket.outgoing = nil
   check socket.acWrite('queued')
   assert(socket.outQueueSize is 6, 'The socket was not usable after Outgoing was cleared')
end

-----------------------------------------------------------------------------------------------------------------------
-- A refused connection reports ConnectionRefused on every platform.

@Test function ConnectionRefusedError()
   local state = { disconnected=false, error=nil }
   -- Keep the operating-system-selected port allocated on another loopback address so that no listener teardown can
   -- race the connection attempt.  The matching 127.0.0.1 endpoint remains unbound and must refuse the connection.
   local port_guard <close> = obj.new('netserver', { address='127.0.0.2', port=0 })

   local socket <close> = obj.new('netsocket', {
      feedback = function(Socket, State)
         if State is NTC_DISCONNECTED then
            state.disconnected = true
            state.error = Socket.error
         end
      end
   })
   check socket.mtConnect('127.0.0.1', port_guard.port)

   for i in {0 to 500} do
      if state.disconnected then break end
      processing.sleep(0.01)
   end
   assert(state.disconnected, 'The refused connection did not disconnect')
   assert(state.error is ERR_ConnectionRefused, f'A refused connection reported error {state.error}')
end
