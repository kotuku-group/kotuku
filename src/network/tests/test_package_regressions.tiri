   import 'net/openapi'
   import 'net/oauth2'
   import 'net/httpserver'
   import 'net/url'
   import 'json'
   include 'http'

function parseRegressionSpec(Spec:table, Options:table):table
   path = 'temp:openapi-component-regression.json'
   defer mSys.DeleteFile(path) end
   io.writeAll(path, json.encode(Spec))
   return openapi.parse(path, Options)
end

function regressionAPI(Options:table):table
   path = 'temp:openapi-route-regression.json'
   defer mSys.DeleteFile(path) end
   io.writeAll(path, json.encode({ openapi = '3.0.3', paths = {
      ['/users/{id}/items/{item}'] = { get = { operationId = 'getItem', responses = {
         ['200'] = { content = { ['application/json'] = { schema = { type = 'string', example = 'mock' } } } }
      } } }
   } }))
   return openapi.parse(path, Options)
end

function regressionResponse():table
   res = { statusCode = 200 }
   res.status = function(Code:num):table res.statusCode = Code return res end
   res.json = function(Data:any) res.body = Data end
   return res
end

@Test function OpenApiParametersReachHttpHandlers()
   api = regressionAPI({ handlers = { getItem = function(Req, Res)
      assert(Req.params.id is '42' and Req.params.item is 'abc', 'Both path parameters must reach the handler')
      Res.json({ id = Req.params.id, item = Req.params.item })
   end } })
   config = api.toServerConfig()
   assert(config.routes[0].pattern is '/users/:id/items/:item', 'OpenAPI paths must use HTTP router parameters')
   config.port = 0
   config.bind = '127.0.0.1'
   config.folder = 'temp:'
   server = hslib.start(config)
   defer server.stop() end
   assert(server.port > 0 and server.port is server._socket.port, 'The server must publish its bound port')
   proc = processing.new({ timeout = 3.0 })
   body = ''
   http <close> = obj.new('http', {
      src = 'http://127.0.0.1:' .. server.port .. '/users/42/items/abc',
      incoming = function(HTTP, Buffer) body ..= Buffer.getString() end,
      stateChanged = function(HTTP, State)
         if State is HGS_COMPLETED or State is HGS_TERMINATED then proc.signal() end
      end
   })
   check http.acActivate()
   check proc.sleep()
   assert(http.status is 200, 'A concrete request must match the generated parameter route')
   data = json.decode(body)
   assert(data.id is '42' and data.item is 'abc', 'The response must come from the parameterised handler')
end

@Test function MockTogglesAffectExistingHandlers()
   modes = array<str> { 'error', 'stub', 'mock' }
   for iteration in {0 to 120} do
      mode = modes[iteration % #modes]
      api = regressionAPI({ onMissingHandler = mode })
      handler = api.routes[0].handler
      res = regressionResponse()
      handler({}, res)
      expected = mode is 'mock' ? 200 : (mode is 'stub' ? 501 : 500)
      assert(res.statusCode is expected, 'Initial missing-handler policy must be preserved')
      api.enableMocks()
      res = regressionResponse()
      handler({}, res)
      assert(res.statusCode is 200 and res.body is 'mock', 'Enabling mocks must affect existing closures')
      api.disableMocks()
      res = regressionResponse()
      handler({}, res)
      assert(res.statusCode is (mode is 'stub' ? 501 : 500), 'Disabling mocks must stop mock responses')
      api.handlers.bind('getItem', function(Req, Res) Res.json('real') end)
      api.enableMocks()
      res = regressionResponse()
      api.routes[0].handler({}, res)
      assert(res.body is 'real', 'Mock mode must preserve bound user handlers')
   end
end

@Test function OAuthCallbackBuffersSeparateReads()
   client = oauth2.Client({ clientID = 'offline-client', scope = 'api', authorizationTimeout = 5,
      custom_endpoints = {
         auth_endpoint = 'https://issuer.invalid/authorize', token_endpoint = 'https://issuer.invalid/token'
      },
      transport = function(Request:table):table
         assert(Request.form.code is 'fixture+code', 'The callback must preserve and decode fragments')
         return { status = 200, body = json.encode({ access_token = 'fixture-token', token_type = 'Bearer' }) }
      end
   })
   socket = nil
   response = ''
   response_proc = processing.new({ timeout = 3.0 })
   defer socket = nil end
   client.open_browser = function(AuthURL:str)
      auth_params = url.parseQuery(url.parse(AuthURL).query)
      redirect = url.parse(auth_params.redirect_uri)
      connected = processing.new({ timeout = 3.0 })
      socket = obj.new('netsocket', {
         feedback = function(Socket, State)
            if State is NTC_CONNECTED then connected.signal() end
         end,
         incoming = function(Socket)
            buffer = string.alloc(8192)
            err, count = Socket.acRead(buffer)
            if err is ERR_Okay then
               response ..= buffer.sub(0, count)
               if response.find('</html>') != nil then response_proc.signal() end
            end
         end
      })
      check socket.mtConnect('127.0.0.1', redirect.port, 3.0)
      check connected.sleep()
      check socket.acWrite('GET ' .. redirect.path .. '?code=fixture')
      processing.new({ timeout = 0.05 }).sleep()
      assert(response is '', 'A partial request line must not produce a response')
      check socket.acWrite('%2Bcode&state=' .. auth_params.state .. ' HTTP/1.1\r\nHost: 127.0.0.1:' ..
         redirect.port .. '\r\n')
      processing.new({ timeout = 0.05 }).sleep()
      assert(response is '', 'Incomplete headers must not complete authorisation')
      check socket.acWrite('\r\n')
   end
   token, err = client.authorizeWeb()
   assert(token and token.access_token is 'fixture-token' and err is nil, 'Fragmented callbacks must complete')
   check response_proc.sleep()
   assert(response.startsWith('HTTP/1.1 200 OK\r\n'), 'The browser must receive a successful response')
end

@Test function LiteralRoutesPrecedeParametersAndWildcards()
   paths = {}
   for i in {0 to 12} do
      prefix = '/x' .. i
      paths[prefix .. '/{id}'] = { get = { operationId = 'parameter' .. i } }
      paths[prefix .. '/me'] = { get = { operationId = 'literal' .. i } }
      paths[prefix .. '/*'] = { get = { operationId = 'wildcard' .. i } }
   end
   paths['/{group}/me'] = { get = { operationId = 'group' } }
   api = parseRegressionSpec({ openapi = '3.0.3', paths = paths }, {})
   positions = {}
   for i, route in ipairs(api.toServerConfig().routes) do positions[route.metadata.operationId] = i end
   for i in {0 to 12} do
      assert(positions['literal' .. i] < positions['parameter' .. i], 'Literal routes must win over parameters')
      assert(positions['parameter' .. i] < positions['wildcard' .. i], 'Parameters must win over wildcards')
      assert(positions['parameter' .. i] < positions.group, 'Specificity must be compared from the first segment')
   end
end

@Test function ComponentSchemasGenerateMockResponses()
   components = { schemas = {
      Name = { type = 'string', example = 'Ada' },
      User = { type = 'object', required = array<str> { 'name', 'children' }, properties = {
         name = { ['$ref'] = '#/components/schemas/Name' },
         children = { type = 'array', minItems = 2, maxItems = 2, items = { ['$ref'] = '#/components/schemas/Name' } },
         parent = { ['$ref'] = '#/components/schemas/User' }
      } },
      Alias = { ['$ref'] = '#/components/schemas/User' },
      ['Slash/Name~'] = { type = 'string', example = 'escaped' },
      Loop = { ['$ref'] = '#/components/schemas/Loop' }
   } }
   paths = {}
   for name, reference in pairs({ user = 'Alias', escaped = 'Slash~1Name~0', loop = 'Loop', missing = 'Absent' }) do
      schema = { ['$ref'] = '#/components/schemas/' .. reference }
      paths['/' .. name] = { get = { operationId = name, responses = {
         ['200'] = { content = { ['application/json'] = { schema = schema } } }
      } } }
   end
   spec = { openapi = '3.0.3', paths = paths, components = components }
   api = parseRegressionSpec(spec, { onMissingHandler = 'mock' })
   for route in values(api.routes) do
      res = regressionResponse()
      route.handler({}, res)
      name = route.metadata.operationId
      if name is 'user' then
         assert(res.body.name is 'Ada', 'Nested component properties must resolve')
         assert(#res.body.children is 2 and res.body.children[0] is 'Ada' and res.body.children[1] is 'Ada',
            'Repeated array references must each generate a value')
         assert(res.body.parent is nil, 'Recursive schemas must terminate')
      elseif name is 'escaped' then
         assert(res.body is 'escaped', 'JSON pointer escapes must resolve')
      else
         assert(res.body.message is 'Mock response for ' .. name, 'Invalid or cyclic references must use the fallback')
      end
   end
   api = parseRegressionSpec(spec, { onMissingHandler = 'mock', mockGenerators = { schemas = {
      User = function(Example:any):table return { name = 'custom' } end
   } } })
   for route in values(api.routes) do
      if route.metadata.operationId is 'user' then
         res = regressionResponse()
         route.handler({}, res)
         assert(res.body.name is 'custom', 'Component references must select their named schema generator')
      end
   end
end

@Test function OAuthExpiryUsesUnixTimeInEveryTokenFlow()
   server = hslib.start({ port = 0, bind = '127.0.0.1', folder = 'temp:', routes = {
      { method = 'POST', pattern = '/token', handler = function(Req, Res)
         Res.json({ access_token = 'fixture-token', token_type = 'Bearer', expires_in = 3600 })
      end },
      { method = 'POST', pattern = '/device', handler = function(Req, Res)
         Res.json({ device_code = 'fixture-code', user_code = 'fixture', verification_uri = 'https://issuer.invalid',
            interval = 1, expires_in = 10 })
      end }
   } })
   defer server.stop() end
   endpoint = 'http://127.0.0.1:' .. server.port
   client = oauth2.Client({ clientID = 'offline-client', scope = 'api', testLoopback = true,
      redirectURI = 'http://127.0.0.1:12345/callback', authorizationTimeout = 5,
      presentDevice = function(Instructions:table)
         assert(Instructions.user_code is 'fixture', 'Device flow must present the fixture user code')
      end,
      custom_endpoints = {
         auth_endpoint = 'https://issuer.invalid/authorize',
         token_endpoint = endpoint .. '/token', device_endpoint = endpoint .. '/device',
         supports_device_flow = true
      }
   })
   clock <close> = obj.new('time')
   check clock.acQuery()
   before = clock.systemTime / 1000000
   for acquire in values(array<any> {
      function():table return client.refreshToken('fixture-refresh') end,
      function():table
         client.buildAuthUrl()
         return client.exchangeCodeForTokens('fixture-code')
      end,
      function():table return client.authorizeDevice() end
   }) do
      check clock.acQuery()
      before = clock.systemTime / 1000000
      token = acquire()
      check clock.acQuery()
      after = clock.systemTime / 1000000
      assert(token and token.expires_at >= before + 3600 and token.expires_at <= after + 3600,
         'Every token flow must store the actual Unix expiry timestamp')
      assert(token.refresh_at is token.expires_at - 60,
         'The refresh threshold must remain separate from actual token expiry')
      assert(client.validateToken(json.decode(json.encode(token))), 'A persisted fresh token must remain valid')
   end
   assert(not client.validateToken({ access_token = 'expired', expires_at = before - 1 }),
      'Persisted tokens with past Unix expiry timestamps must be rejected')
end
