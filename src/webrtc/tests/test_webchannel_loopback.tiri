   import './webchannel_support'

-- Channel behaviour uses numeric candidates; test_mdns_privacy covers name registration.

@Test function ChannelModesAndMessages()
   local first <close> = obj.new('peerconnection', { flags='NO_MDNS' })
   local second <close> = obj.new('peerconnection', { flags='NO_MDNS' })
   local remote = {}
   local received = {}
   local order = array<str>
   second.onWebChannel = function(Peer, Channel)
      order.push('remote:' .. Channel.label)
      remote[Channel.label] = Channel
      Channel.onOpen = function(Child)
         order.push('open:' .. Child.label)
         assert(Child.state is WCS_OPEN, 'OnOpen state is not OPEN')
      end
      Channel.onMessage = function(Child, Buffer, Type)
         received[Child.label] = { data=Buffer.getString(), type=Type }
         check Child.mtSend(Buffer, Type)
      end
   end
   local modes = array<obj> {
      channelTest.create(first, 'ordered', 'chat'),
      channelTest.create(first, 'unordered', '', false),
      channelTest.create(first, 'count-zero', '', true, false, -1, 0),
      channelTest.create(first, 'lifetime', '', true, false, -1, -1, 5000),
      channelTest.create(first, 'count-unordered', '', false, false, -1, 2),
      channelTest.create(first, 'lifetime-unordered', '', false, false, -1, -1, 5000)
   }
   local echoed = {}
   for _, channel in modes do
      assert(channel.streamID is -1 and channel.state is WCS_CONNECTING, 'Pre-SDP automatic ID was assigned early')
      channel.onMessage = function(Child, Buffer, Type)
         echoed[Child.label] = { data=Buffer.getString(), type=Type }
      end
   end
   assert(modes[2].maxRetransmits is 0 and modes[2].maxPacketLifeTime is -1, 'Zero option became omitted')
   channelTest.connect(first, second)
   channelTest.waitFor(function()
      for _, channel in modes do if channel.state != WCS_OPEN then return false end end
      return true
   end)
   assert(#order is 12, 'Remote creation/open notifications were missing or duplicated')
   for i in {0 to 12 by 2} do
      assert(order[i].startsWith('remote:') and order[i + 1].startsWith('open:'), 'Remote event order changed')
   end
   for _, channel in modes do
      assert(channel.streamID % 2 is 0, 'Offerer DTLS client did not receive even IDs')
      assert(channel.maxMessageSize is 262144, 'Remote default receive capacity was not applied')
      check channel.mtSend('hello\0' .. channel.label, WCM_TEXT)
   end
   channelTest.waitFor(function()
      for _, channel in modes do if echoed[channel.label] is nil then return false end end
      return true
   end)
   for _, channel in modes do
      assert(echoed[channel.label].data is 'hello\0' .. channel.label, 'Text including NUL changed')
      assert(echoed[channel.label].type is WCM_TEXT, 'Text PPID changed')
   end
   local binary = array<byte> { 0, 255, 128, 1, 0 }
   echoed.ordered = nil
   local original_binary = binary.getString()
   check modes[0].mtSend(binary, WCM_BINARY)
   binary[1] = 7 -- Mutation after Send must not change the copied payload.
   channelTest.waitFor(function() return echoed.ordered != nil end)
   assert(echoed.ordered.data is original_binary and echoed.ordered.type is WCM_BINARY, 'Binary changed')
   for _, kind in array<int> { WCM_TEXT, WCM_BINARY } do
      echoed.ordered = nil
      check modes[0].mtSend(nil, kind)
      channelTest.waitFor(function() return echoed.ordered != nil end)
      assert(echoed.ordered.data is '' and echoed.ordered.type is kind, 'Empty payload changed')
   end
   -- A new channel on an existing association needs no SDP exchange.
   local reverse = channelTest.create(second, 'reverse')
   first.onWebChannel = function(Peer, Channel)
      Channel.onMessage = function(Child, Buffer, Type) received.reverse = Buffer.getString() end
   end
   channelTest.waitFor(function() return reverse.state is WCS_OPEN end)
   assert(reverse.streamID % 2 is 1, 'DTLS server did not receive an odd ID')
   check reverse.mtSend('reverse', WCM_TEXT)
   channelTest.waitFor(function() return received.reverse is 'reverse' end)
   local closed = 0
   modes[0].onClose = function(Child)
      assert(Child.state is WCS_CLOSED, 'OnClose state was not CLOSED')
      closed += 1
   end
   check modes[0].mtClose()
   check modes[0].mtClose()
   assert(modes[0].state is WCS_CLOSING, 'Close did not reject sends immediately')
   channelTest.waitFor(function() return modes[0].state is WCS_CLOSED and remote.ordered.state is WCS_CLOSED end)
   assert(closed is 1, 'Terminal close was not exactly once')
end

@Test function NegotiatedLargeBinaryAndBuffering()
   local first <close> = obj.new('peerconnection', { flags='NO_MDNS', receiveLimit=16777216 })
   local second <close> = obj.new('peerconnection', { flags='NO_MDNS', receiveLimit=16777216 })
   local channel = channelTest.create(first, 'bulk', '', true, true, 42)
   local receiver = channelTest.create(second, 'bulk', '', true, true, 42)
   local unexpected = 0
   second.onWebChannel = function() unexpected += 1 end
   local payload = array<byte, 16777216>
   -- Non-uniform bytes including NUL and every byte value; compare all bytes at receipt.
   local pattern = array<byte, 28928> -- The byte pattern repeats every 113 * 256 bytes.
   for i in {0 to #pattern} do pattern[i] = (i * 13 + math.floor(i / 113)) % 256 end
   payload.copy(string.rep(pattern.getString(), math.ceil(#payload / #pattern)), 0, 0, #payload)
   local delivered = false
   receiver.onMessage = function(Child, Buffer, Type)
      assert(Type is WCM_BINARY and #Buffer is #payload, 'Large binary size/type changed')
      assert(Buffer is payload, 'Large binary bytes changed')
      delivered = true
   end
   channelTest.connect(first, second)
   channelTest.waitFor(function() return channel.state is WCS_OPEN and receiver.state is WCS_OPEN end)
   assert(channel.maxMessageSize is 16777216, '16 MiB directional send capacity was not negotiated')
   local low = 0
   channel.onBufferedAmountLow = function(Child)
      assert(Child.bufferedAmount is 0, 'Low callback arrived before adapter acceptance')
      low += 1
   end
   check channel.mtSend(payload, WCM_BINARY)
   assert(channel.bufferedAmount is #payload, 'Send incorrectly charged packetisation as adapter acceptance')
   assert(low is 0, 'Send invoked a callback inline')
   assert(channel.mtSend('x', WCM_BINARY) is ERR_BufferOverflow, 'Retained per-channel budget was exceeded')
   assert(channel.bufferedAmount is #payload, 'Rejected Send changed buffering')
   channelTest.waitFor(function() return delivered and low is 1 end, 90)
   assert(unexpected is 0, 'Negotiated channel produced a remote DCEP event')
   channel.bufferedAmountLowThreshold = 100
   channel.bufferedAmountLowThreshold = 0
   processing.sleep(0.05)
   assert(low is 1, 'Threshold assignment emitted a low event')
end
