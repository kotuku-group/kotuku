--$TIRI:Include

module({ name="WebSocket", copyright="Paul Manias © 2026", version=1.0, timestamp=20240611 }, function()
  c_include("<kotuku/modules/network.h>")

  enums("WSS", { type="int", start=0, comment="WebSocket connection states." },
    "CONNECTING: The opening handshake is in progress.",
    "OPEN: The handshake completed and messages can be exchanged.",
    "CLOSING: The closing handshake has started.  No further messages can be sent.",
    "CLOSED: The connection is closed or could not be opened.")

  enums("WSM", { type="int", start=1, comment="WebSocket message types." },
    "TEXT: The message payload is UTF-8 text.",
    "BINARY: The message payload is binary data.")

  flags("WSF", { comment="WebSocket flags." },
    "STREAM_MESSAGES: Deliver message fragments as they arrive instead of assembling complete messages.",
    "NO_UTF8_CHECK: Skip UTF-8 validation of text messages.  For interoperability with non-conforming peers only.",
    "DISABLE_SERVER_VERIFY: Do not verify the server's TLS certificate.",
    "NO_AUTO_PONG: Do not answer received pings automatically.  Intended for test fixtures only.",
    "SSL: WebSocketServer only.  Accept TLS (`wss://`) connections.",
    "EXTERNAL_LISTENER: WebSocketServer only.  Adopt sockets from an external NetServer without binding a listener.")

  enums("WSE", { type="int", start=0, comment="External listener events forwarded to WebSocketServer.Dispatch()." },
    "INCOMING: Read and process available socket input.",
    "OUTGOING: Resume transmission when the socket becomes writable.",
    "DISCONNECTED: Release protocol state after socket disconnection.")

  constants("WSC", { type="int", comment="WebSocket close status codes, as defined by RFC 6455 section 7.4.1." }, {
    NORMAL              = 1000,
    GOING_AWAY          = 1001,
    PROTOCOL_ERROR      = 1002,
    UNSUPPORTED_DATA    = 1003,
    NO_STATUS           = 1005,
    ABNORMAL            = 1006,
    INVALID_PAYLOAD     = 1007,
    POLICY_VIOLATION    = 1008,
    MESSAGE_TOO_BIG     = 1009,
    MANDATORY_EXTENSION = 1010,
    INTERNAL_ERROR      = 1011,
    TLS_HANDSHAKE       = 1015
  })

  methods("WebSocket", "wsk", {
    { id=1, name="Send" },
    { id=2, name="Ping" },
    { id=3, name="Close" }
  })

  structdef("WSRequest", { comment="Describes an opening handshake request received by a WebSocketServer." }, [[
    string Path       # The request path, excluding the query string.
    string Query      # The query string without its leading `?`, or empty.
    string Host       # The value of the Host header.
    string Origin     # The value of the Origin header, or empty.
    string Protocols  # The requested subprotocols as a comma-separated list, or empty.
    string Protocol   # The subprotocol that the server will select, or empty.
    string Address    # The client's IP address.
    string Headers    # The request's header fields, one `Name: Value` pair per line.
  ]])

  methods("WebSocketServer", "wsv", {
    { id=1, name="Broadcast" },
    { id=2, name="DisconnectClient" },
    { id=3, name="Adopt" },
    { id=4, name="Dispatch" }
  })

  klass("WebSocketServer", { src="class_websocket_server.cpp", output="class_websocket_server_def.c",
    extended=true }, [[
    large MaxMessageSize    # Maximum size of an assembled message, applied to each connection.
    large MaxFrameSize      # Maximum size of a single frame, applied to each connection.
    large SendLimit         # Maximum number of queued bytes awaiting transmission, applied to each connection.
    double PingInterval     # Keep-alive interval applied to each connection.
    double CloseTimeout     # Closing handshake timeout applied to each connection.
    double HandshakeTimeout # Seconds allowed for a client to send its opening handshake request.
    ptr ClientData          # Free for user data storage.
    string Address          # Local address to bind.  Empty binds all interfaces.
    string Path             # Accept requests for this path only.  Empty accepts any path.
    string Protocols        # Comma-separated subprotocols supported by the server, in order of preference.
    string SSLCertificate   # TLS certificate file.
    string SSLPrivateKey    # TLS private key file.
    string SSLKeyPassword   # Password for an encrypted TLS private key.
    int Port                # Local port to bind.  Zero selects an ephemeral port.
    int(WSF) Flags          # Optional flags.
    int TotalConnections    # Number of open connections.
  ]])

  klass("WebSocket", { src={ "class_websocket.cpp", "class_websocket_fields.cpp" },
    output="class_websocket_def.c", extended=true }, [[
    large MaxMessageSize   # Maximum size of an assembled message, in bytes.
    large MaxFrameSize     # Maximum size of a single frame, in bytes.  Zero applies MaxMessageSize.
    large SendLimit        # Maximum number of queued bytes awaiting transmission.
    double ConnectTimeout  # Handshake connection timeout, in seconds.
    double DataTimeout     # Handshake response timeout, in seconds.
    double PingInterval    # Seconds of inactivity before a keep-alive ping is sent.  Zero disables keep-alive.
    double CloseTimeout    # Seconds to wait for the closing handshake to complete.
    ptr ClientData         # Free for user data storage.
    string Location        # The ws:// or wss:// URL to connect to.
    string Protocols       # Comma-separated subprotocols to request.
    string Protocol        # The subprotocol selected by the server.
    string Origin          # Optional Origin request header.
    string ProxyServer     # HTTP proxy server for CONNECT tunnels.
    string CloseReason     # Received or generated close reason.
    string Redirect        # Target of a redirecting handshake response.
    int ProxyPort          # HTTP proxy server port.
    int(WSF) Flags         # Optional flags.
    int(WSS) State         # Current connection state.
    error Error            # The last error.
    int CloseCode          # Received or generated close status code.
    int Status             # HTTP status of the handshake response.
  ]])
end)
