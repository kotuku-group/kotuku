   module audio as mAudio

function expect_init_error(Object, Code)
   try
      Object.init()
   except e
      assert(e.code is Code, f'Expected {Code}, got {e.code}: {e.message}')
   success
      raise f'Expected initialisation error {Code}'
   end
end

@Test function OwnerAndExplicitTarget()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   effect = audio.new('AudioEffect')
   assert(effect.audio.id is audio.id, 'An Audio owner supplies the target')
   effect.init()
   assert(effect.outputRate is 48000)
   assert(effect.channel is 0)
   assert(effect.flags is 0)

   other <close> = obj.new('Audio', { device='null', outputRate=32000 })
   explicit = audio.new('AudioEffect', { audio=other })
   assert(explicit.audio.id is other.id, 'An explicit target overrides ownership')
   assert(explicit.outputRate is 32000)
   other.free()
   explicit.free()
end

@Test function InvalidTargetsAndChannels()
   missing <close> = obj.new('AudioEffect')
   expect_init_error(missing, ERR_FieldNotSet)
   wrong <close> = obj.new('AudioEffect')
   wrong.audio = missing
   expect_init_error(wrong, ERR_InvalidObject)

   audio <close> = obj.new('Audio', { device='null' })
   err, channel = audio.mtOpenChannels(2)
   assert(err is ERR_Okay)
   invalid <close> = obj.new('AudioEffect')
   invalid.audio = audio
   invalid.channel = channel + 1
   expect_init_error(invalid, ERR_Args)
   check audio.mtCloseChannels(channel)
   invalid.channel = channel
   expect_init_error(invalid, ERR_Args)
end

@Test function ApplicationFieldsAndClosedSet()
   audio <close> = obj.new('Audio', { device='null' })
   err, channel = audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   effect <close> = obj.new('AudioEffect', { audio=audio, channel=channel, order=-3, flags=AEF_BYPASS })
   effect.order = 4
   effect.flags = 0
   assert(effect.order is 4 and effect.flags is 0)
   assert(effect.mutable is 1, 'An attached application effect must be mutable')
   check audio.mtCloseChannels(channel)
   assert(effect.mutable is 0, 'A disconnected effect must not report itself as mutable')
   try
      effect.order = 5
   except e when ERR_NotInitialised
   success
      raise 'A disconnected effect must reject changes'
   end
   effect.free()
end

@Test function GlobalImmutability()
   audio <close> = obj.new('Audio', { device='null' })
   effect = audio.new('AudioEffect', { order=2 })
   try
      effect.order = 3
   except e when ERR_Immutable
   success
      raise 'Global order must be immutable'
   end
   try
      effect.flags = AEF_BYPASS
   except e when ERR_Immutable
   success
      raise 'Global flags must be immutable'
   end
   bypass <close> = obj.new('AudioEffect')
   bypass.audio = audio
   bypass.flags = AEF_BYPASS
   expect_init_error(bypass, ERR_InvalidValue)
end

@Test function ActiveMixerLifecycle()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   check audio.acActivate()
   data = array<byte, 65536>
   data.fill(128)
   err, sample = audio.mtAddSample(nil, SFM_U8_BIT_MONO, data, nil)
   assert(err is ERR_Okay)
   for i in {0 to 20} do
      err, channel = audio.mtOpenChannels(1)
      assert(err is ERR_Okay)
      effect <close> = obj.new('AudioEffect', { audio=audio, channel=channel })
      assert(effect.outputRate is audio.outputRate)
      check mAudio.MixSample(audio, channel, sample)
      check mAudio.MixFrequency(audio, channel, 44100)
      check mAudio.MixPlay(audio, channel, 0)
      mSys.WaitTime(-0.002)
      effect.flags = AEF_BYPASS
      effect.flags = 0
      check audio.mtCloseChannels(channel)
   end
   external <close> = obj.new('AudioEffect', { audio=audio })
   audio.free()
   external.free()
end

@Test function ReactivationRefreshesLayout()
   audio <close> = obj.new('Audio', { device='null', outputRate=32000, stereo=false })
   effect = audio.new('AudioEffect', {})
   assert(effect.stereo is 0, 'Attachment uses the requested layout before activation')
   check audio.acActivate()
   assert(effect.outputRate is audio.outputRate and effect.stereo is 0)
   check audio.acDeactivate()
   audio.stereo = true
   check audio.acActivate()
   assert(effect.stereo is 1, 'Reactivation refreshes the negotiated layout')
   assert(effect.setKey('stereo', 0) != ERR_Okay, 'Negotiated layout is read-only')
   assert(effect.setKey('channel', 65536) != ERR_Okay, 'Attachment scope is immutable')
   assert(effect.setKey('audio', tostring(audio.id)) != ERR_Okay, 'Attachment target is immutable')
end
