-- Opt-in real-device validation and Debug render measurements.  Output is a very quiet test signal.
   module audio as mAudio

@Test function RenderWorkloadMatrix()
   for _, voices in array<int> {1, 16, 64} do
      for _, bands in array<int> {0, 1, 8, 64} do
         audio <close> = obj.new('Audio', {})
         audio.masterVolume = 1
         check audio.acActivate()
         err, channel = audio.mtOpenChannels(voices)
         assert(err is ERR_Okay)
         data = array<byte, 8192>
         for i in {0 to 4096} do
            value = math.floor(16 * math.sin(i * 2 * math.pi / 64))
            if value < 0 then value += 65536 end
            data[i*2] = value % 256
            data[i*2+1] = math.floor(value / 256)
         end
         loop = struct.new('AudioLoop', { loopMode=LOOP_SINGLE, loop1Type=LTYPE_UNIDIRECTIONAL,
            loop1Start=0, loop1End=#data })
         err, sample = audio.mtAddSample(nil, SFM_S16_BIT_MONO, data, loop)
         assert(err is ERR_Okay)
         list = array<struct<AudioEQBand>>
         for i in {0 to bands} do
            list.push(struct.new('AudioEQBand', { type=EQB_PEAK, frequency=1000, gain=0.25, q=0.7 }))
         end
         effect <close> = obj.new('AudioEqualiser', {audio=audio, channel=channel, bands=list})
         if bands is 0 then effect.free() end
         for i in {0 to voices} do
            check mAudio.MixSample(audio, channel+i, sample)
            check mAudio.MixFrequency(audio, channel+i, 44100)
            check mAudio.MixVolume(audio, channel+i, 0.02)
            check mAudio.MixPlay(audio, channel+i, 0)
         end
         logOutput(f'WASAPI workload: voices={voices}, bands={bands}, '
            .. f'rate={audio.outputRate}, period={audio.periodSize}')
         processing.sleep(0.5) -- Warm-up; diagnostics include warm-up and the sustained interval.
         processing.sleep(2.5)
         if bands > 0 then
            for i in {0 to 20} do
               effect.gain = -(i % 2)
               processing.sleep(0.015)
            end
         end
         check audio.acDeactivate()
      end
   end
end

@Test function SoundCompletionAndReactivation()
   audio <close> = obj.new('Audio', {})
   for i in {0 to 3} do
      check audio.acActivate()
      sound <close> = obj.new('Sound', { audio=audio, path='src/audio/tests/low-tone.wav', volume=0.02 })
      completed = 0
      sound.onStop = function(Sound) completed++ end
      start = mSys.PreciseTime()
      check sound.acActivate()
      deadline = start + 2000000
      while completed is 0 and mSys.PreciseTime() < deadline do processing.sleep(0.005) end
      elapsed = (mSys.PreciseTime() - start) / 1000000
      assert(completed is 1, 'The real endpoint must deliver completion')
      assert(elapsed >= sound.duration, 'Completion must wait for submitted device audio')
      assert(elapsed < sound.duration + 0.2, 'Completion must not retain the old half-buffer delay')
      check audio.acDeactivate()
   end
end
