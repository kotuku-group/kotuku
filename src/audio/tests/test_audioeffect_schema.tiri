   module audio as mAudio

-- Helpers that interpret an AudioEffect schema without knowledge of the effect class.

function attrib(Tag:table, Name:str):any
   for a in values(Tag.attribs) do
      if a.name is Name then return a.value end
   end
   return nil
end

function parse_param(Tag:table):table
   param = { key=attrib(Tag, 'key'), description=attrib(Tag, 'description'), type=attrib(Tag, 'type'),
      default=tonumber(attrib(Tag, 'default')), min=tonumber(attrib(Tag, 'min')), max=attrib(Tag, 'max'),
      options={}, optionDescriptions={}, rules={} }
   for child in values(Tag.children) do
      name = child.attribs[0].name
      if name is 'option' then
         param.options.insert(tonumber(attrib(child, 'value')))
         param.optionDescriptions.insert(attrib(child, 'description') ?? '')
      elseif name is 'rule' then
         values_list = {}
         for v in values(attrib(child, 'values').split(',')) do values_list.insert(tonumber(v)) end
         param.rules.insert({ key=attrib(child, 'key'), values=values_list, max=tonumber(attrib(child, 'max')),
            inactive=attrib(child, 'inactive') is '1' })
      end
   end
   return param
end

function parse_schema(Xml:str):table
   xml = obj.new('xml', { statement=Xml })
   root = xml.tags[0]
   assert(root.attribs[0].name is 'effect', 'The schema root must be an effect element')
   schema = { class=attrib(root, 'class'), description=attrib(root, 'description'), params={}, groups={}, outputs={} }
   for tag in values(root.children) do
      name = tag.attribs[0].name
      if name is 'param' then
         schema.params.insert(parse_param(tag))
      elseif name is 'group' then
         group = { key=attrib(tag, 'key'), description=attrib(tag, 'description'), min=tonumber(attrib(tag, 'min')),
            max=tonumber(attrib(tag, 'max')), members={} }
         for member in values(tag.children) do group.members.insert(parse_param(member)) end
         schema.groups.insert(group)
      elseif name is 'output' then
         schema.outputs.insert(attrib(tag, 'key'))
      end
   end
   return schema
end

-- Choose a valid, non-default value for each member of a parameter set, honouring rules that lower a maximum.

function choose_values(Params:table, Rate:num):table
   chosen = {}
   for p in values(Params) do
      if p.type is 'enum' then
         chosen[p.key] = p.options[#p.options - 1]
      elseif p.type is 'bool' then
         chosen[p.key] = 1 - p.default
      end
   end
   for p in values(Params) do
      if (p.type != 'enum') and (p.type != 'bool') then
         max = (p.max is 'nyquist') ? (Rate * 0.5) : tonumber(p.max)
         for rule in values(p.rules) do
            for v in values(rule.values) do
               if (not rule.inactive) and (chosen[rule.key] is v) and (rule.max < max) then max = rule.max end
            end
         end
         chosen[p.key] = p.min + ((max - p.min) * 0.25)
      end
   end
   return chosen
end

function new_equaliser(Audio:obj):<obj, num>
   err, channel = Audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   return obj.new('AudioEqualiser', { audio=Audio, channel=channel }), channel
end

-----------------------------------------------------------------------------------------------------------------------

@Test function SchemaDrivenModel()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   eq <close> = new_equaliser(audio)
   schema = parse_schema(eq.schema)
   assert(schema.class is 'AudioEqualiser')
   assert(#schema.groups is 1 and schema.outputs[0] is 'response')
   assert(eq.mutable is 1)

   -- Every item carries a description for presentation to the user.

   assert((schema.description ?? '') != '', 'The effect must be described')
   for group in values(schema.groups) do
      assert((group.description ?? '') != '', f'Group {group.key} must be described')
      for m in values(group.members) do
         assert((m.description ?? '') != '', f'{group.key}.{m.key} must be described')
         for i, text in ipairs(m.optionDescriptions) do
            assert(text != '', f'Option {m.options[i]} of {group.key}.{m.key} must be described')
         end
      end
   end
   for p in values(schema.params) do assert((p.description ?? '') != '', f'{p.key} must be described') end

   -- Every group gets one new entry, which reports the published defaults before it is edited.

   inserts = array<str>
   for group in values(schema.groups) do inserts.push(f'insert {group.key} 0') end
   check eq.mtBatch(inserts)
   for group in values(schema.groups) do
      for m in values(group.members) do
         path = f'{group.key}[0].{m.key}'
         err, value_text = eq.acGetKey(path)
         value = tonumber(value_text)
         assert(err is ERR_Okay and value is m.default, f'{path} should default to {m.default}, got {value}')
      end
   end

   -- Top-level parameters report their defaults, then every parameter is changed in a single batch.

   commands = array<str>
   top = choose_values(schema.params, eq.outputRate)
   for p in values(schema.params) do
      err, value_text = eq.acGetKey(p.key)
      value = tonumber(value_text)
      assert(err is ERR_Okay and value is p.default, f'{p.key} should default to {p.default}')
      commands.push(f'set {p.key} {string.format("%.17g", top[p.key])}')
   end
   for group in values(schema.groups) do
      entry = choose_values(group.members, eq.outputRate)
      for m in values(group.members) do
         commands.push(f'set {group.key}[0].{m.key} {string.format("%.17g", entry[m.key])}')
      end
   end
   check eq.mtBatch(commands)

   for p in values(schema.params) do
      err, value_text = eq.acGetKey(p.key)
      value = tonumber(value_text)
      assert(err is ERR_Okay and value is top[p.key], f'{p.key} was not committed')
   end
   for group in values(schema.groups) do
      entry = choose_values(group.members, eq.outputRate)
      for m in values(group.members) do
         err, value_text = eq.acGetKey(f'{group.key}[0].{m.key}')
         value = tonumber(value_text)
         assert(err is ERR_Okay and value is entry[m.key], f'{group.key}[0].{m.key} was not committed')
      end
   end
end

@Test function PathErrors()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   eq <close> = new_equaliser(audio)
   check eq.mtBatch(array<str> { 'insert bands 0' })

   for path in values({ 'unknown', 'bands[0].unknown', 'bands[x].gain', 'bands[].gain', 'bands[-1].gain', 'bands[0]',
      'bands[0]gain', 'bands[0.gain' }) do
      err, failed = eq.mtBatch(array<str> { f'set {path} 1' })
      assert(err is ERR_Search and failed is 0, f'Path {path} must fail with ERR_Search, got {err}')
   end
   assert(eq.mtBatch(array<str> { 'set bands[1].gain 1' }) is ERR_OutOfRange)
   assert(eq.mtBatch(array<str> { 'set gain 49' }) is ERR_InvalidValue)
   assert(eq.mtBatch(array<str> { 'set bands[0].type 9' }) is ERR_InvalidValue)
   assert(eq.mtBatch(array<str> { 'set bands[0].frequency 0' }) is ERR_InvalidValue)
   assert(eq.mtBatch(array<str> { 'set bands[0].frequency 24000' }) is ERR_InvalidValue)
   err, value_text = eq.acGetKey('bands[5].q')
   assert(err is ERR_OutOfRange)
   assert(eq.mtBatch(array<str> { 'insert unknown 0' }) is ERR_Search)
   assert(eq.mtBatch(array<str> { 'insert bands 5' }) is ERR_OutOfRange)
   assert(eq.mtBatch(array<str> { 'remove bands -1' }) is ERR_Syntax)
   assert(eq.mtBatch(array<str> { 'remove bands 1' }) is ERR_OutOfRange)
   assert(eq.mtBatch(array<str> { 'remove unknown 0' }) is ERR_Search)

   -- The group is limited to its published maximum.

   inserts = array<str>
   for i in {1 to 64} do inserts.push(f'insert bands {i}') end
   check eq.mtBatch(inserts)
   assert(#eq.bands is 64)
   err, failed = eq.mtBatch(array<str> { 'set gain 1', 'insert bands 64' })
   assert(err is ERR_OutOfRange and failed is 1)
   assert(#eq.bands is 64 and eq.gain is 0, 'A failed batch must change nothing')

   -- A base AudioEffect publishes no schema.

   err, channel = audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   plain <close> = obj.new('AudioEffect', { audio=audio, channel=channel })
   assert(plain.schema is '' or plain.schema is nil)
   err, failed = plain.mtBatch(array<str> { 'set gain 0' })
   assert(err is ERR_NoSupport and failed is -1)
end

@Test function NumericKeyValues()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   eq <close> = new_equaliser(audio)
   for text in values({ 'abc', '1dB', '+', '+-1', '1e999', 'nan', 'inf', '-inf', '0x10', '1,5' }) do
      err, failed = eq.mtBatch(array<str> { f'set gain {text}' })
      assert(err is ERR_InvalidValue and failed is 0, f'Invalid numeric text {text} must fail, got {err}')
   end
   check eq.mtBatch(array<str> { '  set gain +1.2345678901234567e0  ' })
   err, text = eq.acGetKey('gain')
   assert(err is ERR_Okay and type(text) is 'string')
   assert(tonumber(text) is 1.2345678901234567, 'GetKey must preserve double precision')
   assert(eq.gain is 1.2345678901234567)
   assert(eq.mtBatch(array<str> { 'set gain 2junk' }) is ERR_InvalidValue)
   err, unchanged = eq.acGetKey('gain')
   assert(err is ERR_Okay and unchanged is text, 'Invalid text must leave the value unchanged')
end

@Test function ParameterBounds()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   eq <close> = new_equaliser(audio)

   check eq.mtBatch(array<str> {
      'insert bands 0',
      'set gain -48',
      'set gain 48',
      f'set bands[0].type {EQB_HIGH_PASS}',
      'set bands[0].frequency 0.001',
      'set bands[0].frequency 23999'
   })
   assert(eq.gain is 48 and eq.bands[0].type is EQB_HIGH_PASS)
   assert(eq.bands[0].frequency is 23999)

   assert(eq.mtBatch(array<str> { 'set gain 48.001' }) is ERR_InvalidValue)
   assert(eq.mtBatch(array<str> { f'set gain {math.huge}' }) is ERR_InvalidValue)
   assert(eq.mtBatch(array<str> { 'set bands[0].type 1.5' }) is ERR_InvalidValue)
   assert(eq.mtBatch(array<str> { f'set bands[0].frequency {math.sqrt(-1)}' }) is ERR_InvalidValue)
   assert(eq.gain is 48 and eq.bands[0].frequency is 23999)

   low_rate <close> = obj.new('Audio', { device='null', outputRate=1600 })
   low_eq <close> = new_equaliser(low_rate)
   check low_eq.mtBatch(array<str> { 'insert bands 0' })
   err, frequency_text = low_eq.acGetKey('bands[0].frequency')
   frequency = tonumber(frequency_text)
   assert(err is ERR_Okay and frequency is 400, 'A default frequency must fit below the Nyquist limit')
end

@Test function AtomicChanges()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   eq <close> = new_equaliser(audio)
   err, failed = eq.mtBatch(array<str> { })
   assert(err is ERR_Okay and failed is -1, 'An empty batch must succeed')

   check eq.mtBatch(array<str> { 'insert bands 0', 'set bands[0].q 5' })
   assert(#eq.bands is 1 and eq.bands[0].q is 5)

   -- Field writes are never refused because of an earlier batch.

   eq.gain = -1
   assert(eq.gain is -1)

   -- Switching a Q 5 peak to a shelf only passes if the Q changes in the same batch.

   err, failed = eq.mtBatch(array<str> { 'set bands[0].type low_shelf' })
   assert(err is ERR_InvalidValue and failed is -1, 'A rule violation must not name a command')
   assert(eq.bands[0].type is EQB_PEAK and eq.bands[0].q is 5, 'A failed batch must leave the effect unchanged')
   err, value_text = eq.acGetKey('bands[0].type')
   assert(tonumber(value_text) is EQB_PEAK, 'GetKey() must report the committed value')

   check eq.mtBatch(array<str> { 'set bands[0].type low_shelf', 'set bands[0].q 0.7' })
   assert(eq.bands[0].type is EQB_LOW_SHELF and eq.bands[0].q is 0.7)

   -- Paths follow the working copy after insertion and removal.

   check eq.mtBatch(array<str> { 'insert bands 0', 'set bands[0].frequency 250', 'remove bands 1' })
   assert(#eq.bands is 1 and eq.bands[0].type is EQB_PEAK and eq.bands[0].frequency is 250)
end

@Test function PreInitialisation()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   err, channel = audio.mtOpenChannels(1)
   assert(err is ERR_Okay)

   -- Before initialisation, changes apply directly and Init() validates the rules.

   eq = audio.new('AudioEqualiser')
   eq.channel = channel
   check eq.mtBatch(array<str> { 'insert bands 0', 'set bands[0].frequency 120' })
   assert(#eq.bands is 1 and eq.bands[0].frequency is 120)
   eq.init()
   assert(eq.bands[0].frequency is 120)

   bad = audio.new('AudioEqualiser')
   bad.channel = channel
   check bad.mtBatch(array<str> { 'insert bands 0', f'set bands[0].type {EQB_HIGH_SHELF}', 'set bands[0].q 3' })
   try
      bad.init()
   except e
      assert(e.code is ERR_InvalidValue, f'Expected ERR_InvalidValue, got {e.code}')
   success
      raise 'Init() must reject a shelf with Q above one'
   end
end

@Test function ResponseCurve()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   eq <close> = new_equaliser(audio)
   check eq.mtBatch(array<str> { 'insert bands 0', 'set bands[0].gain 6', 'set bands[0].q 1' })
   eq.gain = -2

   frequencies = array<double> { 20, 1000, 20000 }
   magnitudes = array<double, 3>
   check eq.mtGetResponse(frequencies, magnitudes)
   assert(math.abs(magnitudes[1] - 4) < 0.001, f'Expected 4 dB at the centre, got {magnitudes[1]}')
   assert(math.abs(magnitudes[0] + 2) < 0.05)

   -- A rejected batch does not change the response.

   assert(eq.mtBatch(array<str> { 'set bands[0].gain -6', 'set bands[0].q 99' }) is ERR_InvalidValue)
   check eq.mtGetResponse(frequencies, magnitudes)
   assert(math.abs(magnitudes[1] - 4) < 0.001)

   assert(eq.mtGetResponse(frequencies, array<double, 2>) is ERR_Args)
   assert(eq.mtGetResponse(array<double, 0>, array<double, 0>) is ERR_Args)
   assert(eq.mtGetResponse(array<double> { 0 }, array<double, 1>) is ERR_InvalidValue)
   assert(eq.mtGetResponse(array<double> { 24000 }, array<double, 1>) is ERR_InvalidValue)

   err, channel = audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   plain <close> = obj.new('AudioEffect', { audio=audio, channel=channel })
   assert(plain.mtGetResponse(frequencies, magnitudes) is ERR_NoSupport)
end

@Test function GroupCounts()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   eq <close> = new_equaliser(audio)
   err, count = eq.mtGetGroupCount('bands')
   assert(err is ERR_Okay and count is 0)
   assert(eq.mtGetGroupCount('missing') is ERR_Search)

   check eq.mtBatch(array<str> { 'insert bands 0' })
   _, count = check eq.mtGetGroupCount('bands')
   assert(count is 1 and #eq.bands is 1)

   -- A rejected batch leaves the committed count unchanged.

   err, failed = eq.mtBatch(array<str> { 'remove bands 0', 'insert bands 0', 'set bands[0].type low_shelf',
      'set bands[0].q 5', 'insert bands 1' })
   assert(err is ERR_InvalidValue and failed is -1)
   _, count = check eq.mtGetGroupCount('bands')
   assert(count is 1, 'Rejected changes must leave the committed count')

   check audio.mtCloseChannels(eq.channel)
   _, count = check eq.mtGetGroupCount('bands')
   assert(count is 1, 'Disconnected effects retain their parameters')

   uninitialised <close> = obj.new('AudioEqualiser')
   check uninitialised.mtBatch(array<str> { 'insert bands 0' })
   _, count = check uninitialised.mtGetGroupCount('bands')
   assert(count is 1, 'Counts must work before initialisation')
   plain <close> = obj.new('AudioEffect')
   assert(plain.mtGetGroupCount('bands') is ERR_NoSupport)
end
