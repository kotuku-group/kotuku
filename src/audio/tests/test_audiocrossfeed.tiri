-- AudioCrossfeed: schema, validation, staged changes, live processing measured through the peak meters, mono, global
-- immutability, tail draining and unsupported rates.  The null device is unpaced, so live tests play a looping tone
-- and poll until a reading reflects the latest settings.

@if(exists='modules:audio')

   module audio as mAudio

@BeforeAll function init(State)
   global glFolder = State.folder
end

-- Published parameters in schema order, with their defaults, units and scales.

PARAMS = {
   { key='amount', default=20, unit='%', scale='linear', min=0, max=50 },
   { key='cutoff', default=700, unit='Hz', scale='log', min=100, max=2000 },
   { key='delay', default=0.3, unit='ms', scale='linear', min=0, max=1 },
   { key='gain', default=0, unit='dB', scale='linear', min=-12, max=12 }
}

FLOOR = -120
RATE = 48000
FREQUENCY = 1000

-- The level of the crossfed term relative to the input, in dB: the amount, the bilinear first-order low-pass and the
-- linear interpolation of a fractional delay, at the tone frequency.

function cross_db(Amount:num, Cutoff:num, Delay:num):num
   a = Amount / 100
   ratio = math.tan(math.pi * FREQUENCY / RATE) / math.tan(math.pi * Cutoff / RATE)
   filter = 1 / math.sqrt(1 + (ratio * ratio))
   frames = Delay * RATE / 1000
   fraction = frames - math.floor(frames)
   omega = 2 * math.pi * FREQUENCY / RATE
   interpolation = math.sqrt(1 - (2 * fraction * (1 - fraction) * (1 - math.cos(omega))))
   return 20 * math.log10(a / (1 + a) * filter * interpolation)
end

function direct_db(Amount:num):num
   return -20 * math.log10(1 + (Amount / 100))
end

-- A looping 1 kHz sine at half of full scale.  4410 frames at 44.1 kHz hold exactly 100 cycles, so it loops seamlessly.

function tone_sample(Audio:obj):num
   frames = 4410
   data = array<byte, 8820>
   for i in {0 to frames} do
      value = math.floor(16384 * math.sin(2 * math.pi * 1000 * i / 44100))
      if value < 0 then value += 65536 end
      data[i * 2] = value & 0xff
      data[(i * 2) + 1] = (value >> 8) & 0xff
   end
   format = struct.new('AudioFormat', { sampleRate=44100, sampleFormat=ASF_S16, layout=array<int> { SPK_CENTRE } })
   loop = struct.new('AudioLoop', { loopMode=LOOP_SINGLE, loop1Type=LTYPE_UNIDIRECTIONAL, loop1Start=0,
      loop1End=frames * 2 })
   err, sample = Audio.mtAddSample(nil, format, data, loop)
   assert(err is ERR_Okay, f'AddSample() failed: {err}')
   return sample
end

-- Play the tone in the left channel only, so that the right output carries only the crossfed signal.

function play_left(Audio:obj, Channel:num)
   check mAudio.MixSample(Audio, Channel, tone_sample(Audio))
   check mAudio.MixFrequency(Audio, Channel, 44100)
   check mAudio.MixVolume(Audio, Channel, 1)
   check mAudio.MixPan(Audio, Channel, -1)
   check mAudio.MixPlay(Audio, Channel, 0)
end

function new_crossfeed(Audio:obj):<obj, num>
   err, channel = Audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   return obj.new('AudioCrossfeed', { audio=Audio, channel=channel }), channel
end

function get_number(Effect:obj, Key:str):<num>
   err, text = Effect.acGetKey(Key)
   assert(err is ERR_Okay, f'GetKey({Key}) must succeed')
   return tonumber(text)
end

function configure(Effect:obj, Values:table)
   for key, value in pairs(Values) do check Effect.acSetKey(key, value) end
   check Effect.acFlush()
end

-- Poll until a valid meter reading has the expected output levels relative to the left input peak, within 0.25 dB.
-- An expected level of FLOOR requires the floor exactly.

function await_levels(Effect:obj, Left:num, Right:num, Description:str)
   err, layout = Effect.mtGetMeterLayout()
   assert(err is ERR_Okay)
   meters = { }
   near = function(Value, Expected, Input)
      if Expected is FLOOR then return Value is FLOOR end
      return math.abs(Value - (Input + Expected)) < 0.25
   end
   for attempt in {0 to 300} do
      err, reading = Effect.mtReadMeters()
      assert(err is ERR_Okay)
      if (reading.flags has AMF_VALID) and (reading.id is layout.id) then
         for i in {0 to #layout.meters} do meters[layout.meters[i].key] = reading.values[i].value end
         reference = meters.input_peak_left
         if (reference > -20) and (meters.input_peak_right is FLOOR) and
            near(meters.output_peak_left, Left, reference) and near(meters.output_peak_right, Right, reference) then
            return
         end
      end
      processing.sleep(0.01)
   end
   assert(false, f'{Description}: expected {Left} / {Right} dB relative to the input, got input ' ..
      f'{meters.input_peak_left}, output {meters.output_peak_left} / {meters.output_peak_right}')
end

function wait_for_stop(Count:table, Seconds:num)
   deadline = mSys.PreciseTime() + (Seconds * 1000000)
   while (Count.stops is 0) and (mSys.PreciseTime() < deadline) do processing.sleep(0.01) end
end

-----------------------------------------------------------------------------------------------------------------------

@Test function SchemaDiscovery()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   crossfeed <close> = new_crossfeed(audio)
   schema = crossfeed.schema
   assert(schema.find('<effect class="AudioCrossfeed" version="1"') != nil, 'The schema must identify the class')
   assert(schema.find('<group') is nil, 'The effect has no parameter groups')
   assert(schema.find('<rule ') is nil, 'No parameter carries a rule')
   assert(schema.find('type="enum"') is nil, 'The effect has no enumerated parameters')
   assert(schema.find('type="curve"') is nil, 'The effect does not publish a response curve')
   assert(schema.find('gain_reduction') is nil, 'The effect does not publish gain reduction')
   for p in values(PARAMS) do
      assert(schema.find(f'<param key="{p.key}"') != nil, f'{p.key} must be published')
      text = f'type="double" unit="{p.unit}" scale="{p.scale}" min="{p.min}" max="{p.max}" default="{p.default}"'
      assert(schema.find(text) != nil, f'{p.key} must publish its type, unit, scale, range and default')
      value = get_number(crossfeed, p.key)
      assert(value is p.default, f'{p.key} should default to {p.default}, got {value}')
   end

   last = 0
   for p in values(PARAMS) do
      position = schema.find(f'<param key="{p.key}"')
      assert(position > last, f'{p.key} is out of order')
      last = position
   end

   assert(schema.find('key="input_peak_left" type="scalar"') != nil)
   assert(schema.find('key="output_peak_right" type="scalar"') != nil)
   assert(crossfeed.mtGetOutput('response') is ERR_Search)
end

@Test function StagedChangesAndValidation()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   crossfeed <close> = new_crossfeed(audio)
   assert(crossfeed.mutable is 1)

   for p in values(PARAMS) do
      check crossfeed.acSetKey(p.key, p.min)
      check crossfeed.acSetKey(p.key, p.max)
      assert(crossfeed.acSetKey(p.key, p.min - 0.001) is ERR_InvalidValue, f'{p.key} below {p.min} must fail')
      assert(crossfeed.acSetKey(p.key, p.max + 0.001) is ERR_InvalidValue, f'{p.key} above {p.max} must fail')
      assert(crossfeed.acSetKey(p.key, math.huge) is ERR_InvalidValue, f'{p.key} must reject infinity')
      assert(crossfeed.acSetKey(p.key, math.sqrt(-1)) is ERR_InvalidValue, f'{p.key} must reject NaN')
   end
   assert(crossfeed.acSetKey('unknown', 1) is ERR_Search)
   check crossfeed.acFlush()

   -- Staged values are readable before Flush(); a rejected value leaves earlier staged changes intact.

   check crossfeed.acSetKey('amount', 37.5)
   check crossfeed.acSetKey('delay', 0.0625)
   assert(crossfeed.acSetKey('cutoff', 99) is ERR_InvalidValue)
   check crossfeed.acSetKey('cutoff', 455.5)
   assert(get_number(crossfeed, 'cutoff') is 455.5, 'Staged values must be readable')
   check crossfeed.acFlush()
   for key, expected in pairs({ amount=37.5, delay=0.0625, cutoff=455.5, gain=12 }) do
      value = get_number(crossfeed, key)
      assert(value is expected, f'{key} should be {expected} after Flush(), got {value}')
   end
end

@Test function ConfigureBeforeInit()
   audio <close> = obj.new('Audio', { device='null', outputRate=44100 })
   err, channel = audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   crossfeed <close> = obj.new('AudioCrossfeed')
   crossfeed.audio = audio
   crossfeed.channel = channel
   check crossfeed.acSetKey('amount', 45)
   check crossfeed.acSetKey('cutoff', 250)
   assert(crossfeed.acSetKey('gain', 13) is ERR_InvalidValue)
   crossfeed.init()
   for key, expected in pairs({ amount=45, cutoff=250, delay=0.3, gain=0 }) do
      value = get_number(crossfeed, key)
      assert(value is expected, f'{key} should be {expected}, got {value}')
   end
end

-- Each setting is verified from the output peaks of a left-only tone, relative to its input peak.

@Test function LiveProcessing()
   audio <close> = obj.new('Audio', { device='null', outputRate=RATE })
   crossfeed, channel = new_crossfeed(audio)
   check audio.acActivate()
   assert(crossfeed.latency is 0, 'The effect has no latency')
   err, rate, format, layout = crossfeed.mtGetProcessingFormat()
   assert(err is ERR_Okay and rate is RATE and #layout is 2)
   play_left(audio, channel)

   await_levels(crossfeed, direct_db(20), cross_db(20, 700, 0.3), 'Defaults crossfeed the filtered left channel')

   configure(crossfeed, { amount=0 })
   await_levels(crossfeed, 0, FLOOR, 'Zero amount passes the input unchanged')

   configure(crossfeed, { amount=50, cutoff=2000, delay=0 })
   await_levels(crossfeed, direct_db(50), cross_db(50, 2000, 0), 'The maximum amount with a high cutoff')

   configure(crossfeed, { cutoff=100 })
   await_levels(crossfeed, direct_db(50), cross_db(50, 100, 0), 'A low cutoff attenuates the crossfed tone')

   configure(crossfeed, { amount=0, gain=-6 })
   await_levels(crossfeed, -6, FLOOR, 'Gain trims the output')

   err, meter_layout = crossfeed.mtGetMeterLayout()
   assert(err is ERR_Okay and #meter_layout.meters is 4)
   assert(meter_layout.meters[0].key is 'input_peak_left' and meter_layout.meters[3].key is 'output_peak_right')

   crossfeed.flags = AEF_BYPASS
   err, reading = crossfeed.mtReadMeters()
   assert(err is ERR_Okay and reading.flags is AMF_BYPASSED)
   crossfeed.flags = 0

   check audio.mtCloseChannels(channel)
   err, reading = crossfeed.mtReadMeters()
   assert(err is ERR_Okay and reading.flags is AMF_DISCONNECTED)
   assert(crossfeed.acSetKey('amount', 10) is ERR_NotInitialised)
   crossfeed.free()
end

@Test function MonoAndGlobalImmutability()
   audio <close> = obj.new('Audio', { device='null', outputRate=44100, outputLayout=array<int> { SPK_CENTRE } })
   crossfeed = audio.new('AudioCrossfeed')
   check crossfeed.acSetKey('amount', 50)
   check crossfeed.acSetKey('gain', -3)
   crossfeed.init()
   assert(crossfeed.mutable is 0)
   assert(crossfeed.acSetKey('amount', 10) is ERR_Immutable)
   assert(get_number(crossfeed, 'amount') is 50, 'Global settings are retained')
   check audio.acActivate()
   err, layout = crossfeed.mtGetMeterLayout()
   assert(err is ERR_Okay and #layout.meters is 2)
   assert(layout.meters[0].key is 'input_peak_centre' and layout.meters[1].key is 'output_peak_centre')
   check audio.acDeactivate()
end

-- OnStop waits for the crossfed tail to drain when a panned Sound plays through the slowest setting.

@Test function SoundStopWaitsForTail()
   audio <close> = obj.new('Audio', { device='null' })
   check audio.acActivate()
   count = { stops=0 }
   state_at_stop = -1
   sound <close> = obj.new('Sound', { audio=audio, path=glFolder .. 'low-tone.wav', pan=-1,
      onStop=function(Sound)
         count.stops++
         err, _, _, _, _, _, state = audio.mtGetEffectStatus(Sound.channelIndex & 0xffff0000)
         state_at_stop = state
      end })
   crossfeed <close> = obj.new('AudioCrossfeed', { audio=audio, channel=sound.channelIndex & 0xffff0000 })
   configure(crossfeed, { amount=50, cutoff=100, delay=1 })
   check sound.acActivate()
   wait_for_stop(count, 20)
   assert(count.stops is 1, 'OnStop must be delivered once')
   assert(state_at_stop is ADS_IDLE, f'The crossfeed must have drained before OnStop, state {state_at_stop}')
   check audio.acDeactivate()
end

-- Destroying the effect while its channel set is playing leaves the Sound to finish normally.

@Test function DestroyDuringPlayback()
   audio <close> = obj.new('Audio', { device='null' })
   check audio.acActivate()
   count = { stops=0 }
   sound <close> = obj.new('Sound', { audio=audio, path=glFolder .. 'low-tone.wav', pan=-1,
      onStop=function(Sound) count.stops++ end })
   crossfeed = obj.new('AudioCrossfeed', { audio=audio, channel=sound.channelIndex & 0xffff0000 })
   configure(crossfeed, { amount=50, delay=1 })
   check sound.acActivate()
   processing.sleep(0.05)
   crossfeed.free()
   wait_for_stop(count, 20)
   assert(count.stops is 1, 'OnStop must be delivered once after the effect is destroyed')
   check audio.acDeactivate()
end

@Test function UnsupportedRate()
   audio <close> = obj.new('Audio', { device='null', outputRate=4000 })
   err, channel = audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   try
      crossfeed = obj.new('AudioCrossfeed', { audio=audio, channel=channel })
   except e when ERR_NoSupport
   success
      raise 'An output rate below 8000 Hz must be rejected'
   end
end

@end
