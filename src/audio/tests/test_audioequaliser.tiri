
@if(exists='modules:audio')

   module audio as mAudio

function u8_mono()
   return struct.new('AudioFormat', { sampleRate=44100, sampleFormat=ASF_U8, layout=array<int> { SPK_CENTRE } })
end

function set_band(Eq:obj, Index:num, Type:num, Frequency:num, Gain:num, Q:num)
   check Eq.acSetKey(f'bands[{Index}].type', Type)
   check Eq.acSetKey(f'bands[{Index}].frequency', Frequency)
   check Eq.acSetKey(f'bands[{Index}].gain', Gain)
   check Eq.acSetKey(f'bands[{Index}].q', Q)
end

@Test function BandsAndLiveChanges()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   err, channel = audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   eq <close> = obj.new('AudioEqualiser', { audio=audio, channel=channel, gain=-2 })
   assert(eq.outputRate is 48000 and eq.gain is -2)
   check eq.mtInsertEntry('bands', 0)
   check eq.mtInsertEntry('bands', 1)
   set_band(eq, 0, EQB_LOW_SHELF, 100, 4, 0.7)
   set_band(eq, 1, EQB_PEAK, 3000, -2, 1.2)
   check eq.acFlush()
   assert(#eq.bands is 2 and eq.bands[0].frequency is 100)
   set_band(eq, 0, EQB_HIGH_PASS, 40, 0, 0.7)
   check eq.acFlush()
   assert(eq.bands[0].type is EQB_HIGH_PASS)
   eq.gain = -3
   check eq.mtRemoveEntry('bands', 1)
   check eq.acFlush()
   assert(#eq.bands is 1 and eq.gain is -3)
   eq.flags = AEF_BYPASS
   eq.flags = 0
   check audio.acActivate()
   data = array<byte, 4096>
   data.fill(128)
   err, sample = audio.mtAddSample(nil, u8_mono(), data, nil)
   assert(err is ERR_Okay)
   check mAudio.MixSample(audio, channel, sample)
   check mAudio.MixFrequency(audio, channel, 44100)
   check mAudio.MixPlay(audio, channel, 0)
   set_band(eq, 0, EQB_LOW_PASS, 8000, 0, 0.7)
   check eq.acFlush()
   check audio.mtCloseChannels(channel)
   assert(eq.acSetKey('bands[0].frequency', 500) is ERR_NotInitialised)
end

@Test function LoudnessCompensation()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   err, channel = audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   eq <close> = obj.new('AudioEqualiser', { audio=audio, channel=channel })
   check eq.mtInsertEntry('bands', 0)
   set_band(eq, 0, EQB_PEAK, 3000, -4, 1)
   check eq.acFlush()

   frequencies = array<double> { 20, 50, 1000, 3000, 12500 }
   plain = array<double, 5>
   check eq.mtGetResponse(frequencies, plain)

   -- The listening level is ignored while compensation is off, so the response is unchanged.

   err, value_text = eq.acGetKey('listening_level')
   value = tonumber(value_text)
   assert(err is ERR_Okay and value is -20, 'The listening level defaults to -20 dB')
   check eq.acSetKey('listening_level', -40)
   check eq.acFlush()
   magnitudes = array<double, 5>
   check eq.mtGetResponse(frequencies, magnitudes)
   for i in {0 to 5} do assert(magnitudes[i] is plain[i], 'Disabled compensation must not alter the response') end

   -- Enabling compensation boosts bass and treble relative to 1 kHz, after the bands.

   check eq.acSetKey('loudness', 1)
   check eq.acFlush()
   check eq.mtGetResponse(frequencies, magnitudes)
   assert(magnitudes[0] - plain[0] > 15, f'Expected a bass boost at -40 dB, got {magnitudes[0] - plain[0]}')
   assert(math.abs(magnitudes[2] - plain[2]) < 1, 'Compensation is nearly flat at 1 kHz')
   assert(magnitudes[4] - plain[4] > 3, 'Expected a treble boost at 12.5 kHz')
   assert(magnitudes[3] < magnitudes[2], 'The band remains in the response')

   -- Lower listening levels receive more compensation, and the reference level is flat.

   bass_at_40 = magnitudes[0] - plain[0]
   check eq.acSetKey('listening_level', -60)
   check eq.acFlush()
   check eq.mtGetResponse(frequencies, magnitudes)
   assert(magnitudes[0] - plain[0] > bass_at_40)
   check eq.acSetKey('listening_level', 0)
   check eq.acFlush()
   check eq.mtGetResponse(frequencies, magnitudes)
   for i in {0 to 5} do
      assert(math.abs(magnitudes[i] - plain[i]) < 1e-9, 'Compensation is flat at the reference level')
   end

   assert(eq.acSetKey('listening_level', -61) is ERR_InvalidValue)
   assert(eq.acSetKey('listening_level', 1) is ERR_InvalidValue)
   assert(eq.acSetKey('loudness', 0.5) is ERR_InvalidValue)

   -- Live edits while playing exercise the crossfaded transitions.

   check eq.acSetKey('listening_level', -30)
   check eq.acFlush()
   check audio.acActivate()
   data = array<byte, 4096>
   data.fill(128)
   err, sample = audio.mtAddSample(nil, u8_mono(), data, nil)
   assert(err is ERR_Okay)
   check mAudio.MixSample(audio, channel, sample)
   check mAudio.MixFrequency(audio, channel, 44100)
   check mAudio.MixPlay(audio, channel, 0)
   check eq.acSetKey('listening_level', -50)
   check eq.acFlush()
   check eq.acSetKey('loudness', 0)
   check eq.acFlush()
   err, value_text = eq.acGetKey('loudness')
   value = tonumber(value_text)
   assert(err is ERR_Okay and value is 0)
   check audio.mtCloseChannels(channel)
end

@Test function LoudnessSchema()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   err, channel = audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   eq <close> = obj.new('AudioEqualiser', { audio=audio, channel=channel })
   schema = eq.schema
   assert(schema.find('<effect class="AudioEqualiser" version="2"') != nil, 'The equaliser schema is version 2')
   assert(schema.find('<param key="loudness" label="Loudness"') != nil, 'loudness must be published')
   assert(schema.find('<rule key="loudness" values="0" inactive="1"/>') != nil,
      'listening_level is inactive while loudness is off')
end

@Test function BandListAndGlobalImmutability()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   eq = audio.new('AudioEqualiser')
   eq.bands = array<struct<AudioEQBand>> {
      struct.new('AudioEQBand', { type=EQB_LOW_SHELF, frequency=100, gain=3, q=0.7 }),
      struct.new('AudioEQBand', { type=EQB_HIGH_SHELF, frequency=10000, gain=-1, q=0.7 })
   }
   eq.gain = -2
   assert(eq.mutable is 1)
   eq.init()
   assert(#eq.bands is 2)
   assert(eq.mutable is 0)
   assert(eq.acSetKey('bands[0].gain', 2) is ERR_Immutable)
   assert(eq.mtInsertEntry('bands', 0) is ERR_Immutable)
   assert(eq.mtRemoveEntry('bands', 0) is ERR_Immutable)
   err, value_text = eq.acGetKey('bands[0].frequency')
   value = tonumber(value_text)
   assert(err is ERR_Okay and value is 100, 'Global effects remain readable')
   check eq.acFlush()
   try
      eq.gain = 0
   except e when ERR_Immutable
   success
      raise 'Global gain must be immutable'
   end
   try
      eq.bands = array<struct<AudioEQBand>, 0>
   except e when ERR_Immutable
   success
      raise 'Global bands must be immutable'
   end
end

@end
