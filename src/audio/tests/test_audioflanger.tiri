@if(exists='modules:audio')

   module audio as mAudio

@BeforeAll function init(State)
   global glFolder = State.folder
end

-- Published parameters in schema order, with their defaults, units and scales.

PARAMS = {
   { key='rate', default=0.25, unit='Hz', scale='log', min=0.02, max=10 },
   { key='delay', default=1, unit='ms', scale='log', min=0.1, max=5 },
   { key='depth', default=2, unit='ms', scale='linear', min=0, max=10 },
   { key='feedback', default=30, unit='%', scale='linear', min=-90, max=90 },
   { key='mix', default=50, unit='%', scale='linear', min=0, max=100 }
}

function u8_mono()
   return struct.new('AudioFormat', { sampleRate=44100, sampleFormat=ASF_U8, layout=array<int> { SPK_CENTRE } })
end

function new_flanger(Audio:obj):<obj, num>
   err, channel = Audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   return obj.new('AudioFlanger', { audio=Audio, channel=channel }), channel
end

function play_square(Audio:obj, Channel:num)
   data = array<byte, 8192>
   for i in {0 to 8192} do data[i] = (i % 64 < 32) ? 160 : 96 end
   err, sample = Audio.mtAddSample(nil, u8_mono(), data, nil)
   assert(err is ERR_Okay)
   check mAudio.MixSample(Audio, Channel, sample)
   check mAudio.MixFrequency(Audio, Channel, 44100)
   check mAudio.MixPlay(Audio, Channel, 0)
end

function wait_for_stop(Count:table, Seconds:num)
   deadline = mSys.PreciseTime() + (Seconds * 1000000)
   while (Count.stops is 0) and (mSys.PreciseTime() < deadline) do processing.sleep(0.01) end
end

function wait_for_idle(Audio:obj, Set:num):<num, num>
   state, truncated = -1, 0
   deadline = mSys.PreciseTime() + 5000000
   while mSys.PreciseTime() < deadline do
      err, _, _, _, _, _, state, truncated = Audio.mtGetEffectStatus(Set)
      assert(err is ERR_Okay)
      if state is ADS_IDLE then break end
      processing.sleep(0.01)
   end
   return state, truncated
end

-----------------------------------------------------------------------------------------------------------------------

@Test function SchemaDiscovery()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   flanger <close> = new_flanger(audio)
   schema = flanger.schema
   assert(schema.find('<effect class="AudioFlanger" version="1"') != nil, 'The schema must identify the class')
   assert(schema.find('<group') is nil, 'The flanger has no parameter groups')
   assert(schema.find('type="enum"') is nil, 'The flanger has no enumerated parameters')
   assert(schema.find('type="curve"') is nil, 'The flanger does not publish a response curve')
   assert(schema.find('gain_reduction') is nil, 'The flanger does not publish gain reduction')
   for p in values(PARAMS) do
      assert(schema.find(f'<param key="{p.key}"') != nil, f'{p.key} must be published')
      assert(schema.find(f'unit="{p.unit}" scale="{p.scale}" min="{p.min}" max="{p.max}" default="{p.default}"') != nil,
         f'{p.key} must publish its unit, scale, range and default')
      err, value_text = flanger.acGetKey(p.key)
      value = tonumber(value_text)
      assert(err is ERR_Okay and value is p.default, f'{p.key} should default to {p.default}, got {value}')
   end

   -- Parameters appear in the documented order.

   last = 0
   for p in values(PARAMS) do
      position = schema.find(f'<param key="{p.key}"')
      assert(position > last, f'{p.key} is out of order')
      last = position
   end

   assert(schema.find('key="input_peak_left" type="scalar"') != nil)
   assert(schema.find('key="output_peak_right" type="scalar"') != nil)
   assert(schema.find('unit="dBFS" scope="channel"') != nil)
   assert(schema.find('key="spread"') is nil, 'Both channels share the oscillator, so there is no spread control')
   assert(flanger.mtGetOutput('response') is ERR_Search)
end

@Test function StagedChangesAndValidation()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   flanger <close> = new_flanger(audio)
   assert(flanger.mutable is 1)

   -- Every bound is inclusive; values outside it and non-finite values are rejected immediately.

   for p in values(PARAMS) do
      check flanger.acSetKey(p.key, p.min)
      check flanger.acSetKey(p.key, p.max)
      assert(flanger.acSetKey(p.key, p.min - 0.001) is ERR_InvalidValue, f'{p.key} below {p.min} must fail')
      assert(flanger.acSetKey(p.key, p.max + 0.001) is ERR_InvalidValue, f'{p.key} above {p.max} must fail')
      assert(flanger.acSetKey(p.key, math.huge) is ERR_InvalidValue, f'{p.key} must reject infinity')
      assert(flanger.acSetKey(p.key, -math.huge) is ERR_InvalidValue, f'{p.key} must reject -infinity')
      assert(flanger.acSetKey(p.key, math.sqrt(-1)) is ERR_InvalidValue, f'{p.key} must reject NaN')
   end
   assert(flanger.acSetKey('unknown', 1) is ERR_Search)
   check flanger.acFlush()

   -- Staged values are readable before Flush(); a rejected value leaves earlier staged changes intact, and Flush()
   -- commits them together.  Fractional and negative values are kept.

   check flanger.acSetKey('rate', 1.25)
   check flanger.acSetKey('delay', 2.5)
   check flanger.acSetKey('depth', 4.75)
   assert(flanger.acSetKey('feedback', -91) is ERR_InvalidValue)
   check flanger.acSetKey('feedback', -62.5)
   err, value_text = flanger.acGetKey('feedback')
   value = tonumber(value_text)
   assert(err is ERR_Okay and value is -62.5, 'Staged values must be readable')
   check flanger.acFlush()
   for key, expected in pairs({ rate=1.25, delay=2.5, depth=4.75, feedback=-62.5, mix=100 }) do
      err, value_text = flanger.acGetKey(key)
      value = tonumber(value_text)
      assert(err is ERR_Okay and value is expected, f'{key} should be {expected} after Flush(), got {value}')
   end
end

@Test function ConfigureBeforeInit()
   audio <close> = obj.new('Audio', { device='null', outputRate=44100 })
   err, channel = audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   flanger <close> = obj.new('AudioFlanger')
   flanger.audio = audio
   flanger.channel = channel
   check flanger.acSetKey('delay', 3)
   check flanger.acSetKey('feedback', -80)
   assert(flanger.acSetKey('depth', 10.5) is ERR_InvalidValue)
   flanger.init()
   for key, expected in pairs({ delay=3, feedback=-80, depth=2 }) do
      err, value_text = flanger.acGetKey(key)
      value = tonumber(value_text)
      assert(err is ERR_Okay and value is expected, f'{key} should be {expected}, got {value}')
   end
end

@Test function LivePlayback()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   flanger, channel = new_flanger(audio)
   check flanger.acSetKey('mix', 100)
   check flanger.acFlush()
   check audio.acActivate()
   assert(flanger.latency is 0, 'The flanger publishes no algorithmic latency, even when fully wet')
   err, rate, format, layout, generation, state = flanger.mtGetProcessingFormat()
   assert(err is ERR_Okay and rate is 48000 and #layout is 2)

   play_square(audio, channel)

   -- Simultaneous rate, depth and feedback edits with a delay crossfade, then a queued delay edit.

   check flanger.acSetKey('delay', 4.5)
   check flanger.acSetKey('rate', 9)
   check flanger.acSetKey('depth', 10)
   check flanger.acSetKey('feedback', -90)
   check flanger.acFlush()
   check flanger.acSetKey('delay', 0.2)
   check flanger.acSetKey('mix', 0)
   check flanger.acFlush()
   assert(flanger.latency is 0, 'Parameter changes must not alter the latency')

   err, layout = flanger.mtGetMeterLayout()
   assert(err is ERR_Okay and #layout.meters is 4)
   assert(layout.meters[0].key is 'input_peak_left' and layout.meters[3].key is 'output_peak_right')

   flanger.flags = AEF_BYPASS
   err, reading = flanger.mtReadMeters()
   assert(err is ERR_Okay and reading.flags is AMF_BYPASSED)
   flanger.flags = 0

   check audio.mtCloseChannels(channel)
   err, reading = flanger.mtReadMeters()
   assert(err is ERR_Okay and reading.flags is AMF_DISCONNECTED)
   assert(flanger.acSetKey('mix', 50) is ERR_NotInitialised)
   flanger.free()
end

@Test function MonoAndGlobalImmutability()
   audio <close> = obj.new('Audio', { device='null', outputRate=44100, outputLayout=array<int> { SPK_CENTRE } })
   flanger = audio.new('AudioFlanger')
   check flanger.acSetKey('feedback', -45)
   check flanger.acSetKey('delay', 0.5)
   flanger.init()
   assert(flanger.mutable is 0)
   assert(flanger.acSetKey('delay', 2) is ERR_Immutable)
   err, value_text = flanger.acGetKey('feedback')
   value = tonumber(value_text)
   assert(err is ERR_Okay and value is -45, 'Global settings are retained')
   check audio.acActivate()
   err, layout = flanger.mtGetMeterLayout()
   assert(err is ERR_Okay and #layout.meters is 2)
   assert(layout.meters[0].key is 'input_peak_centre' and layout.meters[1].key is 'output_peak_centre')
   assert(flanger.schema.find('input_peak_right') is nil, 'Mono must not publish a right channel')
   check audio.acDeactivate()
end

-- OnStop is held until the recirculating audio has drained from the Sound's channel set, at either feedback sign.

@Test function SoundStopWaitsForTail()
   for feedback in values({ 90, -90 }) do
      audio <close> = obj.new('Audio', { device='null' })
      check audio.acActivate()
      count = { stops=0 }
      state_at_stop = -1
      sound <close> = obj.new('Sound', { audio=audio, path=glFolder .. 'low-tone.wav',
         onStop=function(Sound)
            count.stops++
            err, _, _, _, _, _, state = audio.mtGetEffectStatus(Sound.channelIndex & 0xffff0000)
            state_at_stop = state
         end })
      flanger <close> = obj.new('AudioFlanger', { audio=audio, channel=sound.channelIndex & 0xffff0000 })
      check flanger.acSetKey('delay', 5)
      check flanger.acSetKey('depth', 10)
      check flanger.acSetKey('feedback', feedback)
      check flanger.acFlush()
      check sound.acActivate()
      wait_for_stop(count, 20)
      assert(count.stops is 1, 'OnStop must be delivered once')
      assert(state_at_stop is ADS_IDLE, f'The delayed audio must have drained before OnStop, state {state_at_stop}')
      check audio.acDeactivate()
   end
end

-- A Sound on the shared global path stops after its estimated decay, behind a serial global chain.

@Test function GlobalChainStop()
   audio <close> = obj.new('Audio', { device='null' })
   first = audio.new('AudioFlanger')
   check first.acSetKey('delay', 5)
   check first.acSetKey('feedback', 90)
   first.init()
   second = audio.new('AudioFlanger')
   check second.acSetKey('depth', 10)
   check second.acSetKey('feedback', -90)
   second.init()
   check audio.acActivate()
   count = { stops=0 }
   sound <close> = obj.new('Sound', { audio=audio, path=glFolder .. 'low-tone.wav',
      onStop=function(Sound) count.stops++ end })
   check sound.acActivate()
   wait_for_stop(count, 20)
   assert(count.stops is 1, 'OnStop must be delivered once on the global path')

   state = wait_for_idle(audio, 0)
   assert(state is ADS_IDLE, f'The global chain must reach idle, state {state}')
   check audio.acDeactivate()
end

-- Destroying the flanger while its channel set is playing leaves the Sound to finish normally.

@Test function DestroyDuringPlayback()
   audio <close> = obj.new('Audio', { device='null' })
   check audio.acActivate()
   count = { stops=0 }
   sound <close> = obj.new('Sound', { audio=audio, path=glFolder .. 'low-tone.wav',
      onStop=function(Sound) count.stops++ end })
   flanger = obj.new('AudioFlanger', { audio=audio, channel=sound.channelIndex & 0xffff0000 })
   check flanger.acSetKey('feedback', 90)
   check flanger.acFlush()
   check sound.acActivate()
   processing.sleep(0.05)
   flanger.free()
   wait_for_stop(count, 20)
   assert(count.stops is 1, 'OnStop must be delivered once after the flanger is destroyed')
   check audio.acDeactivate()
end

-- A MaxDrain shorter than the recirculating tail cuts it short and reports it, and the chain still reaches idle.

@Test function MaxDrainTruncation()
   audio <close> = obj.new('Audio', { device='null', maxDrain=0.01 })
   check audio.acActivate()
   count = { stops=0 }
   sound <close> = obj.new('Sound', { audio=audio, path=glFolder .. 'low-tone.wav',
      onStop=function(Sound) count.stops++ end })
   set = sound.channelIndex & 0xffff0000
   flanger <close> = obj.new('AudioFlanger', { audio=audio, channel=set })
   check flanger.acSetKey('feedback', 90)
   check flanger.acFlush()
   check sound.acActivate()
   wait_for_stop(count, 20)
   assert(count.stops is 1, 'OnStop must be delivered once the drain limit is reached')

   state, truncated = wait_for_idle(audio, set)
   assert(state is ADS_IDLE, f'The chain must reach idle after truncation, state {state}')
   assert(truncated is 1, 'A drain cut short by MaxDrain must be reported')
   check audio.acDeactivate()
end

@Test function UnsupportedRate()
   audio <close> = obj.new('Audio', { device='null', outputRate=4000 })
   err, channel = audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   try
      flanger = obj.new('AudioFlanger', { audio=audio, channel=channel })
   except e when ERR_NoSupport
   success
      raise 'An output rate below 8000 Hz must be rejected'
   end
end

@end
