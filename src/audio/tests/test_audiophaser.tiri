@if(exists='modules:audio')

   module audio as mAudio
   import './effect_fields'

@BeforeAll function init(State)
   global glFolder = State.folder
end

-- Published parameters in schema order, with their defaults, units and scales.

PARAMS = {
   { key='rate', default=0.4, unit='Hz', scale='log', min=0.02, max=10 },
   { key='centre', default=800, unit='Hz', scale='log', min=100, max=4000 },
   { key='depth', default=60, unit='%', scale='linear', min=0, max=100 },
   { key='feedback', default=20, unit='%', scale='linear', min=-80, max=80 },
   { key='mix', default=50, unit='%', scale='linear', min=0, max=100 }
}

function u8_mono()
   return struct.new('AudioFormat', { sampleRate=44100, sampleFormat=ASF_U8, layout=array<int> { SPK_CENTRE } })
end

function new_phaser(Audio:obj):<obj, num>
   err, channel = Audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   return obj.new('AudioPhaser', { audio=Audio, channel=channel }), channel
end

function play_square(Audio:obj, Channel:num)
   data = array<byte, 8192>
   for i in {0 to 8192} do data[i] = (i % 64 < 32) ? 160 : 96 end
   err, sample = Audio.mtAddSample(nil, u8_mono(), data, nil)
   assert(err is ERR_Okay)
   check mAudio.MixSample(Audio, Channel, sample)
   check mAudio.MixFrequency(Audio, Channel, 44100)
   check mAudio.MixPlay(Audio, Channel, 0)
end

function wait_for_stop(Count:table, Seconds:num)
   deadline = mSys.PreciseTime() + (Seconds * 1000000)
   while (Count.stops is 0) and (mSys.PreciseTime() < deadline) do processing.sleep(0.01) end
end

function wait_for_idle(Audio:obj, Set:num):<num, num>
   state, truncated = -1, 0
   deadline = mSys.PreciseTime() + 5000000
   while mSys.PreciseTime() < deadline do
      err, status = Audio.mtGetEffectStatus(Set)
      state, truncated = status.state, status.truncated
      assert(err is ERR_Okay)
      if state is ADS_IDLE then break end
      processing.sleep(0.01)
   end
   return state, truncated
end

-----------------------------------------------------------------------------------------------------------------------

@Test function SchemaDiscovery()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   phaser <close> = new_phaser(audio)
   schema = phaser.schema
   assert(schema.find('<effect class="AudioPhaser" version="1"') != nil, 'The schema must identify the class')
   assert(schema.find('<group') is nil, 'The phaser has no parameter groups')
   assert(schema.find('type="enum"') is nil, 'The phaser has no enumerated parameters')
   assert(schema.find('type="curve"') is nil, 'The phaser does not publish a response curve')
   assert(schema.find('gain_reduction') is nil, 'The phaser does not publish gain reduction')
   for p in values(PARAMS) do
      assert(schema.find(f'<param key="{p.key}"') != nil, f'{p.key} must be published')
      assert(schema.find(f'unit="{p.unit}" scale="{p.scale}" min="{p.min}" max="{p.max}" default="{p.default}"') != nil,
         f'{p.key} must publish its unit, scale, range and default')
      err, value_text = phaser.acGetKey(p.key)
      value = tonumber(value_text)
      assert(err is ERR_Okay and value is p.default, f'{p.key} should default to {p.default}, got {value}')
   end

   -- Parameters appear in the documented order.

   last = 0
   for p in values(PARAMS) do
      position = schema.find(f'<param key="{p.key}"')
      assert(position > last, f'{p.key} is out of order')
      last = position
   end

   assert(schema.find('key="input_peak_left" type="scalar"') != nil)
   assert(schema.find('key="output_peak_right" type="scalar"') != nil)
   assert(schema.find('unit="dBFS" scope="channel"') != nil)
   assert(phaser.mtGetOutput('response') is ERR_Search)
end

@Test function ChangesAndValidation()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   phaser <close> = new_phaser(audio)
   assert(phaser.mutable is 1)

   -- Every bound is inclusive; values outside it and non-finite values are rejected immediately.

   for p in values(PARAMS) do
      check phaser.mtBatch(array<str> { f'set {p.key} {p.min}', f'set {p.key} {p.max}' })
      assert(phaser.mtBatch(array<str> { f'set {p.key} {p.min - 0.001}' }) is ERR_InvalidValue,
         f'{p.key} below {p.min} must fail')
      assert(phaser.mtBatch(array<str> { f'set {p.key} {p.max + 0.001}' }) is ERR_InvalidValue,
         f'{p.key} above {p.max} must fail')
      assert(phaser.mtBatch(array<str> { f'set {p.key} {math.huge}' }) is ERR_InvalidValue,
         f'{p.key} must reject infinity')
      assert(phaser.mtBatch(array<str> { f'set {p.key} {-math.huge}' }) is ERR_InvalidValue,
         f'{p.key} must reject -infinity')
      assert(phaser.mtBatch(array<str> { f'set {p.key} {math.sqrt(-1)}' }) is ERR_InvalidValue,
         f'{p.key} must reject NaN')
   end
   assert(phaser.mtBatch(array<str> { 'set unknown 1' }) is ERR_Search)

   -- A rejected value fails the whole batch and names its command; a valid batch commits every value together.
   -- Fractional and negative values are kept.

   err, failed = phaser.mtBatch(array<str> {
      'set rate 1.25', 'set centre 1234.5', 'set depth 47.25', 'set feedback -81'
   })
   assert(err is ERR_InvalidValue and failed is 3, f'The last command must fail, got {err} at {failed}')
   err, value_text = phaser.acGetKey('rate')
   assert(err is ERR_Okay and tonumber(value_text) != 1.25, 'A rejected batch must change nothing')
   check phaser.mtBatch(array<str> { 'set rate 1.25', 'set centre 1234.5', 'set depth 47.25', 'set feedback -62.5' })
   for key, expected in pairs({ rate=1.25, centre=1234.5, depth=47.25, feedback=-62.5, mix=100 }) do
      err, value_text = phaser.acGetKey(key)
      value = tonumber(value_text)
      assert(err is ERR_Okay and value is expected, f'{key} should be {expected} after Batch(), got {value}')
   end
end

@Test function ConfigureBeforeInit()
   audio <close> = obj.new('Audio', { device='null', outputRate=44100 })
   err, channel = audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   phaser <close> = obj.new('AudioPhaser')
   phaser.audio = audio
   phaser.channel = channel
   check phaser.mtBatch(array<str> { 'set centre 2500', 'set feedback -70' })
   assert(phaser.mtBatch(array<str> { 'set centre 99' }) is ERR_InvalidValue)
   phaser.init()
   for key, expected in pairs({ centre=2500, feedback=-70, depth=60 }) do
      err, value_text = phaser.acGetKey(key)
      value = tonumber(value_text)
      assert(err is ERR_Okay and value is expected, f'{key} should be {expected}, got {value}')
   end
end

@Test function LivePlayback()
   audio <close> = obj.new('Audio', { device='null', outputRate=48000 })
   phaser, channel = new_phaser(audio)
   check phaser.mtBatch(array<str> { 'set mix 100' })
   check audio.acActivate()
   assert(phaser.latency is 0, 'The phaser publishes no algorithmic latency, even when fully wet')
   err, rate, format, layout, generation, state = phaser.mtGetProcessingFormat()
   assert(err is ERR_Okay and rate is 48000 and #layout is 2)

   play_square(audio, channel)

   -- Simultaneous edits of every parameter at their extremes, followed by a second edit during the ramp.

   check phaser.mtBatch(array<str> { 'set centre 100', 'set rate 10', 'set depth 100', 'set feedback -80' })
   check phaser.mtBatch(array<str> { 'set centre 4000', 'set feedback 80', 'set mix 0' })
   assert(phaser.latency is 0, 'Parameter changes must not alter the latency')

   err, layout = phaser.mtGetMeterLayout()
   assert(err is ERR_Okay and #layout.meters is 4)
   assert(layout.meters[0].key is 'input_peak_left' and layout.meters[3].key is 'output_peak_right')

   phaser.flags = AEF_BYPASS
   err, reading = phaser.mtReadMeters()
   assert(err is ERR_Okay and reading.flags is AMF_BYPASSED)
   phaser.flags = 0

   check audio.mtCloseChannels(channel)
   err, reading = phaser.mtReadMeters()
   assert(err is ERR_Okay and reading.flags is AMF_DISCONNECTED)
   assert(phaser.mtBatch(array<str> { 'set mix 50' }) is ERR_NotInitialised)
   phaser.free()
end

@Test function MonoAndGlobalImmutability()
   audio <close> = obj.new('Audio', { device='null', outputRate=44100, outputLayout=array<int> { SPK_CENTRE } })
   phaser = audio.new('AudioPhaser')
   check phaser.mtBatch(array<str> { 'set feedback -45', 'set centre 300' })
   phaser.init()
   assert(phaser.mutable is 0)
   assert(phaser.mtBatch(array<str> { 'set centre 2000' }) is ERR_Immutable)
   err, value_text = phaser.acGetKey('feedback')
   value = tonumber(value_text)
   assert(err is ERR_Okay and value is -45, 'Global settings are retained')
   check audio.acActivate()
   err, layout = phaser.mtGetMeterLayout()
   assert(err is ERR_Okay and #layout.meters is 2)
   assert(layout.meters[0].key is 'input_peak_centre' and layout.meters[1].key is 'output_peak_centre')
   assert(phaser.schema.find('input_peak_right') is nil, 'Mono must not publish a right channel')
   check audio.acDeactivate()
end

-- OnStop is held until the ringing filters have drained from the Sound's channel set, at either feedback sign.

@Test function SoundStopWaitsForTail()
   for feedback in values({ 80, -80 }) do
      audio <close> = obj.new('Audio', { device='null' })
      check audio.acActivate()
      count = { stops=0 }
      state_at_stop = -1
      sound <close> = obj.new('Sound', { audio=audio, path=glFolder .. 'low-tone.wav',
         onStop=function(Sound)
            count.stops++
            err, status = audio.mtGetEffectStatus(Sound.channelIndex & 0xffff0000)
            state = status.state
            state_at_stop = state
         end })
      phaser <close> = obj.new('AudioPhaser', { audio=audio, channel=sound.channelIndex & 0xffff0000 })
      check phaser.mtBatch(array<str> { 'set centre 100', 'set depth 100', f'set feedback {feedback}' })
      check sound.acActivate()
      wait_for_stop(count, 20)
      assert(count.stops is 1, 'OnStop must be delivered once')
      assert(state_at_stop is ADS_IDLE, f'The filters must have drained before OnStop, state {state_at_stop}')
      check audio.acDeactivate()
   end
end

-- A Sound on the shared global path stops after its estimated decay, and the global chain then reaches idle.

@Test function GlobalChainStop()
   audio <close> = obj.new('Audio', { device='null' })
   first = audio.new('AudioPhaser')
   check first.mtBatch(array<str> { 'set centre 100', 'set feedback 80' })
   first.init()
   second = audio.new('AudioPhaser')
   check second.mtBatch(array<str> { 'set depth 100', 'set feedback -80' })
   second.init()
   check audio.acActivate()
   count = { stops=0 }
   sound <close> = obj.new('Sound', { audio=audio, path=glFolder .. 'low-tone.wav',
      onStop=function(Sound) count.stops++ end })
   check sound.acActivate()
   wait_for_stop(count, 20)
   assert(count.stops is 1, 'OnStop must be delivered once on the global path')

   state = wait_for_idle(audio, 0)
   assert(state is ADS_IDLE, f'The global chain must reach idle, state {state}')
   check audio.acDeactivate()
end

-- Destroying the phaser while its channel set is playing leaves the Sound to finish normally.

@Test function DestroyDuringPlayback()
   audio <close> = obj.new('Audio', { device='null' })
   check audio.acActivate()
   count = { stops=0 }
   sound <close> = obj.new('Sound', { audio=audio, path=glFolder .. 'low-tone.wav',
      onStop=function(Sound) count.stops++ end })
   phaser = obj.new('AudioPhaser', { audio=audio, channel=sound.channelIndex & 0xffff0000 })
   check phaser.mtBatch(array<str> { 'set feedback 80' })
   check sound.acActivate()
   processing.sleep(0.05)
   phaser.free()
   wait_for_stop(count, 20)
   assert(count.stops is 1, 'OnStop must be delivered once after the phaser is destroyed')
   check audio.acDeactivate()
end

-- A MaxDrain shorter than the ringing tail cuts it short and reports it, and the chain still reaches idle.

@Test function MaxDrainTruncation()
   audio <close> = obj.new('Audio', { device='null', maxDrain=0.01 })
   check audio.acActivate()
   count = { stops=0 }
   sound <close> = obj.new('Sound', { audio=audio, path=glFolder .. 'low-tone.wav',
      onStop=function(Sound) count.stops++ end })
   set = sound.channelIndex & 0xffff0000
   phaser <close> = obj.new('AudioPhaser', { audio=audio, channel=set })
   check phaser.mtBatch(array<str> { 'set centre 100', 'set depth 0', 'set feedback 80' })
   check sound.acActivate()
   wait_for_stop(count, 20)
   assert(count.stops is 1, 'OnStop must be delivered once the drain limit is reached')

   state, truncated = wait_for_idle(audio, set)
   assert(state is ADS_IDLE, f'The chain must reach idle after truncation, state {state}')
   assert(truncated is 1, 'A drain cut short by MaxDrain must be reported')
   check audio.acDeactivate()
end

@Test function UnsupportedRate()
   audio <close> = obj.new('Audio', { device='null', outputRate=4000 })
   err, channel = audio.mtOpenChannels(1)
   assert(err is ERR_Okay)
   try
      phaser = obj.new('AudioPhaser', { audio=audio, channel=channel })
   except e when ERR_NoSupport
   success
      raise 'An output rate below 8000 Hz must be rejected'
   end
end

-- Every schema parameter has a typed field that follows the shared field semantics.

@Test function TypedFields()
   effect_fields.checkFields('AudioPhaser')
end

@end
