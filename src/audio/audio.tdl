--$TIRI:Include

module({ name="Audio", copyright="Paul Manias © 2002-2026", version=1.0, timestamp=20240611, src={ "audio.cpp", "commands.cpp" } }, function()
  flags("ADF", { comment="Optional flags for the Audio object." },
    "OVER_SAMPLING: Enables oversampling for higher quality audio at the cost of slower mixing.",
    "FILTER_LOW: Enable a low level of output filtering to minimise distortion.",
    "FILTER_HIGH: Enable a high level of output filtering to minimise distortion.",
    "VOL_RAMPING: Enable volume ramping for softer playback when a sample is played multiple times (enabled by default).",
    "AUTO_SAVE: Save configuration information on exit.",
    "SYSTEM_WIDE: Mixer changes should be applied system-wide.")

  flags("AEF", { comment="Audio effect flags." },
    "BYPASS: Skip an application effect.  Global effects cannot be bypassed.")

  flags("AMF", { comment="Audio meter snapshot flags." },
    "VALID: The snapshot holds a valid measurement.",
    "IDLE: The measurement is idle or stale.",
    "BYPASSED: The effect is bypassed.  The VALID flag is not set.",
    "DISCONNECTED: The effect is not attached to an effect chain.  The VALID flag is not set.",
    "NO_SAMPLES: No samples have been measured yet.")

  flags("AMV", { comment="Per-value flags returned by AudioEffect.ReadMeters()." },
    "VALID: The value holds a measurement from the snapshot's interval.",
    "FLOOR: The measured value was below the meter floor.  The reported value is the floor.")

  enums("ASF", { type="int", start=1, comment="Sample representations, independent of the channel count." },
    "U8: Unsigned 8-bit integer samples in one byte.  Silence is `128`.",
    "S16: Signed 16-bit integer samples in two bytes.",
    "F32: 32-bit IEEE-754 floating point samples in four bytes, with a nominal range of `-1.0` to `1.0`.")

  flags("AFF", { comment="Optional AudioFormat flags." },
    "BIG_ENDIAN_ORDER: Multi-byte samples are stored in big endian byte order.  Samples are little endian if this flag is not set.")

  constants("SPK", { type="int", comment="Channel identities for the Layout of an AudioFormat." }, {
    CENTRE      = "1: Front centre speaker.  An ordinary mono channel also uses this identity.",
    FRONT_LEFT  = "2: Front left speaker.",
    FRONT_RIGHT = "3: Front right speaker.",
    LFE         = "4: Low-frequency effects channel.",
    SIDE_LEFT   = "5: Side left speaker.",
    SIDE_RIGHT  = "6: Side right speaker.",
    REAR_LEFT   = "7: Rear left speaker.",
    REAR_RIGHT  = "8: Rear right speaker.",
    DISCRETE    = "0x10000: Base identity for a discrete channel that has no speaker position.  Add a zero-based index from `0` to `0xffff`."
  })

  enums("ACL", { type="int", start=1, comment="Named channel layout presets for ExpandLayout()." },
    "MONO: `CENTRE`.",
    "STEREO: `FRONT_LEFT`, `FRONT_RIGHT`.",
    "SURROUND_5_1_SIDE: `FRONT_LEFT`, `FRONT_RIGHT`, `CENTRE`, `LFE`, `SIDE_LEFT`, `SIDE_RIGHT`.",
    "SURROUND_5_1_REAR: `FRONT_LEFT`, `FRONT_RIGHT`, `CENTRE`, `LFE`, `REAR_LEFT`, `REAR_RIGHT`.")

  enums("AFS", { type="int", start=0, comment="Availability of a reported processing format." },
    "UNAVAILABLE: No processing format has been committed.  The format results are empty.",
    "ACTIVE: The reported format is committed and in use.",
    "INACTIVE: Processing has stopped.  The last committed format is reported.")

  enums("ADS", { type="int", start=0, comment="Effect drain states reported by GetEffectStatus()." },
    "IDLE: No sources are playing and no effect has pending output.",
    "ACTIVE: At least one source on the selected path is playing.",
    "DRAINING: Sources have stopped, but one or more effects are still producing tail output.")

  enums("EQB", { type="int", start=0, comment="Parametric equaliser band types." },
    "PEAK: Bell filter with gain in decibels.",
    "LOW_SHELF: Low-frequency shelf with gain in decibels.",
    "HIGH_SHELF: High-frequency shelf with gain in decibels.",
    "LOW_PASS: Low-pass filter; gain is ignored.",
    "HIGH_PASS: High-pass filter; gain is ignored.")

  flags("VCF", { comment="Volume control flags" },
    { PLAYBACK = "0x00000001: The mixer supports audio output." },
    { CAPTURE  = "0x00000010: The mixer supports audio input." },
    { JOINED   = "0x00000100: The control's channels are joined and cannot be adjusted separately." },
    { MONO     = "0x00001000: The control has a single channel.  Its absence does not imply exactly two channels." },
    { MUTE     = "0x00010000: The mixer is muted." },
    { SYNC     = "0x00100000: The mixer is synchronised." }
  )

  flags("CHF", { comment="Optional flags for the AudioChannel structure." },
    "MUTE: Channel is muted.",
    "BACKWARD: Play channel backwards.",
    "VOL_RAMP: Volume ramping is enabled.",
    "CHANGED: Sample change")

  flags("SVF", { comment="Flags for the SetVolume() method." },
    { MUTE    = "0x00000100: Mute the audio for this channel." },
    { UNMUTE  = "0x00001000: Unmute the audio for this channel." },
    { CAPTURE = "0x00010000: Set input, not output." }
  )

  flags("SDF", { type='int', comment="Sound flags" },
    "LOOP: Enables sample looping. The #LoopStart and #LoopEnd fields determine where the looping area lies within the sample data.",
    "NEW: Create the sample from scratch (e.g. for audio recording purposes).",
    "RESTRICT_PLAY: Restricts playback so that the sound can never play on more than one channel at any given time.",
    { STREAM = "0x40000000: Read-Only. Indicates that streaming is enabled." },
    { NOTE = "0x80000000: Internal. Used for managing playback." }
  )

  enums("LOOP", { type='short', start=1, comment="Loop modes for the AudioLoop structure." },
    "SINGLE: Single loop: Releasing will end the note.",
    "SINGLE_RELEASE: Single loop: Sample data after the loop will be played when the note is released.",
    "DOUBLE: Double loop: When the note is released, playing shifts to the second loop.",
    "AMIGA_NONE: Amiga loop: Do nothing.",
    "AMIGA: Single loop: Amiga style.")

  enums("LTYPE", { type='char', start=1, comment="Loop types for the AudioLoop structure." },
    "UNIDIRECTIONAL: The sample playback position returns to the byte position specified in the Loop1Start field.",
    "BIDIRECTIONAL: The sample will play in reverse whenever it hits the end marker, then forwards when it hits the start marker.")

  enums("STREAM", { type='int', start=1, comment="Streaming options" },
    "NEVER: No streaming - load all data into memory.",
    "SMART: Smart streaming is the default.  If the sample appears to be relatively small with respect to available system RAM, it will be loaded into memory.  Otherwise it will be streamed.",
    "ALWAYS: Stream if the sample length exceeds 64k.")

  enums("NOTE", { start=0, comment="Definitions for the Note field.  An 'S' indicates a sharp note." },
    "C", "CS", "D", "DS", "E", "F", "FS", "G", "GS", "A", "AS", "B", "OCTAVE")

  enums("CHS", { type='char', start=0, comment="Channel status types for the AudioChannel structure." },
   "STOPPED: Playing was stopped by the client.",
   "FINISHED: Playback concluded by reaching the sample end.",
   "PLAYING: Sample playing and not released.",
   "RELEASED: Sample playing and note has been released.",
   "FADE_OUT: Playback is fading out.")

  enums("MIX", { type="int", start=1, comment="Mixer batch operations." },
    "CONTINUE: Resume a paused channel; arguments ignored.",
    "FREQUENCY: Set playback frequency using Integer (0 to 192000 Hz).",
    "MUTE: Set mute using Integer (zero is unmuted).",
    "PAN: Set pan using Value (-1 to 1, clamped).",
    "PAUSE: Suspend playback, preserving position, loop and release state; arguments ignored.",
    "PLAY: Start playback at byte position Integer (non-negative).",
    "RELEASE: Release the playing note according to the sample's loop mode; arguments ignored.",
    "TEMPO: Set channel-set tracker tempo using Integer (1 to 100000 BPM; 24 ticks per beat).",
    "SAMPLE: Select sample handle Integer (positive).",
    "STOP: End playback terminally; arguments ignored.",
    "VOLUME: Set gain using Value (0 to 1, clamped).")

  structdef("AudioMixCommand", { comment="One command in a caller-owned mixer batch." }, [[
    int(MIX) Operation # Mixer operation
    int Handle         # Target channel; all commands in a batch must use the same channel set
    large Integer      # Integer argument for the selected operation; otherwise ignored
    double Value       # Finite floating-point argument for PAN and VOLUME; otherwise ignored
  ]])

  structdef("AudioLoop", { comment="Loop settings for the AddSample() method." }, [[
    short(LOOP) LoopMode    # Loop mode (single, double)
    char(LTYPE) Loop1Type   # First loop type (unidirectional, bidirectional)
    char(LTYPE) Loop2Type   # Second loop type (unidirectional, bidirectional)
    large Loop1Start        # Byte position at the start of the first loop
    large Loop1End          # Byte position at the end of the first loop
    large Loop2Start        # Byte position at the start of the second loop
    large Loop2End          # Byte position at the end of the second loop
  ]])

  structdef("AudioFormat", { comment="Describes interleaved PCM audio data." }, [[
    int SampleRate          # Nominal sample rate in frames per second
    int(ASF) SampleFormat   # Representation of each sample
    int(AFF) Flags          # Optional format flags
    vector(int) Layout      # Ordered channel identities from SPK; the length is the channel count
  ]])

  structdef("MeterInfo", { comment="Describes one value published by an effect's meters." }, [[
    string Key         # Stable key, e.g. `input_peak_left`
    string Label       # Human-readable label
    string Unit        # Unit of measurement, e.g. `dBFS`, or empty
    string Scope       # Either `channel` or `global`
    string Semantics   # Kind of measurement, e.g. `sample-peak`, or empty
    int Slot           # Index of the value in the Values of a MeterReading
    int Channel        # Channel identity from SPK, or zero for a global value
  ]])

  structdef("MeterLayout", { comment="An owned snapshot of the descriptors returned by GetMeterLayout()." }, [[
    large ID                              # Configuration identifier shared with the matching MeterReading
    vector(struct(MeterInfo)) Meters # Meter descriptors in slot order
  ]])

  structdef("MeterValue", { comment="One meter value in a MeterReading." }, [[
    double Value    # Measured value in the units of its MeterInfo descriptor
    int(AMV) Flags  # Validity of the value
  ]])

  structdef("MeterReading", { comment="One coherent measurement of every meter value, from ReadMeters()." }, [[
    large Sequence                    # Publication sequence number; increases with each published interval
    large ID                          # Configuration identifier; compare with the ID from GetMeterLayout()
    large Position                    # Processed-frame position at the end of the interval
    int(AMF) Flags                    # Validity and lifecycle state of the reading
    int Interval                      # Length of the measurement interval in frames
    vector(struct(MeterValue)) Values # One value per meter descriptor, indexed by slot
  ]])

  structdef("AudioEQBand", { comment="One parametric equaliser band." }, [[
    int(EQB) Type      # Filter type
    double Frequency   # Centre or corner frequency in hertz
    double Gain        # Band gain in decibels
    double Q           # Quality factor or shelf slope
  ]])

  methods("Audio", "Snd", {
    { id=1, name="OpenChannels" },
    { id=2, name="CloseChannels" },
    { id=3, name="AddSample" },
    { id=4, name="RemoveSample" },
    { id=5, name="SetSampleLength" },
    { id=6, name="AddStream" },
    { id=7, name="Beep" },
    { id=8, name="SetVolume" },
    { id=9, name="GetEffectStatus" },
    { id=10, name="ResetEffects" },
    { id=11, name="GetOutputFormat" },
    { id=12, name="GetVolumeChannels" }
  })

  klass("Audio", { version=1, src="class_audio.cpp", output="class_audio_def.c", extended=true }, [[
    ~double MaxDrain
    ~array(int) OutputLayout
    int OutputRate
    int InputRate
    int Quality
    int(ADF) Flags     # Special flags
    int BitDepth       # Typically `8` or `16` bit, reflects the hardware driver's bit depth
    int Periods        # Number of periods for ALSA audio buffering
    int PeriodSize     # Frames per period for ALSA audio buffering
  ]])

  methods("AudioEffect", "Fx", {
    { id=3, name="InsertEntry" },
    { id=4, name="RemoveEntry" },
    { id=5, name="GetResponse" },
    { id=6, name="GetGroupCount" },
    { id=7, name="GetMeterLayout" },
    { id=8, name="GetOutput" },
    { id=9, name="ReadMeters" },
    { id=10, name="GetProcessingFormat" }
  })

  klass("AudioEffect", { version=1, src="class_audioeffect.cpp", output="class_audioeffect_def.c", extended=true }, [[
    oid Audio
    int Channel
    int Order
    int(AEF) Flags
    int OutputRate
    oid Parent
    int Branch
    ~large Latency
    ~int Mutable
    ~string Schema
  ]])

  klass("AudioEqualiser", { base="AudioEffect", src="class_audioequaliser.cpp",
    output="class_audioequaliser_def.c", extended=true }, [[
    ~array(struct(AudioEQBand)) Bands
    ~double Gain
  ]])

  klass("AudioReverb", { base="AudioEffect", src="class_audioreverb.cpp",
    output="class_audioreverb_def.c", extended=true }, [[
  ]])

  klass("AudioCompressor", { base="AudioEffect", src="class_audiocompressor.cpp",
    output="class_audiocompressor_def.c", extended=true }, [[
  ]])

  klass("AudioLimiter", { base="AudioEffect", src="class_audiolimiter.cpp",
    output="class_audiolimiter_def.c", extended=true }, [[
  ]])

  klass("AudioGate", { base="AudioEffect", src="class_audiogate.cpp",
    output="class_audiogate_def.c", extended=true }, [[
  ]])

  klass("AudioDelay", { base="AudioEffect", src="class_audiodelay.cpp",
    output="class_audiodelay_def.c", extended=true }, [[
  ]])

  klass("AudioChorus", { base="AudioEffect", src="class_audiochorus.cpp",
    output="class_audiochorus_def.c", extended=true }, [[
  ]])

  klass("AudioFlanger", { base="AudioEffect", src="class_audioflanger.cpp",
    output="class_audioflanger_def.c", extended=true }, [[
  ]])

  klass("AudioLoudness", { base="AudioEffect", src="class_audioloudness.cpp",
    output="class_audioloudness_def.c", extended=true }, [[
  ]])

  klass("AudioPhaser", { base="AudioEffect", src="class_audiophaser.cpp",
    output="class_audiophaser_def.c", extended=true }, [[
  ]])

  klass("AudioSaturator", { base="AudioEffect", src="class_audiosaturator.cpp",
    output="class_audiosaturator_def.c", extended=true }, [[
  ]])

  klass("AudioSplitter", { base="AudioEffect", src="class_audiosplitter.cpp",
    output="class_audiosplitter_def.c", extended=true }, [[
    ~double LatencyBudget
  ]])

  klass("AudioStereo", { base="AudioEffect", src="class_audiostereo.cpp",
    output="class_audiostereo_def.c", extended=true }, [[
  ]])

  klass("AudioCrossfeed", { base="AudioEffect", src="class_audiocrossfeed.cpp",
    output="class_audiocrossfeed_def.c", extended=true }, [[
  ]])

  klass("AudioPitchShift", { base="AudioEffect", src="class_audiopitchshift.cpp",
    output="class_audiopitchshift_def.c", extended=true }, [[
  ]])

  -- AudioAnalyser method IDs start high enough to give a cushion from inherited AudioEffect methods.

  methods("AudioAnalyser", "Ana", {
    { id=30, name="GetSpectrum" },
    { id=31, name="GetWaveform" }
  })

  klass("AudioAnalyser", { base="AudioEffect", src="class_audioanalyser.cpp",
    output="class_audioanalyser_def.c", extended=true }, [[
  ]])

  klass("Sound", { version=1, src="class_sound.cpp", output="class_sound_def.c", extended=true }, [[
    ~struct(*AudioFormat) SourceFormat
    ~int Channels
    ~int FrameBytes
    ~int SampleRate
    string Path
    double Volume      # Volume of sample (0 - 100%)
    double Pan         # Horizontal positioning for playback on stereo speakers (`-100` to `+100`)
    large Position     # Byte position to start playing from
    large Length       # Length of sample data in bytes
    large LoopStart    # Byte position of looping start
    large LoopEnd      # Byte position of looping end
    int Priority       # Priority over other sounds
    int Octave         # Current octave to use for playing back notes (defaults to zero)
    int(SDF) Flags     # Sound flags
    int Playback       # Frequency to use for sample playback
    int Compression    # Compression rating (0% none, 100% high)
    int BytesPerSecond # Bytes per second, measured as `SampleRate * FrameBytes`
    oid Audio          # Reference to an @Audio object to use for audio output and input
    int(STREAM) Stream # Streaming type (smart by default)
    int Handle         # Audio handle acquired at the audio object [Private - Available to child classes]
    int ChannelIndex   # Channel handle that the sound was last played on
  ]])

  functionNames("snd",
     "MixContinue",
     "MixFrequency",
     "MixMute",
     "MixPan",
     "MixPause",
     "MixPlay",
     "MixRelease",
     "MixTempo",
     "MixSample",
     "MixStop",
     "MixVolume",
     "MixSubmitBatch",
     "ExpandLayout",
     "GetFrameBytes")

end)
