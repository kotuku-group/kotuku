@Test; @Requires(network=true)
function StreamingCloseDisconnectsSession()
   response, disconnected = websocket_exchange_until_disconnect(websocket_frame('', 0x08))

   assert(response.find('HTTP/1.1 101 Switching Protocols'), 'Expected WebSocket handshake, got: ' .. response)
   assert(disconnected, 'Expected WebSocket close frame to disconnect the session.')
end

@Test function StreamingPrefixDeliveredOnce()
   local command = '{"id":"prefix","type":"subscribe","topics":["system"]}'
   local response = websocket_exchange(array<str> {}, array<str> { '"id":"prefix"', '"event":"subscribed"' },
      websocket_frame(command, 1))
   assert(response.count('"id":"prefix"') is 1, 'Coalesced command was duplicated')
   assert(response.count('"event":"connected"') is 1, 'Connected event was duplicated')
end

@Test function StreamingFragmentedSubscription()
   local response = websocket_exchange(array<str> {
      websocket_frame('{"id":"fragments","type":"sub', 1, false),
      websocket_frame('interleaved', 9),
      websocket_frame('scribe","topics":["system"]}', 0)
   }, array<str> { '"id":"fragments"', '"event":"subscribed"', 'interleaved' })
   assert(response.count('"id":"fragments"') is 1, 'Fragments were delivered separately or duplicated')
end

@Test function StreamingProtocolCloseCodes()
   local cases = {
      { websocket_frame('binary', 2), 1003 },
      { websocket_frame('bad \xc0\xaf', 1), 1007 },
      { websocket_frame(string.char(3), 8), 1002 },
      { string.char(0x81, 1) .. 'x', 1002 },
      { string.char(0x81, 0x80 | 127, 0, 0, 0, 0, 0, 1, 0, 1, 0x11, 0x22, 0x33, 0x44), 1009 }
   }
   for case in values(cases) do
      local code = string.char(case[1] >> 8, case[1] & 255)
      local response = websocket_exchange(array<str> { case[0] }, array<str> { string.char(0x88), code })
      assert(response.find(code), f'Expected close {case[1]}')
   end
end

@Test function StreamingAbruptDisconnectKeepsRestAvailable()
   local response = request_backstage(websocket_handshake(''), '"event":"heartbeat"')
   assert(response.find('HTTP/1.1 101 Switching Protocols'), 'Streaming did not open before the TCP drop')
   -- request_backstage frees the raw client without a Close frame.
   PingReturnsJsonPong()
end

@Test function StreamingUnknownCommand()
   local response = websocket_exchange(array<str> { websocket_frame('{"id":"bad","type":"other"}', 1) },
      array<str> { '"code":"unknown_command"' })
   assert(response.find('"id":"bad"'), 'Command error lost the request ID')
end

-- Decode complete server frames so ordered token matches cannot conceal truncated or malformed JSON.
function streaming_messages(Response:str):array<table>
   local position = Response.find('\r\n\r\n')
   assert(position, 'Opening response was incomplete')
   position += 4
   local messages = array<table>
   while position < #Response do
      assert(#Response - position >= 2, 'Truncated frame header')
      assert(Response.byte(position) is 0x81, 'Expected a complete text frame')
      local length = Response.byte(position + 1)
      assert((length & 0x80) is 0, 'Server frame was masked')
      local header = 2
      if length is 126 then
         assert(#Response - position >= 4, 'Truncated extended frame header')
         length = (Response.byte(position + 2) << 8) | Response.byte(position + 3)
         header = 4
      elseif length is 127 then
         assert(#Response - position >= 10, 'Truncated extended frame header')
         length = 0
         for i in {2 to 10} do length = length * 256 + Response.byte(position + i) end
         header = 10
      end
      assert(#Response - position >= header + length, 'Truncated JSON frame')
      local message = json.decode(Response.sub(position + header, position + header + length))
      messages.push(message)
      position += header + length
   end
   return messages
end

@Test function StreamingBurstKeepsEventOrder()
   local frames = array<str>
   for i in {0 to 100} do
      frames.push(websocket_frame(f'{{"id":"{i}","type":"subscribe","topics":["system"]}}', 1))
   end
   local response = websocket_exchange(frames, array<str> { '"seq":102,"data":{"topic":"system"}}' })
   local sequence = 0
   local acknowledgements = 0
   local messages = streaming_messages(response)
   assert(#messages is 202, 'Burst frames were lost or duplicated')
   for message in values(messages) do
      if message.type is 'event' then
         sequence++
         assert(message.seq is sequence, f'Event {sequence} was lost or reordered')
      elseif message.type is 'ack' then
         assert(message.id is tostring(acknowledgements), 'Acknowledgements were reordered')
         acknowledgements++
      else
         raise 'Unexpected streaming message'
      end
   end
   assert(sequence is 102 and acknowledgements is 100, 'Burst events or acknowledgements were lost')
end
@end

@Test function StreamingBuildAvailability()
   local expected = 'HTTP/1.1 501 Not Implemented'
   @if(exists='modules:websocket')
      expected = 'HTTP/1.1 101 Switching Protocols'
   @end
   local response = request_backstage(websocket_handshake(''), expected)
   assert(response.find(expected), f'Streaming availability did not match this build: {response}')
   PingReturnsJsonPong()
end
