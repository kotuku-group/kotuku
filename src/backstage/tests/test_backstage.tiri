   response = websocket_exchange(array<str> { frame }, array<str> {
      '"type":"ack"',
      '"id":"1"',
      '"command":"subscribe"',
      '"topic":"system"',
      '"event":"subscribed"'
   })

   assert(response.find('"topics":["system"]'), 'Expected system topic acknowledgement, got: ' .. response)
end

