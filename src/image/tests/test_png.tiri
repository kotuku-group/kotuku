   'data/xs4n0g01.png',
   'data/xs7n0g01.png'
}

local glDataFolder

@BeforeAll function setup(State)
   glDataFolder = State.folder
   err = mSys.CreateFolder(glResultFolder, 0)
   if (err != ERR_Okay) and (err != ERR_FileExists) then
      raise 'CreateFolder() failed for ' .. glResultFolder .. ': ' .. mSys.GetErrorMsg(err)
   end
end

function formatHash(Hash:num)
   return string.format('0x%.8x', Hash)
end

function saveBitmap(Image:obj, Name:str)
   try
      file = obj.new('file', { flags=FL_NEW|FL_WRITE, path=glResultFolder .. Name })
      Image.acSaveImage(file)
   except ex
      logOutput('Unable to save decoded PNG result for "' .. Name .. '": ' .. ex.message)
   end
end

----------------------------------------------------------------------------------------------------------------------

@Test global function ValidPNGHashes()
   missing = array<str> { }
   mismatches = array<str> { }

   for entry in values(glValidPNG) do
      local hash, bmp, pic

      try
         pic = obj.new('image', { path=glDataFolder .. entry.src })
         bmp = pic.bitmap
         hash = mSys.GenCRC32(0, bmp.data, bmp.size)
      except ex
         mismatches.push(entry.src .. ': load failed: ' .. ex.message)
         continue
      success
         if not entry.crc?? then
            saveBitmap(bmp, entry.src)
            missing.push("   { src='" .. entry.src .. "', crc=" .. formatHash(hash) .. ' },')
         elseif entry.crc != hash then
            saveBitmap(bmp, entry.src)
            mismatches.push(entry.src .. ': computed ' .. formatHash(hash) .. ', expected ' .. formatHash(entry.crc))
         end

         if entry.mask_crc then
            if not pic.mask then
               mismatches.push(entry.src .. ': expected alpha mask but none was loaded')
            else
               mask_hash = mSys.GenCRC32(0, pic.mask.data, pic.mask.size)

               if entry.mask_crc != mask_hash then
                  mismatches.push(entry.src .. ': mask computed ' .. formatHash(mask_hash) ..
                     ', expected ' .. formatHash(entry.mask_crc))
               end
            end
         end
      end
   end

   if (#missing > 0) or (#mismatches > 0) then
      message = ''
      if #missing > 0 then
         message ..= 'Missing Image PNG CRC values:\n' .. missing.concat('\n')
      end
      if #mismatches > 0 then
         if #message > 0 then message ..= '\n\n' end
         message ..= 'Image PNG CRC mismatches or load failures:\n' .. mismatches.concat('\n')
      end
      raise message
   end
end

----------------------------------------------------------------------------------------------------------------------

@Test global function InvalidPNGsFailToLoad()
   failures = array<str> { }

   for entry in values(glInvalidPNG) do
      try
         obj.new('image', { path=glDataFolder .. entry })
      success
         failures.push(entry .. ': loaded successfully but should be rejected')
      end
   end

   if #failures > 0 then
      raise 'Invalid PNG files loaded successfully:\n' .. failures.concat('\n')
   end
end

----------------------------------------------------------------------------------------------------------------------
-- 16-bit greyscale.  The Bitmap dictates the format: 16-bit greyscale sources load as-is into BMF_GREYSCALE bitmaps,
-- and a preset BMF_GREYSCALE flag loads greyscale sources of any depth that way.  The expected CRCs are of the raw PNG
-- samples as little-endian uint16 values (8-bit and lower samples scaled to 16 bits), computed independently of the
-- Image class.  No gamma correction is applied, even though every PngSuite file here has gAMA 1.0.

glGreyscale16PNG = array<table> {
   { src='data/basn0g16.png', crc=0x2ab15133 },
   { src='data/basi0g16.png', crc=0x2ab15133 }, -- Interlaced
   { src='data/oi9n0g16.png', crc=0x2ab15133 }, -- One IDAT chunk per byte
   { src='data/basn4a16.png', crc=0xdbf1c94e, mask_crc=0x8ce873a2 },
   { src='data/bggn4a16.png', crc=0xdbf1c94e, mask_crc=0x8ce873a2 }
}

glGreyscalePresetPNG = array<table> {
   { src='data/basn0g01.png', crc=0x394acc75 },
   { src='data/basn0g04.png', crc=0xdffc2988 },
   { src='data/basn0g08.png', crc=0x0c71a789 }
}

-- Load an image after presetting fields of its Bitmap.

function loadPreset(Src:str, Bitmap:table, Flags:num):obj
   local pic = obj.new('image', { path=glDataFolder .. Src, flags=PCF_LAZY | (Flags ?? 0) })
   for k, v in Bitmap do pic.bitmap[k] = v end
   check pic.acActivate()
   return pic
end

function assertGreyscale16(Pic:obj, Entry:table)
   local bmp = Pic.bitmap
   assert(bmp.bitsPerPixel is 16, Entry.src .. ': expected 16 bits per pixel, got ' .. bmp.bitsPerPixel)
   assert(bmp.flags has BMF_GREYSCALE, Entry.src .. ': expected BMF_GREYSCALE')
   assert(bmp.lineWidth is bmp.width * 2, Entry.src .. ': unexpected line width ' .. bmp.lineWidth)

   local hash = mSys.GenCRC32(0, bmp.data, bmp.size)
   assert(hash is Entry.crc,
      Entry.src .. ': computed ' .. formatHash(hash) .. ', expected ' .. formatHash(Entry.crc))

   if Entry.mask_crc then
      assert(Pic.mask, Entry.src .. ': expected an alpha mask')
      local mask_hash = mSys.GenCRC32(0, Pic.mask.data, Pic.mask.size)
      assert(mask_hash is Entry.mask_crc, Entry.src .. ': mask computed ' .. formatHash(mask_hash) ..
         ', expected ' .. formatHash(Entry.mask_crc))
   else
      assert(not Pic.mask, Entry.src .. ': unexpected mask')
   end
end

@Test global function Greyscale16LoadsAsIs()
   for entry in values(glGreyscale16PNG) do
      assertGreyscale16(obj.new('image', { path=glDataFolder .. entry.src }), entry)
   end
end

@Test global function PresetGreyscaleExpandsLowDepths()
   for entry in values(glGreyscalePresetPNG) do
      assertGreyscale16(loadPreset(entry.src, { flags=BMF_GREYSCALE }), entry)
   end

   -- Without the preset, 8-bit greyscale keeps its 8-bit format.
   local bmp = obj.new('image', { path=glDataFolder .. 'data/basn0g08.png' }).bitmap
   assert(bmp.bitsPerPixel is 8, 'Expected 8-bit greyscale by default, got ' .. bmp.bitsPerPixel)
end

@Test global function PresetDepthConvertsGreyscale16()
   -- A preset depth selects the conversion; the CRC is that of the 8-bit, gamma-corrected glValidPNG entry.
   local bmp = loadPreset('data/basn0g16.png', { bitsPerPixel=8 }).bitmap
   assert(bmp.bitsPerPixel is 8, 'Expected 8 bits per pixel, got ' .. bmp.bitsPerPixel)
   assert(not (bmp.flags has BMF_GREYSCALE), 'Unexpected BMF_GREYSCALE')
   local hash = mSys.GenCRC32(0, bmp.data, bmp.size)
   assert(hash is 0x630db2ea, 'Computed ' .. formatHash(hash))
end

@Test global function Greyscale16ReadsAsEightBitGrey()
   -- ReadRGBPixel() sees the high byte of each 16-bit sample.
   local bmp = obj.new('image', { path=glDataFolder .. 'data/basn0g16.png' }).bitmap
   local d = bmp.data
   for x in {0 to 3} do
      local sample = d[x * 2] | (d[(x * 2) + 1] << 8)
      local rgb = mGfx.ReadRGBPixel(bmp, x, 0)
      local red, green, blue = rgb.red, rgb.green, rgb.blue -- Copy before the next read reuses the buffer
      assert(red is sample >> 8, f'x={x}: expected red {sample >> 8}, got {red}')
      assert((red is green) and (green is blue), f'x={x}: expected equal channels')
   end
end

@Test global function Greyscale16ExactTransparencyKey()
   -- tbwn0g16 has a 16-bit tRNS key of 0xffff, tbbn0g04 a 4-bit key of 0xf, which also expands to 0xffff.
   local bmp = obj.new('image', { path=glDataFolder .. 'data/tbwn0g16.png' }).bitmap
   assert(bmp.transIndex is 0xffff, 'tbwn0g16: expected transIndex 0xffff, got ' .. formatHash(bmp.transIndex))
   assert(bmp.transColour.red is 255, 'tbwn0g16: expected transColour 255, got ' .. bmp.transColour.red)

   bmp = loadPreset('data/tbbn0g04.png', { flags=BMF_GREYSCALE }).bitmap
   assert(bmp.transIndex is 0xffff, 'tbbn0g04: expected transIndex 0xffff, got ' .. formatHash(bmp.transIndex))
end

@Test global function TransparencyKeyScalesToEightBits()
   -- A 4-bit key of 0xf is expanded in the same way as the pixel data, giving 255.
   local bmp = obj.new('image', { path=glDataFolder .. 'data/tbbn0g04.png' }).bitmap
   assert(bmp.transColour.red is 255, 'Expected transColour 255, got ' .. bmp.transColour.red)
end

@Test global function ColourSourcesIgnoreGreyscale16()
   local bmp = obj.new('image', { path=glDataFolder .. 'data/basn2c16.png' }).bitmap
   assert(not (bmp.flags has BMF_GREYSCALE), 'Colour sources must not load as greyscale')
   local hash = mSys.GenCRC32(0, bmp.data, bmp.size)
   assert(hash is 0xc4c4f721, 'Colour source changed: ' .. formatHash(hash))
end

@Test global function PresetGreyscaleConvertsColourToLuminance()
   local colour = obj.new('image', { path=glDataFolder .. 'data/basn2c08.png' }).bitmap
   local grey = loadPreset('data/basn2c08.png', { flags=BMF_GREYSCALE }).bitmap
   assert(grey.bitsPerPixel is 16, 'Expected 16 bits per pixel, got ' .. grey.bitsPerPixel)
   assert(grey.flags has BMF_GREYSCALE, 'Expected BMF_GREYSCALE')

   local d = grey.data
   for pt in values(array<table> { { 0, 0 }, { 7, 3 }, { 20, 11 }, { 31, 31 } }) do
      local x, y = pt[0], pt[1]
      local rgb = mGfx.ReadRGBPixel(colour, x, y)
      local r, g, b = rgb.red, rgb.green, rgb.blue
      local expected = (((r * 13933) + (g * 46871) + (b * 4732)) * 257) >> 16
      local i = (y * grey.lineWidth) + (x * 2)
      local sample = d[i] | (d[i+1] << 8)
      assert(sample is expected, f'({x},{y}) rgb {r},{g},{b}: expected {expected}, got {sample}')
   end
end

@Test global function ForceAlpha32OverridesAsIsLoading()
   local bmp = obj.new('image', { path=glDataFolder .. 'data/basn4a16.png', flags=PCF_FORCE_ALPHA_32 }).bitmap
   assert(bmp.bitsPerPixel is 32, 'FORCE_ALPHA_32 must select 32-bit, got ' .. bmp.bitsPerPixel .. ' bpp')
   assert(not (bmp.flags has BMF_GREYSCALE), 'Unexpected BMF_GREYSCALE')
end

@Test global function PresetGreyscaleOverridesForceAlpha32()
   local pic = loadPreset('data/basn4a16.png', { flags=BMF_GREYSCALE }, PCF_FORCE_ALPHA_32)
   assertGreyscale16(pic, glGreyscale16PNG[3])
end

@Test global function PresetGreyscalePreservesPaletteTransparency()
   local pic = loadPreset('data/tm3n3p02.png', { flags=BMF_GREYSCALE }, PCF_FORCE_ALPHA_32)
   assert(pic.mask, 'Expected a mask for the palette alpha values')
   assert(mSys.GenCRC32(0, pic.mask.data, pic.mask.size) is 0xb53eaecb, 'Palette alpha changed')

   local source = obj.new('image', { path=glDataFolder .. 'data/tp1n3p08.png' })
   local indexed = source.bitmap
   pic = loadPreset('data/tp1n3p08.png', { flags=BMF_GREYSCALE }, PCF_FORCE_ALPHA_32)
   local mask = pic.mask
   assert(mask, 'Expected a mask for the transparent palette index')
   assert(not (pic.bitmap.flags has BMF_TRANSPARENT), 'The mask should provide transparency')
   -- tp1n3p08 declares palette index 0 transparent.
   for y in {0 to indexed.height} do
      for x in {0 to indexed.width} do
         local index = indexed.data[(y * indexed.lineWidth) + x]
         local expected = index is 0 ? 0 : 255
         assert(mask.data[(y * mask.lineWidth) + x] is expected, f'Wrong alpha at {x},{y}')
      end
   end
end

@Test global function Greyscale16SaveRoundTrip()
   local path = f'{glResultFolder}roundtrip_{processing.task().id}_{mSys.PreciseTime()}.png'
   defer mSys.DeleteFile(path) end

   local entries = array<table> {
      { src='data/basn0g16.png', crc=0x2ab15133, gamma_crc=0x630db2ea },
      { src='data/g03n0g16.png', crc=0x1c3c33ca, gamma_crc=0x8433a124 },
      glGreyscale16PNG[3],
      { src='data/tbwn0g16.png', crc=0x5e02d81b, trans_index=0xffff }
   }

   for entry in values(entries) do
      local pic = obj.new('image', { path=glDataFolder .. entry.src })
      do
         local file <close> = obj.new('file', { path=path, flags=FL_NEW|FL_WRITE })
         check pic.acSaveImage(file)
      end

      local saved = obj.new('image', { path=path })
      assertGreyscale16(saved, entry)
      if entry.trans_index then
         assert(saved.bitmap.flags has BMF_TRANSPARENT, 'Expected colour-key transparency')
         assert(saved.bitmap.transIndex is entry.trans_index, 'The saved transparency key changed')
      end

      if entry.gamma_crc then
         local converted = obj.new('image', { path=path, flags=PCF_LAZY })
         converted.bitmap.bitsPerPixel = 8
         check converted.acActivate()
         local bmp = converted.bitmap
         local hash = mSys.GenCRC32(0, bmp.data, bmp.size)
         assert(hash is entry.gamma_crc, f'{entry.src}: gamma-corrected output changed to {formatHash(hash)}')
      end
   end
end

@Test global function Greyscale16QueryReportsFormat()
   local pic = obj.new('image', { path=glDataFolder .. 'data/basn0g16.png', flags=PCF_LAZY })
   assert(pic.acQuery() is ERR_Okay, 'Query failed')
   assert(pic.bitmap.bitsPerPixel is 16, 'Query should report 16 bits per pixel, got ' .. pic.bitmap.bitsPerPixel)
   assert(pic.bitmap.flags has BMF_GREYSCALE, 'Query should set BMF_GREYSCALE')

   assert(pic.acActivate() is ERR_Okay, 'Activate failed')
   assertGreyscale16(pic, glGreyscale16PNG[0])
end
