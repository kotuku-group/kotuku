@Test; @Requires(windows_platform=true)
function MoveFileReplacesOpenDestination()
   src_path = glTempRoot .. 'move_open_source.tmp'
   dest_path = glTempRoot .. 'move_open_dest.tmp'
   old_content = 'Original destination content'
   new_content = 'Replacement content'
   mSys.DeleteFile(src_path)
   mSys.DeleteFile(dest_path)

   writeFile(src_path, new_content)
   writeFile(dest_path, old_content)

   local old_reader <close> = obj.new('file', { path=dest_path, flags=FL_READ })
   err = mSys.MoveFile(src_path, dest_path)
   assert(err is ERR_Okay, 'MoveFile() should replace a destination that has an open reader: ' .. mSys.GetErrorMsg(err))

   old_buffer = string.alloc(#old_content)
   err, result = old_reader.acRead(old_buffer)
   assert(err is ERR_Okay, 'The existing destination reader should remain readable: ' .. mSys.GetErrorMsg(err))
   assert(result is #old_content, 'The existing destination reader returned an unexpected byte count.')
   assert(old_buffer.sub(0, result) is old_content,
      'The existing destination reader should retain the original file content.')

   err = mSys.AnalysePath(src_path)
   assert(err != ERR_Okay, 'MoveFile() should remove the replacement source file.')
   assert(readFile(dest_path) is new_content, 'New readers should observe the replacement file content.')
end

