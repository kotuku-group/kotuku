@Test function FileIcons()
   if mSys.AnalysePath('icons:') != ERR_Okay then
      -- Icons not available, skip test
      return
   end

   icon_pairs = {
      { path='fonts:fonts.cfg',            icon='icons:filetypes/text' },
      { path='fonts:truetype/Micro-6.ttf', icon='icons:filetypes/font' },
      { path='temp:filesystem_tests/source.tiri',           icon='icons:filetypes/source' }
   }

   for v in values(icon_pairs) do
      local icon
      try
         icon = obj.new('file', { path=v.path }).icon
      except ex
         raise f'Failed to open path {v.path}: {ex.message}'
      success
         if icon != v.icon then
            raise f'Icon for {v.path} evaluated to {icon} instead of expected "{v.icon}"'
         end
      end
   end
end

