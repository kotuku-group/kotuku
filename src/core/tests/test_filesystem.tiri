@Test function WatchRootFolder()
   local folder <close> = obj.new('file', { path='drive1:' })

   local err = folder.mtWatch(function(File, Path, Flags) return ERR_Okay end, MFF_CREATE)
   if err is ERR_NoSupport then
      return 'Host platform does not support file system watching.'
