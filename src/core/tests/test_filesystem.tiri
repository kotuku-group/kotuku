@Test function RenameRejectsAncestorNames()
   root = glTempRoot .. 'rename_ancestor/'
   source = root .. 'parent/before/'
   mSys.DeleteFile(root)
   ensureFolder(source)
   writeFile(source .. 'child.txt', 'Source content')
   writeFile(root .. 'parent/child.txt', 'Parent content')
   writeFile(root .. 'child.txt', 'Grandparent content')

   folder = obj.new('file', { path=source })
   for name in values(array<str> { '.', '..', 'elsewhere/./', 'elsewhere/../' }) do
      err = folder.acRename(name)
      assert(err is ERR_Args, 'acRename() must reject ancestor name: ' .. name)
      assert(folder.path is source, 'Rejected rename changed the folder path.')
      assert(readFile(source .. 'child.txt') is 'Source content', 'Rejected rename changed the source content.')
      assert(readFile(root .. 'parent/child.txt') is 'Parent content', 'Rejected rename overwrote parent content.')
      assert(readFile(root .. 'child.txt') is 'Grandparent content', 'Rejected rename overwrote grandparent content.')
   end
   folder.free()

   mSys.DeleteFile(root)
end

