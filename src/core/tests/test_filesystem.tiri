-- acRename() must keep the file in its folder.  A regression dropped the folder separator, moving 'dir/a' to 'dirb'.

@Test function RenameFile()
   folder = glTempRoot .. 'rename_file/'
   mSys.DeleteFile(folder)
   ensureFolder(folder)
   writeFile(folder .. 'before.txt', 'Renamed content')

   file = obj.new('file', { path=folder .. 'before.txt' })
   err = file.acRename('after.txt')
   assert(err is ERR_Okay, 'acRename() failed: ' .. mSys.GetErrorMsg(err))
   assert(file.path is folder .. 'after.txt', 'Path not updated after rename, got: ' .. file.path)
   file.free()

   assert(mSys.AnalysePath(folder .. 'before.txt') != ERR_Okay, 'The original file must no longer exist.')
   assert(mSys.AnalysePath(glTempRoot .. 'rename_fileafter.txt') != ERR_Okay, 'Renamed file escaped its folder.')
   assert(readFile(folder .. 'after.txt') is 'Renamed content', 'Renamed file is missing or its content changed.')

   -- Any path in the new name is ignored; only the leaf is used.

   file = obj.new('file', { path=folder .. 'after.txt' })
   err = file.acRename('elsewhere/leaf.txt')
   assert(err is ERR_Okay, 'acRename() with a path in the name failed: ' .. mSys.GetErrorMsg(err))
   file.free()
   assert(readFile(folder .. 'leaf.txt') is 'Renamed content', 'Leaf of the new name was not used.')

   mSys.DeleteFile(folder)
end

