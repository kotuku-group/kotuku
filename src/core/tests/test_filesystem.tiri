@Test function CopyFile()
   src_path = glTempRoot .. 'copy_source.tmp'
   dest_path = glTempRoot .. 'copy_dest.tmp'
   callback_hits = 0

   mSys.DeleteFile(src_path)
   mSys.DeleteFile(dest_path)

   writeFile(src_path, 'Copied content')

   err = mSys.CopyFile(src_path, dest_path, function(Size, Position, Path, Dest, User, FeedbackID)
      callback_hits++
      return FFR_OKAY
   end)

   assert(err is ERR_Okay, 'CopyFile() failed: ' .. mSys.GetErrorMsg(err))
   assert(callback_hits > 0, 'CopyFile() callback was not invoked.')
   assert(readFile(dest_path) is 'Copied content', 'CopyFile() did not preserve the source file content.')
end

----------------------------------------------------------------------------------------------------------------------

@Test function CopyFileFeedbackPayloads()
   src_path = glTempRoot .. 'copy_feedback_source.tmp'
   dest_path = glTempRoot .. 'copy_feedback_dest.tmp'
   writeFile(src_path, 'Feedback payload')

   for result in values(array<int> { FFR_SKIP, FFR_ABORT }) do
      mSys.DeleteFile(dest_path)
      hits = 0
      err = mSys.CopyFile(src_path, dest_path, function(Size, Position, Path, Dest, FeedbackID, Extra):num
         assert(Extra is nil, 'The explicit result sink must not become a callback argument')
         hits++
         return result
      end)
      assert(hits > 0, 'CopyFile() must invoke its feedback callback')
      if result is FFR_ABORT then
         assert(err is ERR_Cancelled, 'FFR_ABORT must cancel the copy rather than become an ERR code')
      else
         assert(err is ERR_Okay, 'FFR_SKIP must skip the copy without an error')
      end
      err = mSys.AnalysePath(dest_path)
      assert(err != ERR_Okay, 'Skipped or aborted copies must not create the destination')
   end
end

