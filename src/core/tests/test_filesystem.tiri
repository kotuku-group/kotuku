@Test function ReadFileToBuffer()
   read_path = glTempRoot .. 'buffer_read.txt'
   expected = 'Buffer content'

   mSys.DeleteFile(read_path)
   writeFile(read_path, expected)

   buffer = array<byte, #expected>
   err, result = mSys.ReadFileToBuffer(read_path, buffer)
   assert(err is ERR_Okay, 'ReadFileToBuffer() failed: ' .. mSys.GetErrorMsg(err))
   assert(result is #expected, 'ReadFileToBuffer() returned an incorrect byte count.')
   assert(buffer.getString() is expected, 'ReadFileToBuffer() did not return the expected text.')

   approx_buffer = array<byte, #expected>
   err = mSys.ReadFileToBuffer('~' .. glTempRoot .. 'buffer_read', approx_buffer)
   assert(err is ERR_Okay, 'ReadFileToBuffer() failed for an approximated path: ' .. mSys.GetErrorMsg(err))
   assert(approx_buffer.getString() is expected, 'ReadFileToBuffer() did not resolve the approximated path correctly.')

   string_buffer = string.alloc(#expected)
   err = mSys.ReadFileToBuffer(read_path, string_buffer)
   assert(err is ERR_Okay, 'ReadFileToBuffer() failed for a mutable string buffer: ' .. mSys.GetErrorMsg(err))
   assert(string_buffer.sub(0, #expected) is expected, 'ReadFileToBuffer() did not fill the mutable string buffer.')

   try
      mSys.ReadFileToBuffer(read_path, 'literal')
   success
      assert(false, 'ReadFileToBuffer() should reject interned strings for mutable buffers')
   end

   wrong_type = array<int, #expected>
   try
      mSys.ReadFileToBuffer(read_path, wrong_type)
   success
      assert(false, 'ReadFileToBuffer() should reject an array with the wrong element type')
   end
end

