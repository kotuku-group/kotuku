@Test function MoveSymbolicLink()
   source = glTempRoot .. 'move_link_source.txt'
   link = glTempRoot .. 'move_link_source.link'
   moved_link = glTempRoot .. 'move_link_destination.link'

   mSys.DeleteFile(link)
   mSys.DeleteFile(moved_link)
   writeFile(source, 'Move link content')

   err = mSys.CreateLink(link, source)
   if err is ERR_NoSupport then
      return 'Host platform does not support symbolic link creation.'
   end

   if err is ERR_NoPermission then
      return 'Symbolic link creation is blocked for the current user or host policy.'
   end

   assert(err is ERR_Okay, 'CreateLink() failed for the move test: ' .. mSys.GetErrorMsg(err))

   err = mSys.MoveFile(link, moved_link)
   assert(err is ERR_Okay, 'MoveFile() failed to move a symbolic link: ' .. mSys.GetErrorMsg(err))
   assert(mSys.AnalysePath(link, nil) != ERR_Okay, 'MoveFile() left the source symbolic link in place.')
   assert(readFile(moved_link) is 'Move link content', 'The moved symbolic link does not resolve to its target.')
   assert(readFile(source) is 'Move link content', 'MoveFile() moved the link target instead of the link.')

   err = mSys.DeleteFile(moved_link)
   assert(err is ERR_Okay, 'DeleteFile() failed to remove the moved symbolic link: ' .. mSys.GetErrorMsg(err))
   assert(readFile(source) is 'Move link content', 'Removing the moved link also removed its target.')
end

