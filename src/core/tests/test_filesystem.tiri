@Test function RenameFolder()
   root = glTempRoot .. 'rename_folder/'
   mSys.DeleteFile(root)
   ensureFolder(root .. 'before/')
   writeFile(root .. 'before/child.txt', 'Child content')

   folder = obj.new('file', { path=root .. 'before/' })
   err = folder.acRename('after/')
   assert(err is ERR_Okay, 'acRename() failed for a folder: ' .. mSys.GetErrorMsg(err))
   assert(folder.path is root .. 'after/', 'Folder path not updated after rename, got: ' .. folder.path)
   folder.free()

   local err, type = mSys.AnalysePath(root .. 'after/')
   assert(err is ERR_Okay and type is LOC_FOLDER, 'Renamed folder does not exist in its parent.')
   assert(mSys.AnalysePath(root .. 'before/') != ERR_Okay, 'The original folder must no longer exist.')
   assert(readFile(root .. 'after/child.txt') is 'Child content', 'Folder content was not preserved.')

   mSys.DeleteFile(root)
end

