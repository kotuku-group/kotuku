-- Language-level membership tests for `Candidate in Target` and __contains dispatch.

struct ContainsStruct
   Present: int
end

@BeforeEach(hotpath=40)
function enforce_hotpath() end

-- JIT control is restored here rather than in a defer: a defer that runs while an exception unwinds is restricted as
-- for __gc, so jit.on() would raise 'Bad action while in __gc metamethod' and replace the original failure.
@AfterEach
function restore_jit()
   jit.on()
end

function builtin_array_membership_workload(Values:array<int>, Count:num):num
   local matches = 0
   for index in {0 to Count} do
      if 4 in Values then matches++ end
      if not (9 in Values) then matches++ end
   end
   return matches
end

function generic_array_membership_workload(Values:array<any>, Candidate:any, Count:num):num
   local matches = 0
   for index in {0 to Count} do
      if Candidate in Values then matches++ end
   end
   return matches
end

function numeric_array_membership_workload(Values:array<any>, Present:num, Missing:num, Count:num):num
   local matches = 0
   for _ in {0 to Count} do
      if Present in Values then matches++ end
      if not (Missing in Values) then matches++ end
   end
   return matches
end

function numeric_membership_call_address(Values:array<any>, Candidate:num):any
   jit.on()
   jit.flush()
   jit.opt.start('hotloop=2', 'hotexit=1', 'minstitch=0')
   generic_array_membership_workload(Values, Candidate, 100)

   jit.off()
   local address:any
   for trace_no in {1 into 40} do
      local info = jit.util.traceInfo(trace_no)
      -- Inspect the membership loop, excluding helper calls in return and exit traces.
      if info is nil or info.linktype != 'loop' then continue end

      for instruction in {1 into info.nins} do
         local _, ir_ot, _, call_id = jit.util.traceIR(trace_no, instruction)
         if ir_ot != nil and (ir_ot >> 8) is 98 then
            local call_address = jit.util.irCallAddr(call_id)
            if call_address != nil then address = call_address end
         end
      end
   end
   jit.on()
   jit.opt.start()
   return address
end

function builtin_struct_membership_workload(Value:struct<ContainsStruct>, Count:num):num
   local matches = 0
   for index in {0 to Count} do
      if 'Present' in Value then matches++ end
      if not ('Missing' in Value) then matches++ end
   end
   return matches
end

@Test function PlainTablesUseRawKeyPresence()
   local values = { ready=false, present=true }
   assert('ready' in values, 'A false table value must still count as present')
   assert('present' in values, 'A non-nil table value must count as present')
   assert(not ('missing' in values), 'A missing table key must be absent')

   local index_calls = 0
   local proxy = setmetatable({}, {
      __index = function(Key):str
         index_calls++
         return Key
      end
   })
   assert(not ('generated' in proxy), 'Table membership must not use __index')
   assert(index_calls is 0, 'The raw table fallback must not invoke __index')

   local ignored = { contains = function(Value) return true end }
   assert(not ('needle' in ignored), 'An ordinary contains field must not affect the operator')
end

@Test function TableHandlersReceiveContextAndCandidate()
   local colours:any
   local set_mt = {
      __contains = function(Value):any
         assert(&& is colours, '__contains must enter the selected table context')
         return &items[Value]
      end
   }
   colours = setmetatable({ items = { red=true, green=true } }, set_mt)

   local red = 'red' in colours
   local blue = 'blue' in colours
   assert(red is true and blue is false, '__contains should determine table membership')

   local truthy = setmetatable({}, { __contains = function(Value:any):any return Value end })
   assert('value' in truthy, 'Truthy handler results must normalise to true')
   assert(not (false in truthy), 'False handler results must normalise to false')
end

@Test function BuiltinTargetsUseMembershipHandlers()
   local numbers = array<int> { 2, 4, 6 }
   local struct_value = struct<ContainsStruct> { }
   assert(4 in numbers and not (5 in numbers), 'Array membership must remain value based')
   assert(5 in {0 to 10} and not (10 in {0 to 10}), 'Range boundaries must remain unchanged')
   assert('tuk' in 'Kōtuku' and not ('xyz' in 'Kōtuku'), 'String membership must remain substring based')
   assert('Present' in struct_value and not ('Missing' in struct_value),
      'Struct membership must use field presence rather than field values')
end

@Test function MutableStringArrayMembershipUsesContent()
   local first = string.alloc(3)
   local equal = string.alloc(3)
   local shorter = string.alloc(2)
   local values = array<str, 3>
   values[1] = first

   assert(not (first is equal), 'Separately allocated mutable strings must have distinct identities')
   assert(equal in values,
      'Mutable strings with equal embedded-NUL content must compare by bytes during array membership')
   assert(values.indexOf(equal) is 1,
      'Mutable-string indexOf() must share membership content semantics')
   assert(not (shorter in values), 'Mutable strings with different lengths must not compare equal')

   local mutable_empty = string.alloc(0)
   local interned_empty_values = array<str> { '' }
   local mutable_empty_values = array<str> { mutable_empty }
   assert(mutable_empty in interned_empty_values,
      'A mutable string must match an equal ordinary interned string')
   assert('' in mutable_empty_values,
      'An ordinary interned string must match an equal mutable array element')

   local matches = 0
   for _ in {0 to 100} do
      if equal in values then matches++ end
      if mutable_empty in interned_empty_values then matches++ end
      if '' in mutable_empty_values then matches++ end
   end
   assert(matches is 300, 'Mutable-string content equality must remain stable after JIT warming')
end

@Test function VariantArrayMembershipUsesEqualitySemantics()
   local equality_mt = {
      __eq = function(Other:table!):bool return &id is Other.id end
   }
   local first = setmetatable({ id=1 }, equality_mt)
   local second = setmetatable({ id=2 }, equality_mt)
   local probe = setmetatable({ id=2 }, equality_mt)
   local values = array<any> { first, second }

   assert(first in values, 'Variant array membership should find an identical reference')
   assert(probe in values,
      'Variant array membership should honour reference equality metamethods')
   assert(not (setmetatable({ id=3 }, equality_mt) in values),
      'Variant array membership should reject a non-matching reference')

   local plain = { id=4 }
   local plain_values = array<any> { plain }
   assert(plain in plain_values and not ({ id=4 } in plain_values),
      'Variant array membership should use identity when no equality metamethod exists')

   local matches = 0
   for _ in {0 to 100} do
      if probe in values then matches++ end
   end
   assert(matches is 100, 'Variant array membership should remain correct after reaching the JIT threshold')
end

@Test function VariantArrayMembershipRootsCandidateAcrossStackGrowth()
   function grow_stack(Depth:num):bool
      if Depth is 0 then return true end
      return grow_stack(Depth - 1)
   end

   local equality_mt = {
      __eq = function(Other:table!):bool
         if &id is 1 then grow_stack(500) end
         return &id is Other.id
      end
   }
   local first = setmetatable({ id=1 }, equality_mt)
   local second = setmetatable({ id=2 }, equality_mt)
   local probe = setmetatable({ id=2 }, equality_mt)
   local items = array<any> { first, second }

   assert(probe in items,
      'Variant array membership should retain its candidate when an earlier comparison relocates the stack')
end

function interpreted_variant_membership(Items:array<any>, Probe:table):bool
   local v00, v01, v02, v03, v04, v05, v06, v07 = 0, 1, 2, 3, 4, 5, 6, 7
   local v08, v09, v10, v11, v12, v13, v14, v15 = 8, 9, 10, 11, 12, 13, 14, 15
   local v16, v17, v18, v19, v20, v21, v22, v23 = 16, 17, 18, 19, 20, 21, 22, 23
   local v24, v25, v26, v27, v28, v29, v30, v31 = 24, 25, 26, 27, 28, 29, 30, 31
   local found = Probe in Items
   assert(v00 is 0 and v07 is 7 and v15 is 15 and v23 is 23 and v31 is 31,
      'Interpreted membership should preserve live frame slots')
   return found
end

@Test function InterpretedVariantMembershipSynchronisesVMTop()
   jit.off()

   local equality_mt = {
      __eq = function(Other:table!):bool return &id is Other.id end
   }
   local first = setmetatable({ id=1 }, equality_mt)
   local second = setmetatable({ id=2 }, equality_mt)
   local probe = setmetatable({ id=2 }, equality_mt)
   local items = array<any> { first, second }

   assert(interpreted_variant_membership(items, probe),
      'Interpreted variant membership should enter re-entrant equality with a valid VM top')
end

@Test function LegacyBuiltinMembershipApisAreUnavailable()
   assert(array.contains is nil and string.contains is nil and range.contains is nil,
      'Built-in membership APIs must not remain publicly callable')

   local values = array<int> { 1 }
   local available = false
   try
      values.contains(1)
      available = true
   end
   assert(not available, 'Array instances must not retain a contains method')
end

@Test function MembershipEvaluatesCandidateBeforeTargetOnce()
   local events = array<str> {}
   function candidate():str
      events.push('candidate')
      return 'key'
   end
   function target():table
      events.push('target')
      return { key=true }
   end

   assert(candidate() in target(), 'The returned key should be present')
   assert(events[0] is 'candidate' and events[1] is 'target' and #events is 2,
      'Membership operands must evaluate once in source order')
end

@Test function MembershipRunsInHotCode()
   local target = setmetatable({}, { __contains = function(Value:any):bool return Value is 'needle' end })
   local matches = 0
   for index in {0 to 200} do
      if 'needle' in target then matches++ end
   end
   assert(matches is 200, 'Membership should retain its result after JIT compilation')
end

@Test function StructMembershipRunsInHotCode()
   local value = struct<ContainsStruct> { }
   assert(builtin_struct_membership_workload(value, 200) is 400,
      'Struct membership should preserve presence and negation after JIT compilation')
end

@Test function StructContainsMutationUsesGenericDispatch()
   local value = struct<ContainsStruct> { }
   local canonical_handler = struct.__contains
   defer struct.__contains = canonical_handler end

   struct.__contains = function(Target:struct<ContainsStruct>, Candidate:any):bool
      return Candidate is 'replacement'
   end
   assert('replacement' in value and not ('Present' in value),
      'Replacing struct.__contains should change generic membership dispatch')
end

@Test function BuiltinArrayMembershipUsesNativeTrace()
   jit.on()
   jit.flush()
   jit.opt.start('hotloop=2', 'hotexit=1', 'minstitch=0')

   local values = array<int> { 2, 4, 6, 8 }
   assert(builtin_array_membership_workload(values, 100) is 200,
      'Built-in array membership should preserve in and negated-in results on trace')

   jit.off()
   local native_calls = 0
   for trace_no in {1 into 40} do
      local info = jit.util.traceInfo(trace_no)
      if info is nil then continue end

      for instruction in {1 into info.nins} do
         local _, ir_ot, _, call_id = jit.util.traceIR(trace_no, instruction)
         if ir_ot != nil and (ir_ot >> 8) is 98 and jit.util.irCallAddr(call_id) != nil then native_calls++ end
      end
   end
   jit.on()
   jit.opt.start()

   assert(native_calls > 0, 'Canonical array membership should lower to a native side-effecting helper call')
end

@Test function NumericArrayRepresentationsUseNativeMembership()
   assert(numeric_array_membership_workload(array<int8> { -128, 0, 127 }, 127, 12, 100) is 200,
      'Signed eight-bit membership failed after JIT warming')
   assert(numeric_array_membership_workload(array<byte> { 0, 7, 255 }, 255, 12, 100) is 200,
      'Byte membership failed after JIT warming')
   assert(numeric_array_membership_workload(array<uint8> { 0, 7, 255 }, 255, 12, 100) is 200,
      'Unsigned eight-bit membership failed after JIT warming')
   assert(numeric_array_membership_workload(array<int16> { -32768, 0, 32767 }, 32767, 12, 100) is 200,
      'Signed sixteen-bit membership failed after JIT warming')
   assert(numeric_array_membership_workload(array<uint16> { 0, 7, 65535 }, 65535, 12, 100) is 200,
      'Unsigned sixteen-bit membership failed after JIT warming')
   assert(numeric_array_membership_workload(array<int> { -2147483648, 0, 2147483647 }, 2147483647, 12, 100) is 200,
      'Signed integer membership failed after JIT warming')
   assert(numeric_array_membership_workload(array<uint> { 0, 7, 4294967295 }, 4294967295, 12, 100) is 200,
      'Unsigned integer membership failed after JIT warming')
   assert(numeric_array_membership_workload(array<int64> { -9007199254740991, 7, 9007199254740991 },
      9007199254740991, 12, 100) is 200, 'Signed 64-bit membership failed after JIT warming')
   assert(numeric_array_membership_workload(array<uint64> { 0, 17, 9007199254740991 }, 9007199254740991, 12, 100)
      is 200, 'Unsigned 64-bit membership failed after JIT warming')
   assert(numeric_array_membership_workload(array<float> { -1.25, 0.0, 7.5 }, 7.5, 12.0, 100) is 200,
      'Float membership failed after JIT warming')
   assert(numeric_array_membership_workload(array<double> { -1.25, 0.0, 7.5 }, 7.5, 12.0, 100) is 200,
      'Double membership failed after JIT warming')

   assert(7.75 in array<int> { 7 }, 'Integral membership should retain numeric truncation semantics')
   assert(not (7.75 in array<double> { 7.0 }), 'Floating-point membership should retain exact-value semantics')

   local nan = 0 / 0
   assert(0.0 in array<float> { -0.0, nan } and not (nan in array<float> { -0.0, nan }),
      'Float membership should equate signed zero and reject NaN')
   assert(0.0 in array<double> { -0.0, nan } and not (nan in array<double> { -0.0, nan }),
      'Double membership should equate signed zero and reject NaN')
end

@Test function NumericArrayRepresentationsUseDistinctTraceCalls()
   local integer_address = numeric_membership_call_address(array<int> { 2, 4, 6 }, 4)
   local double_address = numeric_membership_call_address(array<double> { 2.0, 4.0, 6.0 }, 4.0)
   assert(integer_address != nil and double_address != nil,
      'Numeric membership traces must contain native helper calls')
   assert(integer_address != double_address,
      'Integer and double membership traces must call representation-specific helpers')
end

@Test function BuiltinArrayMembershipGuardsElementType()
   jit.on()
   jit.flush()
   jit.opt.start('hotloop=2', 'hotexit=1', 'minstitch=0')

   local strings = array<str> { '2', '4', '6' }
   local integers = array<int> { 2, 4, 6 }
   assert(generic_array_membership_workload(strings, '4', 100) is 100,
      'String array membership should warm the generic-array trace')
   assert(generic_array_membership_workload(integers, '4', 100) is 100,
      'A reused trace must not treat numeric array storage as strings')

   jit.flush()
   assert(generic_array_membership_workload(integers, 4, 100) is 100,
      'Numeric array membership should warm the generic-array trace')
   assert(generic_array_membership_workload(strings, 4, 100) is 100,
      'A reused trace must retain numeric coercion for string arrays')

   jit.opt.start()
end

@Test function ArrayContainsMutationLeavesCanonicalFastPath()
   jit.on()
   jit.flush()
   jit.opt.start('hotloop=2', 'hotexit=1', 'minstitch=0')

   local values = array<int> { 2, 4, 6, 8 }
   assert(builtin_array_membership_workload(values, 100) is 200,
      'The canonical array handler should warm successfully before mutation')

   local metatable = getmetatable(values)
   local canonical_handler = metatable.__contains
   defer metatable.__contains = canonical_handler end

   metatable.__contains = function(Target:array<int>, Candidate:num):bool
      return Candidate is 9
   end
   assert(not (4 in values) and 9 in values,
      'Changing __contains should side-exit and select the custom array handler')

   jit.opt.start()
end

-- Counts the candidates that are in Values, and separately those reported by the negated form.  Both must agree with
-- indexOf() whichever result the trace was recorded with.

function mixed_membership_workload(Values:array<any>, Candidates:array<any>):<num, num>
   local hits, negated_hits = 0, 0
   for _, candidate in Candidates do
      if candidate in Values then hits++ end
      if not (candidate in Values) then negated_hits++ end
   end
   return hits, negated_hits
end

function mixed_membership_check(Values:array<any>, Candidates:array<any>, Label:str)
   jit.on()
   jit.flush()
   jit.opt.start('hotloop=2', 'hotexit=1', 'minstitch=0')
   defer jit.opt.start() end

   local expected = 0
   for _, candidate in Candidates do
      if Values.indexOf(candidate) != nil then expected++ end
   end

   local hits, negated_hits = mixed_membership_workload(Values, Candidates)
   assert(hits is expected and negated_hits is #Candidates - expected,
      f'{Label}: expected {expected} hits, got {hits} and {#Candidates - negated_hits} from the negated form')
end

@Test function TracesRecordedOnAMissAcceptLaterHits()
   local strings = array<str> { 'specular', 'diffuse' }
   local misses_first, hits_first = array<str>, array<str>
   for i in {0 to 40} do misses_first.push('bright') end
   for i in {0 to 40} do misses_first.push((i % 2 is 0) ? 'specular' : 'diffuse') end
   for i in {0 to 40} do hits_first.push(misses_first[79 - i]) end
   for i in {0 to 40} do hits_first.push('bright') end
   mixed_membership_check(strings, misses_first, 'String misses then hits')
   mixed_membership_check(strings, hits_first, 'String hits then misses')

   local integers, numbers = array<int> { 2, 4, 6 }, array<double> { 2.5, 4.5 }
   local int_candidates, double_candidates = array<int>, array<double>
   for i in {0 to 40} do int_candidates.push(9) end
   for i in {0 to 40} do int_candidates.push(4) end
   for i in {0 to 40} do double_candidates.push(9.5) end
   for i in {0 to 40} do double_candidates.push(4.5) end
   mixed_membership_check(integers, int_candidates, 'Integer misses then hits')
   mixed_membership_check(numbers, double_candidates, 'Double misses then hits')

   local numeric_strings = array<str>
   for i in {0 to 40} do numeric_strings.push('9') end
   for i in {0 to 40} do numeric_strings.push('4') end
   mixed_membership_check(integers, numeric_strings, 'Numeric strings in an integer array')

   local string_numbers = array<int>
   for i in {0 to 40} do string_numbers.push(9) end
   for i in {0 to 40} do string_numbers.push(2) end
   mixed_membership_check(array<str> { '2', '4' }, string_numbers, 'Numbers in a string array')
end

-- A rejected membership candidate used to be raised by lj_err_argv() at the stale VM-owned top, which overwrote the
-- lowest slots of a top-level chunk.  exec() runs Source as a chunk so the locals occupy those slots.

function rejected_chunk_membership(Values:str, Test:str):<any, any, any, any, any>
   return exec('local values = ' .. Values .. '\n' .. [[
      local a, b, c = 10, 20, 30
      local message
      try
   ]] .. Test .. '\n' .. [[
      except ex
         message = ex.message
      end
      return type(values), a, b, c, message
   ]])
end

function check_rejected_chunk_membership(Values:str, Test:str, Expected:str)
   local values_type, a, b, c, message = rejected_chunk_membership(Values, Test)
   assert(values_type is 'array' and a is 10 and b is 20 and c is 30,
      f'{Test}: locals were overwritten: {values_type}, {a}, {b}, {c}')
   assert(message is Expected, f'{Test}: unexpected message: {message}')
end

@Test function RejectedCandidatesPreserveTopLevelLocals()
   check_rejected_chunk_membership('array<int> { 1, 2 }', "if 'abc' in values then end",
      'Membership test expected number, got string')
   check_rejected_chunk_membership('array<int> { 1, 2 }', "if not ('abc' in values) then end",
      'Membership test expected number, got string')
   check_rejected_chunk_membership('array<int> { 1, 2 }', "local found = 'abc' in values",
      'Membership test expected number, got string')
   check_rejected_chunk_membership("array<obj> { obj.new('config') }", "if not ('abc' in values) then end",
      'Membership test expected object or uid, got string')
   check_rejected_chunk_membership("array<str> { 'x' }", 'if {} in values then end',
      'Membership test expected string, got table')
end

function interpreted_rejected_membership(Values:array<int>, Candidate:any):<str, bool>
   local v00, v01, v02, v03, v04, v05, v06, v07 = 0, 1, 2, 3, 4, 5, 6, 7
   local message
   try
      if Candidate in Values then end
   except ex
      message = ex.message
   end
   local intact = v00 is 0 and v01 is 1 and v02 is 2 and v03 is 3 and v07 is 7 and type(Values) is 'array'
   return message, intact
end

@Test function RejectedCandidatesRaiseTypeMismatch()
   jit.off()

   local message, intact = interpreted_rejected_membership(array<int> { 1, 2 }, 'abc')
   assert(intact, 'A rejected membership candidate should preserve live frame slots')
   assert(message is 'Membership test expected number, got string', f'Unexpected message: {message}')

   local code
   try
      if 'abc' in array<double> { 1.5 } then end
   except ex
      code = ex.code
   end
   assert(code is ERR_TypeMismatch, f'A rejected membership candidate should raise ERR_TypeMismatch, got {code}')

   assert(not ('abc' in array<int> {}), 'An empty array should not check the candidate')
end

-- The trace is recorded with numeric strings, so its candidate guard only checks for a string.  A later non-numeric
-- string must leave the trace and raise from the interpreter, not take a branch or raise from native trace code.

function string_candidate_workload(Values:array<int>, Candidates:array<str>):num
   local hits = 0
   for _, candidate in Candidates do
      if candidate in Values then hits++ end
   end
   return hits
end

@Test function TracedMembershipRaisesRejectedCandidatesInTheInterpreter()
   jit.on()
   jit.flush()
   jit.opt.start('hotloop=2', 'hotexit=1', 'minstitch=0')
   defer jit.opt.start() end

   local values = array<int> { 1, 2 }
   local candidates = array<str>
   for i in {0 to 60} do candidates.push((i % 2 is 0) ? '2' : '3') end
   assert(string_candidate_workload(values, candidates) is 30, 'Numeric string candidates should match on trace')

   jit.off()
   local native_calls = 0
   for trace_no in {1 into 40} do
      local info = jit.util.traceInfo(trace_no)
      if info is nil then continue end
      for instruction in {1 into info.nins} do
         local _, ir_ot, _, call_id = jit.util.traceIR(trace_no, instruction)
         if ir_ot != nil and (ir_ot >> 8) is 98 and jit.util.irCallAddr(call_id) != nil then native_calls++ end
      end
   end
   jit.on()
   assert(native_calls > 0, 'String candidates should be recorded as a native membership call')

   candidates.push('abc')
   local a, b, c = 10, 20, 30
   local message, hits
   try
      hits = string_candidate_workload(values, candidates)
   except ex
      message = ex.message
   end
   assert(hits is nil, f'A rejected candidate on trace should raise, got {hits} hits')
   assert(message is 'Membership test expected number, got string', f'Unexpected message: {message}')
   assert(a is 10 and b is 20 and c is 30, 'A rejected candidate on trace should preserve the caller locals')
end
