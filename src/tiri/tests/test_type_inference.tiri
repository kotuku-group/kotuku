-- Flute tests for static result inference and deliberately dynamic result behaviour.

@BeforeEach(hotpath=true)
function enforce_hotpath() end

----------------------------------------------------------------------------------------------------------------------
-- BASIC TYPE INFERENCE

@Test function StaticNumberInference()
   function getValue()
      return 42
   end

   local a = getValue()
   assert(a is 42, "Inferred numeric result should return 42")

   -- Second call should still work with typed assignment
   local x: num = getValue()
   assert(x is 42, "Typed assignment should accept the statically inferred result")
end

@Test function StaticStringInference()
   function getMessage()
      return "hello"
   end

   local msg = getMessage()
   local s: str = getMessage()
   assert(s is "hello", "String type should be inferred")
end

@Test function StaticTableInference()
   function getConfig()
      return { key = "value" }
   end

   local cfg = getConfig()
   local t: table = getConfig()
   assert(t.key is "value", "Table type should be inferred")
end

@Test function StaticBooleanInference()
   function getFlag()
      return true
   end

   local a = getFlag()
   assert(a is true, "Inferred boolean result should return true")

   local b: bool = getFlag()
   assert(b is true, "Bool type should be inferred")
end

----------------------------------------------------------------------------------------------------------------------
-- NIL HANDLING

@Test function NilCompatibleStaticInference()
   global call_count = 0
   function maybeValue()
      call_count += 1
      if call_count is 1 then
         return nil
      end
      return 42
   end

   local a = maybeValue()
   assert(a is nil, "First call returns nil")

   local b = maybeValue()
   assert(b is 42, "Second call returns number")

   local x: num = maybeValue()
   assert(x is 42, "Nil-compatible static inference should retain the concrete numeric result")
end

----------------------------------------------------------------------------------------------------------------------
-- EXPLICIT TYPE ANNOTATIONS

@Test function ExplicitTypeNotOverridden()
   function getTyped(): num
      return 42
   end

   -- An explicit type remains the authoritative checked signature.
   local x: num = getTyped()
   assert(x is 42, "Explicit return type should work")
end

@Test function ExplicitResultContract()
   function typedFunc(): str
      return "typed"
   end

   local s: str = typedFunc()
   assert(s is "typed", "Explicit return type works correctly")
end

----------------------------------------------------------------------------------------------------------------------
-- TAIL-CALL HANDLING

@Test function InferredTailCallForwarding()
   function inner()
      return 99
   end

   function outer()
      return inner()
   end

   local a = outer()
   assert(a is 99, "Tail-call return should work")

   local x: num = outer()
   assert(x is 99, "Typed assignment should accept a statically inferred tail result")
end

@Test function NestedTailCallForwarding()
   function level3()
      return 333
   end

   function level2()
      return level3()
   end

   function level1()
      return level2()
   end

   local a = level1()
   assert(a is 333, "Nested tail-calls should work")

   local x: num = level1()
   assert(x is 333, "Nested tail-call inference should retain the numeric result")
end

----------------------------------------------------------------------------------------------------------------------
-- MULTIPLE RETURN VALUES

@Test function StaticMultipleResultInference()
   function getMultiple()
      return 1, "a"
   end

   local a, b = getMultiple()
   assert(a is 1, "First return value should be 1")
   assert(b is "a", "Second return value should be 'a'")

   -- Test typed assignment of multi-return
   local x: num, y: str = getMultiple()
   assert(x is 1, "Typed first return should work")
   assert(y is "a", "Typed second return should work")
end

@Test function NilCompatibleMultipleResultInference()
   global multi_call = 0
   function partialMulti()
      multi_call += 1
      if multi_call is 1 then
         return nil, "first"
      end
      return 42, "second"
   end

   local a1, b1 = partialMulti()
   assert(a1 is nil, "First call position 0 is nil")
   assert(b1 is "first", "First call position 1 is string")

   local a2, b2 = partialMulti()
   assert(a2 is 42, "Second call position 0 is number")
   assert(b2 is "second", "Second call position 1 is string")

   local x: num, y: str = partialMulti()
   assert(x is 42, "Typed position 0 should work")
   assert(y is "second", "Typed position 1 should work")
end

@Test function StaticThreeResultInference()
   function getThree()
      return 1, "two", true
   end

   local a, b, c = getThree()
   assert(a is 1, "First return value should be 1")
   assert(b is "two", "Second return value should be 'two'")
   assert(c is true, "Third return value should be true")

   local x: num, y: str, z: bool = getThree()
   assert(x is 1, "Typed first return should work")
   assert(y is "two", "Typed second return should work")
   assert(z is true, "Typed third return should work")
end

----------------------------------------------------------------------------------------------------------------------
-- FUNCTION TYPE INFERENCE

@Test function StaticFunctionResultInference()
   function getHandler()
      return function(x) return x * 2 end
   end

   local fn = getHandler()
   assert(fn(5) is 10, "Returned function should work")

   local typed: func = getHandler()
   assert(typed(7) is 14, "Function type should be inferred")
end

----------------------------------------------------------------------------------------------------------------------
-- CLOSURE BEHAVIOR

@Test function ClosureResultInference()
   function makeCounter()
      local count = 0
      return function()
         count += 1
         return count
      end
   end

   local counter1 = makeCounter()
   local counter2 = makeCounter()

   assert(counter1() is 1, "First counter should return 1")
   assert(counter1() is 2, "First counter should return 2")
   assert(counter2() is 1, "Second counter should return 1")

   local x: num = counter1()
   assert(x is 3, "Typed assignment should work for closures")
end

@Test function ExplicitAnyRemainsDynamic()
   function dynamicValue(Value:any):any
      return Value
   end

   assert(dynamicValue(nil) is nil, "A dynamic result should preserve nil")
   assert(dynamicValue(42) is 42, "A dynamic result should preserve numbers")
   assert(dynamicValue("text") is "text", "A dynamic result should preserve strings without gaining a contract")
   assert(dynamicValue({ key="value" }).key is "value",
      "A dynamic result should preserve tables without gaining a contract")

   for i in {0 to 250} do
      local value:any = i % 2 is 0 ? i :> "dynamic"
      assert(dynamicValue(value) is value, "Hot dynamic calls should retain interpreter and JIT behaviour")
   end
end

@Test function TailPositionExceptionRemainsProtected()
   function fail():num
      error('tail-position failure')
   end

   function protectedCall():any
      try
         return fail()
      except e
         return e.message
      end
   end

   local message:any = protectedCall()
   assert(message.find('tail-position failure'), 'A try boundary must catch an exception from a returned call')
end
