-- Fresh-process coverage for structurally linked imported-module graphs and complete-root persistence.

include 'core'

local glRoot

@BeforeAll function setup()
   local err, temp = mSys.ResolvePath('temp:', 0)
   check err
   glRoot = temp .. f'/import_module_deduplication.tests_{processing.task().id}_{mSys.PreciseTime()}/'
   local folder <close> = obj.new('file', { path=glRoot, flags=FL_NEW|FL_FOLDER })
end

@AfterAll function cleanup()
   if glRoot then check mSys.DeleteFile(glRoot) end
end

function write_file(Path:str, Content:str)
   local file <close> = obj.new('file', { path=Path, flags=FL_NEW|FL_WRITE })
   if #Content > 0 then check file.acWrite(Content) end
end

function child(Parameters:array<str>):<num, str>
   local output = ''
   local executable = processing.task().processPath .. 'origo'
   if mSys.GetSystemState().platform is 'Windows' then executable ..= '.exe' end
   local task <close> = obj.new('task', {
      location=executable, flags=TSF_WAIT, timeout=60,
      outputCallback=function(Task, Buffer) output ..= Buffer.getString() end,
      errorCallback=function(Task, Buffer) output ..= Buffer.getString() end
   })
   for parameter in values(Parameters) do check task.mtAddArgument(parameter) end
   check task.acActivate()
   return task.returnCode, output
end

function exists(Path:str):bool
   return mSys.AnalysePath(Path) is ERR_Okay
end

function assert_execution(Output:str)
   assert(Output.count('D05_GRAPH_OK:LABXYRCD') is 1, Output)
end

@Test function FreshProcessStructuralPersistence()
   local scripts = glRoot .. 'scripts/'
   local modules = scripts .. 'd05/'
   local isolated_temp = glRoot .. 'temp/'
   local scripts_folder <close> = obj.new('file', { path=scripts, flags=FL_NEW|FL_FOLDER })
   local modules_folder <close> = obj.new('file', { path=modules, flags=FL_NEW|FL_FOLDER })
   local temp_folder <close> = obj.new('file', { path=isolated_temp, flags=FL_NEW|FL_FOLDER })

   write_file(modules .. 'leaf.tiri', "glD05Trace ..= 'L'")
   write_file(modules .. 'a.tiri', "import 'd05/leaf'\nglD05Trace ..= 'A'")
   write_file(modules .. 'b.tiri', "import 'd05/leaf'\nglD05Trace ..= 'B'")
   write_file(modules .. 'nested_a.tiri', "import 'd05/leaf', 'd05/a', 'd05/b'\nglD05Trace ..= 'X'")
   write_file(modules .. 'nested_b.tiri', "import 'd05/a', 'd05/b'\nglD05Trace ..= 'Y'")
   write_file(modules .. 'native.tiri', "include 'vector'\nglobal glD05Native = ARF_MEET")
   write_file(modules .. 'namespace_root.tiri', [[
      namespace d05_namespace { initialisations=0 }
      d05_namespace.initialisations++
      glD05Trace ..= 'R'
   ]])
   write_file(modules .. 'namespace_a.tiri', [[
      import 'd05/namespace_root'
      namespace d05_namespace
      d05_namespace.a = true
      glD05Trace ..= 'C'
   ]])
   write_file(modules .. 'namespace_b.tiri', [[
      import 'd05/namespace_root'
      namespace d05_namespace
      d05_namespace.b = true
      glD05Trace ..= 'D'
   ]])

   local producer_a = glRoot .. 'producer_a.tiri'
   local producer_b = glRoot .. 'producer_b.tiri'
   local main = glRoot .. 'main.tiri'
   local runner = glRoot .. 'runner.tiri'
   local wrapped = glRoot .. 'root.tbc'
   local resaved = glRoot .. 'resaved.tbc'
   local root_cache = glRoot .. 'root_cache.tbc'

   write_file(producer_a, "global glD05Trace = ''\nimport 'd05/a', 'd05/native'")
   write_file(producer_b, "global glD05Trace = ''\nimport 'd05/b'")
   write_file(main, [[
      global glD05Trace = ''
      import 'd05/nested_a', 'd05/nested_b', 'd05/a', 'd05/native'
      import 'd05/namespace_a', 'd05/namespace_b'
      assert(ARF_MEET is glD05Native)
      assert(d05_namespace.initialisations is 1 and d05_namespace.a and d05_namespace.b)
      assert(glD05Trace is 'LABXYRCD', glD05Trace)
      print('D05_GRAPH_OK:' .. glD05Trace)
   ]])
   write_file(runner, [[
      local mode = arg('mode')
      local source = arg('source')
      local output = arg('output')
      if mode is 'query' then
         local script <close> = obj.new('tiri', { path=source })
         check script.acQuery()
      elseif mode is 'save' then
         local script <close> = obj.new('tiri', { path=source })
         local file <close> = obj.new('file', { path=output, flags=FL_NEW|FL_WRITE })
         check script.acSaveToObject(file)
      elseif mode is 'automatic' then
         local script <close> = obj.new('tiri', { path=source, cacheFile=output, flags=SCF_AUTO_CACHE })
         check script.acQuery()
         check script.acActivate()
         assert(script.error is ERR_Okay, script.errorMessage)
      elseif mode is 'resave' then
         local script <close> = obj.new('tiri', { path=source })
         check script.acQuery()
         local file <close> = obj.new('file', { path=output, flags=FL_NEW|FL_WRITE })
         check script.acSaveToObject(file)
      else
         raise 'Unknown D05 runner mode'
      end
   ]])

   function run_runner(Mode:str, Source:str, Output:str):<num, str>
      return child(array<str> { runner, 'mode=' .. Mode, 'source=' .. Source, 'output=' .. Output,
         '--log-trace', '--gfx-driver=headless', '--set-volume', 'scripts=' .. scripts,
         '--set-volume', 'temp=' .. isolated_temp })
   end

   -- Warm the two diamond parents in independent states, then build a mixed root whose nested and namespace modules
   -- are cold while their shared executable dependencies are warm.
   local code, output = run_runner('query', producer_a, '')
   assert(code is 0 and output.find('Imported-module source rebuild') != nil, output)
   code, output = run_runner('query', producer_b, '')
   assert(code is 0 and output.find('Imported-module cache hit') != nil, output)
   code, output = run_runner('save', main, wrapped)
   assert(code is 0 and output.find('Imported-module cache hit') != nil and
      output.find('Imported-module source rebuild') != nil, output)

   code, output = child(array<str> { wrapped, '--log-warning', '--gfx-driver=headless',
      '--set-volume', 'scripts=' .. scripts, '--set-volume', 'temp=' .. isolated_temp })
   assert(code is 0, output)
   assert_execution(output)

   -- The first explicit whole-root cache run uses warm imported modules.  The second must bypass imported-module
   -- lookup entirely, proving that the complete root cache owns the executable graph.
   code, output = run_runner('automatic', main, root_cache)
   assert(code is 0 and output.find('Imported-module cache hit') != nil, output)
   assert_execution(output)
   code, output = run_runner('automatic', main, root_cache)
   assert(code is 0 and output.find('Cache hit') != nil and
      output.find('Imported-module cache hit') is nil and
      output.find('Imported-module source rebuild') is nil,
      f'code={code}, root hits={output.count("Cache hit")}, module hits=' ..
      f'{output.count("Imported-module cache hit")}, rebuilds={output.count("Imported-module source rebuild")}')
   assert_execution(output)

   -- Remove every original root/module source and every imported-module artefact before exercising complete-root
   -- execution, re-saving and JIT parity in fresh processes.
   check mSys.DeleteFile(scripts)
   check mSys.DeleteFile(main)
   check mSys.DeleteFile(producer_a)
   check mSys.DeleteFile(producer_b)
   local module_cache = isolated_temp .. 'tiri/cache/'
   if exists(module_cache) then check mSys.DeleteFile(module_cache) end

   for jit in values({ '', 'off' }) do
      local arguments = array<str> { wrapped, '--log-warning', '--gfx-driver=headless',
         '--set-volume', 'scripts=' .. scripts, '--set-volume', 'temp=' .. isolated_temp }
      if jit != '' then arguments.push('--jit-options') arguments.push(jit) end
      code, output = child(arguments)
      assert(code is 0, output)
      assert_execution(output)
   end

   code, output = run_runner('resave', wrapped, resaved)
   assert(code is 0, output)
   code, output = child(array<str> { resaved, '--log-warning', '--gfx-driver=headless',
      '--set-volume', 'scripts=' .. scripts, '--set-volume', 'temp=' .. isolated_temp })
   assert(code is 0, output)
   assert_execution(output)

   code, output = child(array<str> { root_cache, '--log-warning', '--gfx-driver=headless',
      '--set-volume', 'scripts=' .. scripts, '--set-volume', 'temp=' .. isolated_temp })
   assert(code is 0, output)
   assert_execution(output)
end

@Test function ImportedIdentityExcludesImporterContext()
   local scripts = glRoot .. 'identity_scripts/'
   local modules = scripts .. 'identity_context/'
   local isolated_temp = glRoot .. 'identity_temp/'
   local scripts_folder <close> = obj.new('file', { path=scripts, flags=FL_NEW|FL_FOLDER })
   local modules_folder <close> = obj.new('file', { path=modules, flags=FL_NEW|FL_FOLDER })
   local temp_folder <close> = obj.new('file', { path=isolated_temp, flags=FL_NEW|FL_FOLDER })

   local style = glRoot .. 'identity_style.tiri'
   local main = glRoot .. 'identity_main.tiri'
   write_file(modules .. 'base.tiri', [[
      namespace identity_context { base=true }
   ]])
   write_file(style, [[
      import 'identity_context/base'
      assert(identity_context.base)
   ]])
   write_file(modules .. 'extension.tiri',
      "import 'identity_context/base'\n" ..
      "namespace identity_context\n" ..
      "loadFile([[" .. style .. "]])\n" ..
      "identity_context.extension = true\n")
   write_file(main, [[
      import 'identity_context/base', 'identity_context/extension'
      assert(identity_context.base and identity_context.extension)
      print('IMPORT_IDENTITY_CONTEXT_OK')
   ]])

   for _ in {0 to 2} do
      local code, output = child(array<str> { '--cache', main, '--log-warning', '--gfx-driver=headless',
         '--set-volume', 'scripts=' .. scripts, '--set-volume', 'temp=' .. isolated_temp })
      assert(code is 0 and output.find('IMPORT_IDENTITY_CONTEXT_OK') != nil, output)
   end
end
