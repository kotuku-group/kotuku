-- Flute tests for the @NoDiscard function annotation.
--
-- Declaration, result-consumption and import contracts from docs/plans/tiri/1_tiri_no_discard.md.

include 'core'

@NoDiscard
function no_discard_named():table
   return { name='named' }
end

----------------------------------------------------------------------------------------------------------------------

function expect_valid(Source:str, Context:str)
   local result = debug.validate(Source)
   if not result.success then
      local message = result.diagnostics?[0]?.message ?? 'no diagnostic'
      assert(false, f'{Context}: expected valid source, got: {message}')
   end
end

-- Asserts that a declaration or call fails with exactly one NoDiscard diagnostic containing the expected message.

function expect_no_discard_error(Source:str, Message:str, Context:str)
   local result = debug.validate(Source)
   assert(result.success is false, f'{Context}: source should fail validation')
   assert(#result.diagnostics > 0, f'{Context}: a diagnostic should be reported')
   local first = result.diagnostics[0]
   assert(first.code is 'NoDiscard', f'{Context}: expected code NoDiscard, got {first.code}: {first.message}')
   assert(first.message.find(Message, 0, true) != nil,
      f'{Context}: expected diagnostic containing "{Message}", got: {first.message}')

   local count = 0
   for _, diagnostic in pairs(result.diagnostics) do
      if diagnostic.code is 'NoDiscard' then count++ end
   end
   assert(count is 1, f'{Context}: expected one NoDiscard diagnostic, got {count}')
end

----------------------------------------------------------------------------------------------------------------------

local constructor_source = [[
@NoDiscard
function make():<table, num>
   return { value=1 }, 2
end
]]

@Test function StorageDestinationsRetainFreshResults()
   for source in values(array<str> {
      'local value = make()',
      'value = make()',
      'global glNoDiscardValue = make()',
      'local value = {}\nvalue = make()',
      'local value = {}\nfunction replace() value = make() end',
      'local owner = {}\nowner.widget = make()',
      'local owner = {}\nowner[0] = make()',
      'local owner = {}\nowner.{ widget=make(), [0]=make() }',
      'local owner = {}\nowner?.{ widget=make() }',
      'local owner = entity {}\nusing owner do &widget = make() end',
      'namespace owner { widget=make() }',
      'local value = (make())',
      'local first, second = make()',
      'local first, _ = make()',
      'local first, second = make(), 3',
      'local value = {}\nvalue ?= make()',
      'local value = {}\nvalue ??= make()'
   }) do
      expect_valid(constructor_source .. source, source)
   end
end

----------------------------------------------------------------------------------------------------------------------

@Test function AggregatesMustReachStorage()
   for source in values(array<str> {
      'local value = { widget=make() }',
      'local value = { make() }',
      'local value = { nested={ widget=make() } }',
      'local value = { widget=make() }.widget',
      'local value = { [make()]=3 }',
      'local value = { make(), 3 }',
      'local value = array<table> { (make()) }',
      'local value = array<table, 4> { (make()) }',
      'local size = 4\nlocal value = array<table, size> { (make()) }',
      'local value = array<any> { make() }',
      'local value = array<any> { make(), 3 }',
      'print({ widget=make() })',
      'print({ [make()]={ nested=make() } })',
      'print(array<table> { (make()) })',
      'print(array<table, 4> { (make()) })'
   }) do
      expect_valid(constructor_source .. source, source)
   end

   for source in values(array<str> {
      '_ = { widget=make() }',
      '_ = { nested={ make() } }',
      '_ = { [make()]=3 }',
      '_ = array<table> { (make()) }',
      '_ = array<table, 4> { (make()) }'
   }) do
      expect_no_discard_error(constructor_source .. source, 'marked @NoDiscard', source)
   end
end

----------------------------------------------------------------------------------------------------------------------

@Test function DiscardsAndResultAdjustmentAreRejected()
   expect_no_discard_error(constructor_source .. 'make()', "Result 1 of 'make'", 'bare call')
   for source in values(array<str> {
      '_ = make()',
      'local _ = make()',
      'local _, second = make()',
      'local _, second = make(), 3',
      'local value = 0\n_, value = make()'
   }) do
      expect_no_discard_error(constructor_source .. source, 'blank assignment', source)
   end
   -- Surplus explicit expressions are already forbidden by the assignment grammar, before semantic validation.
   local surplus = debug.validate(constructor_source .. 'local first = 3\nfirst = 3, make()')
   assert(not surplus.success and surplus.diagnostics[0].code is 'InvalidAssignment',
      'An excess first result must not bypass the existing assignment-arity check')
   expect_no_discard_error(constructor_source .. 'make().{ field=1 }', 'Immediate member',
      'field-block receiver temporary is not client storage')
end

----------------------------------------------------------------------------------------------------------------------

@Test function FiltersPreserveOriginalResultObligations()
   for source in values(array<str> {
      'local value = [*]make()',
      'local value = [*_]make()',
      'local first, _ = [**_]make()',
      'local first, second = [*_]make(), 3',
      'local owner = { widget=[*_]make() }',
      'local value = ([*]make())'
   }) do
      expect_valid(constructor_source .. source, source)
   end
   for filter in values(array<str> { '[]', '[_]', '[_*]', '[__*]', '[_*_]' }) do
      expect_no_discard_error(constructor_source .. 'local value = ' .. filter .. 'make()', 'result filter', filter)
   end
   expect_no_discard_error(constructor_source .. 'local _, value = [*]make()', 'blank assignment',
      'storing an unrelated result does not satisfy the first result')
end

----------------------------------------------------------------------------------------------------------------------

@Test function ArgumentsAndPipesAcceptFreshResults()
   for source in values(array<str> {
      'print(make())',
      'print(make(), 3)',
      'print(3, make())',
      'print((make()))',
      'print([*_]make())',
      'local widgets = array<table>\nwidgets.push((make()))',
      'function consume(Value:any, ...) end\nconsume(make())',
      'function consume(...) end\nconsume(make(), make())',
      'function pass(Flag:bool) print(Flag ? make() : {}) end',
      'local owner = { consume=function(...) end }\nowner.consume?(make())',
      'local owner = entity { consume=function(Value:any) end }\nowner.consume(make())',
      'local value = tostring(make())',
      'local value = f"{make()}"',
      'local value = make() |> tostring()',
      'local value = make() |1> tostring()',
      'make() |2> print()',
      'defer(Value) print(Value) end(make())'
   }) do
      expect_valid(constructor_source .. source, source)
   end
end

@Test function PassedResultsReachRetainingFunctions()
   exec([[
@NoDiscard function create():table return { value=42 } end
local widgets = array<table>
widgets.push(create())
assert(#widgets is 1 and widgets[0].value is 42, 'A passed constructor result must reach array.push')
local owner = {}
function retain(Widget:table) owner.widget = Widget end
create() |> retain()
assert(owner.widget.value is 42, 'A piped constructor result must reach its callee')
]])
end

@Test function ConcatenatedResultsFollowTheStringDestination()
   local source = '@NoDiscard function text():str return "value" end\n'
   for expression in values(array<str> {
      'text() .. ":"',
      '":" .. text()',
      'text() .. ":" .. text()',
      '(text()) .. (":" .. text())'
   }) do
      expect_valid(source .. 'local value = ' .. expression, 'stored ' .. expression)
      expect_valid(source .. 'print(' .. expression .. ')', 'passed ' .. expression)
      expect_valid(source .. 'return ' .. expression, 'returned ' .. expression)
      local discarded = debug.validate(source .. '_ = ' .. expression)
      assert(not discarded.success, 'Discarding a concatenated protected result must fail: ' .. expression)
      for diagnostic in values(discarded.diagnostics) do
         assert(diagnostic.code is 'NoDiscard' and diagnostic.message.find('blank assignment') != nil,
            'Each discarded operand should report its blank destination: ' .. diagnostic.message)
      end
   end
   expect_no_discard_error(source .. 'local value = [_*]text() .. ":"', 'result filter',
      'concatenation must not hide a filtered protected result')
   expect_no_discard_error(source .. 'local _ = { text() .. ":" }', 'blank assignment',
      'a discarded aggregate must not retain its concatenated elements')

   exec([[
import 'json'
local parts = array<str>
parts.push(json.encode({ key='value' }) .. ':')
assert(#parts is 1 and parts[0] is '{"key":"value"}:', 'The concatenated JSON must reach array.push')
]])
end

@Test function OperatorsFollowTheirComputedValueDestination()
   local source = [[
@NoDiscard function numb():<num, num> return 6, 99 end
@NoDiscard function text():str return 'value' end
@NoDiscard function keys():table return { [6]=true } end
]]
   for expression in values(array<str> {
      'numb() + 2', '2 + numb()', 'numb() - 2', '12 - numb()',
      'numb() * 2', '12 / numb()', 'numb() % 4', 'numb() ** 2',
      'numb() & 3', 'numb() | 1', 'numb() ^ 3', 'numb() << 1', 'numb() >> 1',
      '-numb()', '~numb()', '#text()', 'not numb()',
      'numb() is 6', 'numb() != 6', 'numb() < 7', 'numb() <= 6',
      'numb() > 5', 'numb() >= 6', 'numb() has 2',
      'numb() in { [6]=true }', '6 in keys()', 'numb() is <num>', 'numb()??',
      '0 < numb() < 10', '(numb() + 2) * -numb()',
      'text() .. ":"', '{numb() to 10}', '{0 to numb()}', '{0 to 10 by numb()}'
   }) do
      expect_valid(source .. 'local value = ' .. expression, 'stored ' .. expression)
      expect_valid(source .. 'print(' .. expression .. ')', 'passed ' .. expression)
      expect_valid(source .. 'return ' .. expression, 'returned ' .. expression)
      expect_valid(source .. 'if ' .. expression .. ' then end', 'tested ' .. expression)
      exec(source .. 'local value = ' .. expression)

      local discarded = debug.validate(source .. '_ = ' .. expression)
      assert(not discarded.success and #discarded.diagnostics > 0,
         'Discarded computations must retain their operands\' obligations: ' .. expression)
      for diagnostic in values(discarded.diagnostics) do
         assert(diagnostic.code is 'NoDiscard', 'Expected NoDiscard for ' .. expression)
      end
   end
   expect_no_discard_error(source .. 'local value = [_*]numb() + 2', 'result filter',
      'arithmetic must not hide removal of the original first result')
   expect_no_discard_error(source .. 'local _ = { numb() * 2 }', 'blank assignment',
      'aggregate computations must reach an accepted destination')
   expect_valid(constructor_source .. 'local value = not make()', 'stored negation')
   expect_valid(constructor_source .. 'print(make() is nil)', 'passed comparison')
   expect_valid(constructor_source .. 'return make()??', 'returned presence test')
end

@Test function CompoundAssignmentsAndIndexOperandsUseFreshResults()
   local source = '@NoDiscard function numb():num return 2 end\n'
   for operator in values(array<str> { '+=', '-=', '*=', '/=', '%=' }) do
      expect_valid(source .. 'local value = 12\nvalue ' .. operator .. ' numb()', operator)
      expect_valid(source .. 'local owner = { value=12 }\nowner.value ' .. operator .. ' numb()',
         'member ' .. operator)
   end
   expect_valid(source .. 'local owner = {}\nowner[numb()] = 1', 'computed assignment key')
   expect_valid(source .. 'local owner = {}\nlocal value = owner[numb()]', 'computed lookup key')
   expect_valid(source .. 'local owner = {}\nlocal value = owner?[numb()]', 'safe computed lookup key')
   expect_valid(source .. 'for index in {0 to numb()} do end', 'range loop bound')
   exec([[
@NoDiscard function numb():num return 2 end
@NoDiscard function text():str return 'value' end
local parts = array<int>
parts.push(numb() + 2)
assert(#parts is 1 and parts[0] is 4, 'Arithmetic must reach array.push')
local value = 12
value += numb()
value -= numb()
value *= numb()
value /= numb()
value %= numb()
assert(value is 0, 'Compound arithmetic must use the protected result')
local owner = { value=1 }
owner.value += numb()
assert(owner.value is 3, 'Compound member assignment must use the protected result')
local label = 'prefix:'
label ..= text()
assert(label is 'prefix:value', 'Compound concatenation must use the protected result')
if numb() > 1 then value = 42 end
assert(value is 42, 'Comparison conditions must use the protected result')
]])
end

@Test function BuiltinMethodReceiversConsumeFreshResults()
   local source = [[
@NoDiscard function text():str! return 'value' end
@NoDiscard function nullable():str return 'value' end
@NoDiscard function variant():any return 'value' end
]]
   for expression in values(array<str> {
      "assert(not text().find('secret'))",
      "assert(not nullable().find('secret'))",
      "assert(not variant().find('secret'))",
      "assert(not text()?.find('secret'))",
      "assert(not nullable()?.find('secret'))",
      "assert(not variant()?.find('secret'))",
      "text().find('secret')",
      "local value = text().trim().find('value')"
   }) do
      expect_valid(source .. expression, expression)
   end
   exec(source .. "assert(not text().find('secret'))\nassert(nullable().trim() is 'value')")
   expect_valid(constructor_source .. 'local value = make().size()', 'table built-in receiver')
   expect_valid(source .. 'local value = text().find', 'stored method extraction')
   expect_no_discard_error(source .. "local value = ([_*]text()).find('value')", 'result filter',
      'method dispatch cannot restore a filtered protected result')
end

----------------------------------------------------------------------------------------------------------------------

@Test function ImportedJsonMethodReceiverConsumesFreshResult()
   exec([[import 'json'
assert(not json.encode({ k='v' }).find('secret'), 'Invalid token must not leak response data')]])
end

