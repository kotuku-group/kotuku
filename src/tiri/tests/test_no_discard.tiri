@Test function EachOriginatingCallIsReportedOnce()
   local result = debug.validate(constructor_source .. '_ = { widget=make() }.widget\nmake()')
   assert(result.success is false, 'Both fresh calls should fail validation')
   assert(#result.diagnostics is 2, f'Expected one diagnostic per call, got {#result.diagnostics}')
   assert(result.diagnostics[0].line is 5 and result.diagnostics[1].line is 6,
      'Call diagnostics should identify their originating source lines')
   assert(result.diagnostics[0].code is 'NoDiscard' and result.diagnostics[1].code is 'NoDiscard',
      'Both diagnostics should have the dedicated NoDiscard code')
end

----------------------------------------------------------------------------------------------------------------------

@Test function NestedBodiesCannotHideDiscardedResults()
   for source in values(array<str> {
      'do make() end',
      'function inner() make() end',
      'local callback = function() make() end',
      'local callbacks = { callback=function() make() end }',
      'defer make() end',
      'try make() except e end',
      'try local value = 1 except e\nmake() end',
      'try local value = 1 success make() end',
      'checkall make() end',
      'local owner = {}\nusing owner do make() end',
      'for index in {0 to 1} do make() end',
      'repeat make() until true',
      'local flag = true\nwhile flag do make() break end',
      'local flag = true\nif flag then make() end',
      'local flag = false\nif flag then else make() end',
      'check make()',
      'local value = false\nvalue ?! check make()'
   }) do
      expect_no_discard_error(constructor_source .. source, 'marked @NoDiscard', source)
   end
end

----------------------------------------------------------------------------------------------------------------------

@Test function SupportedAttachmentFormsAreAccepted()
   expect_valid('@NoDiscard function make() return {} end', 'named function')
   expect_valid('@NoDiscard local function make() return {} end', 'local function')
   expect_valid('@NoDiscard local make = function() return {} end', 'local assignment')
   expect_valid('@NoDiscard global glNoDiscardMake = function() return {} end', 'global declaration')
   expect_valid('local ns = {}\n@NoDiscard ns.make = function() return {} end', 'namespace member assignment')
   expect_valid('local ns = {}\n@NoDiscard function ns.make() return {} end', 'namespace member function')
   expect_valid('@NoDiscard\nfunction make() return {} end', 'annotation on its own line')
   expect_valid('@NoDiscard; @Doc(text="Makes a value") function make() return {} end', 'combined annotations')
end

----------------------------------------------------------------------------------------------------------------------

@Test function DeclaredAndInferredResultsAreAccepted()
   expect_valid('@NoDiscard function make():table return {} end', 'declared single result')
   expect_valid('@NoDiscard function make():<table, num> return {}, 1 end', 'declared multiple results')
   expect_valid('@NoDiscard function make(Options:table!):table! return Options end', 'required result')
   expect_valid('@NoDiscard function make() return nil end', 'nil first result is not a separate requirement')
   expect_valid('function inner() return {} end\n@NoDiscard function make() return inner() end',
      'forwarded call results may supply the first result')
   expect_valid('@NoDiscard function make(...):any return ... end', 'varargs may supply the first result')
   expect_valid('@NoDiscard function make(Flag) if Flag then return end return {} end',
      'one value-bearing return path is sufficient')
end

----------------------------------------------------------------------------------------------------------------------

@Test function ArgumentsAreRejected()
   expect_no_discard_error('@NoDiscard(position=1) function make() return {} end', 'does not accept arguments',
      'named argument')
   expect_no_discard_error('@NoDiscard(strict) function make() return {} end', 'does not accept arguments',
      'bare argument')
end

----------------------------------------------------------------------------------------------------------------------

@Test function DuplicateAnnotationsAreRejected()
   expect_no_discard_error('@NoDiscard; @NoDiscard function make() return {} end', 'more than once',
      'semicolon separated')
   expect_no_discard_error('@NoDiscard\n@NoDiscard\nfunction make() return {} end', 'more than once',
      'line separated')
end

----------------------------------------------------------------------------------------------------------------------

@Test function FunctionsWithoutAFirstResultAreRejected()
   expect_no_discard_error('@NoDiscard function make():<> end', 'declares no results', 'explicit void')
   expect_no_discard_error('@NoDiscard function make() local value = 1 end', 'never returns a value',
      'no return statement')
   expect_no_discard_error('@NoDiscard function make(Flag) if Flag then return end end', 'never returns a value',
      'bare returns only')
   expect_no_discard_error('@NoDiscard function make() local inner = function() return 1 end end',
      'never returns a value', 'nested function returns do not count')
   expect_no_discard_error('@NoDiscard function make() if false then return 1 end end', 'never returns a value',
      'unreachable returns do not count')
end

----------------------------------------------------------------------------------------------------------------------

@Test function DiagnosticsIdentifyTheAnnotation()
   local result = debug.validate('local value = 1\n\n   @NoDiscard function make() end')
   assert(result.success is false, 'An empty @NoDiscard function should fail validation')
   local diagnostic = result.diagnostics[0]
   assert(diagnostic.line is 3, f'The diagnostic should identify the annotation line, got {diagnostic.line}')
   assert(diagnostic.column is 4, f'The diagnostic should identify the annotation column, got {diagnostic.column}')
end

----------------------------------------------------------------------------------------------------------------------

@Test function ValidationBuffersDoNotInheritPreviouslyLoadedSources()
   local result = debug.validate(constructor_source .. 'make()', { path='no_discard_buffer.tiri' })
   assert(not result.success and #result.diagnostics is 1, 'Expected one diagnostic from the validation buffer')
   local diagnostic = result.diagnostics[0]
   assert(diagnostic.code is 'NoDiscard', 'Expected the NoDiscard diagnostic')
   assert(diagnostic.file is nil, 'A synthetic validation buffer must not inherit a previously loaded source file')
   assert(diagnostic.line is 5, f'Expected the originating call line, got {diagnostic.line}')
end

----------------------------------------------------------------------------------------------------------------------

@Test function UnannotatedFunctionsAreUnchanged()
   expect_valid('function make() end\nmake()', 'unannotated function without results')
   expect_valid('function make() return {} end\nmake()', 'unannotated call result may be discarded')
   expect_valid('@Note function make() end', 'other annotations impose no result contract')
end

----------------------------------------------------------------------------------------------------------------------

@Test function AnnotatedFunctionsExecuteAndPublishMetadata()
   local value = no_discard_named()
   assert(value.name is 'named', 'An annotated function should execute normally')

   local entry = debug.anno.get(no_discard_named)
   assert(entry != nil and #entry.annotations is 1, 'The annotation should be registered at runtime')
   assert(entry.annotations[0].name is 'NoDiscard', 'The runtime annotation should be named NoDiscard')

   local result = debug.validate('@NoDiscard function make():table return {} end', { symbols=true })
   assert(result.success, 'Symbol extraction source should validate')
   local symbol = result.symbols[0]
   assert(symbol.name is 'make', f'Expected symbol make, got {symbol.name}')
   assert(symbol.annotations[0].name is 'NoDiscard', 'Tooling metadata should expose the annotation')
   assert(symbol.noDiscard is true, 'Tooling metadata should expose the normalised first-result contract')

   local plain = debug.validate('function make():table return {} end', { symbols=true })
   assert(plain.symbols[0].noDiscard is false, 'An unannotated symbol should not report a @NoDiscard contract')
end
