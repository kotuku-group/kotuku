-- @NoDiscard must survive source imports, active interfaces and the disk cache, before constructors execute.

include 'core'

local glRoot
local glXdgCache
local glRestoreXdg = false

function make_folder(Path:str)
   local folder <close> = obj.new('file', { path=Path, flags=FL_NEW|FL_FOLDER })
end

function write_file(Name:str, Content:str)
   local file <close> = obj.new('file', { path=glRoot .. Name, flags=FL_NEW|FL_WRITE })
   check file.acWrite(Content)
end

@BeforeAll function setup()
   local err, temp = mSys.ResolvePath('temp:', 0)
   check err
   glRoot = temp .. f'no_discard.tests_{processing.task().id}_{mSys.PreciseTime()}/'
   make_folder(glRoot)
   make_folder(glRoot .. 'packages/')
   make_folder(glRoot .. 'packages/base/')
   make_folder(glRoot .. 'packages/outer/')
   make_folder(glRoot .. 'packages/sibling/')
   if mSys.GetSystemState().platform is 'Linux' then
      make_folder(glRoot .. '.cache/')
      _, glXdgCache = processing.task().mtGetEnv('XDG_CACHE_HOME')
      check processing.task().mtSetEnv('XDG_CACHE_HOME', glRoot .. '.cache')
      glRestoreXdg = true
   end
   write_file('packages/index.cfg', '[nd-base]\n1 = base/main.tiri\n\n[nd-outer]\n1 = outer/main.tiri\n' ..
      '\n[nd-sibling]\n1 = sibling/main.tiri\n')
   write_file('packages/base/main.tiri', [[
@Package(name="nd-base", version="1")
namespace nd { }
@NoDiscard
function nd.make():table
   print('ND_CONSTRUCTOR_EXECUTED')
   return {}
end
@NoDiscard
function nd.inferred()
   return {}
end
@NoDiscard
global nd_exported = function():table return {} end
function nd.plain():table return {} end
]])
   write_file('packages/sibling/main.tiri', [[
@Package(name="nd-sibling", version="1")
namespace nd
@NoDiscard
nd.other = function():table
   print('ND_CONSTRUCTOR_EXECUTED')
   return {}
end
function nd.plain():table return {} end
]])
   write_file('packages/outer/main.tiri', [[
@Package(name="nd-outer", version="1")
import 'nd-base'
namespace nd_outer { }
]])
   write_file('bad_local.tiri', '@NoDiscard function local_make():table return {} end\nlocal_make()\n')
end

@AfterAll function cleanup()
   if glRestoreXdg then check processing.task().mtSetEnv('XDG_CACHE_HOME', glXdgCache ?? '') end
   if glRoot then check mSys.DeleteFile(glRoot) end
end

function clear_cache()
   mSys.DeleteFile(glRoot .. '.cache/tiri/')
   mSys.DeleteFile(glRoot .. 'tiri/cache/')
end

function run(Source:str):<num, str>
   write_file('consumer.tiri', Source)
   local output = ''
   local errors = ''
   local executable = processing.task().processPath .. 'origo'
   if mSys.GetSystemState().platform is 'Windows' then executable ..= '.exe' end
   local task <close> = obj.new('task', {
      location=executable, flags=TSF_WAIT, timeout=20,
      outputCallback=function(Task, Buffer) output ..= Buffer.getString() end,
      errorCallback=function(Task, Buffer) errors ..= Buffer.getString() end
   })
   for parameter in values(array<str> { glRoot .. 'consumer.tiri', '--log-trace', '--gfx-driver=headless',
         '--set-volume', 'packages=' .. glRoot .. 'packages/', '--set-volume', 'temp=' .. glRoot }) do
      check task.mtAddArgument(parameter)
   end
   check task.acActivate()
   return task.returnCode, output .. '\n' .. errors
end

function assert_discard(Source:str, Name:str, Warm:bool)
   local code, output = run(Source)
   assert(code != 0, 'A discarded imported constructor must fail compilation: ' .. output)
   assert(output.find("Result 1 of '" .. Name .. "' is marked @NoDiscard") != nil,
      'Expected the imported call diagnostic: ' .. output)
   assert(output.find('ND_CONSTRUCTOR_EXECUTED') is nil, 'A rejected constructor must never execute')
   if Warm then
      assert(output.find('Imported-module cache hit') != nil, 'Expected an imported-module cache hit: ' .. output)
   else
      assert(output.find('Imported-module cache hit') is nil, 'Expected source compilation: ' .. output)
   end
end

@Test function SourceAndDiskCachedImportsEnforceEquivalentContracts()
   clear_cache()
   assert_discard("import 'nd-base'\nnd.make()", 'nd.make', false)
   assert_discard("import 'nd-base'\nnd?.make()", 'nd?.make', false)
   assert_discard("import 'nd-base'\nnd?.inferred()", 'nd?.inferred', false)
   assert_discard("import 'nd-base'\nnd.inferred()", 'nd.inferred', false)
   assert_discard("import 'nd-outer'\nnd_exported()", 'nd_exported', false)

   -- Successful import activation publishes the portable interface to the disk cache.
   local code, output = run("import 'nd-outer'\nprint('ND_PRIMED')")
   assert(code is 0 and output.find('ND_PRIMED') != nil, 'Cache priming failed: ' .. output)

   assert_discard("import 'nd-base'\nnd.make()", 'nd.make', true)
   assert_discard("import 'nd-base'\nnd?.make()", 'nd?.make', true)
   assert_discard("import 'nd-base'\nnd?.inferred()", 'nd?.inferred', true)
   assert_discard("import 'nd-base'\nnd.inferred()", 'nd.inferred', true)
   assert_discard("import 'nd-outer'\nnd_exported()", 'nd_exported', true)

   code, output = run([[
import 'nd-base'
local value = nd.make()
local safe_value = nd?.make()
nd.plain()
nd?.plain()
assert(safe_value is <table>, 'A stored safe call should execute normally')
print('ND_STORED')
]])
   assert(code is 0 and output.find('ND_STORED') != nil,
      'Stored marked results and discarded unannotated results should execute: ' .. output)
end

@Test function SharedNamespaceImportsPreserveMemberContracts()
   clear_cache()
   local sources = array<str> {
      "import 'nd-base', 'nd-sibling'\n",
      "import 'nd-sibling', 'nd-base'\n",
      "import 'nd-base'\nimport 'nd-sibling'\n"
   }
   for warm in values({ false, true }) do
      for source in values(sources) do
         for name in values(array<str> { 'make', 'other' }) do
            assert_discard(source .. f'nd.{name}()', f'nd.{name}', warm)
            assert_discard(source .. f'nd?.{name}()', f'nd?.{name}', warm)
         end
      end
      local code, output = run(sources[0] .. [[
local first = nd.make()
local second = nd.other()
local widgets = array<table>
widgets.push(nd.make())
widgets.push(nd?.other())
assert(#widgets is 2, 'Source and cached constructors must support direct function arguments')
nd.plain()
for options in values(array<table> { {}, { symbols=true } }) do
   local result = debug.validate("import 'nd-base', 'nd-sibling'\nnd.make()\nnd.other()", options)
   assert(not result.success and #result.diagnostics is 2, 'Both shared namespace contracts must survive')
   for diagnostic in values(result.diagnostics) do
      assert(diagnostic.code is 'NoDiscard', 'Expected NoDiscard for both shared namespace members')
   end
   local passed = debug.validate("import 'nd-base', 'nd-sibling'\nprint(nd.make(), nd?.other())", options)
   assert(passed.success, 'Active and source-tooling interfaces must accept passed constructor results')
end
print('ND_SHARED_OK')
]])
      assert(code is 0 and output.find('ND_SHARED_OK') != nil,
         'Shared namespace storage and active/source interfaces must succeed: ' .. output)
   end
end

@Test function DirectGlobalCallsFailBeforeConstructorsExecute()
   for declaration in values(array<str> {
      '@NoDiscard global function glNoDiscardMake():table',
      '@NoDiscard global glNoDiscardMake = function():table'
   }) do
      local source = declaration .. "\nprint('ND_CONSTRUCTOR_EXECUTED')\nreturn {}\nend\n"
      local code, output = run(source .. 'glNoDiscardMake()')
      assert(code != 0 and output.find("Result 1 of 'glNoDiscardMake' is marked @NoDiscard") != nil,
         'A discarded direct global result must fail compilation: ' .. output)
      assert(output.find('ND_CONSTRUCTOR_EXECUTED') is nil, 'A rejected global constructor must never execute')
      code, output = run(source .. 'local value = glNoDiscardMake()')
      assert(code is 0 and output.find('ND_CONSTRUCTOR_EXECUTED') != nil,
         'A stored direct global result should execute normally: ' .. output)
   end
end

@Test function ActiveInterfacesAndToolingReportImportedCalls()
   clear_cache()
   local code, output = run([[
import 'nd-outer'
local result = debug.validate("import 'nd-base'\nnd.make()")
assert(not result.success and #result.diagnostics is 1, 'Expected one imported call diagnostic')
assert(result.diagnostics[0].code is 'NoDiscard', 'Expected NoDiscard code')
assert(result.diagnostics[0].line is 2, 'Expected the importer call line')
local reexport = debug.validate("import 'nd-outer'\nnd_exported()")
assert(not reexport.success and reexport.diagnostics[0].code is 'NoDiscard', 'Expected re-export contract')
local source = debug.validate("import 'nd-base'\nnd.make()", { symbols=true })
assert(not source.success and source.diagnostics[0].code is 'NoDiscard', 'Expected source-tooling contract')
for options in values(array<table> { {}, { symbols=true } }) do
   local safe = debug.validate("import 'nd-base'\nnd?.make()", options)
   assert(not safe.success and #safe.diagnostics is 1, 'Expected one safe imported call diagnostic')
   assert(safe.diagnostics[0].code is 'NoDiscard', 'Expected the safe imported contract')
end
print('ND_TOOLING_OK')
]])
   assert(code is 0 and output.find('ND_TOOLING_OK') != nil, 'Active/tooling interface checks failed: ' .. output)
end

@Test function ImportedBodyDiagnosticsKeepTheirSourceFile()
   local code, output = run([[
local result = debug.validate("import './bad_local'\nimport './bad_local'", { path=@SourceFile })
assert(not result.success and #result.diagnostics is 1, 'Expected one diagnostic from the imported body')
assert(result.diagnostics[0].code is 'NoDiscard', 'Expected NoDiscard code')
assert(result.diagnostics[0].line is 2, 'Expected the imported call line')
assert(result.diagnostics[0].file is 'bad_local.tiri', 'Expected the imported source file')
print('ND_ATTRIBUTION_OK')
]])
   assert(code is 0 and output.find('ND_ATTRIBUTION_OK') != nil, 'Imported source attribution failed: ' .. output)
end
