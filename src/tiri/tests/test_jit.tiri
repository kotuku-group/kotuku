@Test function ConstrainedObjectFieldTypePropagation()
   local script = obj.new('tiri', { statement=[[
struct PhaseTwoObjectHolder Clock: obj<Time> end
function readYear(Holder:struct<PhaseTwoObjectHolder>):num
   return Holder.Clock.year
end
]] })
   check script.acQuery()
   check script.acActivate()
   local _, disassembly = script.mtDebugLog('disasm')
   assert(disassembly.find('STGETF') != nil, 'The constrained object should be read with STGETF')
   assert(disassembly.find('OBGETF') != nil, 'obj<Class> metadata should specialise chained object field access')
end

