-- Flute regression tests for the defer keyword

@BeforeEach(hotpath=true)
function enforce_hotpath() end

function join(values:table):str
   return values.concat(',')
end

@Test function BasicExecution()
   order = {}
   function subject()
      defer
         order.insert('deferred')
      end
      order.insert('body')
   end

   subject()
   assert(join(order) is 'body,deferred', "Expected body before deferred handler, got '" .. join(order) .. "'")
end

@Test function DeferWithoutParens()
   order = {}

   function subject()
      defer
         order.insert('alpha')
      end

      defer()
         order.insert('beta')
      end

      order.insert('body')
   end

   subject()

   assert(join(order) is 'body,beta,alpha', "Expected mix of defer syntaxes to preserve order, got '" .. join(order) .. "'")
end

@Test function LifoOrder()
   order = {}
   function subject()
      defer
         order.insert('first')
      end
      defer
         order.insert('second')
      end
      defer
         order.insert('third')
      end
      order.insert('body')
   end

   subject()
   assert(join(order) is 'body,third,second,first', "Expected LIFO order for defers, got '" .. join(order) .. "'")
end

function subjectReturn(order)
   defer
      order.insert('deferred')
   end
   order.insert('before-return')
   return 'result'
end

@Test function EarlyReturn()
   order = {}
   value = subjectReturn(order)

   assert(value is 'result', "Expected subjectReturn result to be 'result', got '" .. tostring(value) .. "'")
   assert(join(order) is 'before-return,deferred', "Expected deferred handler to run after return, got '" .. join(order) .. "'")
end

@Test function NestedScopes()
   order = {}

   function subject()
      defer
         order.insert('outer')
      end

      do
         defer
            order.insert('inner')
         end
         order.insert('inner-body')
      end

      order.insert('after-inner')
   end

   subject()

   assert(join(order) is 'inner-body,inner,after-inner,outer', "Expected inner defer before outer, got '" .. join(order) .. "'")
end

@Test function Break()
   order = {}

   function subject()
      for i in {0 to 3} do
         defer
            order.insert('loop-' .. tostring(i))
         end
         order.insert('before-break-' .. tostring(i))
         break
      end
   end

   subject()
   assert(join(order) is 'before-break-0,loop-0', "Expected loop defer to run on break, got '" .. join(order) .. "'")
end

@Test function Continue()
   order = {}

   function subject()
      for i in {0 to 2} do
         defer
            order.insert('defer-' .. tostring(i))
         end
         order.insert('body-' .. tostring(i))
         if i is 0 then
            order.insert('continue-' .. tostring(i))
            continue
         end
         order.insert('after-' .. tostring(i))
      end
   end

   subject()
   assert(join(order) is 'body-0,continue-0,defer-0,body-1,after-1,defer-1', "Unexpected continue defer order: '" .. join(order) .. "'")
end

@Test function Upvalues()
   captures = {}

   function subject()
      value = 10
      defer
         captures.insert(value)
      end
      value = 25
      captures.insert('body')
      value = 30
   end

   subject()

   assert(join(captures) is 'body,30', "Expected upvalue capture to reflect latest value, got '" .. join(captures) .. "'")
end

@Test function ArgumentSnapshot()
   events = {}

   function subject()
      value = 5

      defer(arg)
         events.insert('defer-' .. tostring(arg))
      end(value)

      events.insert('body-' .. tostring(value))
      value += 10
      events.insert('mutated-' .. tostring(value))
   end

   subject()

   assert(join(events) is 'body-5,mutated-15,defer-5',
      "Deferred argument should snapshot initial value: '" .. join(events) .. "'")
end

@Test function MultiReturnPreservesLocals()
   function subject()
      head = 'alpha'
      tail = 'omega'

      defer
         head = 'mutated-alpha'
         tail = 'mutated-omega'
      end

      return head, tail
   end

   first, second = subject()

   assert(first is 'alpha', "Expected first return value to remain 'alpha', got '" .. tostring(first) .. "'")
   assert(second is 'omega', "Expected second return value to remain 'omega', got '" .. tostring(second) .. "'")
end

@Test function TailCallResultsBeforeDefer()
   order = {}

   function source()
      order.insert('call')
      return 'first', 'second'
   end

   function subject()
      defer
         order.insert('defer')
      end
      return source()
   end

   local first, second = subject()
   assert(first is 'first' and second is 'second', 'Deferred cleanup must preserve all returned call values')
   assert(order[0] is 'call' and order[1] is 'defer', 'The returned call must execute before deferred cleanup')
end

@Test function ConditionalScopes()
   order = {}

   function subject()
      defer
         order.insert('outer')
      end

      if true then
         defer
            order.insert('if-block')
         end
         order.insert('if-body')
      end

      order.insert('after-if')
   end

   subject()

   assert(join(order) is 'if-body,if-block,after-if,outer', "Unexpected conditional defer order: '" .. join(order) .. "'")
end

@Test function LoopMultipleDefers()
   order = {}

   function subject()
      for i in {0 to 2} do
         defer
            order.insert('outer-' .. tostring(i))
         end
         do
            defer
               order.insert('inner-' .. tostring(i))
            end
            order.insert('inner-body-' .. tostring(i))
         end
         order.insert('loop-body-' .. tostring(i))
      end
   end

   subject()
   local joined = join(order)
   local expected = 'inner-body-0,inner-0,loop-body-0,outer-0,inner-body-1,inner-1,loop-body-1,outer-1'
   assert(joined is expected, f"Unexpected nested loop defer order: '{joined}', expected '{expected}'")

   total = 0
   step = 1
   repeat
      defer
         total = total + step
      end
      total = total + step
   until total > 5

   assert(total is 6, "Expected total to be 6 after loop")
end

@Test function HandlerError()
   -- Phase 3 placeholder: deferred handler error propagation to be implemented.
end

function recurse(n, order)
   defer
      order.insert('defer-' .. tostring(n))
   end
   order.insert('enter-' .. tostring(n))
   if n > 1 then
      recurse(n - 1, order)
   end
   order.insert('leave-' .. tostring(n))
end

@Test function Recursive()
   order = {}
   recurse(3, order)

   assert(join(order) is 'enter-3,enter-2,enter-1,leave-1,defer-1,leave-2,defer-2,leave-3,defer-3', "Unexpected recursive defer order: '" .. join(order) .. "'")
end

@Test function ClosureReturn()
   calls = {}
   function make()
      sum = 0
      defer
         sum += 5
         calls.insert(sum)
      end
      sum += 10
      return sum
   end

   value = make()
   assert(value is 10, "Expected make() to return immediate sum, got " .. tostring(value))
   assert(join(calls) is '15', "Expected deferred closure to observe mutated state, got '" .. join(calls) .. "'")
end

@Test function ResourceCleanupPattern()
   log = {}

   function cleanup(resource, token)
      log.insert('cleanup-' .. resource.name .. '-' .. token)
   end

   function acquire(name)
      log.insert('acquire-' .. name)
      return { name = name }
   end

   function subject()
      resource = acquire('alpha')
      label = 'start'

      defer(handler, handle, token)
         handler(handle, token)
      end(cleanup, resource, label .. '-token')

      resource.name = 'beta'
      label = 'updated'
      log.insert('body-' .. resource.name .. '-' .. label)
   end

   subject()

   assert(join(log) is 'acquire-alpha,body-beta-updated,cleanup-beta-start-token',
      "Resource cleanup should receive original token value: '" .. join(log) .. "'")
end
