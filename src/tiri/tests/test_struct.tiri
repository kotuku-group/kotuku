@Test function StructCopyAndClone()
   MAKESTRUCT('CopyChild', 'lValue,zsLabel')
   MAKESTRUCT('CopyRecord', 'lCount,zsName,eChild:CopyChild')
   MAKESTRUCT('CopyMismatch', 'lCount')

   local source = struct.new('CopyRecord', { count=12, name='source' })
   source.child.value = 44
   source.child.label = 'nested'

   local clone = struct.clone(source)
   assert(clone.count is 12 and clone.name is 'source', 'clone() should copy primitive and C++ string fields')
   assert(clone.child.value is 44 and clone.child.label is 'nested', 'clone() should copy nested struct fields')

   source.name = 'changed'
   source.child.label = 'changed nested'
   assert(clone.name is 'source' and clone.child.label is 'nested', 'clone strings should own independent storage')

   local dest = struct.new('CopyRecord')
   assert(struct.copy(dest, clone) is dest, 'copy() should return its destination')
   assert(dest.count is 12 and dest.child.label is 'nested', 'copy() should replace the destination payload')

   try
      struct.copy(struct.new('CopyMismatch'), source)
   success
      assert(false, 'Copying mismatched struct definitions should fail')
   end
end

