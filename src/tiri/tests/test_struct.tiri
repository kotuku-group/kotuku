@Test function NativeStructDeclarationErrors()
   try
      exec([[struct RetiredBraceDeclaration { Value: int }]])
   success
      assert(false, "Brace-delimited struct declarations should fail to compile")
   end

   try
      MAKESTRUCT('Bad_Name', 'lValue')
   success
      assert(false, 'MAKESTRUCT should reject names containing non-alphanumeric characters')
   end

   try
      exec([[struct Bad_Name Value: int end]])
   success
      assert(false, 'Struct declarations should reject names containing non-alphanumeric characters')
   end

   exec([[
struct IdenticalLayout Value: int end
struct IdenticalLayout Value: int end
local value = struct<IdenticalLayout> { Value=12 }
assert(value.Value is 12)
]])

   try
      exec([[struct BadUnknownType Value: mystery end]])
   success
      assert(false, 'Unknown declaration field types should fail')
   end

   try
      exec([[struct RetiredInt32 Value: int32 end]])
   success
      assert(false, 'Struct declarations should reject the retired int32 alias')
   end

   try
      exec([[struct RetiredUInt32 Value: uint32 end]])
   success
      assert(false, 'Struct declarations should reject the retired uint32 alias')
   end

   try
      exec([[struct RetiredInt32Array Values: array<int32> end]])
   success
      assert(false, 'Struct array fields should reject the retired int32 alias')
   end

   try
      exec([[struct RetiredUInt32Array Values: array<uint32> end]])
   success
      assert(false, 'Struct array fields should reject the retired uint32 alias')
   end

   try
      exec([[struct RetiredInt32Pointer Value: ptr<int32> end]])
   success
      assert(false, 'Struct pointer fields should reject the retired int32 alias')
   end

   try
      exec([[struct RetiredUInt32Pointer Value: ptr<uint32> end]])
   success
      assert(false, 'Struct pointer fields should reject the retired uint32 alias')
   end

   try
      exec([[struct BadForwardReference Value: struct<NotDeclaredYet> end]])
   success
      assert(false, 'Forward struct references should fail')
   end

   try
      exec([[struct BadCaseCollision Value: int, value: int end]])
   success
      assert(false, 'Case-insensitive field-name collisions should fail')
   end

   try
      exec([[struct BadArrayDimensionRange Values: int[4294967296] end]])
   success
      assert(false, 'Array dimensions that exceed the parser integer range should fail')
   end

   try
      exec([[struct BadArrayStorageRange Values: int[20000] end]])
   success
      assert(false, 'Array layouts that exceed the native struct offset range should fail')
   end

   try
      exec([[
struct ConflictingLayout Value: int end
struct ConflictingLayout Value: double end
]])
   success
      assert(false, 'Conflicting declarations should fail')
   end
   exec([[
struct ConflictingLayout Value: double end
local value = struct<ConflictingLayout> { Value=2.5 }
assert(value.Value is 2.5)
]])

   exec([[
local struct = { marker=42 }
assert(struct.marker is 42)
]])
end

----------------------------------------------------------------------------------------------------------------------

@Test function NativeStructConcurrentRegistration()
   local total = 16
   local completed = 0
   local succeeded = 0
   local failed = 0
   local signal = obj.new('time', { })
   local proc = processing.new({ timeout=5.0, signals=array<obj> { signal } })
   local scripts = array<obj>

   for i in {0 to total} do
      local statement
      if (i & 1) is 0 then
         statement = [[
struct ConcurrentDeclaredStruct Value: int end
local value = struct<ConcurrentDeclaredStruct> { Value=42 }
assert(value.Value is 42)
]]
      else
         statement = [[
struct ConcurrentDeclaredStruct Value: double end
local value = struct<ConcurrentDeclaredStruct> { Value=42.5 }
assert(value.Value is 42.5)
]]
      end
      if (i & 2) is 0 then
         statement ..= [[
struct ConcurrentInvalidStruct Value: mystery end]]
      end
      scripts.push(obj.new('tiri', { statement=statement }))
   end

   for script in values(scripts) do
      async.script(script, function(Object)
         if Object.error is ERR_Okay then succeeded++
         else failed++ end
         completed++
         if completed >= total then signal.acSignal() end
      end)
   end

   check proc.sleep()
   assert(succeeded is total / 2 and failed is total / 2,
      f'Expected equal successful and failed concurrent declarations, got {succeeded}/{failed}')
   exec([[struct ConcurrentDeclaredStruct Value: int end
assert(struct<ConcurrentDeclaredStruct> { Value=17 }.Value is 17)]])
end

@Test(hotpath=true)
function ProbeStruct()
   local meta = mSys.FindClass('task'.hash(), 0)
   local err, field = meta.mtFindField('args'.hash())
   assert(type(field) is 'table', 'Failed to find args field in task class')
   assert(field.name is 'Args', 'Expected string type for field name')
   assert(field.fieldID > 0, 'Expected fieldID to be greater than zero')
   assert(field.index > 0, 'Expected field index to be greater than zero')
   assert(type(field.writeValue) is 'userdata', 'Expected writeValue to be a function pointer')
end

