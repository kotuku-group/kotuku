@Test function ArrayFieldAssignments()
   MAKESTRUCT('ArrayAssignmentRecord', 'lFixed[3],zlDynamic[1],zsNames[1]')
   local value = struct.new('ArrayAssignmentRecord')

   value.fixed = array<int> { 4, 5, 6 }
   assert(value.fixed is array<int> { 4, 5, 6 }, 'Fixed array assignment should copy all elements')

   value.fixed = array<int> { 9 }
   assert(value.fixed is array<int> { 9, 0, 0 }, 'Short fixed array assignment should clear unused elements')

   value.fixed = array<int>
   assert(value.fixed is array<int> { 0, 0, 0 }, 'Empty fixed array assignment should clear all elements')

   value.dynamic = array<int> { 8, 9, 10, 11 }
   assert(value.dynamic is array<int> { 8, 9, 10, 11 }, 'C++ vector assignment should resize and copy elements')

   value.names = array<str> { 'alpha', 'beta' }
   local names = value.names
   assert(#names is 2 and names[0] is 'alpha' and names[1] is 'beta',
      'C++ string vector assignment should copy strings')

   local clone = struct.clone(value)
   value.dynamic = array<int> { 99 }
   value.names = array<str> { 'changed' }
   assert(clone.dynamic is array<int> { 8, 9, 10, 11 }, 'clone() should deep-copy C++ primitive vectors')
   local clone_names = clone.names
   assert(#clone_names is 2 and clone_names[0] is 'alpha' and clone_names[1] is 'beta',
      'clone() should deep-copy C++ string vectors')

   try
      value.fixed = array<int> { 1, 2, 3, 4 }
   success
      assert(false, 'Fixed array overflow should fail')
   end

   try
      value.fixed = array<double> { 1, 2 }
   success
      assert(false, 'Array element type mismatch should fail')
   end
end

