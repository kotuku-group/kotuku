-- Declarations no longer bind a constructor variable; construction must use the explicit struct<Name> form.

@Test function ExplicitConstructionRequired()
   try
      exec([[
struct RetiredTableSyntax Value: int end
local value = RetiredTableSyntax { Value=1 }
]])
   success
      assert(false, 'The retired Name { fields } construction syntax should fail to compile')
   end

   try
      exec([[
struct RetiredCallSyntax Value: int end
local value = RetiredCallSyntax()
]])
   success
      assert(false, 'The retired Name() construction syntax should fail to compile')
   end

   try
      exec([[local value = struct<NotARegisteredStruct> { }]])
   success
      assert(false, 'Constructing an unknown struct name should fail to compile')
   end

   exec([[
struct OmittedInitialiser Value: int end
local value = struct<OmittedInitialiser>
assert(value.Value is 0, 'struct<Name> without an initialiser table should be zero-initialised')
]])
end

----------------------------------------------------------------------------------------------------------------------

@Test function ConstrainedObjectField()
   local holder = struct<DeclaredUser> { }
   local clock = obj.new('time', { })
   holder.Object = clock
   holder.Object = nil
   assert(holder.Object is nil, 'Unconstrained object fields should allow nil clearing')
   holder.Clock = clock
   assert(holder.Clock.year is clock.year, 'obj<Class> fields should retain typed object references')
   holder.Clock = nil
   assert(holder.Clock is nil, 'Constrained object fields should allow nil clearing')

   try
      holder.Clock = obj.new('tiri', { statement='return 1' })
   success
      assert(false, 'obj<Class> fields should reject objects of another class')
   end
end

----------------------------------------------------------------------------------------------------------------------
-- A sub-class satisfies a base class constraint: 'json' declares XML as its base class, so an obj<XML> field must
-- accept it.  An exact ClassID comparison would incorrectly reject this.

@Test function ConstrainedObjectFieldAcceptsSubClass()
   local holder = struct<DeclaredUser> { }
   local markup = obj.new('xml', { statement='<a/>' })
   holder.Markup = markup
   assert(holder.Markup is not nil, 'obj<Class> fields should accept an exact class match')

   local derived = obj.new('json', { statement='{ "a": 1 }' })
   holder.Markup = derived
   assert(holder.Markup is not nil, 'obj<Class> fields should accept a sub-class of the constrained base class')

   try
      holder.Markup = obj.new('time', { })
   success
      assert(false, 'obj<Class> fields should still reject unrelated classes')
   end
end

