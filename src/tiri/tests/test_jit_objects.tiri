@Test(hotpath=100) function NumericHashKeyStoresClassifyOnTrace()
   -- Negative and fractional keys can never be sequence indices, so they classify the table as sparse.  Recorded
   -- stores must reach the same conclusion as the interpreter, including after the trace becomes hot.
   local negative = { 1, 2, 3 }
   local fractional = { 1, 2, 3 }
   for i in {0 to 200} do
      negative[-1 - (i % 4)] = i
      fractional[0.5 + (i % 4)] = i
   end
   assert(#negative is nil, f"Negative keys should classify on trace, got {tostring(#negative)}")
   assert(negative.kind() is 'sparse', f"Expected sparse, got {negative.kind()}")
   assert(#fractional is nil, f"Fractional keys should classify on trace, got {tostring(#fractional)}")
   assert(fractional.kind() is 'sparse', f"Expected sparse, got {fractional.kind()}")
end

@Test(hotpath=100) function DistantNumericKeyStoresStayNumericalOnTrace()
   -- Positive holes remain inside the sequence-compatible key domain.  The classification does not promise that
   -- every slot below the numerical boundary is populated.
   local distant = { 1, 2, 3 }
   for i in {0 to 200} do
      distant[9000 + (i % 4)] = i
   end
   assert(#distant is 3, f"Distant positive keys should preserve the length on trace, got {tostring(#distant)}")
   assert(distant.kind() is 'sequence', f"Expected sequence, got {distant.kind()}")
end

@Test(hotpath=100) function NumericStoreTraceExitsOnFirstNegativeKey()
   -- Warm a variable-key store with non-negative hash keys, then cross into the sparse domain without changing the
   -- key's integer type.  The recorded non-negative guard must side-exit so the interpreter publishes TAB_SPARSE.
   jit.flush()
   jit.opt.start('hotloop=2', 'hotexit=1', 'minstitch=0')

   local t = {}
   for i in {0 to 100} do
      local key = i < 80 ? 1000 + (i % 4) : -1
      t[key] = i
   end

   assert(#t is nil, f"The first negative key must invalidate length, got {tostring(#t)}")
   assert(t.kind() is 'sparse', f"Expected sparse after the side exit, got {t.kind()}")
   jit.opt.start()
end

