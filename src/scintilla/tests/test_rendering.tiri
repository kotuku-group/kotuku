-- Plain-text repaint coverage for bitmap and scalable fonts, alongside the styled and folding suites.
-- Every incremental result must equal a forced full repaint through the public API.

   include 'scintilla', 'vector', 'display'
   module display as mGfx
   import './repaint_utils'

function compareRepaints(Face:str, Size:num)
   local scene <close> = obj.new('VectorScene', { pageWidth=280, pageHeight=130 })
   local viewport = scene.new('VectorViewport', { x=0.25, y=0.5, width=279, height=129 })
   local sci = viewport.new('Scintilla', { face=Face, fontSize=Size, lineNumbers=true, symbols=true,
      showWhitespace=true, lineHighlight='255,255,255,0', selectFore='0,0,0,0', selectBkgd='0,0,255,128' })
   local bitmap <close> = obj.new('Bitmap', { width=280, height=130, bitsPerPixel=32 })
   scene.bitmap = bitmap
   local lines = array<str> { }
   for i in {0 to 100} do lines.push(f'{i}\tAV café 😀 é  more text and a long suffix') end
   sci.string = lines.concat('\n')
   check sci.mtDefineMarker(0, SCMK_CIRCLE, struct<RGB8> { red=255, green=255, blue=255, alpha=255 },
      struct<RGB8> { red=255, green=0, blue=0, alpha=255 })
   check sci.mtAddMarker(1, 0)
   repaint_utils.assertFull(scene, sci, bitmap, 'Initial document')

   check sci.mtSelectRange(3, 100)
   repaint_utils.assertFull(scene, sci, bitmap, 'Translucent selection')
   check sci.mtInsertText('inserted é😀\n', 5)
   repaint_utils.assertFull(scene, sci, bitmap, 'Multibyte insertion')
   check sci.mtReplaceLine(2, 'short line', -1)
   repaint_utils.assertFull(scene, sci, bitmap, 'Shorter replacement')
   check sci.mtDeleteLine(3)
   repaint_utils.assertFull(scene, sci, bitmap, 'Deleted line')
   for _, line in array<int> { 3, 5, 6, 4, 20, 19, 18, 50, 0 } do
      check sci.mtGotoLine(line)
      repaint_utils.assertFull(scene, sci, bitmap, f'Scroll to line {line}')
   end

   check sci.mtGotoLine(20)
   repaint_utils.render(scene)
   check sci.mtInsertText('pending edit ', 0)
   check sci.mtGotoLine(21)
   check sci.mtGotoLine(22)
   repaint_utils.assertFull(scene, sci, bitmap, 'Pending edit and consecutive scrolls')
   check sci.mtScrollToPoint(30.5, 0)
   repaint_utils.assertFull(scene, sci, bitmap, 'Fractional horizontal scroll')
   sci.lineNumbers = false
   sci.symbols = false
   repaint_utils.assertFull(scene, sci, bitmap, 'Hidden margins')
   sci.lineNumbers = true
   sci.symbols = true
   viewport.width = 210.5
   viewport.height = 105.25
   repaint_utils.assertFull(scene, sci, bitmap, 'Resized fractional viewport')
   sci.fontSize = Size + 3
   repaint_utils.assertFull(scene, sci, bitmap, 'Font reload')
end

@Test function BitmapIncrementalRepaints()
   compareRepaints('Clean', 11)
end

@Test function ScalableIncrementalRepaints()
   compareRepaints('Source Code Pro', 14)
end


@Test function DisabledSelectionOverrideKeepsTextVisible()
   local scene <close> = obj.new('VectorScene', { pageWidth=140, pageHeight=40 })
   local viewport = scene.new('VectorViewport', { width=140, height=40 })
   local sci = viewport.new('Scintilla', { face='Clean', fontSize=11, lineHighlight='255,255,255,0',
      selectFore='0,0,0,255', selectBkgd='0,0,255,128' })
   local bitmap <close> = obj.new('Bitmap', { width=140, height=40, bitsPerPixel=32 })
   scene.bitmap = bitmap
   sci.string = 'HHHH'
   check sci.mtSelectRange(0, 4)
   repaint_utils.render(scene)
   sci.selectBkgd = '0,0,0,0'
   repaint_utils.render(scene)
   local dark = 0
   for y in {0 to 13} do
      for x in {4 to 32} do
         local p = mGfx.ReadRGBPixel(bitmap, x, y)
         if p.red + p.green + p.blue < 100 then dark++ end
      end
   end
   assert(dark > 20, 'Disabling SelectBkgd must restore base-layer selection without covering the text')
end
