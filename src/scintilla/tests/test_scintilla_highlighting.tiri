-- Pixel-level lexer regressions use Clean's fixed 7 by 13 geometry.  No display or GUI wrapper is required.

   include 'scintilla', 'vector', 'display', 'xml'
   import './lexer_utils'
   module display as mGfx
   module vector as mVec

   namespace gui { }
   import '../../../packages/gui/palettes_data'
   import './theme_utils'

WIDTH = 360
HEIGHT = 160
KEYWORD = '178,34,34'
COMMENT = '128,128,128'
STRING = '176,0,0'
NUMBER = '0,0,255'
TYPE = '148,0,211'
ERROR = '255,0,0'
TEXT = '0,0,0'

function newEditor(Options:table):<obj, obj, obj>
   local scene = obj.new('VectorScene', { pageWidth=WIDTH, pageHeight=HEIGHT })
   local vp = scene.new('VectorViewport', { width='100%', height='100%' })
   local options = Options ?? { }
   options.textStyle = 'face=Clean; size=11px'
   local sci = vp.new('Scintilla', options)
   theme_utils.apply(sci, { lineHighlight='transparent' })
   local bmp = obj.new('Bitmap', { width=WIDTH, height=HEIGHT, bitsPerPixel=32 })
   scene.bitmap = bmp
   return scene, sci, bmp
end

function render(Scene:obj)
   check Scene.acDraw()
   processing.sleep(0)
   check Scene.acDraw()
end

function pixelsOf(Bitmap:obj, Colour:str, X:num, Y:num, Width:num, Height:num):num
   local count = 0
   for y in {Y to Y + Height} do
      for x in {X to X + Width} do
         local pixel = mGfx.ReadRGBPixel(Bitmap, x, y)
         if f'{pixel.red},{pixel.green},{pixel.blue}' is Colour then count++ end
      end
   end
   return count
end

function expectToken(Bitmap:obj, Token:str, Colour:str, Column:num, Row:num)
   assert(pixelsOf(Bitmap, Colour, 4 + (Column ?? 0) * 7, (Row ?? 0) * 13, #Token * 7, 13) > 0,
      f'Expected "{Token}" to render in {Colour}')
end

@Test function EveryPublicLexerHasAProfile()
   local samples = array<table> {
      { 'json', 'true', 'true', KEYWORD },
      { 'markdown', '# Heading', 'Heading', KEYWORD, 2 },
      { 'cpp', 'int value;', 'int', KEYWORD },
      { 'tiri', 'defer print(value) end', 'defer', KEYWORD },
      { 'python', 'def example():', 'def', KEYWORD },
      { 'perl', 'my $value;', 'my', KEYWORD },
      { 'sql', 'SELECT value FROM example;', 'SELECT', KEYWORD },
      { 'vb', 'Dim value', 'Dim', KEYWORD },
      { 'props', '[main]', '[main]', KEYWORD },
      { 'errorlist', 'example.c:3: error: missing value', 'example.c', ERROR },
      { 'makefile', '# comment', '# comment', COMMENT },
      { 'batch', 'echo value', 'echo', KEYWORD },
      { 'diff', '+added', '+added', STRING },
      { 'pascal', 'begin', 'begin', KEYWORD },
      { 'ruby', 'class Example', 'class', KEYWORD },
      { 'vbscript', 'Dim value', 'Dim', KEYWORD },
      { 'asp', '<% Dim value %>', 'Dim', KEYWORD, 3 },
      { 'asm', 'mov eax, ebx', 'mov', KEYWORD },
      { 'css', 'a { color: red; }', 'color', TYPE, 4 },
      { 'bash', 'if true; then', 'if', KEYWORD },
      { 'html', '<div class="example">', 'div', KEYWORD, 1 },
      { 'xml', '<custom value="example"/>', 'custom', KEYWORD, 1 },
      { 'phpscript', 'function example() {}', 'function', KEYWORD },
      { 'rebol', 'REBOL [] func [value] [print value]', 'func', KEYWORD, 9 }
   }
   local scene <close>, sci, bmp = newEditor()
   for sample in values(samples) do
      if not lexer_utils.supports(sci, sample[0]) then continue end
      sci.lexerName = sample[0]
      sci.string = sample[1]
      render(scene)
      expectToken(bmp, sample[2], sample[3], sample[4], 0)
   end
end

@RequiresLexers(tiri=true)
@Test function TiriReservedWords()
   -- Includes extensions and words reserved for future syntax.
   local words = ('and as break choose checkall continue defer do else elseif end enum extern false for from ' ..
      'function global has if import in is local namespace nil not or repeat return then thunk true try except ' ..
      'until when success raise check while with class interface record extends export await yield ' ..
      'using where').split(' ')
   local scene <close>, sci, bmp = newEditor({ lexer=SCLEX_TIRI })
   for _, word in words do
      sci.string = word .. ' '
      render(scene)
      expectToken(bmp, word, KEYWORD, 0, 0)
   end
   sci.string = 'deferred -- defer\n"choose"\n123\nidentifier'
   render(scene)
   expectToken(bmp, 'deferred', TEXT, 0, 0)
   expectToken(bmp, '-- defer', COMMENT, 9, 0)
   expectToken(bmp, '"choose"', STRING, 0, 1)
   expectToken(bmp, '123', NUMBER, 0, 2)
   expectToken(bmp, 'identifier', TEXT, 0, 3)
end

@RequiresLexers(cpp=true, python=true, tiri=true)
@Test function LexerChangesRefreshKeywordsAndColours()
   local scene <close>, sci, bmp = newEditor({ lexer=SCLEX_CPP })
   sci.string = 'defer int\n"text"\n// comment'
   render(scene)
   expectToken(bmp, 'defer', TEXT, 0, 0)
   expectToken(bmp, 'int', KEYWORD, 6, 0)
   expectToken(bmp, '// comment', COMMENT, 0, 2)
   sci.lexer = SCLEX_TIRI
   render(scene)
   expectToken(bmp, 'defer', KEYWORD, 0, 0)
   expectToken(bmp, 'int', TEXT, 6, 0)
   sci.lexer = SCLEX_PYTHON
   sci.string = 'def\n"text"\n# comment\n123'
   render(scene)
   expectToken(bmp, 'def', KEYWORD, 0, 0)
   expectToken(bmp, '"text"', STRING, 0, 1)
   expectToken(bmp, '# comment', COMMENT, 0, 2)
   expectToken(bmp, '123', NUMBER, 0, 3)
   sci.lexer = 0
   render(scene)
   expectToken(bmp, 'def', TEXT, 0, 0)
   expectToken(bmp, '"text"', TEXT, 0, 1)
end

@RequiresLexers(cpp=true, tiri=true)
@Test function ThemeUpdatesAreLocalAndPreserveState()
   local scene <close>, sci, bmp = newEditor({ lexer=SCLEX_TIRI, foldingMarkers=true })
   local other_scene <close>, other, other_bmp = newEditor({ lexer=SCLEX_TIRI })
   sci.string = 'function example()\n   return 123\nend\n"text"\n-- comment'
   other.string = 'function example()'
   render(scene)
   assert(sci.mtToggleFold(0) is ERR_Okay, 'The lexer must retain working folds')
   check sci.mtSelectRange(9, 16)
   render(scene)
   assert(pixelsOf(bmp, STRING, 24, 13, 70, 13) > 0, 'Contracting the function must move the string to row 1')
   local folded_height = sci.page.height
   local text = sci.string
   local modified = sci.modified

   local theme <close> = obj.new('XML', { statement=[[<theme><palette background="#141e28" text="#f0f0f0"
      keyword="#14f0a0" string="#f0d278" comment="#78b4c8" number="#b48cff" operator="#f0f0f0"
      preprocessor="#c8dc78" type="#64c8fa" error="#ff6478" margin="#c8c8c8" marginBackground="#2d3741"
      selectionForeground="#f0f0f0" selectionBackground="#3c4650" cursor="#f0f0f0"/></theme>]] })
   sci.themeXML = theme
   render(scene)
   render(other_scene)
   assert(sci.string is text and sci.modified is modified, 'Theme updates must preserve document state')
   assert(sci.page.height is folded_height, 'Theme updates must preserve the page height')
   assert(pixelsOf(bmp, '240,210,120', 24, 13, 70, 13) > 0, 'Theme updates must preserve the contracted fold')
   assert(pixelsOf(bmp, '20,240,160', 24, 0, 150, 13) > 0, 'The folded header must use the new keyword colour')
   assert(pixelsOf(bmp, '20,30,40', 250, 0, 20, HEIGHT) > 0, 'The document background must update')
   assert(pixelsOf(bmp, '45,55,65', 0, 0, 20, HEIGHT) > 0, 'The fold margin must update')
   expectToken(other_bmp, 'function', KEYWORD, 0, 0)
   assert(theme_utils.rgb(sci, 'selectionBackground').red is 60, 'Selection colours must be writable after Init')
   assert(pixelsOf(bmp, '60,70,80', 87, 0, 49, 13) > 20, 'Theme updates must preserve the selection')

   sci.lexer = SCLEX_CPP
   sci.string = 'int value;'
   render(scene)
   assert(pixelsOf(bmp, '20,240,160', 24, 0, 21, 13) > 0, 'Custom colours must survive a lexer switch')
end

@RequiresLexers(cpp=true, tiri=true)
@Test function FileDetectionRefreshesProfilesAndFolding()
   local scene <close>, sci, bmp = newEditor({ flags=SCIF_DETECT_LEXER, foldingMarkers=true })
   for sample in values(array<table> {
      { 'temp:scintilla_highlighting.c', 'int example() {\nreturn 1;\n}\n', SCLEX_CPP, 'int' },
      { 'temp:scintilla_highlighting.tiri', 'function example()\nreturn 1\nend\n', SCLEX_TIRI, 'function' }
   }) do
      local path = sample[0]
      defer mSys.DeleteFile(path) end
      do
         local file <close> = obj.new('File', { path=path, flags=FL_NEW|FL_WRITE })
         check file.acWrite(sample[1])
      end
      sci.path = path
      render(scene)
      assert(sci.lexer is sample[2], 'Loading a recognised extension must change the lexer')
      assert(pixelsOf(bmp, KEYWORD, 24, 0, #sample[3] * 7, 13) > 0, 'Detection must refresh keyword highlighting')
      assert(sci.mtToggleFold(0) is ERR_Okay, 'The lexer must retain working folds')
      render(scene)
      assert(sci.mtToggleFold(0) is ERR_Okay, 'The lexer must retain working folds')
   end
end

-- Exercise the existing GUI palette data without importing a GUI editor wrapper.

function paletteColour(Value:str):struct
   local painter = struct<VectorPainter>
   check mVec.ReadPainter(nil, Value, painter)
   local colour = painter.colour
   return struct<RGB8> {
      red=math.floor(math.clamp(colour.red, 0, 1) * 255 + 0.5),
      green=math.floor(math.clamp(colour.green, 0, 1) * 255 + 0.5),
      blue=math.floor(math.clamp(colour.blue, 0, 1) * 255 + 0.5), alpha=255
   }
end

@RequiresLexers(tiri=true)
@Test function GuiPaletteColoursReachDirectEditors()
   local scene <close>, sci, bmp = newEditor({ lexer=SCLEX_TIRI })
   sci.string = 'defer value'
   for palette in values(array<table> { gui.palettes.ocean.light, gui.palettes.ocean.dark }) do
      local theme <close> = obj.new('XML', { statement=f'<theme><palette background="{palette.bkgd}" ' ..
         f'text="{palette.text}" keyword="{palette.prime}" comment="{palette.handle}" string="{palette.success}" ' ..
         f'type="{palette.contrast}" error="{palette.error}" marginBackground="{palette.neutral}"/></theme>' })
      sci.themeXML = theme
      render(scene)
      local keyword = paletteColour(palette.prime)
      local background = theme_utils.rgb(sci, 'background')
      expectToken(bmp, 'defer', f'{keyword.red},{keyword.green},{keyword.blue}', 0, 0)
      assert(pixelsOf(bmp, f'{background.red},{background.green},{background.blue}', 250, 0, 20, HEIGHT) > 0,
         'The editor must render the GUI palette background')
   end
end

@RequiresLexers(cpp=true, python=true, tiri=true)
@Test function DifferentLexersRemainIndependent()
   local scene <close>, sci, bmp = newEditor({ lexer=SCLEX_CPP })
   sci.string = 'int value;'
   local other_scene <close>, other, other_bmp = newEditor({ lexer=SCLEX_PYTHON })
   other.string = 'def example():\n# comment'
   render(scene)
   render(other_scene)
   expectToken(bmp, 'int', KEYWORD, 0, 0)
   expectToken(other_bmp, 'def', KEYWORD, 0, 0)
   expectToken(other_bmp, '# comment', COMMENT, 0, 1)
   other.lexer = SCLEX_TIRI
   other.string = 'defer print(value) end'
   render(other_scene)
   render(scene)
   expectToken(bmp, 'int', KEYWORD, 0, 0)
   expectToken(other_bmp, 'defer', KEYWORD, 0, 0)
end

@RequiresLexers(html=true)
@Test function EmbeddedHtmlStylesFollowTheTheme()
   local theme <close> = obj.new('XML', {
      statement='<theme><palette background="#141e28" keyword="#14f0a0" string="#f0d278"/></theme>' })
   local scene <close>, sci, bmp = newEditor({ lexer=SCLEX_HTML, themeXML=theme })
   sci.string = '<script>const value = "text";</script>\n<?php function demo() {} ?>'
   render(scene)
   expectToken(bmp, 'const', '20,240,160', 8, 0)
   expectToken(bmp, '"text"', '240,210,120', 22, 0)
   expectToken(bmp, 'function', '20,240,160', 6, 1)
   assert(pixelsOf(bmp, '20,30,40', 60, 0, 200, 26) > 100,
      'Embedded script styles above STYLE_DEFAULT must use the document background')
   theme_utils.apply(sci, { background='#323c46' })
   render(scene)
   assert(pixelsOf(bmp, '20,30,40', 0, 0, WIDTH, HEIGHT) is 0,
      'A theme update must replace backgrounds in every embedded script style')
end

@RequiresLexers(tiri=true)
@Test function ThemeXMLIsCopiedAndCanBeShared()
   local scene <close>, sci, bmp = newEditor({ lexer=SCLEX_TIRI })
   local other_scene <close>, other, other_bmp = newEditor({ lexer=SCLEX_TIRI })
   sci.string = 'defer value'
   other.string = sci.string
   do
      local theme <close> = obj.new('XML', { statement='<theme><palette keyword="lime"/></theme>' })
      sci.themeXML = theme
      other.themeXML = theme
      theme.statement = '<theme><palette keyword="red"/></theme>'
      render(scene)
      render(other_scene)
      expectToken(bmp, 'defer', '0,255,0', 0, 0)
      expectToken(other_bmp, 'defer', '0,255,0', 0, 0)
      sci.themeXML = theme
   end
   render(scene)
   render(other_scene)
   expectToken(bmp, 'defer', '255,0,0', 0, 0)
   expectToken(other_bmp, 'defer', '0,255,0', 0, 0)
end

function expectRejectedTheme(Sci:obj, Theme:obj)
   local rejected = false
   try
      Sci.themeXML = Theme
   except ex
      rejected = true
   end
   assert(rejected, 'An invalid theme assignment must fail')
end

@RequiresLexers(tiri=true)
@Test function InvalidThemesLeaveColoursUnchanged()
   local scene <close>, sci, bmp = newEditor({ lexer=SCLEX_TIRI })
   sci.string = 'defer value'
   local theme <close> = obj.new('XML', { statement='<theme><palette keyword="lime"/></theme>' })
   sci.themeXML = theme
   for statement in values(array<str> {
      '<other><palette keyword="red"/></other>',
      '<theme keyword="red"/>',
      '<theme/>',
      '<theme><palette/><palette keyword="red"/></theme>',
      '<theme><palette keyword="red"/><child/></theme>',
      '<theme background="red"><palette/></theme>',
      '<theme><Palette keyword="red"/></theme>',
      '<theme><palette keyword="red"/>unexpected content</theme>',
      '<theme><palette background="red" unknown="blue"/></theme>',
      '<theme><palette background="red" keyword="invalid-colour"/></theme>',
      '<theme><palette background="red" keyword="blue; red"/></theme>',
      '<theme><palette background="red"><child/></palette></theme>',
      '<theme><palette background="red">unexpected content</palette></theme>',
      '<theme><palette background="red"/></theme><theme><palette keyword="blue"/></theme>'
   }) do
      local invalid <close> = obj.new('XML', { statement=statement })
      expectRejectedTheme(sci, invalid)
      render(scene)
      expectToken(bmp, 'defer', '0,255,0', 0, 0)
      assert(theme_utils.colour(sci, 'background') is '#ffffff',
         'A rejected theme must leave earlier attributes unapplied')
   end
   expectRejectedTheme(sci, nil)
   expectRejectedTheme(sci, scene)
   local uninitialised <close> = obj.new('XML')
   expectRejectedTheme(sci, uninitialised)

   -- A partial update retains colours that it does not specify.  Ignore XML declarations, comments and whitespace.
   theme.statement = '<?xml version="1.0"?>\n<!-- theme -->\n<theme>\n<!-- palette -->\n' ..
      '<palette background="#123456">\n<!-- colours -->\n</palette>\n</theme>'
   sci.themeXML = theme
   render(scene)
   expectToken(bmp, 'defer', '0,255,0', 0, 0)
   assert(pixelsOf(bmp, '18,52,86', 250, 0, 20, HEIGHT) > 0, 'A partial theme must update its supplied colour')

   theme.statement = '<theme><palette/></theme>'
   sci.themeXML = theme
   render(scene)
   expectToken(bmp, 'defer', '0,255,0', 0, 0)
   assert(theme_utils.rgb(sci, 'background').red is 18, 'An empty palette must retain the current colours')
end

@Test function ThemeAPIHidesIndividualColours()
   local scene <close>, sci, bmp = newEditor()
   for name in values(array<str> {
      'commentColour', 'keywordColour', 'stringColour', 'numberColour', 'operatorColour', 'preprocessorColour',
      'typeColour', 'errorColour', 'marginColour', 'marginBkgd', 'bkgdColour', 'textColour', 'cursorColour',
      'lineHighlight', 'selectFore', 'selectBkgd'
   }) do
      local readable = false
      try
         local value = sci[name]
         readable = true
      except ex
      end
      assert(not readable, f'{name} must not be publicly readable')
   end
end

-- Reading ThemeXML describes the full palette, so the result can be assigned to another editor without loss.

@RequiresLexers(tiri=true)
@Test function ThemeXMLReadback()
   local scene <close>, sci, bmp = newEditor({ lexer=SCLEX_TIRI })
   local expected = '<theme><palette comment="#808080" keyword="#b22222" string="#b00000" number="#0000ff" ' ..
      'operator="#000000" preprocessor="#228b22" type="#9400d3" error="#ff0000" margin="#808080" ' ..
      'marginBackground="#e0e0e0" text="#000000" background="#ffffff" cursor="#000000" ' ..
      'lineHighlight="#00000000" selectionForeground="#ffffff" selectionBackground="#0000b4" ' ..
      'whitespace="inherit" indentGuide="inherit" braceMatch="inherit" braceMismatch="inherit" ' ..
      'braceBackground="inherit" selectionInactiveBackground="inherit" selectionAdditionalBackground="inherit"' ..
      '/></theme>'
   local err, statement = sci.themeXML.mtSerialise(0)
   assert(err is ERR_Okay and statement is expected, f'The default palette must be readable, got {statement}')

   theme_utils.apply(sci, { keyword='lime', background='rgb(20 30 40)', selectionBackground='#3c465080',
      cursor='oklch(0.7 0.1 30)' })
   assert(theme_utils.colour(sci, 'keyword') is '#00ff00', 'Named colours must read back in hex')
   assert(theme_utils.colour(sci, 'background') is '#141e28', 'Colour functions must read back in hex')
   assert(theme_utils.colour(sci, 'selectionBackground') is '#3c465080', 'Translucent selections must retain alpha')
   assert(theme_utils.colour(sci, 'comment') is '#808080', 'Partial updates must retain other colours')
   local first = sci.themeXML
   local second = sci.themeXML
   assert(first.id is second.id, 'Each read must reuse the editor-owned XML object')

   -- Applying the readback to a second editor must reproduce the palette and its rendering.

   local other_scene <close>, other, other_bmp = newEditor({ lexer=SCLEX_TIRI })
   other.themeXML = sci.themeXML
   local _, copy = other.themeXML.mtSerialise(0)
   local _, source = sci.themeXML.mtSerialise(0)
   assert(copy is source, 'A readback must round-trip without loss')
   sci.string = 'defer value'
   other.string = sci.string
   render(scene)
   render(other_scene)
   expectToken(bmp, 'defer', '0,255,0', 0, 0)
   expectToken(other_bmp, 'defer', '0,255,0', 0, 0)

   -- Freeing the returned object is not supported, but the next read must recover.

   do
      local closed <close> = sci.themeXML
   end
   assert(theme_utils.colour(sci, 'keyword') is '#00ff00', 'A freed readback must be replaced on the next read')
end

-- Derived colours follow their source until they are assigned, and 'inherit' restores the link.  Line 2 of the
-- document has six columns of indentation, which shows whitespace dots and an indentation guide at column 3.

@RequiresLexers(cpp=true)
@Test function DerivedColoursFollowTheirSources()
   local scene <close>, sci, bmp = newEditor({ lexer=SCLEX_CPP, showWhitespace=true, indentWidth=3,
      indentationGuides=SCGUIDE_REAL })
   sci.string = '{\n   {\n      x;\n   }\n}'
   check sci.mtSelectRange(sci.textLength, sci.textLength)
   local indent = (Colour => pixelsOf(bmp, Colour, 4, 26, 42, 13))

   theme_utils.apply(sci, { margin='#ff00ff' })
   render(scene)
   assert(indent('255,0,255') > 0, 'Whitespace and guides must inherit the margin colour')

   theme_utils.apply(sci, { whitespace='#00ffff' })
   render(scene)
   assert(indent('0,255,255') > 0, 'An assigned whitespace colour must be drawn')
   assert(indent('255,0,255') > 0, 'The indentation guide must still inherit the margin colour')

   theme_utils.apply(sci, { indentGuide='#ffff00', margin='#808080' })
   render(scene)
   assert(indent('255,255,0') > 0, 'An assigned guide colour must be drawn')
   assert(indent('128,128,128') is 0, 'Assigned colours must not follow later changes to their source')

   theme_utils.apply(sci, { whitespace='inherit', indentGuide='inherit' })
   render(scene)
   assert(indent('128,128,128') > 0, 'Inherit must restore the link to the source colour')
   assert(indent('0,255,255') is 0 and indent('255,255,0') is 0, 'Inherit must replace the assigned colours')

   -- The caret before the opening brace highlights it in braceMatch over braceBackground.

   check sci.mtSelectRange(0, 0)
   theme_utils.apply(sci, { keyword='#14f0a0', marginBackground='#405060' })
   render(scene)
   assert(pixelsOf(bmp, '20,240,160', 4, 0, 7, 13) > 0, 'A matched brace must inherit the keyword colour')
   assert(pixelsOf(bmp, '64,80,96', 4, 0, 7, 13) > 0, 'The brace background must inherit the margin background')

   theme_utils.apply(sci, { braceMatch='#ff8000', braceBackground='#102030' })
   render(scene)
   assert(pixelsOf(bmp, '255,128,0', 4, 0, 7, 13) > 0, 'An assigned brace colour must be drawn')
   assert(pixelsOf(bmp, '16,32,48', 4, 0, 7, 13) > 0, 'An assigned brace background must be drawn')

   sci.string = 'x}'
   check sci.mtSelectRange(2, 2)
   theme_utils.apply(sci, { error='#c00000' })
   render(scene)
   assert(pixelsOf(bmp, '192,0,0', 11, 0, 7, 13) > 0, 'An unmatched brace must inherit the error colour')
end

@RequiresLexers(cpp=true, json=true)
@Test function CustomKeywordsSurviveLexerSwitches()
   local scene <close>, sci, bmp = newEditor({ lexer=SCLEX_CPP })
   sci.string = 'Widget value;'
   local revision = sci.documentRevision
   local undo = sci.canUndo
   check sci.mtSetKeywords(1, 'Widget')
   check sci.mtColourise(0, sci.textLength)
   render(scene)
   expectToken(bmp, 'Widget', TYPE, 0, 0)
   local buffer = array<byte, 256>
   check sci.mtGetKeywords(1, buffer)
   assert(buffer.getString(0, 6) is 'Widget', 'Keyword getter returns the override')
   sci.lexer = SCLEX_JSON
   sci.lexer = SCLEX_CPP
   check sci.mtColourise(0, sci.textLength)
   render(scene)
   expectToken(bmp, 'Widget', TYPE, 0, 0)
   assert(sci.documentRevision is revision and sci.canUndo is undo, 'Styling preserves revision and undo')
   assert(sci.mtSetKeywords(99, 'bad') is ERR_NoSupport, 'Unsupported sets must fail')
   assert(sci.mtSetKeywords(1, 'bad\0text') is ERR_Args, 'Embedded NUL must fail')
   check sci.mtSetKeywords(1, '')
   check sci.mtColourise(0, sci.textLength)
   render(scene)
   expectToken(bmp, 'Widget', TEXT, 0, 0)
end

@RequiresLexers(json=true, markdown=true, tiri=true)
@Test function LexerPropertiesAndNames()
   local scene <close>, sci, bmp = newEditor({ lexer=SCLEX_JSON })
   sci.string = '// comment\ntrue'
   check sci.mtSetLexerProperty('lexer.json.allow.comments', '1')
   check sci.mtColourise(0, sci.textLength)
   render(scene)
   expectToken(bmp, '// comment', COMMENT, 0, 0)
   assert(sci.mtSetLexerProperty('lexer.json.allow.comments', 'yes') is ERR_Args, 'Boolean validation')
   assert(sci.mtSetLexerProperty('missing.property', '1') is ERR_NoSupport, 'Unknown property validation')
   assert(sci.mtSetLexerProperty('fold', '1') is ERR_NoSupport, 'Folding is adapter-owned')
   local buffer = array<byte, 32>
   check sci.mtGetLexerProperty('lexer.json.allow.comments', buffer)
   assert(buffer.getString(0, 1) is '1', 'Property getter returns the override')
   sci.lexerName = 'markdown'
   assert(sci.lexer is SCLEX_MARKDOWN and sci.lexerName is 'markdown', 'Names report numeric profiles')
   sci.lexerName = 'json'
   render(scene)
   expectToken(bmp, '// comment', COMMENT, 0, 0)
   assert(sci.supportedLexers.find('markdown') != nil and sci.supportedLexers.find('json') != nil,
      'Enumeration includes new profiles')
   local rejected = false
   try
      sci.lexerName = 'missing'
   except ex
      rejected = true
   end
   assert(rejected, 'Unknown lexer names must fail')
   assert(sci.lexer is SCLEX_JSON, 'Failed selection preserves the current lexer')
   sci.lexerName = 'lua'
   assert(sci.lexer is SCLEX_TIRI and sci.lexerName is 'tiri', 'Aliases report their canonical profile')
end

@Test function DiagnosticThemeColoursAndExplicitColours()
   local scene <close>, sci, bmp = newEditor()
   sci.string = 'marked text'
   check sci.mtDefineIndicator(8, SCIND_PLAIN, -1)
   check sci.mtDefineIndicator(9, SCIND_PLAIN, 0x00ff00)
   check sci.mtFillIndicator(8, 0, 6, 1)
   check sci.mtFillIndicator(9, 7, 11, 2)
   render(scene)
   assert(pixelsOf(bmp, ERROR, 4, 0, 42, 16) > 0, 'Error underline renders')
   assert(pixelsOf(bmp, '0,255,0', 53, 0, 28, 16) > 0, 'Explicit underline renders')
   local theme <close> = obj.new('XML', { statement='<theme><palette error="blue"/></theme>' })
   sci.themeXML = theme
   render(scene)
   assert(pixelsOf(bmp, '0,0,255', 4, 0, 42, 16) > 0, 'Theme references update')
   assert(pixelsOf(bmp, '0,255,0', 53, 0, 28, 16) > 0, 'Explicit colours survive theme updates')
end

@RequiresLexers(cpp=true, json=true, markdown=true)
@Test function ConfigurationBuffersAndUnsupportedSettings()
   local scene <close>, sci, bmp = newEditor({ lexer=SCLEX_CPP })
   local buffer = array<byte, 4>
   buffer[0] = 77
   assert(sci.mtGetKeywords(0, buffer) is ERR_BufferOverflow, 'Keyword buffers include the terminator')
   assert(buffer[0] is 77, 'Insufficient buffers must remain unchanged')
   assert(sci.mtGetKeywords(-1, buffer) is ERR_NoSupport, 'Negative sets are unsupported')
   sci.lexer = SCLEX_JSON
   check sci.mtGetLexerProperty('lexer.json.allow.comments', buffer)
   assert(buffer[0] is 0, 'Unset property overrides return an empty string')
   check sci.mtSetLexerProperty('lexer.json.allow.comments', '1')
   sci.lexer = SCLEX_CPP
   assert(sci.mtGetLexerProperty('lexer.json.allow.comments', buffer) is ERR_NoSupport,
      'Properties must be advertised by the selected lexer')
   sci.lexer = SCLEX_JSON
   check sci.mtGetLexerProperty('lexer.json.allow.comments', buffer)
   assert(buffer[0] is 49 and buffer[1] is 0, 'The profile restores its own property override')
   sci.lexer = SCLEX_MARKDOWN
   assert(sci.mtSetKeywords(0, 'word') is ERR_NoSupport, 'Structural lexers can have no keyword sets')
   assert(sci.mtColourise(1, 0) is ERR_OutOfRange, 'Recolouring validates ranges')
   check sci.mtColourise(0, 0)
end

@RequiresLexers(json=true, markdown=true)
@Test function DetectsJSONAndMarkdownFiles()
   local scene <close>, sci, bmp = newEditor({ flags=SCIF_DETECT_LEXER })
   for sample in values(array<table> {
      { 'temp:scintilla_phase3.json', 'true', SCLEX_JSON, 'true', 0 },
      { 'temp:scintilla_phase3.md', '# Heading', SCLEX_MARKDOWN, 'Heading', 2 }
   }) do
      local path = sample[0]
      defer mSys.DeleteFile(path) end
      do
         local file <close> = obj.new('File', { path=path, flags=FL_NEW|FL_WRITE })
         check file.acWrite(sample[1])
      end
      sci.path = path
      render(scene)
      assert(sci.lexer is sample[2], 'File detection selects the new numeric profile')
      expectToken(bmp, sample[3], KEYWORD, sample[4], 0)
   end
end

lexer_utils.configureTests()
