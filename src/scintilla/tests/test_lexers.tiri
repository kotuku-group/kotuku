-- Lexer changes and theme updates must preserve the editable document and its undo history.
   include 'scintilla', 'vector', 'xml'

function newEditor():<obj, obj>
   local scene = obj.new('VectorScene', { pageWidth=400, pageHeight=200 })
   local viewport = scene.new('VectorViewport', { width='100%', height='100%' })
   return scene, viewport.new('Scintilla', { lexer=SCLEX_TIRI, flags=SCIF_EDIT })
end

@Test function SwitchingAndThemePreserveUndoHistory()
   local scene <close>, sci = newEditor()
   sci.string = 'function example()\n   return 1\nend\n'
   local original = sci.string
   check sci.mtInsertText('-- before\n', 0)
   local edited = sci.string
   local theme <close> = obj.new('XML', { statement='<theme><palette keyword="#14f0a0"/></theme>' })
   for _ in {0 to 10} do
      for lexer in values(array<int> { SCLEX_CPP, 0, SCLEX_XML, SCLEX_ASP, SCLEX_HTML, SCLEX_PHPSCRIPT, SCLEX_TIRI }) do
         sci.lexer = lexer
         sci.themeXML = theme
         assert(sci.string is edited, 'Switching and theme changes preserve the complete document')
      end
   end
   check sci.acUndo(1)
   assert(sci.string is original, 'One undo must still revert the original edit after switching and theme updates')
end

@Test function UnsupportedLexerLeavesWorkingProfile()
   local scene <close>, sci = newEditor()
   sci.string = 'defer print(value) end'
   local rejected = false
   try
      sci.lexer = 99999
   except e
      rejected = true
   end
   assert(rejected, 'An unknown public lexer must report an error')
   assert(sci.lexer is SCLEX_TIRI, 'A failed assignment must retain the previous public lexer')
   assert(sci.string is 'defer print(value) end', 'A failed assignment must preserve text')
   sci.lexer = SCLEX_CPP
   assert(sci.lexer is SCLEX_CPP, 'A successful assignment must still work after failure')
end
