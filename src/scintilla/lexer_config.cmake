# Each row maps a public profile to its Lexilla factory, catalogue module and source file.
# NIL is required for plain text; other profiles can be disabled with SCINTILLA_LEXER_<ID>=OFF.
set (SCINTILLA_LEXER_PROFILES
   "NIL|null|lmNull|LexNull"
   "PYTHON|python|lmPython|LexPython"
   "CPP|cpp|lmCPP|LexCPP"
   "HTML|hypertext|lmHTML|LexHTML"
   "XML|xml|lmXML|LexHTML"
   "PERL|perl|lmPerl|LexPerl"
   "SQL|sql|lmSQL|LexSQL"
   "VB|vb|lmVB|LexVB"
   "PROPERTIES|props|lmProps|LexProps"
   "ERRORLIST|errorlist|lmErrorList|LexErrorList"
   "MAKEFILE|makefile|lmMake|LexMake"
   "BATCH|batch|lmBatch|LexBatch"
   "TIRI|lua|lmLua|LexLua"
   "DIFF|diff|lmDiff|LexDiff"
   "PASCAL|pascal|lmPascal|LexPascal"
   "RUBY|ruby|lmRuby|LexRuby"
   "VBSCRIPT|vbscript|lmVBScript|LexVB"
   "ASP|hypertext|lmHTML|LexHTML"
   "ASSEMBLER|asm|lmAsm|LexAsm"
   "CSS|css|lmCss|LexCSS"
   "BASH|bash|lmBash|LexBash"
   "PHPSCRIPT|phpscript|lmPHPSCRIPT|LexHTML"
   "REBOL|rebol|lmREBOL|LexRebol"
   "MARKDOWN|markdown|lmMarkdown|LexMarkdown"
   "JSON|json|lmJSON|LexJSON")

set (LEXILLA_LEXERS "")
set (lexilla_modules "")
set (profile_entries "")
foreach (profile IN LISTS SCINTILLA_LEXER_PROFILES)
   string (REPLACE "|" ";" fields "${profile}")
   list (GET fields 0 id)
   list (GET fields 1 factory)
   list (GET fields 2 module)
   list (GET fields 3 source)
   if (NOT id STREQUAL "NIL")
      option (SCINTILLA_LEXER_${id} "Include the Scintilla ${id} lexer profile" ON)
   endif ()
   if (id STREQUAL "NIL" OR SCINTILLA_LEXER_${id})
      string (APPEND profile_entries "   { SCLEX::${id}, \"${factory}\" },\n")
      list (APPEND lexilla_modules "${module}")
      list (APPEND LEXILLA_LEXERS "lexilla/lexers/${source}.cxx")
   endif ()
endforeach ()
list (REMOVE_DUPLICATES lexilla_modules)
list (REMOVE_DUPLICATES LEXILLA_LEXERS)
file (CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/configured_lexer_profiles.h" CONTENT "${profile_entries}" @ONLY)

set (declarations "")
set (catalogue_entries "")
foreach (module IN LISTS lexilla_modules)
   string (APPEND declarations "extern const LexerModule ${module};\n")
   string (APPEND catalogue_entries "      &${module},\n")
endforeach ()

# Preserve the upstream implementation and replace only its two generated catalogue lists in a build-tree copy.
set (lexilla_catalogue "${CMAKE_CURRENT_SOURCE_DIR}/lexilla/src/Lexilla.cxx")
set_property (DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lexilla_catalogue}")
file (READ "${lexilla_catalogue}" catalogue_source)
foreach (replacement IN ITEMS declarations catalogue_entries)
   string (FIND "${catalogue_source}" "//++Autogenerated" start)
   string (FIND "${catalogue_source}" "//--Autogenerated" finish)
   if (start LESS 0 OR finish LESS start)
      message (FATAL_ERROR "Lexilla catalogue markers missing or out of order in ${lexilla_catalogue}")
   endif ()
   string (SUBSTRING "${catalogue_source}" 0 ${start} before)
   string (SUBSTRING "${catalogue_source}" ${finish} -1 after)
   string (FIND "${after}" "\n" end_line)
   if (end_line LESS 0)
      message (FATAL_ERROR "Invalid Lexilla catalogue end marker in ${lexilla_catalogue}")
   endif ()
   math (EXPR end_line "${end_line} + 1")
   string (SUBSTRING "${after}" ${end_line} -1 after)
   set (catalogue_source "${before}${${replacement}}${after}")
endforeach ()
file (CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/Lexilla.cxx" CONTENT "${catalogue_source}" @ONLY)
