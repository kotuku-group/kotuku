-- $TIRI
-- Flute tests for SVG generated images.
--
-- This technique uses pre-computed checksums from SVG images, captured from a 'good' state.  If a checksum doesn't
-- match, the test will fail and the resulting image will be saved to "temp:svg_test_results/".  Check the
-- corresponding image file, if it is acceptable then update the old checksum from the test output in order to pass
-- future tests.

   include 'vector', 'display'
   module display as mGfx

local glSVGFolder

@BeforeAll function setup(State:table)
   glSVGFolder = State.folder
end

glWhite = struct<RGB8> { red = 255, green = 255, blue = 255, alpha = 255 }

----------------------------------------------------------------------------------------------------------------------

function renderSVGToBitmap(Path:str, Stable:bool):obj
   -- Some tests require Stable to be true when the hashes differ due to compiler/platform differences
   scene = obj.new('VectorScene', {
      name='TestSceneRender', pageWidth=1024, pageHeight=768, flags=Stable ? VPF_STABLE_RENDER : nil, compliance=VSC_SVG2
   })
   -- The SVG reuses this viewport, so it must opt into the sRGB compositing that browsers use.
   vp = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%', colourSpace=VCS_SRGB })
   svg = obj.new('svg', { target=scene, path=Path })
   bmp = obj.new('bitmap', { width=scene.pageWidth, height=scene.pageHeight, bitsPerPixel=32, bkgd=glWhite })
   bmp.acClear()
   scene.bitmap = bmp
   scene.acDraw()
   return bmp
end

----------------------------------------------------------------------------------------------------------------------

function saveBitmap(Bitmap:obj, Path:str)
   folder, filename = io.splitPath(Path)
   split = string.split(filename, '.')
   if split?? then
      filename = split[0] .. '.png'

      pic = obj.new('image', { width = Bitmap.width, height = Bitmap.height, bitsPerPixel = Bitmap.bitsPerPixel, flags='NEW' })
      Bitmap.acCopyData(pic.bitmap)
      file = obj.new('file', { flags=FL_NEW|FL_WRITE, path='temp:svg_test_results/' .. filename })
      pic.acSaveImage(file)
   end
end

----------------------------------------------------------------------------------------------------------------------

function hashTestSVG(Path:str, ExpectedHash:num, Stable:bool)
   if ExpectedHash is -1 then return end
   bmp = renderSVGToBitmap(glSVGFolder .. Path, Stable)
   hash = mSys.GenCRC32(0, bmp.data, bmp.size)
   if ExpectedHash != hash then
      saveBitmap(bmp, Path, Stable)
      if ExpectedHash then
         raise 'Computed hash for "' .. Path .. '" is ' .. string.format('0x%.8x', hash) ..
            ', expected ' .. string.format('0x%.8x', ExpectedHash)
      else
         raise 'Hash for "' .. Path .. '" is '  .. string.format('0x%.8x', hash)
      end
   end
end

-----------------------------------------------------------------------------------------------------------------------

-- Generate a 64-bit perceptual hash from a bitmap.  The image is reduced to 32x32 luminance samples before applying
-- an 8x8 discrete cosine transform.  Bitmap.data is an external byte-array view over the pixel buffer, so this avoids
-- the overhead of calling a pixel reader for every source pixel.

function pHash(Bitmap:obj):array<byte>
   sample_size <const> = 32
   dct_size <const> = 8
   pixels = Bitmap.data
   format = Bitmap.colourFormat
   bytes_per_pixel = Bitmap.bytesPerPixel
   red_offset = format.redPos / 8
   green_offset = format.greenPos / 8
   blue_offset = format.bluePos / 8
   samples = array<double>

   for sample_y in {0 to sample_size} do
      local y_start = math.floor((sample_y * Bitmap.height) / sample_size)
      local y_end = math.floor(((sample_y + 1) * Bitmap.height) / sample_size)

      for sample_x in {0 to sample_size} do
         local x_start = math.floor((sample_x * Bitmap.width) / sample_size)
         local x_end = math.floor(((sample_x + 1) * Bitmap.width) / sample_size)
         local luminance = 0

         for y in {y_start to y_end} do
            local pixel:num = (y * Bitmap.lineWidth) + (x_start * bytes_per_pixel)
            for x in {x_start to x_end} do
               luminance += (77 * pixels[pixel + red_offset]) + (150 * pixels[pixel + green_offset]) +
                  (29 * pixels[pixel + blue_offset])
               pixel += bytes_per_pixel
            end
         end

         samples.push(luminance / (256 * (x_end - x_start) * (y_end - y_start)))
      end
   end

   local cosines = array<double>
   for frequency in {0 to dct_size} do
      for position in {0 to sample_size} do
         cosines.push(math.cos(((2 * position + 1) * frequency * math.pi) / (2 * sample_size)))
      end
   end

   local row_dct = array<double>
   for y in {0 to sample_size} do
      for frequency_x in {0 to dct_size} do
         local coefficient = 0
         for x in {0 to sample_size} do
            coefficient += samples[(y * sample_size) + x] * cosines[(frequency_x * sample_size) + x]
         end
         row_dct.push(coefficient)
      end
   end

   local coefficients = array<double>
   for frequency_y in {0 to dct_size} do
      for frequency_x in {0 to dct_size} do
         local coefficient = 0
         for y in {0 to sample_size} do
            coefficient += row_dct[(y * dct_size) + frequency_x] * cosines[(frequency_y * sample_size) + y]
         end
         coefficients.push(coefficient)
      end
   end

   local ac_coefficients = array<double>
   for i in {1 to #coefficients} do ac_coefficients.push(coefficients[i]) end
   ac_coefficients.sort()
   local median = ac_coefficients[math.floor(#ac_coefficients / 2)]
   local fingerprint = array<byte> { 0, 0, 0, 0, 0, 0, 0, 0 }

   for i in {1 to #coefficients} do
      if coefficients[i] > median then
         local bit_index = i - 1
         local byte_index = math.floor(bit_index / 8)
         fingerprint[byte_index] = bit.bor(fingerprint[byte_index], bit.lshift(1, bit_index % 8))
      end
   end

   return fingerprint
end

-----------------------------------------------------------------------------------------------------------------------

function pHashString(Hash:array<byte>):str
   local result = ''
   for i in {0 to #Hash} do result ..= string.format('%d,', Hash[i]) end
   return result
end

-----------------------------------------------------------------------------------------------------------------------

function pHashDistance(Left:array<byte>, Right:array<byte>):num
   assert(#Left is #Right, 'Perceptual hashes must have the same length')
   local set_bits <const> = array<byte> { 0, 1, 1, 2, 1, 2, 2, 3, 1, 2, 2, 3, 2, 3, 3, 4 }
   local distance = 0

   for i in {0 to #Left} do
      local difference = bit.bxor(Left[i], Right[i])
      distance += set_bits[bit.band(difference, 0x0f)] + set_bits[bit.rshift(difference, 4)]
   end

   return distance
end

-----------------------------------------------------------------------------------------------------------------------

function pHashTestSVG(Path:str, ExpectedHash:array<byte>, MaxDistance:num, Stable:bool)
   bmp = renderSVGToBitmap(glSVGFolder .. Path, Stable)
   hash = pHash(bmp)
   distance = pHashDistance(hash, ExpectedHash)

   if distance > MaxDistance then
      saveBitmap(bmp, Path)
      raise 'Computed pHash for "' .. Path .. '" is ' .. pHashString(hash) .. ', expected ' ..
         pHashString(ExpectedHash) .. ' (Hamming distance ' .. distance .. ', maximum ' .. MaxDistance .. ')'
   end
end

-----------------------------------------------------------------------------------------------------------------------

