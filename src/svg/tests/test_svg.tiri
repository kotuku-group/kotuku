-----------------------------------------------------------------------------------------------------------------------
-- Compositing policy.  SVG content composites in sRGB as browsers do, so 50% black over white reads 127-128.
-- color-interpolation="linearRGB" opts a subtree into gamma-correct blending, which reads 185-187.

COMPOSITE_SIZE <const> = 40

function renderStatementPixel(Statement:str):table
   local scene <close> = obj.new('VectorScene', { pageWidth=COMPOSITE_SIZE, pageHeight=COMPOSITE_SIZE })
   local svg <close> = obj.new('svg', { target=scene, statement=Statement })
   local bmp <close> = obj.new('bitmap', {
      width=COMPOSITE_SIZE, height=COMPOSITE_SIZE, bitsPerPixel=32, bkgd='255,255,255,255'
   })
   bmp.acClear()
   scene.bitmap = bmp
   check scene.acDraw()
   return struct.toTable(mGfx.ReadRGBPixel(bmp, COMPOSITE_SIZE / 2, COMPOSITE_SIZE / 2))
end

function compositeDocument(Content:str, RootAttribs:str):str
   return '<svg width="40" height="40" ' .. (RootAttribs ?? '') .. ' xmlns="http://www.w3.org/2000/svg">' ..
      Content .. '</svg>'
end

function assertRed(Pixel:table, Low:num, High:num, Message:str)
   assert(Pixel.red >= Low and Pixel.red <= High, f'{Message}: expected red {Low}-{High}, got {Pixel.red}')
end

@Test function LinkVisibilityOverridesHiddenAncestors()
   for attribs in values(array<str> { 'visibility="visible"', 'style="visibility:visible"' }) do
      for child_attribs in values(array<str> { '', 'visibility="inherit"' }) do
         local px = renderStatementPixel(compositeDocument(
            '<g visibility="hidden"><a href="#test" ' .. attribs .. '>' ..
            '<rect width="40" height="40" ' .. child_attribs .. '/></a></g>'))
         assertRed(px, 0, 0, 'Visible links must restore visibility for their descendants')
      end
   end
end

@Test function LinkVisibilityDoesNotAffectSiblings()
   for attribs in values(array<str> { 'visibility="hidden"', 'style="visibility:hidden"',
      'visibility="collapse"' }) do
      local px = renderStatementPixel(compositeDocument(
         '<a href="#test" ' .. attribs .. '><rect width="40" height="40"/></a>'))
      assertRed(px, 255, 255, 'Hidden links must suppress descendants with omitted visibility')

      px = renderStatementPixel(compositeDocument(
         '<a href="#test" ' .. attribs .. '><rect width="40" height="40"/></a>' ..
         '<rect width="40" height="40" visibility="inherit"/>'))
      assertRed(px, 0, 0, 'Link visibility must not leak into its following sibling')
   end
end

@Test function FillOpacityCompositesInSRGB()
   local px = renderStatementPixel(compositeDocument('<rect width="40" height="40" fill-opacity="0.5"/>'))
   assertRed(px, 127, 128, 'fill-opacity 0.5 black over white')
end

@Test function OpacityCompositesInSRGB()
   local px = renderStatementPixel(compositeDocument('<rect width="40" height="40" opacity="0.5"/>'))
   assertRed(px, 127, 128, 'opacity 0.5 black over white')
end

@Test function GroupOpacityIsNotInherited()
   -- opacity applies to the group as a whole and must not be copied to its children.
   local px = renderStatementPixel(compositeDocument('<g opacity="0.5"><rect width="40" height="40"/></g>'))
   assertRed(px, 127, 128, 'Group opacity 0.5 black over white')

   -- Nested opacity values multiply: 0.5 * 0.5 leaves 25% black, which reads 191.
   px = renderStatementPixel(compositeDocument(
      '<g opacity="0.5"><rect width="40" height="40" opacity="0.5"/></g>'))
   assertRed(px, 190, 192, 'Group opacity 0.5 over a child with opacity 0.5')

   -- fill-opacity is an inherited property and continues to reach the children.
   px = renderStatementPixel(compositeDocument('<g fill-opacity="0.5"><rect width="40" height="40"/></g>'))
   assertRed(px, 127, 128, 'Inherited fill-opacity 0.5 black over white')
end

@Test function SVGViewportOpacityIsNotInherited()
   local px = renderStatementPixel(compositeDocument('<rect width="40" height="40"/>', 'opacity="0.5"'))
   assertRed(px, 127, 128, 'Root SVG opacity 0.5 black over white')

   px = renderStatementPixel(compositeDocument(
      '<svg width="40" height="40" opacity="0.5"><rect width="40" height="40"/></svg>'))
   assertRed(px, 127, 128, 'Nested SVG opacity 0.5 black over white')

   px = renderStatementPixel(compositeDocument(
      '<svg width="40" height="40" opacity="0.5"><rect width="40" height="40"/></svg>', 'opacity="0.5"'))
   assertRed(px, 190, 192, 'Root and nested SVG opacity values multiply')
end

@Test function FilterOutputCompositesInSRGB()
   local px = renderStatementPixel(compositeDocument([[
<filter id="f" x="0" y="0" width="1" height="1"><feFlood flood-color="black" flood-opacity="0.5"/></filter>
<rect width="40" height="40" fill="red" filter="url(#f)"/>]]))
   assertRed(px, 127, 128, 'Filter output of 50% black over white')
end

@Test function LinearRGBInterpolationUsesGammaBlend()
   local px = renderStatementPixel(compositeDocument(
      '<g color-interpolation="linearRGB"><rect width="40" height="40" fill-opacity="0.5"/></g>'))
   assertRed(px, 185, 187, 'color-interpolation="linearRGB" on a group')

   px = renderStatementPixel(compositeDocument('<rect width="40" height="40" fill-opacity="0.5"/>',
      'color-interpolation="linearRGB"'))
   assertRed(px, 185, 187, 'color-interpolation="linearRGB" on the root')

   px = renderStatementPixel(compositeDocument(
      '<g color-interpolation="sRGB"><rect width="40" height="40" fill-opacity="0.5"/></g>',
      'color-interpolation="linearRGB"'))
   assertRed(px, 127, 128, 'color-interpolation="sRGB" inside a linearRGB root')
end

@Test function CustomTargetCompositesInSRGB()
   -- The SVG's own viewport carries the policy, so the host viewport is left unmodified.
   local scene <close> = obj.new('VectorScene', { pageWidth=COMPOSITE_SIZE, pageHeight=COMPOSITE_SIZE })
   local root = scene.new('VectorViewport', { width='100%', height='100%' })
   local host = root.new('VectorViewport', { width='100%', height='100%' })
   local svg <close> = obj.new('svg', {
      target=host, statement=compositeDocument('<rect width="40" height="40" fill-opacity="0.5"/>')
   })
   assert(svg.viewport.id is host.child.id, 'SVG.Viewport should reference the document root beneath the target')
   local bmp <close> = obj.new('bitmap', {
      width=COMPOSITE_SIZE, height=COMPOSITE_SIZE, bitsPerPixel=32, bkgd='255,255,255,255'
   })
   bmp.acClear()
   scene.bitmap = bmp
   check scene.acDraw()
   local px = struct.toTable(mGfx.ReadRGBPixel(bmp, COMPOSITE_SIZE / 2, COMPOSITE_SIZE / 2))
   assertRed(px, 127, 128, 'SVG parsed into a custom target')
   assert(host.colourSpace is VCS_INHERIT, f'The host viewport colour space should not change, got {host.colourSpace}')
end

@Test function ExistingSceneViewportKeepsColourSpace()
   -- Parsing into a scene that already has a viewport reuses it, so the host's colour space must be preserved.
   local scene <close> = obj.new('VectorScene', { pageWidth=COMPOSITE_SIZE, pageHeight=COMPOSITE_SIZE })
   local root = scene.new('VectorViewport', { width='100%', height='100%', colourSpace=VCS_LINEAR_RGB })
   local svg <close> = obj.new('svg', {
      target=scene, statement=compositeDocument('<rect width="40" height="40" fill-opacity="0.5"/>')
   })
   assert(svg.viewport.id is root.id, 'The SVG should reuse the existing scene viewport')
   assert(root.colourSpace is VCS_LINEAR_RGB, f'The host viewport colour space should not change, got {root.colourSpace}')
   local bmp <close> = obj.new('bitmap', {
      width=COMPOSITE_SIZE, height=COMPOSITE_SIZE, bitsPerPixel=32, bkgd='255,255,255,255'
   })
   bmp.acClear()
   scene.bitmap = bmp
   check scene.acDraw()
   local px = struct.toTable(mGfx.ReadRGBPixel(bmp, COMPOSITE_SIZE / 2, COMPOSITE_SIZE / 2))
   assertRed(px, 185, 187, 'SVG parsed into a linearRGB host viewport')
end
