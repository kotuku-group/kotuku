@Test global function ReplacingAnimationDocumentRestartsTimer()
   local svg <close> = obj.new('svg', { statement=ANIMATED_SVG })
   svg.scene.bitmap = obj.new('bitmap', { width=200, height=200, bitsPerPixel=32, bkgd=glWhite })
   local frames = 0
   svg.frameCallback = function(SVG) frames += 1 end
   check svg.acActivate()
   processing.sleep(0.08)
   assert(frames > 0, 'The initial animation must run')

   check svg.acDataFeed(nil, DATA_XML, '<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"/>')
   processing.sleep(0.06) -- The now-empty timer terminates itself.
   local stopped_frames = frames
   processing.sleep(0.04)
   assert(frames is stopped_frames, 'Replacing the document must discard its old animations')

   check svg.acDataFeed(nil, DATA_XML, [[<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200">
      <rect id="replacement" width="10" height="10">
         <animate attributeName="x" from="0" to="100" dur="1s"/>
      </rect>
   </svg>]])
   check svg.acActivate()
   for attempt in {0 to 100} do
      if frames >= stopped_frames + 3 then break end
      processing.sleep(0.02)
   end
   check svg.acDeactivate()
   assert(frames >= stopped_frames + 3, 'Activation must create a new timer after the old one terminates')
   assert(obj.find('replacement').x > 0, 'The replacement document must animate')
end

@Test global function ParsingSymbolPreservesAnimationBases()
   local svg <close> = obj.new('svg', { statement=[[
      <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200">
         <defs><symbol id="animated_symbol">
            <rect width="1" height="1"><animate attributeName="x" from="0" to="10" dur="0.1s"/></rect>
         </symbol></defs>
         <rect id="symbol_base" x="7" width="1" height="1">
            <animate attributeName="x" from="100" to="200" dur="0.1s"/>
         </rect>
      </svg>
   ]] })
   svg.scene.bitmap = obj.new('bitmap', { width=200, height=200, bitsPerPixel=32, bkgd=glWhite })
   local frames = 0
   svg.frameCallback = function(SVG) frames += 1 end
   check svg.acActivate()
   for attempt in {0 to 100} do
      if frames > 0 then break end
      processing.sleep(0.01)
   end
   assert(obj.find('symbol_base').x >= 100, 'Expected the original animation to be active')
   check svg.mtParseSymbol('animated_symbol', svg.viewport)
   processing.sleep(0.15)
   check svg.acDeactivate()
   assert(obj.find('symbol_base').x is 7, 'Adding an animated symbol must retain the original attribute base')
end

@Test global function DeletedAnimationTargetsAreSkipped()
   local svg <close> = obj.new('svg', { statement=[[
      <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200">
         <rect id="deleted_transform" width="1" height="1">
            <animateTransform attributeName="transform" type="translate" from="0 0" to="20 0" dur="1s"/>
         </rect>
         <rect id="deleted_motion" width="1" height="1">
            <animateMotion from="0 0" to="20 0" dur="1s"/>
         </rect>
      </svg>
   ]] })
   svg.scene.bitmap = obj.new('bitmap', { width=200, height=200, bitsPerPixel=32, bkgd=glWhite })
   local frames = 0
   svg.frameCallback = function(SVG) frames += 1 end
   check svg.acActivate()
   for attempt in {0 to 100} do
      if frames >= 3 then break end
      processing.sleep(0.02)
   end
   assert(frames >= 3, 'Expected the animation matrices to be created')
   obj.find('deleted_transform').free()
   obj.find('deleted_motion').free()
   local previous_frames = frames
   for attempt in {0 to 100} do
      if frames >= previous_frames + 3 then break end
      processing.sleep(0.02)
   end
   check svg.acDeactivate()
   assert(frames >= previous_frames + 3, 'Frame rendering must continue after the animation targets are deleted')
end

