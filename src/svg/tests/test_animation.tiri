-- $TIRI
-- Flute tests for SVG animation playback control.

   include 'vector', 'display'

glWhite = struct<RGB8> { red = 255, green = 255, blue = 255, alpha = 255 }

function seekDocument(Body:str!):obj
   local svg = obj.new('svg', { statement=
      '<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200">' .. Body .. '</svg>' })
   svg.scene.bitmap = obj.new('bitmap', { width=200, height=200, bitsPerPixel=32, bkgd=glWhite })
   return svg
end

function nearValue(Actual:num, Expected:num, Description:str)
   assert(math.abs(Actual - Expected) < 0.00001, f'{Description}: expected {Expected}, got {Actual}')
end

@Test global function ToOnlyAnimationsComposeUnderlyingEffects()
   local svg <close> = seekDocument([[
      <rect id="composed_to" width="1" height="1" opacity="0.1" fill="green">
         <animate attributeName="x" from="20" to="40" dur="10s"/>
         <animate attributeName="x" to="100" begin="2s" dur="4s"/>
         <animate attributeName="opacity" from="0.2" to="0.6" dur="10s"/>
         <animate attributeName="opacity" to="1" begin="2s" dur="4s"/>
         <animate attributeName="fill" from="red" to="red" dur="10s"/>
         <animate attributeName="fill" to="blue" begin="2s" dur="4s"/>
      </rect>
      <rect id="reference_to_colour" width="1" height="1" fill="red">
         <animate attributeName="fill" from="red" to="blue" begin="2s" dur="4s"/>
      </rect>
      <rect id="chained_to" width="1" height="1">
         <animate attributeName="x" from="20" to="40" dur="10s"/>
         <animate attributeName="x" to="100" begin="2s" dur="4s"/>
         <animate attributeName="x" to="160" begin="3s" dur="4s"/>
      </rect>
   ]])
   for time in values(array<double> { 3, 5, 1, 6, 4, 12, 0, 3 }) do
      check svg.acSeek(time, SEEK_START)
      local x = time < 10 ? 20 + time * 2 : 0
      local opacity = time < 10 ? 0.2 + time * 0.04 : 0.1
      if time >= 2 and time < 6 then
         local progress = (time - 2) / 4
         x += (100 - x) * progress
         opacity += (1 - opacity) * progress
         local colour = obj.find('composed_to').fillColour
         local reference = obj.find('reference_to_colour').fillColour
         for channel in values(array<str> { 'red', 'green', 'blue', 'alpha' }) do
            nearValue(colour[channel], reference[channel], f'To-only colour {channel} at {time}')
         end
      end
      nearValue(obj.find('composed_to').x, x, f'To-only dimension at {time}')
      nearValue(obj.find('composed_to').opacity, opacity, f'To-only number at {time}')
      if time >= 3 and time < 7 then x += (160 - x) * (time - 3) / 4 end
      nearValue(obj.find('chained_to').x, x, f'Chained to-only effects at {time}')
   end
end

@Test global function FrozenToOnlyAnimationsSampleUnderlyingEndpoints()
   local svg <close> = seekDocument([[
      <rect id="frozen_to" width="1" height="1">
         <animate attributeName="x" from="0" to="100" dur="10s"/>
         <animate attributeName="x" to="100" begin="1s" dur="4s" max="2s" fill="freeze"/>
      </rect>
      <rect id="frozen_to_chain" width="1" height="1">
         <animate attributeName="x" from="0" to="100" dur="10s"/>
         <animate attributeName="x" to="100" begin="1s" dur="4s" max="2s" fill="freeze"/>
         <animate attributeName="x" to="200" begin="3s" dur="4s" max="1s" fill="freeze"/>
      </rect>
   ]])
   for time in values(array<double> { 8, 2, 3, 4, 1, 12, 3.5, 0, 8 }) do
      check svg.acSeek(time, SEEK_START)
      local sample = math.min(time, 3)
      local expected = sample * 10
      if sample >= 1 then expected += (100 - expected) * (sample - 1) / 4 end
      nearValue(obj.find('frozen_to').x, expected, f'Frozen to-only endpoint at {time}')
      if time >= 3 then expected += (200 - expected) * math.min(time - 3, 1) / 4 end
      nearValue(obj.find('frozen_to_chain').x, expected, f'Frozen to-only chain at {time}')
   end
end

@Test global function MinimumDurationDoesNotAddRepeats()
   local svg <close> = seekDocument([[
      <rect id="min_freeze" x="7" width="1" height="1">
         <animate id="min_anchor" attributeName="x" from="0" to="10" dur="2s" min="4s" fill="freeze"/>
      </rect>
      <rect id="min_remove" x="7" width="1" height="1">
         <animate attributeName="x" from="0" to="10" dur="2s" min="4s"/>
      </rect>
      <rect id="min_repeat" x="7" width="1" height="1">
         <animate attributeName="x" from="0" to="10" dur="2s" repeatCount="2.5" min="8s"
            accumulate="sum" fill="freeze"/>
      </rect>
      <rect id="min_repeat_remove" x="7" width="1" height="1">
         <animate attributeName="x" from="0" to="10" dur="2s" repeatDur="5s" min="8s"/>
      </rect>
      <rect id="min_restart" x="7" width="1" height="1">
         <animate attributeName="x" from="0" to="10" begin="0s; 3s; 5s" dur="2s" min="4s"
            restart="whenNotActive" fill="freeze"/>
      </rect>
      <rect id="min_dependent" x="7" width="1" height="1">
         <animate attributeName="x" from="20" to="20" begin="min_anchor.end" dur="2s"/>
      </rect>
      <rect id="min_transform" width="1" height="1">
         <animateTransform attributeName="transform" type="translate" from="0 0" to="10 0"
            dur="2s" min="4s" fill="freeze"/>
      </rect>
      <rect id="min_motion" width="1" height="1">
         <animateMotion from="0 0" to="10 0" dur="2s" min="4s"/>
      </rect>
   ]])
   for time in values(array<double> { 3, 1, 2, 5.5, 4, 8, 0, 4.5, 7, 3 }) do
      check svg.acSeek(time, SEEK_START)
      local frozen = math.min(time, 2) * 5
      nearValue(obj.find('min_freeze').x, frozen, f'Minimum duration freeze at {time}')
      nearValue(obj.find('min_remove').x, time < 2 ? time * 5 : 7, f'Minimum duration remove at {time}')
      nearValue(obj.find('min_repeat').x, math.min(time, 5) * 5, f'Minimum duration accumulation at {time}')
      local repeated = time < 5 ? (time % 2) * 5 : 7
      nearValue(obj.find('min_repeat_remove').x, repeated, f'Minimum repeat duration removal at {time}')
      local restarted = time < 5 ? frozen : math.min(time - 5, 2) * 5
      nearValue(obj.find('min_restart').x, restarted, f'Minimum duration restart filtering at {time}')
      nearValue(obj.find('min_dependent').x, time >= 4 and time < 6 ? 20 : 7,
         f'Minimum duration syncbase end at {time}')
      local _, transform_x = check obj.find('min_transform').mtGetBoundary(0)
      local _, motion_x = check obj.find('min_motion').mtGetBoundary(0)
      nearValue(transform_x, frozen, f'Minimum duration transform at {time}')
      nearValue(motion_x, time < 2 ? time * 5 : 0, f'Minimum duration motion removal at {time}')
   end
end

----------------------------------------------------------------------------------------------------------------------
-- Seek before activation and in arbitrary order must evaluate the same timeline on each visit.

@Test global function SeekEvaluatesIntervalsAndDependencies()
   local svg <close> = seekDocument([[
      <rect id="seek_remove" x="7" width="1" height="1">
         <animate id="seek_anchor" attributeName="x" from="10" to="30" begin="1s" dur="2s" repeatCount="2"/>
      </rect>
      <rect id="seek_freeze" x="7" width="1" height="1">
         <animate attributeName="x" from="10" to="30" begin="1s" dur="2s" repeatCount="2" fill="freeze"/>
      </rect>
      <rect id="seek_loop" width="1" height="1">
         <animate attributeName="x" from="0" to="10" dur="0.1s" repeatCount="100" accumulate="sum" fill="freeze"/>
      </rect>
      <rect id="seek_series" x="7" width="1" height="1">
         <animate attributeName="x" from="10" to="30" begin="8s; 2s; 5s" dur="1s"/>
      </rect>
      <rect id="seek_dependent" x="7" width="1" height="1">
         <animate id="seek_middle" attributeName="x" from="20" to="40" begin="seek_anchor.end+1s"
            dur="2s" fill="freeze"/>
      </rect>
      <rect id="seek_chain" x="7" width="1" height="1">
         <animate attributeName="x" from="50" to="80" begin="seek_middle.end-0.5s" dur="1.5s" fill="freeze"/>
      </rect>
      <rect id="seek_to" x="7" width="1" height="1">
         <animate attributeName="x" to="27" dur="4s" fill="freeze"/>
      </rect>
      <rect id="seek_by" x="7" width="1" height="1">
         <animate attributeName="x" by="20" dur="4s" fill="freeze"/>
      </rect>
      <rect id="seek_priority" x="5" width="1" height="1">
         <animate attributeName="x" from="100" to="200" dur="10s"/>
         <animate attributeName="x" from="300" to="400" begin="2s" dur="2s"/>
      </rect>
   ]])
   local frames = 0
   svg.frameCallback = function(SVG) frames += 1 end
   local visits = array<double> { 0, 9.95, 1.5, 3, 6.5, 8.5, 2, 10, 100, 5.5, 0.15, 1.5, 0 }
   for time in values(visits) do
      local before_frames = frames
      check svg.acSeek(time, SEEK_START)
      assert(frames is before_frames + 1, 'Each Seek must synchronously invoke the frame callback once')
      local active = time >= 1 and time < 5
      local interval_value = 10 + ((time - 1) % 2) * 10
      nearValue(obj.find('seek_remove').x, active ? interval_value : 7, f'Removal at {time}')
      nearValue(obj.find('seek_freeze').x, time < 1 ? 7 : (active ? interval_value : 30), f'Freeze at {time}')
      nearValue(obj.find('seek_loop').x, math.min(time, 10) * 100, f'Accumulation at {time}')
      local series_value = 7
      for begin in values(array<double> { 2, 5, 8 }) do
         if time >= begin and time < begin + 1 then series_value = 10 + (time - begin) * 20 end
      end
      nearValue(obj.find('seek_series').x, series_value, f'Begin list at {time}')
      local dependent = time < 6 ? 7 : 20 + math.min(2, time - 6) * 10
      local chain = time < 7.5 ? 7 : 50 + math.min(1.5, time - 7.5) * 20
      nearValue(obj.find('seek_dependent').x, dependent, f'Syncbase end offset at {time}')
      nearValue(obj.find('seek_chain').x, chain, f'Chained negative offset at {time}')
      nearValue(obj.find('seek_to').x, 7 + math.min(4, time) * 5, f'To-only base at {time}')
      nearValue(obj.find('seek_by').x, 7 + math.min(4, time) * 5, f'By-only base at {time}')
      local priority = time >= 10 ? 5 : (time >= 2 and time < 4 ? 300 + (time - 2) * 50 : 100 + time * 10)
      nearValue(obj.find('seek_priority').x, priority, f'Attribute priority at {time}')
   end
   processing.sleep(0.04)
   assert(frames is #visits, 'Seeking before activation must leave playback paused')
end

@Test global function SeekPositionsUseResolvedDocumentDuration()
   local svg <close> = seekDocument([[
      <rect id="seek_clock" width="1" height="1">
         <animate attributeName="x" from="0" to="10" dur="10s" fill="freeze"/>
      </rect>
      <rect width="1" height="1">
         <animate id="duration_anchor" attributeName="x" from="0" to="1" begin="2s; 8s" dur="1s"/>
         <animate attributeName="y" from="0" to="1" begin="duration_anchor.end+1s" dur="2s"/>
      </rect>
   ]]) -- Latest end is 12s, including the final syncbase instance.
   local clock = obj.find('seek_clock')
   check svg.acSeek(3.25, SEEK_CURRENT) -- Current time before the first Activate is zero.
   nearValue(clock.x, 3.25, 'Initial current seek')
   check svg.acSeek(-1, SEEK_CURRENT)
   nearValue(clock.x, 2.25, 'Relative current seek')
   check svg.acSeek(3, SEEK_END)
   nearValue(clock.x, 9, 'Offset from latest document end')
   check svg.acSeek(0.5, SEEK_RELATIVE)
   nearValue(clock.x, 6, 'Fraction of resolved document duration')
   check svg.acSeek(15, SEEK_END)
   nearValue(clock.x, 0, 'End seek clamps below zero')
   check svg.acSeek(-5, SEEK_CURRENT)
   nearValue(clock.x, 0, 'Current seek clamps below zero')
   check svg.acSeek(-2, SEEK_START)
   nearValue(clock.x, 0, 'Start seek clamps below zero')
   check svg.acSeek(2, SEEK_RELATIVE)
   nearValue(clock.x, 10, 'Seeking beyond the document end is allowed')

   -- Replacing the document invalidates the cached duration.
   check svg.acDataFeed(nil, DATA_XML, [[<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200">
      <rect id="seek_new_clock" width="1" height="1">
         <animate attributeName="x" from="0" to="4" dur="4s" fill="freeze"/>
      </rect></svg>]])
   check svg.acSeek(0.5, SEEK_RELATIVE)
   nearValue(obj.find('seek_new_clock').x, 2, 'Reparsed document duration')
end

@Test global function SeekRejectsIndefiniteDurationAndInvalidArguments()
   for timing in values(array<str> {
      'dur="1s" repeatCount="indefinite"', 'dur="indefinite"', 'dur="1s" begin="indefinite"',
      'dur="1s" begin="missing.end"', 'dur="1s" id="seek_cycle" begin="seek_cycle.end"' }) do
      local svg <close> = seekDocument(f'<rect id="seek_indefinite" x="7" width="1" height="1">' ..
         f'<animate attributeName="x" from="0" to="10" {timing}/></rect>')
      local frames = 0
      svg.frameCallback = function(SVG) frames += 1 end
      check svg.acSeek(0.25, SEEK_START)
      local original = obj.find('seek_indefinite').x
      assert(svg.acSeek(0, SEEK_END) is ERR_NoSupport, f'End requires finite duration: {timing}')
      assert(svg.acSeek(0.5, SEEK_RELATIVE) is ERR_NoSupport, f'Relative requires finite duration: {timing}')
      assert(frames is 1 and obj.find('seek_indefinite').x is original, 'Rejected seeks must not render')
      check svg.acSeek(-0.25, SEEK_CURRENT)
      assert(frames is 2, 'Current seeks must remain supported with indefinite duration')
   end

   local svg <close> = seekDocument('<rect width="1" height="1">' ..
      '<animate attributeName="x" from="0" to="10" dur="2s"/></rect>')
   local frames = 0
   svg.frameCallback = function(SVG) frames += 1 end
   for offset in values(array<double> { math.huge, -math.huge, 0/0 }) do
      assert(svg.acSeek(offset, SEEK_START) is ERR_Args, 'Non-finite offsets must be rejected')
   end
   assert(svg.acSeek(1, 9999) is ERR_Args, 'Unknown Seek positions must be rejected')
   assert(frames is 0, 'Invalid seeks must not invoke the callback')

   local empty <close> = seekDocument('<rect width="1" height="1"/>')
   empty.frameCallback = function(SVG) frames += 1 end
   for position in values(array<int> { SEEK_START, SEEK_CURRENT, SEEK_END, SEEK_RELATIVE }) do
      check empty.acSeek(2, position)
   end
   assert(frames is 0, 'Documents without animations must accept Seek without rendering')
end

@Test global function SeekRebuildsTransformAndMotionMatrices()
   local svg <close> = seekDocument([[
      <rect id="seek_transform" x="1" width="1" height="1" transform="translate(5 0)">
         <animateTransform attributeName="transform" type="translate" from="0 0" to="20 0" begin="2s" dur="4s"/>
      </rect>
      <rect id="seek_motion" x="2" width="1" height="1" transform="translate(5 0)">
         <animateMotion from="0 0" to="20 0" begin="2s" dur="4s" fill="freeze"/>
      </rect>
   ]])
   for time in values(array<double> { 3, 5, 0, 6, 4, 1, 3 }) do
      check svg.acSeek(time, SEEK_START)
      local _, transform_x = check obj.find('seek_transform').mtGetBoundary(0)
      local _, motion_x = check obj.find('seek_motion').mtGetBoundary(0)
      nearValue(transform_x, time >= 2 and time < 6 ? 1 + (time - 2) * 5 : 6, f'Transform at {time}')
      nearValue(motion_x, 7 + math.max(0, math.min(4, time - 2)) * 5, f'Motion at {time}')
   end
end

@Test global function SeekPreservesPlaybackState()
   local svg <close> = seekDocument([[
      <rect id="seek_playing" width="1" height="1">
         <animate attributeName="x" from="0" to="100" dur="100s" fill="freeze"/>
      </rect>
   ]])
   local clock = obj.find('seek_playing')
   local frames = 0
   svg.frameCallback = function(SVG) frames += 1 end
   check svg.acSeek(20, SEEK_START)
   processing.sleep(0.04)
   nearValue(clock.x, 20, 'Initial seek stays paused')
   assert(frames is 1, 'Initial seek must not start a timer')

   check svg.acActivate()
   for attempt in {0 to 100} do
      if frames >= 3 then break end
      processing.sleep(0.01)
   end
   assert(clock.x > 20 and clock.x < 21, 'First Activate must continue from the seeked position')
   check svg.acSeek(50, SEEK_START)
   nearValue(clock.x, 50, 'Playing seek is immediate')
   local seek_frames = frames
   for attempt in {0 to 100} do
      if frames >= seek_frames + 2 then break end
      processing.sleep(0.01)
   end
   assert(clock.x > 50 and clock.x < 51, 'Playing Seek must retain its timer and continue from the new time')
   check svg.acDeactivate()
   check svg.acSeek(5, SEEK_START)
   nearValue(clock.x, 5, 'Paused seek is immediate')
   seek_frames = frames
   processing.sleep(0.04)
   assert(frames is seek_frames and clock.x is 5, 'Paused Seek must leave the clock and timer paused')
   check svg.acSeek(0.5, SEEK_CURRENT)
   nearValue(clock.x, 5.5, 'Current seek excludes the paused interval')
   check svg.acActivate()
   for attempt in {0 to 100} do
      if frames >= seek_frames + 3 then break end
      processing.sleep(0.01)
   end
   check svg.acDeactivate()
   assert(clock.x > 5.5 and clock.x < 6.5, 'Resuming must retain the paused seek position')
end

-- A linear animation of x from 0 to 1000 over 10 seconds, i.e. 100 units per second.

local ANIMATED_SVG = [[<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200">
  <rect id="anim_box" x="0" y="0" width="10" height="10">
    <animate attributeName="x" from="0" to="1000" dur="10s"/>
  </rect>
</svg>]]

----------------------------------------------------------------------------------------------------------------------
-- Deactivate must pause the animation clock, so that Activate resumes from the paused position rather than jumping
-- ahead by the time spent deactivated.

@Test global function DeactivatePausesAnimation()
   local scene = obj.new('VectorScene', { pageWidth=200, pageHeight=200 })
   scene.bitmap = obj.new('bitmap', { width=200, height=200, bitsPerPixel=32, bkgd=glWhite })
   local svg = obj.new('svg', { target=scene, statement=ANIMATED_SVG })
   local rect = obj.find('anim_box')
   assert(rect, 'Failed to find the animated rectangle')

   svg.acActivate()
   processing.sleep(0.3)
   svg.acDeactivate()

   local paused_x = rect.x
   assert(paused_x > 0, 'Expected the animation to have advanced before pausing, got ' .. paused_x)

   processing.sleep(0.6)
   assert(rect.x is paused_x, 'Expected x to remain at ' .. paused_x .. ' while deactivated, got ' .. rect.x)

   svg.acActivate()
   processing.sleep(0.1)
   svg.acDeactivate()

   -- Approximately 10 units are expected after resuming.  Without pausing, x would jump by at least 60 units.

   local resumed_x = rect.x
   assert(resumed_x > paused_x, 'Expected the animation to advance after reactivation, got ' .. resumed_x)
   assert(resumed_x - paused_x < 40,
      'Animation jumped by ' .. (resumed_x - paused_x) .. ' units after reactivation; paused time was not excluded')
end

----------------------------------------------------------------------------------------------------------------------
-- A reference animation exposes document time as x.  Compare every observed frame against that time, so delayed
-- timer delivery cannot change the expected repeats, syncbase offsets or attribute priority.

@Test global function PlaybackUsesDeterministicTiming()
   local scene <close> = obj.new('VectorScene', { pageWidth=200, pageHeight=200 })
   scene.bitmap = obj.new('bitmap', { width=200, height=200, bitsPerPixel=32, bkgd=glWhite })
   local svg <close> = obj.new('svg', { target=scene, statement=[[
      <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200">
         <defs><linearGradient id="base_paint"><stop stop-color="green"/></linearGradient></defs>
         <rect id="clock" width="1" height="1">
            <animate attributeName="x" from="0" to="100" dur="100s"/>
         </rect>
         <rect id="loop" width="1" height="1">
            <animate attributeName="x" from="0" to="10" dur="0.01s" repeatCount="indefinite" accumulate="sum"/>
         </rect>
         <rect id="dependent" width="1" height="1" x="7">
            <animate attributeName="x" from="20" to="24" begin="anchor.end+0.01s" dur="0.04s" fill="freeze"/>
         </rect>
         <rect id="negative_offset" width="1" height="1" x="7">
            <animate attributeName="x" from="0" to="10" begin="anchor.begin-0.01s" dur="0.1s" fill="freeze"/>
         </rect>
         <rect width="1" height="1">
            <animate id="anchor" attributeName="x" from="0" to="4" begin="0.02s" dur="0.04s"/>
         </rect>
         <rect id="series" x="7" width="1" height="1">
            <animate attributeName="x" from="10" to="30" begin="0.12s; 0.02s; 0.08s" dur="0.02s"/>
         </rect>
         <rect id="priority" x="5" width="1" height="1">
            <animate attributeName="x" from="100" to="200" dur="1s"/>
            <animate attributeName="x" from="300" to="400" begin="0.03s" dur="0.05s"/>
         </rect>
         <rect id="fractional" width="1" height="1">
            <animate attributeName="x" from="0" to="10" dur="0.02s" repeatCount="2.5"
               accumulate="sum" fill="freeze"/>
         </rect>
         <rect id="repeat_duration" width="1" height="1">
            <animate attributeName="x" from="0" to="10" dur="0.02s" repeatDur="0.05s"
               accumulate="sum" fill="freeze"/>
         </rect>
         <rect id="transform_remove" x="1" width="1" height="1" transform="translate(5 0)">
            <animateTransform attributeName="transform" type="translate" from="0 0" to="20 0" dur="0.02s"/>
         </rect>
         <rect id="motion_remove" x="2" width="1" height="1" transform="translate(5 0)">
            <animateMotion from="0 0" to="20 0" dur="0.02s"/>
         </rect>
         <rect id="transform_frozen" x="1" width="1" height="1">
            <animateTransform attributeName="transform" type="translate" from="0 0" to="20 0" dur="0.02s"
               max="0.01s" fill="freeze"/>
         </rect>
         <rect id="motion_frozen" x="2" width="1" height="1">
            <animateMotion from="0 0" to="20 0" dur="0.02s" max="0.01s" fill="freeze"/>
         </rect>
         <g opacity="0.25">
            <animate attributeName="opacity" from="0.4" to="0.9" dur="0.03s"/>
            <rect id="group_child" width="1" height="1"/>
            <rect id="group_override" width="1" height="1" opacity="0.6"/>
         </g>
         <rect id="paint_restore" width="1" height="1" fill="url(#base_paint)">
            <animate attributeName="fill" from="red" to="blue" dur="0.02s"/>
         </rect>
         <rect id="cycle_target" x="9" width="1" height="1">
            <animate id="cycle_a" attributeName="x" from="0" to="10" begin="cycle_b.end" dur="0.01s"/>
            <animate id="cycle_b" attributeName="x" from="0" to="10" begin="cycle_a.end" dur="0.01s"/>
         </rect>
      </svg>
   ]] })
   local clock = obj.find('clock')
   local loop = obj.find('loop')
   local dependent = obj.find('dependent')
   local negative = obj.find('negative_offset')
   local series = obj.find('series')
   local priority = obj.find('priority')
   local child = obj.find('group_child')
   local override = obj.find('group_override')
   local paint = obj.find('paint_restore')
   local original_paint = paint.fill
   local cycle = obj.find('cycle_target')
   local max_error = 0
   local frame_count = 0
   svg.frameCallback = function(SVG)
      local time = clock.x
      local expected_dependent = time < 0.07 ? 7 : 20 + math.min(1, (time - 0.07) / 0.04) * 4
      local expected_negative = time < 0.01 ? 7 : math.min(10, (time - 0.01) * 100)
      local expected_series = 7
      for begin in values({ 0.02, 0.08, 0.12 }) do
         if time >= begin and time < begin + 0.02 then expected_series = 10 + (time - begin) * 1000 end
      end
      local expected_priority = time >= 0.03 and time < 0.08 ? 300 + (time - 0.03) * 2000 : 100 + time * 100
      local expected_child = time < 0.03 ? 0.4 + time / 0.03 * 0.5 : 1
      max_error = math.max(max_error, math.abs(loop.x - time * 1000),
         math.abs(dependent.x - expected_dependent), math.abs(negative.x - expected_negative),
         math.abs(series.x - expected_series), math.abs(priority.x - expected_priority),
         math.abs(child.opacity - expected_child))
      frame_count += 1
   end
   check svg.acActivate()
   for attempt in {0 to 100} do
      if clock.x >= 0.25 then break end
      processing.sleep(0.02)
   end
   check svg.acDeactivate()
   assert(clock.x >= 0.25 and frame_count >= 3, 'Expected document time and frame callbacks to advance')
   assert(max_error < 0.00001, f'Playback diverged from the analytical timeline by {max_error}')
   assert(child.opacity is 1, f'A group effect must restore its child base value, got {child.opacity}')
   assert(math.abs(override.opacity - 0.6) < 0.00001, 'Group animation must respect child-defined attributes')
   assert(paint.fill is original_paint, 'Removing a colour animation must restore its original paint server')
   assert(cycle.x is 9, 'A syncbase cycle must remain unresolved')
   assert(math.abs(obj.find('fractional').x - 25) < 0.00001, 'A fractional repeat must freeze at its partial end')
   assert(math.abs(obj.find('repeat_duration').x - 25) < 0.00001,
      'repeatDur must repeat and accumulate without a count')
   for name, expected in { transform_remove=6, motion_remove=7, transform_frozen=11, motion_frozen=12 } do
      local _, x = check obj.find(name).mtGetBoundary(0)
      assert(math.abs(x - expected) < 0.00001, f'{name}: expected boundary x={expected}, got {x}')
   end
end

