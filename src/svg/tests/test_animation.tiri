@Test global function RemovedEffectsRestoreAttributeTypes()
   local svg <close> = obj.new('svg', { statement=[[
      <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200">
         <rect id="typed_rect" width="50%" height="10" stroke-linejoin="bevel" stroke-dasharray="3 5">
            <animate attributeName="width" from="10" to="20" dur="0.001s"/>
            <set attributeName="stroke-linejoin" to="round" dur="0.001s"/>
            <set attributeName="stroke-dasharray" to="7 9" dur="0.001s"/>
         </rect>
         <text id="typed_text" x="20" y="30" font-size="16px" text-anchor="end" font-family="Noto Sans">Text
            <set attributeName="font-size" to="30px" dur="0.001s"/>
            <set attributeName="font-family" to="Noto Serif" dur="0.001s"/>
            <set attributeName="text-anchor" to="start" dur="0.001s"/>
         </text>
      </svg>
   ]] })
   svg.scene.bitmap = obj.new('bitmap', { width=200, height=200, bitsPerPixel=32, bkgd=glWhite })
   local rect = obj.find('typed_rect')
   local text = obj.find('typed_text')
   local original_width, original_join = rect.width, rect.lineJoin
   local original_face, original_size, original_align = text.face, text.fontSize, text.align
   local frames = 0
   svg.frameCallback = function(SVG) frames += 1 end
   check svg.acActivate()
   for attempt in {0 to 100} do
      if frames >= 3 then break end
      processing.sleep(0.02)
   end
   check svg.acDeactivate()
   assert(frames >= 3, 'Expected the short animations to finish')
   assert(rect.width is original_width, 'Removal must preserve a relative dimension')
   assert(rect.lineJoin is original_join, 'Removal must restore an SVG enumeration')
   assert(rect.dashArray[0] is 3 and rect.dashArray[1] is 5, 'Removal must restore a numeric array')
   assert(text.face is original_face, 'Removal must restore the font family')
   assert(text.fontSize is original_size, 'Removal must restore the font size')
   assert(text.align is original_align, 'Removal must restore the text anchor')

   -- Inactive effects restore once, then leave subsequent client edits alone.
   rect.width = 33
   frames = 0
   check svg.acActivate()
   for attempt in {0 to 100} do
      if frames >= 3 then break end
      processing.sleep(0.02)
   end
   check svg.acDeactivate()
   assert(rect.width is 33, 'An inactive animation must not continually overwrite client values')
end

