-- Short animations finish on the second timer frame.  Wait for frame callbacks rather than assuming a fixed sleep
-- is enough, so the assertions also exercise frame rendering and callback dispatch on a busy machine.

@Test global function AnimationFillModesRestoreBaseValues()
   local scene <close> = obj.new('VectorScene', { pageWidth=200, pageHeight=200 })
   scene.bitmap = obj.new('bitmap', { width=200, height=200, bitsPerPixel=32, bkgd=glWhite })
   local svg <close> = obj.new('svg', { target=scene, statement=[[
      <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200">
         <rect id="removed" width="10" height="10" opacity="0.25" fill-opacity="0.3">
            <animate attributeName="opacity" from="0.5" to="0.75" dur="0.001s" fill="remove"/>
            <animate attributeName="fill-opacity" from="0.5" to="0.75" dur="0.001s" fill="remove"/>
         </rect>
         <rect id="default_remove" width="10" height="10" opacity="0.4">
            <animate attributeName="opacity" from="0.5" to="0.75" dur="0.001s"/>
            <animate attributeName="fill-opacity" from="0.5" to="0.75" dur="0.001s"/>
         </rect>
         <g fill-opacity="0.35">
            <rect id="inherited" width="10" height="10">
               <animate attributeName="fill-opacity" from="0.5" to="0.75" dur="0.001s" fill="remove"/>
            </rect>
         </g>
         <rect id="frozen" width="10" height="10" opacity="0.25">
            <animate attributeName="opacity" from="0.5" to="0.75" dur="0.001s" fill="freeze"/>
         </rect>
         <rect id="set_removed" width="10" height="10">
            <set attributeName="display" to="none" dur="0.001s" fill="remove"/>
         </rect>
      </svg>
   ]] })
   local removed = obj.find('removed')
   local default_remove = obj.find('default_remove')
   local inherited = obj.find('inherited')
   local frozen = obj.find('frozen')
   local set_removed = obj.find('set_removed')
   local base_visibility = set_removed.visibility
   local frame_count = 0
   local first_opacity, first_visibility
   svg.frameCallback = function(SVG)
      frame_count += 1
      if frame_count is 1 then
         first_opacity = removed.opacity
         first_visibility = set_removed.visibility
      end
   end

   check svg.acActivate()
   for attempt in {0 to 100} do
      if frame_count >= 3 then break end
      processing.sleep(0.02)
   end
   check svg.acDeactivate()

   assert(frame_count >= 3, f'Expected at least three frame callbacks, got {frame_count}')
   assert(first_opacity is 0.5, f'First callback must see the animated value, got {first_opacity}')
   assert(first_visibility != base_visibility, 'The set animation must change display during its active interval')
   assert(math.abs(removed.opacity - 0.25) < 0.00001,
      f'fill="remove" must restore the original opacity, got {removed.opacity}')
   assert(math.abs(removed.fillOpacity - 0.3) < 0.00001,
      f'fill="remove" must restore the original fill opacity, got {removed.fillOpacity}')
   assert(math.abs(default_remove.opacity - 0.4) < 0.00001,
      f'The default fill mode must restore the original opacity, got {default_remove.opacity}')
   assert(default_remove.fillOpacity is 1,
      f'The default fill opacity must be restored to one, got {default_remove.fillOpacity}')
   assert(math.abs(inherited.fillOpacity - 0.35) < 0.00001,
      f'The inherited fill opacity must be restored, got {inherited.fillOpacity}')
   assert(frozen.opacity is 0.75, f'fill="freeze" must keep the final opacity, got {frozen.opacity}')
   assert(set_removed.visibility is base_visibility, 'fill="remove" must restore display after the set animation')
end

----------------------------------------------------------------------------------------------------------------------
-- Position and Duration fields.  Paused reads after an exact Seek are deterministic; playback checks use bounds
-- measured with PreciseTime() rather than relying on timer delivery.

function elapsedSince(Start:num!):num
   return (mSys.PreciseTime() - Start) / 1000000
end

function waitFrames(Count:func!, Target:num!)
   for attempt in {0 to 100} do
      if Count() >= Target then break end
      processing.sleep(0.01)
   end
end

@Test global function AnimationFieldsAreZeroWithoutAnimations()
   local svg <close> = seekDocument('<rect id="static_rect" x="7" width="1" height="1"/>')
   local frames = 0
   svg.frameCallback = function(SVG) frames += 1 end
   for attempt in {0 to 3} do
      assert(svg.position is 0 and svg.duration is 0, 'A static document must report zero position and duration')
   end
   check svg.acSeek(5, SEEK_START)
   check svg.acActivate()
   processing.sleep(0.04)
   check svg.acDeactivate()
   assert(svg.position is 0 and svg.duration is 0, 'Seek and playback must not move a static document clock')
   assert(frames is 0, 'A static document must not render animation frames')
end

@Test global function AnimationFieldsDoNotStartPlayback()
   local svg <close> = seekDocument([[<rect id="unstarted" x="7" width="1" height="1">
      <animate attributeName="x" from="10" to="20" begin="1s" dur="4s"/></rect>]])
   local frames = 0
   svg.frameCallback = function(SVG) frames += 1 end
   for attempt in {0 to 5} do
      assert(svg.position is 0, f'An unactivated document must report time 0, got {svg.position}')
      assert(svg.duration is 5, f'Expected the resolved duration 5, got {svg.duration}')
   end
   processing.sleep(0.05)
   assert(frames is 0, 'Reading the fields must not render or invoke FrameCallback')
   assert(obj.find('unstarted').x is 7, 'Reading the fields must not apply animation values')
   assert(svg.position is 0, 'The position must not advance before playback')

   -- If a read had established the epoch, the current time would now include the sleep above.
   check svg.acSeek(0, SEEK_CURRENT)
   nearValue(svg.position, 0, 'Field reads must leave the animation epoch unset')
   assert(frames is 1, 'Only the Seek must render')
end

@Test global function PositionReportsExactSeekTimes()
   local svg <close> = seekDocument([[
      <rect id="field_clock" width="1" height="1">
         <animate attributeName="x" from="0" to="10" dur="10s" fill="freeze"/>
      </rect>
      <rect width="1" height="1">
         <animate id="field_anchor" attributeName="x" from="0" to="1" begin="2s; 8s" dur="1s"/>
         <animate attributeName="y" from="0" to="1" begin="field_anchor.end+1s" dur="2s"/>
      </rect>
   ]]) -- Latest end is 12s, including the final syncbase instance.
   assert(svg.duration is 12, f'Expected the duration 12, got {svg.duration}')
   local steps = {
      { 3.25, SEEK_START, 3.25 }, { 1.5, SEEK_CURRENT, 4.75 }, { -2, SEEK_CURRENT, 2.75 }, { 3, SEEK_END, 9 },
      { 0, SEEK_END, 12 }, { 0.25, SEEK_RELATIVE, 3 }, { 1, SEEK_START, 1 }, { 15, SEEK_END, 0 },
      { -5, SEEK_CURRENT, 0 }, { -2, SEEK_START, 0 }, { 2, SEEK_RELATIVE, 24 }, { 30, SEEK_CURRENT, 54 },
      { 0.5, SEEK_RELATIVE, 6 } }
   for _, step in steps do
      check svg.acSeek(step[0], step[1])
      nearValue(svg.position, step[2], f'Position after Seek({step[0]}, {step[1]})')
      nearValue(obj.find('field_clock').x, math.min(10, step[2]), f'Scene after Seek({step[0]}, {step[1]})')
      assert(svg.duration is 12, 'Seeking must not change a duration without event instances')
   end
   processing.sleep(0.03)
   nearValue(svg.position, 6, 'A seek before activation must remain paused')

   -- Reading the duration first must not change the time selected by end-relative seeks.
   local quiet <close> = seekDocument('<rect width="1" height="1">' ..
      '<animate attributeName="x" from="0" to="1" begin="1s; 3s" dur="2.5s"/></rect>')
   local reader <close> = seekDocument('<rect width="1" height="1">' ..
      '<animate attributeName="x" from="0" to="1" begin="1s; 3s" dur="2.5s"/></rect>')
   for attempt in {0 to 3} do assert(reader.duration is 5.5, 'Expected a restarted interval to end at 5.5') end
   for step in values({ { 1, SEEK_END }, { 0.5, SEEK_RELATIVE } }) do
      check quiet.acSeek(step[0], step[1])
      check reader.acSeek(step[0], step[1])
      assert(quiet.position is reader.position, 'A Duration read must not affect subsequent Seek results')
   end
end

@Test global function PositionFollowsPlaybackClock()
   local svg <close> = seekDocument([[<rect id="playing_clock" width="1" height="1">
      <animate attributeName="x" from="0" to="100" dur="100s" fill="freeze"/></rect>]])
   local clock = obj.find('playing_clock')
   local frames = 0
   local lag = 0 -- The largest amount by which Position trailed the delivered frame.
   svg.frameCallback = function(SVG)
      frames += 1
      lag = math.max(lag, clock.x - SVG.position)
   end
   local count = () => frames

   check svg.acActivate()
   waitFrames(count, 3)
   local playing = svg.position
   assert(frames >= 3 and playing > 0, f'Expected the clock to advance during playback, got {playing}')
   processing.sleep(0.05)
   local later = svg.position
   assert(later > playing, 'Position must advance between reads while playing')

   check svg.acDeactivate()
   local paused = svg.position
   assert(paused >= later, 'Pausing must not move the clock backwards')
   processing.sleep(0.06)
   assert(svg.position is paused, f'Position must remain constant while paused, {paused} became {svg.position}')

   local resume_start = mSys.PreciseTime()
   check svg.acActivate()
   waitFrames(count, frames + 2)
   check svg.acDeactivate()
   local resumed = svg.position
   local resume_wall = elapsedSince(resume_start)
   assert(resumed > paused, 'Activate must resume the clock')
   assert(resumed - paused <= resume_wall + 0.000001,
      f'Resuming advanced {resumed - paused}s in {resume_wall}s of playback; the paused interval was included')
   assert(lag < 0.000001, f'Position must not trail the delivered frame, lagged by {lag}')
   assert(svg.duration is 100, 'Duration must not count down during playback')

   check svg.acSeek(20, SEEK_START)
   nearValue(svg.position, 20, 'Paused Seek')
   processing.sleep(0.03)
   assert(svg.position is 20 or math.abs(svg.position - 20) < 0.00001, 'A paused Seek must remain constant')

   check svg.acActivate()
   local seek_start = mSys.PreciseTime()
   check svg.acSeek(50, SEEK_START)
   local selected = svg.position
   assert(selected >= 50 - 0.00001 and selected - 50 <= elapsedSince(seek_start) + 0.00001,
      f'A playing Seek must report the selected time, got {selected}')
   waitFrames(count, frames + 2)
   assert(svg.position > selected, 'Playback must continue after a playing Seek')
   check svg.acDeactivate()

   check svg.acSeek(250, SEEK_START)
   nearValue(svg.position, 250, 'Seeking beyond the duration must not clamp the position')
   assert(svg.duration is 100, 'Duration must remain constant when timing inputs do not change')

   -- Activate after an initial Seek continues from the selected time.
   local fresh <close> = seekDocument([[<rect id="initial_clock" width="1" height="1">
      <animate attributeName="x" from="0" to="100" dur="100s"/></rect>]])
   local fresh_frames = 0
   fresh.frameCallback = function(SVG) fresh_frames += 1 end
   check fresh.acSeek(30, SEEK_START)
   processing.sleep(0.03)
   nearValue(fresh.position, 30, 'An initial Seek must hold its position until activation')
   local fresh_start = mSys.PreciseTime()
   check fresh.acActivate()
   waitFrames(() => fresh_frames, 3)
   check fresh.acDeactivate()
   assert(fresh.position > 30 and fresh.position - 30 <= elapsedSince(fresh_start) + 0.000001,
      f'The first Activate must continue from the initial Seek, got {fresh.position}')
end

@Test global function DurationResolvesFiniteTiming()
   local cases = {
      { 'begin="1s; 4s" dur="2s"', 6 },
      { 'begin="1s" dur="2s" repeatCount="3"', 7 },
      { 'dur="2s" repeatCount="2.5"', 5 },
      { 'dur="1s" repeatDur="3.5s"', 3.5 },
      { 'dur="2s" min="4s"', 4 },
      { 'dur="5s" max="2s"', 2 },
      { 'begin="0s; 1s" dur="3s"', 4 },
      { 'begin="0s; 1s" dur="3s" restart="whenNotActive"', 3 },
      { 'begin="0s; 5s" dur="1s" restart="never"', 1 },
      { 'dur="1s" repeatCount="indefinite" repeatDur="2.5s"', 2.5 },
      { 'dur="1s" repeatCount="indefinite" max="4s"', 4 },
      { 'begin="-5s" dur="2s"', 0 },
      { 'dur="1s" max="0s"', 0 }
   }
   for _, case in cases do
      local svg <close> = seekDocument('<rect width="1" height="1">' ..
         f'<animate attributeName="x" from="0" to="10" {case[0]}/></rect>')
      local expected = case[1]
      assert(svg.duration is expected, f'{case[0]}: expected duration {expected}, got {svg.duration}')
      check svg.acSeek(0, SEEK_END)
      nearValue(svg.position, expected, f'{case[0]}: SEEK_END agrees with Duration')
      check svg.acSeek(0.5, SEEK_RELATIVE)
      nearValue(svg.position, expected / 2, f'{case[0]}: SEEK_RELATIVE agrees with Duration')
      check svg.acSeek(1, SEEK_END)
      nearValue(svg.position, math.max(0, expected - 1), f'{case[0]}: SEEK_END offset')
   end

   local chain <close> = seekDocument([[
      <rect width="1" height="1">
         <animate id="chain_a" attributeName="x" from="0" to="1" begin="1s" dur="2s"/>
         <animate id="chain_b" attributeName="y" from="0" to="1" begin="chain_a.end+1s" dur="2s"/>
         <animate attributeName="width" from="1" to="2" begin="chain_b.end-1s" dur="3s"/>
      </rect>
   ]]) -- chain_a ends at 3, chain_b runs 4-6 and the final animation runs 5-8.
   assert(chain.duration is 8, f'Expected the syncbase chain to end at 8, got {chain.duration}')
   check chain.acSeek(0, SEEK_END)
   nearValue(chain.position, 8, 'SEEK_END follows the syncbase chain')
end

@Test global function DurationReportsIndefiniteTiming()
   for timing in values(array<str> {
      'dur="1s" repeatCount="indefinite"', 'dur="indefinite"', 'dur="1s" begin="indefinite"',
      'dur="1s" begin="missing.end"', 'dur="1s" id="field_cycle" begin="field_cycle.end"' }) do
      local svg <close> = seekDocument('<rect width="1" height="1">' ..
         f'<animate attributeName="x" from="0" to="10" {timing}/></rect>' ..
         '<rect width="1" height="1"><animate attributeName="x" from="0" to="1" dur="3s"/></rect>')
      assert(svg.duration is -1, f'{timing}: expected an indefinite duration, got {svg.duration}')
      check svg.acSeek(3, SEEK_START)
      assert(svg.acSeek(0, SEEK_END) is ERR_NoSupport, f'{timing}: SEEK_END requires a finite duration')
      assert(svg.acSeek(0.5, SEEK_RELATIVE) is ERR_NoSupport, f'{timing}: SEEK_RELATIVE requires a finite duration')
      nearValue(svg.position, 3, f'{timing}: a failed Seek must not move the position')
      check svg.acSeek(-1, SEEK_CURRENT)
      nearValue(svg.position, 2, f'{timing}: current seeking remains available')
      assert(svg.duration is -1, f'{timing}: the duration must remain indefinite')
   end
end

@Test global function AnimationFieldsFollowDocumentChanges()
   local svg <close> = seekDocument('<rect width="1" height="1">' ..
      '<animate attributeName="x" from="0" to="1" dur="4s"/></rect>')
   check svg.acSeek(3, SEEK_START)
   nearValue(svg.position, 3, 'Initial position')
   assert(svg.duration is 4, 'Initial duration')

   local replacements = {
      { '<animate attributeName="x" from="0" to="1" dur="2s"/>', 2 },
      { '<animate attributeName="x" from="0" to="1" begin="1s" dur="9s"/>', 10 },
      { '', 0 },
      { '<animate attributeName="x" from="0" to="1" dur="1s" repeatCount="indefinite"/>', -1 }
   }
   for _, replacement in replacements do
      check svg.acSeek(1.5, SEEK_START)
      check svg.acDataFeed(nil, DATA_XML, '<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200">' ..
         f'<rect width="1" height="1">{replacement[0]}</rect></svg>')
      assert(svg.position is 0, f'Reparsing must reset the position, got {svg.position}')
      assert(svg.duration is replacement[1], f'Expected a fresh duration {replacement[1]}, got {svg.duration}')
   end

   -- Replacing a playing document resets the clock immediately; the timer then restarts it from zero.
   check svg.acDataFeed(nil, DATA_XML, ANIMATED_SVG)
   local frames = 0
   svg.frameCallback = function(SVG) frames += 1 end
   check svg.acActivate()
   waitFrames(() => frames, 3)
   local replace_start = mSys.PreciseTime()
   check svg.acDataFeed(nil, DATA_XML, ANIMATED_SVG)
   assert(svg.position is 0, 'Replacing a playing document must reset the position')
   waitFrames(() => frames, frames + 2)
   check svg.acDeactivate()
   assert(svg.position > 0 and svg.position <= elapsedSince(replace_start) + 0.000001,
      f'Playback must restart from zero after replacement, got {svg.position}')

   -- A document loaded from Path reports the same initial state.
   local path = 'temp:svg_animation_fields.svg'
   local file = obj.new('file', { path=path, flags=FL_WRITE|FL_NEW })
   check file.acWrite(ANIMATED_SVG)
   file.free()
   defer mSys.DeleteFile(path) end
   local loaded <close> = obj.new('svg', { path=path })
   assert(loaded.position is 0 and loaded.duration is 10, 'A Path document must report time 0 and duration 10')
end

@Test global function ParsingSymbolRefreshesDuration()
   local svg <close> = seekDocument([[
      <defs><symbol id="long_symbol">
         <rect width="1" height="1"><animate attributeName="x" from="0" to="10" begin="1s" dur="19s"/></rect>
      </symbol></defs>
      <rect width="1" height="1"><animate attributeName="x" from="0" to="1" dur="2s"/></rect>
   ]])
   assert(svg.duration is 2, f'Expected the symbol to be excluded until instantiated, got {svg.duration}')
   check svg.acSeek(1.5, SEEK_START)
   check svg.mtParseSymbol('long_symbol', svg.viewport)
   nearValue(svg.position, 1.5, 'Instantiating a symbol must keep the document clock')
   assert(svg.duration is 20, f'Instantiating a symbol must refresh the duration, got {svg.duration}')
   check svg.acSeek(0, SEEK_END)
   nearValue(svg.position, 20, 'SEEK_END must include the symbol animation')
end

----------------------------------------------------------------------------------------------------------------------
-- A hyperlink to an animation records an event-triggered begin at the current document time.  Pointer input is
-- injected through the SystemPointer, as in src/vector/tests/test_input_free.tiri.

function putDouble(Buffer:array<byte>!, Offset:num!, Value:num!)
   if Value is 0 then return end
   local mantissa, exponent = math.frexp(Value)
   local fraction = ((mantissa * 2) - 1) * 1048576 -- The top 20 bits of the mantissa occupy the high word
   local high = ((exponent + 1022) * 1048576) + math.floor(fraction)
   local low = (fraction - math.floor(fraction)) * 4294967296
   for i in {0 to 4} do
      Buffer[Offset + i] = math.floor(low / (256 ** i)) % 256
      Buffer[Offset + 4 + i] = math.floor(high / (256 ** i)) % 256
   end
end

-- Feed one dcDeviceInput record: { double Values[2]; int64 Timestamp; OBJECTID DeviceID; JTYPE Flags; JET Type }.

function feedPointer(Type:num!, Value0:num!, Value1:num!)
   local input = array<byte, 40>
   putDouble(input, 0, Value0)
   putDouble(input, 8, Value1)
   input[32] = Type
   check obj.find('SystemPointer').acDataFeed(nil, DATA_DEVICE_INPUT, input)
   processing.sleep(0)
end

@Test global function DurationFollowsEventInstances()
   local surface <close> = obj.new('Surface', { x=50, y=50, width=200, height=200 })
   local scene = surface.new('VectorScene', { surface=surface })
   local svg <close> = obj.new('svg', { target=scene, statement=[[
      <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200">
         <a href="#event_anim"><rect id="event_button" width="50" height="50" fill="blue"/></a>
         <rect id="event_target" x="7" y="100" width="10" height="10">
            <animate id="event_anim" attributeName="x" from="20" to="50" begin="indefinite" dur="3s"/>
         </rect>
         <rect y="150" width="10" height="10"><animate attributeName="x" from="0" to="1" dur="1s"/></rect>
      </svg>
   ]] })
   surface.acShow()
   surface.acDraw()
   processing.sleep(0)
   local pointer = obj.find('SystemPointer')
   assert(pointer, 'The SystemPointer must exist once a surface is shown')
   pointer.surface = surface.id -- Hit-testing must start at this surface even if other tests leaked surfaces.
   defer
      feedPointer(JET_LMB, 0, 0)
      pointer.surface = 0
   end

   assert(svg.duration is -1, 'An event-only begin must leave the duration indefinite')
   check svg.acSeek(2, SEEK_START)
   feedPointer(JET_ABS_XY, surface.absX + 25, surface.absY + 25)
   feedPointer(JET_LMB, 1, 0)
   feedPointer(JET_LMB, 0, 0)

   nearValue(svg.position, 2, 'Recording an event must not move the paused clock')
   for attempt in {0 to 3} do
      assert(svg.duration is 5, f'A recorded begin at 2s must resolve the duration to 5, got {svg.duration}')
   end
   check svg.acSeek(0, SEEK_END)
   nearValue(svg.position, 5, 'SEEK_END must use the recorded begin')
   nearValue(obj.find('event_target').x, 7, 'The unfrozen animation must have ended at the document end')
   check svg.acSeek(3.5, SEEK_START)
   nearValue(obj.find('event_target').x, 35, 'The recorded begin must drive the animation')
   assert(svg.duration is 5, 'Seeking forwards must retain the recorded begin')

   check svg.acSeek(1, SEEK_START) -- Discards the instance recorded at 2s.
   assert(svg.duration is -1, f'Discarding the recorded begin must restore an indefinite duration, got {svg.duration}')
   assert(svg.acSeek(0, SEEK_END) is ERR_NoSupport, 'SEEK_END must be unavailable once the begin is discarded')
   nearValue(svg.position, 1, 'A rejected Seek must leave the position unchanged')
end

@Test global function AnimationFieldsRejectWrites()
   local svg <close> = seekDocument('<rect width="1" height="1">' ..
      '<animate attributeName="x" from="0" to="1" dur="4s"/></rect>')
   local frames = 0
   svg.frameCallback = function(SVG) frames += 1 end
   check svg.acSeek(2, SEEK_START)
   assert(svg.set('position', 3) is ERR_NoFieldAccess, 'Position must be read-only')
   assert(svg.set('duration', 3) is ERR_NoFieldAccess, 'Duration must be read-only')
   for name in values(array<str> { 'position', 'duration' }) do
      try
         svg[name] = 1
         assert(false, f'Assigning {name} must raise')
      except e when ERR_ImmutableField
      end
   end
   nearValue(svg.position, 2, 'A rejected write must not change the position')
   assert(svg.duration is 4, 'A rejected write must not change the duration')
   for attempt in {0 to 10} do
      local _ = svg.position + svg.duration
   end
   processing.sleep(0.03)
   assert(frames is 1, 'Field reads must not render or invoke FrameCallback')
end
