-- $TIRI

   include 'svg'
   include 'vector'
   module display as mGfx

local glSVGFolder
glFiles = array<str>

@BeforeAll function setup(State:table)
   glSVGFolder = State.folder
end

@AfterAll function removeFiles()
   for path in values(glFiles) do
      mSys.DeleteFile(path)
   end
end

----------------------------------------------------------------------------------------------------------------------

glImagePath = <{ glSVGFolder .. 'basics/sign.png' }>

function saveScene(Scene:obj, Path:str):str
   svg = obj.new('svg', { target=Scene })
   file = obj.new('file', { path=Path, flags=FL_NEW|FL_WRITE })
   glFiles.push(Path)

   check svg.acSaveToObject(file, 0)
   file = nil
   return io.readAll(Path)
end

function assertContains(Haystack:str, Needle:str, Message:str)
   assert(Haystack.find(Needle, 0, true) != nil, Message)
end

function assertNear(Actual, Expected, Message)
   assert(Actual ≈ Expected, Message .. ' expected ' .. Expected .. ', got ' .. Actual)
end

function transitionStop(Offset:num, Transform:str)
   local stop = struct.new('Transition')
   stop.offset = Offset
   stop.transform = Transform
   return stop
end

function transitionStops()
   return {
      transitionStop(0.0, 'translate(5 6)'),
      transitionStop(1.0, 'scale(2)')
   }
end

function waveDocument(ID:str, AttribName:str):str
   return [[
<svg viewBox="0 0 120 80" xmlns="http://www.w3.org/2000/svg" xmlns:kotuku="http://www.kotuku.dev/xmlns/svg">
  <kotuku:wave id="]] .. ID .. [[" x="0" y="40" length="100" amplitude="20" frequency="2" ]] ..
     AttribName .. [[="8" fill="none" stroke="black"/>
</svg>
]]
end

function loadWaveWithEndFrequency(ID:str, AttribName:str):<obj, obj>
   local scene = obj.new('VectorScene', { pageWidth=120, pageHeight=80 })
   scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   obj.new('svg', { target=scene, statement=waveDocument(ID, AttribName) })

   local wave = obj.find(ID)
   assert(wave != nil, 'Parsed SVG should create the named VectorWave')
   return scene, wave
end

----------------------------------------------------------------------------------------------------------------------

@Test function GradientInterpolationSurvivesInheritanceAndExport()
   local scene = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   obj.new('svg', { target=scene, statement=[[
<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100">
  <defs>
    <linearGradient id="base" color-interpolation="OkLcH  LoNgEr  HuE">
      <stop offset="0" stop-color="red"/>
      <stop offset="1" stop-color="blue"/>
    </linearGradient>
    <linearGradient id="inherited" href="#base"/>
    <linearGradient id="shorter" href="#base" color-interpolation="oklch shorter hue"/>
    <linearGradient id="increasing" href="#base" color-interpolation="oklch increasing hue"/>
    <linearGradient id="decreasing" href="#base" color-interpolation="oklch decreasing hue"/>
    <linearGradient id="lab" href="#base" color-interpolation="oklab"/>
    <linearGradient id="linear" href="#base" color-interpolation="linearRGB"/>
    <radialGradient id="radial" r="40%" color-interpolation="oklch">
      <stop offset="0" stop-color="red"/>
      <stop offset="1" stop-color="blue"/>
    </radialGradient>
    <linearGradient id="from_radial" href="#radial"/>
  </defs>
  <rect width="100" height="100" fill="url(#inherited)"/>
</svg>
]] })

   local saved = saveScene(scene, 'temp:svg_defs_gradient_interpolation.svg')
   assertContains(saved, 'color-interpolation="oklch"', 'The shorter hue arc should use bare oklch')
   assert(not saved.find('oklch shorter hue'), 'The shorter hue suffix should be omitted')

   local loaded = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   loaded.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   obj.new('svg', { target=loaded, statement=saved })
   local cases = {
      { id='base', mode=GCI_OKLCH, hue=GHM_LONGER },
      { id='inherited', mode=GCI_OKLCH, hue=GHM_LONGER },
      { id='shorter', mode=GCI_OKLCH, hue=GHM_SHORTER },
      { id='increasing', mode=GCI_OKLCH, hue=GHM_INCREASING },
      { id='decreasing', mode=GCI_OKLCH, hue=GHM_DECREASING },
      { id='lab', mode=GCI_OKLAB, hue=GHM_SHORTER },
      { id='radial', mode=GCI_OKLCH, hue=GHM_SHORTER },
      { id='from_radial', mode=GCI_OKLCH, hue=GHM_SHORTER }
   }
   for target in values({ scene, loaded }) do
      for sample in values(cases) do
         local _, gradient = check target.mtFindDef(sample.id)
         assert(gradient.interpolation is sample.mode and gradient.hueMethod is sample.hue,
            f'Interpolation or hue arc lost on {sample.id}')
         assert(#gradient.stops is 2, f'Stops lost on {sample.id}')
      end
      local _, gradient = check target.mtFindDef('linear')
      assert(gradient.interpolation is GCI_DEFAULT and gradient.colourSpace is VCS_LINEAR_RGB,
         'Explicit linearRGB should override inherited OKLCH')
   end
end

@Test function SingleStopStaysSolidWithLongerHue()
   local scene = obj.new('VectorScene', { pageWidth=100, pageHeight=20 })
   scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   obj.new('svg', { target=scene, statement=[[
<svg xmlns="http://www.w3.org/2000/svg" width="100" height="20">
  <defs>
    <linearGradient id="single" color-interpolation="oklch longer hue">
      <stop offset="50%" stop-color="red"/>
    </linearGradient>
  </defs>
  <rect width="100" height="20" fill="url(#single)"/>
</svg>
]] })

   local saved = saveScene(scene, 'temp:svg_defs_single_stop.svg')
   local loaded = obj.new('VectorScene', { pageWidth=100, pageHeight=20 })
   loaded.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   obj.new('svg', { target=loaded, statement=saved })

   local bitmap = obj.new('bitmap', { width=100, height=20, bitsPerPixel=32 })
   for target in values({ scene, loaded }) do
      bitmap.acClear()
      target.bitmap = bitmap
      check target.acDraw()
      for x in values({ 0, 50, 99 }) do
         local pixel = mGfx.ReadRGBPixel(bitmap, x, 10)
         assert(pixel.red is 255 and pixel.green is 0 and pixel.blue is 0, f'Expected solid red at x={x}')
      end
   end
end

@Test function MeshAndDiffusionExportTheirRenderingColourSpace()
   local scene = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   obj.new('svg', { target=scene, statement=[[
<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100">
  <defs>
    <meshgradient id="mesh" color-interpolation="linearRGB" style="color-interpolation: oklab">
      <meshrow><meshpatch>
        <stop path="l 1 0" stop-color="red"/>
        <stop path="l 0 1" stop-color="blue"/>
        <stop path="l -1 0" stop-color="red"/>
        <stop path="z" stop-color="blue"/>
      </meshpatch></meshrow>
    </meshgradient>
    <diffusionGradient id="diffusion" color-interpolation="linearRGB" style="color-interpolation: oklch longer hue">
      <curve d="M 0.5,0 L 0.5,1" left-start="red" right-start="blue"/>
    </diffusionGradient>
  </defs>
  <rect width="100" height="100" fill="url(#mesh)"/>
</svg>
]] })

   local saved = saveScene(scene, 'temp:svg_defs_surface_colour_space.svg')
   local loaded = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   loaded.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   obj.new('svg', { target=loaded, statement=saved })

   for id in values({ 'mesh', 'diffusion' }) do
      local _, original = check scene.mtFindDef(id)
      assert(original.colourSpace is VCS_LINEAR_RGB, f'Expected linear RGB on the original {id} gradient')
      local _, gradient = check loaded.mtFindDef(id)
      assert(gradient.colourSpace is original.colourSpace, f'Export changed the rendering colour space of {id}')
   end
end

@Test function SavesClipDefWithMapKeyId()
   local scene = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   local viewport = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   local clip = scene.new('VectorClip', { units=VUNIT_BOUNDING_BOX })

   clip.viewport.new('VectorRectangle', { x=0, y=0, width=1, height=1 })
   viewport.new('VectorRectangle', { x=0, y=0, width=100, height=100, mask=clip })
   check scene.mtAddDef('tile_clip', clip)

   local saved = saveScene(scene, 'temp:svg_defs_clip.svg')
   assertContains(saved, '<clipPath', 'Saved SVG should contain the clipPath definition')
   assertContains(saved, 'id="tile_clip"', 'ClipPath should use the scene def key when SID is empty')
   assertContains(saved, 'clipPathUnits="objectBoundingBox"', 'ClipPath should preserve object-bounding-box units')
   assertContains(saved, '<rect', 'ClipPath should include its viewport child vectors')
end

@Test function SavesPatternDefWithChildren()
   local scene = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   local viewport = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   local pattern = scene.new('VectorPattern', {
      x=2, y=3, width=8, height=9, units=VUNIT_USERSPACE, contentUnits=VUNIT_BOUNDING_BOX,
      transform='translate(1 2)'
   })

   pattern.viewport.new('VectorRectangle', { x=0, y=0, width=8, height=9, fill='rgb(255,0,0)' })
   check scene.mtAddDef('tile_pattern', pattern)
   viewport.new('VectorRectangle', { x=0, y=0, width=100, height=100, fill='url(#tile_pattern)' })

   local saved = saveScene(scene, 'temp:svg_defs_pattern.svg')
   assertContains(saved, '<pattern', 'Saved SVG should contain the pattern definition')
   assertContains(saved, 'id="tile_pattern"', 'Pattern should use the scene def key')
   assertContains(saved, 'patternUnits="userSpaceOnUse"', 'Pattern should preserve user-space units')
   assertContains(saved, 'patternContentUnits="objectBoundingBox"', 'Pattern should preserve content units')
   assertContains(saved, 'patternTransform=', 'Pattern should preserve transforms')
   assertContains(saved, '<rect', 'Pattern should include its viewport child vectors')
end

@Test function SavesGenericVectorDefWithMapKeyId()
   local scene = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   local viewport = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   local group = viewport.new('VectorGroup')

   group.new('VectorRectangle', { x=5, y=6, width=7, height=8 })
   check scene.mtAddDef('shared_group', group)

   local saved = saveScene(scene, 'temp:svg_defs_group.svg')
   assertContains(saved, '<g', 'Saved SVG should contain the generic vector definition')
   assertContains(saved, 'id="shared_group"', 'Generic vector defs should use the scene def key when SID is empty')
   assertContains(saved, '<rect', 'Generic vector defs should preserve child vectors')
end

@Test function SavesTransitionDefFromXMLDef()
   local scene = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   local transition = scene.new('VectorTransition', { stops=transitionStops() })

   assertContains(transition.xmlDef, '<stop offset="0"', 'Transition XMLDef should include the first stop')
   assertContains(transition.xmlDef, 'transform="matrix(', 'Transition XMLDef should serialise parsed transforms')

   check scene.mtAddDef('text_transition', transition)

   local saved = saveScene(scene, 'temp:svg_defs_transition.svg')
   assertContains(saved, '<kotuku:transition', 'Saved SVG should contain the transition definition')
   assertContains(saved, 'id="text_transition"', 'Transition should use the scene def key')
   assertContains(saved, '<stop offset="0"', 'Transition definition should include XMLDef stop elements')
   assertContains(saved, 'transform="matrix(', 'Transition definition should include XMLDef transform matrices')
end

@Test function SavesVectorImageDefWithExistingPath()
   local scene = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   local viewport = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   local source = obj.new('image', { src=glImagePath, bitsPerPixel=32 })
   local image = scene.new('VectorImage', { image=source, units=VUNIT_BOUNDING_BOX })

   check scene.mtAddDef('sign_image', image)
   viewport.new('VectorRectangle', { x=0, y=0, width=100, height=100, fill='url(#sign_image)' })

   local saved = saveScene(scene, 'temp:svg_defs_image_path.svg')
   assertContains(saved, '<image', 'Saved SVG should contain the image definition')
   assertContains(saved, 'id="sign_image"', 'VectorImage should use the scene def key')
   assertContains(saved, 'xmlns:xlink="http://www.w3.org/1999/xlink"', 'Saved SVG should declare the xlink namespace')
   assertContains(saved, 'xlink:href=', 'VectorImage should export a source reference')
   assertContains(saved, 'sign.png', 'VectorImage should preserve an existing source path')
   assert(saved.find('data:image/png;base64,', 0, true) is nil, 'Existing image paths should not be embedded')
end

@Test function SavesVectorImageDefWithEmbeddedBitmapFallback()
   local scene = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   local viewport = scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   local source = obj.new('image', { src=glImagePath, bitsPerPixel=32 })
   local image = scene.new('VectorImage', { bitmap=source.bitmap, units=VUNIT_BOUNDING_BOX })

   check scene.mtAddDef('embedded_image', image)
   viewport.new('VectorRectangle', { x=0, y=0, width=100, height=100, fill='url(#embedded_image)' })

   local saved = saveScene(scene, 'temp:svg_defs_image_embedded.svg')
   assertContains(saved, '<image', 'Saved SVG should contain the image definition')
   assertContains(saved, 'id="embedded_image"', 'Embedded VectorImage should use the scene def key')
   assertContains(saved, 'xlink:href="data:image/png;base64,', 'VectorImage without a valid path should embed PNG data')

   local loaded_scene = obj.new('VectorScene', { pageWidth=100, pageHeight=100 })
   loaded_scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   obj.new('svg', { target=loaded_scene, path='temp:svg_defs_image_embedded.svg' })
   local err, loaded_image = loaded_scene.mtFindDef('embedded_image')
   assert(err is ERR_Okay, 'Embedded VectorImage data should load back as a definition')
   assert(loaded_image != nil, 'Embedded VectorImage definition should be available after reload')
end

@Test function ParsesAndSavesWaveFrequencyEnd()
   local scene, wave = loadWaveWithEndFrequency('svg_wave_frequency_end', 'frequencyEnd')

   assertNear(wave.frequency, 2, 'VectorWave frequency should parse from SVG')
   assertNear(wave.frequencyEnd, 8, 'VectorWave frequencyEnd should parse from SVG')

   local saved = saveScene(scene, 'temp:svg_wave_frequency_end.svg')
   assertContains(saved, 'frequencyEnd=', 'Saved SVG should include a differing VectorWave frequencyEnd')
end

@Test function ParsesWaveFrequencyEndHyphenAlias()
   local scene, wave = loadWaveWithEndFrequency('svg_wave_frequency_end_alias', 'frequency-end')

   assertNear(wave.frequency, 2, 'VectorWave frequency should parse from SVG')
   assertNear(wave.frequencyEnd, 8, 'VectorWave frequency-end alias should parse from SVG')
end

@Test function ParsesAndSavesWaveNoise()
   local scene = obj.new('VectorScene', { pageWidth=120, pageHeight=80 })
   scene.new('VectorViewport', { x=0, y=0, width='100%', height='100%' })
   obj.new('svg', { target=scene, statement=[[
<svg viewBox="0 0 120 80" xmlns="http://www.w3.org/2000/svg" xmlns:kotuku="http://www.kotuku.dev/xmlns/svg">
  <kotuku:wave id="svg_wave_noise" x="0" y="40" length="100" amplitude="20" frequency="2" noise="0.75" fill="none" stroke="black"/>
</svg>
]] })

   local wave = obj.find('svg_wave_noise')
   assert(wave != nil, 'Parsed SVG should create the named VectorWave')
   assertNear(wave.noise, 0.75, 'VectorWave noise should parse from SVG')

   local saved = saveScene(scene, 'temp:svg_wave_noise.svg')
   assertContains(saved, 'noise=', 'Saved SVG should include VectorWave noise, got ' .. saved)
end

@Test function SpiralSamplingFieldsRoundTrip()
   local scene <close> = obj.new('VectorScene', { pageWidth=200, pageHeight=200 })
   local svg = obj.new('svg', { target=scene, statement=[[
<svg width="200" height="200" xmlns="http://www.w3.org/2000/svg"
     xmlns:kotuku="http://www.kotuku.dev/xmlns/svg">
  <kotuku:spiral id="sampling_spiral" startTurn="0.25" endTurn="2.5"
                 tolerance="0.01" clockwise="false" reverse="true" thickness="2%" fill="none" stroke="black"/>
</svg>]] })
   local spiral = obj.find('sampling_spiral')
   assert(spiral != nil, 'SVG should create the spiral')
   assertNear(spiral.startTurn, 0.25, 'Start turn should import')
   assertNear(spiral.endTurn, 2.5, 'End turn should import')
   assertNear(spiral.tolerance, 0.01, 'Tolerance should import')
   assertNear(spiral.thickness, 0.02, 'Percentage thickness should import')
   assert(spiral.clockwise is 0 and spiral.reverse is 1, 'Spiral directions should import')
   local saved = saveScene(scene, 'temp:svg_spiral_sampling.svg')
   assertContains(saved, 'startTurn="0.25"', 'Start turn should export')
   assertContains(saved, 'endTurn="2.5"', 'End turn should export')
   assertContains(saved, 'tolerance="0.01"', 'Tolerance should export')
   assertContains(saved, 'thickness="2%"', 'Percentage thickness should export')
   assertContains(saved, 'clockwise="false"', 'Anticlockwise winding should export')
   assertContains(saved, 'reverse="true"', 'Reverse traversal should export')
   local loaded_scene <close> = obj.new('VectorScene', { pageWidth=200, pageHeight=200 })
   local loaded_svg = obj.new('svg', { target=loaded_scene, statement=saved })
   local loaded = loaded_svg.viewport.child
   assertNear(loaded.startTurn, 0.25, 'Start turn should survive round trip')
   assertNear(loaded.endTurn, 2.5, 'End turn should survive round trip')
   assertNear(loaded.tolerance, 0.01, 'Tolerance should survive round trip')
   assertNear(loaded.thickness, 0.02, 'Percentage thickness should survive round trip')
   assert(loaded.clockwise is 0 and loaded.reverse is 1, 'Spiral directions should survive round trip')
end


@Test function SupershapeSamplingFieldsRoundTrip()
   local scene <close> = obj.new('VectorScene', { pageWidth=200, pageHeight=200 })
   local svg = obj.new('svg', { target=scene, statement=[[
<svg width="200" height="200" xmlns="http://www.w3.org/2000/svg"
     xmlns:kotuku="http://www.kotuku.dev/xmlns/svg">
  <kotuku:shape tolerance="0.1" startAngle="45" endAngle="135" normalise="false" close="false"
                spiral="3" offset="5"/>
</svg>]] })
   local shape = svg.viewport.child
   assertNear(shape.tolerance, 0.1, 'Tolerance should import')
   assertNear(shape.startAngle, 45, 'Start angle should import')
   assertNear(shape.endAngle, 135, 'End angle should import')
   assertNear(shape.offset, 5, 'Offset should import')
   assert(shape.normalise is 0 and shape.close is 0, 'Natural scale and open path should import')
   local saved = saveScene(scene, 'temp:svg_supershape_sampling.svg')
   assertContains(saved, 'normalise="false"', 'Natural scale should export')
   local loaded_scene <close> = obj.new('VectorScene', { pageWidth=200, pageHeight=200 })
   local loaded_svg = obj.new('svg', { target=loaded_scene, statement=saved })
   local loaded = loaded_svg.viewport.child
   assertNear(loaded.tolerance, 0.1, 'Tolerance should survive round trip')
   assertNear(loaded.startAngle, 45, 'Start angle should survive round trip')
   assertNear(loaded.endAngle, 135, 'End angle should survive round trip')
   assertNear(loaded.offset, 5, 'Offset should survive round trip')
   assert(loaded.normalise is 0 and loaded.close is 0, 'Natural scale and open path should survive round trip')
end

@Test function SupershapeManualSamplingRoundTrip()
   local scene <close> = obj.new('VectorScene', { pageWidth=200, pageHeight=200 })
   local viewport = scene.new('VectorViewport', { width=200, height=200 })
   viewport.new('VectorShape', { vertices=8 })
   local saved = saveScene(scene, 'temp:svg_supershape_manual.svg')
   print(saved)
   local loaded_scene <close> = obj.new('VectorScene', { pageWidth=200, pageHeight=200 })
   local loaded_svg = obj.new('svg', { target=loaded_scene, statement=saved })
   local loaded = loaded_svg.viewport.child
   assertNear(loaded.tolerance, 0, 'Manual sampling should survive round trip')
   assert(loaded.vertices is 8, 'Manual interval count should survive round trip, got ' .. loaded.vertices)
end

@Test function ColourInterpolationRoundTrip()
   local scene <close> = obj.new('VectorScene', { pageWidth=40, pageHeight=40 })
   local svg = obj.new('svg', { target=scene, statement=[[
<svg width="40" height="40" color-interpolation="linearRGB" xmlns="http://www.w3.org/2000/svg">
  <g id="ci_srgb" color-interpolation="sRGB"><rect id="ci_inherit" width="20" height="20"/></g>
  <rect id="ci_linear" x="20" width="20" height="20" color-interpolation="linearRGB"/>
</svg>]] })
   assert(svg.viewport.colourSpace is VCS_LINEAR_RGB, 'Root color-interpolation should import')
   assert(obj.find('ci_srgb').colourSpace is VCS_SRGB, 'Group color-interpolation should import')
   assert(obj.find('ci_linear').colourSpace is VCS_LINEAR_RGB, 'Shape color-interpolation should import')
   assert(obj.find('ci_inherit').colourSpace is VCS_INHERIT, 'Unspecified color-interpolation should inherit')

   local saved = saveScene(scene, 'temp:svg_colour_interpolation.svg')
   assertContains(saved, 'color-interpolation="sRGB"', 'sRGB color-interpolation should export')
   assertContains(saved, 'color-interpolation="linearRGB"', 'linearRGB color-interpolation should export')

   local loaded_scene <close> = obj.new('VectorScene', { pageWidth=40, pageHeight=40 })
   local loaded_svg = obj.new('svg', { target=loaded_scene, statement=saved })
   assert(loaded_svg.viewport.colourSpace is VCS_LINEAR_RGB, 'Root color-interpolation should survive round trip')
   local group = loaded_svg.viewport.child
   assert(group.colourSpace is VCS_SRGB, 'Group color-interpolation should survive round trip')
   assert(group.child.colourSpace is VCS_INHERIT, 'Inherited color-interpolation should not be written')
   assert(group.next.colourSpace is VCS_LINEAR_RGB, 'Shape color-interpolation should survive round trip')
end

@Test function DefaultSVGRootDoesNotExportColourInterpolation()
   -- sRGB is the SVG default for a parsed document's root, so it is not written.
   local scene <close> = obj.new('VectorScene', { pageWidth=40, pageHeight=40 })
   local svg = obj.new('svg', { target=scene, statement=[[
<svg width="40" height="40" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="20"/></svg>]] })
   assert(svg.viewport.colourSpace is VCS_SRGB, 'A parsed root should composite in sRGB')
   local saved = saveScene(scene, 'temp:svg_colour_interpolation_default.svg')
   assert(saved.find('color-interpolation', 0, true) is nil, 'The default root colour space should not be written')
end

function paintOrderDocument(Content:str):str
   return '<svg width="40" height="40" xmlns="http://www.w3.org/2000/svg">' .. Content .. '</svg>'
end

@Test function PaintOrderImports()
   local scene <close> = obj.new('VectorScene', { pageWidth=40, pageHeight=40 })
   local svg = obj.new('svg', { target=scene, statement=paintOrderDocument([[
<rect id="po_stroke" width="10" height="10" paint-order="stroke"/>
<rect id="po_case" width="10" height="10" paint-order="Markers  STROKE"/>
<rect id="po_style" width="10" height="10" style="paint-order: fill markers"/>
<rect id="po_normal" width="10" height="10" paint-order="normal"/>
<rect id="po_full" width="10" height="10" paint-order="stroke markers fill"/>
<g paint-order="stroke"><rect id="po_child" width="10" height="10"/><rect id="po_override" paint-order="markers"/></g>
<rect id="po_default" width="10" height="10"/>]]) })
   assert(obj.find('po_stroke').paintOrder is VPO_STROKE_FILL_MARKERS, 'paint-order="stroke" should import')
   assert(obj.find('po_case').paintOrder is VPO_MARKERS_STROKE_FILL, 'paint-order keywords are case-insensitive')
   assert(obj.find('po_style').paintOrder is VPO_FILL_MARKERS_STROKE, 'paint-order should import from a style')
   assert(obj.find('po_normal').paintOrder is VPO_NORMAL, 'paint-order="normal" should import')
   assert(obj.find('po_full').paintOrder is VPO_STROKE_MARKERS_FILL, 'A full paint-order list should import')
   assert(obj.find('po_child').paintOrder is VPO_STROKE_FILL_MARKERS, 'paint-order should be inherited from a group')
   assert(obj.find('po_override').paintOrder is VPO_MARKERS_FILL_STROKE,
      'A child paint-order should override its group')
   assert(obj.find('po_default').paintOrder is VPO_NORMAL, 'An undeclared paint-order should default to normal')
end

@Test function InvalidPaintOrderIsIgnored()
   local scene <close> = obj.new('VectorScene', { pageWidth=40, pageHeight=40 })
   local svg = obj.new('svg', { target=scene, statement=paintOrderDocument([[
<rect id="po_duplicate" width="10" height="10" paint-order="stroke stroke"/>
<rect id="po_unknown" width="10" height="10" paint-order="bogus"/>
<rect id="po_mixed" width="10" height="10" paint-order="normal fill"/>
<g paint-order="stroke">
   <rect id="po_invalid_child" width="10" height="10" paint-order="fill fill"/>
   <rect id="po_blank_child" width="10" height="10" paint-order=" "/>
</g>]]) })
   for id in values(array<str> { 'po_duplicate', 'po_unknown', 'po_mixed' }) do
      local order = obj.find(id).paintOrder
      assert(order is VPO_NORMAL, f'An invalid paint-order on {id} should leave the default, got {order}')
   end
   assert(obj.find('po_invalid_child').paintOrder is VPO_STROKE_FILL_MARKERS,
      'An invalid paint-order should leave the inherited value')
   assert(obj.find('po_blank_child').paintOrder is VPO_STROKE_FILL_MARKERS,
      'A whitespace-only paint-order should leave the inherited value')
end

@Test function PaintOrderCascadeResolvesInherit()
   local scene <close> = obj.new('VectorScene', { pageWidth=40, pageHeight=40 })
   local svg = obj.new('svg', { target=scene, statement=paintOrderDocument([[
<g paint-order="stroke">
   <rect id="po_inherit_shape" width="10" height="10" paint-order="fill" style="paint-order: inherit"/>
   <g paint-order="markers" style="paint-order: inherit">
      <rect id="po_inherit_group" width="10" height="10"/>
   </g>
</g>
<rect id="po_inherit_root" width="10" height="10" paint-order="stroke" style="paint-order: inherit"/>]]) })
   assert(obj.find('po_inherit_shape').paintOrder is VPO_STROKE_FILL_MARKERS,
      'Inline inherit should override a shape presentation attribute')
   assert(obj.find('po_inherit_group').paintOrder is VPO_STROKE_FILL_MARKERS,
      'Inline inherit on a group should use the parent order for its children')
   assert(obj.find('po_inherit_root').paintOrder is VPO_NORMAL,
      'Inheriting from an undeclared parent should give the default order')
end

@Test function PaintOrderRoundTripsNormalUnderStrokeGroup()
   local scene <close> = obj.new('VectorScene', { pageWidth=40, pageHeight=40 })
   local svg = obj.new('svg', { target=scene, statement=paintOrderDocument([[
<g paint-order="stroke">
   <svg width="30" height="30">
      <rect width="10" height="10" paint-order="normal"/>
      <rect x="12" width="10" height="10"/>
   </svg>
</g>]]) })
   local saved = saveScene(scene, 'temp:svg_paint_order_group.svg')
   assertContains(saved, 'paint-order="normal"', 'Export should preserve normal under a stroke-ordered group')

   local loaded_scene <close> = obj.new('VectorScene', { pageWidth=40, pageHeight=40 })
   local loaded_svg = obj.new('svg', { target=loaded_scene, statement=saved })
   local rect = loaded_svg.viewport.child.child.child
   assert(rect.paintOrder is VPO_NORMAL, 'The explicit normal order should survive reload')
   assert(rect.next.paintOrder is VPO_STROKE_FILL_MARKERS, 'The inherited stroke-first order should survive reload')
end

@Test function PaintOrderExportsShortestForm()
   local expected = {
      [VPO_FILL_MARKERS_STROKE] = 'fill markers',
      [VPO_STROKE_FILL_MARKERS] = 'stroke',
      [VPO_STROKE_MARKERS_FILL] = 'stroke markers',
      [VPO_MARKERS_FILL_STROKE] = 'markers',
      [VPO_MARKERS_STROKE_FILL] = 'markers stroke'
   }

   for order, value in expected do
      local scene <close> = obj.new('VectorScene', { pageWidth=40, pageHeight=40 })
      local viewport = scene.new('VectorViewport', { width='100%', height='100%' })
      viewport.new('VectorRectangle', { width=10, height=10, fill='rgb(0,0,255)', paintOrder=order })
      local saved = saveScene(scene, f'temp:svg_paint_order_{order}.svg')
      assertContains(saved, f'paint-order="{value}"', f'PaintOrder {order} should export as "{value}"')

      local loaded_scene <close> = obj.new('VectorScene', { pageWidth=40, pageHeight=40 })
      local loaded_svg = obj.new('svg', { target=loaded_scene, statement=saved })
      local loaded = loaded_svg.viewport.child
      assert(loaded.paintOrder is order, f'PaintOrder {order} should survive round trip, got {loaded.paintOrder}')
   end

   local scene <close> = obj.new('VectorScene', { pageWidth=40, pageHeight=40 })
   local viewport = scene.new('VectorViewport', { width='100%', height='100%' })
   viewport.new('VectorRectangle', { width=10, height=10, fill='rgb(0,0,255)' })
   local saved = saveScene(scene, 'temp:svg_paint_order_normal.svg')
   assert(saved.find('paint-order', 0, true) is nil, 'The default paint order should not be written')
end

@Test function CollectionTileColourSpaceRoundTrip()
   local _, original = mSys.ResolvePath('patterns:', RSF_NO_FILE_CHECK)
   check mSys.SetVolume('patterns', glSVGFolder .. 'collection_paints/', '', '', '', VOLUME_REPLACE)
   defer
      mSys.SetVolume('patterns', original, '', '', '', VOLUME_REPLACE)
   end

   local function sample(Scene:obj):num
      local bitmap <close> = obj.new('Bitmap', { width=32, height=32, bitsPerPixel=32, bkgd='0,0,0,255' })
      bitmap.acClear()
      Scene.bitmap = bitmap
      check Scene.acDraw()
      return mGfx.ReadRGBPixel(bitmap, 8, 8).red
   end

   for colour_space in values(array<int> { VCS_SRGB, VCS_LINEAR_RGB }) do
      local scene <close> = obj.new('VectorScene', { pageWidth=32, pageHeight=32 })
      local viewport = scene.new('VectorViewport', { width=32, height=32, colourSpace=colour_space })
      viewport.new('VectorRectangle', { width=32, height=32, fill='url(#pattern:blend)' })
      local expected = sample(scene)
      assert(math.abs(expected - 127) <= 2, 'Collection tiles should blend in sRGB')

      local saved = saveScene(scene, 'temp:svg_collection_colour_space.svg')
      assert(saved.lower().find('url(#pattern:', 0, true) is nil, 'Export must embed the collection tile')
      local loaded_scene <close> = obj.new('VectorScene', { pageWidth=32, pageHeight=32 })
      local svg <close> = obj.new('svg', { target=loaded_scene, statement=saved })
      local actual = sample(loaded_scene)
      assert(math.abs(actual - expected) <= 2,
         f'Collection tile colour space changed after export: expected {expected}, got {actual}')
   end
end

@Test function PathEdgeOffsetsExportAsNumericSnapshot()
   local scene <close> = obj.new('VectorScene', { pageWidth=100, pageHeight=60 })
   local viewport = scene.new('VectorViewport', { width='100%', height='100%' })
   local path = viewport.new('VectorPath', { sequence='M 0 0 L ~10 0 L ~10 ~10 L 0 ~10 Z' })
   local sequence = path.sequence
   local saved = saveScene(scene, 'temp:svg_path_edge_offsets.svg')
   assert(saved.find('~') is nil, 'SVG path data must not contain parent-edge syntax')
   assertContains(saved, 'd="' .. sequence .. '"', 'SVG must contain the resolved numeric Sequence')

   local loaded_scene <close> = obj.new('VectorScene', { pageWidth=200, pageHeight=100 })
   local loaded_svg = obj.new('svg', { target=loaded_scene, statement=saved })
   assert(loaded_svg.viewport != nil, 'Numeric path snapshot must be readable by the SVG parser')
end
